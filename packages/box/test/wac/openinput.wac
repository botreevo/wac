// A program run with its standard input **still open** — the shape a terminal has.
//
// Every other harness gives a program an input that is already at its end, and a read of that returns at once, so
// a program that read its input when it should not have looked fine. Here the program is spawned with its input a
// queue the caller holds and never writes to, which stays open, and its end is bounded by `Clock.within`, so a hang
// is a result (`hung`) rather than a wedged suite. `stdinopen_test.wac` and `sealed_test.wac`.

import { Authority, Child, Launch, Sys, TimedOut } from "std";

/** What a run said, its status, or that it did not finish within its bound. */
export struct Ran {
  string out;
  i32 status;
  bool hung;
}

/** `wasm` with `args`, holding `given`, its input open and never written to, given at most `ms` to finish. */
export async Ran openInput(Sys sys, u8[] wasm, string[] args, Authority given, i32 ms) {
  auto spawned = await sys.procs().spawn(wasm, args, given, Launch.plain());
  if (spawned.isErr()) { return Ran("did not start: \{spawned.err()!}", 0 - 1, false); }
  Child child = spawned.unwrap();
  // The input is not touched: held open, as a terminal's is, until the child has ended or been given up on.
  auto ended = await sys.clock().within(child.exit(), ms);
  if (ended.isErr()) {
    bool hung = ended.err()! is TimedOut;
    child.stop();
    return Ran("", 0 - 1, hung);
  }
  string out = string.fromBytes((await child.output().readAll()).orElse(u8[]()));
  return Ran(out, ended.unwrap(), false);
}
