// `codec` as the repository's root entry presents it (`lib.wac` at the root): base16 and base64, from
// RFC 4648. The two modules name their functions alike (`encode`, `decode`), so each is renamed here
// with its encoding in front — the namespace a project sees is `codec.base64Encode`, never a bare
// `codec.encode` that could mean either.
//
// **One name per statement, deliberately.** `tools/wac/libentry_test.wac` holds this file to that.

export { ALPHABET_STANDARD as BASE64_STANDARD } from "./base64.wac";
export { ALPHABET_URL as BASE64_URL } from "./base64.wac";
export { encode as base64Encode } from "./base64.wac";
export { decode as base64Decode } from "./base64.wac";
export { encode as hexEncode } from "./hex.wac";
export { encodeUpper as hexEncodeUpper } from "./hex.wac";
export { decode as hexDecode } from "./hex.wac";
export { PemBlock } from "./pem.wac";
export { pemEncode } from "./pem.wac";
export { pemBlocks } from "./pem.wac";
export { pemFind } from "./pem.wac";
