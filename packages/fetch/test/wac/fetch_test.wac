// The parts of `fetch` that decide where a request goes: the URL taken apart, and `NO_PROXY`. The socket
// halves are the ones git's transport already runs against real servers.

import { T } from "../../../wactest/src/assert.wac";
import { Target, parseTarget, noProxy } from "../../src/fetch.wac";
import { Sys } from "std";

string show(Target? t) {
  if (t is null) { return "null"; }
  return (t!.tls ? "https " : "http ") + t!.host + " \{t!.port} " + t!.path;
}

export string test_a_url_is_taken_apart(Sys sys) {
  T t = T.create();
  string[][] cases = [
    ["https://app.example/", "https app.example 443 /"],
    ["http://localhost:3000/instances?x=1", "http localhost 3000 /instances?x=1"],
    ["HTTPS://Host.Example", "https host.example 443 /"],
    ["http://h?q", "http h 80 /?q"],
    ["http://h/p#frag", "http h 80 /p"],
    ["http://[::1]:8080/a", "http ::1 8080 /a"],
    ["http://[::1]/", "http ::1 80 /"],
    ["ftp://h/", "null"],
    ["http://", "null"],
    ["http://h:0/", "null"],
    ["http://h:65536/", "null"],
    ["http://h:8x/", "null"],
    ["http://user:pw@h/", "null"],
    ["h/p", "null"],
  ];
  for (string[] c in cases) { t.eqStr(show(parseTarget(c[0])), c[1], c[0]); }
  return t.report();
}

export string test_no_proxy_names_hosts_and_the_domains_under_them(Sys sys) {
  T t = T.create();
  string list = "localhost, 127.0.0.1,.internal,*.svc.cluster.local,example.org:8080,::1";
  t.eqBool(noProxy(list, "localhost"), true, "a listed host");
  t.eqBool(noProxy(list, "127.0.0.1"), true, "a listed address");
  t.eqBool(noProxy(list, "::1"), true, "an IPv6 address");
  t.eqBool(noProxy(list, "a.internal"), true, "under a leading-dot domain");
  t.eqBool(noProxy(list, "internal"), true, "a leading-dot domain itself");
  t.eqBool(noProxy(list, "x.svc.cluster.local"), true, "under a star domain");
  t.eqBool(noProxy(list, "www.example.org"), true, "under a bare domain, its port ignored");
  t.eqBool(noProxy(list, "notexample.org"), false, "a suffix that is not a subdomain");
  t.eqBool(noProxy(list, "example.com"), false, "an unlisted host");
  t.eqBool(noProxy("", "localhost"), false, "an empty list");
  t.eqBool(noProxy("*", "anything"), true, "a star");
  return t.report();
}
