// How a child ended, as a value — spec ch44 `§wac-std-child-ended-q2v8mtf`. Run by `ended_test.wac` on each host. The
// parent spawns itself once per way of ending and prints what `ended()` and `exit()` said of each, one line apiece.

import { Sys, Child, Ended, TrapKind, Authority, Launch, Output } from "std";

i32 deep(i32 n) { return n == 0 ? 0 : 1 + deep(n + 1); }

string kindName(TrapKind k) {
  match (k) {
    Explicit: { return "explicit"; }
    UnreachableCode: { return "unreachable"; }
    MemoryBounds: { return "memory bounds"; }
    TableBounds: { return "table bounds"; }
    DivideByZero: { return "divide by zero"; }
    IntegerOverflow: { return "integer overflow"; }
    BadConversion: { return "bad conversion"; }
    NullReference: { return "null reference"; }
    BadCast: { return "bad cast"; }
    StackExhausted: { return "stack exhausted"; }
    Unclassified: { return "other"; }
  }
}

async string said(Sys sys, string mode) {
  Child c = (await sys.procs().spawnSelf([mode], Authority.none(), Launch.plain())).unwrap();
  string how = "";
  match (await c.ended()) {
    Ok(e): {
      match (e) {
        Exited(code): { how = "exited \{code}"; }
        Trapped(k, text): { how = "trapped " + kindName(k) + (kindName(k) == "explicit" ? ": " + text : ""); }
        HostLimit(why): { how = "host limit"; }
      }
    }
    Err(e): { how = "no answer"; }
  }
  string exit = (await c.exit()).isOk() ? "exit ok" : "exit err";
  return mode + ": " + how + ", " + exit;
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() > 0) {
    string mode = args[0];
    if (mode == "exit") { return 3; }
    if (mode == "trap") { trap "the ring is full"; }
    if (mode == "bounds") { i32[] a = i32[].filled(2, 0); i32 i = args.len() + 5; return a[i]; }
    if (mode == "deep") { return deep(1); }
    return 0;
  }
  Output out = sys.stdout();
  for (string mode in ["exit", "trap", "bounds", "deep"]) { await out.line(await said(sys, mode)); }
  return 0;
}
