// A child launched sealed — spec ch44 `§wac-std-sealed-child-w4kq9ve`. Run by `sealed_test.wac` on each host. The
// parent reads its own clock, then spawns itself as `child` with `Launch.sealed()`; the child asks for the time, a
// monotonic reading and random bytes, and spawns a `grandchild` without asking for a seal, which asks the same. Each
// prints what it was answered, on the parent's own output.

import { Sys, Authority, Launch, Child, Output } from "std";

async string asks(Sys sys) {
  string now = (await sys.clock().nowMillis()).isOk() ? "clock" : "no clock";
  string mono = (await sys.clock().monotonicNanos()).isOk() ? "monotonic" : "no monotonic";
  string rnd = (await sys.random().bytes(4)).isOk() ? "random" : "no random";
  return now + ", " + mono + ", " + rnd;
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  Output out = sys.stdout();
  if (args.len() > 0 && args[0] == "grandchild") {
    await out.line("grandchild: " + await asks(sys));
    return 0;
  }
  if (args.len() > 0 && args[0] == "child") {
    await out.line("child: " + await asks(sys));
    // Not asked to be sealed, and sealed all the same: a sealed program cannot hand the clock back.
    Child g = (await sys.procs().spawnSelf(["grandchild"], Authority(null, null, null, null),
                                           Launch("", false, true, false, false))).unwrap();
    await g.exit();
    return 0;
  }
  await out.line("parent: " + await asks(sys));
  Child c = (await sys.procs().spawnSelf(["child"], Authority(null, null, null, sys.procs()),
                                         Launch("", false, true, false, false).sealed())).unwrap();
  await c.exit();
  return 0;
}
