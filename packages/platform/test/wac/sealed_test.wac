// `Launch.sealed()` on every host — spec ch44 `§wac-std-sealed-child-w4kq9ve`. A deterministic runner (wac-eth's reckon)
// needs a child whose run is a function of what it was handed, and the clock and random bytes are the two things every
// program has without asking. Each host is asked to run `sealed_probe.wac`, whose child is sealed and whose grandchild is
// not asked to be: both must find no clock and no random bytes, and the parent must keep its own.

import { Sys, Procs, Exec, SpawnFault, ChildEnv, Launch } from "std";
import { Result, flatten } from "core";
import { T } from "../../../wactest/src/assert.wac";

void sealedSaid(T t, string host, Result<Exec, SpawnFault> ran) {
  match (ran) {
    Ok(r): {
      t.eqI32(r.status, 0, host + ": the probe ran: " + string.fromBytes(r.stderr));
      t.eqStr(string.fromBytes(r.stdout),
              "parent: clock, monotonic, random\nchild: no clock, no monotonic, no random\n"
                + "grandchild: no clock, no monotonic, no random\n",
              host + ": the sealed child and its child have no clock and no random bytes; the parent has both");
    }
    Err(e): { t.fail(host + ": did not run"); }
  }
}

export async string test_a_sealed_child_has_no_clock_and_no_random_bytes_on_every_host(Sys sys) {
  T t = T.create();
  Procs procs = sys.procs();
  string probe = "packages/platform/test/wac/sealed_probe.wac";
  string dir = flatten(sys.env().cwd().wait()).unwrap() + "/.cache/wac-sealed";
  await sys.files().mkdir(dir, true);
  sealedSaid(t, "v8", await procs.exec("native/v8/target/release/wac", ["run", "--allow-run", probe],
                                       u8[](), ChildEnv.inherited(), Launch.plain()));
  if ((await sys.files().stat("native/target/release/wac")).isOk()) {
    sealedSaid(t, "wasmtime", await procs.exec("native/target/release/wac", ["run", "--allow-run", probe],
                                               u8[](), ChildEnv.inherited(), Launch.plain()));
  }
  string denoOut = dir + "/probe-deno.js";
  await procs.exec("deno", ["run", "-A", "packages/platform/build.ts", probe, "--allow-run",
                            "--target", "deno", "-o", denoOut], u8[](), ChildEnv.inherited(), Launch.plain());
  sealedSaid(t, "deno", await procs.exec("deno", ["run", "-A", denoOut], u8[](), ChildEnv.inherited(), Launch.plain()));
  string nodeOut = dir + "/probe-node.js";
  await procs.exec("deno", ["run", "-A", "packages/platform/build.ts", probe, "--allow-run",
                            "--target", "node", "-o", nodeOut], u8[](), ChildEnv.inherited(), Launch.plain());
  sealedSaid(t, "node", await procs.exec("node", [nodeOut], u8[](), ChildEnv.inherited(), Launch.plain()));
  return t.report();
}
