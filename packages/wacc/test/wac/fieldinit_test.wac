// A field's default is compiled in the file it was written in, not the one that constructs — `issues/lang/0435d`.
//
// A struct-typed local held across an `await` is a cell of the coroutine's frame, and a frame starts each cell at
// its type's default — for a struct, one built with its field initialisers. That was compiled in the *async
// function's* file, so a name in an initialiser resolved there: `Vec<X>.create()` in `Holder`, built from a file
// that names neither `X` but reaches two, made a vector of the other `X` and stored it in `Holder`'s field — a module
// the engine would not load, and no diagnostic (wac-kps's two `Outgoing`s).
//
// **Through the compiler, in memory, and checked by the engine**: the bug is a module that builds and is invalid.
import { T } from "../../../wactest/src/assert.wac";
import { emitLinked } from "../../src/emit.wac";
import { Sys } from "std";

export string test_a_default_is_compiled_where_it_was_written(Sys sys) {
  T t = T.create();
  string other = "import { Vec } from \"core\";\nexport struct X { string b; }\n" +
                 "export struct Box { Vec<X> xs = Vec<X>.create(); }\n" +
                 "export i32 boxed() { Box b = Box {}; b.xs.push(X(\"q\")); return b.xs.len(); }\n";
  string holder = "import { Vec } from \"core\";\nstruct X { i32 a; }\n" +
                  "export struct Holder { i32 k; Vec<X> q = Vec<X>.create(); Holder make(i32 k) { return Holder { k: k }; } }\n" +
                  "export i32 count(Holder h) { h.q.push(X(5)); return h.q.len() * 10 + h.q.get(0).a; }\n";
  string main = "import { Sys } from \"std\";\nimport { boxed } from \"./other.wac\";\nimport { Holder, count } from \"./holder.wac\";\n" +
                "export async i32 main(Sys sys) { await; Holder h = Holder.make(1); await; return count(h) + boxed() * 100 - 115; }\n";
  u8[] out = emitLinked(["/p/main.wac", "/p/other.wac", "/p/holder.wac"], [main, other, holder], "/p/main.wac");
  t.isTrue(out.len() > 8, "it builds: \{out.len()} bytes");
  if (out.len() > 8) {
    auto v = sys.modules().validate(out);
    t.isTrue(v.isOk(), "and the engine loads it: \{v.isErr() ? "\{v.err()!}" : "ok"}");
  }
  return t.report();
}
