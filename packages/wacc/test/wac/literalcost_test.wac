// A string literal evaluated in a loop costs about what a variable does.
//
// wacc scans text one character at a time — `string c = t[i]; if (c == "[" || c == "<") …` — and every
// literal in that test is evaluated once per character. `issues/lang/0398b`: through `array.new_data`
// each evaluation was a call into the engine's runtime that took a lock, and that loop ran about 12×
// slower than the same loop with its literals held in variables set before it. Spread over every such
// scanner it was a fifth of building box's shell, as lock and allocation time no one function owned.
//
// The program times both forms and exits with how many times slower the literals were, in tenths, so the
// emitted code is measured by the engine that runs it rather than by reading its bytes.
//
// **The fastest of seven interleaved trials of each, not one of each.** One back-to-back pair failed a loaded gate at
// 3× (2026-11-13) and passed alone 5/5 at about 1×: a wall-clock ratio of two single runs is decided by whichever one a
// preemption lands in. Load only ever adds time, so a minimum is the closest a busy machine gets to the cost itself,
// and alternating the two forms means a slow stretch is seen by both. The bound stays at 3×, against the 12× the bug
// it guards was; measured 2026-11-13 it reads 1.5–1.6× alone, and passed 5/5 with every core busy.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Clock, Sys } from "std";
import { flatten } from "core";
import { Ran, runEmittedOne, scratchDir } from "./artifacts_probe.wac";

static string PROGRAM = "import { Sys, Clock } from \"std\";\n"
  + "import { flatten } from \"core\";\n"
  + "i32 withLiterals(string t, i32 rounds) {\n"
  + "  i32 n = 0;\n"
  + "  for (i32 r = 0; r < rounds; r++) {\n"
  + "    for (i32 i = 0; i < t.len(); i++) {\n"
  + "      string c = t[i];\n"
  + "      if (c == \"[\" || c == \"<\") { n = n + 1; }\n"
  + "      if (c == \"]\" || c == \">\") { n = n - 1; }\n"
  + "    }\n"
  + "  }\n"
  + "  return n;\n"
  + "}\n"
  + "i32 withVariables(string t, i32 rounds) {\n"
  + "  string lb = \"[\"; string lt = \"<\"; string rb = \"]\"; string gt = \">\";\n"
  + "  i32 n = 0;\n"
  + "  for (i32 r = 0; r < rounds; r++) {\n"
  + "    for (i32 i = 0; i < t.len(); i++) {\n"
  + "      string c = t[i];\n"
  + "      if (c == lb || c == lt) { n = n + 1; }\n"
  + "      if (c == rb || c == gt) { n = n - 1; }\n"
  + "    }\n"
  + "  }\n"
  + "  return n;\n"
  + "}\n"
  + "i64 now(Clock clock) { return flatten(clock.monotonicNanos().wait()).unwrap(); }\n"
  + "export i32 main(Sys sys) {\n"
  + "  Clock clock = sys.clock();\n"
  + "  string t = \"fn[Result<i32,string>(Vec<core$Job>,fn[void(i32)],string[])]\";\n"
  + "  withLiterals(t, 2000); withVariables(t, 2000);\n"
  + "  i64 bestL = 0 as i64; i64 bestV = 0 as i64;\n"
  + "  for (i32 k = 0; k < 7; k++) {\n"
  + "    i64 t0 = now(clock);\n"
  + "    i32 a = withLiterals(t, 3000);\n"
  + "    i64 t1 = now(clock);\n"
  + "    i32 b = withVariables(t, 3000);\n"
  + "    i64 t2 = now(clock);\n"
  + "    if (a != b) { return 255; }\n"
  + "    if (k == 0 || t1 - t0 < bestL) { bestL = t1 - t0; }\n"
  + "    if (k == 0 || t2 - t1 < bestV) { bestV = t2 - t1; }\n"
  + "  }\n"
  + "  if (bestV < (1 as i64)) { bestV = 1 as i64; }\n"
  + "  i64 tenths = bestL * (10 as i64) / bestV;\n"
  + "  return tenths > (250 as i64) ? 250 : tenths as! i32;\n"
  + "}\n";

export string test_a_literal_in_a_loop_costs_about_what_a_variable_does(Sys sys) {
  T t = T.create();
  Ran r = runEmittedOne(sys.env(), sys.files(), sys.procs(), "/t/m.wac", PROGRAM, scratchDir(sys.env(), sys.files()), "literalcost.wasm");
  t.isTrue(r.ok, "the program ran — " + r.error + r.stderr);
  if (!r.ok) { return t.report(); }
  t.isTrue(r.status != 255, "both loops counted the same brackets");
  t.isTrue(r.status < 30,
           "at its fastest of seven, the loop comparing against literals took " + itoa(r.status / 10) + "."
           + itoa(r.status % 10) + "× as long as the same loop comparing against variables");
  return t.report();
}
