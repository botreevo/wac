// Two symbols of one spelling stay two members however many other symbols the program declares first.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/manysymbols_test.wac
//
// A symbol is nominal (spec ch21; spec case 0859): `tag` in `a.wac` and `tag` in `b.wac` are two symbols, and the
// emitter tells their members apart only because `symkeys.wac` counts how many files declare each spelling. It counted
// in a table of 256 that stopped recording, so a spelling past it was not seen to collide and the two symbols became
// one member — the program called the wrong method without a word (the sweep after `issues/lang/0468d`). Here `a.wac`
// declares 300 other symbols before its `tag`.

import { T } from "../../../wactest/src/assert.wac";
import { Sys } from "std";
import { Ran, runEmitted, scratchDir } from "./artifacts_probe.wac";

string aSource() {
  string out = "";
  for (i32 k = 0; k < 300; k++) { out = out + "export symbol s\{k};\n"; }
  return out + "export symbol tag;\n";
}

export string test_two_tags_are_two_members_after_three_hundred_symbols(Sys sys) {
  T t = T.create();
  string main = "import { tag as ta } from \"./a.wac\";\nimport { tag as tb } from \"./b.wac\";\n"
    + "struct S {\n  i32 [ta](const this) { return 1; }\n  i32 [tb](const this) { return 2; }\n}\n"
    + "export i32 main() { S s = S(); return s.[ta]() * 10 + s.[tb](); }\n";
  Ran r = runEmitted(sys.env(), sys.files(), sys.procs(), ["/t/main.wac", "/t/a.wac", "/t/b.wac"],
                     [main, aSource(), "export symbol tag;\n"], "/t/main.wac", scratchDir(sys.env(), sys.files()),
                     "manysymbols.wasm", 0, string[]());
  t.isTrue(r.ok, "the program built and ran — " + r.error + r.stderr);
  t.eqI32(r.status, 12, "each tag called its own member (11 or 22 is one member for both)");
  return t.report();
}
