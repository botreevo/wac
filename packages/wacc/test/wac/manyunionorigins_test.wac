// A bare `union` local keeps every type that flows into it, however many assignments come first.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/manyunionorigins_test.wac
//
// A bare `union` local's type is the union of what is assigned to it (spec ch33), gathered by the checker and again by
// the emitter. Both gathered into a fixed 64 that stopped recording, so the 65th assignment's type was left out —
// fixed in `check.wac` under `issues/lang/0468d`, and in the emitter by the sweep after it. Here 64 strings come first
// and a `bool` last.

import { T } from "../../../wactest/src/assert.wac";
import { Sys } from "std";
import { Ran, runEmittedOne, scratchDir } from "./artifacts_probe.wac";

string program() {
  string out = "i32 f() {\n  union u = \"s\";\n";
  for (i32 k = 0; k < 70; k++) { out = out + "  u = \"s\{k}\";\n"; }
  return out + "  u = true;\n  if (u is bool) { return 7; }\n  return 1;\n}\nexport i32 main() { return f(); }\n";
}

export string test_the_type_assigned_after_seventy_others_is_part_of_the_union(Sys sys) {
  T t = T.create();
  Ran r = runEmittedOne(sys.env(), sys.files(), sys.procs(), "/t/m.wac", program(), scratchDir(sys.env(), sys.files()),
                        "manyunion.wasm");
  t.isTrue(r.ok, "the program built and ran — " + r.error + r.stderr);
  t.eqI32(r.status, 7, "u holds the bool assigned last");
  return t.report();
}
