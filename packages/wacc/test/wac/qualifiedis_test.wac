// `x is A.Truncated` names `A`'s `Truncated`, whichever other `Truncated` the file can see. `issues/lang/0328a`.
//
//     wac test packages/wacc/test/wac/qualifiedis_test.wac
//
// spec ch13 `[§enum-is-qualified-8jkq4wp]`: `s is Shape.Circle` and `s is Circle` mean the same thing, so the
// qualification settles which variant is meant. The checker read only the variant's token and took the name from file
// scope, so importing a second enum with a `Truncated` — used nowhere — made it warn that the test was always false.
// Answered in-process by `diagnoseFiles`, the wire `wac check` renders.

import { T } from "../../../wactest/src/assert.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { diagnoseFiles } from "../../src/api.wac";

static string A = "export enum A { Truncated, Fine }\n";
static string B = "export enum B { Truncated, Fine }\n";

string checked(string entry) {
  return diagnoseFiles(["/t/a.wac", "/t/b.wac", "/t/r.wac"], [A, B, entry], "/t/r.wac");
}

export string test_a_qualified_variant_is_its_enums_whatever_else_is_imported() {
  T t = T.create();
  string alone = checked("import { A } from \"./a.wac\";\nexport i32 f(A x) { return x is A.Truncated ? 1 : 2; }\n");
  t.eqStr(alone, "", "the control: one Truncated in sight");
  string both = checked("import { A } from \"./a.wac\";\nimport { B } from \"./b.wac\";\n" +
                        "export i32 f(A x) { return x is A.Truncated ? 1 : 2; }\n" +
                        "export i32 g(B y) { return y is B.Truncated ? 1 : 2; }\n");
  t.eqStr(both, "", "with B's Truncated imported too, each test names its own enum's");
  return t.report();
}

/** And a test that really is always false still says so: the subject is a `B`, and the variant is `A`'s. */
export string test_a_qualified_variant_of_another_enum_is_still_never_true() {
  T t = T.create();
  string wrong = checked("import { A } from \"./a.wac\";\nimport { B } from \"./b.wac\";\n" +
                         "export i32 g(B y) { return y is A.Truncated ? 1 : 2; }\n");
  t.isTrue(contains(wrong, "warning"), "a B is never A's Truncated: \{wrong}");
  return t.report();
}
