// Two files' private generics of one name are two templates, and their instances two types — `issues/lang/0431d`.
//
// Each file's `Box<X>` was named `Box<X>` from the spellings, so one instance was made for both, with one file's
// layout, and the other's construction was refused (*a construction of Box<X> with 1 of 2 fields*). An instance is
// named from its template's key now, `Box@n` where two files share the name, as a generic function's already was.
//
// **Through the compiler, in memory**: a test file in this repository is declared in an order that hid the clash.
import { T } from "../../../wactest/src/assert.wac";
import { emitLinked } from "../../src/emit.wac";

export string test_two_files_generics_of_one_name_are_two_types() {
  T t = T.create();
  string a = "struct X { i32 a; }\nstruct Box<T> { T v; }\nexport struct Holder { Box<X> bx; }\n" +
             "export Holder mk() { return Holder(Box<X>(X(5))); }\nexport i32 readA(Holder h) { return h.bx.v.a; }\n";
  string b = "struct Box<T> { i32 tag; T v; }\nstruct X { string b; }\nexport struct HB { Box<X> bx; }\n" +
             "export HB mkb() { return HB(Box<X>(7, X(\"rr\"))); }\nexport i32 readB(HB h) { return h.bx.tag + h.bx.v.b.len(); }\n";
  string main = "import { mkb, readB } from \"./b.wac\";\nimport { mk, readA } from \"./a.wac\";\n" +
                "export i32 f() { return readA(mk()) * 100 + readB(mkb()); }\n";
  u8[] out = emitLinked(["/p/main.wac", "/p/a.wac", "/p/b.wac"], [main, a, b], "/p/main.wac");
  t.isTrue(out.len() > 8, "two files' private Box<X> build: \{out.len()} bytes");
  return t.report();
}
