// The specification's examples that are met stay met.
//
// `spec` is the definition and most of it is not implemented yet, so this cannot ask for every example.
// It asks for the ones `spec/_status/MET` lists — every example that was met when
// `packages/wacc/tools/specstatus.wac` last ran — and fails on any of them that is not met now. A change that
// meets more examples passes and says so; running the status program records them, and from then on they
// are held too.
//
// **In three files, a part of the chapters each** (`specPart` in `./specexamples.wac`): the examples were
// one test of about 130s, which a worker spent alone while the rest of the suite had finished. This file
// holds part 0 and the check that the parts cover every chapter; `specexamples1_test.wac` and
// `specexamples2_test.wac` hold the others.

import { Sys } from "std";
import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { exampleDocs, heldStillMet, inPart, specPart, specPartCount } from "./specexamples.wac";

export string test_every_spec_example_once_met_is_still_met(Sys sys) { return heldStillMet(sys, 0); }

/** Each top-level chapter directory holding an example is in exactly one part, or its examples go unjudged. */
export string test_the_parts_cover_every_chapter_once(Sys sys) {
  T t = T.create();
  string[] docs = exampleDocs(sys.files(), "spec");
  t.isTrue(docs.len() >= 40, "only " + itoa(docs.len()) + " spec documents found — the walk has moved");
  for (i32 d = 0; d < docs.len(); d++) {
    i32 owners = 0;
    for (i32 k = 0; k < specPartCount(); k++) {
      string[] parts = specPart(k);
      for (i32 p = 0; p < parts.len(); p++) {
        if (inPart(docs[d], parts[p])) { owners = owners + 1; }
      }
    }
    t.eqI32(owners, 1, docs[d] + " is in " + itoa(owners) + " parts of `specPart`, not one");
  }
  return t.report();
}
