/**
 * WebRTC data channels, as one thing: ICE checks, DTLS, the SCTP association and DCEP joined.
 *
 * **Everything below this file is a codec or one layer's state machine, and joining them was left to the
 * caller.** That worked while the only caller was a test, and it meant a program wanting a data channel had to
 * reimplement seven hundred lines of ordering: which datagram is a STUN check and which is DTLS, where an
 * application record sits inside a datagram, that DCEP's open must be answered before anything will flow, that a
 * channel closes by resetting a stream. None of that is a decision a user of this package should be making.
 *
 * So this is the consumer. `receive` takes a datagram and answers with the datagrams to send; `send`, `open` and
 * `close` take a channel and answer the same way; `events` says what happened — a channel opened (by either end),
 * a message, a channel closed, the association up or down. What a caller supplies is a socket and a clock.
 *
 * **Many channels, each with its own reliability**, as RFC 8831 has them: ordered or not, reliable or limited to
 * a number of retransmissions. A channel is opened in band with DCEP (RFC 8832) — the opener picks an even stream
 * id if it is the DTLS client and an odd one if the server — or *negotiated*: both ends declare it with the same
 * id and nothing crosses the wire to open it. KPS uses both: two negotiated channels for its control and
 * datagrams, and one DCEP channel per stream.
 *
 * **It does not own the signalling.** `sdp.wac` builds the description and reads the peer's; the fingerprint, the
 * ICE fragments and the passwords are handed in rather than negotiated here.
 */

import { Map, Vec, hashI32, i32Eq } from "core";
import { Association, SctpEvent } from "./association.wac";
import { Consent, checkRejected, successFor } from "./ice.wac";
import { Peer } from "./peer.wac";
import { hexColons } from "./sdp.wac";
import { sha256 } from "../../crypto/src/sha256.wac";
import { recordSize } from "./dtls.wac";
import { checksumOk, ppidDcep, ppidString, ppidBinary, ppidStringEmpty, ppidBinaryEmpty, dcepOpenMessage,
         dcepAckMessage, dcepOpen, dcepAck } from "./sctp.wac";

/** DCEP channel types (RFC 8832 §5.1): the high bit is unordered; the low bits name the reliability. */
export static i32 CHANNEL_RELIABLE = 0x00;
export static i32 CHANNEL_PARTIAL_RELIABLE_REXMIT = 0x01;
export static i32 CHANNEL_PARTIAL_RELIABLE_TIMED = 0x02;
export static i32 CHANNEL_UNORDERED = 0x80;

/** What happened, for the layer above. */
export enum ChannelEvent {
  /** The association is up: channels may be opened and negotiated ones used. */
  Up,
  /** The peer opened a channel with DCEP. */
  Opened(i32 id, string label, bool ordered, i32 maxRetransmits),
  /** A channel we opened was acknowledged. */
  Acked(i32 id),
  /** A whole message on a channel: `binary` unless the peer sent a string. */
  Message(i32 id, bool binary, u8[] data),
  /** A channel closed — both directions reset — whichever end began it. */
  Closed(i32 id),
  /** The association ended. */
  Down(bool aborted),
}

/** One channel's settings and where its close has got to. */
struct Channel {
  bool ordered;
  /** -1 for reliable. */
  i32 maxRetransmits;
  bool closingOut;
  bool closedOut;
  bool closedIn;
}

export struct Session {
  Peer peer;
  Association assoc;
  Consent consent;
  string ourUfrag;
  string ourPwd;
  string theirUfrag;
  string theirPwd;
  /**
   * The peer's certificate fingerprint, as its SDP's `a=fingerprint` line spells it.
   *
   * **Empty means refuse, not allow.** A session with nothing to compare against cannot tell the peer it was
   * told about from anyone else who completed a handshake.
   */
  string expectFingerprint;
  /** Whether this end is the DTLS client: decides the parity of the stream ids it opens channels on. */
  bool dtlsClient;
  Map<i32, Channel> channels = Map<i32, Channel>.create(hashI32, i32Eq);
  Vec<ChannelEvent> happened = Vec<ChannelEvent>.create();
  i32 checksAnswered = 0;

  Session of(Peer peer, Association assoc, Consent consent, string ourUfrag, string ourPwd,
             string theirUfrag, string theirPwd, string expectFingerprint) {
    return Session { peer: peer, assoc: assoc, consent: consent, ourUfrag: ourUfrag, ourPwd: ourPwd,
                     theirUfrag: theirUfrag, theirPwd: theirPwd, expectFingerprint: expectFingerprint,
                     dtlsClient: false };
  }

  /**
   * Whether the peer is the one the signalling channel named: it proved possession of a key (`Peer` refuses to
   * establish otherwise), and that key's certificate is the one the SDP promised.
   */
  bool peerIsExpected(const this) {
    if (this.expectFingerprint.len() == 0) { return false; }
    if (!this.peer.peerAuthenticated()) { return false; }
    const u8[] der = this.peer.peerCertificate();
    if (der.len() == 0) { return false; }
    return hexColons(sha256(der)) == this.expectFingerprint;
  }

  // ─────────────────────────────────────────────────────────────────────────────────────── the wire ───

  /**
   * Answer one datagram with the datagrams to send. **Classified by shape, not by state**: a STUN message begins
   * 0x00 or 0x01 and a DTLS record 20 to 63, which is how they share a port at all.
   */
  u8[][] receive(this, u8[] datagram, u8[] fromIp, i32 fromPort, i64 now) {
    if (datagram.len() == 0) { return u8[][](); }
    if (datagram[0] < 20) { return this.stun(datagram, fromIp, fromPort, now); }
    if (datagram[0] > 63) { return u8[][](); }
    Vec<u8[]> out = Vec<u8[]>.create();
    u8[][] flights = this.peer.receive(datagram);
    for (i32 i = 0; i < flights.len(); i++) { out.push(flights[i]); }
    // **Nothing crosses until the peer is the one the SDP named.** The handshake may run — refusing it is
    // `Peer`'s job — but application data is where a wrong peer would actually get something.
    if (!this.peerIsExpected()) { return out.toArray(); }
    i32 at = 0;
    while (recordSize(datagram, at) > 0) {
      u8[] sctp = this.peer.application(datagram, at);
      if (sctp.len() > 0 && checksumOk(sctp)) { this.assoc.receive(sctp, now); }
      at = at + recordSize(datagram, at);
    }
    this.react(now);
    this.drain(out);
    return out.toArray();
  }

  /** A connectivity check to answer, or a response to a consent check we sent. */
  u8[][] stun(this, u8[] datagram, u8[] fromIp, i32 fromPort, i64 now) {
    if (checkRejected(datagram, this.ourUfrag, this.theirUfrag, this.ourPwd.toBytes()) == 0) {
      this.checksAnswered = this.checksAnswered + 1;
      u8[][] out = u8[][].defaulted(1);
      out[0] = successFor(transactionOf(datagram), this.ourPwd.toBytes(), fromIp.len() == 16 ? 2 : 1, fromIp, fromPort);
      return out;
    }
    this.consent.answered(datagram, this.theirPwd.toBytes(), now);
    return u8[][]();
  }

  /** Whatever the timers say is due — retransmissions, the window's release — sealed and ready to send. */
  u8[][] tick(this, i64 now) {
    Vec<u8[]> out = Vec<u8[]>.create();
    if (!this.peerIsExpected()) { return out.toArray(); }
    this.assoc.tick(now);
    this.react(now);
    this.drain(out);
    return out.toArray();
  }

  /** The association's packets, each in its own DTLS record. */
  void drain(this, Vec<u8[]> out) {
    u8[][] pkts = this.assoc.take();
    for (i32 i = 0; i < pkts.len(); i++) { out.push(this.peer.sealApplication(pkts[i])); }
  }

  /** What happened since the last call, taken. */
  ChannelEvent[] events(this) {
    ChannelEvent[] a = this.happened.toArray();
    this.happened = Vec<ChannelEvent>.create();
    return a;
  }

  // ─────────────────────────────────────────────────────────────────────────────────────── channels ───

  /**
   * Declare a negotiated channel: both ends use `id` with these settings and nothing is sent to open it
   * (RFC 8831 §6.5's "negotiated" — KPS's control channel is id 0, its datagram channel id 1).
   */
  void negotiate(this, i32 id, bool ordered, i32 maxRetransmits) {
    this.channels.set(id, Channel(ordered, maxRetransmits, false, false, false));
  }

  /**
   * Open a channel with DCEP: a free id of this end's parity, and a DATA_CHANNEL_OPEN on it. Data may follow at
   * once — the open goes first on the same ordered stream, so the peer has the channel before the data. Answers
   * the id, the datagrams to send going into `out`; -1 if the association is not up.
   */
  i32 open(this, string label, bool ordered, i32 maxRetransmits, i64 now, Vec<u8[]> out) {
    if (!this.assoc.established() || !this.peerIsExpected()) { return -1; }
    i32 id = this.dtlsClient ? 0 : 1;
    while (this.channels.has(id) && id < 65534) { id += 2; }
    if (this.channels.has(id)) { return -1; }
    this.channels.set(id, Channel(ordered, maxRetransmits, false, false, false));
    i32 type = (ordered ? 0 : CHANNEL_UNORDERED) | (maxRetransmits >= 0 ? CHANNEL_PARTIAL_RELIABLE_REXMIT : CHANNEL_RELIABLE);
    u8[] msg = dcepOpenMessage(type, 0, maxRetransmits >= 0 ? maxRetransmits : 0, label, "");
    // DCEP messages travel ordered and reliable whatever the channel is (RFC 8832 §6).
    this.assoc.send(id, ppidDcep(), msg, false, -1, now);
    this.drain(out);
    return id;
  }

  /**
   * Send a message on a channel, as the datagrams that carry it — fewer than the message needs when the congestion
   * window is shut; the rest go out from `tick` as acknowledgements open it. An empty message is sent as the one
   * byte RFC 8831 §6.6 prescribes, with the PPID that says it is empty.
   */
  u8[][] send(this, i32 id, u8[] payload, bool binary, i64 now) {
    Vec<u8[]> out = Vec<u8[]>.create();
    Channel? ch = this.channels.get(id);
    if (ch is null || ch!.closingOut || !this.peerIsExpected()) { return out.toArray(); }
    i32 ppid = payload.len() == 0 ? (binary ? ppidBinaryEmpty() : ppidStringEmpty()) : (binary ? ppidBinary() : ppidString());
    u8[] body = payload.len() == 0 ? u8[].filled(1, 0) : payload;
    this.assoc.send(id, ppid, body, !ch!.ordered, ch!.maxRetransmits, now);
    this.drain(out);
    return out.toArray();
  }

  /** Close a channel: reset its outgoing stream. `Closed` follows once the peer has reset its own. */
  u8[][] close(this, i32 id, i64 now) {
    Vec<u8[]> out = Vec<u8[]>.create();
    Channel? ch = this.channels.get(id);
    if (ch is null || ch!.closingOut) { return out.toArray(); }
    ch!.closingOut = true;
    this.assoc.resetStream(id, now);
    this.drain(out);
    return out.toArray();
  }

  /** Whether `id` is a channel this session knows: opened by either end, or negotiated, and not yet closed. */
  bool hasChannel(const this, i32 id) { return this.channels.has(id); }

  /** Turn the association's events into channel events, answering DCEP and resets as they come. */
  void react(this, i64 now) {
    SctpEvent[] es = this.assoc.events();
    for (i32 i = 0; i < es.len(); i++) {
      match (es[i]) {
        Up: { this.happened.push(ChannelEvent.Up); }
        Down(aborted): { this.happened.push(ChannelEvent.Down(aborted)); }
        Message(id, ppid, data): { this.message(id, ppid, data, now); }
        Reset(id): {
          // The peer reset its outgoing stream: the far end closed the channel. Reset ours back if we have not
          // (RFC 8831 §6.7); the channel is closed when both directions are.
          Channel? ch = this.channels.get(id);
          if (ch is null) { continue; }
          ch!.closedIn = true;
          if (!ch!.closingOut) {
            ch!.closingOut = true;
            this.assoc.resetStream(id, now);
          }
          this.closedIfBoth(id, ch!);
        }
        ResetDone(id): {
          Channel? ch = this.channels.get(id);
          if (ch is null) { continue; }
          ch!.closedOut = true;
          this.closedIfBoth(id, ch!);
        }
      }
    }
  }

  void closedIfBoth(this, i32 id, Channel ch) {
    if (!ch.closedIn || !ch.closedOut) { return; }
    this.channels.remove(id);
    this.happened.push(ChannelEvent.Closed(id));
  }

  void message(this, i32 id, i32 ppid, u8[] data, i64 now) {
    if (ppid == ppidDcep()) {
      if (data.len() >= 12 && data[0] as i32 == dcepOpen()) {
        // **Nothing flows until this is answered** — a browser fires its `open` only on the ACK.
        i32 type = data[1] as i32;
        i32 reliability = (data[4] as i32 << 24) | (data[5] as i32 << 16) | (data[6] as i32 << 8) | data[7] as i32;
        bool ordered = (type & CHANNEL_UNORDERED) == 0;
        i32 rexmit = (type & 0x7F) == CHANNEL_PARTIAL_RELIABLE_REXMIT ? reliability : -1;
        this.channels.set(id, Channel(ordered, rexmit, false, false, false));
        this.assoc.send(id, ppidDcep(), dcepAckMessage(), false, -1, now);
        this.happened.push(ChannelEvent.Opened(id, labelOf(data), ordered, rexmit));
      } else if (data.len() > 0 && data[0] as i32 == dcepAck()) {
        this.happened.push(ChannelEvent.Acked(id));
      }
      return;
    }
    if (!this.channels.has(id)) { return; }                    // a stream nobody opened or negotiated
    bool empty = ppid == ppidStringEmpty() || ppid == ppidBinaryEmpty();
    bool binary = ppid == ppidBinary() || ppid == ppidBinaryEmpty();
    this.happened.push(ChannelEvent.Message(id, binary, empty ? u8[]() : data));
  }

  /** How many of the peer's connectivity checks we have answered. */
  i32 checks(const this) { return this.checksAnswered; }
}

/** A STUN message's transaction id — bytes 8 through 19. */
u8[] transactionOf(u8[] msg) {
  if (msg.len() < 20) { return u8[](); }
  u8[] out = u8[].filled(12, 0);
  out.copyFrom(msg, 8, 0, 12);
  return out;
}

/**
 * The label out of a DCEP DATA_CHANNEL_OPEN. The message is a twelve-byte prologue, then the label, then the
 * protocol, with both lengths in the prologue — so the label is not null-terminated.
 */
string labelOf(u8[] msg) {
  if (msg.len() < 12) { return ""; }
  i32 labelLen = (msg[8] as i32 << 8) | msg[9] as i32;
  if (msg.len() < 12 + labelLen) { return ""; }
  u8[] out = u8[].filled(labelLen, 0);
  out.copyFrom(msg, 12, 0, labelLen);
  return string.fromBytes(out);
}
