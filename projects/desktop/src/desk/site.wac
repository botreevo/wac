// **A site built on the desktop**: what a page of its own adds to it — its own words on the wallpaper, its own links in
// the taskbar, what a first visit opens — as the wac website does. The desktop's own page adds nothing (`plain`).

import { Frame, Node, Ui } from "web";
import { phoneQuery } from "./wm.wac";

/** A link in the taskbar: its words, where it goes, and what a pointer resting on it says. */
export struct DeskLink {
  string label;
  string href;
  string title;
}

export struct DeskSite {
  /**
   * **What the site says first**, drawn on the wallpaper beside the icons, and at the top of a phone's home screen —
   * the same before the desktop is ready and after, so it is in the first frame drawn at build time and that node is
   * kept. Null for nothing there.
   */
  fn<Node(Ui)>? intro;
  /** Links in the taskbar, there whatever the windows cover. */
  DeskLink[] links;
  /** Whether a first visit opens the welcome note: on a desktop, and on a phone, where it covers the home screen. */
  bool welcome;
  bool welcomeOnPhone;

  /** The desktop as its own page: nothing added, and the welcome note opened the first time. */
  DeskSite plain() { return DeskSite(null, DeskLink[](), true, true); }
}

/**
 * **The desktop's first frames for the page at `path`**: a phone's, shown to the windows `phoneQuery` matches — the
 * rule the desktop goes by (`phoneAt`) — and a desktop's for the rest. What a page built on it exports as its
 * `prerendered()`, one pair for each of its pages.
 */
export Frame[] framesAt(string path) {
  return [Frame.on(path, 390, 844, phoneQuery()), Frame.on(path, 1280, 800, "")];
}
