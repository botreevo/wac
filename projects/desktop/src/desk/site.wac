// **A site built on the desktop**: what a page of its own adds to it — its own words on the wallpaper, its own links in
// the taskbar, what a first visit opens — as the wac website does. The desktop's own page adds nothing (`plain`).

import { Frame, Node, Page, Ui } from "web";
import { SiteEntry, phoneQuery } from "./wm.wac";

/**
 * A link in the taskbar: its words, where it goes, and what a pointer resting on it says. An `href` that starts with `/`
 * is a path on the site, which the desktop writes relative to the page it is on (`hrefTo`).
 */
export struct DeskLink {
  string label;
  string href;
  string title;
}

/**
 * **What a site's app is handed to draw its window**: the page it shows, and the ways to go elsewhere. Links are the
 * usual way — `<a href={hrefTo(win.path, "/tour/next/")}>` — which the desktop follows in the page, and which are pages
 * of their own before any script and to a search engine (`framesAt`).
 */
export struct SiteWin {
  /** What the window shows: its page's path after the app's prefix, without the last `/` — `hello` at `/tour/hello/`. */
  string arg;
  /** That page's whole path on the site, for links from it (`hrefTo`). */
  string path;
  /** Whether the desktop is a phone's, where the window fills the screen. */
  bool phone;
  Page page;
  /** Go to the page at `path` on the site — in this window, or another app's — as a link to it would. */
  fn<void(string)> show;
  /**
   * **Something to take away**: `bytes` written to the desktop's disk at `path`, then opened with the desktop's app
   * `with` — "viewer", "editor", "files" (its folder), or "ide", the wac IDE on its projects, which a project written
   * under `Projects/` is one of. `""` writes it and opens nothing: one file of several, before the last.
   */
  fn<void(string, u8[], string)> keep;
  /** One of the desktop's apps started on `arg`: `start("terminal", "Desktop")`, a shell in that folder. */
  fn<void(string, string)> start;
}

/** **One of a site's apps**: a window the site draws, its pages the paths that start with `prefix`. */
export struct SiteApp {
  /** Its name among the site's apps; its windows are app `site:<id>`. */
  string id;
  /** The launcher's group it is in — a site's groups come first — its icon (one of the desktop's), title and line. */
  string group;
  string icon;
  string title;
  string sub;
  /** Where its pages are on the site: `/tour/`, with `/tour/hello/` its page `hello`. */
  string prefix;
  /** Its window's size, on a screen with room for it. */
  i32 w;
  i32 h;
  /** Whether it has an icon on the desktop, as well as in the launcher. */
  bool onDesktop;
  /** Its window's contents: a component, handed the page it shows. */
  fn<Node(Ui, SiteWin)> draw;
  /** Its page's title and description at `arg`: what the tab says and a search engine shows, while it is in front. */
  fn<string(string)> titleOf;
  fn<string(string)> describe;

  /** As the desktop keeps it (`SiteEntry`). */
  SiteEntry entry(this) { return SiteEntry(this.id, this.group, this.icon, this.title, this.sub, this.prefix, this.w, this.h, this.onDesktop); }
}

export struct DeskSite {
  /**
   * **What the site says first**, drawn on the wallpaper beside the icons, and at the top of a phone's home screen —
   * the same before the desktop is ready and after, so it is in the first frame drawn at build time and that node is
   * kept. Null for nothing there.
   */
  fn<Node(Ui)>? intro;
  /** Links in the taskbar, there whatever the windows cover. */
  DeskLink[] links;
  /** Whether a first visit opens the welcome note: on a desktop, and on a phone, where it covers the home screen. */
  bool welcome;
  bool welcomeOnPhone;
  /** Its apps: windows it draws, each with its pages, offered in the launcher, on the desktop and at their paths. */
  SiteApp[] apps;
  /** The page's title and description while none of its apps is in front — at its root. */
  string title;
  string description;

  /** The desktop as its own page: nothing added, and the welcome note opened the first time. */
  DeskSite plain() { return DeskSite(null, DeskLink[](), true, true, SiteApp[](), "", ""); }

  /** The app whose windows are `app` — `site:<id>` — if it is one of this site's. */
  SiteApp? app(this, string app) {
    for (SiteApp a in this.apps) { if ("site:" + a.id == app) { return a; } }
    return null;
  }
}

/**
 * **The desktop's first frames for the page at `path`**: a phone's, shown to the windows `phoneQuery` matches — the
 * rule the desktop goes by (`phoneAt`) — and a desktop's for the rest. What a page built on it exports as its
 * `prerendered()`, one pair for each of its pages.
 */
export Frame[] framesAt(string path) {
  return [Frame.on(path, 390, 844, phoneQuery()), Frame.on(path, 1280, 800, "")];
}
