// The desktop's page: windows, a taskbar and a disk of its own, in a browser tab.

import { Frame, Page, Ui } from "web";
import { Desktop } from "./desk/shell.wac";
import { DeskSite, framesAt } from "./desk/site.wac";

/** **The first frames drawn at build time**: a phone's and a desktop's, so the page is there before its module is. */
export Frame[] prerendered() { return framesAt("/"); }

export async i32 main(Page page) {
  page.title("Desktop");
  page.mount((Ui ui) => <Desktop page={page} site={DeskSite.plain()}/>);
  return 0;
}
