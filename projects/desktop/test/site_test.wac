// A site built on the desktop (`src/desk/site.wac`): its first frames, and the rule the phone's is shown by — which must
// be the desktop's own, or the browser shows one layout and the program draws the other.

import { Frame } from "web";
import { framesAt } from "../src/desk/site.wac";
import { PHONE_HEIGHT, PHONE_SIDEWAYS, PHONE_WIDTH, phoneAt, phoneQuery } from "../src/desk/wm.wac";

export string test_the_phone_query_is_the_desktops_rule() {
  string q = phoneQuery();
  if (q != "(max-width: \{PHONE_WIDTH - 1}.98px), (max-height: \{PHONE_HEIGHT - 1}.98px) and (max-width: \{PHONE_SIDEWAYS - 1}.98px)") {
    return "the query: " + q;
  }
  // Each side of each threshold, as the rule says it: a phone, a phone on its side, a short desktop, a desktop.
  if (!phoneAt(390.0, 844.0) || !phoneAt(699.0, 900.0) || phoneAt(700.0, 900.0)) { return "the width"; }
  if (!phoneAt(844.0, 390.0) || phoneAt(1000.0, 400.0) || phoneAt(1280.0, 499.0)) { return "a phone on its side, and a short desktop"; }
  return "";
}

export string test_each_page_has_a_phones_frame_and_a_desktops() {
  Frame[] f = framesAt("/docs/a/");
  if (f.len() != 2) { return "\{f.len()} frames"; }
  if (f[0].path != "/docs/a/" || f[1].path != "/docs/a/") { return "the frames are not the page's"; }
  if (f[0].media != phoneQuery() || !phoneAt(f[0].width as f64, f[0].height as f64)) { return "the first is not the phone's"; }
  if (f[1].media != "" || phoneAt(f[1].width as f64, f[1].height as f64)) { return "the second is not the desktop's, for any window"; }
  return "";
}
