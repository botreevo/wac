{
  // **wac-desktop as a package** (`src/lib.wac`): the desktop, for a site built on it, as the wac website is.
  exports: './src/lib.wac',
  imports: {
    // The rest of wac, as one dependency — `import { json.parse, fs.Fs } from "wac"` — read only as far
    // as a program reaches into it.
    wac: { git: 'https://github.com/voltrevo/wac.git', ref: 'a1814151addb658707145db3e82fbdf228d3c934' },
    // The page a program is handed — `import { Page, Event } from "web"` — a repository of its own since 2026-10-29.
    web: { git: 'https://github.com/voltrevo/wac-web.git', ref: '6d0916180149705cfb9176e87c992d992bf0899b' },
    // The wac IDE, which the build makes one of the desktop's programs (`src/apps/ide.wac`).
    ide: { git: 'https://github.com/voltrevo/wac-ide.git', ref: 'cf4f5abe8555e69f142206edd656a8624da8251d' },
    // The page builder `build.wac` calls — a program, so building needs nothing but `wac`.
    webbuild: { git: 'https://github.com/voltrevo/wac-web.git', ref: '6d0916180149705cfb9176e87c992d992bf0899b', subdir: './tools' },
  },
}
