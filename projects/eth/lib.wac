// wac-eth as a dependency: a namespace per package, and the execution client.
//
//     import { mpt.storageAt, ethrpc.proofOfSlots, rlp.encode, wacuum.Engine } from "eth";
//
// A build reads only the files a program reaches through these, so depending on all of it costs what depending on
// one package would.
export * as abi from "./packages/abi/src/abi.wac";
export * as ens from "./packages/ens/src/lib.wac";
export * as ethrpc from "./packages/ethrpc/src/lib.wac";
export * as ipfs from "./packages/ipfs/src/lib.wac";
export * as lightclient from "./packages/lightclient/src/lib.wac";
export * as mpt from "./packages/mpt/src/lib.wac";
export * as rlp from "./packages/rlp/src/rlp.wac";
export * as ssz from "./packages/ssz/src/lib.wac";
export * as wacuum from "./packages/wacuum/src/lib.wac";
