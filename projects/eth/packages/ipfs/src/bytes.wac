// Small byte-array tools the codecs share.

/** A growable byte buffer: append, then `bytes()`. */
export struct Out {
  u8[] buf;
  i32 n = 0;

  Out create() { return Out(u8[].filled(64, 0), 0); }

  void room(this, i32 more) {
    if (this.n + more <= this.buf.len()) { return; }
    i32 cap = this.buf.len() * 2;
    while (cap < this.n + more) { cap = cap * 2; }
    u8[] next = u8[].filled(cap, 0);
    for (i32 i = 0; i < this.n; i++) { next[i] = this.buf[i]; }
    this.buf = next;
  }

  void byte(this, u8 b) { this.room(1); this.buf[this.n] = b; this.n++; }

  void all(this, const u8[] b) {
    this.room(b.len());
    for (i32 i = 0; i < b.len(); i++) { this.buf[this.n + i] = b[i]; }
    this.n += b.len();
  }

  /** Unsigned LEB128, as multiformats and protobuf both write integers. */
  void varint(this, i64 v) {
    i64 x = v;
    while (true) {
      i64 low = x & (127 as i64);
      x = x >>> (7 as i64);
      if (x == (0 as i64)) { this.byte(low as@ u8); return; }
      this.byte((low | (128 as i64)) as@ u8);
    }
  }

  u8[] bytes(this) {
    u8[] out = u8[].filled(this.n, 0);
    for (i32 i = 0; i < this.n; i++) { out[i] = this.buf[i]; }
    return out;
  }
}

/** A reading position in bytes; `bad` is set, never thrown, when input runs out or is malformed. */
export struct In {
  u8[] b;
  i32 at = 0;
  i32 end = 0;
  string bad = "";

  In of(u8[] b) { return In(b, 0, b.len(), ""); }
  In span(u8[] b, i32 from, i32 to) { return In(b, from, to, ""); }

  bool done(const this) { return this.at >= this.end; }

  void fail(this, string why) { if (this.bad == "") { this.bad = why; } this.at = this.end; }

  u8 byte(this) {
    if (this.at >= this.end) { this.fail("unexpected end of input"); return 0; }
    u8 v = this.b[this.at];
    this.at++;
    return v;
  }

  u8[] take(this, i32 len) {
    if (len < 0 || this.at + len > this.end) { this.fail("a length runs past the end of the input"); return u8[](); }
    u8[] out = u8[].filled(len, 0);
    for (i32 i = 0; i < len; i++) { out[i] = this.b[this.at + i]; }
    this.at += len;
    return out;
  }

  /** Unsigned LEB128, refusing a non-minimal encoding (a trailing zero byte) and anything past 63 bits. */
  i64 varint(this) {
    i64 v = 0 as i64;
    i32 shift = 0;
    i32 count = 0;
    while (true) {
      u8 c = this.byte();
      if (this.bad != "") { return 0 as i64; }
      count++;
      if (shift == 63 && (c & 0x7e) != 0) { this.fail("a varint larger than 63 bits"); return 0 as i64; }
      v = v | (((c & 0x7f) as i64) << (shift as i64));
      if ((c & 0x80) == 0) {
        if (count > 1 && c == 0) { this.fail("a varint that is not minimally encoded"); return 0 as i64; }
        return v;
      }
      shift += 7;
      if (shift > 63) { this.fail("a varint larger than 63 bits"); return 0 as i64; }
    }
  }
}

export bool same(const u8[] a, const u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) { if (a[i] != b[i]) { return false; } }
  return true;
}

/** Bytewise comparison: negative, zero or positive. */
export i32 compare(const u8[] a, const u8[] b) {
  i32 n = a.len() < b.len() ? a.len() : b.len();
  for (i32 i = 0; i < n; i++) {
    if (a[i] != b[i]) { return (a[i] as i32) - (b[i] as i32); }
  }
  return a.len() - b.len();
}

export u8[] slice(const u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  for (i32 i = from; i < to; i++) { out[i - from] = b[i]; }
  return out;
}

export u8[] concat(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  for (i32 i = 0; i < a.len(); i++) { out[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { out[a.len() + i] = b[i]; }
  return out;
}
