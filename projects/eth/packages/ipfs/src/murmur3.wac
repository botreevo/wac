// MurmurHash3, x64 128-bit, seed 0: the hash a UnixFS HAMT places directory entries by (multihash code 0x22).
//
// Written out as @multiformats/murmur3 writes it, which is what the reference importer uses: h1 then h2, each as eight
// big-endian bytes. A HAMT reads only the first eight (see `hamtByte`).

u64 le64(u8[] b, i32 at) {
  u64 v = 0 as u64;
  for (i32 i = 7; i >= 0; i--) { v = (v << 8) | (b[at + i] as u64); }
  return v;
}

u64 rotl(u64 x, u64 r) { return (x << r) | (x >> ((64 as u64) - r)); }

u64 fmix(u64 k0) {
  u64 k = k0;
  k = k ^ (k >> 33);
  k = k * 0xff51afd7ed558ccd;
  k = k ^ (k >> 33);
  k = k * 0xc4ceb9fe1a85ec53;
  k = k ^ (k >> 33);
  return k;
}

/** The 16-byte MurmurHash3 x64 128 of `data`, seed 0: h1 then h2, big-endian. Unsigned arithmetic wraps. */
export u8[] murmur3x64(u8[] data) {
  u64 c1 = 0x87c37b91114253d5;
  u64 c2 = 0x4cf5ad432745937f;
  u64 h1 = 0 as u64;
  u64 h2 = 0 as u64;
  i32 blocks = data.len() / 16;
  for (i32 i = 0; i < blocks; i++) {
    u64 k1 = le64(data, i * 16);
    u64 k2 = le64(data, i * 16 + 8);
    k1 = k1 * c1; k1 = rotl(k1, 31 as u64); k1 = k1 * c2; h1 = h1 ^ k1;
    h1 = rotl(h1, 27 as u64); h1 = h1 + h2; h1 = h1 * (5 as u64) + (0x52dce729 as u64);
    k2 = k2 * c2; k2 = rotl(k2, 33 as u64); k2 = k2 * c1; h2 = h2 ^ k2;
    h2 = rotl(h2, 31 as u64); h2 = h2 + h1; h2 = h2 * (5 as u64) + (0x38495ab5 as u64);
  }
  i32 tail = blocks * 16;
  i32 rest = data.len() - tail;
  u64 t1 = 0 as u64;
  u64 t2 = 0 as u64;
  for (i32 i = rest - 1; i >= 8; i--) { t2 = (t2 << 8) | (data[tail + i] as u64); }
  for (i32 i = (rest < 8 ? rest : 8) - 1; i >= 0; i--) { t1 = (t1 << 8) | (data[tail + i] as u64); }
  if (rest > 8) { t2 = t2 * c2; t2 = rotl(t2, 33 as u64); t2 = t2 * c1; h2 = h2 ^ t2; }
  if (rest > 0) { t1 = t1 * c1; t1 = rotl(t1, 31 as u64); t1 = t1 * c2; h1 = h1 ^ t1; }
  u64 len = data.len() as! u64;
  h1 = h1 ^ len;
  h2 = h2 ^ len;
  h1 = h1 + h2;
  h2 = h2 + h1;
  h1 = fmix(h1);
  h2 = fmix(h2);
  h1 = h1 + h2;
  h2 = h2 + h1;
  u8[] out = u8[].filled(16, 0);
  for (i32 i = 0; i < 8; i++) {
    out[i] = ((h1 >> (((7 - i) * 8) as! u64)) & (255 as u64)) as@ u8;
    out[8 + i] = ((h2 >> (((7 - i) * 8) as! u64)) & (255 as u64)) as@ u8;
  }
  return out;
}

/**
 * The slot a HAMT of fanout 256 puts `name` in at `depth`: a byte of its hash. The reference takes the first eight
 * bytes of the murmur3 output reversed, then reads bytes from the end, so depth k is byte k of the output. Past eight
 * levels it hashes `name` with the byte `depth / 8` appended, and carries on the same way.
 */
export i32 hamtByte(u8[] name, i32 depth) {
  i32 round = depth / 8;
  u8[] input = name;
  if (round > 0) {
    input = u8[].filled(name.len() + 1, 0);
    for (i32 i = 0; i < name.len(); i++) { input[i] = name[i]; }
    input[name.len()] = round as@ u8;
  }
  return murmur3x64(input)[depth % 8] as i32;
}
