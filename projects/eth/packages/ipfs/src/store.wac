// Blocks kept under their CIDs, and objects moved in and out of them with every block checked.
//
// A store is two functions over relative paths, so the same code runs over a directory on disk and over memory in
// the tests. Blocks live at `ipfs/<cid>` — the path a trustless IPFS gateway answers as `/ipfs/<cid>?format=raw`, so a
// directory laid out this way, served by any static web server, *is* a resolver.
//
// Nothing read is believed: `get` re-hashes what it reads, so a store whose disk was edited behind its back, or a
// mirror that serves other bytes, is caught at the block, wherever it came from. That is what lets `http` read from
// any trustless gateway, or any web server in front of a store directory, without trusting it.

import { Files, Procs, ChildEnv, Launch, Net } from "std";
import { http.get, http.Incoming, fetch.fetch, fetch.Caps } from "wac";
import { Result, flatten } from "core";
import { Cid, parseCid, RAW, DAG_PB } from "./cid.wac";
import { Params, Built, Block, Node, readNode, slotLabel } from "./unixfs.wac";
import { hamtByte } from "./murmur3.wac";
import { FileIn, buildTree } from "./tree.wac";
import { readCar } from "./car.wac";
import { Link, pushLink } from "./dagpb.wac";
import { Out } from "./bytes.wac";

export struct Store {
  fn<u8[]?(string)> read;
  fn<bool(string, u8[])> write;

  /** A directory on disk. */
  Store dir(Files fs, string root) {
    return Store(
      (string p) => flatten(fs.readFile(root + "/" + p).wait()).ok(),
      (string p, u8[] b) => {
        // The directory the path names, made first: `ipfs/` for blocks, and anything else a caller keeps here
        // (`claims/index`). Found when the first thing written to a fresh store was not a block.
        i32 slash = -1;
        for (i32 i = 0; i < p.len(); i++) { if (p.slice(i, i + 1) == "/") { slash = i; } }
        flatten(fs.mkdir(slash < 0 ? root : root + "/" + p.slice(0, slash), true).wait());
        return flatten(fs.writeFile(root + "/" + p, b).wait()).isOk();
      });
  }

  /**
   * A trustless gateway at `host:port`, read-only: a block is `GET /ipfs/<cid>?format=raw` (the gateway spec's raw
   * block request), and anything else a caller keeps beside the blocks (`claims/index`) is `GET /<path>`. A static web
   * server in front of a store directory answers the same requests, since it ignores the query. An answer other than
   * 200 is "not here"; what a 200 says is re-hashed by `get` like any other block, so the server is trusted only to
   * be there.
   *
   * **A mirror that fails is asked nothing more.** No answer at all, or a 5xx (a gateway whose own origin is down
   * answers 502, 504, 522 or 526, often slowly), marks it down for as long as this store lives, and every later read
   * is "not here" at once. Otherwise each block of a tree would wait on it again. A 404 is an answer, not a failure.
   */
  Store http(Net net, string host, i32 port) {
    bool down = false;
    return Store(
      (string p) => {
        u8[]? none = null;
        if (down) { return none; }
        string path = "/" + p + (p.indexOf("ipfs/") == 0 ? "?format=raw" : "");
        match (get(net, host, port, path)) {
          Err(_): { down = true; return none; }
          Ok(res): { if (res.status >= 500) { down = true; } return res.status == 200 ? res.body : none; }
        }
      },
      (string p, u8[] b) => false);
  }

  /**
   * A trustless gateway over HTTPS at `base` (`https://host[:port]`), read-only, through wac's `fetch`: TLS checked
   * against the trust store, and the proxy the environment names. The same requests as `http`: a block is
   * `GET /ipfs/<cid>?format=raw` asking for `application/vnd.ipld.raw`, anything else `GET /<path>`. Anything but a
   * 200 is "not here", and what a 200 says is re-hashed by `get`, so a public gateway is trusted only to be there.
   */
  Store gateway(Caps caps, string base) {
    bool down = false;   // as for `http`: a mirror that fails is asked nothing more
    return Store(
      (string p) => {
        u8[]? none = null;
        if (down) { return none; }
        bool block = p.indexOf("ipfs/") == 0;
        string url = base + "/" + p + (block ? "?format=raw" : "");
        string[] headers = block ? ["Accept: application/vnd.ipld.raw"] : string[]();
        match (fetch(caps, "GET", url, headers, u8[]())) {
          Err(_): { down = true; return none; }
          Ok(res): { if (res.status >= 500) { down = true; } return res.status == 200 ? res.body : none; }
        }
      },
      (string p, u8[] b) => false);
  }

  /** Memory, for tests: the map is the closures' own. */
  Store memory() {
    string[] keys = string[]();
    u8[][] vals = u8[][]();
    return Store(
      (string p) => {
        for (i32 i = 0; i < keys.len(); i++) { if (keys[i] == p) { return vals[i]; } }
        u8[]? none = null;
        return none;
      },
      (string p, u8[] b) => {
        for (i32 i = 0; i < keys.len(); i++) { if (keys[i] == p) { vals[i] = b; return true; } }
        string[] nk = string[].defaulted(keys.len() + 1);
        u8[][] nv = u8[][].filled(vals.len() + 1, u8[]());
        for (i32 i = 0; i < keys.len(); i++) { nk[i] = keys[i]; nv[i] = vals[i]; }
        nk[keys.len()] = p;
        nv[vals.len()] = b;
        keys = nk;
        vals = nv;
        return true;
      });
  }

  /** Keep a block, refusing one that is not what its CID names. */
  Result<bool, string> put(this, Block b) {
    if (!b.cid.names(b.data)) { return Result.Err("a block that does not hash to \{b.cid.text()}"); }
    if (!this.write("ipfs/" + b.cid.text(), b.data)) { return Result.Err("cannot write \{b.cid.text()}"); }
    return Result.Ok(true);
  }

  Result<bool, string> putAll(this, Block[] bs) {
    for (i32 i = 0; i < bs.len(); i++) { try this.put(bs[i]); }
    return Result.Ok(true);
  }

  /** A block by CID, re-hashed on the way out. */
  Result<u8[], string> get(this, Cid c) {
    u8[]? b = this.read("ipfs/" + c.text());
    if (b is null) { return Result.Err("not here: \{c.text()}"); }
    if (!c.names(b!)) { return Result.Err("the copy of \{c.text()} here does not hash to it"); }
    return Result.Ok(b!);
  }

  bool has(this, Cid c) { return this.read("ipfs/" + c.text()) is not null; }
}

/** Whether a mirror is named by URL (`http://` or `https://`) rather than as a directory. */
export bool isHttp(string spec) { return spec.indexOf("http://") == 0 || spec.indexOf("https://") == 0; }

/**
 * A mirror named by URL: `http://HOST[:PORT]` as `Store.http`, `https://HOST[:PORT]` as `Store.gateway` (a public
 * trustless gateway such as https://trustless-gateway.link, or a store directory behind any HTTPS server).
 */
export Result<Store, string> mirrorAt(Caps caps, string url) {
  if (url.indexOf("http://") == 0) { return httpStoreAt(caps.net, url); }
  if (url.indexOf("https://") != 0) { return Result.Err("\{url} is not an http:// or https:// URL"); }
  string hp = url.slice(8, url.len());
  if (hp.len() > 0 && hp.slice(hp.len() - 1, hp.len()) == "/") { hp = hp.slice(0, hp.len() - 1); }
  if (hp.indexOf("/") >= 0) { return Result.Err("\{url}: a mirror is a host and port, with no path"); }
  if (hp.len() == 0 || hp.indexOf(":") == 0) { return Result.Err("\{url}: no host"); }
  return Result.Ok(Store.gateway(caps, "https://" + hp));
}

/** `http://HOST[:PORT][/]` as a read-only `Store.http`, or why it is not one. */
export Result<Store, string> httpStoreAt(Net net, string url) {
  if (url.indexOf("http://") != 0) { return Result.Err("\{url} is not an http:// URL"); }
  string hp = url.slice(7, url.len());
  if (hp.len() > 0 && hp.slice(hp.len() - 1, hp.len()) == "/") { hp = hp.slice(0, hp.len() - 1); }
  if (hp.indexOf("/") >= 0) { return Result.Err("\{url}: a mirror is a host and port, with no path"); }
  i32 colon = hp.indexOf(":");
  i32 port = 80;
  if (colon >= 0) {
    port = 0;
    u8[] d = hp.slice(colon + 1, hp.len()).toBytes();
    if (d.len() == 0) { return Result.Err("\{url}: no port after the colon"); }
    for (i32 k = 0; k < d.len(); k++) {
      if (d[k] < 48 || d[k] > 57 || port > 65535) { return Result.Err("\{url}: the port is not a number"); }
      port = port * 10 + (d[k] as i32) - 48;
    }
    hp = hp.slice(0, colon);
  }
  if (hp.len() == 0) { return Result.Err("\{url}: no host"); }
  return Result.Ok(Store.http(net, hp, port));
}

// ---------------------------------------------------------------- resolving

/** Somewhere blocks might be: tried in order, each answer checked. Only the store is written to. */
export struct Resolver {
  Store local;
  Store[] mirrors;

  /** A block, from the local store or the first mirror whose copy hashes to it, then kept locally. */
  Result<u8[], string> block(this, Cid c) {
    match (this.local.get(c)) {
      Ok(b): { return Result.Ok(b); }
      Err(_): { }
    }
    string why = "";
    for (i32 i = 0; i < this.mirrors.len(); i++) {
      match (this.mirrors[i].get(c)) {
        Ok(b): { this.local.put(Block(c, b)); return Result.Ok(b); }
        Err(e): { why += "; mirror \{i}: \{e}"; }
      }
    }
    return Result.Err("no source has \{c.text()}\{why}");
  }
}

// ---------------------------------------------------------------- export

/** A file's bytes, assembled from its blocks, with its declared size checked. */
export Result<u8[], string> readFile(Resolver r, Cid c) {
  Out o = Out.create();
  try fileInto(r, c, o, 0);
  return Result.Ok(o.bytes());
}

Result<bool, string> fileInto(Resolver r, Cid c, Out o, i32 depth) {
  if (depth > 32) { return Result.Err("a file nested past 32 levels"); }
  u8[] b = try r.block(c);
  Node n = try readNode(c, b);
  match (n) {
    Dir(_): { return Result.Err("\{c.text()} is a directory, where a file was expected"); }
    Shard(_, _): { return Result.Err("\{c.text()} is a directory, where a file was expected"); }
    File(size, parts, inline): {
      i32 before = o.n;
      o.all(inline);
      for (i32 i = 0; i < parts.len(); i++) { try fileInto(r, parts[i].cid, o, depth + 1); }
      if (((o.n - before) as i64) != size) { return Result.Err("\{c.text()} declares \{size} bytes and holds \{o.n - before}"); }
      return Result.Ok(true);
    }
  }
}

/**
 * A directory's entries by name, sorted bytewise, whether it is a plain node or a HAMT. A HAMT is read strictly: each
 * shard's bitfield must name exactly the slots its links use, every sub-shard must be a shard, and every entry must sit
 * in the slot its name hashes to at that depth, so a shard that hides, misplaces or duplicates an entry is refused
 * rather than listed differently from how any other reader would list it.
 */
export Result<Link[], string> entriesOf(Resolver r, Cid c) {
  u8[] b = try r.block(c);
  Node n = try readNode(c, b);
  match (n) {
    File(_, _, _): { return Result.Err("\{c.text()} is a file, where a directory was expected"); }
    Dir(entries): { return Result.Ok(entries); }
    Shard(links, bits): {
      Link[] out = try shardInto(r, c, links, bits, 0, Link[]());
      return Result.Ok(sortLinks(out));
    }
  }
}

/** The entries under one shard at `depth`, appended to `acc`. */
Result<Link[], string> shardInto(Resolver r, Cid at, Link[] links, u8[] bits, i32 depth, Link[] acc) {
  Link[] out = acc;
  if (depth >= 64) { return Result.Err("a HAMT deeper than 64 levels"); }
  bool[] seen = bool[].filled(256, false);
  for (i32 i = 0; i < links.len(); i++) {
    string name = links[i].name;
    if (name.len() < 2) { return Result.Err("a HAMT link named \"\{name}\" in \{at.text()}"); }
    i32 slot = -1;
    for (i32 s = 0; s < 256; s++) { if (slotLabel(s) == name.slice(0, 2)) { slot = s; } }
    if (slot < 0) { return Result.Err("a HAMT link whose label \"\{name.slice(0, 2)}\" is not a slot, in \{at.text()}"); }
    if (seen[slot]) { return Result.Err("slot \{name.slice(0, 2)} used twice in \{at.text()}"); }
    seen[slot] = true;
    if (name.len() == 2) {
      u8[] sb = try r.block(links[i].cid);
      Node sn = try readNode(links[i].cid, sb);
      match (sn) {
        Shard(sub, subBits): { out = try shardInto(r, links[i].cid, sub, subBits, depth + 1, out); }
        File(_, _, _): { return Result.Err("slot \{name} of \{at.text()} names a file, where a sub-shard belongs"); }
        Dir(_): { return Result.Err("slot \{name} of \{at.text()} names a directory, where a sub-shard belongs"); }
      }
    } else {
      string entry = name.slice(2, name.len());
      if (hamtByte(entry.toBytes(), depth) != slot) { return Result.Err("\{entry} is in slot \{name.slice(0, 2)} of \{at.text()}, and its hash puts it elsewhere"); }
      out = pushLink(out, Link(links[i].cid, entry, links[i].tsize));
    }
  }
  for (i32 s = 0; s < 256; s++) {
    i32 byte = bits.len() - 1 - s / 8;
    bool set = byte >= 0 && (((bits[byte] as i32) >> (s % 8)) & 1) == 1;
    if (set != seen[s]) { return Result.Err("the bitfield of \{at.text()} does not match its links at slot \{slotLabel(s)}"); }
  }
  if (bits.len() > 32 || (bits.len() > 0 && bits[0] == 0)) { return Result.Err("the bitfield of \{at.text()} is not minimal"); }
  return Result.Ok(out);
}

Link[] sortLinks(Link[] xs) {
  Link[] out = xs;
  for (i32 i = 1; i < out.len(); i++) {
    Link e = out[i];
    i32 j = i;
    while (j > 0 && compareNames(out[j - 1].name, e.name) > 0) { out[j] = out[j - 1]; j--; }
    out[j] = e;
  }
  return out;
}

i32 compareNames(string a, string b) {
  u8[] x = a.toBytes();
  u8[] y = b.toBytes();
  for (i32 i = 0; i < x.len() && i < y.len(); i++) { if (x[i] != y[i]) { return (x[i] as i32) - (y[i] as i32); } }
  return x.len() - y.len();
}

/** Every file in a tree, with its path; an empty directory as its path ending in `/`. */
export Result<FileIn[], string> readTree(Resolver r, Cid c) { return treeOf(r, c, "", 0); }

Result<FileIn[], string> treeOf(Resolver r, Cid c, string prefix, i32 depth) {
  if (depth > 64) { return Result.Err("a tree nested past 64 levels"); }
  Link[] entries = try entriesOf(r, c);
  if (entries.len() == 0 && prefix != "") { return Result.Ok([FileIn(prefix, u8[]())]); }
  FileIn[] out = FileIn[]();
  for (i32 i = 0; i < entries.len(); i++) {
    Link e = entries[i];
    string path = prefix == "" ? e.name : prefix + e.name;
    u8[] eb = try r.block(e.cid);
    Node en = try readNode(e.cid, eb);
    bool isDir = match (en) { Dir(_): true, Shard(_, _): true, File(_, _, _): false };
    if (isDir) {
      FileIn[] sub = try treeOf(r, e.cid, path + "/", depth + 1);
      out = joinFiles(out, sub);
    } else {
      u8[] bytes = try readFile(r, e.cid);
      out = joinFiles(out, [FileIn(path, bytes)]);
    }
  }
  return Result.Ok(out);
}

FileIn[] joinFiles(FileIn[] a, FileIn[] b) {
  if (b.len() == 0) { return a; }
  FileIn[] out = FileIn[].filled(a.len() + b.len(), b[0]);
  for (i32 i = 0; i < a.len(); i++) { out[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { out[a.len() + i] = b[i]; }
  return out;
}

/** Split readTree's answer back into the files and empty directories buildTree takes. */
export string[] emptyDirsOf(FileIn[] fs) {
  string[] out = string[]();
  for (i32 i = 0; i < fs.len(); i++) {
    string p = fs[i].path;
    if (p.len() > 0 && p.slice(p.len() - 1, p.len()) == "/") {
      string[] next = string[].defaulted(out.len() + 1);
      for (i32 j = 0; j < out.len(); j++) { next[j] = out[j]; }
      next[out.len()] = p.slice(0, p.len() - 1);
      out = next;
    }
  }
  return out;
}

export FileIn[] filesOnly(FileIn[] fs) {
  FileIn[] out = FileIn[]();
  for (i32 i = 0; i < fs.len(); i++) {
    string p = fs[i].path;
    if (!(p.len() > 0 && p.slice(p.len() - 1, p.len()) == "/")) { out = joinFiles(out, [fs[i]]); }
  }
  return out;
}

// ---------------------------------------------------------------- import

/** A tree built from files in memory, its blocks kept. */
export Result<Cid, string> importFiles(Store s, FileIn[] files, string[] dirs, Params p) {
  Built b = try buildTree(files, dirs, p);
  try s.putAll(b.blocks);
  return Result.Ok(b.root);
}

/** A CAR's blocks, each checked, kept; its roots answered. */
export Result<Cid[], string> importCar(Store s, u8[] car) {
  auto k = try readCar(car);
  try s.putAll(k.blocks);
  return Result.Ok(k.roots);
}

/** A directory on disk: hidden files included, symlinks refused, `.git` at the top left out. */
export async Result<Cid, string> importDir(Store s, Files fs, string path, Params p) {
  return await importDirExcept(s, fs, path, p, string[]());
}

/**
 * `importDir`, leaving out the top-level entries named in `skip`: what a directory holds beside the tree it is a copy
 * of, such as the package cache's completion marker.
 */
export async Result<Cid, string> importDirExcept(Store s, Files fs, string path, Params p, string[] skip) {
  FileIn[] files = FileIn[]();
  string[] dirs = string[]();
  string[] todo = [""];
  while (todo.len() > 0) {
    string rel = todo[todo.len() - 1];
    string[] rest = string[].defaulted(todo.len() - 1);
    for (i32 i = 0; i < rest.len(); i++) { rest[i] = todo[i]; }
    todo = rest;
    string full = rel == "" ? path : path + "/" + rel;
    string[] names;
    match (await fs.readDir(full)) {
      Err(e): { return Result.Err("\{full}: \{e}"); }
      Ok(n): { names = n; }
    }
    if (names.len() == 0 && rel != "") { dirs = pushS(dirs, rel); }
    for (i32 i = 0; i < names.len(); i++) {
      bool skipped = rel == "" && names[i] == ".git";
      for (i32 k = 0; k < skip.len(); k++) { if (rel == "" && names[i] == skip[k]) { skipped = true; } }
      if (skipped) { continue; }
      string child = rel == "" ? names[i] : rel + "/" + names[i];
      auto st = (await fs.linkStat(path + "/" + child)).ok();
      if (st is null) { return Result.Err("\{child}: cannot stat"); }
      if (st!.isSymlink) { return Result.Err("\{child}: a symlink, which the profile here refuses"); }
      if (st!.isDir) { todo = pushS(todo, child); continue; }
      u8[]? bytes = (await fs.readFile(path + "/" + child)).ok();
      if (bytes is null) { return Result.Err("\{child}: cannot read"); }
      files = joinFiles(files, [FileIn(child, bytes!)]);
    }
  }
  return importFiles(s, files, dirs, p);
}

/** A git commit's tree, from `git` (a locator only: the CIDs come from the bytes it hands over). */
export async Result<Cid, string> importGit(Store s, Procs procs, string repo, string commit, Params p) {
  u8[] listing = try await git(procs, ["-C", repo, "ls-tree", "-r", "-z", commit], u8[]());
  string[] paths = string[]();
  string[] shas = string[]();
  i32 start = 0;
  string ask = "";
  for (i32 i = 0; i < listing.len(); i++) {
    if (listing[i] != 0) { continue; }
    string rec = string.fromBytes(sliceOf(listing, start, i));
    start = i + 1;
    i32 tab = rec.indexOf("\t");
    string mode = rec.slice(0, rec.indexOf(" "));
    if (mode == "120000") { return Result.Err("\{rec.slice(tab + 1, rec.len())}: a symlink, which the profile here refuses"); }
    if (mode == "160000") { return Result.Err("\{rec.slice(tab + 1, rec.len())}: a submodule"); }
    string head = rec.slice(0, tab);
    string sha = head.slice(head.len() - 40, head.len());
    paths = pushS(paths, rec.slice(tab + 1, rec.len()));
    shas = pushS(shas, sha);
    ask += sha + "\n";
  }
  u8[] batch = try await git(procs, ["-C", repo, "cat-file", "--batch"], ask.toBytes());
  FileIn[] files = FileIn[]();
  i32 at = 0;
  for (i32 i = 0; i < shas.len(); i++) {
    i32 nl = at;
    while (batch[nl] != 10) { nl++; }
    string h = string.fromBytes(sliceOf(batch, at, nl));
    i32 size = 0;
    u8[] digits = h.slice(lastSpace(h) + 1, h.len()).toBytes();
    for (i32 d = 0; d < digits.len(); d++) { size = size * 10 + ((digits[d] - '0') as i32); }
    files = joinFiles(files, [FileIn(paths[i], sliceOf(batch, nl + 1, nl + 1 + size))]);
    at = nl + 1 + size + 1;
  }
  return importFiles(s, files, string[](), p);
}

async Result<u8[], string> git(Procs procs, string[] args, u8[] input) {
  match (await procs.exec("git", args, input, ChildEnv.inherited(), Launch.plain())) {
    Err(e): { return Result.Err("cannot run git: \{e}"); }
    Ok(r): {
      if (r.ok()) { return Result.Ok(r.stdout); }
      return Result.Err("git \{args[2]}: \{r.ran() ? string.fromBytes(r.stderr) : r.error}");
    }
  }
}

u8[] sliceOf(u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  for (i32 i = from; i < to; i++) { out[i - from] = b[i]; }
  return out;
}

i32 lastSpace(string s) {
  i32 at = -1;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == ' ') { at = i; } }
  return at;
}

string[] pushS(string[] xs, string x) {
  string[] out = string[].defaulted(xs.len() + 1);
  for (i32 i = 0; i < xs.len(); i++) { out[i] = xs[i]; }
  out[xs.len()] = x;
  return out;
}

/** Every block under `c`, fetched and checked: what a CAR of the object holds. */
export Result<Block[], string> blocksOf(Resolver r, Cid c) {
  u8[] b = try r.block(c);
  Block[] out = [Block(c, b)];
  if (c.codec == RAW()) { return Result.Ok(out); }
  Node n = try readNode(c, b);
  Link[] links = match (n) { File(_, parts, _): parts, Dir(entries): entries, Shard(ls, _): ls };
  for (i32 i = 0; i < links.len(); i++) {
    Block[] sub = try blocksOf(r, links[i].cid);
    Block[] next = Block[].filled(out.len() + sub.len(), out[0]);
    for (i32 j = 0; j < out.len(); j++) { next[j] = out[j]; }
    for (i32 j = 0; j < sub.len(); j++) { next[out.len() + j] = sub[j]; }
    out = next;
  }
  return Result.Ok(out);
}
