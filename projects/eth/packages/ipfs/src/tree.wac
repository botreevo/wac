// A directory tree from a list of paths, as an importer sees one: files with their bytes, and directories that
// may be empty. The tree is built bottom up, each directory from its own entries.

import { Result } from "core";
import { Params, Built, Entry, buildFile, buildDir } from "./unixfs.wac";

export struct FileIn {
  string path;
  u8[] content;
}

struct Dir {
  string[] fileNames;
  u8[][] files;
  string[] dirNames;
  Dir[] dirs;

  Dir child(this, string name) {
    for (i32 i = 0; i < this.dirNames.len(); i++) { if (this.dirNames[i] == name) { return this.dirs[i]; } }
    Dir d = Dir { };
    string[] names = string[].defaulted(this.dirNames.len() + 1);
    Dir[] ds = Dir[].defaulted(this.dirs.len() + 1);
    for (i32 i = 0; i < this.dirNames.len(); i++) { names[i] = this.dirNames[i]; ds[i] = this.dirs[i]; }
    names[this.dirNames.len()] = name;
    ds[this.dirs.len()] = d;
    this.dirNames = names;
    this.dirs = ds;
    return d;
  }

  void addFile(this, string name, u8[] content) {
    string[] names = string[].defaulted(this.fileNames.len() + 1);
    u8[][] fs = u8[][].filled(this.files.len() + 1, u8[]());
    for (i32 i = 0; i < this.fileNames.len(); i++) { names[i] = this.fileNames[i]; fs[i] = this.files[i]; }
    names[this.fileNames.len()] = name;
    fs[this.files.len()] = content;
    this.fileNames = names;
    this.files = fs;
  }

  Result<Built, string> build(this, Params p) {
    i32 n = this.fileNames.len() + this.dirNames.len();
    if (n == 0) { return buildDir(Entry[](), p); }
    Entry[] es = Entry[].filled(n, Entry("", buildFile(u8[](), p)));
    for (i32 i = 0; i < this.fileNames.len(); i++) { es[i] = Entry(this.fileNames[i], buildFile(this.files[i], p)); }
    for (i32 i = 0; i < this.dirNames.len(); i++) {
      Built b = try this.dirs[i].build(p);
      es[this.fileNames.len() + i] = Entry(this.dirNames[i], b);
    }
    return buildDir(es, p);
  }
}

/** The tree of `files` and `dirs` (paths relative to the root, `/`-separated). A name used twice is refused. */
export Result<Built, string> buildTree(FileIn[] files, string[] dirs, Params p) {
  Dir root = Dir { };
  for (i32 i = 0; i < dirs.len(); i++) { walk(root, dirs[i], true); }
  for (i32 i = 0; i < files.len(); i++) {
    string path = files[i].path;
    i32 cut = lastSlash(path);
    Dir at = cut < 0 ? root : walk(root, path.slice(0, cut), true);
    at.addFile(cut < 0 ? path : path.slice(cut + 1, path.len()), files[i].content);
  }
  return root.build(p);
}

Dir walk(Dir root, string path, bool create) {
  Dir at = root;
  string rest = path;
  while (rest.len() > 0) {
    i32 s = rest.indexOf("/");
    string part = s < 0 ? rest : rest.slice(0, s);
    rest = s < 0 ? "" : rest.slice(s + 1, rest.len());
    at = at.child(part);
  }
  return at;
}

i32 lastSlash(string s) {
  i32 at = -1;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == '/') { at = i; } }
  return at;
}
