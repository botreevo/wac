// A test is an exported `test*` function returning a string: empty is a pass and anything else is what failed.
// Failures accumulate, so one run reports every disagreement. (wacuum's `test/check.wac`, without U256.)

export struct Check {
  i32 failed;
  string messages;

  Check create() { return Check(0, ""); }

  void fail(this, string what) {
    this.failed++;
    if (this.failed > 8) { return; }
    if (this.messages.len() > 0) { this.messages += "; "; }
    this.messages += what;
  }

  void ok(this, bool cond, string what) { if (!cond) { this.fail(what); } }

  void eq(this, string got, string want, string what) {
    if (got != want) { this.fail("\{what}: got \"\{got}\", want \"\{want}\""); }
  }

  string report(this) {
    if (this.failed > 8) { return this.messages + " … and more: \{this.failed} failures in all"; }
    return this.messages;
  }
}
