// Light-client data across forks: older data upgraded into a later fork's layout (`upgrade_lc_*_to_*` in each fork's
// `light-client/fork.md`), and header checks that go by the header's own epoch rather than the store's fork.
//
// A store holds everything in its own fork's layout. Data from an earlier fork is upgraded on arrival:
//
//   to Capella   a header gains an empty ExecutionPayloadHeader and a zero execution branch
//   to Deneb     the payload header gains `blob_gas_used` and `excess_blob_gas`, both zero
//   to Electra   headers are unchanged; the state branches gain a leading zero node each, the deeper gindex's
//                "normalized" form, which `is_valid_normalized_merkle_branch` reads back as the shallower proof
//   to Fulu      nothing changes but the fork
//
// The bytes are rebuilt from the parts with this fork's descriptor table, so an upgraded value has exactly the
// serialization (and the root) the spec's constructor would give it.

import { lightClientTypes, lightClientFields, ALTAIR, CAPELLA, DENEB, ELECTRA, FT_LIGHT_CLIENT_HEADER,
         FT_EXECUTION_PAYLOAD_HEADER, FT_LIGHT_CLIENT_UPDATE, FT_LIGHT_CLIENT_BOOTSTRAP, executionPayloadGindex,
         finalityBranchDepth, syncCommitteeBranchDepth } from "../../ssz/src/forks.wac";
import { containerSpans, isFixed, fixedSize, hashTreeRoot } from "../../ssz/src/container.wac";
import { isValidMerkleBranch, subtreeIndex } from "../../ssz/src/merkle.wac";
import { Parts, partsOf } from "./header.wac";
import { Schedule } from "./schedule.wac";

/** A container of `fork`'s type `ty`, serialized from its fields' own serializations. */
export u8[] serialize(i32 fork, i32 ty, u8[][] parts) { return serializeN(fork, 32, ty, parts); }

/** The same, for a type holding a sync committee of `n`. */
export u8[] serializeN(i32 fork, i32 n0, i32 ty, u8[][] parts) {
  i32[] t = lightClientTypes(fork, n0);
  i32[] f = lightClientFields(fork);
  i32 child = t[ty * 4 + 2];
  i32 n = t[ty * 4 + 3];
  i32 fixedPart = 0;
  for (i32 i = 0; i < n; i++) {
    i32 ft = f[child + i];
    fixedPart = fixedPart + (isFixed(t, f, ft) ? fixedSize(t, f, ft) : 4);
  }
  i32 total = fixedPart;
  for (i32 i = 0; i < n; i++) { if (!isFixed(t, f, f[child + i])) { total = total + parts[i].len(); } }
  u8[] out = u8[].filled(total, 0);
  i32 at = 0;
  i32 tail = fixedPart;
  for (i32 i = 0; i < n; i++) {
    if (isFixed(t, f, f[child + i])) {
      out.copyFrom(parts[i], 0, at, parts[i].len());
      at = at + parts[i].len();
    } else {
      for (i32 b = 0; b < 4; b++) { out[at + b] = ((tail >> (b * 8)) & 255) as@ u8; }
      out.copyFrom(parts[i], 0, tail, parts[i].len());
      tail = tail + parts[i].len();
      at = at + 4;
    }
  }
  return out;
}

/** The fields of a `fork` container, each its own bytes; empty when malformed. */
export u8[][] fieldsOf(i32 fork, i32 ty, u8[] data) { return fieldsOfN(fork, 32, ty, data); }

/** The same, for a type holding a sync committee of `n`. */
export u8[][] fieldsOfN(i32 fork, i32 n, i32 ty, u8[] data) {
  i32[] t = lightClientTypes(fork, n);
  i32[]? s = containerSpans(t, lightClientFields(fork), ty, data, 0, data.len());
  if (s is null) { return u8[][](); }
  u8[][] out = u8[][].filled(s!.len() / 2, u8[]());
  for (i32 i = 0; i < out.len(); i++) { out[i] = cut(data, s![2 * i], s![2 * i + 1]); }
  return out;
}

u8[] cut(u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  out.copyFrom(b, from, 0, to - from);
  return out;
}

/** `ExecutionPayloadHeader.empty()` in `fork`'s layout. */
export u8[] emptyPayloadHeader(i32 fork) {
  i32[] t = lightClientTypes(fork, 32);
  i32[] f = lightClientFields(fork);
  i32 n = t[FT_EXECUTION_PAYLOAD_HEADER() * 4 + 3];
  u8[][] parts = u8[][].filled(n, u8[]());
  for (i32 i = 0; i < n; i++) {
    i32 ft = f[t[FT_EXECUTION_PAYLOAD_HEADER() * 4 + 2] + i];
    parts[i] = isFixed(t, f, ft) ? u8[].filled(fixedSize(t, f, ft), 0) : u8[]();
  }
  return serialize(fork, FT_EXECUTION_PAYLOAD_HEADER(), parts);
}

/** A header of `from` in the layout of `from + 1`. */
u8[] headerUp(i32 from, u8[] h) {
  if (from == ALTAIR()) {
    return serialize(CAPELLA(), FT_LIGHT_CLIENT_HEADER(), [h, emptyPayloadHeader(CAPELLA()), u8[].filled(4 * 32, 0)]);
  }
  if (from == CAPELLA()) {
    u8[][] p = fieldsOf(CAPELLA(), FT_LIGHT_CLIENT_HEADER(), h);
    if (p.len() != 3) { return u8[](); }
    u8[][] e = fieldsOf(CAPELLA(), FT_EXECUTION_PAYLOAD_HEADER(), p[1]);
    if (e.len() != 15) { return u8[](); }
    u8[][] e2 = u8[][].filled(17, u8[].filled(8, 0));
    for (i32 i = 0; i < 15; i++) { e2[i] = e[i]; }
    return serialize(DENEB(), FT_LIGHT_CLIENT_HEADER(), [p[0], serialize(DENEB(), FT_EXECUTION_PAYLOAD_HEADER(), e2), p[2]]);
  }
  return h;
}

/** A header of `from` in `to`'s layout. */
export u8[] upgradeHeader(i32 from, i32 to, u8[] h) {
  u8[] out = h;
  for (i32 k = from; k < to; k++) { out = headerUp(k, out); }
  return out;
}

/** A branch padded with leading zero nodes to `depth`: the normalized form of a shallower proof. */
u8[] normalized(u8[] branch, i32 depth) {
  i32 extra = depth * 32 - branch.len();
  if (extra <= 0) { return branch; }
  u8[] out = u8[].filled(depth * 32, 0);
  out.copyFrom(branch, 0, extra, branch.len());
  return out;
}

/** A `LightClientUpdate` of `from` in `to`'s layout. */
export u8[] upgradeUpdate(i32 from, i32 to, i32 n, u8[] u) {
  if (from == to) { return u; }
  u8[][] p = fieldsOfN(from, n, FT_LIGHT_CLIENT_UPDATE(), u);
  if (p.len() != 7) { return u8[](); }
  return serializeN(to, n, FT_LIGHT_CLIENT_UPDATE(), [
    upgradeHeader(from, to, p[0]), p[1], normalized(p[2], syncCommitteeBranchDepth(to)),
    upgradeHeader(from, to, p[3]), normalized(p[4], finalityBranchDepth(to)), p[5], p[6]]);
}

/** A `LightClientBootstrap` of `from` in `to`'s layout. */
export u8[] upgradeBootstrap(i32 from, i32 to, i32 n, u8[] b) {
  if (from == to) { return b; }
  u8[][] p = fieldsOfN(from, n, FT_LIGHT_CLIENT_BOOTSTRAP(), b);
  if (p.len() != 3) { return u8[](); }
  return serializeN(to, n, FT_LIGHT_CLIENT_BOOTSTRAP(), [upgradeHeader(from, to, p[0]), p[1],
                                                     normalized(p[2], syncCommitteeBranchDepth(to))]);
}

// ── Checks by the header's own epoch ─────────────────────────────────────────────────────────────────

i64 slotOf(u8[] header) {
  if (header.len() < 8) { return -1 as i64; }
  i64 v = 0 as i64;
  for (i32 i = 7; i >= 0; i--) { v = (v << (8 as i64)) | (header[i] as i64); }
  return v;
}

bool zeros(u8[] b) {
  for (i32 i = 0; i < b.len(); i++) { if (b[i] != 0) { return false; } }
  return true;
}

/**
 * `get_lc_execution_root` for a header held in `layout`, going by its own epoch: zero before Capella, the root of
 * the payload header as Capella defined it for a Capella-era header (its first 15 fields), and the full root after.
 */
export u8[]? executionRootAt(Schedule s, i32 layout, u8[] header) {
  if (layout < CAPELLA()) { return null; }
  i32 own = s.layoutAtSlot(slotOf(header));
  if (own < CAPELLA()) { return u8[].filled(32, 0); }
  Parts? p = partsOf(layout, header);
  if (p is null) { return null; }
  if (own == CAPELLA() && layout >= DENEB()) {
    u8[][] e = fieldsOf(layout, FT_EXECUTION_PAYLOAD_HEADER(), p!.execution);
    if (e.len() != 17) { return null; }
    u8[][] e15 = u8[][].filled(15, u8[]());
    for (i32 i = 0; i < 15; i++) { e15[i] = e[i]; }
    return hashTreeRoot(lightClientTypes(CAPELLA(), 32), lightClientFields(CAPELLA()), FT_EXECUTION_PAYLOAD_HEADER(),
                        serialize(CAPELLA(), FT_EXECUTION_PAYLOAD_HEADER(), e15));
  }
  return hashTreeRoot(lightClientTypes(layout, 32), lightClientFields(layout), FT_EXECUTION_PAYLOAD_HEADER(), p!.execution);
}

/** `is_valid_light_client_header` for a header held in `layout` (Capella to Fulu), by the header's own epoch. */
export bool isValidHeaderAt(Schedule s, i32 layout, u8[] header) {
  Parts? p = partsOf(layout, header);
  if (p is null) { return false; }
  if (layout < CAPELLA()) { return true; }
  i32 own = s.layoutAtSlot(slotOf(header));
  if (layout >= DENEB() && own < DENEB()) {
    u8[][] e = fieldsOf(layout, FT_EXECUTION_PAYLOAD_HEADER(), p!.execution);
    if (e.len() != 17 || !zeros(e[15]) || !zeros(e[16])) { return false; }
  }
  if (own < CAPELLA()) {
    return zeros(p!.branch) && same(p!.execution, emptyPayloadHeader(layout));
  }
  u8[]? leaf = executionRootAt(s, layout, header);
  if (leaf is null) { return false; }
  return isValidMerkleBranch(leaf!, p!.branch, 4, subtreeIndex(executionPayloadGindex()), cut(p!.beacon, 80, 112));
}

bool same(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) { if (a[i] != b[i]) { return false; } }
  return true;
}
