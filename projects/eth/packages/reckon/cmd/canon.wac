// canon — the NaN rewrite on its own (src/canon.wac), for testing it against itself.
//
//     canon IN OUT          the module with canonical NaNs, as the runner makes it (checks the stack model elides)
//     canon IN OUT --all    the same with every NaN-producing operation checked: the reference
//
// tools/canonfuzz.sh runs both versions of each module on both engines and requires one answer.

import { Sys } from "std";
import { canonicalizeWith } from "../src/canon.wac";

export async i32 main(Sys sys) {
  string[] a = sys.args();
  if (a.len() < 2) { sys.warn("usage: canon IN OUT [--all]"); return 2; }
  bool all = a.len() > 2 && a[2] == "--all";
  match (await sys.readFile(a[0])) {
    Err(e): { sys.warn("canon: \{a[0]}: \{e}"); return 1; }
    Ok(b): {
      match (canonicalizeWith(b, !all)) {
        Err(e): { sys.warn("canon: \{e}"); return 1; }
        Ok(c): { await sys.writeFile(a[1], c.module); return 0; }
      }
    }
  }
}
