// claim — statements about objects, the index that holds them, and admission over both.
//
//     claim address --key F                       the address a key signs as
//     claim endorse SUBJECT SCOPE --key F          sign an endorsement
//     claim reject SUBJECT REASON --key F          sign a rejection (your list)
//     claim revoke STATEMENT --key F               sign a revocation of a statement you signed (by its id)
//     claim slots RECIPE                           a recipe's input slots: name and CID
//     claim origins CID                            the derivations claiming to produce it
//     claim dependents CID                         outputs of recipes that take it as an input
//     claim admit SUBJECT ROLE --policy F          may it be used in that role, and why: SUBJECT a CID, ens:NAME, or
//                                                  name:NAME@0xPUBLISHER (the registry v2's delayed names, with
//                                                  --registry); the policy's `names` says which it follows
//         [--checkpoint ROOT (--beacon DIR | --beacon-url URL) [--fork F] [--now SLOT] | --anchor BLOCKHASH]
//         [--rpc HOST:PORT [--registry ADDR --code-hash H] [--ens-registry ADDR --ens-registry-code H --resolver-code H]]
//                                                  …from a checkpoint, through the light client's anchor, a name read by
//                                                  proof, revocations and rejections proved from the registry v2, to
//                                                  the claims here and in every mirror (docs/admit.md); a step asked
//                                                  for that cannot be done refuses (exit 3)
//
//     claim run SUBJECT ROLE --policy F [the admit flags] [--entry PATH] [--timeout MS] [--out PATH] [-- ARGS…]
//                                                  admit, then fetch the admitted object (every block checked against
//                                                  its CID) and run it in the machine: sealed (no clock, no random
//                                                  bytes), canonical NaNs, no network, no environment, and the
//                                                  machine's files: a tree read-only at /in (PATH is the program in
//                                                  it), an /out held in memory and dropped, nothing else. The
//                                                  program's exit code is the command's. With --out, write the bytes or
//                                                  the tree to PATH instead of running them. Admission's account goes
//                                                  to stderr, so stdout is the program's
//
//     claim publish DIR                            the local index into the mirror DIR, added to what it holds
//
// --store DIR (default .objects), --mirror DIR or --mirror http://HOST:PORT (repeatable): where else to find blocks,
// and claims: the index `admit`, `origins` and `dependents` use is the local one together with every mirror's, each
// statement's signature verified, what fails reported and left out (docs/claims-mirror.md). A signed statement goes into the store and into the
// store's index (`claims/index`), which is reloaded — every signature checked again — on each use.

import { Sys, Authority, Launch, Child, Files, Input, TimedOut } from "std";
import { Result, Ticket } from "core";
import { fetch.Caps } from "wac";
import { ipfs.Cid, ipfs.parseCid, ipfs.Store, ipfs.Resolver, ipfs.isHttp, ipfs.mirrorAt, ipfs.Block, ipfs.DAG_CBOR,
         ipfs.FileIn, ipfs.Node, ipfs.readNode, ipfs.readFile, ipfs.readTree, ipfs.filesOnly, ipfs.emptyDirsOf } from "@/lib.wac";
import { Statement, Signed, signStatement, signedBlock, addressOfKey, recipeFrom, statementId } from "../src/claims.wac";
import { Index, Held, Loaded, loadIndex, saveIndex, loadIndexes, publishIndex } from "../src/graph.wac";
import { slotsOf } from "../src/slots.wac";
import { AdmitRequest, Admitted, admitSubject } from "../src/admission.wac";
import { unhex, hex } from "../src/hex.wac";
import { Written, worldFiles } from "../src/world.wac";
import { canonicalize } from "../src/canon.wac";

/** A flag's value. Nothing after `--` is a flag: it is the arguments `run` hands the program. */
string flag(string[] a, string name, string fallback) {
  for (i32 i = 0; i + 1 < a.len() && a[i] != "--"; i++) { if (a[i] == name) { return a[i + 1]; } }
  return fallback;
}

/** What follows `--`, or nothing. */
string[] afterDashes(string[] a) {
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != "--") { continue; }
    string[] out = string[].defaulted(a.len() - i - 1);
    for (i32 j = i + 1; j < a.len(); j++) { out[j - i - 1] = a[j]; }
    return out;
  }
  return string[]();
}

/** Admission's account: stdout for `admit`, stderr for `run`, whose stdout is the program's. */
void say(Sys sys, bool quiet, string s) { if (quiet) { sys.warn(s); } else { sys.log(s); } }

export async i32 main(Sys sys) {
  string[] a = sys.args();
  if (a.len() < 1) { sys.warn("usage: claim address|endorse|reject|revoke|slots|origins|dependents|admit|run|publish … (see the source)"); return 2; }
  Store store = Store.dir(sys.files(), flag(a, "--store", ".objects"));
  Store[] mirrors = Store[]();
  for (i32 i = 0; i + 1 < a.len() && a[i] != "--"; i++) {
    if (a[i] != "--mirror") { continue; }
    Store m = Store.dir(sys.files(), a[i + 1]);
    if (isHttp(a[i + 1])) {
      match (mirrorAt(Caps(sys.clock(), sys.random(), sys.env(), sys.net(), sys.files()), a[i + 1])) { Err(e): { sys.warn("claim: \{e}"); return 2; } Ok(h): { m = h; } }
    }
    Store[] next = Store[].filled(mirrors.len() + 1, m);
    for (i32 j = 0; j < mirrors.len(); j++) { next[j] = mirrors[j]; }
    mirrors = next;
  }
  Resolver r = Resolver(store, mirrors);
  string cmd = a[0];
  bool admitting = cmd == "admit" || cmd == "run";
  bool quiet = cmd == "run";

  if (cmd == "address") {
    u8[]? key = await keyOf(sys, a);
    if (key is null) { return 1; }
    sys.log("0x" + hex(addressOfKey(key!)));
    return 0;
  }
  if ((cmd == "endorse" || cmd == "reject") && a.len() >= 3 || cmd == "revoke" && a.len() >= 2) {
    Cid subject;
    match (parseCid(a[1])) { Err(e): { sys.warn("claim: \{e}"); return 1; } Ok(c): { subject = c; } }
    u8[]? key = await keyOf(sys, a);
    if (key is null) { return 1; }
    Statement s = cmd == "endorse" ? Statement.Endorsement(subject, a[2])
                : cmd == "reject" ? Statement.Rejection(subject, a[2]) : Statement.Revocation(subject);
    return record(sys, store, signStatement(s, key!));
  }

  if (cmd == "publish" && a.len() >= 2) {
    match (publishIndex(loadIndex(store).index, Store.dir(sys.files(), a[1]))) {
      Err(e): { sys.warn("claim: \{e}"); return 1; }
      Ok(l): {
        for (i32 i = 0; i < l.refused.len(); i++) { sys.warn("claim: \{a[1]} held, and is no longer listed: \{l.refused[i]}"); }
        sys.log("\{a[1]}: \{l.index.signed.len()} statement(s), \{l.index.recipes.len()} recipe(s)");
        return 0;
      }
    }
  }
  Loaded loaded = loadIndexes(store, mirrors);
  for (i32 i = 0; i < loaded.refused.len(); i++) { sys.warn("claim: left out: \{loaded.refused[i]}"); }
  Index ix = loaded.index;
  if (a.len() < 2) { sys.warn("claim: \{cmd} needs a CID"); return 2; }
  if (admitting && a.len() >= 3) {
    // Admission (src/admission.wac), and for `run`, then the admitted object fetched and run.
    string path = flag(a, "--policy", "");
    u8[] text;
    match (await sys.readFile(path)) { Err(e): { sys.warn("claim: \{path}: \{e}"); return 1; } Ok(b): { text = b; } }
    AdmitRequest q = AdmitRequest(a[1], a[2], text, flag(a, "--checkpoint", ""), flag(a, "--beacon", ""), flag(a, "--beacon-url", ""),
                                  flag(a, "--fork", ""), flag(a, "--now", "") != "" ? decimalOf(flag(a, "--now", "")) : (-1 as i64),
                                  flag(a, "--anchor", ""), flag(a, "--rpc", ""), flag(a, "--registry", ""), flag(a, "--code-hash", ""),
                                  flag(a, "--ens-registry", ""), flag(a, "--ens-registry-code", ""), flag(a, "--resolver-code", ""));
    Admitted d = await admitSubject(sys, q, ix, r);
    for (i32 i = 0; i < d.lines.len(); i++) {
      if (d.lines[i].warn) { sys.warn("claim: " + d.lines[i].text); } else { say(sys, quiet, d.lines[i].text); }
    }
    if (d.code != 0 || cmd == "admit") { return d.code; }
    return await runAdmitted(sys, a, r, d.cid!);
  }
  Cid c;
  match (parseCid(a[1])) { Err(e): { sys.warn("claim: \{e}"); return 1; } Ok(x): { c = x; } }
  if (cmd == "slots") {
    match (r.block(c)) {
      Err(e): { sys.warn("claim: \{e}"); return 1; }
      Ok(b): {
        match (recipeFrom(b)) {
          Err(e): { sys.warn("claim: \{e}"); return 1; }
          Ok(rec): {
            match (slotsOf(r, rec.input)) {
              Err(e): { sys.warn("claim: \{e}"); return 1; }
              Ok(ss): { for (i32 i = 0; i < ss.len(); i++) { sys.log("\{ss[i].name} \{ss[i].cid.text()}"); } return 0; }
            }
          }
        }
      }
    }
  }
  if (cmd == "origins") {
    Held[] hs = ix.origins(c);
    for (i32 i = 0; i < hs.len(); i++) {
      match (hs[i].statement) {
        Derivation(rid, _, runner): { sys.log("recipe \{rid.text()} by 0x\{hex(hs[i].signer)} on \"\{runner}\""); }
        default: { }
      }
    }
    return 0;
  }
  if (cmd == "dependents") {
    Cid[] ds = ix.dependents(r, c);
    for (i32 i = 0; i < ds.len(); i++) { sys.log(ds[i].text()); }
    return 0;
  }
  sys.warn("claim: unknown command \{cmd}");
  return 2;
}

async u8[]? keyOf(Sys sys, string[] a) {
  string path = flag(a, "--key", "");
  match (await sys.readFile(path)) {
    Err(e): { sys.warn("claim: --key \{path}: \{e}"); return null; }
    Ok(b): {
      u8[]? k = unhex(trimmed(string.fromBytes(b)));
      if (k is null || k!.len() != 32) { sys.warn("claim: \{path} is not a 32-byte hex key"); return null; }
      return k;
    }
  }
}

string trimmed(string s) {
  i32 from = 0;
  i32 to = s.len();
  while (from < to && (s.slice(from, from + 1) == " " || s.slice(from, from + 1) == "\n")) { from++; }
  while (to > from && (s.slice(to - 1, to) == " " || s.slice(to - 1, to) == "\n")) { to--; }
  return s.slice(from, to);
}

/** Keep a signed statement: its block in the store, and it in the store's index. Prints the statement's id, which a revocation names. */
i32 record(Sys sys, Store store, Signed s) {
  Index ix = loadIndex(store).index;
  match (ix.add(s)) { Err(e): { sys.warn("claim: \{e}"); return 1; } Ok(_): { } }
  match (saveIndex(ix, store)) { Err(e): { sys.warn("claim: \{e}"); return 1; } Ok(_): { } }
  sys.warn("claim: signed block \{Cid.of(DAG_CBOR(), signedBlock(s)).text()}");
  sys.log(statementId(s.statement).text());
  return 0;
}

i64 decimalOf(string s) {
  i64 v = 0 as i64;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] < 48 || b[i] > 57) { return -1 as i64; } v = v * (10 as i64) + ((b[i] as i64) - (48 as i64)); }
  return v;
}

// ---------------------------------------------------------------- run

/**
 * The admitted object, fetched and run, or written out with --out. Every block comes through the resolver, which
 * checks it against its CID, and a file's size against its declared size, so the bytes are the admitted ones or
 * there are none. Exit 1 when they cannot be had; the program's own exit code otherwise.
 */
async i32 runAdmitted(Sys sys, string[] a, Resolver r, Cid c) {
  bool isDir;
  match (r.block(c)) {
    Err(e): { sys.warn("claim: the admitted object: \{e}"); return 1; }
    Ok(b): {
      match (readNode(c, b)) {
        Err(e): { sys.warn("claim: the admitted object: \{e}"); return 1; }
        Ok(n): { isDir = match (n) { Dir(_): true, Shard(_, _): true, File(_, _, _): false }; }
      }
    }
  }
  string out = flag(a, "--out", "");
  string entry = flag(a, "--entry", "");
  if (!isDir) {
    if (entry != "") { sys.warn("claim: --entry: \{c.text()} is a file, not a tree"); return 2; }
    u8[] bytes;
    match (readFile(r, c)) { Err(e): { sys.warn("claim: the admitted bytes: \{e}"); return 1; } Ok(b): { bytes = b; } }
    if (out != "") {
      match (await sys.writeFile(out, bytes)) { Err(e): { sys.warn("claim: --out \{out}: \{e}"); return 1; } Ok(_): { } }
      sys.warn("claim: \{c.text()}: \{bytes.len()} bytes, written to \{out}");
      return 0;
    }
    return await runSealed(sys, bytes, FileIn[](), string[](), afterDashes(a), a);
  }
  FileIn[] tree;
  match (readTree(r, c)) { Err(e): { sys.warn("claim: the admitted tree: \{e}"); return 1; } Ok(t): { tree = t; } }
  FileIn[] files = filesOnly(tree);
  string[] dirs = emptyDirsOf(tree);
  if (out != "") {
    for (i32 i = 0; i < dirs.len(); i++) { await sys.files().mkdir(out + "/" + dirs[i], true); }
    for (i32 i = 0; i < files.len(); i++) {
      string path = out + "/" + files[i].path;
      i32 slash = path.len() - 1;
      while (path.slice(slash, slash + 1) != "/") { slash--; }
      await sys.files().mkdir(path.slice(0, slash), true);
      match (await sys.writeFile(path, files[i].content)) { Err(e): { sys.warn("claim: --out \{path}: \{e}"); return 1; } Ok(_): { } }
    }
    sys.warn("claim: \{c.text()}: \{files.len()} file(s), written below \{out}");
    return 0;
  }
  if (entry == "") { sys.warn("claim: \{c.text()} is a tree: say which file in it is the program, with --entry PATH"); return 2; }
  for (i32 i = 0; i < files.len(); i++) {
    if (files[i].path == entry) { return await runSealed(sys, files[i].content, files, dirs, afterDashes(a), a); }
  }
  sys.warn("claim: no file \{entry} in \{c.text()}");
  return 1;
}

/**
 * Run `program` as the machine runs a derivation (cmd/derive.wac): its NaNs made canonical, sealed, with `files`
 * read-only at /in, an /out kept in memory and dropped, and nothing else (src/world.wac). Its output is passed on
 * when it ends.
 */
async i32 runSealed(Sys sys, u8[] program, FileIn[] files, string[] dirs, string[] args, string[] a) {
  u8[] runnable;
  match (canonicalize(program)) {
    Err(e): { sys.warn("claim: the program cannot be given canonical NaNs, so it is not run: \{e}"); return 1; }
    Ok(m): { runnable = m.module; }
  }
  Files world = worldFiles(files, dirs, Written.create());
  Child kid;
  match (await sys.procs().spawn(runnable, args, Authority(world, null, null, null), Launch("/", false, false, false, false).sealed())) {
    Err(e): { sys.warn("claim: the program did not start: \{e}"); return 1; }
    Ok(k): { kid = k; }
  }
  await kid.input().close();
  Ticket<Result<u8[], string>> log = drained(kid.output());
  Ticket<Result<u8[], string>> err = drained(kid.errors());
  i32 timeout = decimalOf(flag(a, "--timeout", "0")) as~ i32;
  i32 code = 1;
  match (await sys.clock().within(kid.exit(), timeout > 0 ? timeout : -1)) {
    Ok(x): { code = x; }
    Err(e): {
      if (e is TimedOut) { kid.stop(); sys.warn("claim: out of time after \{timeout}ms"); }
      else { sys.warn("claim: the program: \{e}"); }
    }
  }
  Result<u8[], string> logged = await log;
  Result<u8[], string> said = await err;
  if (logged.isOk()) { await sys.stdout().write(logged.unwrap()); }
  if (said.isOk()) { await sys.stderr().write(said.unwrap()); }
  return code;
}

/** Everything a stream gives until it ends. */
async Result<u8[], string> drained(Input in) {
  u8[] all = u8[]();
  while (true) {
    auto got = await in.chunk();
    if (got.isErr()) { return Result.Err("\{got.err()!}"); }
    match (got.unwrap()) {
      Data(bytes): {
        u8[] next = u8[].filled(all.len() + bytes.len(), 0);
        next.copyFrom(all, 0, 0, all.len());
        next.copyFrom(bytes, 0, all.len(), bytes.len());
        all = next;
      }
      End: { return Result.Ok(all); }
      Failed(why): { return Result.Err("\{why}"); }
    }
  }
}
