// derive — a runner for the deterministic WebAssembly machine (`src/machine.wac`).
//
//     derive recipe --program F [--args F] [--in DIR]   an input tree and a recipe over it, into the store;
//                                                        prints the recipe's CID
//     derive canon IN OUT [--scan F]                    a module with canonical NaNs, as `run` runs it
//     derive run RECIPE [--timeout MS] [--key F --runner NAME]
//                                                        run it: prints the output tree's CID, or nothing on an abort;
//                                                        with --key, signs a derivation, adds it to the store's
//                                                        claim index, and prints its statement id too
//
// --store DIR (default .objects), --mirror DIR (repeatable) as for `obj`.
//
// The program is handed the checked bytes, never a file, and holds one capability: a file system made here, in
// memory, from the verified input tree (`src/world.wac`). Its diagnostic output is not part of the output tree; this
// runner reads it only to learn how the run ended, and passes it on to its own.

import { Sys, Authority, Launch, Child, Files, Input, TimedOut, Env } from "std";
import { Read, Result, Ticket, flatten } from "core";
import { ipfs.Cid, ipfs.parseCid, ipfs.Store, ipfs.Resolver, ipfs.FileIn, ipfs.PROFILE, ipfs.encode, ipfs.readTree,
         ipfs.importFiles, ipfs.importDir, ipfs.emptyDirsOf, ipfs.filesOnly, ipfs.Block, ipfs.DAG_CBOR } from "@/lib.wac";
import { Recipe, recipeFrom, recipeId, recipeValue, Statement, Signed, signStatement, signedBlock, statementId } from "../src/claims.wac";
import { Index, loadIndex, saveIndex } from "../src/graph.wac";
import { Written, worldFiles } from "../src/world.wac";
import { MACHINE, FORMAT, Ending, endingOf, argsOf, outputFiles, outputDirs } from "../src/machine.wac";
import { unhex } from "../src/hex.wac";
import { canonicalize } from "../src/canon.wac";

string flag(string[] a, string name, string fallback) {
  for (i32 i = 0; i + 1 < a.len(); i++) { if (a[i] == name) { return a[i + 1]; } }
  return fallback;
}

export async i32 main(Sys sys) {
  string[] a = sys.args();
  if (a.len() < 1) {
    sys.warn("usage: derive recipe --program F [--args F] [--in DIR] | derive run RECIPE [--timeout MS] [--key F --runner NAME]  [--store DIR] [--mirror DIR]…");
    return 2;
  }
  Store store = Store.dir(sys.files(), flag(a, "--store", ".objects"));
  Store[] mirrors = Store[]();
  for (i32 i = 0; i + 1 < a.len(); i++) {
    if (a[i] != "--mirror") { continue; }
    Store[] next = Store[].filled(mirrors.len() + 1, Store.dir(sys.files(), a[i + 1]));
    for (i32 j = 0; j < mirrors.len(); j++) { next[j] = mirrors[j]; }
    mirrors = next;
  }
  Resolver r = Resolver(store, mirrors);
  if (a[0] == "recipe") { return await recipeCmd(sys, store, a); }
  if (a[0] == "canon" && a.len() >= 3) { return await canonCmd(sys, a); }
  if (a[0] == "run" && a.len() >= 2) { return await runCmd(sys, store, r, a); }
  sys.warn("derive: unknown command \{a[0]}");
  return 2;
}

async i32 recipeCmd(Sys sys, Store store, string[] a) {
  string programPath = flag(a, "--program", "");
  if (programPath == "") { sys.warn("derive recipe: --program is required"); return 2; }
  FileIn[] files = FileIn[]();
  string[] dirs = string[]();
  string inDir = flag(a, "--in", "");
  if (inDir != "") {
    // The directory through the importer, so `in/` is read exactly as `obj add` would read it, then read back.
    Cid sub;
    match (await importDir(store, sys.files(), inDir, PROFILE())) {
      Err(e): { sys.warn("derive: \{inDir}: \{e}"); return 1; }
      Ok(c): { sub = c; }
    }
    match (readTree(Resolver(store, Store[]()), sub)) {
      Err(e): { sys.warn("derive: \{e}"); return 1; }
      Ok(fs): {
        FileIn[] only = filesOnly(fs);
        string[] empty = emptyDirsOf(fs);
        files = FileIn[].filled(only.len(), FileIn("", u8[]()));
        for (i32 i = 0; i < only.len(); i++) { files[i] = FileIn("in/" + only[i].path, only[i].content); }
        dirs = string[].defaulted(empty.len() + 1);
        dirs[0] = "in";
        for (i32 i = 0; i < empty.len(); i++) { dirs[i + 1] = "in/" + empty[i]; }
      }
    }
  }
  match (await sys.readFile(programPath)) {
    Err(e): { sys.warn("derive: \{programPath}: \{e}"); return 1; }
    Ok(b): { files = plus(files, FileIn("program", b)); }
  }
  string argsPath = flag(a, "--args", "");
  if (argsPath != "") {
    match (await sys.readFile(argsPath)) {
      Err(e): { sys.warn("derive: \{argsPath}: \{e}"); return 1; }
      Ok(b): { files = plus(files, FileIn("args", b)); }
    }
  }
  Cid input;
  match (importFiles(store, files, dirs, PROFILE())) {
    Err(e): { sys.warn("derive: \{e}"); return 1; }
    Ok(c): { input = c; }
  }
  Recipe recipe = Recipe(MACHINE(), FORMAT(), input);
  Cid id = recipeId(recipe);
  match (store.put(Block(id, encode(recipeValue(recipe))))) {
    Err(e): { sys.warn("derive: \{e}"); return 1; }
    Ok(_): { }
  }
  sys.warn("input \{input.text()}");
  sys.log(id.text());
  return 0;
}

FileIn[] plus(FileIn[] xs, FileIn x) {
  FileIn[] out = FileIn[].filled(xs.len() + 1, x);
  for (i32 i = 0; i < xs.len(); i++) { out[i] = xs[i]; }
  return out;
}

async i32 runCmd(Sys sys, Store store, Resolver r, string[] a) {
  Cid id;
  match (parseCid(a[1])) {
    Err(e): { sys.warn("derive: \{e}"); return 1; }
    Ok(c): { id = c; }
  }
  Recipe recipe;
  match (r.block(id)) {
    Err(e): { sys.warn("derive: \{e}"); return 1; }
    Ok(b): {
      match (recipeFrom(b)) {
        Err(e): { sys.warn("derive: \{e}"); return 1; }
        Ok(x): { recipe = x; }
      }
    }
  }
  if (recipe.machine != MACHINE()) { sys.warn("derive: this runner is for \{MACHINE()}, not \{recipe.machine}"); return 1; }
  if (recipe.format != FORMAT()) { sys.warn("derive: this runner reads \{FORMAT()}, not \{recipe.format}"); return 1; }
  FileIn[] tree;
  match (readTree(r, recipe.input)) {
    Err(e): { sys.warn("derive: \{e}"); return 1; }
    Ok(fs): { tree = fs; }
  }
  FileIn[] input = filesOnly(tree);
  u8[]? program = null;
  u8[]? argsFile = null;
  for (i32 i = 0; i < input.len(); i++) {
    if (input[i].path == "program") { program = input[i].content; }
    if (input[i].path == "args") { argsFile = input[i].content; }
  }
  if (program is null) { sys.warn("derive: the input tree has no file `program`"); return 1; }

  // The machine's floats: every produced NaN canonical, by rewriting the module (src/canon.wac). A module the
  // rewrite cannot read is refused, never run without the profile.
  u8[] runnable;
  match (canonicalize(program!)) {
    Err(e): { sys.warn("derive: abort: the program cannot be given canonical NaNs: \{e}"); return 3; }
    Ok(c): { runnable = c.module; }
  }

  Written written = Written.create();
  Files world = worldFiles(input, emptyDirsOf(tree), written);
  Child kid;
  // --env-from-runner: the program reads this runner's own environment. That is OUTSIDE the machine, which promises
  // the program none, so a run with it is never signed. It exists for builds with dependencies, whose compiler finds
  // its package cache through $WAC_HOME, until wac lets a runner serve a fixed environment (docs/runner.md).
  bool envFromRunner = has(a, "--env-from-runner");
  if (envFromRunner && flag(a, "--key", "") != "") { sys.warn("derive: --env-from-runner is outside the machine, so nothing is signed with it"); return 2; }
  Env? givenEnv = envFromRunner ? sys.env() : null;
  // Sealed (machine version 2): the program, and anything it spawns, has no clock and no random bytes, on every host.
  // Version 1 could not take them away (docs/runner.md, finding 1).
  match (await sys.procs().spawn(runnable, argsOf(argsFile), Authority(world, null, givenEnv, null),
                                 Launch("/", false, false, false, false).sealed())) {
    Err(e): { sys.warn("derive: abort: the program did not start: \{e}"); return 3; }
    Ok(c): { kid = c; }
  }
  await kid.input().close();
  Ticket<Result<u8[], string>> log = drained(kid.output());
  Ticket<Result<u8[], string>> err = drained(kid.errors());
  i32 timeout = number(flag(a, "--timeout", "-1"));
  bool ran = true;
  i32 code = 0;
  match (await sys.clock().within(kid.exit(), timeout)) {
    Ok(c): { code = c; }
    Err(e): {
      if (e is TimedOut) {
        kid.stop();
        await log;
        await err;
        sys.warn("derive: abort: out of time after \{timeout}ms; no claim");
        return 3;
      }
      ran = false;
    }
  }
  Result<u8[], string> logged = await log;
  Result<u8[], string> said = await err;
  if (logged.isErr() || said.isErr()) { sys.warn("derive: abort: its output was not read to the end"); return 3; }
  if (said.unwrap().len() > 0) { await sys.stderr().write(said.unwrap()); }
  Ending ending = endingOf(ran, code, said.unwrap());
  if (ending.kind == "abort") { sys.warn("derive: abort: \{ending.why}; no claim"); return 3; }

  Cid output;
  match (importFiles(store, outputFiles(ending, logged.unwrap(), written), outputDirs(written), PROFILE())) {
    Err(e): { sys.warn("derive: \{e}"); return 1; }
    Ok(c): { output = c; }
  }
  sys.warn("derive: \{ending.kind == "exit" ? "exit \{ending.code}" : "trap \{ending.name}"}");
  sys.log(output.text());

  string keyPath = flag(a, "--key", "");
  if (keyPath == "") { return 0; }
  u8[]? key = null;
  match (await sys.readFile(keyPath)) {
    Err(e): { sys.warn("derive: \{keyPath}: \{e}"); return 1; }
    Ok(b): { key = unhex(withoutSpace(b)); }
  }
  if (key is null) { sys.warn("derive: \{keyPath} is not a hex key"); return 1; }
  Signed s = signStatement(Statement.Derivation(id, output, flag(a, "--runner", "reckon-derive/0")), key!);
  // Into the store's claim index, with the recipe, so `claim origins` and `claim admit` see it.
  Index ix = loadIndex(store).index;
  match (ix.add(s)) { Err(e): { sys.warn("derive: \{e}"); return 1; } Ok(_): { } }
  ix.addRecipe(recipe);
  match (saveIndex(ix, store)) { Err(e): { sys.warn("derive: \{e}"); return 1; } Ok(_): { } }
  sys.log(statementId(s.statement).text());
  return 0;
}

/** Everything a stream gives until it ends. */
async Result<u8[], string> drained(Input in) {
  u8[] all = u8[]();
  while (true) {
    auto got = await in.chunk();
    if (got.isErr()) { return Result.Err("\{got.err()!}"); }
    match (got.unwrap()) {
      Data(bytes): {
        u8[] next = u8[].filled(all.len() + bytes.len(), 0);
        next.copyFrom(all, 0, 0, all.len());
        next.copyFrom(bytes, 0, all.len(), bytes.len());
        all = next;
      }
      End: { return Result.Ok(all); }
      Failed(why): { return Result.Err("\{why}"); }
    }
  }
}

/** A decimal number, or -1. */
i32 number(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0 || b.len() > 9) { return -1; }
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] > '9') { return -1; }
    n = n * 10 + (b[i] - '0') as i32;
  }
  return n;
}

/** A key file's text, without the whitespace around it. */
string withoutSpace(u8[] b) {
  i32 from = 0;
  i32 to = b.len();
  while (from < to && (b[from] == ' ' || b[from] == '\n' || b[from] == '\r' || b[from] == '\t')) { from++; }
  while (to > from && (b[to - 1] == ' ' || b[to - 1] == '\n' || b[to - 1] == '\r' || b[to - 1] == '\t')) { to--; }
  u8[] out = u8[].filled(to - from, 0);
  out.copyFrom(b, from, 0, to - from);
  return string.fromBytes(out);
}

/** `derive canon IN OUT [--scan FILE]`: the module with canonical NaNs, as the runner will run it; the scan is for the oracle. */
async i32 canonCmd(Sys sys, string[] a) {
  match (await sys.readFile(a[1])) {
    Err(e): { sys.warn("derive: \{a[1]}: \{e}"); return 1; }
    Ok(b): {
      match (canonicalize(b)) {
        Err(e): { sys.warn("derive: \{e}"); return 1; }
        Ok(c): {
          await sys.writeFile(a[2], c.module);
          string scan = flag(a, "--scan", "");
          if (scan != "") { await sys.writeFile(scan, c.scan.toBytes()); }
          return 0;
        }
      }
    }
  }
}

bool has(string[] a, string name) {
  for (i32 i = 0; i < a.len(); i++) { if (a[i] == name) { return true; } }
  return false;
}
