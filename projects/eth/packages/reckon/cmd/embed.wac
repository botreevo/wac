// embed — a wac-web page put together inside the machine (tools/demo-app.sh): a recipe with two slots,
//
//     /in/glue/index.html       the page wac-web's builder writes, its module left out: `const WASM = ""`
//     /in/module/out/page.wasm  the page's module as the compiler built it, inside the machine: a derived output
//
// writing /out/index.html: the glue with the module, less its `wac.manifest` section, as base64 between those quotes,
// which is where and how the builder puts it. So the page a person opens is a derived output: the glue reviewed, the
// module derived, two runners witnessing the same page.

import { Sys } from "std";
import { Result } from "core";
import { codec.base64Encode, codec.BASE64_STANDARD } from "wac";
import { withoutManifest } from "../src/wasmsections.wac";

static string HOLE = "const WASM = \"\"";

async Result<string, string> embed(Sys sys) {
  u8[] glue;
  match (await sys.readFile("/in/glue/index.html")) { Err(e): { return Result.Err("/in/glue/index.html: \{e}"); } Ok(b): { glue = b; } }
  u8[] module;
  match (await sys.readFile("/in/module/out/page.wasm")) { Err(e): { return Result.Err("/in/module/out/page.wasm: \{e}"); } Ok(b): { module = b; } }
  string page = string.fromBytes(glue);
  i32 at = page.indexOf(HOLE);
  if (at < 0) { return Result.Err("the glue has no `\{HOLE}` for the module"); }
  if (page.slice(at + HOLE.len(), page.len()).indexOf(HOLE) >= 0) { return Result.Err("the glue has two holes"); }
  u8[] stripped = try withoutManifest(module);
  string b64 = string.fromBytes(base64Encode(stripped, BASE64_STANDARD(), true));
  string out = page.slice(0, at) + "const WASM = \"" + b64 + "\"" + page.slice(at + HOLE.len(), page.len());
  match (await sys.files().mkdir("/out", true)) { Err(e): { return Result.Err("/out: \{e}"); } Ok(_): { } }
  match (await sys.writeFile("/out/index.html", out.toBytes())) { Err(e): { return Result.Err("/out/index.html: \{e}"); } Ok(_): { } }
  return Result.Ok("embedded: \{stripped.len()} bytes of module (from \{module.len()}) into index.html, \{out.len()} bytes");
}

export async i32 main(Sys sys) {
  match (await embed(sys)) {
    Err(e): { sys.warn("embed: \{e}"); return 1; }
    Ok(said): { sys.log(said); return 0; }
  }
}
