// gather — one tree from files of a recipe's slots, inside the machine: each argument `FROM=TO` copies /in/FROM to
// /out/TO, and nothing else is written. A site whose page was derived and whose other files are source (a wac-web page
// and the data it loads beside it: tools/turbostack.sh) becomes one derived output, each of its files traced to a slot
// a policy admits in its own role.

import { Sys } from "std";

export async i32 main(Sys sys) {
  string[] a = sys.args();
  if (a.len() == 0) { sys.warn("usage: gather FROM=TO…  (FROM below /in, TO below /out)"); return 2; }
  for (i32 i = 0; i < a.len(); i++) {
    i32 eq = a[i].indexOf("=");
    if (eq < 1 || eq == a[i].len() - 1 || a[i].indexOf("..") >= 0) { sys.warn("gather: \{a[i]}: FROM=TO, with no .."); return 2; }
    string from = "/in/" + a[i].slice(0, eq);
    string to = "/out/" + a[i].slice(eq + 1, a[i].len());
    u8[] bytes;
    match (await sys.readFile(from)) { Err(e): { sys.warn("gather: \{from}: \{e}"); return 1; } Ok(b): { bytes = b; } }
    i32 slash = to.len() - 1;
    while (to.slice(slash, slash + 1) != "/") { slash--; }
    match (await sys.files().mkdir(to.slice(0, slash), true)) { Err(e): { sys.warn("gather: \{to}: \{e}"); return 1; } Ok(_): { } }
    match (await sys.writeFile(to, bytes)) { Err(e): { sys.warn("gather: \{to}: \{e}"); return 1; } Ok(_): { } }
    sys.log("\{from} → \{to} (\{bytes.len()} bytes)");
  }
  return 0;
}
