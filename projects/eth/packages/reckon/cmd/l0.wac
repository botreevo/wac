// l0 — a runner for the wac-L0 machine (`src/l0.wac`, docs/l0-machine.md).
//
//     l0 recipe --source F                              an input tree holding F as `source`, and a recipe over it, into
//                                                        the store; prints the recipe's CID
//     l0 run RECIPE --assembler CMD [--key F --runner NAME] [--work DIR]
//                                                        assemble it: prints the output tree's CID, or nothing when the
//                                                        runner failed; with --key, signs a derivation, adds it to the
//                                                        store's claim index, and prints its statement id too
//
// --store DIR (default .objects), --mirror DIR (repeatable) as for `obj`.
//
// The assembler is a host command, run as `/bin/sh -c 'CMD "$1" "$2"' sh IN OUT`: wac's Rust assembler is exactly
// that (`wax IN OUT`), and tools/l0/assemble.mjs gives its JavaScript one the same shape. It is handed the checked
// source as a file, and its exit says which answer it gave: 0 with OUT written is a module, 1 is a refusal, anything
// else is this runner's failure, and no claim is made.

import { Sys, ChildEnv, Launch } from "std";
import { Result } from "core";
import { ipfs.Cid, ipfs.parseCid, ipfs.Store, ipfs.Resolver, ipfs.FileIn, ipfs.PROFILE, ipfs.encode, ipfs.readTree,
         ipfs.importFiles, ipfs.filesOnly, ipfs.Block } from "@/lib.wac";
import { Recipe, recipeFrom, recipeId, recipeValue, Statement, Signed, signStatement, statementId } from "../src/claims.wac";
import { Index, loadIndex, saveIndex } from "../src/graph.wac";
import { FORMAT } from "../src/machine.wac";
import { L0_MACHINE, assembled, refused, dirsOf } from "../src/l0.wac";
import { unhex } from "../src/hex.wac";

string flag(string[] a, string name, string fallback) {
  for (i32 i = 0; i + 1 < a.len(); i++) { if (a[i] == name) { return a[i + 1]; } }
  return fallback;
}

export async i32 main(Sys sys) {
  string[] a = sys.args();
  if (a.len() < 1) {
    sys.warn("usage: l0 recipe --source F | l0 run RECIPE --assembler CMD [--key F --runner NAME] [--work DIR]  [--store DIR] [--mirror DIR]…");
    return 2;
  }
  Store store = Store.dir(sys.files(), flag(a, "--store", ".objects"));
  Store[] mirrors = Store[]();
  for (i32 i = 0; i + 1 < a.len(); i++) {
    if (a[i] != "--mirror") { continue; }
    Store[] next = Store[].filled(mirrors.len() + 1, Store.dir(sys.files(), a[i + 1]));
    for (i32 j = 0; j < mirrors.len(); j++) { next[j] = mirrors[j]; }
    mirrors = next;
  }
  if (a[0] == "recipe") { return await recipeCmd(sys, store, a); }
  if (a[0] == "run" && a.len() >= 2) { return await runCmd(sys, store, Resolver(store, mirrors), a); }
  sys.warn("l0: unknown command \{a[0]}");
  return 2;
}

async i32 recipeCmd(Sys sys, Store store, string[] a) {
  string path = flag(a, "--source", "");
  if (path == "") { sys.warn("l0 recipe: --source is required"); return 2; }
  u8[] text;
  match (await sys.readFile(path)) {
    Err(e): { sys.warn("l0: \{path}: \{e}"); return 1; }
    Ok(b): { text = b; }
  }
  Cid input;
  match (importFiles(store, [FileIn("source", text)], string[](), PROFILE())) {
    Err(e): { sys.warn("l0: \{e}"); return 1; }
    Ok(c): { input = c; }
  }
  Recipe recipe = Recipe(L0_MACHINE(), FORMAT(), input);
  Cid id = recipeId(recipe);
  match (store.put(Block(id, encode(recipeValue(recipe))))) {
    Err(e): { sys.warn("l0: \{e}"); return 1; }
    Ok(_): { }
  }
  sys.warn("input \{input.text()}");
  sys.log(id.text());
  return 0;
}

async i32 runCmd(Sys sys, Store store, Resolver r, string[] a) {
  Cid id;
  match (parseCid(a[1])) {
    Err(e): { sys.warn("l0: \{e}"); return 1; }
    Ok(c): { id = c; }
  }
  Recipe recipe;
  match (r.block(id)) {
    Err(e): { sys.warn("l0: \{e}"); return 1; }
    Ok(b): {
      match (recipeFrom(b)) {
        Err(e): { sys.warn("l0: \{e}"); return 1; }
        Ok(x): { recipe = x; }
      }
    }
  }
  if (recipe.machine != L0_MACHINE()) { sys.warn("l0: this runner is for \{L0_MACHINE()}, not \{recipe.machine}"); return 1; }
  if (recipe.format != FORMAT()) { sys.warn("l0: this runner reads \{FORMAT()}, not \{recipe.format}"); return 1; }
  FileIn[] tree;
  match (readTree(r, recipe.input)) {
    Err(e): { sys.warn("l0: \{e}"); return 1; }
    Ok(fs): { tree = filesOnly(fs); }
  }
  // The input is exactly one file, `source`: anything more or less is not a recipe for this machine.
  if (tree.len() != 1 || tree[0].path != "source") {
    sys.warn("l0: the input tree must hold exactly one file, `source`");
    return 1;
  }
  string assembler = flag(a, "--assembler", "");
  if (assembler == "") { sys.warn("l0 run: --assembler is required"); return 2; }

  string work = flag(a, "--work", ".l0-work");
  await sys.files().remove(work, true);
  await sys.files().mkdir(work, true);
  string inPath = work + "/source.l0";
  string outPath = work + "/module.wasm";
  match (await sys.writeFile(inPath, tree[0].content)) {
    Err(e): { sys.warn("l0: abort: \{e}"); return 3; }
    Ok(_): { }
  }
  i32 status = -1;
  match (await sys.procs().exec("/bin/sh", ["-c", assembler + " \"$1\" \"$2\"", "sh", inPath, outPath], u8[](),
                                ChildEnv.inherited(), Launch("", false, false, false, false))) {
    Err(e): { sys.warn("l0: abort: the assembler did not start: \{e}"); return 3; }
    Ok(ran): {
      if (ran.stderr.len() > 0) { await sys.stderr().write(ran.stderr); }
      status = ran.ok() ? 0 : ran.status;
    }
  }
  FileIn[] out;
  bool ok = false;
  if (status == 0) {
    match (await sys.readFile(outPath)) {
      Err(e): { sys.warn("l0: abort: the assembler said ok and wrote nothing: \{e}; no claim"); return 3; }
      Ok(b): { out = assembled(b); ok = true; }
    }
  } else if (status == 1) {
    out = refused();
  } else {
    sys.warn("l0: abort: the assembler failed (exit \{status}); no claim");
    return 3;
  }
  await sys.files().remove(work, true);

  Cid output;
  match (importFiles(store, out, dirsOf(ok), PROFILE())) {
    Err(e): { sys.warn("l0: \{e}"); return 1; }
    Ok(c): { output = c; }
  }
  sys.warn("l0: \{ok ? "ok" : "refused"}");
  sys.log(output.text());

  string keyPath = flag(a, "--key", "");
  if (keyPath == "") { return 0; }
  u8[]? key = null;
  match (await sys.readFile(keyPath)) {
    Err(e): { sys.warn("l0: \{keyPath}: \{e}"); return 1; }
    Ok(b): { key = unhex(hexOnly(b)); }
  }
  if (key is null) { sys.warn("l0: \{keyPath} is not a hex key"); return 1; }
  Signed s = signStatement(Statement.Derivation(id, output, flag(a, "--runner", "reckon-l0/0")), key!);
  Index ix = loadIndex(store).index;
  match (ix.add(s)) { Err(e): { sys.warn("l0: \{e}"); return 1; } Ok(_): { } }
  ix.addRecipe(recipe);
  match (saveIndex(ix, store)) { Err(e): { sys.warn("l0: \{e}"); return 1; } Ok(_): { } }
  sys.log(statementId(s.statement).text());
  return 0;
}

/** A key file's hex digits, without the whitespace around or within it. */
string hexOnly(u8[] b) {
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) { if (b[i] != ' ' && b[i] != '\n' && b[i] != '\r' && b[i] != '\t') { n++; } }
  u8[] out = u8[].filled(n, 0);
  i32 j = 0;
  for (i32 i = 0; i < b.len(); i++) { if (b[i] != ' ' && b[i] != '\n' && b[i] != '\r' && b[i] != '\t') { out[j] = b[i]; j++; } }
  return string.fromBytes(out);
}
