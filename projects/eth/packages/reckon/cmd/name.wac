// name — an ENS name's content, as a CID, read from a chain by proof: the registry's record of the name, then the
// contenthash in the resolver that record names. Every value is a storage slot proved against one header's state root,
// by the same code that reads mainnet's (packages/ens: verified.wac, contenthash.wac).
//
//     name resolve NAME --rpc HOST:PORT --registry ADDR --registry-code HASH --resolver-code HASH [--anchor BLOCKHASH]
//
// Prints `ipfs://CID`, then the block it was proved at, the owner and the resolver. Exit 1 when the name has no
// owner or no contenthash (each proved absent), 3 when it cannot be proved.
//
// **What anchors it.** On mainnet the header comes from the light client (`lc`), so the state root is the chain's.
// A devnet has no beacon chain, so here the header is the node's latest block (or `--anchor`, a block hash you trust),
// and what is checked beyond the proofs is that the two accounts run the code you deployed: `--registry-code` and
// `--resolver-code`, the keccak256 of their runtime code. Without an anchor that proves the node is consistent with
// itself and with those contracts, not that its chain is anyone else's; it says so when it answers.

import { Sys } from "std";
import { codec.hexDecoded } from "wac";
import { ensContent, NameAnswer } from "../src/names.wac";

u8[] unhex(string s) { return hexDecoded(s.len() >= 2 && s.slice(0, 2) == "0x" ? s.slice(2, s.len()) : s); }

string flag(string[] a, string name) {
  for (i32 i = 0; i + 1 < a.len(); i++) { if (a[i] == name) { return a[i + 1]; } }
  return "";
}

export i32 main(Sys sys) {
  string[] a = sys.args();
  if (a.len() < 2 || a[0] != "resolve") {
    sys.warn("usage: name resolve NAME --rpc HOST:PORT --registry ADDR --registry-code HASH --resolver-code HASH [--anchor BLOCKHASH]");
    return 2;
  }
  string rpc = flag(a, "--rpc");
  i32 colon = rpc.indexOf(":");
  u8[] registry = unhex(flag(a, "--registry"));
  u8[] rc = unhex(flag(a, "--registry-code"));
  u8[] vc = unhex(flag(a, "--resolver-code"));
  u8[] anchor = flag(a, "--anchor") == "" ? u8[]() : unhex(flag(a, "--anchor"));
  if (colon < 1 || registry.len() != 20 || rc.len() != 32 || vc.len() != 32 || (anchor.len() != 0 && anchor.len() != 32)) {
    sys.warn("name: --rpc HOST:PORT, a 20-byte --registry, and 32-byte --registry-code and --resolver-code are required");
    return 2;
  }
  i32 port = 0;
  u8[] ps = rpc.slice(colon + 1, rpc.len()).toBytes();
  for (i32 i = 0; i < ps.len(); i++) { port = port * 10 + (ps[i] as i32) - 48; }
  match (ensContent(sys.net(), a[1], rpc.slice(0, colon), port, registry, rc, vc, anchor)) {
    Ok(ans): { sys.log(ans.out); return ans.code; }
    Err(e): { sys.warn("name: \{e}"); return 3; }
  }
}
