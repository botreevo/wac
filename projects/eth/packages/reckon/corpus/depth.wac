// Recursion to the depth given as the first argument: the stack a runner of machine /1 must provide (docs/runner.md).
import { Sys } from "std";
i64 down(i64 n, i64 acc) { if (n == 0 as i64) { return acc; } return down(n - (1 as i64), acc + n) + (1 as i64); }
i64 parse(string s) {
  i64 v = 0 as i64;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { v = v * (10 as i64) + ((b[i] as i32 - '0') as i64); }
  return v;
}
export i32 main(Sys sys) { i64 d = parse(sys.args()[0]); sys.log("depth \{d}: \{down(d, 0 as i64)}"); return 0; }
