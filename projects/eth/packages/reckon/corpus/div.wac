// Integer division by zero: a trap the module decides, so an output. The divisor comes from the run (two arguments
// in tools/machine.sh), so nothing can fold it away.
import { Sys } from "std";
export i32 main(Sys sys) { sys.log("before"); i32 z = sys.args().len() - 2; sys.log("\{7 / z}"); return 3; }
