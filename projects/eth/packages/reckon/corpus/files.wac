// Reads the input tree at /in and writes what it found under /out: the ordinary case, which must agree everywhere.
import { Sys, Files } from "std";
import { flatten } from "core";

async void walk(Sys sys, Files fs, string dir, string[] seen) {
  auto names = await fs.readDir(dir);
  if (names.isErr()) { sys.log("cannot list \{dir}: \{names.err()!}"); return; }
  string[] ns = names.unwrap();
  for (i32 i = 0; i < ns.len(); i++) {
    string p = dir + "/" + ns[i];
    auto st = (await fs.stat(p)).unwrap();
    if (st.isDir) { sys.log("dir  \{p}"); await walk(sys, fs, p, seen); }
    else { sys.log("file \{p} \{st.size}"); }
  }
}

export async i32 main(Sys sys) {
  Files fs = sys.files();
  string[] args = sys.args();
  sys.log("args \{args.len()}: \{args.len() > 0 ? args[0] : ""}");
  await walk(sys, fs, "/in", string[]());
  auto wrote = await fs.writeFile("/in/x", "no".toBytes());
  sys.log(wrote.isOk() ? "wrote /in/x" : "refused /in/x: \{wrote.err()!}");
  auto up = await fs.readFile("/in/../../etc/hostname");
  sys.log(up.isOk() ? "read outside" : "refused climbing out");
  await fs.mkdir("/out/a/b", true);
  await fs.mkdir("/out/empty", false);
  await fs.writeFile("/out/a/b/copy.txt", (await fs.readFile("/in/in/sub/a.txt")).orElse("missing".toBytes()));
  await fs.writeFile("/out/a/gone", "x".toBytes());
  await fs.remove("/out/a/gone", false);
  auto o = (await fs.openWrite("/out/streamed")).unwrap();
  await o.write("one ".toBytes());
  await o.write("two".toBytes());
  await o.close();
  auto bad = await fs.writeFile("/out/missing/dir/f", "x".toBytes());
  sys.log(bad.isOk() ? "wrote without a directory" : "refused a file in a missing directory");
  return 0;
}
