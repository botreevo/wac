// Float results, bit for bit: which of them two engines agree on is what the machine can promise.
// Every operand comes from the arguments' count, so neither wacc nor an engine can fold it away.
import { Sys } from "std";

string hex64(u64 b) {
  string digits = "0123456789abcdef";
  string out = "";
  for (i32 i = 15; i >= 0; i--) {
    i32 d = ((b >> ((i * 4) as@ u32 as u64)) & (15 as u64)) as~ i32;
    out += digits.slice(d, d + 1);
  }
  return out;
}

string hex32(u32 b) { return hex64(b as u64).slice(8, 16); }

void show(Sys sys, string name, f64 x) { sys.log("\{name} \{hex64(f64.toBits(x))}"); }
void show32(Sys sys, string name, f32 x) { sys.log("\{name} \{hex32(f32.toBits(x))}"); }

export i32 main(Sys sys) {
  f64 zero = sys.args().len() as f64;                       // 0 when run with no arguments
  f64 one = zero + 1.0;
  f64 inf = one / zero;
  f64 nan = zero / zero;
  f64 quiet = f64.fromBits(0x7FF8000000000001);             // a positive NaN with a payload
  f64 negq = f64.fromBits(0xFFF8000000000002);
  show(sys, "0/0", nan);
  show(sys, "inf-inf", inf - inf);
  show(sys, "inf*0", inf * zero);
  show(sys, "sqrt(-1)", (zero - one).sqrt());
  show(sys, "-(0/0)", -nan);
  show(sys, "abs(0/0)", nan.abs());
  show(sys, "payload+1", quiet + one);
  show(sys, "payload*1", quiet * one);
  show(sys, "negpayload-0", negq - zero);
  show(sys, "min(nan,1)", nan.min(one));
  show(sys, "max(1,payload)", one.max(quiet));
  show(sys, "copysign", quiet.copySign(zero - one));
  show(sys, "nan+payload", nan + quiet);
  show(sys, "payload+negpayload", quiet + negq);
  show(sys, "floor(payload)", quiet.floor());
  show(sys, "sqrt(payload)", quiet.sqrt());
  f32 n32 = nan as~ f32;
  show32(sys, "demote(0/0)", n32);
  show32(sys, "demote(payload)", quiet as~ f32);
  show(sys, "promote(demote(payload))", (quiet as~ f32) as f64);
  show32(sys, "f32 0/0", (zero as~ f32) / (zero as~ f32));
  // Ordinary arithmetic, which must agree everywhere.
  f64 acc = one;
  for (i32 i = 1; i < 2000; i++) { acc = acc * 1.0001 + (i as f64).sqrt() / (acc + 3.0); }
  show(sys, "series", acc);
  show(sys, "subnormal", f64.fromBits(0x0000000000000003) * (one + one));
  show(sys, "-0*1", (zero - zero) * -one);
  show(sys, "round(2.5)", (one + one + 0.5).round());
  return 0;
}
