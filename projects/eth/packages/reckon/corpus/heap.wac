// Holds the MiB given as the first argument live at once, in 1 MiB arrays: the heap a runner of machine /1 must provide.
import { Sys } from "std";
i32 parse(string s) {
  i32 v = 0;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { v = v * 10 + (b[i] as i32 - '0'); }
  return v;
}
export i32 main(Sys sys) {
  i32 n = parse(sys.args()[0]);
  u8[][] keep = u8[][].filled(n, u8[]());
  i64 sum = 0 as i64;
  for (i32 i = 0; i < n; i++) { keep[i] = u8[].filled(1048576, (i & 255) as@ u8); sum = sum + (keep[i][i % 1048576] as i64); }
  sys.log("held \{n} MiB, sum \{sum}");
  return 0;
}
