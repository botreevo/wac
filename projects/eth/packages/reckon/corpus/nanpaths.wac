// Every way a produced NaN can leave the arithmetic that made it, each checked for the canonical bits. src/canon.wac
// skips the check on a result whose payload cannot be seen (one consumed by more arithmetic, a comparison, or a local
// only ever read that way), so this is the test that skipping it never lets a payload out: through a local, a tee,
// an array, a struct, a return, a call argument, `neg`, `copysign`, a `select`, a loop-carried local, and an f32.
//
// Exit 0 when every one is canonical. Run without the rewrite on x86 it fails: there `0/0` is fff8…, not 7ff8….
import { Sys } from "std";

struct Box { f64 v; }

string hex64(u64 b) {
  string digits = "0123456789abcdef";
  string out = "";
  for (i32 i = 15; i >= 0; i--) {
    i32 d = ((b >> ((i * 4) as@ u32 as u64)) & (15 as u64)) as~ i32;
    out += digits.slice(d, d + 1);
  }
  return out;
}

f64 made(f64 zero) { return zero / zero; }                  // a NaN returned
u64 bitsOf(f64 x) { return f64.toBits(x); }                 // a NaN passed in

export i32 main(Sys sys) {
  f64 zero = (sys.args().len() as f64) * 0.0;               // 0 whatever the arguments, and not foldable: n*0.0 is not 0 for every n
  f64 one = zero + 1.0;
  u64 canon = 0x7FF8000000000000;
  u64 negCanon = 0xFFF8000000000000;
  i32 bad = 0;

  f64 a = zero / zero;                                      // local, read only by toBits
  f64 b = (zero / zero) * one + zero;                       // a chain: only the last op's result shows
  f64 c = zero / zero;
  f64 d = c + one;                                          // c is only read by arithmetic; d shows
  f64[] arr = f64[].filled(1, 0.0);
  arr[0] = zero / zero;                                     // into an array
  Box box = Box(0.0);
  box.v = zero * (one / zero) ;                             // 0 * inf, into a struct
  f64 e = -(zero / zero);                                   // neg carries the payload: fff8 once canonical
  f64 f = one.copySign(zero / zero);                        // copysign shows the NaN's sign: canonical is +
  f64 g = one > zero ? zero / zero : one;                   // a select or a branch
  f64 h = one;
  for (i32 i = 0; i < 3; i++) { h = h * (zero / zero); }   // loop-carried
  f32 k = (zero as~ f32) / (zero as~ f32);
  bool cmp = (zero / zero) == (zero / zero);                // comparisons: false whatever the payload

  f64[] xs = [a, b, d, arr[0], box.v, made(zero), g, h];
  string[] ns = ["local", "chain", "via-arith-local", "array", "struct", "return", "select", "loop"];
  for (i32 i = 0; i < xs.len(); i++) {
    u64 v = bitsOf(xs[i]);
    if (v != canon) { bad++; sys.log("\{ns[i]} \{hex64(v)} (want \{hex64(canon)})"); } else { sys.log("\{ns[i]} ok"); }
  }
  if (f64.toBits(e) != negCanon) { bad++; sys.log("neg \{hex64(f64.toBits(e))}"); } else { sys.log("neg ok"); }
  if (f64.toBits(f) != 0x3FF0000000000000) { bad++; sys.log("copysign \{hex64(f64.toBits(f))}"); } else { sys.log("copysign ok"); }
  if (f32.toBits(k) != (0x7FC00000 as u32)) { bad++; sys.log("f32 \{hex64(f32.toBits(k) as u64)}"); } else { sys.log("f32 ok"); }
  if (cmp) { bad++; sys.log("compare: NaN == NaN"); } else { sys.log("compare ok"); }
  return bad == 0 ? 0 : 1;
}
