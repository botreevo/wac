// What a program can reach that is not its input: run by tools/machine.sh, which checks the refusals and reports the rest.
import { Sys } from "std";
import { flatten } from "core";

export async i32 main(Sys sys) {
  auto now = await sys.clock().nowMillis();
  sys.log(now.isOk() ? "clock: \{now.unwrap()}" : "clock: refused \{now.err()!}");
  auto mono = await sys.clock().monotonicNanos();
  sys.log(mono.isOk() ? "monotonic: \{mono.unwrap()}" : "monotonic: refused \{mono.err()!}");
  auto rnd = await sys.random().bytes(4);
  sys.log(rnd.isOk() ? "random: \{rnd.unwrap().len()} bytes" : "random: refused \{rnd.err()!}");
  auto host = await sys.files().readFile("/etc/hostname");
  sys.log(host.isOk() ? "read /etc/hostname: ok" : "read /etc/hostname: refused \{host.err()!}");
  auto home = await sys.env().get("HOME");
  sys.log(home.isOk() ? "env HOME: ok" : "env HOME: refused \{home.err()!}");
  auto cwd = await sys.env().cwd();
  sys.log(cwd.isOk() ? "cwd: \{cwd.unwrap()}" : "cwd: refused \{cwd.err()!}");
  sys.log("args: \{sys.args().len()}");
  return 0;
}
