// A Mandelbrot set, as a web page: the app reckon's demo admits and shows (docs/browser-extension.md, "a real app").
// A wac-web page (`main(Page)`): every pixel an iteration loop in wac, compiled to WebAssembly, blitted into a canvas
// in one call; click to centre there and zoom. Built with wac-web's page builder (`--in-page`), and its module derived
// in the sealed machine on two runners (tools/demo-app.sh).

import { ElementEvent, Node, Page, Ref, Ui, html.button, html.canvas, html.div, html.h1, html.p, html.style } from "web";

static string STYLE =
  "body { margin: 0; font: 15px system-ui, sans-serif; background: #0d1417; color: #e3ecec; }" +
  "#app { max-width: 36rem; margin: 0 auto; padding: 1.2rem; }" +
  "h1 { font-size: 1.2rem; margin: 0 0 .3rem; }" +
  "p { margin: 0 0 .8rem; color: #9db1b2; }" +
  "canvas { width: 100%; height: auto; image-rendering: pixelated; border-radius: 6px; cursor: zoom-in; }" +
  "button { margin: .6rem .4rem 0 0; font: inherit; padding: .25rem .8rem; border-radius: 5px; cursor: pointer;" +
  "         background: #16262b; color: #e3ecec; border: 1px solid #2b4148; }";

static i32 W = 360;
static i32 H = 240;
static i32 LIMIT = 200;

/** The view, in millionths of a unit of the complex plane: its width, and its centre. */
struct View { i32 span; i32 cx; i32 cy; }

View start() { return View(3200000, 0 - 600000, 0); }

/** How many steps the point under pixel (x, y) takes to leave the radius-2 disc, or LIMIT if it never does. */
i32 steps(i32 x, i32 y, View v) {
  f64 re = (v.cx as f64) / 1000000.0 + ((x - W / 2) as f64) * (v.span as f64) / 1000000.0 / (W as f64);
  f64 im = (v.cy as f64) / 1000000.0 + ((y - H / 2) as f64) * (v.span as f64) / 1000000.0 / (W as f64);
  f64 a = 0.0;
  f64 b = 0.0;
  i32 n = 0;
  while (n < LIMIT && a * a + b * b <= 4.0) {
    f64 t = a * a - b * b + re;
    b = 2.0 * a * b + im;
    a = t;
    n++;
  }
  return n;
}

/** The picture as RGBA: inside the set dark, outside coloured by how fast it escapes. */
u8[] draw(View v) {
  u8[] px = u8[].filled(W * H * 4, 0);
  for (i32 y = 0; y < H; y++) {
    for (i32 x = 0; x < W; x++) {
      i32 n = steps(x, y, v);
      i32 at = (y * W + x) * 4;
      if (n >= LIMIT) { px[at] = 8 as u8; px[at + 1] = 16 as u8; px[at + 2] = 20 as u8; }
      else {
        i32 k = n * 255 / 48;
        if (k > 255) { k = 255; }
        px[at] = (k / 4) as@ u8;
        px[at + 1] = ((k * 3) / 4) as@ u8;
        px[at + 2] = k as@ u8;
      }
      px[at + 3] = 255 as u8;
    }
  }
  return px;
}

Node App(Ui ui, Page page) {
  auto view = ui.state(start());
  auto took = ui.state("drawing…");
  Ref c = ui.ref();
  View v = view.get();
  ui.effect("\{v.span} \{v.cx} \{v.cy}", () => {
    f64 t0 = page.now();
    c.element()!.pixels(W, H, draw(v));
    took.set("\{W * H} pixels in \{(page.now() - t0) as~ i32} ms");
    return () => { };
  });
  return <div id="app">
    <style>{STYLE}</style>
    <h1>A Mandelbrot set, admitted</h1>
    <p>Built from reviewed source by two runners in a sealed machine, named, admitted by your policy, and run with
      no network. Click to zoom.</p>
    <p id="took">{took.get()}</p>
    <canvas ref={c} id="c" onclick={(ElementEvent e) => {
      View g = view.get();
      i32 per = g.span / W;
      view.set(View(g.span / 2, g.cx + (e.x - W / 2) * per, g.cy + (e.y - H / 2) * per));
    }}></canvas>
    <div>
      <button id="out" onclick={(ElementEvent e) => { view.update((View g) => View(g.span * 2, g.cx, g.cy)); }}>zoom out</button>
      <button id="reset" onclick={(ElementEvent e) => { view.set(start()); }}>reset</button>
    </div>
  </div>;
}

export async i32 main(Page page) {
  page.title("A Mandelbrot set, admitted");
  page.mount((Ui ui) => App(ui, page));
  return 0;
}
