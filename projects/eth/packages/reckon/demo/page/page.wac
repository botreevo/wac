// Written by web's tools/build.wac — the calls the host makes, and the program they run.
import { main } from "../mandelbrot.wac";
import { PAGE_CAPABILITY, Page, PageLine, Runner, System, World, answered } from "web";
import { Answer, OP_CAPABILITY, ask } from "std";
import { Ticket } from "core";

export struct PageHost {
  private World world;
  private Page? page;

  PageHost create(System system) {
    Runner r = Runner.create();
    schedule r.take;
    return PageHost(World.create(system, 0), null);
  }

  void answer(this, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m, i32 flags) {
    if (this.page is null) {
      this.world.deliver(req, fault, text, bytes, n, m, flags);
      return;
    }
    answered(this.page!, this.world, req, fault, text, bytes, n, m, flags);
  }

  /** Open the page this host provides, then run the program with it as its schedule target until it first waits. */
  void start(this) {
    Ticket<Answer> found = ask(this.world.host, OP_CAPABILITY(), 0 as i64, 0 as i64, PAGE_CAPABILITY(), "^1".toBytes());
    if (!found.settled() || found.value().fault != 0) {
      trap "the page's host does not provide " + PAGE_CAPABILITY() + (found.settled() ? ": " + found.value().text : "");
    }
    Page page = Page.over(PageLine(this.world.host, found.value().n as~ i32), this.world.sys);
    this.page = page;
    schedule page.take;
    main(page);
    page.drain();
    page.turn();
  }
}
