// The bootstrap's host-run machines: what a recipe naming one means, apart from any runner. Each is a pure function
// of its input, defined by a written rule in wac's bootstrap and implemented twice there, in Rust and in JavaScript,
// so two runners can be asked to agree. Neither has a program in its input: the machine *is* the tool.
//
// wac-l0/1 (docs/l0-machine.md)          wac's bootstrap/spec/l0.md: one L0 text assembled into one wasm module.
//     input   source                     the L0 text
//     output  status, out/module.wasm
//
// wac-flatten/1 (docs/flatten-machine.md) the rule wac's two flatteners share (bootstrap/js/flatten.js,
//                                        bootstrap/rust-ladder/src/flatten.rs): a module graph, as one program.
//     input   tree/…, entry              the sources, and the entry's path within tree/, one line
//     output  status, out/flat.wac
//
// wasm-seam/1 (docs/seam-machine.md)     one rung of the ladder run: a module wac's ladder made from hand-written L0,
//                                        given text through the rung's seam (bootstrap/js/ladder.js), its answer kept.
//     input   module, source[, subject][, suffix]
//                                        the rung, the text it is given, for the interpreter an L2 program that
//                                        `source` (the L2 compiler) is to compile, and for a compiler a suffix
//                                        appended after a newline (the driver the Rust ladder appends to wacc)
//     output  status, out/answer.l0
//
// wacc-drive/1 (docs/drive-machine.md)   the wacc the ladder built, compiling a program: the tail of wac's
//                                        `ladder --with-wacc` (its file set, emitFiles, seal).
//     input   wacc, tree/…, entry, name, grants
//                                        the driven wacc, the sources, the program's path within tree/, the module
//                                        name its manifest records, and its `--allow-…` grants, by name
//     output  status, out/module.wasm    the sealed module; `refused` when wacc declines the program
//
// `status` is "ok" or "refused". A refusal's message is not part of the output: the two implementations word it
// differently. A runner's own failure (its tool did not start, crashed, or wrote nothing) is no answer and no claim.

import { ipfs.FileIn } from "@/lib.wac";

export string L0_MACHINE() { return "wac-l0/1"; }
export string FLATTEN_MACHINE() { return "wac-flatten/1"; }
export string SEAM_MACHINE() { return "wasm-seam/1"; }
export string DRIVE_MACHINE() { return "wacc-drive/1"; }

/** Whether this is one of these machines. */
export bool isBootMachine(string m) {
  return m == L0_MACHINE() || m == FLATTEN_MACHINE() || m == SEAM_MACHINE() || m == DRIVE_MACHINE();
}

/** The file a machine's answer is, under `out/`. */
export string outName(string machine) {
  if (machine == L0_MACHINE() || machine == DRIVE_MACHINE()) { return "module.wasm"; }
  return machine == FLATTEN_MACHINE() ? "flat.wac" : "answer.l0";
}

/** The output tree for an answer. */
export FileIn[] answered(string machine, u8[] bytes) {
  return [FileIn("status", "ok".toBytes()), FileIn("out/" + outName(machine), bytes)];
}

/** The output tree for an input the rule refuses. */
export FileIn[] refused() { return [FileIn("status", "refused".toBytes())]; }

/** The output's directories: `out` when there is an answer, none for a refusal. */
export string[] dirsOf(bool ok) { return ok ? ["out"] : string[](); }
