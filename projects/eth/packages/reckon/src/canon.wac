// NaN canonicalization, by rewriting the module: WebAssembly 3.0's deterministic profile, imposed on any engine.
//
// The WebAssembly spec lets an operation whose result is NaN choose that NaN's sign and payload, and engines do choose
// differently: V8 and wasmtime disagree on `max(1, NaN with a payload)`, and x86 gives `0/0` a sign bit that ARM does
// not (docs/runner.md). A program sees the difference through `toBits`, so a deterministic machine must take the
// choice away. The deterministic profile does that by making every NaN an operation *produces* the canonical positive
// NaN, while the operations that only move bits (`neg`, `abs`, `copysign`, the reinterprets, loads and stores) keep
// them exactly.
//
// So the rewrite is this: after every float operation that may produce a NaN (arithmetic, `min`/`max`, `sqrt`, the
// four roundings, `promote` and `demote`) whose NaN could be seen, replace a NaN result with the canonical one, inline
// and without a branch:
//
//     local.tee $t  f64.const nan:0x8000000000000  local.get $t  local.get $t  f64.eq  select
//
// `select` keeps `$t` when it equals itself, which only a NaN does not. `$t` is a scratch local appended to the
// function's locals, one f64 and one f32, after its parameters (from its type) and its own locals, so no existing local
// moves. Only functions that need a check change; no section but the code section changes, and no index anywhere.
//
// **Where a NaN could be seen.** A result consumed by another NaN-producing operation (which is checked, or passes the
// duty on), by a comparison, by a conversion to an integer or by `drop` shows nothing of its payload, and neither does
// one kept in a local whose every read is consumed that way. `simulate` follows values through the stack within
// straight-line code to find which results are only consumed so; anything it does not model (a call, a branch, a block,
// `select`, a store, a reinterpret…) counts as seeing what is on the stack, so a value it cannot follow is checked where
// it was made. In `dx*dx + dy*dy + dz*dz` only the last add is checked. corpus/nanpaths.wac sends a produced NaN out
// every way it can leave and checks each is canonical. Version 1 called one of two appended functions after every such
// operation instead: on corpus/nbody.wac that cost +73% on V8 and +244% on wasmtime, and this costs +16% and +15%
// (docs/runner.md).
//
// The decoder reads every instruction a wac-built module contains (the core set, reference types, GC, tail calls,
// exceptions, the 0xFC group). It refuses what it does not know, SIMD included, rather than guess at its length, so
// a module it cannot rewrite is refused, not run unprofiled. `tools/wasmscan` (wasmparser, as wasmtime uses) is the
// oracle: it must find the same operators at the same offsets, and the rewritten module must validate.

import { Result } from "core";

struct Reader {
  u8[] b;
  i32 at;
  bool bad;

  u8 byte(this) {
    if (this.at >= this.b.len()) { this.bad = true; return 0 as u8; }
    u8 v = this.b[this.at];
    this.at++;
    return v;
  }

  /** An unsigned LEB128 (u32 here; a larger one is refused). */
  i32 u32(this) {
    i32 v = 0;
    i32 shift = 0;
    while (true) {
      u8 x = this.byte();
      if (this.bad) { return 0; }
      if (shift < 32) { v = v | (((x as i32) & 127) << shift); }
      if ((x & (128 as u8)) == 0) { break; }
      shift += 7;
      if (shift > 35) { this.bad = true; return 0; }
    }
    return v;
  }

  /** Any LEB128, signed or not, up to 64 bits: skipped, its length all that matters. */
  void leb(this) {
    for (i32 i = 0; i < 10; i++) {
      u8 x = this.byte();
      if (this.bad || (x & (128 as u8)) == 0) { return; }
    }
    this.bad = true;
  }

  void skip(this, i32 n) {
    if (this.at + n > this.b.len()) { this.bad = true; return; }
    this.at += n;
  }
}

/** A growing byte buffer. */
struct Out {
  u8[] b;
  i32 n;

  Out create() { return Out(u8[].filled(256, 0), 0); }

  void put(this, u8 x) {
    if (this.n == this.b.len()) {
      u8[] g = u8[].filled(this.b.len() * 2, 0);
      g.copyFrom(this.b, 0, 0, this.n);
      this.b = g;
    }
    this.b[this.n] = x;
    this.n++;
  }

  void all(this, u8[] xs) { for (i32 i = 0; i < xs.len(); i++) { this.put(xs[i]); } }

  void range(this, u8[] src, i32 from, i32 to) { for (i32 i = from; i < to; i++) { this.put(src[i]); } }

  void u32(this, i32 v) {
    i32 x = v;
    while (true) {
      i32 low = x & 127;
      x = (x >> 7) & 33554431;
      if (x == 0) { this.put(low as@ u8); return; }
      this.put((low | 128) as@ u8);
    }
  }

  u8[] take(this) {
    u8[] r = u8[].filled(this.n, 0);
    r.copyFrom(this.b, 0, 0, this.n);
    return r;
  }
}

// ── Types and imports: only far enough to count ──────────────────────────────────────────────────────────

/** A value type: one byte, or a reference type with a heap type after it. */
void valtype(Reader r) {
  u8 t = r.byte();
  if (t == (0x63 as u8) || t == (0x64 as u8)) { r.leb(); }
}

void storagetype(Reader r) { valtype(r); }                 // the packed types are single bytes as well

/** A composite type: a function type's parameter count, or -1 for a struct or an array. */
i32 comptype(Reader r) {
  u8 k = r.byte();
  if (k == (0x60 as u8)) {                                  // func
    i32 np = r.u32();
    for (i32 i = 0; i < np && !r.bad; i++) { valtype(r); }
    i32 nr = r.u32();
    for (i32 i = 0; i < nr && !r.bad; i++) { valtype(r); }
    return np;
  } else if (k == (0x5F as u8)) {                           // struct
    i32 nf = r.u32();
    for (i32 i = 0; i < nf && !r.bad; i++) { storagetype(r); r.byte(); }
  } else if (k == (0x5E as u8)) {                           // array
    storagetype(r);
    r.byte();
  } else {
    r.bad = true;
  }
  return -1;
}

i32 subtype(Reader r) {
  u8 k = r.b[r.at];
  if (k == (0x50 as u8) || k == (0x4F as u8)) {
    r.byte();
    i32 n = r.u32();
    for (i32 i = 0; i < n && !r.bad; i++) { r.u32(); }
  }
  return comptype(r);
}

i32[] push(i32[] xs, i32 x) {
  i32[] out = i32[].filled(xs.len() + 1, x);
  for (i32 i = 0; i < xs.len(); i++) { out[i] = xs[i]; }
  return out;
}

/** Each type's parameter count, by type index (-1 for a struct or an array); null when the section does not decode. */
i32[]? typeParams(u8[] sec) {
  Reader r = Reader(sec, 0, false);
  i32 groups = r.u32();
  i32[] out = i32[]();
  for (i32 g = 0; g < groups && !r.bad; g++) {
    if (r.b[r.at] == (0x4E as u8)) {
      r.byte();
      i32 n = r.u32();
      for (i32 i = 0; i < n && !r.bad; i++) { out = push(out, subtype(r)); }
    } else {
      out = push(out, subtype(r));
    }
  }
  return r.bad ? null : out;
}

// ── Instructions ─────────────────────────────────────────────────────────────────────────────────────────

void blocktype(Reader r) {
  u8 t = r.b[r.at];
  if (t == (0x40 as u8)) { r.byte(); return; }
  if (t == (0x63 as u8) || t == (0x64 as u8)) { r.byte(); r.leb(); return; }
  if (t >= (0x69 as u8) && t <= (0x7F as u8)) { r.byte(); return; }
  r.leb();                                                  // a type index, as an s33
}

void memarg(Reader r) {
  i32 align = r.u32();
  if ((align & 64) != 0) { r.u32(); }                       // a memory index
  r.leb();
}

/** Which canonicalizer a float opcode's result needs: 64, 32, or 0 for none. */
i32 producesNaN(i32 op) {
  if (op >= 0x8D && op <= 0x97) { return 32; }              // f32 ceil floor trunc nearest sqrt add sub mul div min max
  if (op >= 0x9B && op <= 0xA5) { return 64; }              // the same for f64
  if (op == 0xB6) { return 32; }                            // f32.demote_f64
  if (op == 0xBB) { return 64; }                            // f64.promote_f32
  return 0;
}

/**
 * Read one instruction's immediates after its opcode `op`. Unknown opcodes, SIMD and threads included, set `bad`.
 */
void immediates(Reader r, i32 op) {
  if (op == 0x02 || op == 0x03 || op == 0x04 || op == 0x06) { blocktype(r); return; }
  if (op == 0x07 || op == 0x08 || op == 0x09 || op == 0x0C || op == 0x0D || op == 0x18) { r.u32(); return; }
  if (op == 0x0E) {
    i32 n = r.u32();
    for (i32 i = 0; i <= n && !r.bad; i++) { r.u32(); }
    return;
  }
  if (op == 0x10 || op == 0x12 || op == 0x14 || op == 0x15) { r.u32(); return; }
  if (op == 0x11 || op == 0x13) { r.u32(); r.u32(); return; }
  if (op == 0x1C) {
    i32 n = r.u32();
    for (i32 i = 0; i < n && !r.bad; i++) { valtype(r); }
    return;
  }
  if (op == 0x1F) {
    blocktype(r);
    i32 n = r.u32();
    for (i32 i = 0; i < n && !r.bad; i++) {
      u8 k = r.byte();
      if (k == (0 as u8) || k == (1 as u8)) { r.u32(); }
      r.u32();
    }
    return;
  }
  if (op >= 0x20 && op <= 0x26) { r.u32(); return; }
  if (op >= 0x28 && op <= 0x3E) { memarg(r); return; }
  if (op == 0x3F || op == 0x40) { r.u32(); return; }
  if (op == 0x41 || op == 0x42) { r.leb(); return; }
  if (op == 0x43) { r.skip(4); return; }
  if (op == 0x44) { r.skip(8); return; }
  if (op >= 0x45 && op <= 0xC4) { return; }
  if (op == 0x00 || op == 0x01 || op == 0x05 || op == 0x0A || op == 0x0B || op == 0x0F || op == 0x19
      || op == 0x1A || op == 0x1B || op == 0xD1 || op == 0xD3 || op == 0xD4) { return; }
  if (op == 0xD0) { r.leb(); return; }                     // ref.null: a heap type
  if (op == 0xD2 || op == 0xD5 || op == 0xD6) { r.u32(); return; }
  if (op == 0xFB) { gc(r, r.u32()); return; }
  if (op == 0xFC) { misc(r, r.u32()); return; }
  r.bad = true;                                             // 0xFD (SIMD), 0xFE (threads), or unknown
}

void gc(Reader r, i32 sub) {
  if (sub == 0 || sub == 1 || sub == 6 || sub == 7 || (sub >= 11 && sub <= 14) || sub == 16) { r.u32(); return; }
  if (sub == 2 || sub == 3 || sub == 4 || sub == 5 || sub == 8 || sub == 9 || sub == 10 || sub == 17 || sub == 18
      || sub == 19) { r.u32(); r.u32(); return; }
  if (sub == 15 || (sub >= 26 && sub <= 30)) { return; }
  if (sub >= 20 && sub <= 23) { r.leb(); return; }
  if (sub == 24 || sub == 25) { r.byte(); r.u32(); r.leb(); r.leb(); return; }
  r.bad = true;
}

void misc(Reader r, i32 sub) {
  if (sub >= 0 && sub <= 7) { return; }
  if (sub == 8 || sub == 10 || sub == 12 || sub == 14) { r.u32(); r.u32(); return; }
  if (sub == 9 || sub == 11 || sub == 13 || (sub >= 15 && sub <= 17)) { r.u32(); return; }
  r.bad = true;
}

/** The inline check on the `width`-bit float on top of the stack, through scratch local `t`: a NaN becomes canonical. */
void check(Out o, i32 width, i32 t) {
  o.put(0x22 as u8); o.u32(t);                              // local.tee $t
  if (width == 64) { o.all([0x44 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0xF8 as u8, 0x7F as u8]); }
  else { o.all([0x43 as u8, 0 as u8, 0 as u8, 0xC0 as u8, 0x7F as u8]); }     // the canonical NaN
  o.put(0x20 as u8); o.u32(t);                              // local.get $t
  o.put(0x20 as u8); o.u32(t);                              // local.get $t
  o.put(width == 64 ? (0x61 as u8) : (0x5B as u8));         // f64.eq / f32.eq: false only for a NaN
  o.put(0x1B as u8);                                        // select: $t if it equals itself, else the canonical NaN
}

/** WebAssembly's limit on a function's locals, parameters included, as validators enforce it. */
i32 MAX_LOCALS() { return 50000; }

/** What the simulation knows of a value on the stack: made by producer `n` (kind 1), read from local `n` (kind 2), or
 * neither (kind 0), which is anything whose payload is not this function's to hide. */
struct Stack {
  i32[] kind;
  i32[] n;
  i32 len;

  Stack create() { return Stack(i32[].filled(64, 0), i32[].filled(64, 0), 0); }

  void push(this, i32 k, i32 v) {
    if (this.len == this.kind.len()) {
      i32[] k2 = i32[].filled(this.len * 2, 0);
      i32[] n2 = i32[].filled(this.len * 2, 0);
      k2.copyFrom(this.kind, 0, 0, this.len);
      n2.copyFrom(this.n, 0, 0, this.len);
      this.kind = k2;
      this.n = n2;
    }
    this.kind[this.len] = k;
    this.n[this.len] = v;
    this.len++;
  }

  /** The top entry's index, popped; -1 when the simulation has nothing there (it was flushed). */
  i32 pop(this) {
    if (this.len == 0) { return -1; }
    this.len--;
    return this.len;
  }
}

/** Where NaN payloads can be seen, as the simulation of one body finds them. */
struct Seen {
  bool[] need;                                              // by producer: its result must be checked
  bool[] hidden;                                            // by local: every value in it is consumed unseen
  bool[] next;                                              // `hidden` as this pass leaves it

  /** Entry `i` of `s` reaches somewhere its payload shows: a producer is checked, a local is not hidden. */
  void see(this, Stack s, i32 i) {
    if (i < 0) { return; }
    if (s.kind[i] == 1) { this.need[s.n[i]] = true; }
    if (s.kind[i] == 2) { this.next[s.n[i]] = false; }
  }

  void flush(this, Stack s) {
    for (i32 i = 0; i < s.len; i++) { this.see(s, i); }
    s.len = 0;
  }
}

bool isProducer(i32 op) { return producesNaN(op) != 0; }

/** Binary producers: add sub mul div min max, both widths. The rest of `producesNaN` are unary. */
bool binaryProducer(i32 op) { return (op >= 0x92 && op <= 0x97) || (op >= 0xA0 && op <= 0xA5); }

/**
 * One pass of the simulation over a body's instructions from `from`. A value is *consumed unseen* by an instruction
 * whose result is the same whatever its payload: a float operation that produces a NaN (and is itself checked, or
 * passes the duty on), a comparison, a conversion to an integer, `drop`; or by `local.set`/`local.tee` into a hidden
 * local. `neg` and `abs` carry the value's payload through; `copysign` shows its second operand's sign. Everything this
 * does not model (calls, branches, blocks, `select`, references…) sees whatever is on the stack, which is the safe
 * direction: a value it cannot follow is checked where it was made.
 */
void simulate(u8[] b, i32 from, Seen seen) {
  Reader r = Reader(b, from, false);
  Stack s = Stack.create();
  i32 producer = 0;
  while (r.at < b.len()) {
    i32 start = r.at;
    i32 op = r.byte() as i32;
    i32 sub = op == 0xFB || op == 0xFC ? Reader(b, r.at, false).u32() : -1;
    immediates(r, op);
    i32 local = op >= 0x20 && op <= 0x22 ? Reader(b, start + 1, false).u32() : -1;
    if (op == 0x20) { s.push(2, local); }
    else if (op == 0x21) { i32 e = s.pop(); if (!seen.hidden[local]) { seen.see(s, e); } }
    else if (op == 0x22) {
      i32 e = s.pop();
      if (seen.hidden[local] && e >= 0) { s.push(s.kind[e], s.n[e]); } else { seen.see(s, e); s.push(0, 0); }
    }
    else if (op == 0x01) { }
    else if (op == 0x1A) { s.pop(); }
    else if (op == 0x23 || (op >= 0x41 && op <= 0x44) || op == 0x3F) { s.push(0, 0); }
    else if (op == 0x24) { seen.see(s, s.pop()); }
    else if (isProducer(op)) {
      s.pop();
      if (binaryProducer(op)) { s.pop(); }
      s.push(1, producer);
    }
    else if (op == 0x8B || op == 0x8C || op == 0x99 || op == 0x9A) {          // neg, abs: the same payload
      i32 e = s.pop();
      if (e >= 0) { s.push(s.kind[e], s.n[e]); } else { s.push(0, 0); }
    }
    else if (op == 0x98 || op == 0xA6) {                                       // copysign(a, b): b's sign shows
      seen.see(s, s.pop());
      i32 e = s.pop();
      if (e >= 0) { s.push(s.kind[e], s.n[e]); } else { s.push(0, 0); }
    }
    else if ((op >= 0x46 && op <= 0x4F) || (op >= 0x51 && op <= 0x66) || (op >= 0x6A && op <= 0x78) || (op >= 0x7C && op <= 0x8A)) {
      s.pop(); s.pop(); s.push(0, 0);                                          // comparisons, integer arithmetic
    }
    else if (op == 0x45 || op == 0x50 || (op >= 0x67 && op <= 0x69) || (op >= 0x79 && op <= 0x7B)
             || (op >= 0xA7 && op <= 0xB5) || (op >= 0xB7 && op <= 0xBA) || op == 0xBE || op == 0xBF
             || (op >= 0xC0 && op <= 0xC4) || (op >= 0x28 && op <= 0x35) || op == 0x40) {
      s.pop(); s.push(0, 0);                                                   // unary: tests, conversions, loads
    }
    else if (op == 0xBC || op == 0xBD) { seen.see(s, s.pop()); s.push(0, 0); } // reinterpret: the bits themselves
    else if (op >= 0x36 && op <= 0x3E) { seen.see(s, s.pop()); s.pop(); }     // stores
    else if (op == 0xFB && sub >= 2 && sub <= 4) { s.pop(); s.push(0, 0); }   // struct.get
    else if (op == 0xFB && sub == 5) { seen.see(s, s.pop()); s.pop(); }       // struct.set
    else if (op == 0xFB && sub >= 11 && sub <= 13) { s.pop(); s.pop(); s.push(0, 0); }  // array.get
    else if (op == 0xFB && sub == 14) { seen.see(s, s.pop()); s.pop(); s.pop(); }       // array.set
    else if (op == 0xFB && sub == 15) { s.pop(); s.push(0, 0); }              // array.len
    else if (op == 0xFC && sub >= 0 && sub <= 7) { s.pop(); s.push(0, 0); }   // trunc_sat
    else { seen.flush(s); }
    if (isProducer(op)) { producer++; }
  }
  seen.flush(s);
}

/**
 * One function body, `params` its parameter count: locals, then instructions, each NaN-producing float operation whose
 * NaN could be seen followed by the inline check. A body with none comes back unchanged.
 */
Result<u8[], string> body(u8[] b, i32 params, Out scan) {
  Reader r = Reader(b, 0, false);
  i32 groups = r.u32();
  i32 declStart = r.at;
  i64 locals = params as i64;
  for (i32 i = 0; i < groups && !r.bad; i++) { locals += r.u32() as i64; valtype(r); }
  if (r.bad) { return Result.Err("a function's locals do not decode"); }
  i32 declEnd = r.at;
  if (locals + (2 as i64) > (MAX_LOCALS() as i64)) { return Result.Err("a function with \{locals} locals has no room for the two scratch locals"); }
  i32 t64 = locals as@ i32;
  i32 t32 = t64 + 1;
  // Decode once: the scan the oracle compares, how many producers there are, and that every local index is in range.
  i32 ops = 0;
  i32 producers = 0;
  string hits = "";
  while (r.at < b.len()) {
    i32 start = r.at;
    i32 op = r.byte() as i32;
    immediates(r, op);
    if (r.bad) { return Result.Err("an instruction this rewrite does not know, opcode 0x\{hexByte(op)} at \{start}"); }
    if (op >= 0x20 && op <= 0x22 && Reader(b, start + 1, false).u32() >= t64) { return Result.Err("local out of range at \{start}"); }
    ops++;
    if (isProducer(op)) { producers++; hits += (hits == "" ? "" : ",") + "\{start}"; }
  }
  scan.all("\{ops} \{hits}\n".toBytes());
  if (producers == 0) { return Result.Ok(b); }
  // Which locals hide their values, to a fixed point (it only ever shrinks), then which producers need their check.
  Seen seen = Seen(bool[].filled(producers, false), bool[].filled(t64, true), bool[].filled(t64, true));
  while (true) {
    seen.need = bool[].filled(producers, false);
    seen.next = bool[].filled(t64, true);
    for (i32 i = 0; i < t64; i++) { seen.next[i] = seen.hidden[i]; }
    simulate(b, declEnd, seen);
    bool same = true;
    for (i32 i = 0; i < t64; i++) { if (seen.next[i] != seen.hidden[i]) { same = false; } }
    if (same) { break; }
    seen.hidden = seen.next;
  }
  bool any = false;
  for (i32 i = 0; i < producers; i++) { if (seen.need[i]) { any = true; } }
  if (!any) { return Result.Ok(b); }
  Out o = Out.create();
  r = Reader(b, declEnd, false);
  i32 producer = 0;
  while (r.at < b.len()) {
    i32 start = r.at;
    i32 op = r.byte() as i32;
    immediates(r, op);
    o.range(b, start, r.at);
    i32 which = producesNaN(op);
    if (which != 0) {
      if (seen.need[producer]) { check(o, which, which == 64 ? t64 : t32); }
      producer++;
    }
  }
  Out f = Out.create();
  f.u32(groups + 2);
  f.range(b, declStart, declEnd);
  f.all([0x01 as u8, 0x7C as u8, 0x01 as u8, 0x7D as u8]);              // one f64, one f32
  f.all(o.take());
  return Result.Ok(f.take());
}

string hexByte(i32 v) {
  string d = "0123456789abcdef";
  return d.slice((v >> 4) & 15, ((v >> 4) & 15) + 1) + d.slice(v & 15, (v & 15) + 1);
}

/** The result of `canonicalize`: the module, and per function "operators offsets…" lines for the oracle to compare. */
export struct Canon {
  u8[] module;
  string scan;
}

/** `wasm` with every NaN an operation produces made canonical, or why it cannot be. */
export Result<Canon, string> canonicalize(u8[] wasm) {
  if (wasm.len() < 8 || wasm[0] != 0 || wasm[1] != 0x61 || wasm[2] != 0x73 || wasm[3] != 0x6D) {
    return Result.Err("not a WebAssembly module");
  }
  // First pass: each defined function's parameter count, from its type.
  i32[] params = i32[]();
  i32[] funcTypes = i32[]();
  Reader r = Reader(wasm, 8, false);
  while (r.at < wasm.len() && !r.bad) {
    i32 id = r.byte() as i32;
    i32 size = r.u32();
    i32 from = r.at;
    r.skip(size);
    if (r.bad) { break; }
    u8[] sec = u8[].filled(size, 0);
    sec.copyFrom(wasm, from, 0, size);
    if (id == 1) {
      i32[]? ps = typeParams(sec);
      if (ps is null) { return Result.Err("the module's types do not decode"); }
      params = ps!;
    }
    if (id == 3) {
      Reader f = Reader(sec, 0, false);
      i32 n = f.u32();
      for (i32 i = 0; i < n && !f.bad; i++) { funcTypes = push(funcTypes, f.u32()); }
      if (f.bad) { return Result.Err("the module's function section does not decode"); }
    }
  }
  if (r.bad) { return Result.Err("the module's sections do not decode"); }

  Out o = Out.create();
  o.range(wasm, 0, 8);
  Out scan = Out.create();
  r = Reader(wasm, 8, false);
  while (r.at < wasm.len()) {
    i32 header = r.at;
    i32 id = r.byte() as i32;
    i32 size = r.u32();
    i32 from = r.at;
    r.skip(size);
    if (id != 10) {
      o.range(wasm, header, from + size);                   // as it was, header and all
      continue;
    }
    Reader s = Reader(wasm, from, false);
    Out sec = Out.create();
    i32 n = s.u32();
    if (n != funcTypes.len()) { return Result.Err("\{n} bodies for \{funcTypes.len()} functions"); }
    sec.u32(n);
    for (i32 f = 0; f < n; f++) {
      i32 len = s.u32();
      if (s.at + len > wasm.len()) { return Result.Err("a function body runs past the module"); }
      u8[] b = u8[].filled(len, 0);
      b.copyFrom(wasm, s.at, 0, len);
      s.skip(len);
      i32 t = funcTypes[f];
      if (t < 0 || t >= params.len() || params[t] < 0) { return Result.Err("function \{f} has type \{t}, which is not a function type"); }
      u8[] nb = try body(b, params[t], scan);
      sec.u32(nb.len());
      sec.all(nb);
    }
    u8[] bytes = sec.take();
    o.put(10 as u8);
    o.u32(bytes.len());
    o.all(bytes);
  }
  return Result.Ok(Canon(o.take(), string.fromBytes(scan.take())));
}
