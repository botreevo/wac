// NaN canonicalization, by rewriting the module: WebAssembly 3.0's deterministic profile, imposed on any engine.
//
// The WebAssembly spec lets an operation whose result is NaN choose that NaN's sign and payload, and engines do choose
// differently: V8 and wasmtime disagree on `max(1, NaN with a payload)`, and x86 gives `0/0` a sign bit that ARM does
// not (docs/runner.md). A program sees the difference through `toBits`, so a deterministic machine must take the
// choice away. The deterministic profile does that by making every NaN an operation *produces* the canonical positive
// NaN, while the operations that only move bits (`neg`, `abs`, `copysign`, the reinterprets, loads and stores) keep
// them exactly.
//
// So the rewrite is this: after every float operation that may produce a NaN (arithmetic, `min`/`max`, `sqrt`, the
// four roundings, `promote` and `demote`), call a function that replaces a NaN with the canonical one. The two
// functions are appended to the module, with their two types appended to the type section, so no existing index
// moves; nothing else in the module changes.
//
// The decoder reads every instruction a wac-built module contains (the core set, reference types, GC, tail calls,
// exceptions, the 0xFC group). It refuses what it does not know, SIMD included, rather than guess at its length, so
// a module it cannot rewrite is refused, not run unprofiled. `tools/wasmscan` (wasmparser, as wasmtime uses) is the
// oracle: it must find the same operators at the same offsets, and the rewritten module must validate.

import { Result } from "core";

struct Reader {
  u8[] b;
  i32 at;
  bool bad;

  u8 byte(this) {
    if (this.at >= this.b.len()) { this.bad = true; return 0 as u8; }
    u8 v = this.b[this.at];
    this.at++;
    return v;
  }

  /** An unsigned LEB128 (u32 here; a larger one is refused). */
  i32 u32(this) {
    i32 v = 0;
    i32 shift = 0;
    while (true) {
      u8 x = this.byte();
      if (this.bad) { return 0; }
      if (shift < 32) { v = v | (((x as i32) & 127) << shift); }
      if ((x & (128 as u8)) == 0) { break; }
      shift += 7;
      if (shift > 35) { this.bad = true; return 0; }
    }
    return v;
  }

  /** Any LEB128, signed or not, up to 64 bits: skipped, its length all that matters. */
  void leb(this) {
    for (i32 i = 0; i < 10; i++) {
      u8 x = this.byte();
      if (this.bad || (x & (128 as u8)) == 0) { return; }
    }
    this.bad = true;
  }

  void skip(this, i32 n) {
    if (this.at + n > this.b.len()) { this.bad = true; return; }
    this.at += n;
  }
}

/** A growing byte buffer. */
struct Out {
  u8[] b;
  i32 n;

  Out create() { return Out(u8[].filled(256, 0), 0); }

  void put(this, u8 x) {
    if (this.n == this.b.len()) {
      u8[] g = u8[].filled(this.b.len() * 2, 0);
      g.copyFrom(this.b, 0, 0, this.n);
      this.b = g;
    }
    this.b[this.n] = x;
    this.n++;
  }

  void all(this, u8[] xs) { for (i32 i = 0; i < xs.len(); i++) { this.put(xs[i]); } }

  void range(this, u8[] src, i32 from, i32 to) { for (i32 i = from; i < to; i++) { this.put(src[i]); } }

  void u32(this, i32 v) {
    i32 x = v;
    while (true) {
      i32 low = x & 127;
      x = (x >> 7) & 33554431;
      if (x == 0) { this.put(low as@ u8); return; }
      this.put((low | 128) as@ u8);
    }
  }

  u8[] take(this) {
    u8[] r = u8[].filled(this.n, 0);
    r.copyFrom(this.b, 0, 0, this.n);
    return r;
  }
}

// ── Types and imports: only far enough to count ──────────────────────────────────────────────────────────

/** A value type: one byte, or a reference type with a heap type after it. */
void valtype(Reader r) {
  u8 t = r.byte();
  if (t == (0x63 as u8) || t == (0x64 as u8)) { r.leb(); }
}

void storagetype(Reader r) { valtype(r); }                 // the packed types are single bytes as well

void comptype(Reader r) {
  u8 k = r.byte();
  if (k == (0x60 as u8)) {                                  // func
    i32 np = r.u32();
    for (i32 i = 0; i < np && !r.bad; i++) { valtype(r); }
    i32 nr = r.u32();
    for (i32 i = 0; i < nr && !r.bad; i++) { valtype(r); }
  } else if (k == (0x5F as u8)) {                           // struct
    i32 nf = r.u32();
    for (i32 i = 0; i < nf && !r.bad; i++) { storagetype(r); r.byte(); }
  } else if (k == (0x5E as u8)) {                           // array
    storagetype(r);
    r.byte();
  } else {
    r.bad = true;
  }
}

void subtype(Reader r) {
  u8 k = r.b[r.at];
  if (k == (0x50 as u8) || k == (0x4F as u8)) {
    r.byte();
    i32 n = r.u32();
    for (i32 i = 0; i < n && !r.bad; i++) { r.u32(); }
  }
  comptype(r);
}

/** How many types a type section defines: a recursion group defines one per member. */
i32 typeCount(u8[] sec) {
  Reader r = Reader(sec, 0, false);
  i32 groups = r.u32();
  i32 total = 0;
  for (i32 g = 0; g < groups && !r.bad; g++) {
    if (r.b[r.at] == (0x4E as u8)) {
      r.byte();
      i32 n = r.u32();
      for (i32 i = 0; i < n && !r.bad; i++) { subtype(r); }
      total += n;
    } else {
      subtype(r);
      total++;
    }
  }
  return r.bad ? -1 : total;
}

void limits(Reader r) {
  u8 flag = r.byte();
  r.leb();
  if ((flag & (1 as u8)) != 0) { r.leb(); }
}

/** How many functions the imports bring in. */
i32 importedFunctions(u8[] sec) {
  Reader r = Reader(sec, 0, false);
  i32 n = r.u32();
  i32 funcs = 0;
  for (i32 i = 0; i < n && !r.bad; i++) {
    r.skip(r.u32());
    r.skip(r.u32());
    u8 kind = r.byte();
    if (kind == (0 as u8)) { r.u32(); funcs++; }
    else if (kind == (1 as u8)) { valtype(r); limits(r); }
    else if (kind == (2 as u8)) { limits(r); }
    else if (kind == (3 as u8)) { valtype(r); r.byte(); }
    else if (kind == (4 as u8)) { r.byte(); r.u32(); }
    else { r.bad = true; }
  }
  return r.bad ? -1 : funcs;
}

// ── Instructions ─────────────────────────────────────────────────────────────────────────────────────────

void blocktype(Reader r) {
  u8 t = r.b[r.at];
  if (t == (0x40 as u8)) { r.byte(); return; }
  if (t == (0x63 as u8) || t == (0x64 as u8)) { r.byte(); r.leb(); return; }
  if (t >= (0x69 as u8) && t <= (0x7F as u8)) { r.byte(); return; }
  r.leb();                                                  // a type index, as an s33
}

void memarg(Reader r) {
  i32 align = r.u32();
  if ((align & 64) != 0) { r.u32(); }                       // a memory index
  r.leb();
}

/** Which canonicalizer a float opcode's result needs: 64, 32, or 0 for none. */
i32 producesNaN(i32 op) {
  if (op >= 0x8D && op <= 0x97) { return 32; }              // f32 ceil floor trunc nearest sqrt add sub mul div min max
  if (op >= 0x9B && op <= 0xA5) { return 64; }              // the same for f64
  if (op == 0xB6) { return 32; }                            // f32.demote_f64
  if (op == 0xBB) { return 64; }                            // f64.promote_f32
  return 0;
}

/**
 * Read one instruction's immediates after its opcode `op`. Unknown opcodes, SIMD and threads included, set `bad`.
 */
void immediates(Reader r, i32 op) {
  if (op == 0x02 || op == 0x03 || op == 0x04 || op == 0x06) { blocktype(r); return; }
  if (op == 0x07 || op == 0x08 || op == 0x09 || op == 0x0C || op == 0x0D || op == 0x18) { r.u32(); return; }
  if (op == 0x0E) {
    i32 n = r.u32();
    for (i32 i = 0; i <= n && !r.bad; i++) { r.u32(); }
    return;
  }
  if (op == 0x10 || op == 0x12 || op == 0x14 || op == 0x15) { r.u32(); return; }
  if (op == 0x11 || op == 0x13) { r.u32(); r.u32(); return; }
  if (op == 0x1C) {
    i32 n = r.u32();
    for (i32 i = 0; i < n && !r.bad; i++) { valtype(r); }
    return;
  }
  if (op == 0x1F) {
    blocktype(r);
    i32 n = r.u32();
    for (i32 i = 0; i < n && !r.bad; i++) {
      u8 k = r.byte();
      if (k == (0 as u8) || k == (1 as u8)) { r.u32(); }
      r.u32();
    }
    return;
  }
  if (op >= 0x20 && op <= 0x26) { r.u32(); return; }
  if (op >= 0x28 && op <= 0x3E) { memarg(r); return; }
  if (op == 0x3F || op == 0x40) { r.u32(); return; }
  if (op == 0x41 || op == 0x42) { r.leb(); return; }
  if (op == 0x43) { r.skip(4); return; }
  if (op == 0x44) { r.skip(8); return; }
  if (op >= 0x45 && op <= 0xC4) { return; }
  if (op == 0x00 || op == 0x01 || op == 0x05 || op == 0x0A || op == 0x0B || op == 0x0F || op == 0x19
      || op == 0x1A || op == 0x1B || op == 0xD1 || op == 0xD3 || op == 0xD4) { return; }
  if (op == 0xD0) { r.leb(); return; }                     // ref.null: a heap type
  if (op == 0xD2 || op == 0xD5 || op == 0xD6) { r.u32(); return; }
  if (op == 0xFB) { gc(r, r.u32()); return; }
  if (op == 0xFC) { misc(r, r.u32()); return; }
  r.bad = true;                                             // 0xFD (SIMD), 0xFE (threads), or unknown
}

void gc(Reader r, i32 sub) {
  if (sub == 0 || sub == 1 || sub == 6 || sub == 7 || (sub >= 11 && sub <= 14) || sub == 16) { r.u32(); return; }
  if (sub == 2 || sub == 3 || sub == 4 || sub == 5 || sub == 8 || sub == 9 || sub == 10 || sub == 17 || sub == 18
      || sub == 19) { r.u32(); r.u32(); return; }
  if (sub == 15 || (sub >= 26 && sub <= 30)) { return; }
  if (sub >= 20 && sub <= 23) { r.leb(); return; }
  if (sub == 24 || sub == 25) { r.byte(); r.u32(); r.leb(); r.leb(); return; }
  r.bad = true;
}

void misc(Reader r, i32 sub) {
  if (sub >= 0 && sub <= 7) { return; }
  if (sub == 8 || sub == 10 || sub == 12 || sub == 14) { r.u32(); r.u32(); return; }
  if (sub == 9 || sub == 11 || sub == 13 || (sub >= 15 && sub <= 17)) { r.u32(); return; }
  r.bad = true;
}

/** One function body: locals, then instructions; each NaN-producing float operation followed by a call. */
Result<u8[], string> body(u8[] b, i32 canon64, i32 canon32, Out scan) {
  Reader r = Reader(b, 0, false);
  i32 groups = r.u32();
  for (i32 i = 0; i < groups && !r.bad; i++) { r.u32(); valtype(r); }
  if (r.bad) { return Result.Err("a function's locals do not decode"); }
  Out o = Out.create();
  o.range(b, 0, r.at);
  i32 ops = 0;
  string hits = "";
  while (r.at < b.len()) {
    i32 start = r.at;
    i32 op = r.byte() as i32;
    immediates(r, op);
    if (r.bad) { return Result.Err("an instruction this rewrite does not know, opcode 0x\{hexByte(op)} at \{start}"); }
    o.range(b, start, r.at);
    ops++;
    i32 which = producesNaN(op);
    if (which != 0) {
      hits += (hits == "" ? "" : ",") + "\{start}";
      o.put(0x10 as u8);
      o.u32(which == 64 ? canon64 : canon32);
    }
  }
  scan.all("\{ops} \{hits}\n".toBytes());
  return Result.Ok(o.take());
}

string hexByte(i32 v) {
  string d = "0123456789abcdef";
  return d.slice((v >> 4) & 15, ((v >> 4) & 15) + 1) + d.slice(v & 15, (v & 15) + 1);
}

/** The two canonicalizers: `x != x ? canonical : x`. */
u8[] canonBody64() {
  return [0x00 as u8, 0x20 as u8, 0x00 as u8, 0x20 as u8, 0x00 as u8, 0x62 as u8, 0x04 as u8, 0x7C as u8, 0x44 as u8,
          0x00 as u8, 0x00 as u8, 0x00 as u8, 0x00 as u8, 0x00 as u8, 0x00 as u8, 0xF8 as u8, 0x7F as u8,
          0x05 as u8, 0x20 as u8, 0x00 as u8, 0x0B as u8, 0x0B as u8];
}

u8[] canonBody32() {
  return [0x00 as u8, 0x20 as u8, 0x00 as u8, 0x20 as u8, 0x00 as u8, 0x5C as u8, 0x04 as u8, 0x7D as u8, 0x43 as u8,
          0x00 as u8, 0x00 as u8, 0xC0 as u8, 0x7F as u8, 0x05 as u8, 0x20 as u8, 0x00 as u8, 0x0B as u8, 0x0B as u8];
}

/** The result of `canonicalize`: the module, and per function "operators offsets…" lines for the oracle to compare. */
export struct Canon {
  u8[] module;
  string scan;
}

/** `wasm` with every NaN an operation produces made canonical, or why it cannot be. */
export Result<Canon, string> canonicalize(u8[] wasm) {
  if (wasm.len() < 8 || wasm[0] != 0 || wasm[1] != 0x61 || wasm[2] != 0x73 || wasm[3] != 0x6D) {
    return Result.Err("not a WebAssembly module");
  }
  // First pass: the counts the new indices depend on.
  i32 types = 0;
  i32 imported = 0;
  i32 defined = 0;
  Reader r = Reader(wasm, 8, false);
  while (r.at < wasm.len() && !r.bad) {
    i32 id = r.byte() as i32;
    i32 size = r.u32();
    i32 from = r.at;
    r.skip(size);
    if (r.bad) { break; }
    u8[] sec = u8[].filled(size, 0);
    sec.copyFrom(wasm, from, 0, size);
    if (id == 1) { types = typeCount(sec); }
    if (id == 2) { imported = importedFunctions(sec); }
    if (id == 3) { defined = Reader(sec, 0, false).u32(); }
  }
  if (r.bad || types < 0 || imported < 0) { return Result.Err("the module's sections do not decode"); }
  i32 canon64 = imported + defined;
  i32 canon32 = canon64 + 1;

  Out o = Out.create();
  o.range(wasm, 0, 8);
  Out scan = Out.create();
  r = Reader(wasm, 8, false);
  while (r.at < wasm.len()) {
    i32 id = r.byte() as i32;
    i32 size = r.u32();
    i32 from = r.at;
    r.skip(size);
    Reader s = Reader(wasm, from, false);
    Out sec = Out.create();
    if (id == 1) {
      i32 n = s.u32();
      sec.u32(n + 2);
      sec.range(wasm, s.at, from + size);
      sec.all([0x60 as u8, 0x01 as u8, 0x7C as u8, 0x01 as u8, 0x7C as u8, 0x60 as u8, 0x01 as u8, 0x7D as u8, 0x01 as u8, 0x7D as u8]);
    } else if (id == 3) {
      i32 n = s.u32();
      sec.u32(n + 2);
      sec.range(wasm, s.at, from + size);
      sec.u32(types);
      sec.u32(types + 1);
    } else if (id == 10) {
      i32 n = s.u32();
      sec.u32(n + 2);
      for (i32 f = 0; f < n; f++) {
        i32 len = s.u32();
        u8[] b = u8[].filled(len, 0);
        if (s.at + len > wasm.len()) { return Result.Err("a function body runs past the module"); }
        b.copyFrom(wasm, s.at, 0, len);
        s.skip(len);
        u8[] nb = try body(b, canon64, canon32, scan);
        sec.u32(nb.len());
        sec.all(nb);
      }
      u8[] c64 = canonBody64();
      u8[] c32 = canonBody32();
      sec.u32(c64.len());
      sec.all(c64);
      sec.u32(c32.len());
      sec.all(c32);
    } else {
      sec.range(wasm, from, from + size);
    }
    u8[] bytes = sec.take();
    o.put(id as@ u8);
    o.u32(bytes.len());
    o.all(bytes);
  }
  if (types == 0) { return Result.Err("a module with no type section cannot take the canonicalizers"); }
  return Result.Ok(Canon(o.take(), string.fromBytes(scan.take())));
}
