// Hex text and bytes, as the command line, policies and JSON-RPC write them.

import { codec.hexEncode, codec.hexDecode } from "wac";

/** Bytes as lowercase hex, without a `0x`. */
export string hex(u8[] b) { return string.fromBytes(hexEncode(b)); }

/** `0x`-prefixed (or bare) hex to bytes, or null. */
export u8[]? unhex(string s) {
  string body = s.len() >= 2 && s.slice(0, 2) == "0x" ? s.slice(2, s.len()) : s;
  return hexDecode(body.toBytes());
}
