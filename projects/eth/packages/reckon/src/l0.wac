// The wac-L0 machine, version 1: what a recipe naming `wac-l0/1` means, apart from any runner (docs/l0-machine.md).
//
// The rule is a written format: wac's bootstrap/spec/l0.md at the commit the doc names, "wasm as text, implementable
// in an afternoon, twice". The machine assembles one L0 text into one wasm module, or refuses it. There is no program
// in the input: the machine *is* the assembler, which is what makes it the root of the bootstrap ladder rather than
// a step on it.
//
//     input tree    source        the L0 text, UTF-8
//     output tree   status        "ok" or "refused"
//                   out/module.wasm   the module, only when ok
//
// A refusal's message is not part of the output. The two implementations word their errors differently and agree
// only that the text is not L0, so that is all the output says. Anything else (the assembler would not start, crashed,
// or wrote nothing) is the runner's failure, not the machine's answer: no output and no claim.

import { ipfs.FileIn } from "@/lib.wac";

export string L0_MACHINE() { return "wac-l0/1"; }

/** The output tree for an assembled module. */
export FileIn[] assembled(u8[] module) { return [FileIn("status", "ok".toBytes()), FileIn("out/module.wasm", module)]; }

/** The output tree for a text the format refuses. */
export FileIn[] refused() { return [FileIn("status", "refused".toBytes())]; }

/** The output's directories: `out` when there is a module, none for a refusal. */
export string[] dirsOf(bool ok) { return ok ? ["out"] : string[](); }
