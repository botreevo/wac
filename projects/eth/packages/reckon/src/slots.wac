// A recipe's input tree, as named slots: its top-level entries. The machine defines what the names mean; the policy
// says which role each must be admitted in.

import { ipfs.Cid, ipfs.Resolver, ipfs.Node, ipfs.readNode, ipfs.Link, ipfs.entriesOf } from "@/lib.wac";
import { Result } from "core";

export struct Slot {
  string name;
  Cid cid;
}

export Result<Slot[], string> slotsOf(Resolver r, Cid inputTree) {
  u8[] b = try r.block(inputTree);
  Node n = try readNode(inputTree, b);
  bool file = match (n) { File(_, _, _): true, Dir(_): false, Shard(_, _): false };
  if (file) { return Result.Err("a recipe's input must be a directory tree"); }
  // A plain directory or a HAMT: either way, its entries by name.
  Link[] entries = try entriesOf(r, inputTree);
  Slot[] out = Slot[].filled(entries.len(), Slot("", inputTree));
  for (i32 i = 0; i < entries.len(); i++) { out[i] = Slot(entries[i].name, entries[i].cid); }
  return Result.Ok(out);
}
