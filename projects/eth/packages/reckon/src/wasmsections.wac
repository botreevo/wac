// A wasm module's sections, as far as reckon needs them: leaving out the `wac.manifest` custom section, which
// `wac build` writes last and wac's browser builds leave out (cmd/assemble.wac, cmd/embed.wac).

import { Result } from "core";

/** The module with its `wac.manifest` custom section left out; every other byte as it was. */
export Result<u8[], string> withoutManifest(u8[] b) {
  if (b.len() < 8 || b[0] != (0 as u8) || b[1] != (0x61 as u8) || b[2] != (0x73 as u8) || b[3] != (0x6d as u8)) {
    return Result.Err("not a wasm module");
  }
  u8[] out = u8[].filled(b.len(), 0);
  out.copyFrom(b, 0, 0, 8);
  i32 n = 8;
  i32 i = 8;
  while (i < b.len()) {
    i32 start = i;
    i32 id = b[i] as i32;
    i++;
    i32 size = 0;
    i32 shift = 0;
    while (true) {
      if (i >= b.len()) { return Result.Err("a section's size runs past the end"); }
      i32 x = b[i] as i32;
      i++;
      size = size | ((x & 127) << shift);
      shift += 7;
      if (x < 128) { break; }
    }
    i32 body = i;
    i = i + size;
    if (i > b.len()) { return Result.Err("a section runs past the end"); }
    bool manifest = false;
    if (id == 0) {
      i32 len = 0;
      i32 sh = 0;
      i32 j = body;
      while (true) {
        i32 x = b[j] as i32;
        j++;
        len = len | ((x & 127) << sh);
        sh += 7;
        if (x < 128) { break; }
      }
      manifest = len == 12 && string.fromBytes(cut(b, j, j + len)) == "wac.manifest";
    }
    if (!manifest) { out.copyFrom(b, start, n, i - start); n = n + (i - start); }
  }
  return Result.Ok(cut(out, 0, n));
}

u8[] cut(u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  out.copyFrom(b, from, 0, to - from);
  return out;
}

