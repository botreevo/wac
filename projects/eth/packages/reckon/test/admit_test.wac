// Admission over a derivation graph shaped like the motivating cases: a hand-written seed derives a compiler from its
// endorsed source, the compiler builds an app from the app's source, and an analyser run over that source can stand in
// for a human endorsement. Each refusal is checked for its reason, so a refusal for the wrong reason does not pass.

import { codec.hexDecoded } from "wac";
import { ipfs.Cid, ipfs.Store, ipfs.Resolver, ipfs.Built, ipfs.buildFile, ipfs.buildTree, ipfs.FileIn, ipfs.Entry, ipfs.buildDir,
         ipfs.PROFILE } from "@/lib.wac";
import { Recipe, Statement, statementId, signStatement, addressOfKey } from "../src/claims.wac";
import { Index, Held, saveIndex, loadIndex, Loaded } from "../src/graph.wac";
import { Policy, Rule, RoleRules, SlotRole, Named, Chain, Decision, Conformance, admit } from "../src/admit.wac";
import { Check } from "./check.wac";

string rep(string two) { string out = ""; for (i32 i = 0; i < 32; i++) { out += two; } return out; }
u8[] signingKey(string two) { return hexDecoded(rep(two)); }
string W1() { return "21"; }
string W2() { return "22"; }
string W3() { return "23"; }
string ENDORSER_ALICE() { return "41"; }
string LIST() { return "51"; }
string MACHINE() { return "wasm-gc/det/1"; }
string FORMAT() { return "unixfs-v1-2025+hidden"; }

/** The world: objects in a store, and the CIDs the tests talk about. */
struct World {
  Store s;
  Cid seed;
  Cid csrc;
  Cid compiler;
  Cid asrc;
  Cid app;
  Cid analyser;
  Recipe r1;
  Recipe r2;
  Recipe r3;
  Cid report;
  Cid passing;
  Cid failing;
}

Cid keep(Store s, Built b) { s.putAll(b.blocks); return b.root; }
Cid file(Store s, string text) { return keep(s, buildFile(text.toBytes(), PROFILE())); }
Cid tree(Store s, string name, string text) { return keep(s, buildTree([FileIn(name, text.toBytes())], string[](), PROFILE()).ok()!); }

/** An input tree with the given slots. */
Cid input(Store s, string[] names, Cid[] cids) {
  Entry[] es = Entry[].filled(names.len(), Entry("", buildFile(u8[](), PROFILE())));
  for (i32 i = 0; i < names.len(); i++) {
    // A slot entry needs the child's Tsize; rebuilding it from the store would be the honest way, and for these small
    // objects a placeholder Built carrying the CID is enough, since admission reads only names and CIDs.
    es[i] = Entry(names[i], Built(cids[i], [], 0 as i64, 0 as i64));
  }
  return keep(s, buildDir(es, PROFILE()).ok()!);
}

World world() {
  Store s = Store.memory();
  Cid seed = file(s, "hand-written seed");
  Cid csrc = tree(s, "compiler.wac", "the compiler's source");
  Cid compiler = file(s, "compiler binary");
  Cid asrc = tree(s, "app.wac", "the app's source");
  Cid app = file(s, "app binary");
  Cid analyser = file(s, "constant-time checker");
  Recipe r1 = Recipe(MACHINE(), FORMAT(), input(s, ["program", "src"], [seed, csrc]));
  Recipe r2 = Recipe(MACHINE(), FORMAT(), input(s, ["program", "src"], [compiler, asrc]));
  Recipe r3 = Recipe(MACHINE(), FORMAT(), input(s, ["program", "subject"], [analyser, asrc]));
  Cid passing = tree(s, "verdict", "pass");
  Cid failing = tree(s, "verdict", "fail");
  return World(s, seed, csrc, compiler, asrc, app, analyser, r1, r2, r3, passing, passing, failing);
}

Statement derivation(Index ix, Recipe r, Cid out, string runner) { return Statement.Derivation(ix.addRecipe(r), out, runner); }
void claim(Index ix, Statement st, string who) { ix.add(signStatement(st, signingKey(who))); }

/** The ordinary state of things: everything witnessed and endorsed. */
Index full(World w) {
  Index ix = Index.create();
  claim(ix, derivation(ix, w.r1, w.compiler, "wac on V8"), W1());
  claim(ix, derivation(ix, w.r1, w.compiler, "wac on wasmtime"), W2());
  claim(ix, derivation(ix, w.r1, w.compiler, "wac on V8"), W3());
  claim(ix, derivation(ix, w.r2, w.app, "wac on V8"), W1());
  claim(ix, derivation(ix, w.r2, w.app, "wac on wasmtime"), W2());
  claim(ix, Statement.Endorsement(w.csrc, "read all of it"), ENDORSER_ALICE());
  claim(ix, Statement.Endorsement(w.asrc, "read all of it"), ENDORSER_ALICE());
  return ix;
}

Named n(string name, string two) { return Named(name, addressOfKey(signingKey(two))); }

Policy policy(World w) {
  string[] ws = ["w1", "w2", "w3"];
  return Policy([n("w1", W1()), n("w2", W2()), n("w3", W3()), n("alice", ENDORSER_ALICE())], [w.seed], [MACHINE()], [FORMAT()], [addressOfKey(signingKey(LIST()))], [
    RoleRules("app", [Rule.Derived(ws, 2, 2, [SlotRole("program", "compiler"), SlotRole("src", "source")], "")]),
    RoleRules("compiler", [Rule.Root, Rule.Derived(ws, 3, 1, [SlotRole("program", "bootstrap"), SlotRole("src", "source")], "")]),
    RoleRules("bootstrap", [Rule.Root]),
    RoleRules("source", [Rule.Endorsed(["alice"], 1), Rule.Analysis(w.analyser, "subject", "verdict", "pass", ["w1"], 1)]),
  ], Conformance[]());
}

Decision app(World w, Index ix, Chain ch) { return admit(policy(w), ix, Resolver(w.s, Store[]()), ch, w.app, "app"); }

bool says(Decision d, string phrase) {
  for (i32 i = 0; i < d.why.len(); i++) { if (d.why[i].indexOf(phrase) >= 0) { return true; } }
  return false;
}

string all(Decision d) { string out = ""; for (i32 i = 0; i < d.why.len(); i++) { out += d.why[i] + " | "; } return out; }

export string test_an_app_is_admitted_through_its_compiler_down_to_the_seed() {
  Check c = Check.create();
  World w = world();
  Decision d = app(w, full(w), Chain.none());
  c.ok(d.ok, "admitted: \{all(d)}");
  c.ok(says(d, "a trust root"), "and the chain reaches the seed: \{all(d)}");
  return c.report();
}

export string test_too_few_witnesses_or_runners_refuses() {
  Check c = Check.create();
  World w = world();
  Index one = Index.create();
  one.add(signStatement(derivation(one, w.r2, w.app, "wac on V8"), signingKey(W1())));
  Decision d1 = app(w, one, Chain.none());
  c.ok(!d1.ok && says(d1, "witnessed by w1 on 1 runner(s) (need 2 on 2)"), "one witness: \{all(d1)}");
  // Replace w2's app claim with one on V8: two witnesses, one runner.
  Index two = Index.create();
  claim(two, derivation(two, w.r1, w.compiler, "wac on V8"), W1());
  claim(two, derivation(two, w.r1, w.compiler, "wac on V8"), W2());
  claim(two, derivation(two, w.r1, w.compiler, "wac on V8"), W3());
  claim(two, derivation(two, w.r2, w.app, "wac on V8"), W1());
  claim(two, derivation(two, w.r2, w.app, "wac on V8"), W2());
  claim(two, Statement.Endorsement(w.csrc, "all"), ENDORSER_ALICE());
  claim(two, Statement.Endorsement(w.asrc, "all"), ENDORSER_ALICE());
  Decision d2 = app(w, two, Chain.none());
  c.ok(!d2.ok && says(d2, "on 1 runner(s) (need 2 on 2)"), "two witnesses on one runner: \{all(d2)}");
  return c.report();
}

export string test_a_revoked_compiler_witness_brings_the_app_down() {
  Check c = Check.create();
  World w = world();
  Index ix = full(w);
  Statement d = derivation(ix, w.r1, w.compiler, "wac on wasmtime");
  claim(ix, Statement.Revocation(statementId(d)), W2());
  Decision got = app(w, ix, Chain.none());
  c.ok(!got.ok && says(got, "witnessed by w1, w3"), "revoked in the index: \{all(got)}");
  // The same from the chain's record instead.
  Index fresh = full(w);
  Chain ch = Chain([addressOfKey(signingKey(W2()))], [statementId(d)], u8[][](), Cid[]());
  c.ok(!app(w, fresh, ch).ok, "revoked on the chain");
  // A revocation by someone else revokes nothing.
  Index other = full(w);
  claim(other, Statement.Revocation(statementId(d)), ENDORSER_ALICE());
  c.ok(app(w, other, Chain.none()).ok, "alice cannot revoke w2's statement");
  return c.report();
}

export string test_a_rejected_compiler_refuses_everything_built_with_it() {
  Check c = Check.create();
  World w = world();
  Index ix = full(w);
  claim(ix, Statement.Rejection(w.compiler, "backdoored"), LIST());
  Decision d = app(w, ix, Chain.none());
  c.ok(!d.ok && says(d, "rejection list you follow"), "a signed rejection: \{all(d)}");
  Chain ch = Chain(u8[][](), Cid[](), [addressOfKey(signingKey(LIST()))], [w.compiler]);
  c.ok(!app(w, full(w), ch).ok, "a rejection on the chain");
  // And the dependents lookup finds what the rejection affects.
  Cid[] hit = full(w).dependents(Resolver(w.s, Store[]()), w.compiler);
  c.ok(hit.len() == 1 && hit[0].eq(w.app), "dependents of the compiler: the app");
  return c.report();
}

export string test_an_analysis_can_stand_in_for_a_review() {
  Check c = Check.create();
  World w = world();
  Index ix = full(w);
  ix.held = withoutEndorsementOf(ix, w.asrc);
  c.ok(!app(w, ix, Chain.none()).ok, "no review, no analysis: refused");
  claim(ix, derivation(ix, w.r3, w.passing, "wac on V8"), W1());
  Decision d = app(w, ix, Chain.none());
  c.ok(d.ok && says(d, "says \"pass\""), "the analyser says pass: \{all(d)}");
  Index failing = full(w);
  failing.held = withoutEndorsementOf(failing, w.asrc);
  claim(failing, derivation(failing, w.r3, w.failing, "wac on V8"), W1());
  Decision f = app(w, failing, Chain.none());
  c.ok(!f.ok && says(f, "says \"fail\""), "the analyser says fail: \{all(f)}");
  return c.report();
}

Held[] withoutEndorsementOf(Index ix, Cid subject) {
  Held[] out = Held[]();
  for (i32 i = 0; i < ix.held.len(); i++) {
    bool drop = match (ix.held[i].statement) { Endorsement(s, _): s.eq(subject), Derivation(_, _, _): false, Rejection(_, _): false, Revocation(_): false };
    if (!drop) {
      Held[] next = Held[].filled(out.len() + 1, ix.held[i]);
      for (i32 j = 0; j < out.len(); j++) { next[j] = out[j]; }
      out = next;
    }
  }
  return out;
}

export string test_any_good_origin_is_enough_and_found_after_the_fact() {
  Check c = Check.create();
  World w = world();
  Index ix = Index.create();
  claim(ix, Statement.Endorsement(w.asrc, "all"), ENDORSER_ALICE());
  claim(ix, Statement.Endorsement(w.csrc, "all"), ENDORSER_ALICE());
  c.ok(!app(w, ix, Chain.none()).ok, "no origin known yet");
  // A second compiler nobody vouches for produces the same app: not enough on its own…
  Cid stranger = file(w.s, "an unknown compiler");
  Recipe bad = Recipe(MACHINE(), FORMAT(), input(w.s, ["program", "src"], [stranger, w.asrc]));
  claim(ix, derivation(ix, bad, w.app, "wac on V8"), W1());
  claim(ix, derivation(ix, bad, w.app, "wac on wasmtime"), W2());
  Decision only = app(w, ix, Chain.none());
  c.ok(!only.ok && says(only, "an input is refused"), "only the unvouched origin: \{all(only)}");
  // …and later someone publishes the derivations through the real compiler: now it is admitted.
  claim(ix, derivation(ix, w.r1, w.compiler, "wac on V8"), W1());
  claim(ix, derivation(ix, w.r1, w.compiler, "wac on wasmtime"), W2());
  claim(ix, derivation(ix, w.r1, w.compiler, "wac on V8"), W3());
  claim(ix, derivation(ix, w.r2, w.app, "wac on V8"), W1());
  claim(ix, derivation(ix, w.r2, w.app, "wac on wasmtime"), W2());
  c.ok(app(w, ix, Chain.none()).ok, "a good origin found after the fact admits it");
  return c.report();
}

/**
 * Diverse double-compiling: the compiler admitted only when the seed and an unrelated compiler (the bootstrap ladder's)
 * both build it from the same source. One origin is not enough, and one recipe cannot stand in for two.
 */
export string test_agree_needs_every_origin_each_through_its_own_recipe() {
  Check c = Check.create();
  World w = world();
  Cid ladder = file(w.s, "the ladder's compiler");
  Recipe viaLadder = Recipe(MACHINE(), FORMAT(), input(w.s, ["program", "src"], [ladder, w.csrc]));
  string[] ws = ["w1", "w2", "w3"];
  Rule bySeed = Rule.Derived(ws, 2, 2, [SlotRole("program", "seed"), SlotRole("src", "source")], "");
  Rule byLadder = Rule.Derived(ws, 2, 2, [SlotRole("program", "ladder"), SlotRole("src", "source")], "");
  Policy p = Policy([n("w1", W1()), n("w2", W2()), n("w3", W3()), n("alice", ENDORSER_ALICE())], [w.seed],
                    [MACHINE()], [FORMAT()], u8[][](), [
    RoleRules("compiler", [Rule.Agree([bySeed, byLadder])]),
    RoleRules("twice", [Rule.Agree([bySeed, bySeed])]),
    RoleRules("seed", [Rule.Root]),
    RoleRules("ladder", [Rule.Endorsed(["alice"], 1)]),
    RoleRules("source", [Rule.Endorsed(["alice"], 1)]),
  ], Conformance[]());
  Index ix = Index.create();
  claim(ix, Statement.Endorsement(w.csrc, "read all of it"), ENDORSER_ALICE());
  claim(ix, Statement.Endorsement(ladder, "built by the bootstrap ladder from its reviewed rungs"), ENDORSER_ALICE());
  claim(ix, derivation(ix, w.r1, w.compiler, "wac on V8"), W1());
  claim(ix, derivation(ix, w.r1, w.compiler, "wac on wasmtime"), W2());
  Resolver r = Resolver(w.s, Store[]());
  Decision one = admit(p, ix, r, Chain.none(), w.compiler, "compiler");
  c.ok(!one.ok && says(one, "origin 2 of 2 does not hold"), "the seed's origin alone: \{all(one)}");
  claim(ix, derivation(ix, viaLadder, w.compiler, "wac on V8"), W1());
  claim(ix, derivation(ix, viaLadder, w.compiler, "wac on wasmtime"), W2());
  Decision both = admit(p, ix, r, Chain.none(), w.compiler, "compiler");
  c.ok(both.ok, "the seed and the ladder agree: \{all(both)}");
  Decision twice = admit(p, ix, r, Chain.none(), w.compiler, "twice");
  c.ok(!twice.ok && says(twice, "origin 2 of 2 does not hold") && says(twice, "refused as seed"), "one recipe cannot be two origins: \{all(twice)}");
  return c.report();
}

export string test_machines_formats_and_cycles() {
  Check c = Check.create();
  World w = world();
  Index ix = full(w);
  Recipe x86 = Recipe("x86-64-linux/1", FORMAT(), w.r2.input);
  Index natives = Index.create();
  claim(natives, Statement.Endorsement(w.asrc, "all"), ENDORSER_ALICE());
  claim(natives, derivation(natives, x86, w.app, "a"), W1());
  claim(natives, derivation(natives, x86, w.app, "b"), W2());
  Decision m = app(w, natives, Chain.none());
  c.ok(!m.ok && says(m, "machine x86-64-linux/1 is not one the policy accepts"), "a machine the policy does not accept: \{all(m)}");
  // An object claimed to derive from itself: refused, and the evaluation ends.
  Cid loop = file(w.s, "a loop");
  Recipe self = Recipe(MACHINE(), FORMAT(), input(w.s, ["program", "src"], [loop, w.asrc]));
  Index cyc = Index.create();
  claim(cyc, derivation(cyc, self, loop, "a"), W1());
  claim(cyc, derivation(cyc, self, loop, "b"), W2());
  claim(cyc, derivation(cyc, self, loop, "c"), W3());
  // A role whose program slot must itself be admitted in that same role: the shape a compiler built by its own previous
  // version has, with nothing at the bottom.
  Policy p = policy(w);
  RoleRules chainRole = RoleRules("chain", [Rule.Derived(["w1", "w2", "w3"], 3, 1, [SlotRole("program", "chain")], "source")]);
  Decision d = admit(Policy(p.signers, Cid[](), p.machines, p.formats, p.rejectLists, [chainRole, p.roles[3]], Conformance[]()), cyc, Resolver(w.s, Store[]()), Chain.none(), loop, "chain");
  c.ok(!d.ok && says(d, "depends on itself"), "a cycle: \{all(d)}");
  return c.report();
}

export string test_an_index_saved_to_a_store_loads_back_and_still_admits() {
  Check c = Check.create();
  World w = world();
  Index ix = full(w);
  Store mirror = Store.memory();
  c.ok(saveIndex(ix, mirror).isOk(), "saved");
  Loaded l = loadIndex(mirror);
  c.ok(l.refused.len() == 0, "nothing refused on loading");
  c.ok(l.index.held.len() == ix.held.len() && l.index.recipes.len() == ix.recipes.len(), "every statement and recipe");
  // The claims came from the mirror; the objects they name (recipe inputs) still come from the world's own store.
  c.ok(app(w, l.index, Chain.none()).ok, "and the loaded index admits the app as the original did");
  // A mirror that altered one signed record: that record is refused, the rest load.
  Store bad = Store.memory();
  saveIndex(ix, bad);
  string list = string.fromBytes(bad.read("claims/index")!);
  string first = list.slice(7, list.indexOf("\n"));
  bad.write("ipfs/" + first, "{}".toBytes());
  Loaded lb = loadIndex(bad);
  c.ok(lb.refused.len() == 1 && lb.index.held.len() == ix.held.len() - 1, "one altered record refused, the rest kept: \{lb.refused.len()}");
  return c.report();
}
