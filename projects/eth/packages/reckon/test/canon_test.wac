// The NaN rewrite on modules small enough to read by hand: one function, (f64, f64) -> f64, and where the inline
// check goes, and where it is rightly left out.

import { canonicalize } from "../src/canon.wac";
import { Check } from "./check.wac";

u8[] module(u8[] code) {
  u8[] head = [0x00 as u8, 0x61 as u8, 0x73 as u8, 0x6D as u8, 0x01 as u8, 0x00 as u8, 0x00 as u8, 0x00 as u8,
               // type section: one func type (f64 f64) -> f64
               0x01 as u8, 0x07 as u8, 0x01 as u8, 0x60 as u8, 0x02 as u8, 0x7C as u8, 0x7C as u8, 0x01 as u8, 0x7C as u8,
               // function section: one function of type 0
               0x03 as u8, 0x02 as u8, 0x01 as u8, 0x00 as u8,
               // code section
               0x0A as u8, (code.len() + 2) as@ u8, 0x01 as u8, code.len() as@ u8];
  u8[] out = u8[].filled(head.len() + code.len(), 0);
  out.copyFrom(head, 0, 0, head.len());
  out.copyFrom(code, 0, head.len(), code.len());
  return out;
}

bool contains(u8[] hay, u8[] needle) {
  for (i32 i = 0; i + needle.len() <= hay.len(); i++) {
    bool all = true;
    for (i32 j = 0; j < needle.len(); j++) { if (hay[i + j] != needle[j]) { all = false; break; } }
    if (all) { return true; }
  }
  return false;
}

i32 count(u8[] hay, u8 x) {
  i32 n = 0;
  for (i32 i = 0; i < hay.len(); i++) { if (hay[i] == x) { n++; } }
  return n;
}

/** The inline check on an f64 through local `t`: tee, the canonical NaN, get, get, f64.eq, select. */
u8[] check64(u8 t) {
  return [0x22 as u8, t, 0x44 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0xF8 as u8, 0x7F as u8,
          0x20 as u8, t, 0x20 as u8, t, 0x61 as u8, 0x1B as u8];
}

u8[] cat(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  out.copyFrom(a, 0, 0, a.len());
  out.copyFrom(b, 0, a.len(), b.len());
  return out;
}

export string testAnAddThatIsReturnedIsChecked() {
  Check c = Check.create();
  // no locals; local.get 0; local.get 1; f64.add; end
  u8[] m = module([0x00 as u8, 0x20 as u8, 0x00 as u8, 0x20 as u8, 0x01 as u8, 0xA0 as u8, 0x0B as u8]);
  match (canonicalize(m)) {
    Err(e): { c.fail(e); }
    Ok(r): {
      c.eq(r.scan, "4 5\n", "four operators, the add at byte 5");
      // Two scratch locals declared after the two parameters, so the f64 one is local 2.
      c.ok(contains(r.module, [0x02 as u8, 0x01 as u8, 0x7C as u8, 0x01 as u8, 0x7D as u8, 0x20 as u8]), "an f64 and an f32 local appended");
      c.ok(contains(r.module, cat([0xA0 as u8], cat(check64(2 as u8), [0x0B as u8]))), "the add, then the check through local 2, then end");
      // Nothing appended elsewhere: one type, one function, as before.
      c.ok(contains(r.module, [0x01 as u8, 0x07 as u8, 0x01 as u8, 0x60 as u8]), "the type section is untouched");
      c.ok(contains(r.module, [0x03 as u8, 0x02 as u8, 0x01 as u8, 0x00 as u8]), "the function section is untouched");
    }
  }
  return c.report();
}

export string testAResultConsumedByArithmeticIsNotCheckedTwice() {
  Check c = Check.create();
  // (a * b) + a: the product only feeds the add, so only the add's result is checked.
  u8[] m = module([0x00 as u8, 0x20 as u8, 0x00 as u8, 0x20 as u8, 0x01 as u8, 0xA2 as u8, 0x20 as u8, 0x00 as u8,
                   0xA0 as u8, 0x0B as u8]);
  match (canonicalize(m)) {
    Err(e): { c.fail(e); }
    Ok(r): {
      c.eq(r.scan, "6 5,8\n", "two producers seen");
      c.ok(count(r.module, 0x1B as u8) == 1, "one check, not two: \{count(r.module, 0x1B as u8)}");
      c.ok(contains(r.module, [0xA2 as u8, 0x20 as u8, 0x00 as u8, 0xA0 as u8, 0x22 as u8]), "the product goes straight on; the sum is checked");
    }
  }
  return c.report();
}

export string testASignCopiedFromANaNIsChecked() {
  Check c = Check.create();
  // copysign(a, a / b): the quotient's sign shows, so it is checked even though no arithmetic follows it.
  u8[] m = module([0x00 as u8, 0x20 as u8, 0x00 as u8, 0x20 as u8, 0x00 as u8, 0x20 as u8, 0x01 as u8, 0xA3 as u8,
                   0xA6 as u8, 0x0B as u8]);
  match (canonicalize(m)) {
    Err(e): { c.fail(e); }
    Ok(r): { c.ok(contains(r.module, cat([0xA3 as u8], cat(check64(2 as u8), [0xA6 as u8]))), "the division is checked before copysign"); }
  }
  return c.report();
}

export string testALocalReadOnlyByArithmeticHidesItsValue() {
  Check c = Check.create();
  // one f64 local (2): local.set 2 (a / b); local.get 2; local.get 0; f64.mul; end — the quotient never shows itself.
  u8[] m = module([0x01 as u8, 0x01 as u8, 0x7C as u8, 0x20 as u8, 0x00 as u8, 0x20 as u8, 0x01 as u8, 0xA3 as u8,
                   0x21 as u8, 0x02 as u8, 0x20 as u8, 0x02 as u8, 0x20 as u8, 0x00 as u8, 0xA2 as u8, 0x0B as u8]);
  match (canonicalize(m)) {
    Err(e): { c.fail(e); }
    Ok(r): {
      c.ok(count(r.module, 0x1B as u8) == 1, "only the product is checked: \{count(r.module, 0x1B as u8)} checks");
      c.ok(contains(r.module, [0xA3 as u8, 0x21 as u8, 0x02 as u8]), "the quotient is set unchecked");
      c.ok(contains(r.module, cat([0xA2 as u8], check64(3 as u8))), "the product is checked through local 3, after the declared one");
    }
  }
  // The same, but the local is then also returned: now it shows, and so the quotient is checked where it is made.
  u8[] m2 = module([0x01 as u8, 0x01 as u8, 0x7C as u8, 0x20 as u8, 0x00 as u8, 0x20 as u8, 0x01 as u8, 0xA3 as u8,
                    0x21 as u8, 0x02 as u8, 0x20 as u8, 0x02 as u8, 0x0B as u8]);
  match (canonicalize(m2)) {
    Err(e): { c.fail(e); }
    Ok(r): { c.ok(contains(r.module, cat([0xA3 as u8], check64(3 as u8))), "a local that is returned does not hide"); }
  }
  return c.report();
}

export string testWhatMovesBitsIsLeftAlone() {
  Check c = Check.create();
  // local.get 0; f64.neg; local.get 1; f64.copysign; end — no NaN is produced, so nothing is inserted
  u8[] m = module([0x00 as u8, 0x20 as u8, 0x00 as u8, 0x9A as u8, 0x20 as u8, 0x01 as u8, 0xA6 as u8, 0x0B as u8]);
  match (canonicalize(m)) {
    Err(e): { c.fail(e); }
    Ok(r): {
      c.eq(r.scan, "5 \n", "neg and copysign move bits exactly");
      c.ok(r.module.len() == m.len() && contains(r.module, m), "and a module with nothing to check comes back as it was");
    }
  }
  return c.report();
}

export string testWhatItCannotReadItRefuses() {
  Check c = Check.create();
  // a SIMD instruction (0xFD prefix)
  u8[] m = module([0x00 as u8, 0xFD as u8, 0x0C as u8, 0x0B as u8]);
  c.ok(canonicalize(m).isErr(), "SIMD is refused, not skipped");
  c.ok(canonicalize([0x01 as u8, 0x02 as u8]).isErr(), "not a module");
  return c.report();
}
