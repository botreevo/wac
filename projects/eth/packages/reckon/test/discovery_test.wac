// Manifests: how their entries resolve, what is read and what is refused (src/discovery.wac).

import { readManifest, writeManifest, resolveUrl } from "../src/discovery.wac";
import { Check } from "./check.wac";

export string testRelativeEntriesResolveAgainstTheManifest() {
  Check c = Check.create();
  string m = "https://pages.example/wac-eth/reckon-mirrors.json";
  c.eq(resolveUrl(m, "downloads/claims"), "https://pages.example/wac-eth/downloads/claims", "beside it");
  c.eq(resolveUrl(m, "./downloads/claims/"), "https://pages.example/wac-eth/downloads/claims", "./ and a trailing slash");
  c.eq(resolveUrl(m, "../other/m.json"), "https://pages.example/other/m.json", "up one");
  c.eq(resolveUrl(m, "/root/mirror"), "https://pages.example/root/mirror", "from the origin");
  c.eq(resolveUrl(m, "http://127.0.0.1:8780"), "http://127.0.0.1:8780", "absolute, as it is");
  c.eq(resolveUrl("http://127.0.0.1:9000/m.json", "a"), "http://127.0.0.1:9000/a", "at a server's root, with a port");
  return c.report();
}

export string testAManifestReadsAndRoundTrips() {
  Check c = Check.create();
  string text = writeManifest(["https://a.example/m", "b/mirror"], ["https://c.example/reckon-mirrors.json"]);
  match (readManifest(text.toBytes(), "https://site.example/x/reckon-mirrors.json")) {
    Err(e): { c.fail(e); }
    Ok(m): {
      c.ok(m.mirrors.len() == 2 && m.mirrors[1] == "https://site.example/x/b/mirror", "mirrors, the relative one resolved");
      c.ok(m.manifests.len() == 1 && m.manifests[0] == "https://c.example/reckon-mirrors.json", "manifests");
    }
  }
  c.ok(readManifest("{ \"format\": \"reckon-mirrors/1\", \"mirrors\": [\"x\"], \"later\": 1 }".toBytes(), "https://s/m.json").isOk(),
       "an unknown field is ignored");
  c.ok(readManifest("{ \"format\": \"reckon-mirrors/2\", \"mirrors\": [] }".toBytes(), "https://s/m.json").isErr(), "another format");
  c.ok(readManifest("{ \"mirrors\": [] }".toBytes(), "https://s/m.json").isErr(), "no format");
  c.ok(readManifest("<html>".toBytes(), "https://s/m.json").isErr(), "not JSON");
  return c.report();
}
