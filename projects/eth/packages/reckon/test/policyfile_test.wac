// The policy file: what it reads into, and what it refuses rather than drop.

import { readPolicyFile } from "../src/policyfile.wac";
import { Rule } from "../src/admit.wac";
import { Check } from "./check.wac";

string kind(Rule r) {
  return match (r) { Root: "root", Endorsed(_, n): "endorsed \{n}", Derived(by, n, k, slots, other): "derived \{by.len()} \{n} \{k} \{slots.len()} \{other}", Analysis(_, _, _, _, _, _): "analysis", Within(role, path): "within \{role} \{path}" };
}

export string testAPolicyReadsWhole() {
  Check c = Check.create();
  string text = """
    {
      signers: { a: "0x1111111111111111111111111111111111111111", b: "0x2222222222222222222222222222222222222222" },
      roots: ["bafkreidtzm4frjuhvbeuzizsgbjqcyuc6pnnhhkcz5rmuttz3wrkvr6zvq"],
      machines: ["wasm-gc/wac-host/2"], formats: ["unixfs-v1-2025+hidden"],
      reject_lists: ["0x3333333333333333333333333333333333333333"],
      roles: {
        result: [{ derived: { by: ["a", "b"], at_least: 2, runners: 2, slots: { program: "program" }, other: "input" } }],
        input: ["root", { endorsed: { by: ["a"], at_least: 1 } }],
      },
    }
  """;
  match (readPolicyFile(text.toBytes())) {
    Err(e): { c.fail(e); }
    Ok(p): {
      c.ok(p.signers.len() == 2 && p.signers[1].name == "b" && p.signers[1].address[0] == 0x22, "signers");
      c.ok(p.roots.len() == 1 && p.rejectLists.len() == 1 && p.machines.len() == 1, "roots, lists, machines");
      c.ok(p.roles.len() == 2 && p.roles[0].role == "result" && p.roles[1].anyOf.len() == 2, "roles");
      c.eq(kind(p.roles[0].anyOf[0]), "derived 2 2 2 1 input", "the derived rule");
      c.eq(kind(p.roles[1].anyOf[0]) + ", " + kind(p.roles[1].anyOf[1]), "root, endorsed 1", "the alternatives");
    }
  }
  return c.report();
}

export string testWhatItRefuses() {
  Check c = Check.create();
  c.ok(readPolicyFile("{ signers: { a: \"0x12\" } }".toBytes()).isErr(), "a short address");
  c.ok(readPolicyFile("{ roles: { x: [\"rot\"] } }".toBytes()).isErr(), "a misspelt rule");
  c.ok(readPolicyFile("{ roles: { x: [{ endorse: {} }] } }".toBytes()).isErr(), "an unknown kind of rule");
  c.ok(readPolicyFile("{ roles: { x: \"root\" } }".toBytes()).isErr(), "a role that is not a list");
  c.ok(readPolicyFile("{ roots: [\"not-a-cid\"] }".toBytes()).isErr(), "a root that is not a CID");
  return c.report();
}
