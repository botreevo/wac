// Build statements, and checking one by rebuilding: design/system/0016 H3.
//
// A build is run from a clean commit, so that its source is a tree with a hash rather than whatever happened to be
// on disk. If the directory it runs in has a `wac.lock`, every entry must be pinned and the cache must match —
// the lock is inside the source tree, so the source hash then covers every dependency's bytes too.

import { Sys, Files, ChildEnv, Launch } from "std";
import { Result } from "core";
import { Claim } from "./statement.wac";
import { treeId, blobId, leafHash } from "./tree.wac";
import { hashDir, hashCommit } from "./walk.wac";
import { readLock, check, LockEntry } from "./lock.wac";

export struct Ran {
  bool ok;
  string out;
}

export async Ran exec(Sys sys, string program, string[] args, string cwd) {
  match (await sys.procs().exec(program, args, u8[](), ChildEnv.inherited(), Launch(cwd, false, false, false, false))) {
    Err(e): { return Ran(false, "cannot run \{program}: \{e}"); }
    Ok(r): {
      string out = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
      return Ran(r.ok(), r.ran() ? out : r.error);
    }
  }
}

/** If `dir` holds a wac.lock, every entry pinned and matched by the cache; "" when fine, else why not. */
export async string locked(Files fs, string home, string dir) {
  u8[]? text = (await fs.readFile(dir + "/wac.lock")).ok();
  if (text is null) { return ""; }
  match (readLock(text!)) {
    Err(e): { return e; }
    Ok(es): {
      match (await check(fs, home, es)) {
        Err(e): { return e; }
        Ok(_): { return ""; }
      }
    }
  }
}

/** Run `command` in `root/dir` and answer the claim it supports: source `source`, output the hash of `root/dir/path`. */
export async Result<Claim, string> runBuild(Sys sys, string home, string root, string source, string dir, string[] command,
                                            string path, string toolchain) {
  string where = dir == "" || dir == "." ? root : root + "/" + dir;
  string fault = await locked(sys.files(), home, where);
  if (fault != "") { return Result.Err("the dependencies are not what the lock pins: \{fault}"); }
  string[] rest = string[].defaulted(command.len() - 1);
  for (i32 i = 1; i < command.len(); i++) { rest[i - 1] = command[i]; }
  await sys.files().remove(where + "/" + path, false);
  Ran r = await exec(sys, command[0], rest, where);
  if (!r.ok) { return Result.Err("the build failed:\n\{r.out}"); }
  u8[] built;
  match (await sys.readFile(where + "/" + path)) {
    Err(e): { return Result.Err("the build wrote no \{path}"); }
    Ok(b): { built = b; }
  }
  return Result.Ok(Claim.Built(source, dir, command, path, toolchain, blobId(leafHash(built))));
}

/** The source of a build from the working tree: HEAD's tree, refused if anything tracked or untracked differs from it. */
export async Result<string, string> cleanSource(Sys sys) {
  Ran st = await exec(sys, "git", ["status", "--porcelain"], "");
  if (!st.ok) { return Result.Err("not a git checkout: \{st.out}"); }
  if (st.out != "") { return Result.Err("the working tree differs from HEAD, so it has no source hash:\n\{st.out}"); }
  match (await hashCommit(sys, ".", "HEAD", "")) {
    Err(e): { return Result.Err(e); }
    Ok(h): { return Result.Ok(treeId(h)); }
  }
}

/**
 * A rebuild: check out `commit` of `repo` into `scratch` (git as a locator — the checkout must hash to the
 * statement's source), run the same command, and answer the claim this rebuild supports.
 */
export async Result<Claim, string> rebuild(Sys sys, string home, string repo, string commit, string scratch, Claim c,
                                           string toolchain) {
  match (c) {
    Reviewed(_, _): { return Result.Err("only a built statement can be rebuilt"); }
    Built(source, dir, command, path, _, output): {
      await sys.files().remove(scratch, true);
      await sys.files().mkdir(scratch, true);
      Ran co = await exec(sys, "sh", ["-c", "git -C '\{repo}' archive '\{commit}' | tar -x -C '\{scratch}'"], "");
      if (!co.ok) { return Result.Err("cannot check out \{commit}: \{co.out}"); }
      string got;
      match (await hashDir(sys.files(), scratch, string[]())) {
        Err(e): { return Result.Err(e); }
        Ok(h): { got = treeId(h); }
      }
      if (got != source) { return Result.Err("\{repo} at \{commit} is not the statement's source\n  statement \{source}\n  checkout  \{got}"); }
      return await runBuild(sys, home, scratch, source, dir, command, path, toolchain);
    }
  }
}
