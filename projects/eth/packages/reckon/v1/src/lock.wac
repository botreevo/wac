// `wac.lock` pinned by content: design/system/0016 H2.
//
// Each entry gains `tree`, the kt1 of what the mapping takes (its `subdir`, or the whole repository), and for a
// subdir mapping `root`, the kt1 of the whole repository. `git` and `commit` stay, demoted to a locator: where
// to try first. `wac` itself reads such a lock without complaint and ignores the new fields, so this runs
// beside the compiler rather than inside it — `check` before a build is what the compiler would do on a fetch.
//
//   pin    fill in `tree` (and `root`) for entries that lack one, from the cache's bytes. Never changes one.
//   check  hash every entry in the cache and refuse any that differs from its `tree`.
//   fetch  for an entry not in the cache: fetch the commit with git into a scratch directory, hash *that*,
//          and install it only if it matches — a remote that serves other bytes is refused before the cache
//          ever holds them.

import { Sys, Files, ChildEnv, Launch } from "std";
import { Result } from "core";
import { json.parseJson5, json.JsonValue, json.JsonObject } from "wac";
import { treeId, parseId } from "./tree.wac";
import { hashDir, hashCommit } from "./walk.wac";

export struct LockEntry {
  string name;
  string git;
  string ref;
  string subdir;
  string commit;
  string tree;
  string root;
}

string field(JsonValue v, string key) { return v.member(key)?.text() ?? ""; }

export Result<LockEntry[], string> readLock(u8[] text) {
  JsonValue doc;
  match (parseJson5(text)) {
    Err(e): { return Result.Err("wac.lock: \{e.text()}"); }
    Ok(v): { doc = v; }
  }
  JsonObject? imports = doc.member("imports")?.object();
  if (imports is null) { return Result.Ok(LockEntry[]()); }
  LockEntry[] out = LockEntry[].defaulted(imports!.len());
  for (i32 i = 0; i < imports!.len(); i++) {
    string name = imports!.at(i).keyStr();
    JsonValue e = imports!.at(i).value;
    out[i] = LockEntry(name, field(e, "git"), field(e, "ref"), field(e, "subdir"), field(e, "commit"),
                       field(e, "tree"), field(e, "root"));
  }
  return Result.Ok(out);
}

/** The lock written back, one entry per line, fields in a fixed order. */
export string writeLock(LockEntry[] es) {
  string out = "{\n  \"imports\": {\n";
  for (i32 i = 0; i < es.len(); i++) {
    LockEntry e = es[i];
    string line = "    \"\{e.name}\": { \"git\": \"\{e.git}\", \"ref\": \"\{e.ref}\"";
    if (e.subdir != "") { line += ", \"subdir\": \"\{e.subdir}\""; }
    line += ", \"commit\": \"\{e.commit}\"";
    if (e.tree != "") { line += ", \"tree\": \"\{e.tree}\""; }
    if (e.root != "") { line += ", \"root\": \"\{e.root}\""; }
    out += line + " }" + (i + 1 < es.len() ? "," : "") + "\n";
  }
  return out + "  }\n}\n";
}

/** A repository URL as wac's cache names it (`packages/wacpkg/src/cache.wac`). */
export string escapeRepo(string url) {
  string out = "";
  string hexd = "0123456789ABCDEF";
  for (u8 c in url.toBytes()) {
    if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-') { out += string.fromBytes([c]); }
    else if (c >= 'A' && c <= 'Z') { out += "!" + string.fromBytes([c + 32]); }
    else { out += "%" + hexd.slice((c >> 4) as i32, ((c >> 4) as i32) + 1) + hexd.slice((c & 15) as i32, ((c & 15) as i32) + 1); }
  }
  return out;
}

export string cacheDir(string home, LockEntry e) { return home + "/cache/git/" + escapeRepo(e.git) + "/" + e.commit; }

/** `subdir` without its `./` and trailing `/`. */
string clean(string subdir) {
  string s = subdir;
  if (s.len() >= 2 && s.slice(0, 2) == "./") { s = s.slice(2, s.len()); }
  while (s.len() > 0 && s.slice(s.len() - 1, s.len()) == "/") { s = s.slice(0, s.len() - 1); }
  return s;
}

/** What the cache holds for an entry: (tree, root), the cache's `pack.pack` marker left out. */
export async Result<(string, string), string> cached(Files fs, string home, LockEntry e) {
  string dir = cacheDir(home, e);
  if (!((await fs.stat(dir + "/pack.pack")).ok()?.exists ?? false)) { return Result.Err("\{e.name}: not in the cache (\{dir})"); }
  string skip = "pack.pack";
  string root;
  match (await hashDir(fs, dir, [skip])) {
    Err(x): { return Result.Err("\{e.name}: \{x}"); }
    Ok(h): { root = treeId(h); }
  }
  string sub = clean(e.subdir);
  if (sub == "") { return Result.Ok((root, root)); }
  match (await hashDir(fs, dir + "/" + sub, string[]())) {
    Err(x): { return Result.Err("\{e.name}: \{x}"); }
    Ok(h): { return Result.Ok((treeId(h), root)); }
  }
}

/** Fill in missing trees. Answers the lines to print; an entry whose cache disagrees with its pin is an error. */
export async Result<string[], string> pin(Files fs, string home, LockEntry[] es) {
  string[] said = string[]();
  for (i32 i = 0; i < es.len(); i++) {
    (string, string) got = try await cached(fs, home, es[i]);
    if (es[i].tree != "" && es[i].tree != got.0) {
      return Result.Err("\{es[i].name}: the lock pins \{es[i].tree} and the cache holds \{got.0} — refusing to repin; "
                        + "move a pin on purpose by deleting it");
    }
    if (es[i].tree == "") {
      es[i].tree = got.0;
      if (clean(es[i].subdir) != "") { es[i].root = got.1; }
      said = push(said, "pinned \{es[i].name} \{got.0}");
    }
  }
  return Result.Ok(said);
}

/** Every entry pinned, and every pin matched by the cache. Answers one line per entry, or the first failure. */
export async Result<string[], string> check(Files fs, string home, LockEntry[] es) {
  string[] said = string[]();
  for (i32 i = 0; i < es.len(); i++) {
    if (es[i].tree == "") { return Result.Err("\{es[i].name}: no tree pinned — run `reckon lock pin`"); }
    (string, string) got = try await cached(fs, home, es[i]);
    if (got.0 != es[i].tree) {
      return Result.Err("\{es[i].name}: the cache does not hold what the lock pins\n  pinned \{es[i].tree}\n  cached \{got.0}");
    }
    if (es[i].root != "" && got.1 != es[i].root) {
      return Result.Err("\{es[i].name}: the repository around the subdir differs\n  pinned \{es[i].root}\n  cached \{got.1}");
    }
    said = push(said, "ok \{es[i].name} \{es[i].tree}");
  }
  return Result.Ok(said);
}

/**
 * Fetch an entry from `from` (its own `git` URL unless overridden) and install it in the cache only if what
 * arrived hashes to the pin. git is asked for a commit and its answer is never believed.
 */
export async Result<string, string> fetchInto(Sys sys, string home, LockEntry e, string from) {
  if (e.tree == "") { return Result.Err("\{e.name}: no tree pinned, so nothing to check a fetch against"); }
  string tmp = home + "/cache/fetching-" + e.commit;
  await sys.files().remove(tmp, true);
  await sys.files().mkdir(tmp, true);
  if (!(try await git(sys, ["-C", tmp, "init", "-q"]))) { return Result.Err("git init"); }
  try await git(sys, ["-C", tmp, "fetch", "-q", "--depth", "1", from, e.commit]);
  string got;
  match (await hashCommit(sys, tmp, "FETCH_HEAD", clean(e.subdir))) {
    Err(x): { await sys.files().remove(tmp, true); return Result.Err("\{e.name}: \{x}"); }
    Ok(h): { got = treeId(h); }
  }
  if (got != e.tree) {
    await sys.files().remove(tmp, true);
    return Result.Err("\{e.name}: \{from} served other bytes\n  pinned  \{e.tree}\n  arrived \{got}\n  nothing was written to the cache");
  }
  string dest = cacheDir(home, e);
  await sys.files().mkdir(dest, true);
  try await git(sys, ["-C", tmp, "--work-tree", dest, "checkout", "-q", "-f", "FETCH_HEAD", "--", "."]);
  await sys.writeFile(dest + "/pack.pack", u8[]());
  await sys.files().remove(tmp, true);
  return Result.Ok("fetched \{e.name} \{e.tree} from \{from}");
}

async Result<bool, string> git(Sys sys, string[] args) {
  match (await sys.procs().exec("git", args, u8[](), ChildEnv.inherited(), Launch.plain())) {
    Err(x): { return Result.Err("cannot run git: \{x}"); }
    Ok(r): {
      if (r.ok()) { return Result.Ok(true); }
      return Result.Err("git \{args[2]}: \{r.ran() ? string.fromBytes(r.stderr) : r.error}");
    }
  }
}

string[] push(string[] xs, string x) {
  string[] out = string[].defaulted(xs.len() + 1);
  for (i32 i = 0; i < xs.len(); i++) { out[i] = xs[i]; }
  out[xs.len()] = x;
  return out;
}
