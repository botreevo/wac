// The tree hash (design/system/0016 H1): agreement with an oracle, and sensitivity to everything it claims to
// cover. The vectors come from `tools/oracle/vectors.mjs`, an independent implementation over js-sha3; the
// whole-repository agreement (working tree, commit through git, oracle) is in `tools/agree.sh`.

import { Result } from "core";
import { Builder, Entry, nodeHash, leafHash, treeId, blobId, parseId, KIND_FILE, KIND_EXEC, KIND_DIR } from "../src/tree.wac";
import { hex } from "../src/statement.wac";
import { Check } from "../../test/check.wac";

string h(Result<u8[], string> r) {
  return match (r) { Ok(b): hex(b), Err(e): "error: " + e };
}

export string test_vectors_agree_with_the_javascript_oracle() {
  Check c = Check.create();
  c.eq(hex(leafHash(u8[]())), "bc36789e7a1e281436464229828f817d6612f7b477d66591ff96a9e064bcc98a", "leaf of nothing");
  c.eq(h(nodeHash(Entry[]())), "5fe7f977e71dba2ea1a68e21057beebb9be2ac30c6410aa38d4f3fbe41dcffd2", "empty tree");
  Builder one = Builder.create();
  one.add("a.txt", false, "hello\n".toBytes());
  c.eq(h(one.hash()), "4ce290a0efa67e5a51659854c94e43d82fc058cd73b9700d644db82c493d3cda", "one file");
  Builder two = Builder.create();
  two.add("src/lib.wac", false, "x".toBytes());
  two.add("bin/run", true, "#!/bin/sh\n".toBytes());
  c.eq(h(two.hash()), "388af3fec85753c62c76b2288097608a2684ae4414631741ed05b1c4017b964a", "nested, with an executable");
  return c.report();
}

/** The fixture every perturbation is a change to. `which` selects the change; 0 is none. */
string fixture(i32 which) {
  Builder b = Builder.create();
  b.add(which == 2 ? "README.MD" : "README.md", false, "# hello\n".toBytes());
  b.add("src/a.wac", false, (which == 1 ? "export i32 a() { return 2; }\n" : "export i32 a() { return 1; }\n").toBytes());
  b.add("src/b.wac", false, (which == 5 ? "export i32 a() { return 1; }\n" : "export i32 b() { return 2; }\n").toBytes());
  b.add(which == 4 ? "lib/c.wac" : "src/c.wac", false, "// c\n".toBytes());
  b.add("tools/run.sh", which != 3, "#!/bin/sh\n".toBytes());
  if (which == 6) { b.add("src/d.wac", false, u8[]()); }
  if (which == 7) { b.add("src/deeper/e.wac", false, u8[]()); }
  return h(b.hash());
}

export string test_every_kind_of_change_moves_the_hash() {
  Check c = Check.create();
  string base = fixture(0);
  c.eq(fixture(0), base, "the same files twice");
  string[] what = ["", "one byte of a file", "a rename (case only)", "the executable bit", "a file moved to another directory",
                   "two files' contents swapped into one", "an empty file added", "an empty file in a new directory"];
  string[] seen = string[].defaulted(what.len());
  seen[0] = base;
  for (i32 i = 1; i < what.len(); i++) {
    seen[i] = fixture(i);
    for (i32 j = 0; j < i; j++) {
      if (seen[i] == seen[j]) { c.fail("\{what[i]} hashes the same as \{j == 0 ? "the fixture" : what[j]}"); }
    }
  }
  return c.report();
}

export string test_order_of_entries_does_not_matter() {
  Check c = Check.create();
  u8[] x = leafHash("x".toBytes());
  u8[] y = leafHash("y".toBytes());
  Entry[] ab = [Entry("a", KIND_FILE, x), Entry("b", KIND_EXEC, y)];
  Entry[] ba = [Entry("b", KIND_EXEC, y), Entry("a", KIND_FILE, x)];
  c.eq(h(nodeHash(ab)), h(nodeHash(ba)), "two orders");
  // Bytewise, not by code point or locale: "B" (0x42) sorts before "a" (0x61), and "é" after both.
  Entry[] mixed = [Entry("é", KIND_FILE, x), Entry("a", KIND_FILE, x), Entry("B", KIND_FILE, x)];
  Entry[] sorted = [Entry("B", KIND_FILE, x), Entry("a", KIND_FILE, x), Entry("é", KIND_FILE, x)];
  c.eq(h(nodeHash(mixed)), h(nodeHash(sorted)), "bytewise order");
  // A file and a directory with the same hash and name are still different trees: the kind is hashed.
  c.ok(h(nodeHash([Entry("a", KIND_FILE, x)])) != h(nodeHash([Entry("a", KIND_DIR, x)])), "kind is part of the entry");
  return c.report();
}

export string test_names_a_tree_cannot_hold_are_refused() {
  Check c = Check.create();
  u8[] x = leafHash(u8[]());
  string[] bad = ["", ".", "..", "a/b"];
  for (i32 i = 0; i < bad.len(); i++) {
    c.ok(h(nodeHash([Entry(bad[i], KIND_FILE, x)])).indexOf("error:") == 0, "the name \"\{bad[i]}\" was accepted");
  }
  c.ok(h(nodeHash([Entry("a", KIND_FILE, x), Entry("a", KIND_DIR, x)])).indexOf("error:") == 0, "a name twice was accepted");
  Builder b = Builder.create();
  b.add("a", false, u8[]());
  c.ok(b.add("a/b", false, u8[]()) != "", "a path through a file was accepted");
  c.ok(b.add("a", false, u8[]()) != "", "a file named twice was accepted");
  c.ok(b.add("x/../y", false, u8[]()) != "", "a path through .. was accepted");
  return c.report();
}

export string test_ids_round_trip_and_keep_their_kind() {
  Check c = Check.create();
  u8[] x = leafHash("x".toBytes());
  c.ok(parseId(treeId(x))!.tree, "kt1 is a tree");
  c.ok(!parseId(blobId(x))!.tree, "kb1 is a file");
  c.eq(hex(parseId(blobId(x))!.hash), hex(x), "the hash comes back");
  c.ok(parseId("kt2:" + hex(x)) is null, "an unknown version");
  c.ok(parseId("kt1:" + hex(x).slice(0, 62)) is null, "a short hash");
  c.ok(parseId("kt1:" + hex(x).slice(0, 62) + "zz") is null, "not hex");
  return c.report();
}
