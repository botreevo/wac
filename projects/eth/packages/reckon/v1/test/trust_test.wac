// Which statements bear on a subject. This filter once matched nothing at all — compiled inside an async
// function, wacc lost the match — and every app was refused for want of a review that was right there.

import { Claim, Verified, signClaim, verify, unhex } from "../src/statement.wac";
import { about } from "../src/trust.wac";
import { Check } from "../../test/check.wac";

string rep(string two) { string out = ""; for (i32 i = 0; i < 32; i++) { out += two; } return out; }
Verified v(Claim c) { return verify(signClaim(c, unhex(rep("11"))!).ok()!).ok()!; }

export string test_a_review_of_the_claimed_source_bears_on_the_app() {
  Check c = Check.create();
  string app = "kb1:" + rep("cc");
  Verified[] all = [
    v(Claim.Built("kt1:" + rep("aa"), ".", ["wac"], "a.wasm", "kt1:" + rep("bb"), app)),
    v(Claim.Built("kt1:" + rep("a1"), ".", ["wac"], "a.wasm", "kt1:" + rep("bb"), "kb1:" + rep("c1"))),
    v(Claim.Reviewed("kt1:" + rep("aa"), "all")),
    v(Claim.Reviewed("kt1:" + rep("a1"), "all")),
    v(Claim.Reviewed(app, "the binary")),
  ];
  Verified[] kept = about(all, app);
  c.ok(kept.len() == 3, "the build of it, the review of its source and the review of it: kept \{kept.len()}");
  return c.report();
}
