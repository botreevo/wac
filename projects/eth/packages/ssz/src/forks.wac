// The light client's SSZ types after Altair: one descriptor table per fork, for `container.wac`.
//
// Altair's table is in `beacon.wac`, and its first eleven entries are kept here at the same indices. What changes by
// fork is the `LightClientHeader` and the lengths of the three branches:
//
//   Capella   the header gains `execution: ExecutionPayloadHeader` (15 fields) and an `execution_branch` of depth 4,
//             proving it at gindex 25 of the BeaconBlockBody. ExecutionPayloadHeader has a list in it (`extra_data`),
//             so from here on a header is variable-size and the offset code in `container.wac` is finally exercised.
//   Deneb     ExecutionPayloadHeader gains `blob_gas_used` and `excess_blob_gas` (17 fields). Branches unchanged.
//   Electra   BeaconState grew, so the state branches deepen: finality gindex 169 (depth 7), sync committees 86/87
//             (depth 6). Header unchanged from Deneb.
//   Fulu      no light-client change at all.
//   Gloas     EIP-7732 takes the payload out of the block, so the header loses `execution` and carries only
//             `execution_block_hash`, proved at gindex 2856 (the bid's parent_block_hash; depth 11). EIP-7688 moves
//             the state fields again: finality 735 (depth 9), sync committees 2945/2946 (depth 11).
//
// Read off `consensus-specs` specs/{capella,deneb,electra,gloas}/light-client/sync-protocol.md and the
// ExecutionPayloadHeader definitions in specs/{capella,deneb}/beacon-chain.md.

export i32 ALTAIR() { return 0; }
export i32 CAPELLA() { return 1; }
export i32 DENEB() { return 2; }
export i32 ELECTRA() { return 3; }
export i32 FULU() { return 4; }
export i32 GLOAS() { return 5; }

export string forkName(i32 fork) {
  string[] names = ["altair", "capella", "deneb", "electra", "fulu", "gloas"];
  return fork >= 0 && fork < names.len() ? names[fork] : "unknown";
}

/** The fork a name gives, or -1. */
export i32 forkNamed(string name) {
  for (i32 i = 0; i <= GLOAS(); i++) { if (forkName(i) == name) { return i; } }
  return -1;
}

// ── Generalized indices, each the spec's `get_generalized_index(…)` ─────────────────────────────────────

export u64 finalizedRootGindex(i32 fork) {
  if (fork >= GLOAS()) { return 735 as u64; }
  if (fork >= ELECTRA()) { return 169 as u64; }
  return 105 as u64;
}

export u64 currentSyncCommitteeGindex(i32 fork) {
  if (fork >= GLOAS()) { return 2945 as u64; }
  if (fork >= ELECTRA()) { return 86 as u64; }
  return 54 as u64;
}

export u64 nextSyncCommitteeGindex(i32 fork) {
  if (fork >= GLOAS()) { return 2946 as u64; }
  if (fork >= ELECTRA()) { return 87 as u64; }
  return 55 as u64;
}

/** `execution_payload` in a Capella-to-Fulu BeaconBlockBody. */
export u64 executionPayloadGindex() { return 25 as u64; }

/**
 * The execution block hash within the BeaconBlockBody: through the payload header before Gloas (`block_hash` is
 * field 12 of 15 or 17, so 25·16+12 for Capella and 25·32+12 for Deneb on), and through the bid from Gloas on.
 */
export u64 executionBlockHashGindex(i32 fork) {
  if (fork >= GLOAS()) { return 2856 as u64; }
  if (fork >= DENEB()) { return 812 as u64; }
  return 412 as u64;
}

i32 depthOf(u64 g) {
  i32 d = 0;
  u64 x = g;
  while (x > 1 as u64) { x = x >> (1 as u64); d++; }
  return d;
}

export i32 finalityBranchDepth(i32 fork) { return depthOf(finalizedRootGindex(fork)); }
export i32 syncCommitteeBranchDepth(i32 fork) { return depthOf(currentSyncCommitteeGindex(fork)); }
export i32 executionBranchDepth(i32 fork) {
  if (fork >= GLOAS()) { return depthOf(executionBlockHashGindex(fork)); }
  return fork >= CAPELLA() ? depthOf(executionPayloadGindex()) : 0;
}

// ── Type indices: 0–10 as in beacon.wac ───────────────────────────────────────────────────────────────

export i32 FT_UINT64() { return 1; }
export i32 FT_BYTES32() { return 2; }
export i32 FT_BEACON_BLOCK_HEADER() { return 5; }
export i32 FT_SYNC_COMMITTEE() { return 8; }
export i32 FT_SYNC_AGGREGATE() { return 10; }
export i32 FT_LIGHT_CLIENT_HEADER() { return 11; }
export i32 FT_SYNC_BRANCH() { return 12; }
export i32 FT_FINALITY_BRANCH() { return 13; }
export i32 FT_LIGHT_CLIENT_BOOTSTRAP() { return 14; }
export i32 FT_LIGHT_CLIENT_UPDATE() { return 15; }
export i32 FT_LIGHT_CLIENT_FINALITY_UPDATE() { return 16; }
export i32 FT_LIGHT_CLIENT_OPTIMISTIC_UPDATE() { return 17; }
export i32 FT_EXECUTION_PAYLOAD_HEADER() { return 22; }
export i32 FT_EXECUTION_BRANCH() { return 23; }

/** The type table for `fork`, with `syncCommitteeSize` 512 (mainnet) or 32 (minimal). */
export i32[] lightClientTypes(i32 fork, i32 syncCommitteeSize) {
  i32[] t = i32[].filled(24 * 4, 0);
  //               kind param                         child count
  put(t, 0,        0,   1,                            0,    0);    // uint8
  put(t, 1,        0,   8,                            0,    0);    // uint64
  put(t, 2,        3,   32,                           0,    0);    // Bytes32
  put(t, 3,        3,   48,                           0,    0);    // BLSPubkey
  put(t, 4,        3,   96,                           0,    0);    // BLSSignature
  put(t, 5,        5,   0,                            0,    5);    // BeaconBlockHeader
  put(t, 6,        5,   0,                            5,    2);    // SigningData
  put(t, 7,        3,   syncCommitteeSize,            3,    0);    // Vector[BLSPubkey, N]
  put(t, 8,        5,   0,                            7,    2);    // SyncCommittee
  put(t, 9,        1,   syncCommitteeSize,            0,    0);    // Bitvector[N]
  put(t, 10,       5,   0,                            9,    2);    // SyncAggregate
  // LightClientHeader: beacon [, execution | execution_block_hash, execution_branch]
  put(t, 11,       5,   0,                            11,   fork >= CAPELLA() ? 3 : 1);
  put(t, 12,       3,   syncCommitteeBranchDepth(fork), 2,  0);    // Current/NextSyncCommitteeBranch
  put(t, 13,       3,   finalityBranchDepth(fork),    2,    0);    // FinalityBranch
  put(t, 14,       5,   0,                            14,   3);    // LightClientBootstrap
  put(t, 15,       5,   0,                            17,   7);    // LightClientUpdate
  put(t, 16,       5,   0,                            24,   5);    // LightClientFinalityUpdate
  put(t, 17,       5,   0,                            29,   3);    // LightClientOptimisticUpdate
  put(t, 18,       3,   20,                           0,    0);    // ExecutionAddress = Bytes20
  put(t, 19,       3,   256,                          0,    0);    // ByteVector[BYTES_PER_LOGS_BLOOM]
  put(t, 20,       4,   32,                           0,    0);    // ByteList[MAX_EXTRA_DATA_BYTES]
  put(t, 21,       0,   32,                           0,    0);    // uint256
  put(t, 22,       5,   0,                            32,   fork >= DENEB() ? 17 : 15);   // ExecutionPayloadHeader
  put(t, 23,       3,   executionBranchDepth(fork),   2,    0);    // ExecutionBranch
  return t;
}

void put(i32[] t, i32 i, i32 kind, i32 param, i32 child, i32 count) {
  t[i * 4 + 0] = kind;
  t[i * 4 + 1] = param;
  t[i * 4 + 2] = child;
  t[i * 4 + 3] = count;
}

/** The field runs; a container's `child` in the table is where its run starts. */
export i32[] lightClientFields(i32 fork) {
  i32[] f = i32[].filled(49, 0);
  f[0] = 1;  f[1] = 1;  f[2] = 2;  f[3] = 2;  f[4] = 2;                    // BeaconBlockHeader
  f[5] = 2;  f[6] = 2;                                                     // SigningData
  f[7] = 7;  f[8] = 3;                                                     // SyncCommittee
  f[9] = 9;  f[10] = 4;                                                    // SyncAggregate
  f[11] = 5; f[12] = fork >= GLOAS() ? 2 : 22; f[13] = 23;                 // LightClientHeader (count says how many)
  f[14] = 11; f[15] = 8; f[16] = 12;                                       // LightClientBootstrap
  f[17] = 11; f[18] = 8; f[19] = 12; f[20] = 11; f[21] = 13; f[22] = 10; f[23] = 1;   // LightClientUpdate
  f[24] = 11; f[25] = 11; f[26] = 13; f[27] = 10; f[28] = 1;              // LightClientFinalityUpdate
  f[29] = 11; f[30] = 10; f[31] = 1;                                       // LightClientOptimisticUpdate
  // ExecutionPayloadHeader: parent_hash, fee_recipient, state_root, receipts_root, logs_bloom, prev_randao,
  // block_number, gas_limit, gas_used, timestamp, extra_data, base_fee_per_gas, block_hash, transactions_root,
  // withdrawals_root [, blob_gas_used, excess_blob_gas]
  f[32] = 2; f[33] = 18; f[34] = 2; f[35] = 2; f[36] = 19; f[37] = 2; f[38] = 1; f[39] = 1; f[40] = 1; f[41] = 1;
  f[42] = 20; f[43] = 21; f[44] = 2; f[45] = 2; f[46] = 2; f[47] = 1; f[48] = 1;
  return f;
}

// ── Mainnet's fork schedule (consensus-specs configs/mainnet.yaml) ─────────────────────────────────────────
//
// Gloas has no epoch yet (FAR_FUTURE_EPOCH upstream); it is left out rather than given a guess, so `mainnetForkAt`
// never answers it until a release sets one and this table is changed to match.

/** The first epoch of each fork from Altair on; -1 where none is scheduled. */
export i64 mainnetForkEpoch(i32 fork) {
  i64[] epochs = [74240 as i64, 194048 as i64, 269568 as i64, 364032 as i64, 411392 as i64, -1 as i64];
  return fork >= 0 && fork < epochs.len() ? epochs[fork] : -1 as i64;
}

/**
 * The four-byte fork version: `0x0N000000` on mainnet, N counting forks from phase 0. Bellatrix (N = 2) changed nothing
 * a light client reads and has no index here, so every fork after Altair is one further on than its index.
 */
export u8[] mainnetForkVersion(i32 fork) { return [(fork == ALTAIR() ? 1 : fork + 2) as@ u8, 0 as u8, 0 as u8, 0 as u8]; }

/** The fork in force at `epoch` on mainnet, or -1 before Altair. */
export i32 mainnetForkAt(i64 epoch) {
  i32 at = -1;
  for (i32 f = 0; f <= GLOAS(); f++) {
    i64 e = mainnetForkEpoch(f);
    if (e >= 0 as i64 && epoch >= e) { at = f; }
  }
  return at;
}
