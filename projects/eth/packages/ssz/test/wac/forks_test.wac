// The per-fork light-client tables (`src/forks.wac`) against Ethereum's `ssz_static` vectors, mainnet config:
// ExecutionPayloadHeader and the five light-client containers, for every fork after Altair in the pinned release.
//
// Size and root are asserted apart, as in `beacon_test.wac`: a variable-size container (every header from Capella
// on carries `extra_data`) has no fixed size, so a wrong field list shows as a refusal instead, and is reported as one.
//
// **Gloas is checked against Electra's table.** The release predates EIP-7732's light-client change, so its Gloas
// containers are Electra's; the test asserts exactly that, so the day the vectors move, it says so.

import { wactest.T } from "wac";
import { wactest.hex } from "wac";
import { wactest.Loaded, wactest.json } from "wac";
import { Files, Output, Procs, Sys } from "std";
import { json.JsonValue, json.JsonArray } from "wac";
import { codec.hexDecoded as decoded } from "wac";
import { hashTreeRoot } from "../../src/container.wac";
import { lightClientTypes, lightClientFields, forkNamed, ELECTRA, GLOAS, FT_EXECUTION_PAYLOAD_HEADER,
         FT_LIGHT_CLIENT_HEADER, FT_LIGHT_CLIENT_BOOTSTRAP, FT_LIGHT_CLIENT_UPDATE, FT_LIGHT_CLIENT_FINALITY_UPDATE,
         FT_LIGHT_CLIENT_OPTIMISTIC_UPDATE, executionBlockHashGindex, finalityBranchDepth, syncCommitteeBranchDepth,
         executionBranchDepth, mainnetForkAt, mainnetForkVersion, FULU, ALTAIR } from "../../src/forks.wac";

static string MANIFEST = "packages/ssz/test/fixtures.json";

i32 typeNamed(string name) {
  if (name == "ExecutionPayloadHeader") { return FT_EXECUTION_PAYLOAD_HEADER(); }
  if (name == "LightClientHeader") { return FT_LIGHT_CLIENT_HEADER(); }
  if (name == "LightClientBootstrap") { return FT_LIGHT_CLIENT_BOOTSTRAP(); }
  if (name == "LightClientUpdate") { return FT_LIGHT_CLIENT_UPDATE(); }
  if (name == "LightClientFinalityUpdate") { return FT_LIGHT_CLIENT_FINALITY_UPDATE(); }
  if (name == "LightClientOptimisticUpdate") { return FT_LIGHT_CLIENT_OPTIMISTIC_UPDATE(); }
  return -1;
}

string textOf(JsonValue c, string key) {
  JsonValue? v = c.member(key);
  if (v is null) { return ""; }
  match (v!) {
    Str(bytes): { return string.fromBytes(bytes); }
    default: { return ""; }
  }
}

export string test_every_post_altair_light_client_container_merkleizes_to_ethereums_root(Sys sys) {
  T t = T.create();
  Loaded f = json(sys.stderr(), sys.files(), sys.procs(), "ssz", "ssz_static_light_client_forks_mainnet", MANIFEST);
  t.isTrue(f.ok, f.error);
  if (!f.ok) { return t.report(); }
  JsonArray? cases = f.doc.member("cases")?.array();
  t.isTrue(!(cases is null), "the fixture has no `cases` array");
  if (cases is null) { return t.report(); }
  i32 checked = 0;
  for (i32 i = 0; i < cases!.len(); i++) {
    JsonValue c = cases!.get(i);
    string forkText = textOf(c, "fork");
    i32 fork = forkNamed(forkText);
    // What this release calls gloas is Electra's light-client layout (see the header).
    if (fork == GLOAS()) { fork = ELECTRA(); }
    string container = textOf(c, "container");
    i32 ty = typeNamed(container);
    t.isTrue(fork >= 0 && ty >= 0, "unknown case \{forkText}/\{container}");
    if (fork < 0 || ty < 0) { continue; }
    u8[]? root = hashTreeRoot(lightClientTypes(fork, 512), lightClientFields(fork), ty, decoded(textOf(c, "ssz")));
    string where = "\{forkText}/\{container}/\{textOf(c, "case")}";
    t.isTrue(root is not null, "\{where}: refused as malformed");
    if (root is not null) { t.eqStr(hex(root!), textOf(c, "root"), where); }
    checked++;
  }
  t.eqStr("\{checked}", "90", "cases checked");
  return t.report();
}

/** The generalized indices and depths, each stated in the specs as a number beside its definition. */
export string test_the_branch_shapes_are_the_specs(Sys sys) {
  T t = T.create();
  t.eqStr("\{finalityBranchDepth(forkNamed("capella"))} \{finalityBranchDepth(ELECTRA())} \{finalityBranchDepth(GLOAS())}", "6 7 9",
       "finality branch depth");
  t.eqStr("\{syncCommitteeBranchDepth(forkNamed("deneb"))} \{syncCommitteeBranchDepth(ELECTRA())} \{syncCommitteeBranchDepth(GLOAS())}",
       "5 6 11", "sync committee branch depth");
  t.eqStr("\{executionBranchDepth(forkNamed("altair"))} \{executionBranchDepth(forkNamed("capella"))} \{executionBranchDepth(GLOAS())}",
       "0 4 11", "execution branch depth");
  t.eqStr("\{executionBlockHashGindex(forkNamed("capella"))} \{executionBlockHashGindex(forkNamed("deneb"))} \{executionBlockHashGindex(GLOAS())}",
       "412 812 2856", "execution block hash gindex");
  t.eqStr("\{mainnetForkAt(74239 as i64)} \{mainnetForkAt(74240 as i64)} \{mainnetForkAt(364031 as i64)} \{mainnetForkAt(364032 as i64)} \{mainnetForkAt(9000000 as i64)}",
          "-1 0 2 3 4", "mainnet's fork at an epoch: nothing before Altair, Fulu from 411392, no Gloas yet");
  t.eqStr(hex(mainnetForkVersion(ALTAIR())) + " " + hex(mainnetForkVersion(FULU())), "01000000 06000000", "fork versions");
  return t.report();
}
