# systemd unit for the devnet. Assumes a `wacuum` user whose ~/.wac/bin/wac is built from wac.lock's wac
# commit (`./bootstrap.sh --host nodejs`: the Node host runs wacuum two to four times as fast as wasmtime),
# and wac-eth at /opt/wac-eth with `wac task devnet:build` run in it (until 2026-11-09 this was wacuum-devnet's own
# repository at /opt/wacuum-devnet: a server set up then needs this path changed, and wac-eth checked out).
#
#     sudo cp packages/wacuum-devnet/deploy/wacuum-devnet.service /etc/systemd/system/ && sudo systemctl enable --now wacuum-devnet
[Unit]
Description=wacuum devnet: chain, explorer and faucet
After=network-online.target
Wants=network-online.target

[Service]
User=wacuum
Environment=PATH=/home/wacuum/.wac/bin:/usr/local/bin:/usr/bin:/bin
StateDirectory=wacuum-devnet
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/wac-eth/packages/wacuum-devnet/dist/devnet --datadir /var/lib/wacuum-devnet --site-url https://wacuum.voltrevo.com
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
