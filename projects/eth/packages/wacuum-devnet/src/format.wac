// Numbers as the explorer shows them: ether with its decimals, gwei, ages, and hashes cut short.

import { U256 } from "@/packages/wacuum/src/lib.wac";

/** A 0x-quantity as a number, or zero when it is not one. */
export U256 quantityOf(string? hex) {
  if (hex is null) { return U256.zero(); }
  return U256.fromHex(hex!) ?? U256.zero();
}

/** A 0x-quantity that fits in 64 bits, as one. */
export u64 smallOf(string? hex) { return quantityOf(hex).low(); }

/** `wei` in units of 10^`decimals`, with at most `places` decimals and no trailing zeros: "1.5", "0.000021". */
export string scaled(U256 wei, i32 decimals, i32 places) {
  U256 unit = U256.ofU64(10).exp(U256.ofI32(decimals));
  string whole = wei.div(unit).toDecimal();
  string frac = wei.mod(unit).toDecimal();
  while (frac.len() < decimals) { frac = "0" + frac; }
  frac = frac.slice(0, places < decimals ? places : decimals);
  while (frac.len() > 0 && frac.slice(frac.len() - 1, frac.len()) == "0") { frac = frac.slice(0, frac.len() - 1); }
  if (frac == "" && wei.mod(unit).isZero()) { return grouped(whole); }
  // Something, but less than the last decimal shown: say so rather than show a zero.
  if (frac == "") { return whole == "0" ? "< 0." + "000000000000000000".slice(0, places - 1) + "1" : "≈ " + grouped(whole); }
  return grouped(whole) + "." + frac;
}

export string etherText(U256 wei) { return scaled(wei, 18, 6) + " ETH"; }
export string gweiText(U256 wei) { return scaled(wei, 9, 3) + " gwei"; }

/** A decimal number with its thousands separated: "1,234,567". */
export string grouped(string digits) {
  string out = "";
  i32 n = digits.len();
  for (i32 i = 0; i < n; i++) {
    if (i > 0 && (n - i) % 3 == 0) { out += ","; }
    out += digits.slice(i, i + 1);
  }
  return out;
}

/** `0x1234…cdef`: a hash or an address short enough for a table. */
export string short(string hex) {
  if (hex.len() <= 14) { return hex; }
  return hex.slice(0, 8) + "…" + hex.slice(hex.len() - 6, hex.len());
}

/** How long ago `then` was, at `now` (both in seconds): "12 s ago", "3 min ago", "5 h ago", "2 d ago". */
export string ago(u64 then, u64 now) {
  if (then >= now) { return "just now"; }
  u64 s = now - then;
  if (s < 60) { return "\{s} s ago"; }
  if (s < 3600) { return "\{s / 60} min ago"; }
  if (s < 86400) { return "\{s / 3600} h ago"; }
  return "\{s / 86400} d ago";
}

/** A gas figure, and its share of `limit`: "21,000 (0.05%)". */
export string gasShare(U256 used, U256 limit) {
  if (limit.isZero()) { return grouped(used.toDecimal()); }
  U256 bp = used.mul(U256.ofU64(10000)).div(limit);
  string frac = bp.mod(U256.ofU64(100)).toDecimal();
  if (frac.len() < 2) { frac = "0" + frac; }
  return grouped(used.toDecimal()) + " (" + bp.div(U256.ofU64(100)).toDecimal() + "." + frac + "%)";
}
