{
  // Every unit test, in wac.
  test: "wac test test",
  // src/images.wac from the images in assets/.
  embed: "wac run --allow-read --allow-write tools/embed.wac",
  // The node, site and faucet, as one executable file.
  build: "mkdir -p dist && wac app --allow-read --allow-write --allow-net cmd/devnet.wac -o dist/devnet",
  // A visitor and a wallet against a running devnet: `wac task e2e`, or with a host and port after it.
  e2e: "wac run --allow-net tools/e2e.wac --",
}
