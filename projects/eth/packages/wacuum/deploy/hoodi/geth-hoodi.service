[Unit]
Description=geth on Hoodi: the reference wacuum takes its state from and is checked against
After=network-online.target
Wants=network-online.target

[Service]
User=eth
ExecStart=/usr/bin/geth --hoodi --datadir /data/geth --syncmode snap \
  --authrpc.addr 127.0.0.1 --authrpc.port 8551 --authrpc.jwtsecret /etc/eth/jwt-geth.hex \
  --http --http.addr 127.0.0.1 --http.port 8545 --http.api eth,net,web3,admin,debug \
  --port 30303
Restart=on-failure
RestartSec=10
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
