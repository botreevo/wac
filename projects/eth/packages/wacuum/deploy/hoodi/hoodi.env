# What wacuum-hoodi runs with (deploy/hoodi/run-wacuum.sh reads it). Kept across reinstalls; edit, then
# systemctl restart wacuum-hoodi.

# The V8 heap: half of a 16 GB machine. wacuum's own bounds sit well inside it — the store's cache below, 64 MB of
# its leaves, its interior (some hundreds of MB at Hoodi's size), and the history it holds.
WAC_MAX_HEAP=8g
# The store's cache of entries, in MB (docs/state-cache.md).
CACHE_MB=2048
# Finalized blocks whose headers, bodies and receipts are held in memory; older ones are read from the store.
HISTORY=8192
# The checkpoint both Lighthouses start from. Check it on the day: https://eth-clients.github.io/checkpoint-sync-endpoints/
CHECKPOINT_URL=https://checkpoint-sync.hoodi.ethpandaops.io

# The box's public address, which wacuum advertises for peers to dial back (port 30304, tcp and udp, open inbound);
# and how many peers it keeps. Without PUBLIC_IP it advertises 127.0.0.1 and only its own dials connect.
PUBLIC_IP=
MAX_PEERS=25

# The driver mode (wacuum-driver-hoodi, instead of lighthouse-wacuum: one or the other drives wacuum, never both).
# The beacon nodes it reads, comma-separated, tried in turn: the reference Lighthouse here first, then public ones.
# Each is trusted for nothing — every update is checked by signature and branch, every block by its proven hash.
BEACON_URL=http://127.0.0.1:5052,https://ethereum-hoodi-beacon-api.publicnode.com,https://lodestar-hoodi.chainsafe.io
# The beacon block root the driver trusts at its first start. Empty: the finalized root CHECKPOINT_URL names — the
# same trust Lighthouse's checkpoint sync places in it. Later starts use the finalized root the driver kept.
CHECKPOINT=
