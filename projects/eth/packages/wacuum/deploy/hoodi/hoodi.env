# What wacuum-hoodi runs with (deploy/hoodi/run-wacuum.sh reads it). Kept across reinstalls; edit, then
# systemctl restart wacuum-hoodi.

# The V8 heap: half of a 16 GB machine. wacuum's own bounds sit well inside it — the store's cache below, 64 MB of
# its leaves, its interior (some hundreds of MB at Hoodi's size), and the history it holds.
WAC_MAX_HEAP=8g
# The store's cache of entries, in MB (docs/state-cache.md).
CACHE_MB=2048
# Finalized blocks whose headers, bodies and receipts are held in memory; older ones are read from the store.
HISTORY=8192
# The checkpoint both Lighthouses start from. Check it on the day: https://eth-clients.github.io/checkpoint-sync-endpoints/
CHECKPOINT_URL=https://checkpoint-sync.hoodi.ethpandaops.io
