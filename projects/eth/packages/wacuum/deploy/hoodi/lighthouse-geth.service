[Unit]
Description=Lighthouse on Hoodi, checkpoint-synced, driving geth
After=network-online.target geth-hoodi.service
Wants=network-online.target

[Service]
User=eth
EnvironmentFile=/etc/eth/hoodi.env
ExecStart=/usr/local/bin/lighthouse bn --network hoodi --datadir /data/lighthouse-geth \
  --execution-endpoint http://127.0.0.1:8551 --execution-jwt /etc/eth/jwt-geth.hex \
  --checkpoint-sync-url ${CHECKPOINT_URL} --http --http-address 127.0.0.1 --http-port 5052 --port 9000 --quic-port 9001
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
