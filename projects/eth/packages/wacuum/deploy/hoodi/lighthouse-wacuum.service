[Unit]
Description=Lighthouse on Hoodi, checkpoint-synced, driving wacuum
After=network-online.target wacuum-hoodi.service
Wants=network-online.target
# One consensus side drives wacuum at a time.
Conflicts=wacuum-driver-hoodi.service

[Service]
User=eth
EnvironmentFile=/etc/eth/hoodi.env
ExecStart=/usr/local/bin/lighthouse bn --network hoodi --datadir /data/lighthouse-wacuum \
  --execution-endpoint http://127.0.0.1:8552 --execution-jwt /etc/eth/jwt-wacuum.hex \
  --checkpoint-sync-url ${CHECKPOINT_URL} --http --http-address 127.0.0.1 --http-port 5053 --port 9002 --quic-port 9003
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
