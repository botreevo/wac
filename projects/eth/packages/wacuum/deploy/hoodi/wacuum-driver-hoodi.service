[Unit]
Description=The light-client driver on Hoodi: wacuum driven by Ethereum's light-client protocol (docs/hoodi.md)
After=network-online.target wacuum-hoodi.service
Wants=network-online.target
# One consensus side drives wacuum at a time.
Conflicts=lighthouse-wacuum.service

[Service]
User=wacuum
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh /opt/wac-eth/packages/wacuum/deploy/hoodi/run-driver.sh
Restart=always
RestartSec=10
MemoryMax=1G

[Install]
WantedBy=multi-user.target
