[Unit]
Description=wacuum on Hoodi as Prometheus metrics (wacuum_*, and driver_* in the driver mode), for node_exporter

[Service]
Type=oneshot
User=wacuum
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/wac-eth/packages/wacuum/dist/allwac /data/wacuum/driver-status.json http://127.0.0.1:8552 /etc/eth/jwt-wacuum.hex --prom /var/lib/prometheus/node-exporter/wacuum_hoodi.prom
