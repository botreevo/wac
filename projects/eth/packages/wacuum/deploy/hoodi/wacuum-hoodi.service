[Unit]
Description=wacuum on Hoodi: its own state on its store, snap-synced in, driven by lighthouse-wacuum
After=network-online.target geth-hoodi.service
Wants=network-online.target

[Service]
User=wacuum
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh /opt/wac-eth/packages/wacuum/deploy/hoodi/run-wacuum.sh
Restart=always
RestartSec=10
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
