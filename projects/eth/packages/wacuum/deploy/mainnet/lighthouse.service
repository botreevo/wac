[Unit]
Description=Lighthouse beacon node, checkpoint-synced, driving reth
After=network-online.target reth.service
Wants=network-online.target

[Service]
User=eth
ExecStart=/usr/local/bin/lighthouse bn --network mainnet --datadir /data/lighthouse \
  --execution-endpoint http://127.0.0.1:8551 --execution-jwt /etc/eth/jwt.hex \
  --checkpoint-sync-url https://mainnet.checkpoint.sigp.io --http --http-address 127.0.0.1 --port 9000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
