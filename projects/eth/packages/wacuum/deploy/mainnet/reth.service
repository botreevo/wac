[Unit]
Description=reth, the reference execution client the wacuum shadow replays against
After=network-online.target
Wants=network-online.target

[Service]
User=eth
ExecStart=/usr/local/bin/reth node --chain mainnet --datadir /data/reth \
  --authrpc.addr 127.0.0.1 --authrpc.port 8551 --authrpc.jwtsecret /etc/eth/jwt.hex \
  --http --http.addr 127.0.0.1 --http.port 8545 --http.api eth,net,web3,debug \
  --port 30303 --full
Restart=on-failure
RestartSec=10
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
