[Unit]
Description=The all-wac mode's status as Prometheus metrics (driver_*, wacuum_*), for node_exporter's textfile collector

[Service]
Type=oneshot
User=wacuum
WorkingDirectory=/opt/wac-eth/packages/wacuum
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/wac-eth/packages/wacuum/dist/allwac /data/wacuum/driver-status.json http://127.0.0.1:8551 /etc/eth/jwt-wacuum.hex --prom /var/lib/prometheus/node-exporter/wacuum_allwac.prom
