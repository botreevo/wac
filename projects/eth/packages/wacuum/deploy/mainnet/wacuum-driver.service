[Unit]
Description=The light-client driver: wacuum driven by Ethereum's light-client protocol, no consensus client (docs/mainnet.md)
After=network-online.target wacuum-mainnet.service
Wants=network-online.target

[Service]
User=wacuum
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh /opt/wac-eth/packages/wacuum/deploy/mainnet/run-driver.sh
Restart=always
RestartSec=10
# Measured at ~155 MB resident on mainnet; the bound only keeps a fault from reaching wacuum's memory.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
