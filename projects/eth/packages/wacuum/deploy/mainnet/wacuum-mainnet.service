[Unit]
Description=wacuum on mainnet, on its store, snap-synced in, driven by the light-client driver (docs/mainnet.md)
After=network-online.target
Wants=network-online.target

[Service]
User=wacuum
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh /opt/wac-eth/packages/wacuum/deploy/mainnet/run-wacuum-mainnet.sh
Restart=always
RestartSec=10
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
