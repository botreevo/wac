# The shadow's log, one line a block (~7 200 a day): a new one each week, half a year kept. copytruncate because
# follow.sh appends with a fresh open each line; it resumes from the log's last line only when it starts.
/data/wacuum/follow.log {
  weekly
  rotate 26
  compress
  delaycompress
  missingok
  notifempty
  copytruncate
}
