[Unit]
Description=wacuum shadowing mainnet: every new block replayed against reth's state and checked
After=reth.service
Wants=reth.service

[Service]
User=wacuum
WorkingDirectory=/opt/wac-eth/packages/wacuum
Environment=WACUUM_RPC=http://127.0.0.1:8545
Environment=WACUUM_PRESTATE=1
# The log is the shadow's whole output: one line a block, on the data disk. A block that differed keeps
# its answers under scratch/follow/ in the working directory, for replaying by hand.
ExecStart=/bin/sh tools/mainnet/follow.sh /data/wacuum/follow.log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
