[Unit]
Description=wacuum shadowing mainnet: every new block replayed against reth's state and checked
After=reth.service
Wants=reth.service

[Service]
User=wacuum
WorkingDirectory=/opt/wac-eth/packages/wacuum
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=WACUUM_RPC=http://127.0.0.1:8545
Environment=WACUUM_PRESTATE=1
# A block that differed keeps every answer here, on the data disk, for replaying by hand.
Environment=WACUUM_KEEP=/data/wacuum/differs
# The log is the shadow's whole output: one line a block, on the data disk (rotated weekly by logrotate).
ExecStart=/bin/sh tools/mainnet/follow.sh /data/wacuum/follow.log
Restart=always
RestartSec=10
# One block's replay at a time; a bound so that a runaway never takes reth's memory from it.
MemoryMax=8G
Nice=5

[Install]
WantedBy=multi-user.target
