[Unit]
Description=The mainnet shadow's status as Prometheus metrics (wacuum_shadow_*), for node_exporter's textfile collector

[Service]
Type=oneshot
User=wacuum
WorkingDirectory=/opt/wac-eth/packages/wacuum
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=WACUUM_RPC=http://127.0.0.1:8545
ExecStart=/bin/sh tools/mainnet/status.sh /data/wacuum/follow.log /var/lib/prometheus/node-exporter/wacuum_shadow.prom
