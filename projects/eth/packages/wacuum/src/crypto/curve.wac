// Points on y^2 = x^3 + b over a prime field, in Jacobian coordinates: (X, Y, Z) is the affine point
// (X/Z^2, Y/Z^3), and Z = 0 is the point at infinity. secp256k1 (b = 7) and bn254's G1 (b = 3) are both
// this shape, so ecrecover and the bn254 precompiles share it.
//
// The formulas are the Explicit-Formulas Database's: dbl-2009-l for a = 0, dbl-2001-b for a = −3 (P-256,
// y^2 = x^3 − 3x + b), and add-2007-bl, which does not depend on a.

import { U256 } from "../u256.wac";
import { Field } from "./field.wac";

export struct Jac {
  u64[] x;
  u64[] y;
  u64[] z;
}

export struct Curve {
  Field f;
  /** b, in Montgomery form. */
  u64[] b;
  /** Whether a is −3 rather than 0. */
  bool aMinus3;
  /** Scratch for `doubleTo` and `addTo`, made once: fourteen field elements, the last always zero. */
  u64[][] t;

  Curve create(Field f, U256 b) { return Curve(f, f.fromU256(b), false, scratch()); }

  /** y^2 = x^3 − 3x + b. */
  Curve createAMinus3(Field f, U256 b) { return Curve(f, f.fromU256(b), true, scratch()); }

  /** A point at infinity of its own, to be changed in place: `infinity` shares the field's one. */
  Jac freshInfinity(this) { return Jac(copyOf(this.f.one()), copyOf(this.f.one()), this.f.zero()); }

  /**
   * r = 2r, in place: `double`'s formulas with every intermediate in the curve's scratch, so a run of
   * doublings allocates nothing. The hot loops of the scalar multiplications are made of this and `addTo`.
   */
  void doubleTo(this, Jac r) {
    Field f = this.f;
    u64[][] t = this.t;
    if (f.isZero(r.z) || f.isZero(r.y)) {
      setInfinity(f, r);
      return;
    }
    if (this.aMinus3) {
      // dbl-2001-b.
      f.sqrTo(t[0], r.z);                 // delta
      f.sqrTo(t[1], r.y);                 // gamma
      f.mulTo(t[2], r.x, t[1]);           // beta
      f.subTo(t[3], r.x, t[0]);
      f.addTo(t[4], r.x, t[0]);
      f.mulTo(t[3], t[3], t[4]);
      f.addTo(t[4], t[3], t[3]);
      f.addTo(t[4], t[4], t[3]);          // alpha = 3(x − delta)(x + delta)
      f.addTo(t[5], t[2], t[2]);
      f.addTo(t[5], t[5], t[5]);          // 4 beta
      f.addTo(t[6], r.y, r.z);
      f.sqrTo(t[6], t[6]);
      f.subTo(t[6], t[6], t[1]);
      f.subTo(r.z, t[6], t[0]);           // z3 = (y + z)^2 − gamma − delta
      f.addTo(t[7], t[5], t[5]);
      f.sqrTo(t[8], t[4]);
      f.subTo(r.x, t[8], t[7]);           // x3 = alpha^2 − 8 beta
      f.subTo(t[8], t[5], r.x);
      f.mulTo(t[8], t[4], t[8]);
      f.sqrTo(t[9], t[1]);
      f.addTo(t[9], t[9], t[9]);
      f.addTo(t[9], t[9], t[9]);
      f.addTo(t[9], t[9], t[9]);
      f.subTo(r.y, t[8], t[9]);           // y3 = alpha(4 beta − x3) − 8 gamma^2
      return;
    }
    // dbl-2009-l.
    f.sqrTo(t[0], r.x);                   // A
    f.sqrTo(t[1], r.y);                   // B
    f.sqrTo(t[2], t[1]);                  // C
    f.addTo(t[3], r.x, t[1]);
    f.sqrTo(t[3], t[3]);
    f.subTo(t[3], t[3], t[0]);
    f.subTo(t[3], t[3], t[2]);
    f.addTo(t[3], t[3], t[3]);            // D
    f.addTo(t[4], t[0], t[0]);
    f.addTo(t[4], t[4], t[0]);            // E = 3A
    f.sqrTo(t[5], t[4]);                  // F
    f.mulTo(r.z, r.y, r.z);
    f.addTo(r.z, r.z, r.z);               // z3 = 2yz
    f.addTo(t[6], t[3], t[3]);
    f.subTo(r.x, t[5], t[6]);             // x3 = F − 2D
    f.subTo(t[6], t[3], r.x);
    f.mulTo(t[6], t[4], t[6]);
    f.addTo(t[7], t[2], t[2]);
    f.addTo(t[7], t[7], t[7]);
    f.addTo(t[7], t[7], t[7]);
    f.subTo(r.y, t[6], t[7]);             // y3 = E(D − x3) − 8C
  }

  /** r = r + q, or r − q when `negQ`, in place, by add-2007-bl as `add`; q is only read. */
  void addTo(this, Jac r, Jac q, bool negQ) {
    Field f = this.f;
    u64[][] t = this.t;
    if (f.isZero(q.z)) { return; }
    if (f.isZero(r.z)) {
      copyInto(r.x, q.x);
      if (negQ) { f.subTo(r.y, t[13], q.y); } else { copyInto(r.y, q.y); }
      copyInto(r.z, q.z);
      return;
    }
    f.sqrTo(t[0], r.z);                   // Z1Z1
    f.sqrTo(t[1], q.z);                   // Z2Z2
    f.mulTo(t[2], r.x, t[1]);             // U1
    f.mulTo(t[3], q.x, t[0]);             // U2
    f.mulTo(t[4], r.y, q.z);
    f.mulTo(t[4], t[4], t[1]);            // S1
    f.mulTo(t[5], q.y, r.z);
    f.mulTo(t[5], t[5], t[0]);            // S2
    if (negQ) { f.subTo(t[5], t[13], t[5]); }
    f.subTo(t[6], t[3], t[2]);            // H
    f.subTo(t[7], t[5], t[4]);
    f.addTo(t[7], t[7], t[7]);            // r
    if (f.isZero(t[6])) {
      if (f.isZero(t[7])) { this.doubleTo(r); } else { setInfinity(f, r); }
      return;
    }
    f.addTo(t[8], t[6], t[6]);
    f.sqrTo(t[8], t[8]);                  // I
    f.mulTo(t[9], t[6], t[8]);            // J
    f.mulTo(t[10], t[2], t[8]);           // V
    f.addTo(t[2], r.z, q.z);
    f.sqrTo(t[2], t[2]);
    f.subTo(t[2], t[2], t[0]);
    f.subTo(t[2], t[2], t[1]);
    f.mulTo(r.z, t[2], t[6]);             // z3 = ((Z1 + Z2)^2 − Z1Z1 − Z2Z2) H
    f.sqrTo(t[11], t[7]);
    f.subTo(t[11], t[11], t[9]);
    f.subTo(t[11], t[11], t[10]);
    f.subTo(r.x, t[11], t[10]);           // x3 = r^2 − J − 2V
    f.subTo(t[12], t[10], r.x);
    f.mulTo(t[12], t[7], t[12]);
    f.mulTo(t[4], t[4], t[9]);
    f.addTo(t[4], t[4], t[4]);
    f.subTo(r.y, t[12], t[4]);            // y3 = r(V − x3) − 2 S1 J
  }

  Jac infinity(this) { return Jac(this.f.one(), this.f.one(), this.f.zero()); }
  bool isInfinity(this, Jac p) { return this.f.isZero(p.z); }

  /** An affine point given as plain integers. The caller has checked it is on the curve. */
  Jac fromAffine(this, U256 x, U256 y) { return Jac(this.f.fromU256(x), this.f.fromU256(y), this.f.one()); }

  /** Whether plain (x, y) satisfies the curve equation; both must already be below p. */
  bool onCurve(this, U256 x, U256 y) {
    Field f = this.f;
    u64[] xm = f.fromU256(x);
    u64[] ym = f.fromU256(y);
    u64[] rhs = f.add(f.mul(f.square(xm), xm), this.b);
    if (this.aMinus3) { rhs = f.sub(rhs, f.add(f.double(xm), xm)); }
    return f.eq(f.square(ym), rhs);
  }

  Jac double(this, Jac p) {
    Field f = this.f;
    if (f.isZero(p.z) || f.isZero(p.y)) { return this.infinity(); }
    if (this.aMinus3) {
      // dbl-2001-b: 3M + 5S.
      u64[] delta = f.square(p.z);
      u64[] gamma = f.square(p.y);
      u64[] beta = f.mul(p.x, gamma);
      u64[] t = f.mul(f.sub(p.x, delta), f.add(p.x, delta));
      u64[] alpha = f.add(f.double(t), t);
      u64[] beta4 = f.double(f.double(beta));
      u64[] x3 = f.sub(f.square(alpha), f.double(beta4));
      u64[] z3 = f.sub(f.sub(f.square(f.add(p.y, p.z)), gamma), delta);
      u64[] g2 = f.square(gamma);
      u64[] y3 = f.sub(f.mul(alpha, f.sub(beta4, x3)), f.double(f.double(f.double(g2))));
      return Jac(x3, y3, z3);
    }
    u64[] a = f.square(p.x);
    u64[] bb = f.square(p.y);
    u64[] c = f.square(bb);
    u64[] d = f.double(f.sub(f.sub(f.square(f.add(p.x, bb)), a), c));
    u64[] e = f.add(f.double(a), a);
    u64[] ff = f.square(e);
    u64[] x3 = f.sub(ff, f.double(d));
    u64[] c8 = f.double(f.double(f.double(c)));
    u64[] y3 = f.sub(f.mul(e, f.sub(d, x3)), c8);
    u64[] z3 = f.double(f.mul(p.y, p.z));
    return Jac(x3, y3, z3);
  }

  Jac add(this, Jac p, Jac q) {
    Field f = this.f;
    if (f.isZero(p.z)) { return q; }
    if (f.isZero(q.z)) { return p; }
    u64[] z1z1 = f.square(p.z);
    u64[] z2z2 = f.square(q.z);
    u64[] u1 = f.mul(p.x, z2z2);
    u64[] u2 = f.mul(q.x, z1z1);
    u64[] s1 = f.mul(f.mul(p.y, q.z), z2z2);
    u64[] s2 = f.mul(f.mul(q.y, p.z), z1z1);
    u64[] h = f.sub(u2, u1);
    u64[] r = f.double(f.sub(s2, s1));
    if (f.isZero(h)) {
      return f.isZero(r) ? this.double(p) : this.infinity();
    }
    u64[] i = f.square(f.double(h));
    u64[] j = f.mul(h, i);
    u64[] v = f.mul(u1, i);
    u64[] x3 = f.sub(f.sub(f.square(r), j), f.double(v));
    u64[] y3 = f.sub(f.mul(r, f.sub(v, x3)), f.double(f.mul(s1, j)));
    u64[] z3 = f.mul(f.sub(f.sub(f.square(f.add(p.z, q.z)), z1z1), z2z2), h);
    return Jac(x3, y3, z3);
  }

  Jac neg(this, Jac p) { return Jac(p.x, this.f.neg(p.y), p.z); }

  /** k * p, double and add from the top bit. */
  Jac mul(this, Jac p, U256 k) {
    Jac r = this.infinity();
    for (i32 i = 255; i >= 0; i--) {
      r = this.double(r);
      if (k.bit(i)) { r = this.add(r, p); }
    }
    return r;
  }

  /**
   * a·p + b·q in one pass (Shamir's trick): 256 doublings shared by both, and at each bit p, q or p + q
   * added — about half the work of two multiplications and an addition, which is what ecrecover does.
   */
  Jac mul2(this, Jac p, U256 a, Jac q, U256 b) {
    Jac pq = this.add(p, q);
    Jac r = this.infinity();
    for (i32 i = 255; i >= 0; i--) {
      r = this.double(r);
      bool x = a.bit(i);
      bool y = b.bit(i);
      if (x && y) { r = this.add(r, pq); }
      else if (x) { r = this.add(r, p); }
      else if (y) { r = this.add(r, q); }
    }
    return r;
  }

  /** P, 3P, 5P, … 15P: the table a width-5 NAF digit indexes, by (|d| − 1) / 2. */
  Jac[] oddMultiples(this, Jac p) {
    Jac[] t = Jac[].filled(8, p);
    Jac twice = this.double(p);
    for (i32 i = 1; i < 8; i++) { t[i] = this.add(t[i - 1], twice); }
    return t;
  }

  /** The affine coordinates as plain integers; the point must not be at infinity. */
  U256[] toAffine(this, Jac p) {
    Field f = this.f;
    u64[] zi = f.inv(p.z);
    u64[] zi2 = f.square(zi);
    U256 x = f.toU256(f.mul(p.x, zi2));
    U256 y = f.toU256(f.mul(p.y, f.mul(zi2, zi)));
    return [x, y];
  }
}

/**
 * k's width-5 NAF, least significant digit first: each digit 0 or odd in (−16, 16). On k's words in locals,
 * with a fifth for the carry an upward correction can make: a U256 a bit was a twentieth of a recovery.
 */
export i32[] wnaf(U256 k) {
  i32[] out = i32[].filled(k.isZero() ? 0 : 258 - k.leadingZeros(), 0);
  u64 w0 = k.word(0);
  u64 w1 = k.word(1);
  u64 w2 = k.word(2);
  u64 w3 = k.word(3);
  u64 w4 = 0;
  i32 i = 0;
  while ((w0 | w1 | w2 | w3 | w4) != 0) {
    if ((w0 & 1) == 1) {
      i32 d = (w0 & 31) as! i32;
      if (d >= 16) {
        // Digit d − 32: the value goes up by 32 − d, carrying as far as it must.
        d -= 32;
        u64 before = w0;
        w0 = w0 + ((0 - d) as! u64);
        if (w0 < before) {
          w1 = w1 + 1;
          if (w1 == 0) {
            w2 = w2 + 1;
            if (w2 == 0) {
              w3 = w3 + 1;
              if (w3 == 0) { w4 = w4 + 1; }
            }
          }
        }
      } else {
        // Digit d: the low five bits are d, so taking it away borrows nothing.
        w0 = w0 - (d as! u64);
      }
      out[i] = d;
    }
    w0 = (w0 >> 1) | (w1 << 63);
    w1 = (w1 >> 1) | (w2 << 63);
    w2 = (w2 >> 1) | (w3 << 63);
    w3 = (w3 >> 1) | (w4 << 63);
    w4 = w4 >> 1;
    i++;
  }
  return out;
}

u64[][] scratch() {
  u64[][] t = u64[][].filled(14, u64[].filled(0, 0));
  for (i32 i = 0; i < 14; i++) { t[i] = u64[].filled(8, 0); }
  return t;
}

u64[] copyOf(u64[] a) {
  u64[] out = u64[].filled(a.len(), 0);
  for (i32 i = 0; i < a.len(); i++) { out[i] = a[i]; }
  return out;
}

void copyInto(u64[] out, u64[] a) {
  for (i32 i = 0; i < 8; i++) { out[i] = a[i]; }
}

void setInfinity(Field f, Jac r) {
  copyInto(r.x, f.one());
  copyInto(r.y, f.one());
  for (i32 i = 0; i < 8; i++) { r.z[i] = 0; }
}
