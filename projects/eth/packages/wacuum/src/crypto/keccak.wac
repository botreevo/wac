// keccak256, with wac's permutation: the absorbing done a lane at a time.
//
// wac's `crypto.keccak256` absorbs a byte at a time — a division, a remainder and a variable shift for each of a
// block's 136 bytes — which on the Node host cost as much as the permutation itself. Ethereum hashes mostly
// short inputs (a storage key's 64 bytes, a log topic, a trie node), where that is most of the work. Here
// each lane is one eight-byte little-endian read, the padding goes straight into its lanes, and the digest
// is four lanes written out. `keccakF`, the permutation, is wac's. Filed for wac as `issues/system/0377w`.

import { crypto.keccakF } from "wac";

/** The eight bytes from `off`, little-endian: one lane. */
u64 lane(const u8[] b, i32 off) {
  return (b[off] as u64) | ((b[off + 1] as u64) << 8) | ((b[off + 2] as u64) << 16) | ((b[off + 3] as u64) << 24) |
         ((b[off + 4] as u64) << 32) | ((b[off + 5] as u64) << 40) | ((b[off + 6] as u64) << 48) | ((b[off + 7] as u64) << 56);
}

export u8[] keccak256(const u8[] msg) {
  u64[] s = u64[].filled(25, 0);
  i32 at = 0;
  i32 n = msg.len();
  // Whole 136-byte blocks: seventeen lanes each.
  while (n - at >= 136) {
    s[0] = s[0] ^ lane(msg, at + 0);
    s[1] = s[1] ^ lane(msg, at + 8);
    s[2] = s[2] ^ lane(msg, at + 16);
    s[3] = s[3] ^ lane(msg, at + 24);
    s[4] = s[4] ^ lane(msg, at + 32);
    s[5] = s[5] ^ lane(msg, at + 40);
    s[6] = s[6] ^ lane(msg, at + 48);
    s[7] = s[7] ^ lane(msg, at + 56);
    s[8] = s[8] ^ lane(msg, at + 64);
    s[9] = s[9] ^ lane(msg, at + 72);
    s[10] = s[10] ^ lane(msg, at + 80);
    s[11] = s[11] ^ lane(msg, at + 88);
    s[12] = s[12] ^ lane(msg, at + 96);
    s[13] = s[13] ^ lane(msg, at + 104);
    s[14] = s[14] ^ lane(msg, at + 112);
    s[15] = s[15] ^ lane(msg, at + 120);
    s[16] = s[16] ^ lane(msg, at + 128);
    keccakF(s);
    at += 136;
  }
  // The rest: whole lanes, then the bytes of the last, then the padding — 0x01 after the message and 0x80 in
  // the block's last byte, which share a byte when the message leaves exactly one.
  i32 rest = n - at;
  i32 full = rest / 8;
  for (i32 l = 0; l < full; l++) { s[l] = s[l] ^ lane(msg, at + 8 * l); }
  u64 last = 0;
  for (i32 k = 0; k < rest - 8 * full; k++) { last = last | ((msg[at + 8 * full + k] as u64) << (8 * k)); }
  last = last | ((1 as u64) << (8 * (rest - 8 * full)));
  s[full] = s[full] ^ last;
  s[16] = s[16] ^ 0x8000000000000000;
  keccakF(s);
  u8[] out = u8[].filled(32, 0);
  out[0] = (s[0] >> 0) as@ u8;
  out[1] = (s[0] >> 8) as@ u8;
  out[2] = (s[0] >> 16) as@ u8;
  out[3] = (s[0] >> 24) as@ u8;
  out[4] = (s[0] >> 32) as@ u8;
  out[5] = (s[0] >> 40) as@ u8;
  out[6] = (s[0] >> 48) as@ u8;
  out[7] = (s[0] >> 56) as@ u8;
  out[8] = (s[1] >> 0) as@ u8;
  out[9] = (s[1] >> 8) as@ u8;
  out[10] = (s[1] >> 16) as@ u8;
  out[11] = (s[1] >> 24) as@ u8;
  out[12] = (s[1] >> 32) as@ u8;
  out[13] = (s[1] >> 40) as@ u8;
  out[14] = (s[1] >> 48) as@ u8;
  out[15] = (s[1] >> 56) as@ u8;
  out[16] = (s[2] >> 0) as@ u8;
  out[17] = (s[2] >> 8) as@ u8;
  out[18] = (s[2] >> 16) as@ u8;
  out[19] = (s[2] >> 24) as@ u8;
  out[20] = (s[2] >> 32) as@ u8;
  out[21] = (s[2] >> 40) as@ u8;
  out[22] = (s[2] >> 48) as@ u8;
  out[23] = (s[2] >> 56) as@ u8;
  out[24] = (s[3] >> 0) as@ u8;
  out[25] = (s[3] >> 8) as@ u8;
  out[26] = (s[3] >> 16) as@ u8;
  out[27] = (s[3] >> 24) as@ u8;
  out[28] = (s[3] >> 32) as@ u8;
  out[29] = (s[3] >> 40) as@ u8;
  out[30] = (s[3] >> 48) as@ u8;
  out[31] = (s[3] >> 56) as@ u8;
  return out;
}
