// A beacon node's REST API, as the light-client driver reads it: light-client data as SSZ (believed only as far as the
// light client verifies it) and blocks as JSON (believed only as far as their execution block hashes chain to one the
// light client proved — `payload.wac`). The node is a source of bytes, nothing more.

import { Sys } from "std";
import { Result, Vec } from "core";
import { fetch.fetchWithinAsync, fetch.Caps, fetch.Fetched } from "wac";
import { json.parse, json.JsonValue } from "wac";

export struct Beacon {
  Sys sys;
  /**
   * Beacon nodes' base URLs, no trailing slash: `https://…` or `http://127.0.0.1:5052`. Several, comma-separated in
   * `at`, are tried in turn when one fails: each is trusted for nothing, so any that answers will do, and a public node
   * that rate-limits or goes away stops nothing.
   */
  string[] urls;
  /** The one that last answered, tried first. */
  i32 current;
  i32 timeoutMs;

  Beacon at(Sys sys, string urls) {
    Vec<string> us = Vec.create();
    string rest = urls;
    while (rest != "") {
      i32 comma = rest.indexOf(",");
      string u = comma < 0 ? rest : rest.slice(0, comma);
      rest = comma < 0 ? "" : rest.slice(comma + 1, rest.len());
      if (u != "") { us.push(u); }
    }
    return Beacon(sys, us.toArray(), 0, 30000);
  }

  /** The node in use, for the log. */
  string url(this) { return this.urls.len() == 0 ? "" : this.urls[this.current]; }

  /**
   * GET, asked again after a pause when the node says it is rate-limiting (429) or busy (503) — a public node does
   * both — up to four times, 2, 4 and 8 s apart.
   */
  async Result<Fetched, string> get(this, string path, string accept) {
    string why = "no beacon node given";
    for (i32 k = 0; k < this.urls.len(); k++) {
      i32 i = (this.current + k) % this.urls.len();
      auto r = await this.getFrom(this.urls[i], path, accept);
      if (r.isOk()) {
        if (i != this.current) { this.sys.log("driver: beacon node \{this.urls[i]} answers; \{this.urls[this.current]} did not"); }
        this.current = i;
        return r;
      }
      why = r.err()!;
      // A 404 is the node's answer about this path (a block it does not have), not about the node: the next is
      // asked too, since another may have it.
    }
    return Result.Err(why);
  }

  async Result<Fetched, string> getFrom(this, string base, string path, string accept) {
    Caps caps = Caps(this.sys.clock(), this.sys.random(), this.sys.env(), this.sys.net(), this.sys.files());
    for (i32 attempt = 0; true; attempt++) {
      auto r = await fetchWithinAsync(caps, "GET", base + path, ["Accept: " + accept], u8[].filled(0, 0), this.timeoutMs);
      if (r.isErr()) { return Result.Err("\{path}: \{r.err()!}"); }
      Fetched f = r.unwrap();
      if ((f.status == 429 || f.status == 503) && attempt < 3) {
        await this.sys.sleepMillis(2000 << attempt);
        continue;
      }
      if (f.status != 200) { return Result.Err("\{path}: HTTP \{f.status}: \{string.fromBytes(cut(f.body, 200))}"); }
      return Result.Ok(f);
    }
    return Result.Err("\{path}: unreachable");
  }

  /** SSZ bytes, and the fork the node says they are laid out in (its `Eth-Consensus-Version`). */
  async Result<Ssz, string> ssz(this, string path) {
    auto r = await this.get(path, "application/octet-stream");
    if (r.isErr()) { return Result.Err(r.err()!); }
    Fetched f = r.unwrap();
    return Result.Ok(Ssz(f.body, string.fromBytes(f.headers.first("eth-consensus-version"))));
  }

  /** A JSON answer's `data`. */
  async Result<JsonValue, string> json(this, string path) {
    auto r = await this.get(path, "application/json");
    if (r.isErr()) { return Result.Err(r.err()!); }
    match (parse(r.unwrap().body)) {
      Err(e): { return Result.Err("\{path}: not JSON"); }
      Ok(v): {
        JsonValue? d = v.member("data");
        if (d is null) { return Result.Err("\{path}: no data"); }
        return Result.Ok(d!);
      }
    }
  }
}

export struct Ssz {
  u8[] bytes;
  /** `Eth-Consensus-Version`: `fulu`, `electra`, …; "" if the node did not say. */
  string fork;
}

u8[] cut(u8[] b, i32 n) {
  i32 m = b.len() < n ? b.len() : n;
  u8[] out = u8[].filled(m, 0);
  for (i32 i = 0; i < m; i++) { out[i] = b[i]; }
  return out;
}
