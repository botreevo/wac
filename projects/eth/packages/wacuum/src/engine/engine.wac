// The Engine API: how a consensus client drives an execution client. It hands over blocks as execution
// payloads (`engine_newPayloadV*`) and says which one is the head (`engine_forkchoiceUpdatedV*`), and
// this answers whether each payload is VALID, INVALID, or cannot be judged yet because its parent is
// unknown (SYNCING).
//
// This layer takes a method name and JSON params and gives back a JSON result or a JSON-RPC error. It
// knows nothing of HTTP or of the JWT that authenticates a caller — `server.wac` wraps it in those — so
// execution-spec-tests' engine fixtures can call it directly.
//
// ## From payload to block
//
// A payload is a block with its header flattened into fields and its transactions as opaque bytes. Two
// header fields are not sent at all and are derived: the transactions root and the withdrawals root, and
// from Prague the requests hash, from the execution requests sent beside the payload. The block hash the
// consensus client sends must equal the hash of the header rebuilt that way, which is what makes the
// payload's own fields binding.

import { Map, Vec } from "core";
import { crypto.sha256 } from "wac";
import { keccak256 } from "../crypto/keccak.wac";
import { json.JsonValue, json.JsonObject, json.JsonArray, json.stringify } from "wac";
import { rlp.Item, rlp.encode, rlp.decode, rlp.Decoded, rlp.bytesOf, rlp.itemsOf, rlp.isList } from "@/lib.wac";
import { U256 } from "../u256.wac";
import { hexToBytes, bytesToHex } from "../hex.wac";
import { World, Account, ChangeSet, hashU256, eqU256 } from "../state/world.wac";
import { u256Bytes } from "../state/root.wac";
import { proofJson, proofFromStore } from "../state/proof.wac";
import { trieRoot } from "../trie/trie.wac";
import { addressBytes, Evm, BlockEnv, TxEnv, Message, processMessage } from "../evm/evm.wac";
import { Outcome } from "../evm/interp.wac";
import { OpTable } from "../evm/table.wac";
import { blobGasPrice } from "../tx/process.wac";
import { Spec, ChainConfig } from "../evm/spec.wac";
import { Header, Block, Withdrawal, Receipt, Body, timestampOf, headerOf, executeBlock, applyBlock, encodeBlock, decodeBlock, BlockDecode, blockTimestamp, headerItem, nextBaseFee, nextExcessBlobGas, EMPTY_OMMERS, requestsHashOf,
         indexedRoot } from "../chain/block.wac";
import { decodeTransaction, decodeWith, DecodedTx, SenderCache } from "../tx/decode.wac";
import { Attributes, Built, buildBlock } from "../chain/build.wac";
import { Sidecar, Unwrapped, unwrap, wrap, sidecarsFit, CELLS_PER_BLOB } from "./blobs.wac";
import { blockJson, txJson, receiptJson, logJson, firstLogIndex } from "./eth.wac";
import { Log } from "../state/world.wac";
import { StateDb, Staged } from "../store/state.wac";
import { executeFrom, Steps } from "../store/exec.wac";
import { receiptsChanges, receiptsOf, receiptsKey, joined } from "../store/receipts.wac";
import { blockKey, blockChanges, canonicalKey, txKey, txPlace, placeIndex } from "../store/blocks.wac";
import { Change } from "../store/tree.wac";
import { undoKey, undoFrom, undoChanges, decodeChangeSet } from "../store/undo.wac";
import { Transaction, AccessEntry, Authorization, processTransaction, Processed, intrinsicGas } from "../tx/process.wac";

/**
 * A block this client has executed, and what executing it changed: enough to move the one world there
 * from its parent and back. Null for the genesis, and for blocks at or below the finalized one, which no
 * fork choice can leave and so which the world never moves across again.
 */
struct Node {
  Header header;
  ChangeSet? changes;
}

/**
 * The undo records' bookkeeping (`store/undo.wac`): the number below which they have been deleted, a notice for
 * the node to log when finality stalls and the oldest are deleted anyway, and the bytes written, for measuring.
 */
struct Undo {
  u64 prunedTo;
  /** Undo records kept at most this many blocks below the head, finalized or not: a bound while finality stalls. */
  u64 limit;
  string notice;
  bool warned;
  i64 bytes;
  i64 stateBytes;

  Undo create() { return Undo(0, 1024, "", false, 0, 0); }
}

/** A payload `prepare` ran on the store: "" and committed, or why it is invalid. */
struct Prepared {
  string error;
  ChangeSet changes;
  Body body;
}

/** A call's method and parameters as one key. */
string answerKey(string method, JsonValue params) { return method + string.fromBytes(stringify(params)); }

i32 hashText(string s) {
  u8[] b = s.toBytes();
  i32 h = 0;
  for (i32 i = 0; i < b.len(); i++) { h = h * 31 + (b[i] as i32); }
  return h;
}

bool textEq(string a, string b) { return a == b; }

/** What a store's commit records beside the tree: the hash and number of the block whose state it holds. */
/** The first key after every key that starts with `p`. */
u8[] keyAfter(u8[] p) {
  u8[] out = u8[].filled(p.len() + 1, 0xff);
  out.copyFrom(p, 0, 0, p.len());
  return out;
}

u8[] storedAt(Header h) {
  u8[] out = u8[].filled(40, 0);
  out.copyFrom(h.hash.toBytes(), 0, 0, 32);
  out.copyFrom(U256.ofU64(h.number.low()).toBytes(), 24, 32, 8);
  return out;
}

/**
 * What the JSON-RPC methods report about a block: its transactions, withdrawals and receipts, and its
 * size. Kept for every canonical block, unlike its change set, and for unfinalized forks until finality
 * rules them out.
 */
struct Archived {
  Header header;
  Item[] txs;
  Withdrawal[] withdrawals;
  Receipt[] receipts;
  i32 size;
}

/** A block waiting for its parent, and the fork it runs under. */
struct Orphan {
  Spec spec;
  Block block;
}

/** On a store, what blocks leaving the history held in memory add to the next commit, and its lookups meanwhile. */
struct Persisting {
  Vec<u8[]> keys;
  Vec<u8[]> values;
  Map<U256, U256> canonical;
  Map<U256, TxAt> txs;

  Persisting create() { return Persisting(Vec.create(), Vec.create(), Map.create(hashU256, eqU256), Map.create(hashU256, eqU256)); }
}

/** Where a canonical transaction is. */
struct TxAt {
  U256 block;
  i32 index;
}

/** The log's two kinds of record, each `rlp([kind, ...])`: a block's RLP, and a fork choice's three hashes. */
static u8 RECORD_BLOCK = 1;
static u8 RECORD_CHOICE = 2;
/** The chain rebased onto a snap-synced block: its header and its 256 ancestors' (`rebase`). */
static u8 RECORD_BASE = 3;

/** What replaying a log came to: how many bytes of it were whole records, and how many blocks. */
export struct Replayed {
  i32 good;
  i32 blocks;
  string error;
}

/** A JSON-RPC answer: a result, or an error with its code, and the error's `data` when it has one ("" when not). */
export struct Answer {
  JsonValue? result;
  i32 code;
  string message;
  string data;

  Answer ok(JsonValue v) { return Answer(v, 0, "", ""); }
  Answer error(i32 code, string message) { return Answer(null, code, message, ""); }

  /**
   * A call that reverted, as geth answers it: code 3, "execution reverted" (with the reason when the data is a
   * Solidity `Error(string)`), and the revert data itself as the error's `data`, which is where wallets look for it.
   */
  Answer reverted(u8[] output) {
    string? why = revertReason(output);
    return Answer(null, 3, why is null ? "execution reverted" : "execution reverted: " + why!, bytesToHex(output));
  }
}

/** The reason in revert data that is `Error(string)`: selector 0x08c379a0, an offset of 32, a length, the bytes. */
export string? revertReason(u8[] d) {
  if (d.len() < 68 || d[0] != 0x08 || d[1] != 0xc3 || d[2] != 0x79 || d[3] != 0xa0) { return null; }
  for (i32 i = 4; i < 35; i++) { if (d[i] != 0) { return null; } }
  if (d[35] != 32) { return null; }
  for (i32 i = 36; i < 64; i++) { if (d[i] != 0) { return null; } }
  i64 n = ((d[64] as i64) << 24) | ((d[65] as i64) << 16) | ((d[66] as i64) << 8) | (d[67] as i64);
  if (n > ((d.len() - 68) as i64)) { return null; }
  u8[] text = u8[].filled(n as@ i32, 0);
  for (i32 i = 0; i < text.len(); i++) { text[i] = d[68 + i]; }
  return string.fromBytes(text);
}

export struct Engine {
  /** The chain's forks: each payload runs under the one its timestamp has reached. */
  ChainConfig config;
  U256 chainId;
  Map<U256, Node> blocks;
  /** Block number to hash along the canonical chain, for BLOCKHASH. */
  Map<U256, U256> canonical;
  U256 head;
  U256 safe;
  U256 finalized;
  /** Transactions sent with eth_sendRawTransaction, waiting for a block, in arrival order. */
  Vec<Item> mempool;
  /** Blocks built for a payload id, waiting for engine_getPayload. */
  Map<U256, Built> payloads;
  u64 nextPayloadId;
  /**
   * The state, at the block `at`. There is one, moved from block to block across their change sets, so
   * what the engine holds grows with what blocks change rather than with the state times the blocks.
   */
  World world;
  U256 at;
  /** The blobs of the blob transactions in the mempool, by versioned hash. */
  Map<U256, Sidecar> sidecars;
  /**
   * Whether a blob transaction may arrive without its blobs. Never for a node: a block it built from one
   * would have blobs nobody can publish. The fixtures' transactions are in block form, so their runners
   * set it, and their payloads' blobs bundles are then short of those blobs.
   */
  bool sidecarsOptional;
  Map<U256, Archived> archive;
  /** Transaction hash to where it is, for the canonical chain; a stale entry is checked away on lookup. */
  Map<U256, TxAt> txIndex;
  /**
   * A block the consensus client has named that this client does not have, to be fetched from peers; null
   * when there is none.
   */
  U256? syncTarget;
  /** Blocks sent with newPayload whose parent is still missing, by hash, to import once it arrives. */
  Map<U256, Orphan> orphans;
  /** Transactions the mempool took that peers have not been told of yet, in their block form. */
  Vec<u8[]> announce;
  /** The block a snapshot restored the world to, if one did, and its number. */
  U256? restoredAt;
  U256 restoredNumber;
  /** The number of the block the last snapshot was of, written or restored. */
  U256 snapshotNumber;
  /** Senders recovered so far, so that no transaction's signature is recovered twice. */
  SenderCache senders;
  /** What the blocks this engine builds say in their header's extra data. */
  u8[] extraData;
  /** The finalized block `forgetBelowFinalized` last pruned for. */
  U256 forgottenAt;
  /**
   * How many finalized blocks to keep for the eth_ methods and for peers, below the finalized one; 0 keeps
   * all of them. Each block's header and receipts are held in memory, so a node that runs for long, a
   * devnet making a block every few seconds say, grows by a few kilobytes a block without a bound.
   */
  u64 history;
  /** The lowest canonical block above the genesis that is still kept. */
  u64 keptFrom;
  /**
   * How many finalized canonical blocks below the finalized one keep their change sets, so that their state can be
   * reached for eth_getProof, eth_call and the rest; 0 keeps only the finalized block's. A `--dev` node finalizes
   * every block as it makes it, so with 0 a proof asked for the header just fetched is refused whenever a block
   * lands in between. Each kept change set is what that block wrote.
   */
  u64 states;
  /**
   * What this engine has done that a restart must redo, as records for the node to append to its log
   * before it answers: each block imported, and each fork choice. `replay` reads them back.
   */
  Vec<u8[]> records;
  /**
   * The store the state is in, or null when `world` holds all of it. On the store, `world` is a cache over
   * it, the store holds the state of the block `at` (docs/state-on-disk.md, "The node on the store"), and
   * `prepare` does the asynchronous part of each call before it.
   */
  StateDb? db;
  /** What `prepare` found of each payload it ran: "" for one now committed, else why it is invalid. */
  Map<U256, Prepared> prepared;
  /** Set while `prepare` runs `newPayload` only to have the block it describes: `importBlock` keeps it. */
  bool collecting;
  Vec<Block> collected;
  Vec<Spec> collectedSpecs;
  /** How the backed runs went, for whoever is measuring. */
  Steps steps;
  /** What `settleRoot` last staged, for `produceAsync` to commit. */
  Staged? lastStaged;
  /** Answers `prepare` worked out whole (a proof, from the store's tries), for the call that follows. */
  Map<string, JsonValue> answered;
  /** On a store, what each built payload changed, by payload id: its state root is the store's to work out. */
  Map<U256, ChangeSet> builtChanges;
  /**
   * On a store, blocks that left the history held in memory: where they go on disk (`blocks.wac`'s
   * canonical and transaction entries), committed with the next block, and meanwhile answered from here.
   * One field, not four: a 41st field of `Engine` made the devnet, which imports it, fail to check
   * (`docs/wac-asks.md`).
   */
  Persisting persisting;
  Undo undo;
  /** Whether the log has the block the store holds: when not, `adoptStored` records it. */
  bool restoredLogged;

  /** An engine whose chain starts at `genesis`, with `world` its state. */
  Engine create(ChainConfig config, Header genesis, World world) {
    Engine e = Engine(config, config.chainId, Map.create(hashU256, eqU256), Map.create(hashU256, eqU256), genesis.hash, genesis.hash,
                      genesis.hash, Vec.create(), Map.create(hashU256, eqU256), 1, world, genesis.hash, Map.create(hashU256, eqU256), false, Map.create(hashU256, eqU256), Map.create(hashU256, eqU256),
                      null, Map.create(hashU256, eqU256), Vec.create(), null, U256.zero(), U256.zero(), SenderCache.create(), "wacuum".toBytes(), U256.zero(), 0, 1, 0, Vec.create(),
                      null, Map.create(hashU256, eqU256), false, Vec.create(), Vec.create(), Steps(0, 0), null, Map.create(hashText, textEq), Map.create(hashU256, eqU256),
                      Persisting.create(), Undo.create(), false);
    e.blocks.set(genesis.hash, Node(genesis, null));
    e.archive.set(genesis.hash, Archived(genesis, Item[].filled(0, Item.Bytes(u8[].filled(0, 0))),
                                         Withdrawal[].filled(0, Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero())),
                                         Vec<Receipt>.create().toArray(), 0));
    e.canonical.set(genesis.number, genesis.hash);
    return e;
  }

  Answer call(this, string method, JsonValue params) {
    JsonArray? ps = params.array();
    if (ps is null) { return Answer.error(-32602, "params must be an array"); }
    if (method == "engine_newPayloadV1") { return this.newPayload(1, ps!); }
    if (method == "engine_newPayloadV2") { return this.newPayload(2, ps!); }
    if (method == "engine_newPayloadV3") { return this.newPayload(3, ps!); }
    if (method == "engine_newPayloadV4") { return this.newPayload(4, ps!); }
    if (method == "engine_forkchoiceUpdatedV1" || method == "engine_forkchoiceUpdatedV2" ||
        method == "engine_forkchoiceUpdatedV3") {
      return this.forkchoiceUpdated(ps!);
    }
    if (method == "engine_getPayloadV3") { return this.getPayload(3, ps!); }
    if (method == "engine_getPayloadV4") { return this.getPayload(4, ps!); }
    if (method == "engine_getPayloadV5") { return this.getPayload(5, ps!); }
    if (method == "engine_getBlobsV1") { return this.getBlobs(1, ps!); }
    if (method == "engine_getBlobsV2") { return this.getBlobs(2, ps!); }
    if (method == "engine_getPayloadBodiesByHashV1") { return this.bodiesByHash(ps!); }
    if (method == "engine_getPayloadBodiesByRangeV1") { return this.bodiesByRange(ps!); }
    if (method == "engine_getClientVersionV1") { return Answer.ok(clientVersion()); }
    if (method == "eth_sendRawTransaction") { return this.sendRawTransaction(ps!); }
    if (method == "eth_getBalance" || method == "eth_getTransactionCount" || method == "eth_getCode") {
      World? w = this.stateAt(arg(ps!, 1));
      if (w is null) { return unavailable(); }
      U256 a = hexU256(arg(ps!, 0));
      if (method == "eth_getBalance") { return Answer.ok(str(w!.balance(a).toHex())); }
      if (method == "eth_getCode") { return Answer.ok(str(bytesToHex(w!.code(a)))); }
      u64 nonce = w!.nonce(a);
      // "pending" counts the sender's transactions waiting in the mempool, as a wallet choosing its next
      // nonce needs.
      if ((arg(ps!, 1)?.text() ?? "") == "pending") { nonce = this.pendingNonce(a, nonce); }
      return Answer.ok(str(U256.ofU64(nonce).toHex()));
    }
    if (method == "eth_getStorageAt") {
      World? w = this.stateAt(arg(ps!, 2));
      if (w is null) { return unavailable(); }
      return Answer.ok(str(hex32(w!.storage(hexU256(arg(ps!, 0)), hexU256(arg(ps!, 1))))));
    }
    if (method == "eth_getProof" && this.db is not null) {
      JsonValue? got = this.answered.get(answerKey(method, params));
      this.answered.remove(answerKey(method, params));
      return got is null ? unavailable() : Answer.ok(got!);
    }
    if (method == "eth_getProof") {
      World? w = this.stateAt(arg(ps!, 2));
      if (w is null) { return unavailable(); }
      JsonArray? keys = arg(ps!, 1)?.array();
      U256[] slots = U256[].filled(keys is null ? 0 : keys!.len(), U256.zero());
      for (i32 i = 0; i < slots.len(); i++) { slots[i] = hexU256(keys!.get(i)); }
      return Answer.ok(proofJson(w!, hexU256(arg(ps!, 0)), slots));
    }
    if (method == "eth_call") { return this.ethCall(ps!); }
    if (method == "eth_estimateGas") { return this.estimateGas(ps!); }
    if (method == "eth_getBlockByNumber" || method == "eth_getBlockByHash") {
      U256? hash = method == "eth_getBlockByHash" ? hexU256(arg(ps!, 0)) : this.blockFor(arg(ps!, 0));
      Archived? a = hash is null ? null : this.archived(hash!);
      if (a is null) { return Answer.ok(JsonValue.Null); }
      bool full = arg(ps!, 1)?.boolean() ?? false;
      return Answer.ok(blockJson(a!.header, a!.txs, a!.withdrawals, a!.receipts, a!.size, full, this.chainId, this.senders));
    }
    if (method == "eth_getBlockTransactionCountByNumber" || method == "eth_getBlockTransactionCountByHash") {
      U256? hash = method == "eth_getBlockTransactionCountByHash" ? hexU256(arg(ps!, 0)) : this.blockFor(arg(ps!, 0));
      Archived? a = hash is null ? null : this.archived(hash!);
      return Answer.ok(a is null ? JsonValue.Null : str(U256.ofI32(a!.txs.len()).toHex()));
    }
    if (method == "eth_getTransactionByHash" || method == "eth_getTransactionReceipt") {
      Archived? a = null;
      i32 i = this.txWhere(hexU256(arg(ps!, 0)));
      if (i >= 0) { a = this.archived(this.txAt(hexU256(arg(ps!, 0)))!.block); }
      if (a is null) {
        if (method == "eth_getTransactionByHash") { return this.pendingTx(hexU256(arg(ps!, 0))); }
        return Answer.ok(JsonValue.Null);
      }
      if (method == "eth_getTransactionByHash") { return Answer.ok(txJson(a!.txs[i], this.chainId, a!.header, i, this.senders)); }
      // A block restored from a snapshot did not run here, so it has its transactions and no receipts.
      if (i >= a!.receipts.len()) { return Answer.ok(JsonValue.Null); }
      return Answer.ok(receiptJson(a!.receipts[i], a!.header, a!.receipts, i));
    }
    if (method == "eth_getBlockReceipts") {
      U256? hash = this.blockFor(arg(ps!, 0));
      Archived? a = hash is null ? null : this.archived(hash!);
      if (a is null) { return Answer.ok(JsonValue.Null); }
      JsonArray out = JsonArray.create();
      for (i32 i = 0; i < a!.receipts.len(); i++) { out.push(receiptJson(a!.receipts[i], a!.header, a!.receipts, i)); }
      return Answer.ok(JsonValue.Array(out));
    }
    if (method == "eth_getLogs") { return this.getLogs(ps!); }
    if (method == "eth_gasPrice") {
      return Answer.ok(str(nextBaseFee(this.blocks.get(this.head)!.header).add(U256.ofU64(SUGGESTED_TIP)).toHex()));
    }
    if (method == "eth_maxPriorityFeePerGas") { return Answer.ok(str(U256.ofU64(SUGGESTED_TIP).toHex())); }
    if (method == "eth_blobBaseFee") {
      Header h = this.blocks.get(this.head)!.header;
      Spec spec = this.config.specAt(h.timestamp);
      return Answer.ok(str(blobGasPrice(spec, nextExcessBlobGas(spec, h)).toHex()));
    }
    if (method == "eth_feeHistory") { return this.feeHistory(ps!); }
    if (method == "eth_syncing") { return Answer.ok(JsonValue.Bool(false)); }
    if (method == "eth_accounts") { return Answer.ok(JsonValue.Array(JsonArray.create())); }
    if (method == "net_version") { return Answer.ok(str(this.chainId.toDecimal())); }
    if (method == "net_listening") { return Answer.ok(JsonValue.Bool(true)); }
    if (method == "net_peerCount") { return Answer.ok(str("0x0")); }
    if (method == "web3_clientVersion") { return Answer.ok(str("wacuum/v0.1.0")); }
    if (method == "web3_sha3") { return Answer.ok(str(bytesToHex(keccak256(hexBytes(arg(ps!, 0)))))); }
    if (method == "engine_exchangeCapabilities") { return Answer.ok(capabilities()); }
    if (method == "eth_chainId") { return Answer.ok(str(this.chainId.toHex())); }
    // How big what the node keeps between blocks is: for tools/e2e/soak.wac, which watches for what grows.
    if (method == "wacuum_sizes") {
      JsonObject o = JsonObject.create();
      o.push("blocks".toBytes(), str("\{this.blocks.len()}"));
      o.push("canonical".toBytes(), str("\{this.canonical.len()}"));
      o.push("archive".toBytes(), str("\{this.archive.len()}"));
      o.push("txIndex".toBytes(), str("\{this.txIndex.len()}"));
      o.push("mempool".toBytes(), str("\{this.mempool.len()}"));
      o.push("payloads".toBytes(), str("\{this.payloads.len()}"));
      o.push("builtChanges".toBytes(), str("\{this.builtChanges.len()}"));
      o.push("prepared".toBytes(), str("\{this.prepared.len()}"));
      o.push("orphans".toBytes(), str("\{this.orphans.len()}"));
      o.push("records".toBytes(), str("\{this.records.len()}"));
      o.push("answered".toBytes(), str("\{this.answered.len()}"));
      o.push("senders".toBytes(), str("\{this.senders.senders.len()}"));
      i32 changed = 0;
      U256[] hs = this.blocks.keys();
      for (i32 i = 0; i < hs.len(); i++) {
        if (this.blocks.get(hs[i])!.changes is not null) { changed++; }
      }
      o.push("blocksWithChanges".toBytes(), str("\{changed}"));
      if (this.db is not null) {
        string st = this.db!.store.sizes();
        o.push("store".toBytes(), str(st));
        o.push("dbAccounts".toBytes(), str("\{this.db!.accounts.len()}"));
        o.push("dbSlots".toBytes(), str("\{this.db!.slots.len()}"));
      }
      return Answer.ok(JsonValue.Object(o));
    }
    if (method == "eth_blockNumber") { return Answer.ok(str(this.blocks.get(this.head)!.header.number.toHex())); }
    return Answer.error(-32601, "method not found: " + method);
  }

  // ── engine_newPayload ──

  Answer newPayload(this, i32 version, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no payload"); }
    JsonValue p = ps.get(0);
    if (p.object() is null) { return Answer.error(-32602, "the payload is not an object"); }
    bool hasWithdrawals = p.member("withdrawals") is not null && !p.member("withdrawals")!.isNull();
    bool hasBlobFields = p.member("blobGasUsed") is not null || p.member("excessBlobGas") is not null;
    // Each version names exactly the fields its fork has; a payload that disagrees is a malformed call.
    if (version == 2 && hasBlobFields) { return Answer.error(-32602, "blob fields before V3"); }
    if (version >= 3) {
      if (!hasWithdrawals || p.member("blobGasUsed") is null || p.member("excessBlobGas") is null) {
        return Answer.error(-32602, "a V\{version} payload needs withdrawals, blobGasUsed and excessBlobGas");
      }
      if (ps.len() < 3 || ps.get(1).array() is null || ps.get(2).text() is null) {
        return Answer.error(-32602, "V\{version} needs expected blob hashes and a parent beacon root");
      }
    }
    u8[][] requests = u8[][].defaulted(0);
    if (version >= 4) {
      if (ps.len() < 4 || ps.get(3).array() is null) { return Answer.error(-32602, "V4 needs execution requests"); }
      JsonArray rs = ps.get(3).array()!;
      requests = u8[][].defaulted(rs.len());
      i32 lastType = -1;
      for (i32 i = 0; i < rs.len(); i++) {
        u8[]? r = hexToBytes(rs.get(i).text() ?? "x");
        // Each request list is its type byte and then its data: types strictly ascending, none empty.
        if (r is null || r!.len() < 2 || (r![0] as i32) <= lastType) { return Answer.error(-32602, "malformed execution requests"); }
        lastType = r![0] as i32;
        requests[i] = r!;
      }
    }

    Header h = headerFrom(p);
    U256 claimed = hexU256(p.member("blockHash"));
    Vec<Item> txs = Vec.create();
    JsonArray rawTxs = p.member("transactions")?.array() ?? JsonArray.create();
    Vec<U256> blobHashes = Vec.create();
    u8[][] txBytes = u8[][].defaulted(rawTxs.len());
    for (i32 i = 0; i < rawTxs.len(); i++) {
      u8[] raw = hexToBytes(rawTxs.get(i).text() ?? "x") ?? u8[].filled(0, 0);
      txBytes[i] = raw;
      Item? it = txItem(raw);
      if (it is null) { return this.invalid(h, "transaction \{i} does not decode"); }
      txs.push(it!);
      DecodedTx d = decodeWith(it!, this.chainId, this.senders);
      for (i32 k = 0; k < d.tx.blobHashes.len(); k++) { blobHashes.push(d.tx.blobHashes[k]); }
    }
    Withdrawal[] withdrawals = withdrawalsFrom(p.member("withdrawals"));

    // The header the payload describes, with the fields the payload does not carry derived.
    h.txRoot = U256.fromBytes(indexedRoot(txBytes), 0, 32);
    u8[][] wsRaw = u8[][].defaulted(withdrawals.len());
    for (i32 i = 0; i < withdrawals.len(); i++) {
      Withdrawal wd = withdrawals[i];
      Item[] fields = [Item.Bytes(u256Bytes(wd.index)), Item.Bytes(u256Bytes(wd.validator)), Item.Bytes(addressBytes(wd.address)),
                       Item.Bytes(u256Bytes(wd.amount))];
      wsRaw[i] = encode(Item.List(fields));
    }
    h.withdrawalsRoot = U256.fromBytes(indexedRoot(wsRaw), 0, 32);
    if (version >= 3) { h.parentBeaconBlockRoot = hexU256(ps.get(2)); }
    if (version >= 4) {
      // The requests hash is over each list's data with its type byte; the payload already has them so.
      u8[][] byType = u8[][].defaulted(3);
      for (i32 t = 0; t < 3; t++) { byType[t] = u8[].filled(0, 0); }
      for (i32 i = 0; i < requests.len(); i++) {
        i32 t = requests[i][0] as i32;
        if (t < 3) {
          u8[] data = u8[].filled(requests[i].len() - 1, 0);
          for (i32 k = 0; k < data.len(); k++) { data[k] = requests[i][k + 1]; }
          byType[t] = data;
        }
      }
      h.requestsHash = requestsHashOf(byType);
    }
    Spec spec = this.config.specAt(h.timestamp);
    h.hash = U256.fromBytes(keccak256(encode(headerItem(spec, h))), 0, 32);
    if (!h.hash.eq(claimed)) { return this.invalidNoAncestor("block hash \{claimed.toHex()} is not the payload's, \{h.hash.toHex()}"); }

    // EIP-4844: the blob hashes the consensus layer expects must be exactly the transactions', in order.
    if (version >= 3) {
      JsonArray expected = ps.get(1).array()!;
      U256[] got = blobHashes.toArray();
      bool same = expected.len() == got.len();
      for (i32 i = 0; same && i < got.len(); i++) { same = hexU256(expected.get(i)).eq(got[i]); }
      if (!same) { return this.invalidNoAncestor("the versioned hashes do not match the transactions'"); }
    }

    return this.importBlock(spec, Block(h, txs.toArray(), false, withdrawals));
  }

  /** Execute a block on its parent's state and keep it: VALID, INVALID, or SYNCING without the parent. */
  Answer importBlock(this, Spec spec, Block b) {
    Header h = b.header;
    if (this.blocks.has(h.hash)) { return status("VALID", hex32(h.hash), ""); }
    Node? parent = this.blocks.get(h.parentHash);
    if (parent is null) {
      // A block on a chain this client has not got: it waits, and the chain it needs is fetched from peers.
      this.orphans.set(h.hash, Orphan(spec, b));
      this.syncTarget = h.parentHash;
      return status("SYNCING", "", "");
    }
    if (this.db is not null) { return this.importPrepared(spec, b); }
    // A parent this client has but cannot reach the state of is on a fork that finality has ruled out.
    if (!this.moveTo(h.parentHash)) { return status("SYNCING", "", ""); }
    this.world.record();
    Body body = executeBlock(spec, this.world, b, parent!.header, this.chainId, this.ancestorHashes(parent!.header), this.senders);
    ChangeSet cs = this.world.seal();
    if (body.error != "") {
      this.world.undo(cs);
      return this.invalid(h, body.error);
    }
    this.blocks.set(h.hash, Node(h, cs));
    this.at = h.hash;
    u8[] rlp = encodeBlock(spec, b);
    this.archive.set(h.hash, Archived(h, b.txs, b.withdrawals, body.receipts, rlp.len()));
    this.records.push(encode(Item.List([Item.Bytes([RECORD_BLOCK]), Item.Bytes(rlp)])));
    return status("VALID", hex32(h.hash), "");
  }

  /** INVALID, naming the parent as the latest valid ancestor when this client has it. */
  Answer invalid(this, Header h, string why) {
    return status("INVALID", this.blocks.has(h.parentHash) ? hex32(h.parentHash) : "", why);
  }

  Answer invalidNoAncestor(this, string why) { return status("INVALID", "", why); }

  /**
   * Move the world to the state after block `target`: back across change sets to the common ancestor of
   * where it is and where it is going, then forward. False, with the world unmoved, when the way crosses a
   * block whose change set has been dropped — a fork below the finalized block.
   */
  bool moveTo(this, U256 target) {
    if (this.at.eq(target)) { return true; }
    // On the store, moving is a commit, which `prepare` does; a move it did not do is one that cannot be made now.
    if (this.db is not null) { return false; }
    Vec<ChangeSet> back = Vec.create();
    Vec<ChangeSet> forward = Vec.create();
    Header a = this.blocks.get(this.at)!.header;
    Node? tn = this.blocks.get(target);
    if (tn is null) { return false; }
    Header b = tn!.header;
    // Step back whichever side is higher (the departure side on a tie) until the two meet.
    while (!a.hash.eq(b.hash)) {
      bool fromHere = !b.number.gt(a.number);
      Header cur = fromHere ? a : b;
      Node n = this.blocks.get(cur.hash)!;
      Node? p = this.blocks.get(cur.parentHash);
      if (n.changes is null || p is null) { return false; }
      if (fromHere) {
        back.push(n.changes!);
        a = p!.header;
      } else {
        forward.push(n.changes!);
        b = p!.header;
      }
    }
    for (i32 i = 0; i < back.len(); i++) { this.world.undo(back.get(i)); }
    for (i32 i = forward.len() - 1; i >= 0; i--) { this.world.redo(forward.get(i)); }
    this.at = target;
    return true;
  }

  /** Number to hash for the chain ending at `tip`, back as far as BLOCKHASH can see. */
  Map<U256, U256> ancestorHashes(this, Header tip) {
    Map<U256, U256> m = Map.create(hashU256, eqU256);
    Header cur = tip;
    for (i32 i = 0; i < 256; i++) {
      m.set(cur.number, cur.hash);
      Node? p = this.blocks.get(cur.parentHash);
      if (p is null) { break; }
      cur = p!.header;
    }
    return m;
  }

  // ── engine_forkchoiceUpdated ──

  /** The engine on a store: `db` holds the state of `genesis` (seeded by the caller), and `world` caches it. */
  Engine onStore(ChainConfig config, Header genesis, StateDb db) {
    World w = World.create();
    w.backBy(db.source());
    Engine e = Engine.create(config, genesis, w);
    e.db = db;
    return e;
  }

  /**
   * On a store that already holds a block's state (its meta names the block): the log's blocks up to it are
   * recorded without running, as after a snapshot, and only those after it run. False when the store is
   * at the genesis, whose state `onStore`'s caller seeded.
   */
  bool resumeFromStore(this) {
    u8[] user = this.db!.store.committed().user;
    if (user.len() < 40) { return false; }
    U256 hash = U256.fromBytes(user, 0, 32);
    if (hash.eq(this.head)) { return false; }
    this.restoredAt = hash;
    this.restoredNumber = U256.fromBytes(user, 32, 8);
    this.snapshotNumber = this.restoredNumber;
    return true;
  }

  /**
   * The chain begun again at `pivot`, a block whose state the store now holds (fetched by snap sync), with
   * its ancestors (newest first, 256 for BLOCKHASH) known only as headers: what came before is not run, and
   * the blocks after it are imported as usual. Recorded, so a restart rebases the same way.
   */
  void rebase(this, Header pivot, Header[] ancestors) {
    this.blocks = Map.create(hashU256, eqU256);
    this.canonical = Map.create(hashU256, eqU256);
    this.archive = Map.create(hashU256, eqU256);
    this.orphans = Map.create(hashU256, eqU256);
    Vec<u8[]> raws = Vec.create();
    raws.push(encode(headerItem(this.config.specAt(pivot.timestamp), pivot)));
    // Newest first in the record, as `ancestors` are.
    for (i32 i = 0; i < ancestors.len(); i++) { raws.push(encode(headerItem(this.config.specAt(ancestors[i].timestamp), ancestors[i]))); }
    for (i32 i = ancestors.len() - 1; i >= -1; i--) {
      Header h = i < 0 ? pivot : ancestors[i];
      this.blocks.set(h.hash, Node(h, null));
      this.canonical.set(h.number, h.hash);
      this.archive.set(h.hash, Archived(h, Item[].filled(0, Item.Bytes(u8[].filled(0, 0))),
                                        Withdrawal[].filled(0, Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero())),
                                        Vec<Receipt>.create().toArray(), 0));
    }
    this.head = pivot.hash;
    this.safe = pivot.hash;
    this.finalized = pivot.hash;
    this.forgottenAt = pivot.hash;
    this.at = pivot.hash;
    this.keptFrom = ancestors.len() > 0 ? ancestors[ancestors.len() - 1].number.low() : pivot.number.low();
    // Replayed after a restart, the store may already be past the pivot: the later of the two is where
    // the log's blocks start running again.
    if (this.restoredAt is null || this.restoredNumber.lt(pivot.number)) {
      this.restoredAt = pivot.hash;
      this.restoredNumber = pivot.number;
      this.snapshotNumber = pivot.number;
    }
    if (this.syncTarget is not null && this.syncTarget!.eq(pivot.hash)) { this.syncTarget = null; }
    if (this.db is not null) { this.freshWorld(); }
    Item[] rec = Item[].filled(raws.len() + 1, Item.Bytes([RECORD_BASE]));
    for (i32 i = 0; i < raws.len(); i++) { rec[i + 1] = Item.Bytes(raws.get(i)); }
    this.records.push(encode(Item.List(rec)));
  }

  /** A fresh cache over the store: after the store moves, what the old one held may be stale. */
  void freshWorld(this) {
    World w = World.create();
    w.backBy(this.db!.source());
    this.world = w;
  }

  /**
   * On the store, the asynchronous part of `call(method, params)`, awaited before it: payloads run and
   * committed, the store moved to a fork choice's head, what a state query reads read. Nothing off the store.
   */
  async void prepare(this, string method, JsonValue params) {
    if (this.db is null) { return; }
    JsonArray? ps = params.array();
    if (ps is null) { return; }
    if (method.indexOf("engine_newPayload") == 0) {
      // The block, as the call would see it: run the call to the point where it would import.
      this.collecting = true;
      this.collected = Vec.create();
      this.collectedSpecs = Vec.create();
      this.call(method, params);
      this.collecting = false;
      for (i32 i = 0; i < this.collected.len(); i++) { await this.prepareBlock(this.collectedSpecs.get(i), this.collected.get(i)); }
      return;
    }
    if (method.indexOf("engine_forkchoiceUpdated") == 0) {
      if (ps!.len() < 1 || ps!.get(0).object() is null) { return; }
      U256 head = hexU256(ps!.get(0).member("headBlockHash"));
      if (this.blocks.has(head)) { await this.moveToAsync(head); }
      return;
    }
    if (method.indexOf("engine_getPayload") == 0) {
      // The built block's state root, from what it changed staged on the store at its parent, and its hash.
      if (ps!.len() < 1) { return; }
      U256 id = hexU256(ps!.get(0));
      ChangeSet? cs = this.builtChanges.get(id);
      Built? b = this.payloads.get(id);
      if (cs is null || b is null) { return; }
      this.builtChanges.remove(id);
      Header h = b!.block.header;
      if (!this.at.eq(h.parentHash)) { await this.moveToAsync(h.parentHash); }
      await this.settleRoot(b!.block, cs!);
      this.db!.discard();
      return;
    }
    if (method == "eth_getProof") {
      // Of the head's state, from the store's tries; the call then answers it.
      if (!this.at.eq(this.head) && this.blocks.has(this.head)) { await this.moveToAsync(this.head); }
      JsonArray? keys = arg(ps!, 1)?.array();
      U256[] slots = U256[].filled(keys is null ? 0 : keys!.len(), U256.zero());
      for (i32 i = 0; i < slots.len(); i++) { slots[i] = hexU256(keys!.get(i)); }
      this.answered.set(answerKey(method, params), await proofFromStore(this.db!, hexU256(arg(ps!, 0)), slots));
      return;
    }
    if (method == "eth_call" || method == "eth_estimateGas") {
      // Run until a run reads nothing it had not read before: then the call itself finds it all in memory.
      if (!this.at.eq(this.head) && this.blocks.has(this.head)) { await this.moveToAsync(this.head); }
      StateDb db = this.db!;
      for (i32 round = 0; round < 1000; round++) {
        this.freshWorld();
        db.misses = 0;
        this.call(method, params);
        if (db.misses == 0) { break; }
        string bad = await db.fetch();
        if (bad != "") { break; }
      }
      this.freshWorld();
      return;
    }
    if (method == "eth_getBalance" || method == "eth_getTransactionCount" || method == "eth_getCode" || method == "eth_getStorageAt") {
      if (!this.at.eq(this.head) && this.blocks.has(this.head)) { await this.moveToAsync(this.head); }
      U256 a = hexU256(arg(ps!, 0));
      StateDb db = this.db!;
      if (!db.accounts.has(a)) { db.wantAccounts.set(a, true); }
      if (method == "eth_getStorageAt") { db.slot(a, hexU256(arg(ps!, 1))); }
      this.world.unask([a], db.wantSlots);
      await db.fetch();
    }
  }

  /**
   * A payload's block run on the store at its parent, a step at a time; committed if every commitment
   * matches, the root included, which leaves the store at the block; its verdict kept for `importBlock`.
   */
  async void prepareBlock(this, Spec spec, Block b) {
    Header h = b.header;
    Node? parent = this.blocks.get(h.parentHash);
    if (parent is null || this.blocks.has(h.hash) || this.prepared.has(h.hash)) { return; }
    if (!(await this.moveToAsync(h.parentHash))) { return; }
    StateDb db = this.db!;
    this.freshWorld();
    World w = this.world;
    w.record();
    Body body = await executeFrom(db, w, spec, b, parent!.header, this.chainId, this.ancestorHashes(parent!.header), this.senders, this.steps);
    ChangeSet cs = w.seal();
    this.freshWorld();
    if (body.error != "") {
      db.discard();
      this.prepared.set(h.hash, Prepared(body.error, cs, body));
      return;
    }
    string[] why = [""];
    Staged? st = await db.stageSet(cs, true, why);
    if (st is null) {
      this.prepared.set(h.hash, Prepared("the state did not write: \{why[0]}", cs, body));
      return;
    }
    if (!U256.fromBytes(st!.root, 0, 32).eq(h.stateRoot)) {
      db.discard();
      this.prepared.set(h.hash, Prepared("state root does not match", cs, body));
      return;
    }
    // The receipts with the state, so that a restart, which does not run this block again, still has them.
    Change[] pruned = await this.undoPrunes(h.number.low());
    string bad = await db.commitWith(st!, this.withBlock(h, encodeBlock(spec, b), body.receipts, cs, pruned, st!.changes), storedAt(h));
    if (bad != "") {
      this.prepared.set(h.hash, Prepared("the state did not commit: \{bad}", cs, body));
      return;
    }
    this.at = h.hash;
    this.prepared.set(h.hash, Prepared("", cs, body));
  }

  /** A block built on a world over the store: its state root (and so its hash) from its changes staged on the store. */
  async bool settleRoot(this, Block b, ChangeSet cs) {
    string[] why = [""];
    Staged? st = await this.db!.stageSet(cs, true, why);
    if (st is null) { return false; }
    b.header.stateRoot = U256.fromBytes(st!.root, 0, 32);
    b.header.hash = U256.fromBytes(keccak256(encode(headerItem(this.config.specAt(b.header.timestamp), b.header))), 0, 32);
    this.lastStaged = st;
    return true;
  }

  /**
   * `produce` on the store: built on the head as there, its root from its changes staged on the store,
   * committed, and made the head. "" or why not.
   */
  async string produceAsync(this, U256 timestamp, U256 feeRecipient) {
    if (this.db is null) { return this.produce(timestamp, feeRecipient); }
    if (!(await this.moveToAsync(this.head))) { return "the store cannot reach the head"; }
    Header parent = this.blocks.get(this.head)!.header;
    if (!timestamp.gt(parent.timestamp)) { timestamp = parent.timestamp.add(U256.one()); }
    U256 randao = U256.fromBytes(keccak256(parent.hash.toBytes()), 0, 32);
    Attributes attrs = Attributes(timestamp, randao, feeRecipient,
                                  Withdrawal[].filled(0, Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero())), U256.zero());
    Spec spec = this.config.specAt(timestamp);
    this.freshWorld();
    this.world.record();
    Built built = buildBlock(spec, this.world, parent, attrs, this.candidates(spec), this.chainId,
                             this.ancestorHashes(parent), this.extraData, this.senders);
    ChangeSet cs = this.world.seal();
    if (built.body.error != "") {
      this.freshWorld();
      return built.body.error;
    }
    Block b = built.block;
    if (!(await this.settleRoot(b, cs))) {
      this.freshWorld();
      return "the block's state did not stage";
    }
    Change[] pruned = await this.undoPrunes(b.header.number.low());
    string bad = await this.db!.commitWith(this.lastStaged!, this.withBlock(b.header, encodeBlock(spec, b), built.body.receipts, cs, pruned, this.lastStaged!.changes), storedAt(b.header));
    this.freshWorld();
    if (bad != "") { return "the block's state did not commit: \{bad}"; }
    U256 hash = b.header.hash;
    this.blocks.set(hash, Node(b.header, cs));
    this.at = hash;
    u8[] rlp = encodeBlock(spec, b);
    this.archive.set(hash, Archived(b.header, b.txs, b.withdrawals, built.body.receipts, rlp.len()));
    this.records.push(encode(Item.List([Item.Bytes([RECORD_BLOCK]), Item.Bytes(rlp)])));
    this.choose(hash, hash, hash);
    return "";
  }

  /** `moveTo` on the store: each block left and each reached committed, the root checked against its header. */
  async bool moveToAsync(this, U256 target) {
    if (this.at.eq(target)) { return true; }
    Vec<ChangeSet> back = Vec.create();
    Vec<ChangeSet> forward = Vec.create();
    Vec<Header> reached = Vec.create();
    Header a = this.blocks.get(this.at)!.header;
    Node? tn = this.blocks.get(target);
    if (tn is null) { return false; }
    Header b = tn!.header;
    while (!a.hash.eq(b.hash)) {
      bool fromHere = !b.number.gt(a.number);
      Header cur = fromHere ? a : b;
      Node n = this.blocks.get(cur.hash)!;
      Node? p = this.blocks.get(cur.parentHash);
      if (n.changes is null || p is null) { return false; }
      if (fromHere) {
        back.push(n.changes!);
        a = p!.header;
        reached.push(a);
      } else {
        forward.push(n.changes!);
        b = p!.header;
      }
    }
    StateDb db = this.db!;
    string[] why = [""];
    // Each step is a commit (or a staged one), so `at` follows each: if a step fails part way, the engine still
    // knows the block the store is at, and the next move starts from there rather than from where it set out.
    for (i32 i = 0; i < back.len(); i++) {
      Header to = reached.get(i);
      u8[]? root = await db.writeSet(back.get(i), false, storedAt(to), why);
      if (root is null || !U256.fromBytes(root!, 0, 32).eq(to.stateRoot)) { return false; }
      this.at = to.hash;
      this.freshWorld();
    }
    for (i32 i = forward.len() - 1; i >= 0; i--) {
      // The blocks reached going forward, from the meeting point up to the target.
      Header to = i == 0 ? tn!.header : this.headerAbove(tn!.header, i);
      u8[]? root = await db.writeSet(forward.get(i), true, storedAt(to), why);
      if (root is null || !U256.fromBytes(root!, 0, 32).eq(to.stateRoot)) { return false; }
      this.at = to.hash;
      this.freshWorld();
    }
    this.at = target;
    this.freshWorld();
    return true;
  }

  /** The ancestor of `h` `back` blocks below it. */
  Header headerAbove(this, Header h, i32 back) {
    Header cur = h;
    for (i32 i = 0; i < back; i++) { cur = this.blocks.get(cur.parentHash)!.header; }
    return cur;
  }

  /** On the store: the verdict `prepareBlock` reached on `b`, which it has already committed if valid. */
  Answer importPrepared(this, Spec spec, Block b) {
    Header h = b.header;
    if (this.collecting) {
      this.collected.push(b);
      this.collectedSpecs.push(spec);
      return status("SYNCING", "", "");
    }
    Prepared? pr = this.prepared.get(h.hash);
    if (pr is null) { return status("SYNCING", "", ""); }
    this.prepared.remove(h.hash);
    if (pr!.error != "") { return this.invalid(h, pr!.error); }
    this.blocks.set(h.hash, Node(h, pr!.changes));
    u8[] rlp = encodeBlock(spec, b);
    this.archive.set(h.hash, Archived(h, b.txs, b.withdrawals, pr!.body.receipts, rlp.len()));
    this.records.push(encode(Item.List([Item.Bytes([RECORD_BLOCK]), Item.Bytes(rlp)])));
    return status("VALID", hex32(h.hash), "");
  }

  Answer forkchoiceUpdated(this, JsonArray ps) {
    if (ps.len() < 1 || ps.get(0).object() is null) { return Answer.error(-32602, "no forkchoice state"); }
    JsonValue fc = ps.get(0);
    U256 head = hexU256(fc.member("headBlockHash"));
    if (!this.choose(head, hexU256(fc.member("safeBlockHash")), hexU256(fc.member("finalizedBlockHash")))) {
      this.syncTarget = head;
      return Answer.ok(forkchoiceResult(status("SYNCING", "", "").result!));
    }
    JsonValue payloadId = JsonValue.Null;
    if (ps.len() >= 2 && ps.get(1).object() is not null) {
      JsonValue at = ps.get(1);
      Header parent = this.blocks.get(head)!.header;
      if (!hexU256(at.member("timestamp")).gt(parent.timestamp)) { return Answer.error(-38003, "invalid payload attributes: timestamp"); }
      Attributes attrs = Attributes(hexU256(at.member("timestamp")), hexU256(at.member("prevRandao")),
                                    hexU256(at.member("suggestedFeeRecipient")), withdrawalsFrom(at.member("withdrawals")),
                                    hexU256(at.member("parentBeaconBlockRoot")));
      Spec spec = this.config.specAt(attrs.timestamp);
      // Built on the head's state and then taken back off it: the block exists only as a payload until the
      // consensus client sends it back with newPayload.
      this.moveTo(head);
      this.world.record();
      Built built = buildBlock(spec, this.world, parent, attrs, this.candidates(spec), this.chainId,
                               this.ancestorHashes(parent), this.extraData, this.senders);
      ChangeSet builtCs = this.world.seal();
      this.world.undo(builtCs);
      // A body that fails is a chain this client cannot extend at all — a system contract missing or
      // broken — and not something to hand out as an empty block.
      if (built.body.error != "") { return Answer.error(-32603, "cannot build on this head: " + built.body.error); }
      U256 id = U256.ofU64(this.nextPayloadId);
      this.nextPayloadId++;
      this.payloads.set(id, built);
      // Only the latest are kept: a consensus client asks for a payload seconds after it began, and each holds
      // a whole block. Kept for good, a node building every slot grew by a block's worth each time.
      if (id.low() >= 32) {
        U256 old = U256.ofU64(id.low() - 32);
        this.payloads.remove(old);
        this.builtChanges.remove(old);
      }
      // On a store the world holds only what the build read, so the header's root waits for getPayload's prepare.
      if (this.db is not null) { this.builtChanges.set(id, builtCs); }
      payloadId = str(hex8(id));
    }
    JsonObject o = JsonObject.create();
    o.push("payloadStatus".toBytes(), status("VALID", hex32(head), "").result!);
    o.push("payloadId".toBytes(), payloadId);
    return Answer.ok(JsonValue.Object(o));
  }

  /**
   * What a consensus client and this engine do between them each slot, done here alone: build a block on
   * the head from the mempool, keep it, and make it the head, safe and finalized at once. It is how a devnet
   * with no consensus client runs. The block is kept as it was built, not run a second time, and recorded
   * as an imported one is, so a restart replays it. Answers why it could not, or "".
   */
  string produce(this, U256 timestamp, U256 feeRecipient) {
    Header parent = this.blocks.get(this.head)!.header;
    if (!timestamp.gt(parent.timestamp)) { timestamp = parent.timestamp.add(U256.one()); }
    // Something that changes from block to block for PREVRANDAO, and a beacon root no beacon chain made.
    U256 randao = U256.fromBytes(keccak256(parent.hash.toBytes()), 0, 32);
    Attributes attrs = Attributes(timestamp, randao, feeRecipient,
                                  Withdrawal[].filled(0, Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero())), U256.zero());
    Spec spec = this.config.specAt(timestamp);
    this.moveTo(this.head);
    this.world.record();
    Built built = buildBlock(spec, this.world, parent, attrs, this.candidates(spec), this.chainId,
                             this.ancestorHashes(parent), this.extraData, this.senders);
    ChangeSet cs = this.world.seal();
    if (built.body.error != "") {
      this.world.undo(cs);
      return built.body.error;
    }
    Block b = built.block;
    U256 hash = b.header.hash;
    this.blocks.set(hash, Node(b.header, cs));
    this.at = hash;
    u8[] rlp = encodeBlock(spec, b);
    this.archive.set(hash, Archived(b.header, b.txs, b.withdrawals, built.body.receipts, rlp.len()));
    this.records.push(encode(Item.List([Item.Bytes([RECORD_BLOCK]), Item.Bytes(rlp)])));
    this.choose(hash, hash, hash);
    return "";
  }

  /** The bookkeeping of a fork choice: false, changing nothing, when the head is not a block this has. */
  bool choose(this, U256 head, U256 safe, U256 finalized) {
    if (!this.blocks.has(head)) { return false; }
    if (!(head.eq(this.head) && safe.eq(this.safe) && finalized.eq(this.finalized))) {
      this.records.push(encode(Item.List([Item.Bytes([RECORD_CHOICE]), Item.Bytes(head.toBytes()), Item.Bytes(safe.toBytes()),
                                          Item.Bytes(finalized.toBytes())])));
    }
    this.head = head;
    this.safe = safe;
    this.finalized = finalized;
    // Walk back from the new head, rewriting the canonical number-to-hash map until it agrees.
    Header cur = this.blocks.get(head)!.header;
    while (true) {
      U256? known = this.canonical.get(cur.number);
      if (known is not null && known!.eq(cur.hash)) { break; }
      this.canonical.set(cur.number, cur.hash);
      Archived? arc = this.archive.get(cur.hash);
      if (arc is not null) {
        U256[] hashes = txHashes(arc!);
        for (i32 i = 0; i < hashes.len(); i++) { this.txIndex.set(hashes[i], TxAt(cur.hash, i)); }
      }
      Node? p = this.blocks.get(cur.parentHash);
      if (p is null) { break; }
      cur = p!.header;
    }
    this.prune();
    this.forgetBelowFinalized();
    return true;
  }

  /**
   * Nothing at or below the finalized block can be reorganised away, so the change sets of the canonical
   * blocks there are dropped, and so are the blocks of forks that branch off below it. Canonical blocks more
   * than 256 below it go too: BLOCKHASH reaches 256 back from a head that is never below the finalized
   * block, and nothing else looks further. This runs when finality moves, so the blocks held stay about the
   * unfinalized ones and 256 more.
   */
  void forgetBelowFinalized(this) {
    if (this.finalized.eq(this.forgottenAt)) { return; }
    Node? f = this.blocks.get(this.finalized);
    if (f is null) { return; }
    this.forgottenAt = this.finalized;
    this.moveTo(this.head);
    U256 fin = f!.header.number;
    U256[] hashes = this.blocks.keys();
    for (i32 i = 0; i < hashes.len(); i++) {
      Node n = this.blocks.get(hashes[i])!;
      if (n.header.number.gt(fin)) { continue; }
      U256? c = this.canonical.get(n.header.number);
      bool canonical = c is not null && c!.eq(hashes[i]);
      if (canonical && n.header.number.add(U256.ofU64(256)).gt(fin)) {
        // The last `states` of them keep their change sets, so the world can still be moved back to them.
        if (!n.header.number.add(U256.ofU64(this.states)).gt(fin)) { n.changes = null; }
      } else if (!hashes[i].eq(this.at)) {
        this.blocks.remove(hashes[i]);
        if (!canonical) { this.archive.remove(hashes[i]); }
      }
    }
    // And the history beyond what is kept: its blocks, their receipts, and where their transactions are.
    // The genesis stays, so "earliest" still names a block.
    if (this.history == 0 || !fin.gt(U256.ofU64(this.history))) { return; }
    u64 below = fin.sub(U256.ofU64(this.history)).low();
    while (this.keptFrom < below) {
      U256 n = U256.ofU64(this.keptFrom);
      this.keptFrom++;
      U256? h = this.canonical.get(n);
      if (h is null) { continue; }
      Archived? a = this.archive.get(h!);
      // On a store it is kept on disk: its block and receipts are there already, and where it and its
      // transactions are goes with the next commit.
      if (this.db is not null) {
        this.persisting.keys.push(canonicalKey(n.low()));
        this.persisting.values.push(h!.toBytes());
        this.persisting.canonical.set(n, h!);
      }
      if (a is not null) {
        U256[] hashes = txHashes(a!);
        for (i32 i = 0; i < hashes.len(); i++) {
          if (this.db is not null) {
            this.persisting.keys.push(txKey(hashes[i]));
            this.persisting.values.push(txPlace(h!, i));
            this.persisting.txs.set(hashes[i], TxAt(h!, i));
          }
          this.txIndex.remove(hashes[i]);
        }
      }
      this.archive.remove(h!);
      this.canonical.remove(n);
    }
  }

  /** Drop what the head's state has made stale: a transaction whose nonce its sender has already used. */
  void prune(this) {
    World w = this.headState();
    Vec<Item> keep = Vec.create();
    Item[] all = this.mempool.toArray();
    for (i32 i = 0; i < all.len(); i++) {
      DecodedTx d = decodeWith(all[i], this.chainId, this.senders);
      if (d.error != "") { continue; }
      if (d.tx.nonce.lt(U256.ofU64(w.nonce(d.tx.sender)))) { continue; }
      keep.push(all[i]);
    }
    this.mempool = keep;
    // A sidecar goes with the last transaction that names its blob.
    Map<U256, Sidecar> blobs = Map.create(hashU256, eqU256);
    for (i32 i = 0; i < keep.len(); i++) {
      U256[] hashes = decodeWith(keep.get(i), this.chainId, this.senders).tx.blobHashes;
      for (i32 k = 0; k < hashes.len(); k++) {
        Sidecar? sc = this.sidecars.get(hashes[k]);
        if (sc is not null) { blobs.set(hashes[k], sc!); }
      }
    }
    this.sidecars = blobs;
  }

  /**
   * The mempool as a block under `spec` may take it: a blob transaction only with every blob's sidecar,
   * in the form the fork's blobs bundle carries — a transaction sent with blob proofs before Osaka cannot
   * go into an Osaka block, whose bundle needs cell proofs.
   */
  Item[] candidates(this, Spec spec) {
    if (this.sidecarsOptional) { return this.mempool.toArray(); }
    Vec<Item> out = Vec.create();
    for (i32 i = 0; i < this.mempool.len(); i++) {
      U256[] hashes = decodeWith(this.mempool.get(i), this.chainId, this.senders).tx.blobHashes;
      bool ready = true;
      for (i32 k = 0; k < hashes.len(); k++) {
        Sidecar? sc = this.sidecars.get(hashes[k]);
        if (sc is null || sc!.proofs.len() != (spec.isOsaka ? CELLS_PER_BLOB : 1)) { ready = false; }
      }
      if (ready) { out.push(this.mempool.get(i)); }
    }
    return out.toArray();
  }

  // ── eth_sendRawTransaction ──

  Answer sendRawTransaction(this, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no transaction"); }
    u8[]? raw = hexToBytes(ps.get(0).text() ?? "x");
    if (raw is null) { return Answer.error(-32602, "the transaction is not hex"); }
    return this.acceptTransaction(raw!);
  }

  /**
   * A transaction into the mempool, from a user or a peer: `raw` is its network form (a blob transaction
   * with its sidecar). Answers its hash, or why it was refused.
   */
  Answer acceptTransaction(this, u8[] raw) {
    // The sidecar's form is the next block's fork's, taking the next block to be a slot after the head.
    Header h = this.blocks.get(this.head)!.header;
    Unwrapped u = unwrap(raw, this.config.specAt(h.timestamp.add(U256.ofU64(12))).isOsaka);
    if (u.error != "") { return Answer.error(-32000, u.error); }
    Item? it = txItem(u.canonical);
    if (it is null) { return Answer.error(-32602, "the transaction does not decode"); }
    DecodedTx d = decodeWith(it!, this.chainId, this.senders);
    if (d.error != "") { return Answer.error(-32000, d.error); }
    if (d.tx.nonce.lt(U256.ofU64(this.headState().nonce(d.tx.sender)))) { return Answer.error(-32000, "nonce too low"); }
    if (d.tx.txType == 3) {
      if (!u.wrapped && !this.sidecarsOptional) { return Answer.error(-32000, "a blob transaction without its blobs"); }
      if (u.wrapped && !sidecarsFit(u.sidecars, d.tx.blobHashes)) {
        return Answer.error(-32000, "the sidecar's commitments are not the transaction's blobs");
      }
      for (i32 k = 0; k < u.sidecars.len(); k++) { this.sidecars.set(d.tx.blobHashes[k], u.sidecars[k]); }
    }
    U256 hash = d.hash;
    for (i32 i = 0; i < this.mempool.len(); i++) {
      if (U256.fromBytes(keccak256(rawOf(this.mempool.get(i))), 0, 32).eq(hash)) { return Answer.ok(str(hex32(hash))); }
    }
    this.mempool.push(it!);
    // Peers hear of it, in the form they would fetch it in.
    u8[]? wire = this.networkForm(it!);
    if (wire is not null) { this.announce.push(wire!); }
    return Answer.ok(str(bytesToHex(keccak256(d.raw))));
  }

  // ── engine_getPayload ──

  Answer getPayload(this, i32 version, JsonArray ps) {
    if (ps.len() < 1) { return Answer.error(-32602, "no payload id"); }
    Built? b = this.payloads.get(hexU256(ps.get(0)));
    if (b is null) { return Answer.error(-38001, "unknown payload"); }
    Built built = b!;
    Header h = built.block.header;
    Spec spec = this.config.specAt(h.timestamp);
    i32 wants = spec.isOsaka ? 5 : spec.isPrague ? 4 : 3;
    if (version != wants) { return Answer.error(-38005, "unsupported fork: this payload wants engine_getPayloadV\{wants}"); }
    JsonObject p = JsonObject.create();
    p.push("parentHash".toBytes(), str(hex32(h.parentHash)));
    p.push("feeRecipient".toBytes(), str(bytesToHex(addressBytes(h.coinbase))));
    p.push("stateRoot".toBytes(), str(hex32(h.stateRoot)));
    p.push("receiptsRoot".toBytes(), str(hex32(h.receiptsRoot)));
    p.push("logsBloom".toBytes(), str(bytesToHex(h.bloom)));
    p.push("prevRandao".toBytes(), str(hex32(h.prevRandao)));
    p.push("blockNumber".toBytes(), str(h.number.toHex()));
    p.push("gasLimit".toBytes(), str(h.gasLimit.toHex()));
    p.push("gasUsed".toBytes(), str(h.gasUsed.toHex()));
    p.push("timestamp".toBytes(), str(h.timestamp.toHex()));
    p.push("extraData".toBytes(), str(bytesToHex(h.extraData)));
    p.push("baseFeePerGas".toBytes(), str(h.baseFee.toHex()));
    p.push("blockHash".toBytes(), str(hex32(h.hash)));
    JsonArray txs = JsonArray.create();
    for (i32 i = 0; i < built.block.txs.len(); i++) {
      DecodedTx d = decodeWith(built.block.txs[i], this.chainId, this.senders);
      txs.push(str(bytesToHex(d.raw)));
    }
    p.push("transactions".toBytes(), JsonValue.Array(txs));
    JsonArray ws = JsonArray.create();
    for (i32 i = 0; i < built.block.withdrawals.len(); i++) {
      Withdrawal wd = built.block.withdrawals[i];
      JsonObject o = JsonObject.create();
      o.push("index".toBytes(), str(wd.index.toHex()));
      o.push("validatorIndex".toBytes(), str(wd.validator.toHex()));
      o.push("address".toBytes(), str(bytesToHex(addressBytes(wd.address))));
      o.push("amount".toBytes(), str(wd.amount.toHex()));
      ws.push(JsonValue.Object(o));
    }
    p.push("withdrawals".toBytes(), JsonValue.Array(ws));
    p.push("blobGasUsed".toBytes(), str(h.blobGasUsed.toHex()));
    p.push("excessBlobGas".toBytes(), str(h.excessBlobGas.toHex()));

    // Every blob the block's transactions name, in order, with its commitment and its proof or proofs.
    JsonArray commitments = JsonArray.create();
    JsonArray proofs = JsonArray.create();
    JsonArray blobs = JsonArray.create();
    for (i32 i = 0; i < built.block.txs.len(); i++) {
      U256[] hashes = decodeWith(built.block.txs[i], this.chainId, this.senders).tx.blobHashes;
      for (i32 k = 0; k < hashes.len(); k++) {
        Sidecar? sc = this.sidecars.get(hashes[k]);
        if (sc is null) { continue; }
        commitments.push(str(bytesToHex(sc!.commitment)));
        blobs.push(str(bytesToHex(sc!.blob)));
        for (i32 j = 0; j < sc!.proofs.len(); j++) { proofs.push(str(bytesToHex(sc!.proofs[j]))); }
      }
    }
    JsonObject bundle = JsonObject.create();
    bundle.push("commitments".toBytes(), JsonValue.Array(commitments));
    bundle.push("proofs".toBytes(), JsonValue.Array(proofs));
    bundle.push("blobs".toBytes(), JsonValue.Array(blobs));
    JsonObject out = JsonObject.create();
    out.push("executionPayload".toBytes(), JsonValue.Object(p));
    out.push("blockValue".toBytes(), str(built.body.fees.toHex()));
    out.push("blobsBundle".toBytes(), JsonValue.Object(bundle));
    out.push("shouldOverrideBuilder".toBytes(), JsonValue.Bool(false));
    if (version >= 4) {
      // Each non-empty request list, its type byte first: the form newPayloadV4 takes back.
      JsonArray rs = JsonArray.create();
      for (i32 t = 0; t < built.body.requests.len(); t++) {
        u8[] data = built.body.requests[t];
        if (data.len() == 0) { continue; }
        u8[] typed = u8[].filled(data.len() + 1, 0);
        typed[0] = t as! u8;
        for (i32 k = 0; k < data.len(); k++) { typed[k + 1] = data[k]; }
        rs.push(str(bytesToHex(typed)));
      }
      out.push("executionRequests".toBytes(), JsonValue.Array(rs));
    }
    return Answer.ok(JsonValue.Object(out));
  }

  /**
   * eth_call: a message run on a copy of the head's state, as if in the next block, and thrown away. Only
   * the head is answered for — a block tag naming another block is not looked at yet.
   */
  Answer ethCall(this, JsonArray ps) {
    if (ps.len() < 1 || ps.get(0).object() is null) { return Answer.error(-32602, "no call object"); }
    JsonValue c = ps.get(0);
    Header h = this.blocks.get(this.head)!.header;
    Spec spec = this.config.specAt(h.timestamp.add(U256.ofU64(12)));
    World w = this.headState();
    BlockEnv env = BlockEnv(h.coinbase, h.number.add(U256.one()), h.timestamp.add(U256.ofU64(12)), h.gasLimit,
                            h.prevRandao, nextBaseFee(h), blobGasPrice(spec, nextExcessBlobGas(spec, h)), this.chainId,
                            this.ancestorHashes(h));
    U256 from = hexU256(c.member("from"));
    U256 to = hexU256(c.member("to"));
    u8[] data = c.member("input") is not null ? hexBytes(c.member("input")) : hexBytes(c.member("data"));
    U256 gas = c.member("gas") is not null ? hexU256(c.member("gas")) : h.gasLimit;
    Evm evm = Evm(w, env, TxEnv(from, U256.zero(), U256[].filled(0, U256.zero())), spec.table, spec, null);
    w.warmAddress(from);
    w.warmAddress(to);
    Message m = Message(from, to, to, hexU256(c.member("value")), data, gas.low() as@ i64, false, 0, true, false);
    w.record();
    Outcome o = processMessage(evm, m);
    w.undo(w.seal());
    match (o.halt) {
      Revert(d): { return Answer.reverted(d); }
      Failure(why): { return Answer.error(-32000, why); }
      Stop: { }
      Return(_): { }
    }
    return Answer.ok(str(bytesToHex(o.output())));
  }

  /**
   * engine_getBlobs: the mempool's blobs, for versioned hashes the consensus client has seen in a block or
   * gossip. V1 answers each hash with its blob and proof or null; V2 (Osaka) answers with each blob's cell
   * proofs, and with null for the whole call if any blob is missing.
   */
  Answer getBlobs(this, i32 version, JsonArray ps) {
    JsonArray? hashes = ps.len() > 0 ? ps.get(0).array() : null;
    if (hashes is null) { return Answer.error(-32602, "no versioned hashes"); }
    if (hashes!.len() > 128) { return Answer.error(-38004, "too large request"); }
    JsonArray out = JsonArray.create();
    for (i32 i = 0; i < hashes!.len(); i++) {
      Sidecar? sc = this.sidecars.get(hexU256(hashes!.get(i)));
      if (sc is not null && sc!.proofs.len() != (version == 2 ? CELLS_PER_BLOB : 1)) { sc = null; }
      if (sc is null) {
        if (version == 2) { return Answer.ok(JsonValue.Null); }
        out.push(JsonValue.Null);
        continue;
      }
      JsonObject o = JsonObject.create();
      o.push("blob".toBytes(), str(bytesToHex(sc!.blob)));
      if (version == 1) {
        o.push("proof".toBytes(), str(bytesToHex(sc!.proofs[0])));
      } else {
        JsonArray cells = JsonArray.create();
        for (i32 j = 0; j < sc!.proofs.len(); j++) { cells.push(str(bytesToHex(sc!.proofs[j]))); }
        o.push("proofs".toBytes(), JsonValue.Array(cells));
      }
      out.push(JsonValue.Object(o));
    }
    return Answer.ok(JsonValue.Array(out));
  }

  /**
   * Redo a log of `records`, written by an earlier run on the same genesis. A record cut short — the
   * process stopped while appending it — ends the replay there, and `good` says how much of the log to
   * keep. A record that is whole and does not apply is an error: the log is not this chain's.
   */
  async Replayed replay(this, u8[] log) {
    i32 at = 0;
    i32 blocks = 0;
    bool lookedAhead = false;
    // Blocks of the log that could not run: on a fork finality has since ruled out, whose parent state the store
    // cannot reach (its undo records gone with finality). A fork choice that named one is passed over too.
    Map<U256, bool> skipped = Map.create(hashU256, eqU256);
    await this.adoptFromStore();
    while (at < log.len()) {
      i32 n = rlpLength(log, at);
      if (n < 0) { break; }
      u8[] rec = u8[].filled(n, 0);
      for (i32 i = 0; i < n; i++) { rec[i] = log[at + i]; }
      Decoded d = decode(rec);
      if (!d.ok || !isList(d.item) || itemsOf(d.item).len() < 2) { return Replayed(at, blocks, "record at byte \{at} is malformed"); }
      Item[] f = itemsOf(d.item);
      u8[] kind = bytesOf(f[0]);
      if (kind.len() == 1 && kind[0] == RECORD_BLOCK) {
        u8[] raw = bytesOf(f[1]);
        Spec spec = this.config.specAt(blockTimestamp(raw));
        BlockDecode bd = decodeBlock(spec, raw);
        if (bd.block is null) { return Replayed(at, blocks, "block at byte \{at}: \{bd.error}"); }
        Block b = bd.block!;
        if (this.restoredAt is not null && b.header.hash.eq(this.restoredAt!)) { this.restoredLogged = true; }
        if (this.restoredAt is not null && !b.header.number.gt(this.restoredNumber)) {
          await this.adoptLogged(spec, b);
        } else {
          // The first block to run: every block at or below the store's that the log has later is adopted first,
          // so that the store can be moved across them (a side chain imported after the main chain's later blocks).
          if (this.restoredAt is not null && !lookedAhead) {
            await this.adoptAhead(log, at + n);
            lookedAhead = true;
          }
          if (this.db is not null) { await this.prepareBlock(spec, b); }
          Answer a = this.importBlock(spec, b);
          string st = a.result!.member("status")!.text()!;
          // A block on a fork the snapshot's finality ruled out has no parent state to run on, and is
          // skipped as finality would have dropped it; anything else that does not run is a broken log.
          if (st == "INVALID") { return Replayed(at, blocks, "block at byte \{at} is \{st} on replay"); }
          if (st == "VALID") { blocks++; } else { skipped.set(b.header.hash, true); }
        }
      } else if (kind.len() == 1 && kind[0] == RECORD_BASE && f.len() >= 2) {
        Header[] hs = Header[].filled(f.len() - 1, this.headHeader());
        for (i32 k = 1; k < f.len(); k++) {
          string[] why = [""];
          u8[] raw = bytesOf(f[k]);
          Header? h = headerOf(this.config.specAt(timestampOf(decode(raw).item)), decode(raw).item, why);
          if (h is null) { return Replayed(at, blocks, "a base record's header at byte \{at}: \{why[0]}"); }
          hs[k - 1] = h!;
        }
        Header[] ancestors = Header[].filled(hs.len() - 1, hs[0]);
        for (i32 k = 1; k < hs.len(); k++) { ancestors[k - 1] = hs[k]; }
        this.rebase(hs[0], ancestors);
        // A rebase forgets every block; the store's own is taken again, and the log looked ahead of again.
        await this.adoptFromStore();
        lookedAhead = false;
      } else if (kind.len() == 1 && kind[0] == RECORD_CHOICE && f.len() == 4) {
        U256 head = U256.fromBytes(bytesOf(f[1]), 0, 32);
        if (!this.blocks.has(head) && skipped.has(head)) {
          at += n;
          continue;
        }
        if (this.db is not null && this.blocks.has(head)) { await this.moveToAsync(head); }
        if (!this.choose(head, U256.fromBytes(bytesOf(f[2]), 0, 32), U256.fromBytes(bytesOf(f[3]), 0, 32))) {
          return Replayed(at, blocks, "fork choice at byte \{at} names a block the log has not");
        }
      } else {
        return Replayed(at, blocks, "record at byte \{at} is of no kind this knows");
      }
      at += n;
    }
    // What was replayed is already in the log.
    this.records = Vec.create();
    return Replayed(at, blocks, "");
  }

  /**
   * A block of the log at or below the store's: the state already includes it, so it is recorded, not run — with
   * its change set from its undo record, so that a reorg can still take the store back across it, and its
   * receipts, kept with its state.
   */
  async void adoptLogged(this, Spec spec, Block b) {
    this.adopt(spec, b);
    await this.loadUndo(b.header);
    if (this.db is not null) {
      u8[]? kept = await this.db!.store.chunks(receiptsKey(b.header.hash));
      Archived? a = this.archive.get(b.header.hash);
      if (kept is not null && a is not null) { a!.receipts = receiptsOf(kept!); }
    }
  }

  /** The log's blocks from `from` on that are at or below the store's, adopted, up to a rebase (which forgets them). */
  async void adoptAhead(this, u8[] log, i32 from) {
    i32 at = from;
    while (at < log.len()) {
      i32 n = rlpLength(log, at);
      if (n < 0) { return; }
      u8[] rec = u8[].filled(n, 0);
      rec.copyFrom(log, at, 0, n);
      at += n;
      Decoded d = decode(rec);
      if (!d.ok || !isList(d.item) || itemsOf(d.item).len() < 2) { return; }
      Item[] f = itemsOf(d.item);
      u8[] kind = bytesOf(f[0]);
      if (kind.len() == 1 && kind[0] == RECORD_BASE) { return; }
      if (kind.len() != 1 || kind[0] != RECORD_BLOCK) { continue; }
      u8[] raw = bytesOf(f[1]);
      Spec spec = this.config.specAt(blockTimestamp(raw));
      BlockDecode bd = decodeBlock(spec, raw);
      if (bd.block is null || bd.block!.header.number.gt(this.restoredNumber)) { continue; }
      if (bd.block!.header.hash.eq(this.restoredAt!)) { this.restoredLogged = true; }
      await this.adoptLogged(spec, bd.block!);
    }
  }

  /** The block a JSON-RPC block parameter names: a tag, a number on the canonical chain, or `{blockHash}`. */
  U256? blockFor(this, JsonValue? p) {
    if (p is null || p!.isNull()) { return this.head; }
    JsonValue? byHash = p!.member("blockHash");
    if (byHash is not null) { return this.archived(hexU256(byHash)) is not null ? hexU256(byHash) : null; }
    JsonValue? byNumber = p!.member("blockNumber");
    string tag = (byNumber ?? p!).text() ?? "latest";
    if (tag == "latest" || tag == "pending") { return this.head; }
    if (tag == "safe") { return this.archive.has(this.safe) ? this.safe : null; }
    if (tag == "finalized") { return this.archive.has(this.finalized) ? this.finalized : null; }
    U256 n = tag == "earliest" ? U256.zero() : (U256.fromHex(tag) ?? U256.ofU64(0xFFFFFFFFFFFFFFFF));
    if (n.gt(this.blocks.get(this.head)!.header.number)) { return null; }
    return this.canonicalAt(n);
  }

  /**
   * The state after the block `p` names, which the world is moved to. Null for a block whose state is gone:
   * the world reaches the unfinalized blocks, the finalized one, and the `states` canonical blocks below it.
   */
  World? stateAt(this, JsonValue? p) {
    U256? b = this.blockFor(p);
    if (b is null || !this.blocks.has(b!) || !this.moveTo(b!)) { return null; }
    return this.world;
  }

  /** The index of a canonical transaction in its block, or −1. */
  i32 txWhere(this, U256 hash) {
    TxAt? t = this.txAt(hash);
    if (t is null) { return -1; }
    Archived? a = this.archived(t!.block);
    if (a is null) { return -1; }
    U256? c = this.canonicalAt(a!.header.number);
    if (c is null || !c!.eq(t!.block) || a!.header.number.gt(this.blocks.get(this.head)!.header.number)) { return -1; }
    return t!.index;
  }

  /** A transaction still in the mempool, as `eth_getTransactionByHash` reports one: with no block. */
  Answer pendingTx(this, U256 hash) {
    for (i32 i = 0; i < this.mempool.len(); i++) {
      DecodedTx d = decodeWith(this.mempool.get(i), this.chainId, this.senders);
      if (d.hash.eq(hash)) { return Answer.ok(txJson(this.mempool.get(i), this.chainId, null, 0, this.senders)); }
    }
    return Answer.ok(JsonValue.Null);
  }

  /**
   * eth_getLogs over a range of canonical blocks or one block by hash, filtered by address (one or a list)
   * and by topics position by position (null for any, one, or a list of alternatives).
   */
  Answer getLogs(this, JsonArray ps) {
    JsonValue? f = arg(ps, 0);
    if (f is null || f!.object() is null) { return Answer.error(-32602, "no filter"); }
    Vec<U256> blocks = Vec.create();
    if (f!.member("blockHash") is not null) {
      U256 h = hexU256(f!.member("blockHash"));
      if (this.archived(h) is null) { return Answer.error(-32000, "unknown block"); }
      blocks.push(h);
    } else {
      U256? from = this.blockFor(f!.member("fromBlock"));
      U256? to = this.blockFor(f!.member("toBlock"));
      if (from is null || to is null) { return Answer.ok(JsonValue.Array(JsonArray.create())); }
      U256 lo = this.archived(from!)!.header.number;
      U256 hi = this.archived(to!)!.header.number;
      if (hi.sub(lo).gt(U256.ofU64(10000)) && !lo.gt(hi)) { return Answer.error(-32005, "query covers more than 10000 blocks"); }
      for (U256 n = lo; !n.gt(hi); n = n.add(U256.one())) {
        U256? h = this.canonicalAt(n);
        if (h is not null) { blocks.push(h!); }
      }
    }
    U256[] addresses = U256[].filled(0, U256.zero());
    JsonValue? av = f!.member("address");
    if (av is not null && !av!.isNull()) {
      JsonArray? list = av!.array();
      if (list is null) { addresses = [hexU256(av)]; }
      else {
        addresses = U256[].filled(list!.len(), U256.zero());
        for (i32 i = 0; i < list!.len(); i++) { addresses[i] = hexU256(list!.get(i)); }
      }
    }
    JsonArray topics = f!.member("topics")?.array() ?? JsonArray.create();
    JsonArray out = JsonArray.create();
    for (i32 b = 0; b < blocks.len(); b++) {
      Archived? held = this.archived(blocks.get(b));
      if (held is null) { continue; }
      Archived a = held!;
      i32 logIndex = 0;
      for (i32 t = 0; t < a.receipts.len(); t++) {
        Receipt r = a.receipts[t];
        for (i32 l = 0; l < r.logs.len(); l++) {
          if (logMatches(r.logs[l], addresses, topics)) { out.push(logJson(r.logs[l], a.header, r.txHash, t, logIndex)); }
          logIndex++;
        }
      }
    }
    return Answer.ok(JsonValue.Array(out));
  }

  /**
   * eth_estimateGas: the least gas limit with which the call succeeds, by bisection between the intrinsic
   * cost and the block's gas limit, each try a transaction run on the head's state and undone. The run
   * charges nothing for gas, as geth's does, so the sender needs only the value it sends.
   */
  Answer estimateGas(this, JsonArray ps) {
    JsonValue? c = arg(ps, 0);
    if (c is null || c!.object() is null) { return Answer.error(-32602, "no call object"); }
    Header h = this.blocks.get(this.head)!.header;
    U256 from = hexU256(c!.member("from"));
    World w = this.headState();
    JsonValue? toV = c!.member("to");
    U256? to = toV is null || toV!.isNull() ? null : hexU256(toV);
    u8[] input = c!.member("input") is not null ? hexBytes(c!.member("input")) : hexBytes(c!.member("data"));
    Transaction tx = Transaction(2, U256.ofU64(w.nonce(from)), U256.zero(), U256.zero(), U256.zero(), h.gasLimit, to,
                                 hexU256(c!.member("value")), input, Vec<AccessEntry>.create().toArray(), U256.zero(),
                                 U256[].filled(0, U256.zero()), Vec<Authorization>.create().toArray(), from);
    i64 lo = intrinsicGas(tx) - 1;
    i64 hi = h.gasLimit.low() as@ i64;
    Spec spec = this.config.specAt(h.timestamp.add(U256.ofU64(12)));
    if (spec.isOsaka && hi > 16777216) { hi = 16777216; }
    Processed first = this.tryRun(spec, h, tx, hi);
    if (first.invalid != "") { return Answer.error(-32000, first.invalid); }
    if (!first.success) { return Answer.reverted(first.output); }
    while (hi - lo > 1) {
      i64 mid = lo + (hi - lo) / 2;
      if (this.tryGas(spec, h, tx, mid) == "") { hi = mid; } else { lo = mid; }
    }
    return Answer.ok(str(U256.ofU64(hi as@ u64).toHex()));
  }

  /** "" when `tx` with gas limit `gas` succeeds as the next block's first transaction; otherwise why not. */
  string tryGas(this, Spec spec, Header h, Transaction tx, i64 gas) {
    Processed p = this.tryRun(spec, h, tx, gas);
    if (p.invalid != "") { return p.invalid; }
    return p.success ? "" : "execution reverted";
  }

  /** `tx` with gas limit `gas` run as the next block's first transaction, and undone. */
  Processed tryRun(this, Spec spec, Header h, Transaction tx, i64 gas) {
    tx.gasLimit = U256.ofU64(gas as@ u64);
    BlockEnv env = BlockEnv(h.coinbase, h.number.add(U256.one()), h.timestamp.add(U256.ofU64(12)), h.gasLimit,
                            h.prevRandao, U256.zero(), U256.zero(), this.chainId, this.ancestorHashes(h));
    this.world.record();
    Processed p = processTransaction(spec, this.world, env, tx, h.gasLimit.low() as@ i64, spec.maxBlobGasPerBlock, null);
    this.world.undo(this.world.seal());
    return p;
  }

  /**
   * eth_feeHistory: base fees and gas-used ratios for the last `count` canonical blocks, and the next base
   * fee. Reward percentiles are each block's least effective tip, which is honest for the blocks a devnet
   * makes and short of what a busy chain's distribution would say.
   */
  Answer feeHistory(this, JsonArray ps) {
    U256 count = hexU256(arg(ps, 0));
    if (count.isZero() || count.gt(U256.ofU64(1024))) { count = U256.ofU64(count.isZero() ? 1 : 1024); }
    U256? newest = this.blockFor(arg(ps, 1));
    if (newest is null) { return Answer.error(-32000, "unknown block"); }
    JsonArray? percentiles = arg(ps, 2)?.array();
    U256 top = this.archived(newest!)!.header.number;
    U256 oldest = count.gt(top) ? U256.zero() : top.sub(count).add(U256.one());
    // Not from before the history that is kept (on a store it is all kept, on disk).
    if (this.db is null && this.keptFrom > 1 && oldest.lt(U256.ofU64(this.keptFrom))) { oldest = U256.ofU64(this.keptFrom); }
    JsonArray baseFees = JsonArray.create();
    JsonArray ratios = JsonArray.create();
    JsonArray rewards = JsonArray.create();
    Header last = this.archived(newest!)!.header;
    for (U256 n = oldest; !n.gt(top); n = n.add(U256.one())) {
      Archived a = this.archived(this.canonicalAt(n)!)!;
      Header h = a.header;
      baseFees.push(str(h.baseFee.toHex()));
      f64 ratio = h.gasLimit.isZero() ? 0.0 : (h.gasUsed.low() as~ f64) / (h.gasLimit.low() as~ f64);
      ratios.push(JsonValue.Number(ratio, "\{ratio}".toBytes()));
      if (percentiles is not null) {
        U256 tip = U256.zero();
        for (i32 i = 0; i < a.receipts.len(); i++) {
          U256 t = a.receipts[i].effectiveGasPrice.sub(h.baseFee);
          if (i == 0 || t.lt(tip)) { tip = t; }
        }
        JsonArray r = JsonArray.create();
        for (i32 i = 0; i < percentiles!.len(); i++) { r.push(str(tip.toHex())); }
        rewards.push(JsonValue.Array(r));
      }
      last = h;
    }
    baseFees.push(str(nextBaseFee(last).toHex()));
    JsonObject o = JsonObject.create();
    o.push("oldestBlock".toBytes(), str(oldest.toHex()));
    o.push("baseFeePerGas".toBytes(), JsonValue.Array(baseFees));
    o.push("gasUsedRatio".toBytes(), JsonValue.Array(ratios));
    if (percentiles is not null) { o.push("reward".toBytes(), JsonValue.Array(rewards)); }
    return Answer.ok(JsonValue.Object(o));
  }

  /**
   * Import every orphan whose parent is now here, and their orphans in turn. Answers how many went in. The
   * sync target is cleared once it is a block this has.
   */
  /** `adoptOrphans`, with each one's block prepared first when the engine is on a store. */
  async i32 adoptOrphansAsync(this) {
    if (this.db is null) { return this.adoptOrphans(); }
    i32 n = 0;
    while (true) {
      U256[] hashes = this.orphans.keys();
      bool ready = false;
      for (i32 i = 0; i < hashes.len(); i++) {
        Orphan o = this.orphans.get(hashes[i])!;
        if (!this.blocks.has(o.block.header.parentHash)) { continue; }
        await this.prepareBlock(o.spec, o.block);
        ready = true;
      }
      if (!ready) { break; }
      i32 got = this.adoptOrphans();
      n += got;
      if (got == 0) { break; }
    }
    return n;
  }

  i32 adoptOrphans(this) {
    i32 n = 0;
    bool more = true;
    while (more) {
      more = false;
      U256[] hashes = this.orphans.keys();
      for (i32 i = 0; i < hashes.len(); i++) {
        Orphan o = this.orphans.get(hashes[i])!;
        if (!this.blocks.has(o.block.header.parentHash)) { continue; }
        this.orphans.remove(hashes[i]);
        Answer a = this.importBlock(o.spec, o.block);
        if (a.result!.member("status")!.text()! == "VALID") {
          n++;
          more = true;
        }
      }
    }
    if (this.syncTarget is not null && this.blocks.has(this.syncTarget!)) { this.syncTarget = null; }
    return n;
  }

  /** The nonce after `from`'s run of mempool transactions starting at `nonce`. */
  u64 pendingNonce(this, U256 from, u64 nonce) {
    bool moved = true;
    while (moved) {
      moved = false;
      for (i32 i = 0; i < this.mempool.len(); i++) {
        DecodedTx d = decodeWith(this.mempool.get(i), this.chainId, this.senders);
        if (d.error == "" && d.tx.sender.eq(from) && d.tx.nonce.eq(U256.ofU64(nonce))) {
          nonce++;
          moved = true;
        }
      }
    }
    return nonce;
  }

  /**
   * A mempool transaction as peers exchange it: a blob transaction with its sidecars, in the form the next
   * block's fork wants; any other as it is. Null for a blob transaction whose sidecars this has not got.
   */
  u8[]? networkForm(this, Item tx) {
    u8[] raw = rawOf(tx);
    if (raw.len() == 0 || raw[0] != 0x03) { return raw; }
    U256[] hashes = decodeWith(tx, this.chainId, this.senders).tx.blobHashes;
    bool osaka = this.config.specAt(this.headHeader().timestamp.add(U256.ofU64(12))).isOsaka;
    Sidecar[] scs = Sidecar[].defaulted(hashes.len());
    for (i32 i = 0; i < hashes.len(); i++) {
      Sidecar? sc = this.sidecars.get(hashes[i]);
      if (sc is null || sc!.proofs.len() != (osaka ? CELLS_PER_BLOB : 1)) { return null; }
      scs[i] = sc!;
    }
    return wrap(raw, scs, osaka);
  }

  /** Whether this client has the block, executed. */
  bool has(this, U256 hash) { return this.blocks.has(hash); }

  /**
   * The extra changes a block's commit carries: its receipts, its RLP, and where the blocks that left the
   * history are. Taken here, so the next commit does not carry them again; if this one fails the store is
   * opened again and they are lost with it, which costs only answers about blocks that old.
   */
  Change[] withBlock(this, Header h, u8[] rlp, Receipt[] receipts, ChangeSet cs, Change[] pruned, Change[] state) {
    Vec<Change> out = Vec.create();
    Change[] r = receiptsChanges(h.hash, receipts);
    for (i32 i = 0; i < r.len(); i++) { out.push(r[i]); }
    Change[] k = blockChanges(h.hash, rlp);
    for (i32 i = 0; i < k.len(); i++) { out.push(k[i]); }
    // Its undo record, in the same commit as its state, so that a store holding one holds the other.
    Change[] u = undoChanges(h.number.low(), h.hash, cs);
    for (i32 i = 0; i < u.len(); i++) {
      out.push(u[i]);
      this.undo.bytes += (u[i].key.len() + u[i].value!.len()) as i64;
    }
    for (i32 i = 0; i < state.len(); i++) { this.undo.stateBytes += (state[i].key.len() + (state[i].value is null ? 0 : state[i].value!.len())) as i64; }
    for (i32 i = 0; i < pruned.len(); i++) { out.push(pruned[i]); }
    for (i32 i = 0; i < this.persisting.keys.len(); i++) { out.push(Change(this.persisting.keys.get(i), this.persisting.values.get(i))); }
    this.persisting = Persisting.create();
    return out.toArray();
  }

  /**
   * Deletes for the undo records no reorg can need any more: those of finalized blocks, and past `this.undo.limit`
   * below `number` (the block about to commit) whatever finality says — then a reorg that deep cannot be undone
   * after a restart, and the notice says so.
   */
  async Change[] undoPrunes(this, u64 number) {
    // Up to and including the finalized block: no reorg takes the store below it.
    Header? f = this.headerByHash(this.finalized);
    u64 upTo = f is null ? 0 : f!.number.low() + 1;
    // Finality caught up again: the next stall is told of too.
    if (number <= this.undo.limit || number - this.undo.limit <= upTo) { this.undo.warned = false; }
    if (number > this.undo.limit && number - this.undo.limit > upTo) {
      upTo = number - this.undo.limit;
      if (!this.undo.warned) {
        this.undo.warned = true;
        this.undo.notice = "finality is more than \{this.undo.limit} blocks behind: undo records below block \{upTo} deleted; a reorg that deep cannot be followed after a restart";
      }
    }
    if (upTo <= this.undo.prunedTo) { return Change[].filled(0, Change(u8[].filled(0, 0), null)); }
    Vec<Change> old = await this.db!.store.range(undoFrom(this.undo.prunedTo), undoFrom(upTo), 0x7fffffff);
    Change[] out = Change[].filled(old.len(), Change(u8[].filled(0, 0), null));
    for (i32 i = 0; i < old.len(); i++) { out[i] = Change(old.get(i).key, null); }
    this.undo.prunedTo = upTo;
    return out;
  }

  /** A block adopted without running (at or below the store's): its change set from its undo record, if kept. */
  async void loadUndo(this, Header h) {
    Node? n = this.blocks.get(h.hash);
    if (this.db is null || n is null || n!.changes is not null) { return; }
    u8[]? raw = await this.db!.store.chunks(undoKey(h.number.low(), h.hash));
    if (raw is null) { return; }
    Node node = n!;
    node.changes = decodeChangeSet(raw!);
  }

  /**
   * `engine_getPayloadBodiesByHashV1`: each block's body, in the order asked, null for one this node does not have —
   * in memory or on its store.
   */
  Answer bodiesByHash(this, JsonArray ps) {
    JsonArray? hashes = arg(ps, 0)?.array();
    if (hashes is null) { return Answer.error(-32602, "the first parameter must be an array of block hashes"); }
    if (hashes!.len() > MAX_BODIES) { return Answer.error(-38004, "Too large request"); }
    JsonArray out = JsonArray.create();
    for (i32 i = 0; i < hashes!.len(); i++) {
      Archived? a = this.archived(hexU256(hashes!.get(i)));
      out.push(a is null ? JsonValue.Null : payloadBody(a!));
    }
    return Answer.ok(JsonValue.Array(out));
  }

  /**
   * `engine_getPayloadBodiesByRangeV1`: the canonical bodies from `start`, `count` of them, null for one this node
   * does not have, and none past its head — the spec forbids trailing nulls for blocks not yet known.
   */
  Answer bodiesByRange(this, JsonArray ps) {
    U256 start = hexU256(arg(ps, 0));
    U256 count = hexU256(arg(ps, 1));
    if (start.isZero() || count.isZero()) { return Answer.error(-32602, "start and count must be at least 1"); }
    if (count.gt(U256.ofI32(MAX_BODIES))) { return Answer.error(-38004, "Too large request"); }
    U256 head = this.blocks.get(this.head)!.header.number;
    JsonArray out = JsonArray.create();
    U256 n = start;
    for (i32 i = 0; i < (count.low() as! i32) && !n.gt(head); i++) {
      U256? h = this.canonicalAt(n);
      Archived? a = h is null ? null : this.archived(h!);
      out.push(a is null ? JsonValue.Null : payloadBody(a!));
      n = n.add(U256.one());
    }
    return Answer.ok(JsonValue.Array(out));
  }

  /** A block by hash: held in memory, or on a store read from it (`blocks.wac`), or null. */
  Archived? archived(this, U256 hash) {
    Archived? a = this.archive.get(hash);
    if (a is not null || this.db is null) { return a; }
    u8[]? whole = this.db!.store.chunksNow(blockKey(hash));
    if (whole is null) { return null; }
    u8[] rlp = whole!;
    BlockDecode bd = decodeBlock(this.config.specAt(blockTimestamp(rlp)), rlp);
    if (bd.block is null) { return null; }
    Block b = bd.block!;
    u8[]? rs = this.db!.store.chunksNow(receiptsKey(hash));
    Receipt[] receipts = rs is null ? Receipt[].filled(0, Receipt(U256.zero(), 0, U256.zero(), null, false, 0, 0, U256.zero(), 0, U256.zero(), null, Log[].filled(0, Log(U256.zero(), U256[].filled(0, U256.zero()), u8[].filled(0, 0))), u8[].filled(0, 0))) : receiptsOf(rs!);
    return Archived(b.header, b.txs, b.withdrawals, receipts, rlp.len());
  }

  /** The canonical block at `n`: held in memory, about to be written, or written; null if none. */
  U256? canonicalAt(this, U256 n) {
    U256? h = this.canonical.get(n);
    if (h is not null || this.db is null) { return h; }
    h = this.persisting.canonical.get(n);
    if (h is not null) { return h; }
    u8[]? v = this.db!.store.getNow(canonicalKey(n.low()));
    return v is null ? null : U256.fromBytes(v!, 0, 32);
  }

  /** Where a canonical transaction is: held in memory, about to be written, or written. */
  TxAt? txAt(this, U256 hash) {
    TxAt? t = this.txIndex.get(hash);
    if (t is not null || this.db is null) { return t; }
    t = this.persisting.txs.get(hash);
    if (t is not null) { return t; }
    u8[]? v = this.db!.store.getNow(txKey(hash));
    return v is null ? null : TxAt(U256.fromBytes(v!, 0, 32), placeIndex(v!));
  }

  /** A canonical block's header by number, or any kept block's by hash, from the archive. */
  Header? headerByNumber(this, u64 n) {
    U256? h = this.canonicalAt(U256.ofU64(n));
    if (h is null || U256.ofU64(n).gt(this.blocks.get(this.head)!.header.number)) { return null; }
    Archived? a = this.archived(h!);
    return a is null ? null : a!.header;
  }

  Header? headerByHash(this, U256 hash) {
    Archived? a = this.archived(hash);
    return a is null ? null : a!.header;
  }

  /** A block's body as eth's BlockBodies carries it — [transactions, ommers, withdrawals] — or null. */
  Item? bodyItem(this, U256 hash) {
    Archived? a = this.archived(hash);
    if (a is null) { return null; }
    Item[] ws = Item[].filled(a!.withdrawals.len(), Item.Bytes(u8[].filled(0, 0)));
    for (i32 i = 0; i < ws.len(); i++) {
      Withdrawal wd = a!.withdrawals[i];
      ws[i] = Item.List([Item.Bytes(u256Bytes(wd.index)), Item.Bytes(u256Bytes(wd.validator)), Item.Bytes(addressBytes(wd.address)),
                         Item.Bytes(u256Bytes(wd.amount))]);
    }
    return Item.List([Item.List(a!.txs), Item.List(Item[].filled(0, Item.Bytes(u8[].filled(0, 0)))), Item.List(ws)]);
  }

  /** A block's receipts as eth/69 carries them — [type, status, cumulative gas, logs] each, no bloom — or null. */
  Item? receiptsItem(this, U256 hash) {
    Archived? a = this.archived(hash);
    if (a is null) { return null; }
    Item[] rs = Item[].filled(a!.receipts.len(), Item.Bytes(u8[].filled(0, 0)));
    for (i32 i = 0; i < rs.len(); i++) {
      Receipt r = a!.receipts[i];
      Item[] logs = Item[].filled(r.logs.len(), Item.Bytes(u8[].filled(0, 0)));
      for (i32 l = 0; l < logs.len(); l++) {
        Item[] topics = Item[].filled(r.logs[l].topics.len(), Item.Bytes(u8[].filled(0, 0)));
        for (i32 t = 0; t < topics.len(); t++) { topics[t] = Item.Bytes(r.logs[l].topics[t].toBytes()); }
        logs[l] = Item.List([Item.Bytes(addressBytes(r.logs[l].address)), Item.List(topics), Item.Bytes(r.logs[l].data)]);
      }
      rs[i] = Item.List([Item.Bytes(u256Bytes(U256.ofI32(r.txType))), Item.Bytes(r.success ? [1 as u8] : u8[].filled(0, 0)),
                         Item.Bytes(u256Bytes(U256.ofU64(r.cumulativeGasUsed as@ u64))), Item.List(logs)]);
    }
    return Item.List(rs);
  }

  /**
   * The block whose state the store holds, read from the store — its commit kept the block, its receipts and its
   * undo record (`withBlock`) — and adopted, before the log's replay runs anything: the engine is then where the
   * store is from the start. Without it, a block of the log above the store's that came before the store's own
   * block in the log (a side chain imported after the main chain's later blocks, then a reorg to it stopped
   * part way) ran on a store the engine thought was elsewhere, failed, and the chain after it was lost. Its
   * parent may not be known yet; the log adopts the ancestors before anything moves across them.
   */
  async bool adoptFromStore(this) {
    if (this.db is null || this.restoredAt is null || this.blocks.has(this.restoredAt!)) { return false; }
    u8[]? raw = await this.db!.store.chunks(blockKey(this.restoredAt!));
    if (raw is null) { return false; }
    Spec spec = this.config.specAt(blockTimestamp(raw!));
    BlockDecode bd = decodeBlock(spec, raw!);
    if (bd.block is null || !bd.block!.header.hash.eq(this.restoredAt!)) { return false; }
    Block b = bd.block!;
    this.adopt(spec, b);
    await this.loadUndo(b.header);
    u8[]? kept = await this.db!.store.chunks(receiptsKey(b.header.hash));
    Archived? a = this.archive.get(b.header.hash);
    if (kept is not null && a is not null) { a!.receipts = receiptsOf(kept!); }
    return true;
  }

  /**
   * After the log's replay: the store's block recorded for the log when the log never got it — a stop after the
   * store's commit and before the log's write. Without it the engine had no block for the state it was at, and
   * the payload given again was SYNCING for good. True when it was missing.
   */
  async bool adoptStored(this) {
    await this.adoptFromStore();
    if (this.restoredAt is null || this.restoredLogged || !this.blocks.has(this.restoredAt!)) { return false; }
    u8[]? raw = await this.db!.store.chunks(blockKey(this.restoredAt!));
    if (raw is null) { return false; }
    // Its ancestors the log lost too, from the store (each block's commit keeps it, and none is deleted). The log's
    // appends are not synced, so after a power cut it can end blocks before the store does — every block since its
    // last write to the disk gone (crash.wac's `torn` mode: a run of five) — and the store's block, its parent
    // unknown, was connected to nothing: the head stayed at the log's last, and each payload given again was
    // SYNCING for good. Recorded oldest first, so the log is whole again.
    Vec<u8[]> lost = Vec.create();
    U256 p = this.blocks.get(this.restoredAt!)!.header.parentHash;
    while (!this.blocks.has(p)) {
      u8[]? pr = await this.db!.store.chunks(blockKey(p));
      if (pr is null) { break; }
      Spec ps = this.config.specAt(blockTimestamp(pr!));
      BlockDecode pd = decodeBlock(ps, pr!);
      if (pd.block is null || !pd.block!.header.hash.eq(p)) { break; }
      this.adopt(ps, pd.block!);
      await this.loadUndo(pd.block!.header);
      u8[]? kept = await this.db!.store.chunks(receiptsKey(p));
      Archived? a = this.archive.get(p);
      if (kept is not null && a is not null) { a!.receipts = receiptsOf(kept!); }
      lost.push(pr!);
      p = pd.block!.header.parentHash;
    }
    for (i32 i = lost.len() - 1; i >= 0; i--) { this.records.push(encode(Item.List([Item.Bytes([RECORD_BLOCK]), Item.Bytes(lost.get(i))]))); }
    this.records.push(encode(Item.List([Item.Bytes([RECORD_BLOCK]), Item.Bytes(raw!)])));
    this.restoredLogged = true;
    // And the head the log had, when it is an ancestor of the store's block, moved up to it: the store's block is
    // one this node called VALID and built on, and below it the store cannot go once finality has passed — so a
    // consensus client told the old head would give again blocks this node cannot run.
    if (lost.len() > 0 && this.descends(this.restoredAt!, this.head)) { this.choose(this.restoredAt!, this.safe, this.finalized); }
    return true;
  }

  /** Whether `a` is `b` or descends from it, by the blocks held. */
  bool descends(this, U256 a, U256 b) {
    Node? n = this.blocks.get(a);
    Node? anc = this.blocks.get(b);
    if (n is null || anc is null) { return false; }
    Header cur = n!.header;
    while (cur.number.gt(anc!.header.number)) {
      Node? up = this.blocks.get(cur.parentHash);
      if (up is null) { return false; }
      cur = up!.header;
    }
    return cur.hash.eq(b);
  }

  /** The head's header. */
  Header headHeader(this) { return this.blocks.get(this.head)!.header; }

  /**
   * A block from the log at or below the snapshot's: kept as a header and its transactions, without
   * running it, and when it is the snapshot's own block the world is now at it.
   */
  void adopt(this, Spec spec, Block b) {
    Header h = b.header;
    if (this.blocks.has(h.hash)) { return; }
    this.blocks.set(h.hash, Node(h, null));
    this.archive.set(h.hash, Archived(h, b.txs, b.withdrawals, Vec<Receipt>.create().toArray(), encodeBlock(spec, b).len()));
    if (h.hash.eq(this.restoredAt!)) { this.at = h.hash; }
  }

  /**
   * The state after the finalized block, as bytes to keep: rlp([1, block hash, block number, accounts]) with
   * each account [address, nonce, balance, code, [[slot, value]…]]. Null when the world cannot reach it.
   */
  u8[]? snapshot(this) {
    // On the store, the store is the snapshot.
    if (this.db is not null) { return null; }
    Node? f = this.blocks.get(this.finalized);
    if (f is null || !this.moveTo(this.finalized)) { return null; }
    World w = this.world;
    U256[] addrs = w.accounts.keys();
    Item[] accts = Item[].filled(addrs.len(), Item.Bytes(u8[].filled(0, 0)));
    for (i32 i = 0; i < addrs.len(); i++) {
      Account a = w.accounts.get(addrs[i])!;
      U256[] keys = a.storage.keys();
      Item[] slots = Item[].filled(keys.len(), Item.Bytes(u8[].filled(0, 0)));
      for (i32 k = 0; k < keys.len(); k++) {
        slots[k] = Item.List([Item.Bytes(keys[k].toBytes()), Item.Bytes(u256Bytes(a.storage.get(keys[k])!))]);
      }
      accts[i] = Item.List([Item.Bytes(addressBytes(addrs[i])), Item.Bytes(u256Bytes(U256.ofU64(a.nonce))),
                            Item.Bytes(u256Bytes(a.balance)), Item.Bytes(a.code), Item.List(slots)]);
    }
    u8[] out = encode(Item.List([Item.Bytes([1 as u8]), Item.Bytes(this.finalized.toBytes()),
                                 Item.Bytes(u256Bytes(f!.header.number)), Item.List(accts)]));
    this.moveTo(this.head);
    this.snapshotNumber = f!.header.number;
    return out;
  }

  /**
   * Start from a snapshot instead of the genesis's state: the world is the snapshot's, and replaying the
   * log then records the blocks up to its block and runs only those after. Why not, when it will not do.
   */
  string restore(this, u8[] bytes) {
    Decoded d = decode(bytes);
    if (!d.ok || !isList(d.item) || itemsOf(d.item).len() != 4) { return "the snapshot does not decode"; }
    Item[] f = itemsOf(d.item);
    World w = World.create();
    Item[] accts = itemsOf(f[3]);
    for (i32 i = 0; i < accts.len(); i++) {
      Item[] a = itemsOf(accts[i]);
      U256 addr = U256.fromBytes(bytesOf(a[0]), 0, 20);
      Account acct = w.touch(addr);
      acct.nonce = numberOf(bytesOf(a[1])).low();
      acct.balance = numberOf(bytesOf(a[2]));
      Item[] slots = itemsOf(a[4]);
      for (i32 k = 0; k < slots.len(); k++) {
        Item[] kv = itemsOf(slots[k]);
        acct.storage.set(U256.fromBytes(bytesOf(kv[0]), 0, 32), numberOf(bytesOf(kv[1])));
      }
      w.setCode(addr, bytesOf(a[3]));
    }
    w.endTransaction();
    this.world = w;
    this.restoredAt = U256.fromBytes(bytesOf(f[1]), 0, 32);
    this.restoredNumber = numberOf(bytesOf(f[2]));
    this.snapshotNumber = this.restoredNumber;
    return "";
  }

  /** The state at the head of the chain. */
  World headState(this) {
    this.moveTo(this.head);
    return this.world;
  }
}

/** The length of the RLP item starting at `at`, header included, or −1 if `b` ends before it does. */
i32 rlpLength(u8[] b, i32 at) {
  if (at >= b.len()) { return -1; }
  i32 p = b[at] as i32;
  i64 n = 0;
  if (p < 0x80) { n = 1; }
  else if (p < 0xb8) { n = 1 + (p - 0x80) as i64; }
  else if (p < 0xc0 || (p >= 0xf8)) {
    i32 ll = p < 0xc0 ? p - 0xb7 : p - 0xf7;
    if (at + ll >= b.len()) { return -1; }
    i64 len = 0;
    for (i32 i = 0; i < ll; i++) { len = len * 256 + (b[at + 1 + i] as i64); }
    n = 1 + (ll as i64) + len;
  } else { n = 1 + (p - 0xc0) as i64; }
  if ((at as i64) + n > (b.len() as i64)) { return -1; }
  return n as! i32;
}

/** The tip `eth_maxPriorityFeePerGas` suggests: 1 gwei, what a block with room to spare needs. */
static u64 SUGGESTED_TIP = 1000000000;

Answer unavailable() { return Answer.error(-32000, "the state of that block is not available"); }

/** Whether a log passes an eth_getLogs filter's addresses and topics. */
bool logMatches(Log l, U256[] addresses, JsonArray topics) {
  if (addresses.len() > 0) {
    bool any = false;
    for (i32 i = 0; i < addresses.len(); i++) { any = any || addresses[i].eq(l.address); }
    if (!any) { return false; }
  }
  for (i32 i = 0; i < topics.len(); i++) {
    JsonValue want = topics.get(i);
    if (want.isNull()) { continue; }
    if (i >= l.topics.len()) { return false; }
    JsonArray? alts = want.array();
    if (alts is null) {
      if (!hexU256(want).eq(l.topics[i])) { return false; }
    } else {
      bool any = alts!.len() == 0;
      for (i32 k = 0; k < alts!.len(); k++) { any = any || alts!.get(k).isNull() || hexU256(alts!.get(k)).eq(l.topics[i]); }
      if (!any) { return false; }
    }
  }
  return true;
}

/** A big-endian number of up to 32 bytes; empty is zero. */
U256 numberOf(u8[] b) { return b.len() == 0 ? U256.zero() : U256.fromBytes(b, 0, b.len()); }

// ── JSON helpers ─────────────────────────────────────────────────────────────────

JsonValue str(string s) { return JsonValue.Str(s.toBytes()); }

Answer status(string st, string latestValid, string why) {
  JsonObject o = JsonObject.create();
  o.push("status".toBytes(), str(st));
  o.push("latestValidHash".toBytes(), latestValid == "" ? JsonValue.Null : str(latestValid));
  o.push("validationError".toBytes(), why == "" ? JsonValue.Null : str(why));
  return Answer.ok(JsonValue.Object(o));
}

JsonValue forkchoiceResult(JsonValue payloadStatus) {
  JsonObject o = JsonObject.create();
  o.push("payloadStatus".toBytes(), payloadStatus);
  o.push("payloadId".toBytes(), JsonValue.Null);
  return JsonValue.Object(o);
}

/**
 * `engine_getClientVersionV1`: this client, one entry. The code is two letters the spec's table does not list (it
 * names the clients it knows); the commit is not known to a build, so it is zero, as the spec allows for "unknown".
 */
JsonValue clientVersion() {
  JsonObject o = JsonObject.create();
  o.push("code".toBytes(), str("WA"));
  o.push("name".toBytes(), str("wacuum"));
  o.push("version".toBytes(), str("v0.1.0"));
  o.push("commit".toBytes(), str("0x00000000"));
  JsonArray a = JsonArray.create();
  a.push(JsonValue.Object(o));
  return JsonValue.Array(a);
}

/** A block's ExecutionPayloadBodyV1: its transactions as their raw bytes, and its withdrawals. */
JsonValue payloadBody(Archived a) {
  JsonArray txs = JsonArray.create();
  for (i32 i = 0; i < a.txs.len(); i++) {
    // A typed transaction is its bytes; a legacy one is a list, whose encoding is its bytes.
    txs.push(str(bytesToHex(isList(a.txs[i]) ? encode(a.txs[i]) : bytesOf(a.txs[i]))));
  }
  JsonArray ws = JsonArray.create();
  for (i32 i = 0; i < a.withdrawals.len(); i++) {
    Withdrawal wd = a.withdrawals[i];
    JsonObject o = JsonObject.create();
    o.push("index".toBytes(), str(wd.index.toHex()));
    o.push("validatorIndex".toBytes(), str(wd.validator.toHex()));
    o.push("address".toBytes(), str(bytesToHex(addressBytes(wd.address))));
    o.push("amount".toBytes(), str(wd.amount.toHex()));
    ws.push(JsonValue.Object(o));
  }
  JsonObject b = JsonObject.create();
  b.push("transactions".toBytes(), JsonValue.Array(txs));
  // Every fork this client runs is after Shanghai, so a block always has a withdrawals list, if an empty one.
  b.push("withdrawals".toBytes(), JsonValue.Array(ws));
  return JsonValue.Object(b);
}

/** The most bodies one request may ask for (the spec's lower bound on what a client must serve). */
static i32 MAX_BODIES = 1024;

JsonValue capabilities() {
  string[] names = ["engine_newPayloadV1", "engine_newPayloadV2", "engine_newPayloadV3", "engine_newPayloadV4",
                    "engine_forkchoiceUpdatedV1", "engine_forkchoiceUpdatedV2", "engine_forkchoiceUpdatedV3",
                    "engine_getPayloadV3", "engine_getPayloadV4", "engine_getPayloadV5", "engine_getBlobsV1",
                    "engine_getBlobsV2", "engine_getPayloadBodiesByHashV1", "engine_getPayloadBodiesByRangeV1",
                    "engine_getClientVersionV1"];
  JsonArray a = JsonArray.create();
  for (i32 i = 0; i < names.len(); i++) { a.push(str(names[i])); }
  return JsonValue.Array(a);
}

/** A quantity or data field as a number, zero when absent or malformed. */
U256 hexU256(JsonValue? v) {
  if (v is null) { return U256.zero(); }
  string? s = v!.text();
  if (s is null || s! == "0x") { return U256.zero(); }
  return U256.fromHex(s!) ?? U256.zero();
}

u8[] hexBytes(JsonValue? v) {
  if (v is null) { return u8[].filled(0, 0); }
  return hexToBytes(v!.text() ?? "") ?? u8[].filled(0, 0);
}

/** A transaction's own encoding from its item in a block body: a legacy one's RLP, a typed one's bytes. */
/**
 * The hashes of a block's transactions, in order: from its receipts when it ran here, and from its body when
 * it did not (a block restored from a snapshot has none).
 */
U256[] txHashes(Archived a) {
  U256[] out = U256[].filled(a.txs.len(), U256.zero());
  for (i32 i = 0; i < out.len(); i++) {
    out[i] = i < a.receipts.len() ? a.receipts[i].txHash : U256.fromBytes(keccak256(rawOf(a.txs[i])), 0, 32);
  }
  return out;
}

export u8[] rawOf(Item it) { return isList(it) ? encode(it) : bytesOf(it); }

/** A transaction's bytes as the block body's item: a legacy one is its RLP list, a typed one opaque bytes. */
export Item? txItem(u8[] raw) {
  if (raw.len() == 0) { return null; }
  if ((raw[0] as i32) >= 0xc0) {
    Decoded d = decode(raw);
    return d.ok ? d.item : null;
  }
  return Item.Bytes(raw);
}

Withdrawal[] withdrawalsFrom(JsonValue? v) {
  JsonArray a = v?.array() ?? JsonArray.create();
  Withdrawal[] out = Withdrawal[].filled(a.len(), Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero()));
  for (i32 i = 0; i < a.len(); i++) {
    JsonValue w = a.get(i);
    out[i] = Withdrawal(hexU256(w.member("index")), hexU256(w.member("validatorIndex")), hexU256(w.member("address")),
                        hexU256(w.member("amount")));
  }
  return out;
}

Header headerFrom(JsonValue p) {
  u8[] bloom = hexBytes(p.member("logsBloom"));
  return Header(hexU256(p.member("parentHash")), U256.fromHex(EMPTY_OMMERS)!, hexU256(p.member("feeRecipient")),
                hexU256(p.member("stateRoot")), U256.zero(), hexU256(p.member("receiptsRoot")),
                bloom.len() == 256 ? bloom : u8[].filled(256, 0), U256.zero(), hexU256(p.member("blockNumber")),
                hexU256(p.member("gasLimit")), hexU256(p.member("gasUsed")), hexU256(p.member("timestamp")),
                hexBytes(p.member("extraData")), hexU256(p.member("prevRandao")), u8[].filled(8, 0),
                hexU256(p.member("baseFeePerGas")), U256.zero(), hexU256(p.member("blobGasUsed")),
                hexU256(p.member("excessBlobGas")), U256.zero(), U256.zero(), U256.zero());
}


/** 32 bytes as 0x and 64 digits, leading zeros kept: a hash, not a quantity. */
string hex32(U256 v) { return bytesToHex(v.toBytes()); }

/** A payload id: eight bytes, written in full. */
string hex8(U256 v) {
  u8[] b = v.toBytes();
  u8[] out = u8[].filled(8, 0);
  for (i32 i = 0; i < 8; i++) { out[i] = b[24 + i]; }
  return bytesToHex(out);
}

/** Param `i`, or JSON null when there are fewer. */
JsonValue? arg(JsonArray ps, i32 i) { return i < ps.len() ? ps.get(i) : null; }
