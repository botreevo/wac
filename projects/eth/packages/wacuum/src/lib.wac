// wacuum as a package: what a program that embeds the client imports from "wacuum".
//
// cmd/wacuum.wac is one such program, written against the files themselves; this is for programs in other
// repositories, which wac lets reach a project only through its `exports`. It is the engine and what a
// node built around it needs — a genesis to start from, the 256-bit word, hex, keys and signatures, and
// devp2p — not the EVM's insides.
//
// **One name per statement**, as wac's own `lib.wac` does it: reachability keeps an `export { … } from`
// list whole, so a program using one name would otherwise read whatever every name beside it needs.

export { U256 } from "./u256.wac";
export { hexToBytes } from "./hex.wac";
export { bytesToHex } from "./hex.wac";
export { Engine } from "./engine/engine.wac";
export { Answer } from "./engine/engine.wac";
export { Replayed } from "./engine/engine.wac";
export { answerRpc } from "./engine/rpc.wac";
export { Genesis } from "./chain/genesis.wac";
export { genesisFrom } from "./chain/genesis.wac";
export { Header } from "./chain/block.wac";
export { headerItem } from "./chain/block.wac";
export { systemContracts } from "./chain/dev.wac";
export { u256Bytes } from "./state/root.wac";
export { addressBytes } from "./evm/evm.wac";
export { publicKey } from "./p2p/secp.wac";
export { sign } from "./p2p/secp.wac";
export { recover } from "./p2p/secp.wac";
export { validKey } from "./p2p/secp.wac";
export { Network } from "./p2p/node.wac";
export { dial } from "./p2p/node.wac";
export { listen } from "./p2p/node.wac";
export { tend } from "./p2p/node.wac";
export { discover } from "./p2p/discovery.wac";
