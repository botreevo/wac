// wacuum on the devp2p network: the peers it has, what it answers them, and how it fills in a chain the
// consensus client asks for that it does not have.
//
// Each peer is one task reading that peer's messages. It answers requests from the engine's archive, and it
// hands a response to whichever task asked for it, by request id: a request is a ticket the reading task
// settles. The syncer is another task, which watches the engine's sync target and, when there is one, walks
// headers back from it to a block this node has, then fetches the bodies and imports them in order. All of
// it shares the one engine; the tasks take turns, so nothing else is needed to keep it consistent.

import { Sys, Socket } from "std";
import { Map, Vec, Ticket, TicketBase } from "core";
import { rlp.Item, rlp.encode, rlp.bytesOf, rlp.itemsOf, rlp.isList } from "@/lib.wac";
import { keccak256 } from "../crypto/keccak.wac";
import { U256 } from "../u256.wac";
import { bytesToHex, hexToBytes } from "../hex.wac";
import { hashU256, eqU256 } from "../state/world.wac";
import { Header, headerItem, headerOf, timestampOf, decodeBlock, BlockDecode, blockTimestamp } from "../chain/block.wac";
import { Spec } from "../evm/spec.wac";
import { Engine, Answer, rawOf } from "../engine/engine.wac";
import { blockFormOf } from "../engine/blobs.wac";
import { publicKey } from "./secp.wac";
import { Conn } from "./peer.wac";
import { Deadlines, Watched, enforce } from "../net/deadlines.wac";
import { Asker, Fetched, snapSync, answerAccountRange, answerStorageRanges, answerByteCodes, answerTrieNodes, GET_TRIE_NODES, SOFT_BYTES,
         GET_ACCOUNT_RANGE, ACCOUNT_RANGE, GET_STORAGE_RANGES, STORAGE_RANGES, GET_BYTE_CODES, BYTE_CODES, TRIE_NODES } from "./snap.wac";
import { Message, HelloMsg, StatusMsg, Response, ForkId, hello, helloWith, readHello, status, readStatus, forkId, disconnect,
         disconnectReason, getHeadersByHash, getBodies, readResponse, blockRange, numOf, small, HELLO, DISCONNECT, PING, PONG,
         STATUS, TRANSACTIONS, GET_BLOCK_HEADERS, BLOCK_HEADERS, GET_BLOCK_BODIES, BLOCK_BODIES,
         NEW_POOLED_TRANSACTION_HASHES, GET_POOLED_TRANSACTIONS, POOLED_TRANSACTIONS, GET_RECEIPTS, RECEIPTS,
         BLOCK_RANGE_UPDATE, DISCONNECT_REQUESTED, DISCONNECT_INCOMPATIBLE, DISCONNECT_SUBPROTOCOL } from "./wire.wac";

export struct Peer {
  Conn c;
  string name;
  /** Requests sent and not yet answered, by id: settled by the reading task with the response's items. */
  Map<U256, Ticket<Item[]>> pending;
  u64 latest;
  /** The hash of the peer's latest block, from its Status and then its BlockRangeUpdates. */
  U256 latestHash;
  bool alive;
  /** Whether it speaks snap/1 as well, so that a state can be fetched from it. */
  bool snap;
}

export struct Network {
  Engine e;
  u8[] nodeKey;
  U256 genesis;
  u64[] forkBlocks;
  u64[] forkTimes;
  Vec<Peer> peers;
  u64 nextId;
  U256 announcedHead;
  /**
   * Connections accepted and not yet gone, and how many may be at once: past it a new one is closed as it
   * arrives. Each holds a host call while it waits, and a host gives a program only so many.
   */
  i32 inbound;
  i32 maxInbound;
  /** Where an accepted connection's deadline for its handshake is kept, and enforced. */
  Deadlines deadlines;
  /**
   * Whether to take the chain from peers, with no consensus client: the longest head a peer announces is
   * fetched and becomes this node's head, safe and finalized. It trusts the peer for the fork choice, which
   * is right for a devnet whose blocks one node makes, and for nothing else.
   */
  bool follow;
  /**
   * Whether to fetch the state by snap sync rather than run every block: once, when the engine on a store
   * has only its genesis and is told of a head it has not got, the state at that head is fetched from a peer
   * that speaks snap/1 and the chain is begun again there (`snapTo`).
   */
  bool snap;
  /** A pause before each snap request, in milliseconds: for tests that need a sync to outlive its pivot. */
  i32 snapThrottle;
  /**
   * For tests: after this many snap requests (0 for never), the next answer about a pivot older than the
   * newest head named is taken as empty — what a peer that no longer keeps that state answers — so that the
   * sync moves on and heals, whatever the peer keeps.
   */
  i32 snapRepivot;

  Network create(Engine e, u8[] nodeKey, U256 genesis, u64[] forkBlocks, u64[] forkTimes) {
    return Network(e, nodeKey, genesis, forkBlocks, forkTimes, Vec.create(), 1, U256.zero(), 0, 10, Deadlines.create(), false, false, 0, 0);
  }

  StatusMsg ourStatus(this) {
    Header h = this.e.headHeader();
    ForkId f = forkId(this.genesis, this.forkBlocks, this.forkTimes, h.number.low(), h.timestamp.low());
    return StatusMsg(69, this.e.chainId, this.genesis, f, 0, h.number.low(), h.hash);
  }

  /** Whether a peer with this node key is connected. */
  bool connectedTo(this, u8[] id) {
    for (i32 i = 0; i < this.peers.len(); i++) {
      Peer p = this.peers.get(i);
      if (!p.alive) { continue; }
      u8[] r = p.c.remote();
      bool same = r.len() == id.len();
      for (i32 k = 0; k < r.len() && same; k++) { same = r[k] == id[k]; }
      if (same) { return true; }
    }
    return false;
  }

  i32 alivePeers(this) {
    i32 k = 0;
    for (i32 i = 0; i < this.peers.len(); i++) {
      if (this.peers.get(i).alive) { k++; }
    }
    return k;
  }

  /** The peer announcing the highest block, if any is connected. */
  Peer? highestPeer(this) {
    Peer? best = null;
    for (i32 i = 0; i < this.peers.len(); i++) {
      Peer p = this.peers.get(i);
      if (p.alive && (best is null || p.latest > best!.latest)) { best = p; }
    }
    return best;
  }

  Peer? anyPeer(this) {
    for (i32 i = 0; i < this.peers.len(); i++) {
      if (this.peers.get(i).alive) { return this.peers.get(i); }
    }
    return null;
  }
}

Item emptyList() { return Item.List(Item[].filled(0, Item.Bytes(u8[].filled(0, 0)))); }

/** Hello and Status, both ways, on a connection whose handshake is done. Null when the peer will not do. */
async Peer? greet(Sys sys, Network n, Conn c, string name) {
  if (!(await c.send(helloWith("wacuum/v0.1.0", publicKey(n.nodeKey), n.e.db is not null)))) { return null; }
  Message? hm = await c.receive();
  if (hm is null || hm!.code != HELLO) {
    sys.warn("p2p: \{name}: no Hello: \{hm is null ? c.error : disconnectReason(hm!.body)}");
    return null;
  }
  HelloMsg h = readHello(hm!.body)!;
  bool eth69 = false;
  for (i32 i = 0; i < h.caps.len(); i++) { eth69 = eth69 || h.caps[i] == "eth/69"; }
  if (!eth69) {
    await c.send(disconnect(DISCONNECT_INCOMPATIBLE));
    sys.warn("p2p: \{name}: \{h.client} does not speak eth/69");
    return null;
  }
  c.s!.snappy = h.version >= 5;
  if (!(await c.send(status(n.ourStatus())))) { return null; }
  Message? sm = await c.receive();
  if (sm is null || sm!.code != STATUS) {
    sys.warn("p2p: \{name}: no Status: \{sm is null ? c.error : disconnectReason(sm!.body)}");
    return null;
  }
  StatusMsg st = readStatus(sm!.body)!;
  if (!st.genesis.eq(n.genesis) || !st.networkId.eq(n.e.chainId)) {
    await c.send(disconnect(DISCONNECT_SUBPROTOCOL));
    sys.warn("p2p: \{name}: on another chain");
    return null;
  }
  sys.log("p2p: \{name}: \{h.client}, serving blocks \{st.earliest}-\{st.latest}");
  bool snap = false;
  for (i32 i = 0; i < h.caps.len(); i++) { snap = snap || h.caps[i] == "snap/1"; }
  // snap's codes follow eth/69's only when both sides offered it.
  snap = snap && n.e.db is not null;
  Peer p = Peer(c, name, Map.create(hashU256, eqU256), st.latest, st.latestHash, true, snap);
  n.peers.push(p);
  return p;
}

/** Dial `enode`, and keep dialling it whenever the connection drops. */
export async void dial(Sys sys, Network n, string enode) {
  i32 at = enode.indexOf("@");
  if (enode.indexOf("enode://") != 0 || at < 0) {
    sys.warn("p2p: not an enode: \{enode}");
    return;
  }
  u8[]? remote = hexToBytes(enode.slice(8, at));
  string hostPort = enode.slice(at + 1, enode.len());
  i32 q = hostPort.indexOf("?");
  if (q >= 0) { hostPort = hostPort.slice(0, q); }
  i32 colon = hostPort.indexOf(":");
  if (remote is null || remote!.len() != 64 || colon < 0) {
    sys.warn("p2p: not an enode: \{enode}");
    return;
  }
  string host = hostPort.slice(0, colon);
  i32 port = 0;
  u8[] pd = hostPort.slice(colon + 1, hostPort.len()).toBytes();
  for (i32 i = 0; i < pd.len(); i++) { port = port * 10 + ((pd[i] - 48) as i32); }
  while (true) {
    if (!n.connectedTo(remote!)) { await dialOnce(sys, n, host, port, remote!); }
    await sys.sleepMillis(5000);
  }
}

/** One attempt at a node: connect, handshake, greet, and serve it until it goes. */
export async void dialOnce(Sys sys, Network n, string host, i32 port, u8[] remote) {
  string name = "\{host}:\{port}";
  match (await sys.net().connect(host, port)) {
    Err(err): { sys.warn("p2p: \{name}: \{err}"); }
    Ok(sock): {
      Conn c = Conn.over(sock);
      u8[] rand = (await sys.random().bytes(112)).ok()!;
      if (await c.initiate(n.nodeKey, remote, rand)) {
        Peer? p = await greet(sys, n, c, name);
        if (p is not null) { await run(sys, n, p!); }
      } else {
        sys.warn("p2p: \{name}: handshake: \{c.error}");
      }
      sock.close();
    }
  }
}

/**
 * Accept peers on `port`: at most `n.maxInbound` at once, each closed if its handshake and greeting are not
 * done within ten seconds, so that connections which say nothing cannot pile up.
 */
export async void listen(Sys sys, Network n, string addr, i32 port) {
  enforce(sys, n.deadlines);
  match (await sys.net().listen(addr, port)) {
    Err(err): { sys.warn("p2p: cannot listen on \{addr}:\{port}: \{err}"); }
    Ok(listener): {
      sys.log("p2p: listening on \{listener.addr}; enode://\{bytesToHex(publicKey(n.nodeKey)).slice(2, 130)}@\{addr}:\{port}");
      while (true) {
        match (await listener.accept()) {
          Err(err): { sys.warn("p2p: accept: \{err}"); }
          Ok(sock): {
            if (n.inbound >= n.maxInbound) {
              sock.close();
            } else {
              n.inbound++;
              inbound(sys, n, sock);
            }
          }
        }
      }
    }
  }
}

async void inbound(Sys sys, Network n, Socket sock) {
  Watched w = n.deadlines.watch(sock, (await sys.clock().nowMillis()).orElse(0 as i64), 10000);
  Conn c = Conn.over(sock);
  u8[] rand = (await sys.random().bytes(112)).ok()!;
  string name = "\{sock.peer}:\{sock.port}";
  if (await c.respond(n.nodeKey, rand)) {
    Peer? p = await greet(sys, n, c, name);
    w.done = true;
    if (p is not null) { await run(sys, n, p!); }
  }
  w.done = true;
  sock.close();
  n.inbound--;
}

/** Read a peer's messages until it goes: answer what it asks, settle what it answers. */
async void run(Sys sys, Network n, Peer p) {
  while (true) {
    Message? m = await p.c.receive();
    if (m is null) { break; }
    i32 code = m!.code;
    Item body = m!.body;
    if (code == PING) {
      await p.c.send(Message(PONG, emptyList()));
    } else if (code == DISCONNECT) {
      sys.log("p2p: \{p.name} disconnected: \{disconnectReason(body)}");
      break;
    } else if (code == GET_BLOCK_HEADERS) {
      await p.c.send(answerHeaders(n.e, body));
    } else if (code == GET_BLOCK_BODIES) {
      await p.c.send(answerBodies(n.e, body));
    } else if (code == GET_RECEIPTS) {
      await p.c.send(answerReceipts(n.e, body));
    } else if (code == GET_POOLED_TRANSACTIONS) {
      await p.c.send(answerPooled(n.e, body));
    } else if (code == BLOCK_HEADERS || code == BLOCK_BODIES || code == POOLED_TRANSACTIONS || code == RECEIPTS) {
      Response? r = readResponse(body);
      if (r is not null) {
        Ticket<Item[]>? t = p.pending.get(U256.ofU64(r!.id));
        if (t is not null) {
          p.pending.remove(U256.ofU64(r!.id));
          t!.resolve(r!.items);
        }
        if (code == POOLED_TRANSACTIONS) { takeTransactions(n, r!.items); }
      }
    } else if (p.snap && (code == ACCOUNT_RANGE || code == STORAGE_RANGES || code == BYTE_CODES || code == TRIE_NODES)) {
      // Its items after the id are the answer.
      if (isList(body) && itemsOf(body).len() >= 2) {
        Item[] all = itemsOf(body);
        u64 id = numOf(all[0]).low();
        Ticket<Item[]>? t = p.pending.get(U256.ofU64(id));
        if (t is not null) {
          p.pending.remove(U256.ofU64(id));
          Item[] rest = Item[].filled(all.len() - 1, all[0]);
          for (i32 i = 1; i < all.len(); i++) { rest[i - 1] = all[i]; }
          t!.resolve(rest);
        }
      }
    } else if (p.snap && (code == GET_ACCOUNT_RANGE || code == GET_STORAGE_RANGES || code == GET_BYTE_CODES || code == GET_TRIE_NODES)) {
      // Answered from the store when it holds the head's state; otherwise as a node without it, empty.
      await p.c.send(await answerSnap(n, code, body));
    } else if (code == TRANSACTIONS) {
      if (isList(body)) { takeTransactions(n, itemsOf(body)); }
    } else if (code == NEW_POOLED_TRANSACTION_HASHES) {
      await askForAnnounced(n, p, body);
    } else if (code == BLOCK_RANGE_UPDATE) {
      if (isList(body) && itemsOf(body).len() >= 2) { p.latest = numOf(itemsOf(body)[1]).low(); }
      if (isList(body) && itemsOf(body).len() >= 3 && bytesOf(itemsOf(body)[2]).len() == 32) {
        p.latestHash = U256.fromBytes(bytesOf(itemsOf(body)[2]), 0, 32);
      }
    }
  }
  p.alive = false;
  // Whoever is waiting on this peer gets nothing rather than waiting for ever.
  U256[] ids = p.pending.keys();
  for (i32 i = 0; i < ids.len(); i++) { p.pending.get(ids[i])!.resolve(Item[].filled(0, emptyList())); }
  sys.log("p2p: \{p.name} gone: \{p.c.error}");
}

u64 requestId(Item body) {
  if (!isList(body) || itemsOf(body).len() == 0) { return 0; }
  return numOf(itemsOf(body)[0]).low();
}

/** BlockHeaders for a GetBlockHeaders: from a number or a hash, `amount` of them `skip` apart, either way. */
Message answerHeaders(Engine e, Item body) {
  u64 id = requestId(body);
  Vec<Item> out = Vec.create();
  if (isList(body) && itemsOf(body).len() >= 2 && isList(itemsOf(body)[1]) && itemsOf(itemsOf(body)[1]).len() >= 4) {
    Item[] q = itemsOf(itemsOf(body)[1]);
    u8[] origin = isList(q[0]) ? u8[].filled(0, 0) : bytesOf(q[0]);
    Header? first = origin.len() == 32 ? e.headerByHash(U256.fromBytes(origin, 0, 32)) : e.headerByNumber(numOf(q[0]).low());
    u64 amount = numOf(q[1]).low();
    if (amount > 1024) { amount = 1024; }
    u64 step = numOf(q[2]).low() + 1;
    bool reverse = !numOf(q[3]).isZero();
    Header? cur = first;
    for (u64 k = 0; k < amount && cur is not null; k++) {
      Header h = cur!;
      out.push(headerItem(e.config.specAt(h.timestamp), h));
      u64 num = h.number.low();
      if (reverse) {
        if (num < step) { break; }
        cur = e.headerByNumber(num - step);
      } else {
        cur = e.headerByNumber(num + step);
      }
    }
  }
  return Message(BLOCK_HEADERS, Item.List([small(id), Item.List(out.toArray())]));
}

Message answerBodies(Engine e, Item body) {
  u64 id = requestId(body);
  Vec<Item> out = Vec.create();
  if (isList(body) && itemsOf(body).len() >= 2 && isList(itemsOf(body)[1])) {
    Item[] hashes = itemsOf(itemsOf(body)[1]);
    for (i32 i = 0; i < hashes.len() && i < 1024; i++) {
      u8[] h = bytesOf(hashes[i]);
      if (h.len() != 32) { continue; }
      Item? b = e.bodyItem(U256.fromBytes(h, 0, 32));
      if (b is not null) { out.push(b!); }
    }
  }
  return Message(BLOCK_BODIES, Item.List([small(id), Item.List(out.toArray())]));
}

/** Receipts for each block asked for, in order, stopping at the first this has not got. */
Message answerReceipts(Engine e, Item body) {
  u64 id = requestId(body);
  Vec<Item> out = Vec.create();
  if (isList(body) && itemsOf(body).len() >= 2 && isList(itemsOf(body)[1])) {
    Item[] hashes = itemsOf(itemsOf(body)[1]);
    for (i32 i = 0; i < hashes.len() && i < 256; i++) {
      u8[] h = bytesOf(hashes[i]);
      if (h.len() != 32) { break; }
      Item? r = e.receiptsItem(U256.fromBytes(h, 0, 32));
      if (r is null) { break; }
      out.push(r!);
    }
  }
  return Message(RECEIPTS, Item.List([small(id), Item.List(out.toArray())]));
}

/** PooledTransactions: those of the hashes asked for that are in the mempool, in their network form. */
Message answerPooled(Engine e, Item body) {
  u64 id = requestId(body);
  Vec<Item> out = Vec.create();
  if (isList(body) && itemsOf(body).len() >= 2 && isList(itemsOf(body)[1])) {
    Item[] hashes = itemsOf(itemsOf(body)[1]);
    for (i32 i = 0; i < hashes.len(); i++) {
      U256 want = U256.fromBytes(bytesOf(hashes[i]), 0, 32);
      for (i32 k = 0; k < e.mempool.len(); k++) {
        Item tx = e.mempool.get(k);
        if (!U256.fromBytes(keccak256(rawOf(tx)), 0, 32).eq(want)) { continue; }
        u8[]? wire = e.networkForm(tx);
        if (wire is not null) { out.push(isList(tx) ? tx : Item.Bytes(wire!)); }
      }
    }
  }
  return Message(POOLED_TRANSACTIONS, Item.List([small(id), Item.List(out.toArray())]));
}

void takeTransactions(Network n, Item[] txs) {
  for (i32 i = 0; i < txs.len(); i++) { n.e.acceptTransaction(rawOf(txs[i])); }
}

/** NewPooledTransactionHashes: ask for the ones the mempool lacks. */
async void askForAnnounced(Network n, Peer p, Item body) {
  if (!isList(body) || itemsOf(body).len() < 3 || !isList(itemsOf(body)[2])) { return; }
  Item[] hashes = itemsOf(itemsOf(body)[2]);
  Vec<Item> want = Vec.create();
  for (i32 i = 0; i < hashes.len(); i++) {
    U256 h = U256.fromBytes(bytesOf(hashes[i]), 0, 32);
    bool have = false;
    for (i32 k = 0; k < n.e.mempool.len() && !have; k++) { have = U256.fromBytes(keccak256(rawOf(n.e.mempool.get(k))), 0, 32).eq(h); }
    if (!have) { want.push(hashes[i]); }
  }
  if (want.len() == 0) { return; }
  u64 id = n.nextId;
  n.nextId++;
  // The answer is taken by `run` when it arrives; nobody waits on it here.
  await p.c.send(Message(GET_POOLED_TRANSACTIONS, Item.List([small(id), Item.List(want.toArray())])));
}

/** Send `m` (whose first field is `id`) and wait for its response, up to 15 seconds. Null on no answer. */
async Item[]? request(Sys sys, Peer p, u64 id, Message m) {
  Ticket<Item[]> t;
  p.pending.set(U256.ofU64(id), t);
  if (!(await p.c.send(m))) { return null; }
  Ticket<void> timeout = sys.sleepMillis(15000);
  TicketBase[] race = [t, timeout];
  i32 won = await Ticket.first(race);
  if (won != 0) {
    p.pending.remove(U256.ofU64(id));
    return null;
  }
  return await t;
}

/**
 * Fetch and import the chain up to the engine's sync target from a peer: headers back from the target to a
 * block this node has, then bodies forward, each imported as it comes. Then any payloads that were waiting
 * on that chain go in too.
 */
async bool syncOnce(Sys sys, Network n, Peer p, U256 target) {
  Vec<Item> headers = Vec.create();
  U256 cursor = target;
  bool anchored = false;
  while (!anchored) {
    u64 id = n.nextId;
    n.nextId++;
    Item[]? got = await request(sys, p, id, getHeadersByHash(id, cursor, 128, 0, true));
    if (got is null || got!.len() == 0) { return false; }
    for (i32 i = 0; i < got!.len(); i++) {
      Item h = got![i];
      U256 hash = U256.fromBytes(keccak256(encode(h)), 0, 32);
      if (!hash.eq(cursor)) { return false; }
      if (n.e.has(hash)) {
        anchored = true;
        break;
      }
      headers.push(h);
      cursor = U256.fromBytes(bytesOf(itemsOf(h)[0]), 0, 32);
      if (n.e.has(cursor)) {
        anchored = true;
        break;
      }
    }
  }
  // A block at a time is what following a chain is, every slot: only a longer fetch is worth a line.
  if (headers.len() > 1) { sys.log("p2p: syncing \{headers.len()} blocks from \{p.name}"); }
  // Oldest first, 64 bodies at a time.
  i32 i = headers.len() - 1;
  while (i >= 0) {
    i32 take = i + 1 < 64 ? i + 1 : 64;
    U256[] hashes = U256[].filled(take, U256.zero());
    for (i32 k = 0; k < take; k++) { hashes[k] = U256.fromBytes(keccak256(encode(headers.get(i - k))), 0, 32); }
    u64 id = n.nextId;
    n.nextId++;
    Item[]? bodies = await request(sys, p, id, getBodies(id, hashes));
    if (bodies is null || bodies!.len() == 0) { return false; }
    for (i32 k = 0; k < bodies!.len(); k++) {
      Item[] parts = itemsOf(bodies![k]);
      Item ws = parts.len() > 2 ? parts[2] : emptyList();
      u8[] raw = encode(Item.List([headers.get(i - k), parts[0], parts[1], ws]));
      Spec spec = n.e.config.specAt(blockTimestamp(raw));
      BlockDecode bd = decodeBlock(spec, raw);
      if (bd.block is null) {
        sys.warn("p2p: a block from \{p.name} does not decode: \{bd.error}");
        return false;
      }
      if (n.e.db is not null) { await n.e.prepareBlock(spec, bd.block!); }
      Answer a = n.e.importBlock(spec, bd.block!);
      string verdict = a.result!.member("status")!.text()!;
      if (verdict != "VALID") {
        sys.warn("p2p: block \{bd.block!.header.number.toDecimal()} from \{p.name} is \{verdict}");
        return false;
      }
    }
    i -= bodies!.len();
  }
  i32 adopted = await n.e.adoptOrphansAsync();
  if (headers.len() > 1 || adopted > 0 || n.e.syncTarget is not null) {
    sys.log("p2p: synced to \{n.e.syncTarget is null ? "the target" : "short of it"}; \{adopted} waiting payloads went in");
  }
  return true;
}

/** A snap request answered from the store, about the state of the block the engine is at. */
async Message answerSnap(Network n, i32 code, Item body) {
  Engine e = n.e;
  u8[] root = e.blocks.get(e.at)!.header.stateRoot.toBytes();
  if (code == GET_ACCOUNT_RANGE) { return await answerAccountRange(e.db!.store, root, body); }
  if (code == GET_STORAGE_RANGES) { return await answerStorageRanges(e.db!.store, root, body); }
  if (code == GET_TRIE_NODES) { return await answerTrieNodes(e.db!.store, root, body); }
  return await answerByteCodes(e.db!.store, body);
}

/** One peer as a snap sync's asker: its requests (paced, for tests), with ids from `firstId`. */
Asker askerFor(Sys sys, Network net, Peer peer, Pivots pivots, u64 firstId) {
  return Asker(async (Message m) => {
    if (net.snapThrottle > 0) { await sys.sleepMillis(net.snapThrottle); }
    // A newer head named meanwhile is fetched first, so that the sync can move to it if it must.
    await pivots.refresh();
    u64 rid = numOf(itemsOf(m.body)[0]).low();
    Item[]? got = await request(sys, peer, rid, m);
    pivots.asked++;
    if (net.snapRepivot > 0 && pivots.asked > net.snapRepivot && pivots.seen.len() > 1 && !pivots.moved && got is not null &&
        (m.code == GET_ACCOUNT_RANGE || m.code == GET_STORAGE_RANGES)) {
      // As a peer that has dropped the pivot's state answers: nothing.
      pivots.moved = true;
      return [Item.List(Item[].filled(0, Item.Bytes(u8[].filled(0, 0)))), Item.List(Item[].filled(0, Item.Bytes(u8[].filled(0, 0))))];
    }
    return got;
  }, firstId, SOFT_BYTES, () => pivots.newest());
}

/** The pivots a snap sync has had, newest last, each a header and its ancestors'. */
struct Pivots {
  Sys sys;
  Network n;
  Peer p;
  Vec<Vec<Header>> seen;
  i32 asked;
  bool moved;

  /** The newest head the consensus client has named, fetched as headers if it is newer than the last pivot. */
  async void refresh(this) {
    U256? t = this.n.e.syncTarget;
    if (t is null || t!.eq(this.seen.get(this.seen.len() - 1).get(0).hash)) { return; }
    Vec<Header>? hs = await headersBack(this.sys, this.n, this.p, t!);
    if (hs is not null) { this.seen.push(hs!); }
  }

  /** The newest pivot's state root. */
  u8[] newest(this) { return this.seen.get(this.seen.len() - 1).get(0).stateRoot.toBytes(); }
}

/** `target`'s header and its 256 ancestors', newest first, each the parent of the one before; null if the peer will not say. */
async Vec<Header>? headersBack(Sys sys, Network n, Peer p, U256 target) {
  u64 id = n.nextId;
  n.nextId++;
  Item[]? hs = await request(sys, p, id, getHeadersByHash(id, target, 257, 0, true));
  if (hs is null || hs!.len() == 0) { return null; }
  Vec<Header> out = Vec.create();
  for (i32 i = 0; i < hs!.len(); i++) {
    string[] why = [""];
    Header? h = headerOf(n.e.config.specAt(timestampOf(hs![i])), hs![i], why);
    if (h is null || (i == 0 && !h!.hash.eq(target)) || (i > 0 && !h!.hash.eq(out.get(i - 1).parentHash))) { return null; }
    out.push(h!);
  }
  return out;
}

bool same(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

/**
 * The state at `target` fetched from `p` by snap sync into the engine's store, and the chain begun again
 * there with its 256 ancestors' headers for BLOCKHASH. True when it worked; the blocks after it come the
 * ordinary way.
 */
async bool snapTo(Sys sys, Network n, Peer p, U256 target) {
  Vec<Header>? got = await headersBack(sys, n, p, target);
  if (got is null) {
    sys.warn("p2p: \{p.name} has no chain of headers back from the snap target");
    return false;
  }
  Header[] headers = got!.toArray();
  Header pivot = headers[0];
  sys.log("p2p: snap sync from \{p.name} at block \{pivot.number.toDecimal()}, state root \{pivot.stateRoot.toHex()}");
  Network net = n;
  Peer peer = p;
  // The head moves while the state is fetched, and peers keep only recent states: when this one stops
  // answering about the pivot, the newest head the consensus client has named becomes the pivot.
  Pivots pivots = Pivots(sys, n, p, Vec.create(), 0, false);
  Vec<Header> start = Vec.create();
  for (i32 i = 0; i < headers.len(); i++) { start.push(headers[i]); }
  pivots.seen.push(start);
  // Every peer that speaks snap/1 at once: the account space is split among them (`snapSync`).
  Vec<Asker> askers = Vec.create();
  for (i32 i = 0; i < n.peers.len(); i++) {
    Peer q = n.peers.get(i);
    if (q.alive && q.snap) { askers.push(askerFor(sys, net, q, pivots, n.nextId + 1000000 * ((askers.len() + 1) as@ u32 as u64))); }
  }
  u8[] user = u8[].filled(40, 0);
  user.copyFrom(pivot.hash.toBytes(), 0, 0, 32);
  user.copyFrom(U256.ofU64(pivot.number.low()).toBytes(), 24, 32, 8);
  sys.log("p2p: snap sync from \{askers.len()} peer(s)");
  Fetched f = await snapSync(askers.toArray(), n.e.db!.store, pivot.stateRoot.toBytes(), user);
  if (f.error != "") {
    sys.warn("p2p: snap sync from \{p.name} failed: \{f.error}");
    return false;
  }
  sys.log("p2p: snap sync done: \{f.accounts} accounts, \{f.slots} slots, \{f.codes} codes, \{f.nodes} trie nodes, \{f.healed} healed, \{f.requests} requests");
  // The pivot the state ended at: the first, or the newest it moved to.
  Vec<Header> chosen = pivots.seen.get(0);
  for (i32 i = 0; i < pivots.seen.len(); i++) {
    if (same(pivots.seen.get(i).get(0).stateRoot.toBytes(), f.root)) { chosen = pivots.seen.get(i); }
  }
  pivot = chosen.get(0);
  Header[] ancestors = Header[].filled(chosen.len() - 1, pivot);
  for (i32 i = 1; i < chosen.len(); i++) { ancestors[i - 1] = chosen.get(i); }
  n.e.db!.discard();
  n.e.rebase(pivot, ancestors);
  return true;
}

/**
 * The network's housekeeping, twice a second: sync when the consensus client is ahead, tell peers of new
 * transactions, and of the head when it moves.
 */
export async void tend(Sys sys, Network n, fn<Ticket<void>()> flush) {
  while (true) {
    await sys.sleepMillis(500);
    Peer? from = n.anyPeer();
    if (n.follow) {
      // The highest head on offer: taken once its blocks are in, and fetched until they are.
      Peer? best = n.highestPeer();
      Header ours = n.e.headHeader();
      if (best is not null && best!.latest > ours.number.low() && !best!.latestHash.isZero()) {
        U256 theirs = best!.latestHash;
        from = best;
        if (n.e.has(theirs)) {
          n.e.choose(theirs, theirs, theirs);
          await flush();
          if (best!.latest > ours.number.low() + 1) { sys.log("p2p: following \{best!.name}: head \{best!.latest} \{theirs.toHex()}"); }
        } else if (n.e.syncTarget is null) {
          n.e.syncTarget = theirs;
        }
      }
    }
    U256? target = n.e.syncTarget;
    if (target is not null) {
      if (n.e.has(target!)) {
        await n.e.adoptOrphansAsync();
      } else if (from is not null) {
        // A store with nothing but its genesis, told of a head it has not got: fetch the state there instead.
        Peer? snapPeer = null;
        for (i32 i = 0; i < n.peers.len(); i++) {
          if (n.peers.get(i).alive && n.peers.get(i).snap) { snapPeer = n.peers.get(i); }
        }
        if (n.snap && n.e.db is not null && n.e.blocks.len() == 1 && snapPeer is not null) {
          if (await snapTo(sys, n, snapPeer!, target!)) { await flush(); }
        } else {
          await syncOnce(sys, n, from!, target!);
        }
      }
      await flush();
    }
    if (n.e.announce.len() > 0) {
      Vec<Item> types = Vec.create();
      Vec<Item> sizes = Vec.create();
      Vec<Item> hashes = Vec.create();
      for (i32 i = 0; i < n.e.announce.len(); i++) {
        u8[] raw = n.e.announce.get(i);
        types.push(small(raw[0] >= 0xc0 ? 0 : (raw[0] as u64)));
        sizes.push(small((raw.len() as@ u32) as u64));
        hashes.push(Item.Bytes(keccak256(blockFormOf(raw))));
      }
      n.e.announce = Vec.create();
      u8[] typeBytes = u8[].filled(types.len(), 0);
      for (i32 i = 0; i < types.len(); i++) { typeBytes[i] = (numOf(types.get(i)).low() & 0xff) as! u8; }
      Message m = Message(NEW_POOLED_TRANSACTION_HASHES, Item.List([Item.Bytes(typeBytes), Item.List(sizes.toArray()),
                                                                    Item.List(hashes.toArray())]));
      for (i32 i = 0; i < n.peers.len(); i++) {
        if (n.peers.get(i).alive) { await n.peers.get(i).c.send(m); }
      }
    }
    Header head = n.e.headHeader();
    if (!head.hash.eq(n.announcedHead)) {
      n.announcedHead = head.hash;
      for (i32 i = 0; i < n.peers.len(); i++) {
        if (n.peers.get(i).alive) { await n.peers.get(i).c.send(blockRange(0, head.number.low(), head.hash)); }
      }
    }
  }
}
