// snap/1: a state fetched as ranges of its tries' leaves rather than block by block. A client asks a peer
// for runs of accounts, of each account's slots, and for codes, checks each run against the state root it
// asked about with the run's range proof (`src/trie/rangeproof.wac`), and writes it into the store as it
// is; then builds the tries from the store in one sorted pass (`src/trie/stacktrie.wac`), and the root
// must be the one it asked for. The store's keys are snap's — keccak of the address, keccak of the slot —
// and a stored account is the trie's leaf, so what arrives goes in as it came.
//
// The messages follow eth/69's when both peers have both: capabilities are numbered in name order after
// the base protocol's sixteen codes, and eth/69 takes eighteen, so snap/1 starts at 0x22.
//
// This node also answers snap requests from its store, which is how the client is tested against a
// server with no network between them; healing a state whose root moved while it was fetched is not here
// yet — the pivot is held still.

import { Map, Vec, Ticket } from "core";
import { rlp.Item, rlp.encode, rlp.decode, rlp.itemsOf, rlp.bytesOf, rlp.isList } from "@/lib.wac";
import { keccak256 } from "../crypto/keccak.wac";
import { U256 } from "../u256.wac";
import { Message, small, numOf } from "./wire.wac";
import { Store, Change, compareKeys, CHUNK } from "../store/tree.wac";
import { emptyCodeHash } from "../state/world.wac";
import { emptyRoot, hexPrefixOf } from "../trie/trie.wac";
import { PathTrie, nodeKey, subtreeRanges, entryKey, isEntry, entryHash, entries } from "../trie/pathtrie.wac";
import { StackTrie } from "../trie/stacktrie.wac";
import { verifyRange, Range } from "../trie/rangeproof.wac";

export static i32 SNAP = 0x22;
export static i32 GET_ACCOUNT_RANGE = 0x22;
export static i32 ACCOUNT_RANGE = 0x23;
export static i32 GET_STORAGE_RANGES = 0x24;
export static i32 STORAGE_RANGES = 0x25;
export static i32 GET_BYTE_CODES = 0x26;
export static i32 BYTE_CODES = 0x27;
export static i32 GET_TRIE_NODES = 0x28;
export static i32 TRIE_NODES = 0x29;

/** How much an answer may carry, as snap's requests name it: what geth asks for. */
export static u64 SOFT_BYTES = 512 * 1024;

Item bytes32(u8[] b) { return Item.Bytes(b); }
Item list(Vec<Item> v) { return Item.List(v.toArray()); }
Item[] none() { return Item[].filled(0, Item.Bytes(u8[].filled(0, 0))); }

export Message getAccountRange(u64 id, u8[] root, u8[] origin, u8[] limit, u64 bytes) {
  return Message(GET_ACCOUNT_RANGE, Item.List([small(id), bytes32(root), bytes32(origin), bytes32(limit), small(bytes)]));
}

export Message getStorageRanges(u64 id, u8[] root, u8[][] accounts, u8[] origin, u8[] limit, u64 bytes) {
  Item[] owners = Item[].filled(accounts.len(), Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < accounts.len(); i++) { owners[i] = bytes32(accounts[i]); }
  return Message(GET_STORAGE_RANGES, Item.List([small(id), bytes32(root), Item.List(owners), bytes32(origin), bytes32(limit), small(bytes)]));
}

export Message getByteCodes(u64 id, u8[][] hashes, u64 bytes) {
  Item[] hs = Item[].filled(hashes.len(), Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < hashes.len(); i++) { hs[i] = bytes32(hashes[i]); }
  return Message(GET_BYTE_CODES, Item.List([small(id), Item.List(hs), small(bytes)]));
}

/** An account as snap sends it — empty for the empty storage root and the empty code's hash — as the trie's leaf. */
export u8[]? fullAccount(Item slim) {
  if (!isList(slim) || itemsOf(slim).len() != 4) { return null; }
  Item[] f = itemsOf(slim);
  u8[] root = bytesOf(f[2]);
  u8[] code = bytesOf(f[3]);
  return encode(Item.List([f[0], f[1], Item.Bytes(root.len() == 0 ? emptyRoot() : root),
                           Item.Bytes(code.len() == 0 ? emptyCodeHash().toBytes() : code)]));
}

/** The trie's leaf as snap sends it. */
Item slimAccount(u8[] full) {
  Item[] f = itemsOf(decode(full).item);
  u8[] root = bytesOf(f[2]);
  u8[] code = bytesOf(f[3]);
  return Item.List([f[0], f[1], Item.Bytes(same(root, emptyRoot()) ? u8[].filled(0, 0) : root),
                    Item.Bytes(same(code, emptyCodeHash().toBytes()) ? u8[].filled(0, 0) : code)]);
}

bool same(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

u8[] key(u8 kind, u8[] a, u8[] b) {
  u8[] out = u8[].filled(1 + a.len() + b.len(), kind);
  out.copyFrom(a, 0, 1, a.len());
  out.copyFrom(b, 0, 1 + a.len(), b.len());
  return out;
}

/** The key just after `k` (32 bytes), or null after the last one. */
export u8[]? nextKey(u8[] k) {
  u8[] out = u8[].filled(32, 0);
  out.copyFrom(k, 0, 0, 32);
  i32 i = 31;
  while (i >= 0 && out[i] == 255) {
    out[i] = 0;
    i--;
  }
  if (i < 0) { return null; }
  out[i] = out[i] + 1;
  return out;
}

/** The last key there is. */
u8[] maxKey() { return u8[].filled(32, 255); }

// ── Answering, from the store ────────────────────────────────────────────────

/**
 * An AccountRange for a GetAccountRange, from a store holding the state of `root`'s block (a request
 * about another root gets an empty answer, as snap says).
 */
/**
 * A snap request answered from one state: the store is held for the whole answer, so a block committed
 * meanwhile waits rather than mixing its state into the proof; and the root served is the one the store
 * holds, read under the hold, not one the caller looked up before it.
 */
export async Message answerHeld(Store store, i32 code, Item body) {
  await store.hold();
  PathTrie t = PathTrie.of(store, u8[].filled(0, 0));
  await t.open();
  u8[] root = t.hash();
  Message a = Message(code, body);
  if (code == GET_ACCOUNT_RANGE) { a = await answerAccountRange(store, root, body); }
  else if (code == GET_STORAGE_RANGES) { a = await answerStorageRanges(store, root, body); }
  else if (code == GET_TRIE_NODES) { a = await answerTrieNodes(store, root, body); }
  else { a = await answerByteCodes(store, body); }
  store.release();
  return a;
}

export async Message answerAccountRange(Store store, u8[] stateRoot, Item body) {
  Item[] q = itemsOf(body);
  u64 id = numOf(q[0]).low();
  u8[] root = bytesOf(q[1]);
  u8[] origin = bytesOf(q[2]);
  u8[] limit = bytesOf(q[3]);
  u64 budget = numOf(q[4]).low() < SOFT_BYTES ? numOf(q[4]).low() : SOFT_BYTES;
  if (!same(root, stateRoot) || origin.len() != 32 || limit.len() != 32) {
    return Message(ACCOUNT_RANGE, Item.List([small(id), Item.List(none()), Item.List(none())]));
  }
  Vec<Change> got = await entries(store, u8[].filled(0, 0), origin, 4096);
  Vec<Item> accounts = Vec.create();
  u64 size = 0;
  u8[] last = origin;
  for (i32 i = 0; i < got.len() && size < budget; i++) {
    u8[] h = got.get(i).key;
    // One past the limit is allowed, as snap's servers do: it proves where the run ends.
    accounts.push(Item.List([bytes32(h), slimAccount(got.get(i).value!)]));
    size += 32 + ((got.get(i).value!.len() as@ u32) as u64);
    last = h;
    if (compareKeys(h, limit) >= 0) { break; }
  }
  PathTrie t = PathTrie.of(store, u8[].filled(0, 0));
  await t.open();
  Vec<Item> proof = Vec.create();
  u8[][] a = await t.prove(origin);
  for (i32 i = 0; i < a.len(); i++) { proof.push(Item.Bytes(a[i])); }
  if (accounts.len() > 0) {
    u8[][] b = await t.prove(last);
    for (i32 i = 0; i < b.len(); i++) {
      if (!seen(proof, b[i])) { proof.push(Item.Bytes(b[i])); }
    }
  }
  return Message(ACCOUNT_RANGE, Item.List([small(id), list(accounts), list(proof)]));
}

bool seen(Vec<Item> v, u8[] b) {
  for (i32 i = 0; i < v.len(); i++) {
    if (same(bytesOf(v.get(i)), b)) { return true; }
  }
  return false;
}

/** StorageRanges for a GetStorageRanges: whole storages while they fit, the last cut short with a proof. */
export async Message answerStorageRanges(Store store, u8[] stateRoot, Item body) {
  Item[] q = itemsOf(body);
  u64 id = numOf(q[0]).low();
  u8[] root = bytesOf(q[1]);
  Item[] accounts = isList(q[2]) ? itemsOf(q[2]) : none();
  u8[] origin = bytesOf(q[3]).len() == 32 ? bytesOf(q[3]) : u8[].filled(32, 0);
  u64 budget = numOf(q[5]).low() < SOFT_BYTES ? numOf(q[5]).low() : SOFT_BYTES;
  Vec<Item> slots = Vec.create();
  Vec<Item> proof = Vec.create();
  if (!same(root, stateRoot)) { return Message(STORAGE_RANGES, Item.List([small(id), list(slots), list(proof)])); }
  u64 size = 0;
  for (i32 a = 0; a < accounts.len() && size < budget; a++) {
    u8[] owner = bytesOf(accounts[a]);
    u8[] from = a == 0 ? origin : u8[].filled(32, 0);
    // No more than the budget left could take, each slot being at least 33 bytes of it.
    Vec<Change> got = await entries(store, owner, from, (((budget - size) / 33 + 1) as! i32));
    Vec<Item> mine = Vec.create();
    u8[] last = from;
    bool cut = false;
    for (i32 i = 0; i < got.len(); i++) {
      Change c = got.get(i);
      if (size >= budget) {
        cut = true;
        break;
      }
      u8[] h = c.key;
      mine.push(Item.List([bytes32(h), Item.Bytes(c.value!)]));
      size += 32 + ((c.value!.len() as@ u32) as u64);
      last = h;
    }
    slots.push(list(mine));
    // A storage given whole needs no proof; one cut short, or one started past its beginning, does.
    if (cut || a == 0 && !same(origin, u8[].filled(32, 0))) {
      PathTrie t = PathTrie.of(store, owner);
      await t.open();
      u8[][] pa = await t.prove(from);
      for (i32 i = 0; i < pa.len(); i++) { proof.push(Item.Bytes(pa[i])); }
      if (mine.len() > 0) {
        u8[][] pb = await t.prove(last);
        for (i32 i = 0; i < pb.len(); i++) {
          if (!seen(proof, pb[i])) { proof.push(Item.Bytes(pb[i])); }
        }
      }
      break;
    }
  }
  return Message(STORAGE_RANGES, Item.List([small(id), list(slots), list(proof)]));
}

/** ByteCodes for a GetByteCodes: each code the store has, in the order asked, while they fit. */
export async Message answerByteCodes(Store store, Item body) {
  Item[] q = itemsOf(body);
  u64 id = numOf(q[0]).low();
  Item[] hashes = isList(q[1]) ? itemsOf(q[1]) : none();
  Vec<Item> codes = Vec.create();
  u64 size = 0;
  u64 budget = numOf(q[2]).low() < SOFT_BYTES ? numOf(q[2]).low() : SOFT_BYTES;
  for (i32 i = 0; i < hashes.len() && (i == 0 || size < budget); i++) {
    u8[] base = key(2, bytesOf(hashes[i]), u8[].filled(0, 0));
    u8[] end = key(2, bytesOf(hashes[i]), [255 as u8, 255 as u8, 255 as u8]);
    Vec<Change> parts = await store.range(base, end, 0x7fffffff);
    if (parts.len() == 0) { continue; }
    i32 n = 0;
    for (i32 k = 0; k < parts.len(); k++) { n += parts.get(k).value!.len(); }
    u8[] code = u8[].filled(n, 0);
    i32 at = 0;
    for (i32 k = 0; k < parts.len(); k++) {
      code.copyFrom(parts.get(k).value!, 0, at, parts.get(k).value!.len());
      at += parts.get(k).value!.len();
    }
    codes.push(Item.Bytes(code));
    size += (n as@ u32) as u64;
  }
  return Message(BYTE_CODES, Item.List([small(id), list(codes)]));
}

// ── Fetching ─────────────────────────────────────────────────────────────────

/**
 * A peer, as the sync sees it: a request sent, and the items of its answer after the request id, or null
 * when it did not answer. Over the network this is `node.wac`'s `request`; in a test, a server in memory.
 */
export struct Asker {
  fn<Ticket<Item[]?>(Message)> ask;
  u64 nextId;
  /** How much each answer may carry: `SOFT_BYTES` normally, less to make a test ask more often. */
  u64 bytes;
  /**
   * The newest state root to fetch, asked when a peer answers nothing about the current one (peers keep
   * only recent states, and the head moves while a sync runs); empty when there is none newer. Synchronous,
   * from what the asker has found out already: an async lambda here is compiled wrong at this pin of wac.
   */
  fn<u8[]()>? pivot;
}

/** What a sync did, for whoever is watching it. */
export struct Fetched {
  i32 accounts;
  i32 slots;
  i32 codes;
  i32 nodes;
  i32 requests;
  string error;
  /** Trie nodes fetched by healing, and the root the store ends at. */
  i32 healed;
  u8[] root;
}

/** What the workers of a sync share: the store, the pivot's root as it moves, and what they have found. */
struct Shared {
  Store store;
  u8[] root;
  Fetched f;
  Vec<u8[]> withStorage;
  Vec<u8[]> storageRoots;
  Map<string, bool> codes;
  Vec<u8[]> codeList;
  /** The next account whose storage a storage worker takes. */
  i32 nextStorage;
  /** Whether the pivot ever moved, so that storage runs may fail to prove and heal later. */
  bool moved;
}

/** A worker's commit: the store's gate queues them, one at a time. */
async string commitLocked(Shared s, Change[] changes) { return await s.store.commit(changes, u8[].filled(0, 0)); }

/** The pivot moved on: the newest root, or "" when there is none newer (the peer has no state for it). */
string moveOn(Shared s, Asker peer, u8[] asked) {
  // Another worker may have moved it already.
  if (!same(asked, s.root)) { return ""; }
  u8[] newer = peer.pivot is null ? u8[].filled(0, 0) : peer.pivot!();
  if (newer.len() == 0 || same(newer, s.root)) { return "a peer has no state for the root asked about"; }
  s.root = newer;
  s.moved = true;
  return "";
}

/** The accounts from `from` to `to` (inclusive, 32-byte keys), a run at a time, from one peer. */
async string accounts(Asker peer, Shared s, u8[] from, u8[] to) {
  u8[]? origin = from;
  while (origin is not null) {
    u8[] root = s.root;
    u64 id = peer.nextId;
    peer.nextId++;
    s.f.requests++;
    Item[]? got = await peer.ask(getAccountRange(id, root, origin!, to, peer.bytes));
    if (got is null || got!.len() < 2) { return "a peer did not answer for accounts"; }
    if (itemsOf(got![0]).len() == 0 && itemsOf(got![1]).len() == 0) {
      // Nothing about this root: the peer has moved on. On to the newest, where this run left off.
      string why = moveOn(s, peer, root);
      if (why != "") { return why; }
      continue;
    }
    Item[] run = itemsOf(got![0]);
    u8[][] keys = u8[][].defaulted(run.len());
    u8[][] vals = u8[][].defaulted(run.len());
    for (i32 i = 0; i < run.len(); i++) {
      Item[] pair = itemsOf(run[i]);
      keys[i] = bytesOf(pair[0]);
      u8[]? full = fullAccount(pair[1]);
      if (full is null) { return "an account does not decode"; }
      vals[i] = full!;
    }
    Range r = verifyRange(root, origin!, keys, vals, proofOf(got![1]));
    if (!r.ok) { return "an account range does not prove: \{r.why}"; }
    Vec<Change> out = Vec.create();
    for (i32 i = 0; i < keys.len(); i++) {
      // Past this slice's end is the next slice's: proved here, kept there.
      if (compareKeys(keys[i], to) > 0) { continue; }
      s.f.accounts++;
      out.push(Change(entryKey(u8[].filled(0, 0), keys[i]), vals[i]));
      Item[] acct = itemsOf(decode(vals[i]).item);
      u8[] sr = bytesOf(acct[2]);
      if (!same(sr, emptyRoot())) {
        s.withStorage.push(keys[i]);
        s.storageRoots.push(sr);
      }
      u8[] ch = bytesOf(acct[3]);
      if (!same(ch, emptyCodeHash().toBytes()) && !s.codes.has(text(ch))) {
        s.codes.set(text(ch), true);
        s.codeList.push(ch);
      }
    }
    string bad = await commitLocked(s, out.toArray());
    if (bad != "") { return bad; }
    // Done with this slice when the run reached its end, or the trie has nothing after it.
    bool past = keys.len() > 0 && compareKeys(keys[keys.len() - 1], to) >= 0;
    origin = r.more && keys.len() > 0 && !past ? nextKey(keys[keys.len() - 1]) : null;
  }
  return "";
}

/** Storage, an account at a time from the shared list, from one peer, until the list is done. */
async string storages(Asker peer, Shared s) {
  while (s.nextStorage < s.withStorage.len()) {
    i32 a = s.nextStorage;
    s.nextStorage++;
    u8[] owner = s.withStorage.get(a);
    u8[]? from = u8[].filled(32, 0);
    while (from is not null) {
      u8[] root = s.root;
      u64 id = peer.nextId;
      peer.nextId++;
      s.f.requests++;
      Item[]? got = await peer.ask(getStorageRanges(id, root, [owner], from!, maxKey(), peer.bytes));
      if (got is null || got!.len() < 2) { return "a peer did not answer for storage"; }
      if (itemsOf(got![0]).len() < 1) {
        string why = moveOn(s, peer, root);
        if (why != "") { return why; }
        continue;
      }
      Item[] run = itemsOf(itemsOf(got![0])[0]);
      u8[][] keys = u8[][].defaulted(run.len());
      u8[][] vals = u8[][].defaulted(run.len());
      for (i32 i = 0; i < run.len(); i++) {
        keys[i] = bytesOf(itemsOf(run[i])[0]);
        vals[i] = bytesOf(itemsOf(run[i])[1]);
      }
      Range r = verifyRange(s.storageRoots.get(a), from!, keys, vals, proofOf(got![1]));
      if (!r.ok) {
        // Proved against the storage root the account had when it was fetched; one that moved since is
        // healed at the end instead.
        if (!s.moved) { return "a storage range does not prove: \{r.why}"; }
        break;
      }
      Vec<Change> out = Vec.create();
      for (i32 i = 0; i < keys.len(); i++) { out.push(Change(entryKey(owner, keys[i]), vals[i])); }
      s.f.slots += keys.len();
      string bad = await commitLocked(s, out.toArray());
      if (bad != "") { return bad; }
      from = r.more && keys.len() > 0 ? nextKey(keys[keys.len() - 1]) : null;
    }
  }
  return "";
}

/**
 * The state of `root` fetched from `peers` into `store`, which must not hold another state: every account,
 * every slot and every code, each run checked against `root`; then the tries built from what was fetched,
 * and the root they come to checked — healed, if the pivot moved meanwhile; committed with `user` beside it.
 * The account space is split among the peers, two slices each, fetched at once; then each peer takes the
 * next account's storage until there is none, and the next batch of codes; healing asks them all at once
 * too. `fetched.error` is "" when done.
 */
export async Fetched snapSync(Asker[] peers, Store store, u8[] root, u8[] user) {
  Fetched f = Fetched(0, 0, 0, 0, 0, "", 0, root);
  // What is staged goes first: the sync commits to the tree itself, and a staged key would hide what it writes.
  string flushed = await store.flush();
  if (flushed != "") { return failedWith(f, flushed); }
  Shared s = Shared(store, root, f, Vec.create(), Vec.create(), Map.create(hashText, textEq), Vec.create(), 0, false);

  // Accounts: the key space in slices by its first byte, the slices among the peers, all at once.
  i32 slices = peers.len() * 2;
  Ticket<string>[] work = Ticket<string>[].filled(slices, accountsDone());
  for (i32 i = 0; i < slices; i++) {
    u8[] from = u8[].filled(32, 0);
    from[0] = ((i * 256) / slices) as! u8;
    u8[] to = u8[].filled(32, 255);
    to[0] = (((i + 1) * 256) / slices - 1) as! u8;
    work[i] = accounts(peers[i % peers.len()], s, from, to);
  }
  for (i32 i = 0; i < slices; i++) {
    string why = await work[i];
    if (why != "") { return failedWith(f, why); }
  }

  // Storage: each peer takes the next account until there is none.
  Ticket<string>[] st = Ticket<string>[].filled(peers.len(), accountsDone());
  for (i32 i = 0; i < peers.len(); i++) { st[i] = storages(peers[i], s); }
  for (i32 i = 0; i < peers.len(); i++) {
    string why = await st[i];
    if (why != "") { return failedWith(f, why); }
  }
  root = s.root;
  Vec<u8[]> withStorage = s.withStorage;
  Vec<u8[]> storageRoots = s.storageRoots;
  Map<string, bool> codes = s.codes;
  Vec<u8[]> codeList = s.codeList;

  // Codes, by hash, each checked against its hash: every peer takes the next batch until there is none.
  string codesBad = await fetchCodes(peers, store, f, codeList);
  if (codesBad != "") { return failedWith(f, codesBad); }

  // The tries, from what was fetched: each storage trie, then the account trie, in the store's order.
  bool moved = s.moved;
  f.root = root;
  string bad = await buildTries(store, f, withStorage, storageRoots, moved);
  if (bad != "") { return failedWith(f, bad); }
  u8[]? built = await buildAccountTrie(store, f);
  if (built is null) { return failedWith(f, "the account trie did not build"); }
  if (!same(built!, root)) {
    if (!moved) { return failedWith(f, "the account trie comes to another root"); }
    // A patchwork of the states the pivot passed through: healed to the last one.
    string healed = await heal(peers, store, root, f);
    if (healed != "") { return failedWith(f, healed); }
  }
  string done = await store.commit(Change[].filled(0, Change(u8[].filled(0, 0), null)), user);
  if (done != "") { return failedWith(f, done); }
  return f;
}

/** Each storage trie built from its slots and checked against the account's storage root (unless the pivot moved). */
async string buildTries(Store store, Fetched f, Vec<u8[]> owners, Vec<u8[]> roots, bool moved) {
  for (i32 a = 0; a < owners.len(); a++) {
    u8[] owner = owners.get(a);
    Vec<Change> nodes = Vec.create();
    StackTrie st = StackTrie.create((u8[] path, u8[] enc) => { nodes.push(Change(nodeKey(owner, path), enc)); });
    Vec<Change> slots = await entries(store, owner, u8[].filled(32, 0), 0x7fffffff);
    for (i32 i = 0; i < slots.len(); i++) { st.add(slots.get(i).key, slots.get(i).value!); }
    u8[] r = st.finish();
    if (!same(r, roots.get(a)) && !moved) { return "a storage trie does not come to its account's root"; }
    f.nodes += nodes.len();
    string bad = await store.commit(nodes.toArray(), u8[].filled(0, 0));
    if (bad != "") { return bad; }
  }
  return "";
}

/** The account trie built from the accounts and committed; its root, or null. */
async u8[]? buildAccountTrie(Store store, Fetched f) {
  Vec<Change> nodes = Vec.create();
  StackTrie st = StackTrie.create((u8[] path, u8[] enc) => { nodes.push(Change(nodeKey(u8[].filled(0, 0), path), enc)); });
  // A chunk of accounts at a time, not all of them in memory at once.
  u8[]? from = u8[].filled(32, 0);
  while (from is not null) {
    Vec<Change> accounts = await entries(store, u8[].filled(0, 0), from!, 4096);
    for (i32 i = 0; i < accounts.len(); i++) { st.add(accounts.get(i).key, accounts.get(i).value!); }
    from = accounts.len() < 4096 ? null : nextKey(accounts.get(accounts.len() - 1).key);
  }
  u8[] r = st.finish();
  f.nodes += nodes.len();
  if ((await store.commit(nodes.toArray(), u8[].filled(0, 0))) != "") { return null; }
  return r;
}

// ── Healing ──────────────────────────────────────────────────────────────────

/** GetTrieNodes: each group an account trie path, or an account's hash and paths in its storage trie. */
export Message getTrieNodes(u64 id, u8[] root, Vec<Item> groups, u64 bytes) {
  return Message(GET_TRIE_NODES, Item.List([small(id), bytes32(root), list(groups), small(bytes)]));
}

/** A trie path as snap names it: hex-prefix encoded, as an extension's. */
Item compact(u8[] nibbles) { return Item.Bytes(hexPrefixOf(nibbles, false)); }

/** A hex-prefix path back to nibbles. */
u8[] uncompact(u8[] b) {
  if (b.len() == 0) { return u8[].filled(0, 0); }
  bool odd = ((b[0] >> 4) & 1) == 1;
  u8[] n = u8[].filled(b.len() * 2 - (odd ? 1 : 2), 0);
  i32 at = 0;
  if (odd) {
    n[0] = b[0] & 15;
    at = 1;
  }
  for (i32 i = 1; i < b.len(); i++) {
    n[at] = b[i] >> 4;
    n[at + 1] = b[i] & 15;
    at += 2;
  }
  return n;
}

/** TrieNodes for a GetTrieNodes, from a store holding the state of `stateRoot`: each node asked, in order, while there are any. */
export async Message answerTrieNodes(Store store, u8[] stateRoot, Item body) {
  Item[] q = itemsOf(body);
  u64 id = numOf(q[0]).low();
  Vec<Item> nodes = Vec.create();
  if (!same(bytesOf(q[1]), stateRoot) || !isList(q[2])) { return Message(TRIE_NODES, Item.List([small(id), list(nodes)])); }
  Item[] groups = itemsOf(q[2]);
  for (i32 g = 0; g < groups.len(); g++) {
    Item[] paths = itemsOf(groups[g]);
    if (paths.len() == 1) {
      u8[]? enc = await store.get(nodeKey(u8[].filled(0, 0), uncompact(bytesOf(paths[0]))));
      if (enc is null) { return Message(TRIE_NODES, Item.List([small(id), list(nodes)])); }
      nodes.push(Item.Bytes(enc!));
    } else {
      u8[] owner = bytesOf(paths[0]);
      for (i32 k = 1; k < paths.len(); k++) {
        u8[]? enc = await store.get(nodeKey(owner, uncompact(bytesOf(paths[k]))));
        if (enc is null) { return Message(TRIE_NODES, Item.List([small(id), list(nodes)])); }
        nodes.push(Item.Bytes(enc!));
      }
    }
  }
  return Message(TRIE_NODES, Item.List([small(id), list(nodes)]));
}

/** A node the heal must make right: in the account trie (owner empty) or an account's storage trie. */
struct Need {
  u8[] owner;
  u8[] path;
  /** What the parent says it is: its hash, or itself when under 32 bytes. */
  Item ref;
}

/** The nibbles packed into bytes, padded with `pad` to 32. */
u8[] packed(u8[] nibbles, u8 pad) {
  u8[] out = u8[].filled(32, 0);
  for (i32 i = 0; i < 64; i++) {
    u8 v = i < nibbles.len() ? nibbles[i] : pad;
    if (i % 2 == 0) { out[i / 2] = v << 4; } else { out[i / 2] = out[i / 2] | v; }
  }
  return out;
}

/**
 * The store's trie made the trie of `root`, fetched node by node from the root down where it differs: a
 * stored node with the hash its parent names is a subtree already right, and is left; any other is fetched,
 * checked against that hash, and written, with everything under its path it no longer has — trie nodes,
 * accounts or slots, and a gone account's storage — deleted. A leaf writes its entry; an account's leaf
 * goes on to its storage trie and its code.
 */
async string heal(Asker[] peers, Store store, u8[] root, Fetched f) {
  Vec<Need> todo = Vec.create();
  todo.push(Need(u8[].filled(0, 0), u8[].filled(0, 0), Item.Bytes(root)));
  while (todo.len() > 0) {
    // What is already right comes off; the rest is asked for, up to 64 at a time.
    Vec<Need> ask = Vec.create();
    Vec<Need> known = Vec.create();
    while (todo.len() > 0 && ask.len() < 64 * peers.len()) {
      Need n = todo.pop()!;
      if (isList(n.ref)) {
        known.push(n);
        continue;
      }
      u8[]? have = await store.get(nodeKey(n.owner, n.path));
      if (have is not null && same(keccak256(have!), bytesOf(n.ref))) { continue; }
      ask.push(n);
    }
    Vec<Change> out = Vec.create();
    for (i32 i = 0; i < known.len(); i++) {
      // Inside its parent's encoding, so nothing is stored at its own path: whatever was, goes.
      out.push(Change(nodeKey(known.get(i).owner, known.get(i).path), null));
      string bad = await apply(store, f, known.get(i), known.get(i).ref, false, out, todo);
      if (bad != "") { return bad; }
    }
    if (ask.len() > 0) {
      // The paths shared among the peers, up to 64 each, all asked at once; the answers applied in order after.
      i32 per = (ask.len() + peers.len() - 1) / peers.len();
      if (per > 64) { per = 64; }
      i32 parts = (ask.len() + per - 1) / per;
      Ticket<Item[]?>[] asked = Ticket<Item[]?>[].filled(parts, noAnswer());
      for (i32 p = 0; p < parts; p++) {
        Asker peer = peers[p % peers.len()];
        Vec<Item> groups = Vec.create();
        for (i32 i = p * per; i < ask.len() && i < (p + 1) * per; i++) {
          Need n = ask.get(i);
          groups.push(n.owner.len() == 0 ? Item.List([compact(n.path)]) : Item.List([bytes32(n.owner), compact(n.path)]));
        }
        u64 id = peer.nextId;
        peer.nextId++;
        f.requests++;
        asked[p] = peer.ask(getTrieNodes(id, root, groups, peer.bytes));
      }
      bool repivot = false;
      for (i32 p = 0; p < parts; p++) {
        Item[]? got = await asked[p];
        if (repivot) { continue; }
        if (got is not null && got!.len() >= 1 && itemsOf(got![0]).len() == 0) {
          // Nothing about this root: the peer has moved on, so the heal goes on to the newest, from its top.
          u8[] newer = peers[p % peers.len()].pivot is null ? u8[].filled(0, 0) : peers[p % peers.len()].pivot!();
          if (newer.len() > 0 && !same(newer, root)) {
            repivot = true;
            root = newer;
            f.root = newer;
            continue;
          }
        }
        if (got is null || got!.len() < 1 || itemsOf(got![0]).len() == 0) {
          return "a peer did not answer for trie nodes (\{got is null ? "no answer" : "an empty one"} about root \{text(root)}, \{ask.len()} paths)";
        }
        Item[] nodes = itemsOf(got![0]);
        i32 from = p * per;
        i32 count = ask.len() - from < per ? ask.len() - from : per;
        for (i32 i = 0; i < nodes.len() && i < count; i++) {
          u8[] enc = bytesOf(nodes[i]);
          Need n = ask.get(from + i);
          if (!same(keccak256(enc), bytesOf(n.ref))) { return "a trie node is not the one asked for"; }
          f.healed++;
          string bad = await apply(store, f, n, decode(enc).item, true, out, todo);
          if (bad != "") { return bad; }
          out.push(Change(nodeKey(n.owner, n.path), enc));
        }
        // What was not answered goes back on the list.
        for (i32 i = nodes.len(); i < count; i++) { todo.push(ask.get(from + i)); }
      }
      if (repivot) {
        todo = Vec.create();
        todo.push(Need(u8[].filled(0, 0), u8[].filled(0, 0), Item.Bytes(root)));
      }
    }
    string bad = await store.commit(out.toArray(), u8[].filled(0, 0));
    if (bad != "") { return bad; }
  }
  // Codes the healed accounts name and the store has not got.
  return await healCodes(peers, store, f);
}

u8[] cat(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  out.copyFrom(a, 0, 0, a.len());
  out.copyFrom(b, 0, a.len(), b.len());
  return out;
}

/** Everything the store has under `path` of the trie — its nodes and its entries, and gone accounts' storage — deleted, but for `keep`. */
async void clearUnder(Store store, u8[] owner, u8[] path, u8[]? keep, Vec<Change> out) {
  // The entries under the path are among its nodes, in the depth-first range: one pass deletes both.
  u8[] np = nodeKey(owner, path);
  Vec<u8[]> ranges = subtreeRanges(owner, path);
  for (i32 r = 0; r < ranges.len(); r += 2) {
    Vec<Change> under = await store.range(ranges.get(r), ranges.get(r + 1), 0x7fffffff);
    for (i32 i = 0; i < under.len(); i++) {
      u8[] k = under.get(i).key;
      // The node at the path itself is rewritten by the caller, and `keep` is the entry it writes.
      if (same(k, np) || keep is not null && same(k, keep!)) { continue; }
      out.push(Change(k, null));
      if (owner.len() == 0 && isEntry(k)) {
        // An account gone takes its storage, slots and trie, with it: all under one prefix.
        u8[] tp = key(4, entryHash(k), u8[].filled(0, 0));
        Vec<Change> tn = await store.range(tp, bump(tp), 0x7fffffff);
        for (i32 s = 0; s < tn.len(); s++) { out.push(Change(tn.get(s).key, null)); }
      }
    }
  }
}

/** The first key after every key that starts with `p`. */
u8[] bump(u8[] p) {
  u8[] out = u8[].filled(p.len(), 0);
  out.copyFrom(p, 0, 0, p.len());
  i32 i = p.len() - 1;
  while (i >= 0 && out[i] == 255) {
    out[i] = 0;
    i--;
  }
  if (i >= 0) { out[i] = out[i] + 1; }
  return out;
}

/** A node `it` (fetched, or inside its parent) at `n`: what it no longer covers cleared, its children or its entry next. */
async string apply(Store store, Fetched f, Need n, Item it, bool stored, Vec<Change> out, Vec<Need> todo) {
  if (!isList(it)) { return "a trie node is not a list"; }
  Item[] fs = itemsOf(it);
  if (fs.len() == 17) {
    for (i32 i = 0; i < 16; i++) {
      u8[] child = cat(n.path, [i as@ u8]);
      if (!isList(fs[i]) && bytesOf(fs[i]).len() == 0) {
        await clearUnder(store, n.owner, child, null, out);
        // A node stored at the child's own path goes too.
        out.push(Change(nodeKey(n.owner, child), null));
      } else {
        todo.push(Need(n.owner, child, fs[i]));
      }
    }
    return "";
  }
  if (fs.len() != 2) { return "a trie node is neither a branch nor a pair"; }
  u8[] hp = bytesOf(fs[0]);
  bool leaf = hp.len() > 0 && (hp[0] >> 4) >= 2;
  u8[] rest = uncompact(hp);
  u8[] full = cat(n.path, rest);
  if (!leaf) {
    // Everything under this path not under the extension's goes.
    for (i32 l = 0; l < rest.len(); l++) {
      for (i32 nib = 0; nib < 16; nib++) {
        if (nib == (rest[l] as i32)) { continue; }
        u8[] off = cat(cat(n.path, slice(rest, 0, l)), [nib as@ u8]);
        await clearUnder(store, n.owner, off, null, out);
        out.push(Change(nodeKey(n.owner, off), null));
      }
    }
    todo.push(Need(n.owner, full, fs[1]));
    return "";
  }
  // A leaf: its entry, and nothing else under its path.
  u8[] k = packed(full, 0);
  u8[] flat = entryKey(n.owner, k);
  await clearUnder(store, n.owner, n.path, flat, out);
  u8[] value = bytesOf(fs[1]);
  out.push(Change(flat, value));
  if (n.owner.len() == 0) {
    f.accounts++;
    Item[] acct = itemsOf(decode(value).item);
    u8[] sr = bytesOf(acct[2]);
    if (!same(sr, emptyRoot())) { todo.push(Need(k, u8[].filled(0, 0), Item.Bytes(sr))); }
    else {
      // No storage: none left over from a state before, slots or nodes.
      u8[] tp = key(4, k, u8[].filled(0, 0));
      Vec<Change> tn = await store.range(tp, bump(tp), 0x7fffffff);
      for (i32 s = 0; s < tn.len(); s++) { out.push(Change(tn.get(s).key, null)); }
    }
  } else {
    f.slots++;
  }
  return "";
}

u8[] slice(u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  out.copyFrom(b, from, 0, to - from);
  return out;
}

/** Every code an account in the store names and the store has not got, fetched. */
async string healCodes(Asker[] peers, Store store, Fetched f) {
  Vec<u8[]> missing = Vec.create();
  Map<string, bool> seenCode = Map.create(hashText, textEq);
  // A chunk of accounts at a time, not all of them in memory at once.
  u8[]? from = u8[].filled(32, 0);
  while (from is not null) {
    Vec<Change> accounts = await entries(store, u8[].filled(0, 0), from!, 4096);
    for (i32 i = 0; i < accounts.len(); i++) {
      u8[] ch = bytesOf(itemsOf(decode(accounts.get(i).value!).item)[3]);
      if (same(ch, emptyCodeHash().toBytes()) || seenCode.has(text(ch))) { continue; }
      seenCode.set(text(ch), true);
      u8[] base = key(2, ch, u8[].filled(0, 0));
      if ((await store.range(base, bump(base), 1)).len() == 0) { missing.push(ch); }
    }
    from = accounts.len() < 4096 ? null : nextKey(accounts.get(accounts.len() - 1).key);
  }
  return await fetchCodes(peers, store, f, missing);
}

/** Codes wanted, and the next batch of them a worker takes. */
struct CodeJob {
  Vec<u8[]> list;
  Map<string, bool> wanted;
  i32 next;
  i32 peers;
}

/** The codes with these hashes, from every peer at once, each a batch at a time; each checked against its hash. */
async string fetchCodes(Asker[] peers, Store store, Fetched f, Vec<u8[]> hashes) {
  CodeJob job = CodeJob(hashes, Map.create(hashText, textEq), 0, peers.len());
  for (i32 i = 0; i < hashes.len(); i++) { job.wanted.set(text(hashes.get(i)), true); }
  Ticket<string>[] work = Ticket<string>[].filled(peers.len(), accountsDone());
  for (i32 i = 0; i < peers.len(); i++) { work[i] = codesFrom(peers[i], store, f, job); }
  string why = "";
  for (i32 i = 0; i < peers.len(); i++) {
    string w = await work[i];
    if (why == "") { why = w; }
  }
  return why;
}

async string codesFrom(Asker peer, Store store, Fetched f, CodeJob job) {
  while (job.next < job.list.len()) {
    // A share of what is left, so that a few codes still go to every peer; at most 64 a request.
    i32 left = job.list.len() - job.next;
    i32 n = (left + job.peers - 1) / job.peers;
    if (n > 64) { n = 64; }
    Vec<u8[]> batch = Vec.create();
    for (i32 i = 0; i < n; i++) { batch.push(job.list.get(job.next + i)); }
    job.next += n;
    while (batch.len() > 0) {
      u64 id = peer.nextId;
      peer.nextId++;
      f.requests++;
      Item[]? got = await peer.ask(getByteCodes(id, batch.toArray(), peer.bytes));
      if (got is null || got!.len() < 1) { return "a peer did not answer for codes"; }
      Item[] cs = itemsOf(got![0]);
      if (cs.len() == 0) { return "a peer has none of the codes asked for"; }
      Vec<Change> out = Vec.create();
      Map<string, bool> came = Map.create(hashText, textEq);
      for (i32 i = 0; i < cs.len(); i++) {
        u8[] code = bytesOf(cs[i]);
        u8[] h = keccak256(code);
        if (!job.wanted.has(text(h))) { return "a code that was not asked for"; }
        came.set(text(h), true);
        i32 k = 0;
        for (i32 c = 0; c < code.len(); c += CHUNK) {
          i32 len = code.len() - c < CHUNK ? code.len() - c : CHUNK;
          u8[] part = u8[].filled(len, 0);
          part.copyFrom(code, c, 0, len);
          out.push(Change(key(2, h, [(k >> 8) as! u8, (k & 255) as! u8]), part));
          k++;
        }
        f.codes++;
      }
      string bad = await store.commit(out.toArray(), u8[].filled(0, 0));
      if (bad != "") { return bad; }
      // What the answer left out (it was cut short, or skipped some), asked for again.
      Vec<u8[]> rest = Vec.create();
      for (i32 i = 0; i < batch.len(); i++) {
        if (!came.has(text(batch.get(i)))) { rest.push(batch.get(i)); }
      }
      batch = rest;
    }
  }
  return "";
}

async string accountsDone() { return ""; }

async Item[]? noAnswer() { return null; }

Fetched failedWith(Fetched f, string why) {
  f.error = why;
  return f;
}

u8[][] proofOf(Item p) {
  if (!isList(p)) { return u8[][].defaulted(0); }
  Item[] ns = itemsOf(p);
  u8[][] out = u8[][].defaulted(ns.len());
  for (i32 i = 0; i < ns.len(); i++) { out[i] = bytesOf(ns[i]); }
  return out;
}

string text(u8[] b) {
  u8[] d = "0123456789abcdef".toBytes();
  u8[] out = u8[].filled(b.len() * 2, 0);
  for (i32 i = 0; i < b.len(); i++) {
    out[2 * i] = d[(b[i] >> 4) as i32];
    out[2 * i + 1] = d[(b[i] & 15) as i32];
  }
  return string.fromBytes(out);
}

i32 hashText(string s) {
  u8[] b = s.toBytes();
  i32 h = 0;
  for (i32 i = 0; i < b.len(); i++) { h = h * 31 + (b[i] as i32); }
  return h;
}

bool textEq(string a, string b) { return a == b; }
