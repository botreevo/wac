// Blocks the node keeps on disk beside the state, so that the eth_ methods answer for blocks no longer held in
// memory (the engine's archive holds the last `--history` of them):
//
//     blocks        0x06 ‖ block hash ‖ u16 chunk     the block's RLP, 32 KB a chunk, written as it is committed
//     canonical     0x07 ‖ number (8 bytes)           the hash of the finalized block at that height
//     transactions  0x08 ‖ transaction hash           its finalized block's hash ‖ its index (4 bytes)
//
// A block is kept by hash when it is imported, so a fork's blocks are kept too and a reorg changes nothing
// here; the two indexes are written only for finalized blocks, which no reorg can touch.

import { U256 } from "../u256.wac";
import { Change } from "./tree.wac";
import { chunked } from "./receipts.wac";

export u8[] blockKey(U256 hash) {
  u8[] out = u8[].filled(33, 6);
  out.copyFrom(hash.toBytes(), 0, 1, 32);
  return out;
}

export Change[] blockChanges(U256 hash, u8[] rlp) { return chunked(blockKey(hash), rlp); }

export u8[] canonicalKey(u64 number) {
  u8[] out = u8[].filled(9, 7);
  for (i32 i = 0; i < 8; i++) { out[1 + i] = ((number >> ((56 - 8 * i) as! u64)) & 255) as! u8; }
  return out;
}

export u8[] txKey(U256 hash) {
  u8[] out = u8[].filled(33, 8);
  out.copyFrom(hash.toBytes(), 0, 1, 32);
  return out;
}

/** A transaction's place, as `txKey` keeps it. */
export u8[] txPlace(U256 block, i32 index) {
  u8[] out = u8[].filled(36, 0);
  out.copyFrom(block.toBytes(), 0, 0, 32);
  for (i32 i = 0; i < 4; i++) { out[32 + i] = ((index >> (24 - 8 * i)) & 255) as! u8; }
  return out;
}

export i32 placeIndex(u8[] v) { return ((v[32] as i32) << 24) | ((v[33] as i32) << 16) | ((v[34] as i32) << 8) | (v[35] as i32); }
