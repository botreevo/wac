// What the store asks of a file: read and write at an offset, make it durable, say how long it is. A real
// file is `file.wac`'s; this file also has one in memory that can crash, which is how the store's tests
// check that a crash at any write leaves the last committed state whole. (Apart, so that what uses only the
// one in memory needs no grant to the host's files.)

import { Ticket, Result, Vec } from "core";

export struct Disk {
  /** Up to `n` bytes from `at`; fewer only past the end. */
  fn<Ticket<Result<u8[], string>>(i64, i32)> read;
  fn<Ticket<Result<void, string>>(i64, u8[])> write;
  /** Everything written so far is on the disk itself once this answers. */
  fn<Ticket<Result<void, string>>()> sync;
  fn<Ticket<Result<i64, string>>()> size;
}

/** A write not yet made durable. */
struct Pending {
  i64 at;
  u8[] bytes;
}

/**
 * A disk in memory, for tests. Writes are pending until `sync`; `crash` throws away what is pending, or keeps
 * only the writes a mask chooses (a disk may persist any subset of unsynced writes, in any order); and from
 * `failAfter` writes on, every write is refused, which stops a commit part way.
 */
export struct MemDisk {
  u8[] durable;
  i64 length;
  Vec<Pending> pending;
  i32 writes;
  i32 failAfter;

  MemDisk create() { return MemDisk(u8[].filled(0, 0), 0, Vec.create(), 0, -1); }

  Disk disk(this) {
    MemDisk m = this;
    return Disk(async (i64 at, i32 n) => Result.Ok(m.readNow(at, n)), async (i64 at, u8[] b) => {
      if (m.failAfter >= 0 && m.writes >= m.failAfter) { return Result.Err("the disk refuses writes"); }
      m.writes++;
      m.pending.push(Pending(at, b));
      if (at + (b.len() as i64) > m.length) { m.length = at + (b.len() as i64); }
      return Result.Ok();
    }, async () => {
      if (m.failAfter >= 0 && m.writes >= m.failAfter) { return Result.Err("the disk refuses to sync"); }
      for (i32 i = 0; i < m.pending.len(); i++) { m.apply(m.pending.get(i)); }
      m.pending.clear();
      return Result.Ok();
    }, async () => Result.Ok(m.length));
  }

  /** What a reader sees: the durable bytes with the pending writes over them. */
  u8[] readNow(this, i64 at, i32 n) {
    i64 end = at + (n as i64) < this.length ? at + (n as i64) : this.length;
    if (end <= at) { return u8[].filled(0, 0); }
    u8[] out = u8[].filled((end - at) as! i32, 0);
    for (i64 i = at; i < end && i < (this.durable.len() as i64); i++) { out[(i - at) as! i32] = this.durable[i as! i32]; }
    for (i32 p = 0; p < this.pending.len(); p++) {
      Pending w = this.pending.get(p);
      for (i32 k = 0; k < w.bytes.len(); k++) {
        i64 pos = w.at + (k as i64);
        if (pos >= at && pos < end) { out[(pos - at) as! i32] = w.bytes[k]; }
      }
    }
    return out;
  }

  void apply(this, Pending w) {
    i64 end = w.at + (w.bytes.len() as i64);
    if (end > (this.durable.len() as i64)) {
      u8[] grown = u8[].filled(end as! i32, 0);
      grown.copyFrom(this.durable, 0, 0, this.durable.len());
      this.durable = grown;
    }
    this.durable.copyFrom(w.bytes, 0, w.at as! i32, w.bytes.len());
  }

  /** Another disk holding what this one holds durably now: a point to go back to, for tests. */
  MemDisk copy(this) {
    u8[] d = u8[].filled(this.durable.len(), 0);
    d.copyFrom(this.durable, 0, 0, d.len());
    return MemDisk(d, d.len() as i64, Vec.create(), 0, -1);
  }

  /** Power lost: the pending writes the mask's bits pick survive (bit i for write i), the rest do not. */
  void crash(this, u64 keep) {
    for (i32 i = 0; i < this.pending.len(); i++) {
      if (((keep >> ((i % 64) as! u64)) & 1) == 1) { this.apply(this.pending.get(i)); }
    }
    this.pending.clear();
    this.length = this.durable.len() as i64;
    this.failAfter = -1;
  }
}
