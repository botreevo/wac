// A store's disk on the host's file system, through `RandomFile`.

import { Sys, RandomFile } from "std";
import { Result } from "core";
import { Disk } from "./disk.wac";

/** A file on the host's disk, created if absent. */
export async Result<Disk, string> fileDisk(Sys sys, string path) {
  RandomFile f = match (await sys.files().openRandom(path, true)) {
    Ok(r): r,
    Err(e): return Result.Err("cannot open \{path}: \{e}"),
  };
  return Result.Ok(Disk(async (i64 at, i32 n) => {
    match (await f.readAt(at, n)) {
      Ok(b): { return Result.Ok(b); }
      Err(e): { return Result.Err("read at \{at}: \{e}"); }
    }
  }, (i64 at, i32 n) => readNow(f, at, n), async (i64 at, u8[] b) => {
    match (await f.writeAt(at, b)) {
      Ok(v): { return Result.Ok(); }
      Err(e): { return Result.Err("write at \{at}: \{e}"); }
    }
  }, async () => {
    match (await f.sync()) {
      Ok(v): { return Result.Ok(); }
      Err(e): { return Result.Err("sync: \{e}"); }
    }
  }, async () => {
    match (await f.size()) {
      Ok(n): { return Result.Ok(n); }
      Err(e): { return Result.Err("size: \{e}"); }
    }
  }));
}


/**
 * A read waited for where it is asked: the host's ticket driven to its answer, with no `async` frame around
 * it (a `wait` on one that awaits another keeps it alive, wac 0473w; on the host's own ticket it does not).
 */
Result<u8[], string> readNow(RandomFile f, i64 at, i32 n) {
  match (f.readAt(at, n).wait()) {
    Ok(r): {
      match (r) {
        Ok(b): { return Result.Ok(b); }
        Err(e): { return Result.Err("read at \{at}: \{e}"); }
      }
    }
    Err(stuck): { return Result.Err("read at \{at}: the host did not answer"); }
  }
}
