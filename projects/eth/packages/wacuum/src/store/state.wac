// Ethereum's state in the store: accounts, slots and code under snap's hashed keys, read into memory for a
// `World` as it needs them, and a block's changes written back as one commit.
//
//     account  0x00 ‖ keccak(address)                      rlp([nonce, balance, codeHash])
//     slot     0x01 ‖ keccak(address) ‖ keccak(slot)        rlp(value), absent for zero
//     code     0x02 ‖ codeHash ‖ u16 chunk                 the code, 32 KB a chunk (one for any code mainnet allows)
//
// Reads are asynchronous and a `World` is not, so a `StateDb` answers a `World`'s `StateSource` from what
// it has read already and notes what it has not; `fetch` then reads those, and the caller runs again (the
// speculation of `docs/state-on-disk.md`). The account's storage root is not kept yet: the trie by path is
// the next piece, and until then `rootOf` computes the root from every entry, which is for tests.

import { Map, Vec } from "core";
import { rlp.Item, rlp.encode, rlp.decode, rlp.itemsOf, rlp.bytesOf } from "@/lib.wac";
import { keccak256 } from "../crypto/keccak.wac";
import { U256 } from "../u256.wac";
import { World, Account, StateSource, ChangeSet, AccountState, slotMap, hashU256, eqU256, emptyCodeHash } from "../state/world.wac";
import { u256Bytes } from "../state/root.wac";
import { addressBytes, minimalBytes } from "../evm/evm.wac";
import { trieRoot, emptyRoot } from "../trie/trie.wac";
import { Store, Change, compareKeys } from "./tree.wac";

export u8[] accountKey(U256 addr) { return prefixed(0, keccak256(addressBytes(addr)), u8[].filled(0, 0)); }
export u8[] slotKey(U256 addr, U256 slot) { return prefixed(1, keccak256(addressBytes(addr)), keccak256(slot.toBytes())); }
export u8[] codeKey(U256 codeHash) { return prefixed(2, codeHash.toBytes(), u8[].filled(0, 0)); }

static i32 CHUNK = 32768;

/** A code as the store keeps it: under `codeKey`, a chunk at a time. */
void putCode(Vec<Change> out, U256 codeHash, u8[] code) {
  i32 i = 0;
  for (i32 at = 0; at < code.len(); at += CHUNK) {
    i32 n = code.len() - at < CHUNK ? code.len() - at : CHUNK;
    u8[] part = u8[].filled(n, 0);
    part.copyFrom(code, at, 0, n);
    out.push(Change(prefixed(2, codeHash.toBytes(), [(i >> 8) as! u8, (i & 255) as! u8]), part));
    i++;
  }
}

/** A code back from its chunks, or null if there are none. */
async u8[]? getCode(Store store, U256 codeHash) {
  u8[] base = codeKey(codeHash);
  Vec<Change> parts = await store.range(base, after(base), 0x7fffffff);
  if (parts.len() == 0) { return null; }
  i32 n = 0;
  for (i32 i = 0; i < parts.len(); i++) { n += parts.get(i).value!.len(); }
  u8[] code = u8[].filled(n, 0);
  i32 at = 0;
  for (i32 i = 0; i < parts.len(); i++) {
    u8[] v = parts.get(i).value!;
    code.copyFrom(v, 0, at, v.len());
    at += v.len();
  }
  return code;
}

u8[] prefixed(u8 kind, u8[] a, u8[] b) {
  u8[] out = u8[].filled(1 + a.len() + b.len(), kind);
  out.copyFrom(a, 0, 1, a.len());
  out.copyFrom(b, 0, 1 + a.len(), b.len());
  return out;
}

/** The first key after every key that starts with `p`, for a range's end. */
u8[] after(u8[] p) {
  u8[] out = u8[].filled(p.len(), 0);
  out.copyFrom(p, 0, 0, p.len());
  i32 i = p.len() - 1;
  while (i >= 0 && out[i] == 255) {
    out[i] = 0;
    i--;
  }
  if (i >= 0) { out[i] = out[i] + 1; }
  return out;
}

/** An account as the store has it, with whether any slot of it is stored. */
struct Known {
  u64 nonce;
  U256 balance;
  U256 codeHash;
  u8[] code;
  bool hasStorage;
}

export struct StateDb {
  Store store;
  /** Accounts read, by address: null for one the store does not have. */
  Map<U256, Known?> accounts;
  /** Slots read, zero included, by address. */
  Map<U256, Map<U256, U256>> slots;
  Map<U256, bool> wantAccounts;
  Map<U256, Map<U256, bool>> wantSlots;
  /** Reads a run asked for that were not in memory: the run must go again once `fetch` has read them. */
  i32 misses;

  StateDb over(Store store) {
    return StateDb(store, Map.create(hashU256, eqU256), Map.create(hashU256, eqU256), Map.create(hashU256, eqU256),
                   Map.create(hashU256, eqU256), 0);
  }

  /** What a `World` backed by this asks: answered from memory, a miss noted and answered as empty. */
  StateSource source(this) {
    StateDb d = this;
    return StateSource((U256 addr) => d.account(addr), (U256 addr, U256 key) => d.slot(addr, key), (U256 addr) => d.hasStorage(addr));
  }

  Account? account(this, U256 addr) {
    if (!this.accounts.has(addr)) {
      this.wantAccounts.set(addr, true);
      this.misses++;
      return null;
    }
    Known? k = this.accounts.get(addr)!;
    if (k is null) { return null; }
    return Account(k!.nonce, k!.balance, k!.code, k!.codeHash, slotMap(), null, Map.create(hashU256, eqU256));
  }

  U256 slot(this, U256 addr, U256 key) {
    Map<U256, U256>? m = this.slots.get(addr);
    U256? v = m?.get(key);
    if (v is not null) { return v!; }
    Map<U256, bool>? w = this.wantSlots.get(addr);
    if (w is null) {
      Map<U256, bool> fresh = Map.create(hashU256, eqU256);
      this.wantSlots.set(addr, fresh);
      w = fresh;
    }
    w!.set(key, true);
    this.misses++;
    return U256.zero();
  }

  bool hasStorage(this, U256 addr) {
    Known? k = this.accounts.get(addr) ?? null;
    return k is not null && k!.hasStorage;
  }

  /** Read everything the last run missed. "" or why not. */
  async string fetch(this) {
    U256[] addrs = this.wantAccounts.keys();
    for (i32 i = 0; i < addrs.len(); i++) {
      u8[]? raw = await this.store.get(accountKey(addrs[i]));
      if (raw is null) {
        this.accounts.set(addrs[i], null);
        continue;
      }
      Item[] f = itemsOf(decode(raw!).item);
      U256 codeHash = U256.fromBytes(bytesOf(f[2]), 0, 32);
      u8[] code = u8[].filled(0, 0);
      if (!codeHash.eq(emptyCodeHash())) {
        u8[]? c = await getCode(this.store, codeHash);
        if (c is null) { return "the code of \{codeHash.toHex()} is not stored"; }
        code = c!;
      }
      u8[] prefix = prefixed(1, keccak256(addressBytes(addrs[i])), u8[].filled(0, 0));
      Vec<Change> any = await this.store.range(prefix, after(prefix), 1);
      this.accounts.set(addrs[i], Known(U256.fromBytes(bytesOf(f[0]), 0, bytesOf(f[0]).len()).low(), U256.fromBytes(bytesOf(f[1]), 0, bytesOf(f[1]).len()),
                                        codeHash, code, any.len() > 0));
    }
    this.wantAccounts = Map.create(hashU256, eqU256);
    U256[] holders = this.wantSlots.keys();
    for (i32 i = 0; i < holders.len(); i++) {
      U256[] keys = this.wantSlots.get(holders[i])!.keys();
      Map<U256, U256>? m = this.slots.get(holders[i]);
      if (m is null) {
        Map<U256, U256> fresh = Map.create(hashU256, eqU256);
        this.slots.set(holders[i], fresh);
        m = fresh;
      }
      for (i32 k = 0; k < keys.len(); k++) {
        u8[]? raw = await this.store.get(slotKey(holders[i], keys[k]));
        U256 v = U256.zero();
        if (raw is not null) {
          u8[] b = bytesOf(decode(raw!).item);
          v = U256.fromBytes(b, 0, b.len());
        }
        m!.set(keys[k], v);
      }
    }
    this.wantSlots = Map.create(hashU256, eqU256);
    return "";
  }

  /**
   * A block's changes, as `World.seal` recorded them, committed with `user` beside them; what was read
   * into memory is forgotten for the accounts and slots it changed, so the next read sees the store.
   */
  async string flush(this, ChangeSet cs, u8[] user) {
    Vec<Change> out = Vec.create();
    U256[] addrs = cs.after.keys();
    for (i32 i = 0; i < addrs.len(); i++) {
      AccountState a = cs.after.get(addrs[i])!;
      if (!a.exists) {
        out.push(Change(accountKey(addrs[i]), null));
        // Gone, so its storage with it.
        u8[] prefix = prefixed(1, keccak256(addressBytes(addrs[i])), u8[].filled(0, 0));
        Vec<Change> slots = await this.store.range(prefix, after(prefix), 0x7fffffff);
        for (i32 k = 0; k < slots.len(); k++) { out.push(Change(slots.get(k).key, null)); }
      } else {
        out.push(Change(accountKey(addrs[i]), accountValue(a.nonce, a.balance, a.codeHash)));
        if (a.code.len() > 0) { putCode(out, a.codeHash, a.code); }
      }
      this.accounts.remove(addrs[i]);
      this.slots.remove(addrs[i]);
    }
    U256[] holders = cs.slotsAfter.keys();
    for (i32 i = 0; i < holders.len(); i++) {
      Map<U256, U256> m = cs.slotsAfter.get(holders[i])!;
      U256[] keys = m.keys();
      for (i32 k = 0; k < keys.len(); k++) {
        U256 v = m.get(keys[k])!;
        out.push(Change(slotKey(holders[i], keys[k]), v.isZero() ? null : encode(Item.Bytes(u256Bytes(v)))));
      }
      this.slots.remove(holders[i]);
    }
    return await this.store.commit(out.toArray(), user);
  }
}

u8[] accountValue(u64 nonce, U256 balance, U256 codeHash) {
  return encode(Item.List([Item.Bytes(minimalBytes(nonce)), Item.Bytes(u256Bytes(balance)), Item.Bytes(codeHash.toBytes())]));
}

/** Every account and slot of `w` (with code), as one commit's changes: a genesis or a test's pre-state. */
export Change[] changesOf(World w) {
  Vec<Change> out = Vec.create();
  U256[] addrs = w.accounts.keys();
  for (i32 i = 0; i < addrs.len(); i++) {
    Account a = w.accounts.get(addrs[i])!;
    out.push(Change(accountKey(addrs[i]), accountValue(a.nonce, a.balance, a.codeHash)));
    if (a.code.len() > 0) { putCode(out, a.codeHash, a.code); }
    U256[] keys = a.storage.keys();
    for (i32 k = 0; k < keys.len(); k++) {
      out.push(Change(slotKey(addrs[i], keys[k]), encode(Item.Bytes(u256Bytes(a.storage.get(keys[k])!)))));
    }
  }
  return out.toArray();
}

/**
 * The state root of everything in the store, built from scratch: each account's storage root from its
 * slots, then the account trie. For tests and small states — the trie by path replaces it.
 */
export async u8[] rootOf(Store store) {
  Vec<Change> accounts = await store.range([0], [1], 0x7fffffff);
  u8[][] keys = u8[][].defaulted(accounts.len());
  u8[][] vals = u8[][].defaulted(accounts.len());
  for (i32 i = 0; i < accounts.len(); i++) {
    Change c = accounts.get(i);
    u8[] hashed = u8[].filled(32, 0);
    hashed.copyFrom(c.key, 1, 0, 32);
    u8[] prefix = prefixed(1, hashed, u8[].filled(0, 0));
    Vec<Change> slots = await store.range(prefix, after(prefix), 0x7fffffff);
    u8[][] sk = u8[][].defaulted(slots.len());
    u8[][] sv = u8[][].defaulted(slots.len());
    for (i32 k = 0; k < slots.len(); k++) {
      u8[] h = u8[].filled(32, 0);
      h.copyFrom(slots.get(k).key, 33, 0, 32);
      sk[k] = h;
      sv[k] = slots.get(k).value!;
    }
    Item[] f = itemsOf(decode(c.value!).item);
    keys[i] = hashed;
    vals[i] = encode(Item.List([f[0], f[1], Item.Bytes(slots.len() == 0 ? emptyRoot() : trieRoot(sk, sv)), f[2]]));
  }
  return accounts.len() == 0 ? emptyRoot() : trieRoot(keys, vals);
}
