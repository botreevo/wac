// Ethereum's state in the store: accounts, slots and code under snap's hashed keys, and the account trie and
// every storage trie by path beside them, so that the state root is the store's own. A `World` reads it as
// it needs to, and a block's changes are written back, tries and all, as one commit.
//
//     account       0x00 ‖ keccak(address)                  rlp([nonce, balance, storageRoot, codeHash])
//     slot          0x01 ‖ keccak(address) ‖ keccak(slot)    rlp(value), absent for zero
//     code          0x02 ‖ codeHash ‖ u16 chunk             the code, 12 KB a chunk (CHUNK; two for the largest code mainnet allows)
//     account trie  0x03 ‖ path                             (src/trie/pathtrie.wac)
//     storage trie  0x04 ‖ keccak(address) ‖ path
//
// Reads are asynchronous and a `World` is not, so a `StateDb` answers a `World`'s `StateSource` from what it
// has read already and notes what it has not; `fetch` then reads those and the caller runs again (the
// speculation of `docs/state-on-disk.md`).

import { Map, Vec } from "core";
import { rlp.Item, rlp.encode, rlp.decode, rlp.itemsOf, rlp.bytesOf } from "@/lib.wac";
import { keccak256 } from "../crypto/keccak.wac";
import { U256 } from "../u256.wac";
import { World, Account, StateSource, ChangeSet, AccountState, slotMap, hashU256, eqU256, emptyCodeHash } from "../state/world.wac";
import { u256Bytes } from "../state/root.wac";
import { addressBytes, minimalBytes } from "../evm/evm.wac";
import { trieRoot, emptyRoot } from "../trie/trie.wac";
import { PathTrie } from "../trie/pathtrie.wac";
import { Store, Change, compareKeys, CHUNK } from "./tree.wac";

export u8[] accountKey(U256 addr) { return prefixed(0, keccak256(addressBytes(addr)), u8[].filled(0, 0)); }
export u8[] slotKey(U256 addr, U256 slot) { return prefixed(1, keccak256(addressBytes(addr)), keccak256(slot.toBytes())); }
export u8[] codeKey(U256 codeHash) { return prefixed(2, codeHash.toBytes(), u8[].filled(0, 0)); }

u8[] prefixed(u8 kind, u8[] a, u8[] b) {
  u8[] out = u8[].filled(1 + a.len() + b.len(), kind);
  out.copyFrom(a, 0, 1, a.len());
  out.copyFrom(b, 0, 1 + a.len(), b.len());
  return out;
}

/** The first key after every key that starts with `p`, for a range's end. */
u8[] after(u8[] p) {
  u8[] out = u8[].filled(p.len(), 0);
  out.copyFrom(p, 0, 0, p.len());
  i32 i = p.len() - 1;
  while (i >= 0 && out[i] == 255) {
    out[i] = 0;
    i--;
  }
  if (i >= 0) { out[i] = out[i] + 1; }
  return out;
}



/** A code as the store keeps it: under `codeKey`, a chunk at a time. */
void putCode(Vec<Change> out, U256 codeHash, u8[] code) {
  i32 i = 0;
  for (i32 at = 0; at < code.len(); at += CHUNK) {
    i32 n = code.len() - at < CHUNK ? code.len() - at : CHUNK;
    u8[] part = u8[].filled(n, 0);
    part.copyFrom(code, at, 0, n);
    out.push(Change(prefixed(2, codeHash.toBytes(), [(i >> 8) as! u8, (i & 255) as! u8]), part));
    i++;
  }
}

/** A code back from its chunks, or null if there are none. */
async u8[]? getCode(Store store, U256 codeHash) {
  u8[] base = codeKey(codeHash);
  Vec<Change> parts = await store.range(base, after(base), 0x7fffffff);
  if (parts.len() == 0) { return null; }
  i32 n = 0;
  for (i32 i = 0; i < parts.len(); i++) { n += parts.get(i).value!.len(); }
  u8[] code = u8[].filled(n, 0);
  i32 at = 0;
  for (i32 i = 0; i < parts.len(); i++) {
    u8[] v = parts.get(i).value!;
    code.copyFrom(v, 0, at, v.len());
    at += v.len();
  }
  return code;
}

U256 intOf(Item it) {
  u8[] b = bytesOf(it);
  return U256.fromBytes(b, 0, b.len());
}

/** An account as the store has it. */
struct Known {
  u64 nonce;
  U256 balance;
  U256 storageRoot;
  U256 codeHash;
  u8[] code;
}

u8[] accountValue(u64 nonce, U256 balance, U256 storageRoot, U256 codeHash) {
  return encode(Item.List([Item.Bytes(minimalBytes(nonce)), Item.Bytes(u256Bytes(balance)), Item.Bytes(storageRoot.toBytes()),
                           Item.Bytes(codeHash.toBytes())]));
}

/** Changes ready to commit, and the state root they come to. */
export struct Staged {
  Change[] changes;
  u8[] root;
}

export struct StateDb {
  Store store;
  /** Accounts read, by address: null for one the store does not have. */
  Map<U256, Known?> accounts;
  /** Slots read, zero included, by address. */
  Map<U256, Map<U256, U256>> slots;
  Map<U256, bool> wantAccounts;
  Map<U256, Map<U256, bool>> wantSlots;
  /** Reads a run asked for that were not in memory: the run must go again once `fetch` has read them. */
  i32 misses;
  /** The account trie, kept between commits so its upper nodes stay read. */
  PathTrie? accountTrie;
  /**
   * Whether a miss is read from the store where it happens (`Store.getNow`) rather than noted for `fetch`:
   * then nothing is ever missed and no step runs twice. Measured on mainnet blocks it is several times
   * faster than learning the misses by running again (docs/state-on-disk.md).
   */
  bool readsNow;

  StateDb over(Store store) {
    return StateDb(store, Map.create(hashU256, eqU256), Map.create(hashU256, eqU256), Map.create(hashU256, eqU256),
                   Map.create(hashU256, eqU256), 0, null, true);
  }

  /** The account as stored, read where it is asked; null if there is none. */
  Known? readNow(this, U256 addr) {
    u8[]? raw = this.store.getNow(accountKey(addr));
    if (raw is null) { return null; }
    Item[] f = itemsOf(decode(raw!).item);
    U256 codeHash = U256.fromBytes(bytesOf(f[3]), 0, 32);
    u8[] code = u8[].filled(0, 0);
    if (!codeHash.eq(emptyCodeHash())) {
      u8[] base = codeKey(codeHash);
      Vec<Change> parts = this.store.rangeNow(base, after(base), 0x7fffffff);
      i32 n = 0;
      for (i32 i = 0; i < parts.len(); i++) { n += parts.get(i).value!.len(); }
      code = u8[].filled(n, 0);
      i32 at = 0;
      for (i32 i = 0; i < parts.len(); i++) {
        code.copyFrom(parts.get(i).value!, 0, at, parts.get(i).value!.len());
        at += parts.get(i).value!.len();
      }
    }
    return Known(intOf(f[0]).low(), intOf(f[1]), U256.fromBytes(bytesOf(f[2]), 0, 32), codeHash, code);
  }

  /** What a `World` backed by this asks: answered from memory, a miss noted and answered as empty. */
  StateSource source(this) {
    StateDb d = this;
    return StateSource((U256 addr) => d.account(addr), (U256 addr, U256 key) => d.slot(addr, key), (U256 addr) => d.hasStorage(addr));
  }

  Account? account(this, U256 addr) {
    if (!this.accounts.has(addr) && this.readsNow) { this.accounts.set(addr, this.readNow(addr)); }
    if (!this.accounts.has(addr)) {
      this.wantAccounts.set(addr, true);
      this.misses++;
      return null;
    }
    Known? k = this.accounts.get(addr)!;
    if (k is null) { return null; }
    return Account(k!.nonce, k!.balance, k!.code, k!.codeHash, slotMap(), null, Map.create(hashU256, eqU256));
  }

  U256 slot(this, U256 addr, U256 key) {
    Map<U256, U256>? m = this.slots.get(addr);
    U256? v = m?.get(key);
    if (v is not null) { return v!; }
    if (this.readsNow) {
      u8[]? raw = this.store.getNow(slotKey(addr, key));
      U256 got = raw is null ? U256.zero() : intOf(decode(raw!).item);
      if (m is null) {
        Map<U256, U256> fresh = Map.create(hashU256, eqU256);
        this.slots.set(addr, fresh);
        m = fresh;
      }
      m!.set(key, got);
      return got;
    }
    Map<U256, bool>? w = this.wantSlots.get(addr);
    if (w is null) {
      Map<U256, bool> fresh = Map.create(hashU256, eqU256);
      this.wantSlots.set(addr, fresh);
      w = fresh;
    }
    w!.set(key, true);
    this.misses++;
    return U256.zero();
  }

  /** Whether the account's storage holds anything: its storage root is not the empty trie's. */
  bool hasStorage(this, U256 addr) {
    Known? k = this.accounts.get(addr) ?? null;
    return k is not null && !k!.storageRoot.eq(U256.fromBytes(emptyRoot(), 0, 32));
  }

  /** The account as stored, or null; not cached. */
  async Known? read(this, U256 addr) {
    u8[]? raw = await this.store.get(accountKey(addr));
    if (raw is null) { return null; }
    Item[] f = itemsOf(decode(raw!).item);
    U256 codeHash = U256.fromBytes(bytesOf(f[3]), 0, 32);
    u8[] code = u8[].filled(0, 0);
    if (!codeHash.eq(emptyCodeHash())) { code = (await getCode(this.store, codeHash)) ?? u8[].filled(0, 0); }
    return Known(intOf(f[0]).low(), intOf(f[1]), U256.fromBytes(bytesOf(f[2]), 0, 32), codeHash, code);
  }

  /** Read everything the last run missed. "" or why not. */
  async string fetch(this) {
    U256[] addrs = this.wantAccounts.keys();
    for (i32 i = 0; i < addrs.len(); i++) {
      Known? k = await this.read(addrs[i]);
      if (k is not null && !k!.codeHash.eq(emptyCodeHash()) && k!.code.len() == 0) { return "the code of \{k!.codeHash.toHex()} is not stored"; }
      this.accounts.set(addrs[i], k);
    }
    this.wantAccounts = Map.create(hashU256, eqU256);
    U256[] holders = this.wantSlots.keys();
    for (i32 i = 0; i < holders.len(); i++) {
      U256[] keys = this.wantSlots.get(holders[i])!.keys();
      Map<U256, U256>? m = this.slots.get(holders[i]);
      if (m is null) {
        Map<U256, U256> fresh = Map.create(hashU256, eqU256);
        this.slots.set(holders[i], fresh);
        m = fresh;
      }
      for (i32 k = 0; k < keys.len(); k++) {
        u8[]? raw = await this.store.get(slotKey(holders[i], keys[k]));
        m!.set(keys[k], raw is null ? U256.zero() : intOf(decode(raw!).item));
      }
    }
    this.wantSlots = Map.create(hashU256, eqU256);
    return "";
  }

  async PathTrie trie(this) {
    if (this.accountTrie is null) {
      PathTrie t = PathTrie.of(this.store, u8[].filled(0, 0));
      await t.open();
      this.accountTrie = t;
    }
    return this.accountTrie!;
  }

  /**
   * Accounts and slots — each account's new state, or null for gone, and the slots that changed under it —
   * as the changes that write them with the tries that commit to them, and the state root they come to;
   * nothing is written until `commitStaged`, and `discard` forgets them instead. Null with `why[0]` saying
   * why. What was read into memory is forgotten for what changed.
   */
  async Staged? stage(this, U256[] addrs, AccountState?[] states, Map<U256, Map<U256, U256>> slotsOf, string[] why) {
    Vec<Change> out = Vec.create();
    PathTrie accounts = await this.trie();
    // Every account with changed slots, or changed itself.
    Map<U256, bool> touched = Map.create(hashU256, eqU256);
    for (i32 i = 0; i < addrs.len(); i++) { touched.set(addrs[i], true); }
    U256[] holders = slotsOf.keys();
    for (i32 i = 0; i < holders.len(); i++) { touched.set(holders[i], true); }
    Map<U256, AccountState?> stateOf = Map.create(hashU256, eqU256);
    for (i32 i = 0; i < addrs.len(); i++) { stateOf.set(addrs[i], states[i]); }
    U256[] all = touched.keys();
    for (i32 i = 0; i < all.len(); i++) {
      U256 addr = all[i];
      u8[] owner = keccak256(addressBytes(addr));
      Known? before = await this.read(addr);
      // Its state now: as written, or as stored when only its slots changed.
      bool written = stateOf.has(addr);
      AccountState? now = written ? stateOf.get(addr)! : null;
      bool exists = written ? now is not null && now!.exists : before is not null;
      if (!exists) {
        // Gone, and its storage with it: every slot and every node of its trie.
        u8[] sp = prefixed(1, owner, u8[].filled(0, 0));
        Vec<Change> gone = await this.store.range(sp, after(sp), 0x7fffffff);
        for (i32 k = 0; k < gone.len(); k++) { out.push(Change(gone.get(k).key, null)); }
        u8[] tp = prefixed(4, owner, u8[].filled(0, 0));
        Vec<Change> nodes = await this.store.range(tp, after(tp), 0x7fffffff);
        for (i32 k = 0; k < nodes.len(); k++) { out.push(Change(nodes.get(k).key, null)); }
        if (before is not null) {
          out.push(Change(accountKey(addr), null));
          await accounts.delete(owner);
        }
      } else {
        U256 root = before is null ? U256.fromBytes(emptyRoot(), 0, 32) : before!.storageRoot;
        Map<U256, U256>? slots = slotsOf.get(addr);
        if (slots is not null) {
          PathTrie st = PathTrie.of(this.store, owner);
          await st.open();
          U256[] keys = slots!.keys();
          for (i32 k = 0; k < keys.len(); k++) {
            U256 v = slots!.get(keys[k])!;
            u8[] hk = keccak256(keys[k].toBytes());
            if (v.isZero()) {
              out.push(Change(slotKey(addr, keys[k]), null));
              await st.delete(hk);
            } else {
              u8[] enc = encode(Item.Bytes(u256Bytes(v)));
              out.push(Change(slotKey(addr, keys[k]), enc));
              await st.set(hk, enc);
            }
          }
          if (st.error != "") {
            why[0] = st.error;
            this.discard();
            return null;
          }
          root = U256.fromBytes(st.hash(), 0, 32);
          Change[] nodes = st.changes();
          for (i32 k = 0; k < nodes.len(); k++) { out.push(nodes[k]); }
        }
        u64 nonce = written ? now!.nonce : before!.nonce;
        U256 balance = written ? now!.balance : before!.balance;
        U256 codeHash = written ? now!.codeHash : before!.codeHash;
        if (written && now!.code.len() > 0 && (before is null || !before!.codeHash.eq(codeHash))) { putCode(out, codeHash, now!.code); }
        u8[] value = accountValue(nonce, balance, root, codeHash);
        out.push(Change(accountKey(addr), value));
        await accounts.set(owner, value);
      }
      this.accounts.remove(addr);
      this.slots.remove(addr);
    }
    if (accounts.error != "") {
      why[0] = accounts.error;
      this.discard();
      return null;
    }
    u8[] root = accounts.hash();
    Change[] nodes = accounts.changes();
    for (i32 k = 0; k < nodes.len(); k++) { out.push(nodes[k]); }
    return Staged(out.toArray(), root);
  }

  /** What `stage` made, written, with `user` beside it. "" or why not. */
  async string commitStaged(this, Staged st, u8[] user) { return await this.commitWith(st, Change[].filled(0, Change(u8[].filled(0, 0), null)), user); }

  /** `commitStaged` with `extra` changes in the same commit (a block's receipts). */
  async string commitWith(this, Staged st, Change[] extra, u8[] user) {
    Change[] all = Change[].filled(st.changes.len() + extra.len(), Change(u8[].filled(0, 0), null));
    for (i32 i = 0; i < st.changes.len(); i++) { all[i] = st.changes[i]; }
    for (i32 i = 0; i < extra.len(); i++) { all[st.changes.len() + i] = extra[i]; }
    string bad = await this.store.commit(all, user);
    // What this block read is forgotten either way. Kept, it would be all the state the node ever touched,
    // decoded, growing until the heap stops (docs/state-cache.md); the next block reads what it needs again.
    // And a failed commit leaves the account trie in memory ahead of the store.
    this.discard();
    return bad;
  }

  /** What `stage` made, forgotten: the account trie is read from the store again, as is everything cached. */
  void discard(this) {
    this.accountTrie = null;
    this.accounts = Map.create(hashU256, eqU256);
    this.slots = Map.create(hashU256, eqU256);
  }

  /** `stage` and `commitStaged` together: the new state root, or null with `why[0]` saying why. */
  async u8[]? write(this, U256[] addrs, AccountState?[] states, Map<U256, Map<U256, U256>> slotsOf, u8[] user, string[] why) {
    Staged? st = await this.stage(addrs, states, slotsOf, why);
    if (st is null) { return null; }
    string bad = await this.commitStaged(st!, user);
    if (bad != "") {
      why[0] = bad;
      return null;
    }
    return st!.root;
  }

  /** A block's changes, as `World.seal` recorded them, written with `write`. */
  async u8[]? flush(this, ChangeSet cs, u8[] user, string[] why) {
    Staged? st = await this.stageSet(cs, true, why);
    if (st is null) { return null; }
    string bad = await this.commitStaged(st!, user);
    if (bad != "") {
      why[0] = bad;
      return null;
    }
    return st!.root;
  }

  /** A change set's after-states (`forward`) or before-states written: the new root, or null. */
  async u8[]? writeSet(this, ChangeSet cs, bool forward, u8[] user, string[] why) {
    Staged? st = await this.stageSet(cs, forward, why);
    if (st is null) { return null; }
    string bad = await this.commitStaged(st!, user);
    if (bad != "") {
      why[0] = bad;
      return null;
    }
    return st!.root;
  }

  /** A change set's after-states (`forward`) or before-states staged. */
  async Staged? stageSet(this, ChangeSet cs, bool forward, string[] why) {
    Map<U256, AccountState> acc = forward ? cs.after : cs.before;
    U256[] addrs = acc.keys();
    AccountState?[] states = AccountState?[].defaulted(addrs.len());
    for (i32 i = 0; i < addrs.len(); i++) { states[i] = acc.get(addrs[i])!; }
    return await this.stage(addrs, states, forward ? cs.slotsAfter : cs.slotsBefore, why);
  }

  /** Every account and slot of `w`, with code: a genesis, or a test's pre-state. */
  async u8[]? seed(this, World w, u8[] user, string[] why) {
    U256[] addrs = w.accounts.keys();
    AccountState?[] states = AccountState?[].defaulted(addrs.len());
    Map<U256, Map<U256, U256>> slots = Map.create(hashU256, eqU256);
    for (i32 i = 0; i < addrs.len(); i++) {
      Account a = w.accounts.get(addrs[i])!;
      states[i] = AccountState(true, a.nonce, a.balance, a.code, a.codeHash);
      if (a.storage.len() > 0) { slots.set(addrs[i], a.storage); }
    }
    return await this.write(addrs, states, slots, user, why);
  }
}

/**
 * The state root of everything in the store, built from scratch from the flat entries alone — each
 * account's storage root from its slots, then the account trie — ignoring the tries the store keeps. The
 * oracle the tries are checked against, for tests and small states.
 */
export async u8[] rootOf(Store store) {
  Vec<Change> accounts = await store.range([0], [1], 0x7fffffff);
  u8[][] keys = u8[][].defaulted(accounts.len());
  u8[][] vals = u8[][].defaulted(accounts.len());
  for (i32 i = 0; i < accounts.len(); i++) {
    Change c = accounts.get(i);
    u8[] hashed = u8[].filled(32, 0);
    hashed.copyFrom(c.key, 1, 0, 32);
    u8[] prefix = prefixed(1, hashed, u8[].filled(0, 0));
    Vec<Change> slots = await store.range(prefix, after(prefix), 0x7fffffff);
    u8[][] sk = u8[][].defaulted(slots.len());
    u8[][] sv = u8[][].defaulted(slots.len());
    for (i32 k = 0; k < slots.len(); k++) {
      u8[] h = u8[].filled(32, 0);
      h.copyFrom(slots.get(k).key, 33, 0, 32);
      sk[k] = h;
      sv[k] = slots.get(k).value!;
    }
    Item[] f = itemsOf(decode(c.value!).item);
    keys[i] = hashed;
    vals[i] = encode(Item.List([f[0], f[1], Item.Bytes(slots.len() == 0 ? emptyRoot() : trieRoot(sk, sv)), f[3]]));
  }
  return accounts.len() == 0 ? emptyRoot() : trieRoot(keys, vals);
}
