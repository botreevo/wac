// The state store: one file, a copy-on-write B+tree of byte keys and byte values, with 64 KB pages, the
// interior always in memory, and commits that are atomic across a crash. `docs/state-on-disk.md` says why
// each of those; in short, a host request costs ~55 µs whatever it carries, so a lookup is exactly one
// request (a leaf, its interior already in memory) and a page is big enough to make that request worth it.
//
// ## The file
//
// Pages of `PAGE` bytes. Pages 0 and 1 are the two meta slots; every other page is a node or a page of the
// free list. A commit writes every node it changed to pages no committed tree uses, syncs, then writes a
// meta into the slot the last commit did not use, and syncs again. The meta with the higher sequence number
// and a good checksum is the store: a crash anywhere before the second sync leaves the previous one, whose
// pages nothing has touched. (LMDB's scheme; it needs no log of its own.)
//
// A node is `kind` (0 leaf, 1 interior), a u32 count, then its entries: a leaf's are a u16 key length, the
// key, a u32 value length and the value; an interior's are a u16 key length, the key (the first key under
// that child) and the child's u64 page. Integers are little-endian.
//
// ## Free pages
//
// Pages a commit stops using are still the previous commit's, which is the one a crash goes back to, so
// they become free only at the commit after. The meta names the pages free at its commit — those left from
// before, those it freed, and the pages of the previous free list — written contiguously at the file's
// end, so the next commit can take them.

import { Map, Vec, Ticket, Result } from "core";
import { keccak256 } from "../crypto/keccak.wac";
import { Disk } from "./disk.wac";
import { EntryCache, Cached } from "./cache.wac";

export static i32 PAGE = 65536;
/** A value larger than this is refused: a leaf must hold at least one entry, with room for its key. */
export static i32 MAX_VALUE = 60000;
/**
 * Leaves kept in memory once read or written: few, since what is read again is kept as entries
 * (`cache.wac`), at a fifth of the memory a leaf costs for what it holds that anyone wants
 * (docs/state-cache.md). Enough for a commit's paths and a range read under way.
 */
export static i32 LEAVES = 64;
/** The entry cache's budget by default, in MB. */
export static i64 CACHE_MB = 256;
static u64 MAGIC = 0x4244554d55434157;

/** A node, decoded. A leaf's `vals` hold its values; an interior's `kids` hold its children once loaded. */
struct Node {
  bool leaf;
  /** Its page on disk, or -1 for one no commit has written yet. */
  i64 page;
  bool dirty;
  Vec<u8[]> keys;
  Vec<u8[]> vals;
  Vec<i64> kidPages;
  Vec<Node?> kids;
  /** What it encodes to. */
  i32 bytes;

  Node fresh(bool leaf) {
    return Node(leaf, -1, true, Vec.create(), Vec.create(), Vec.create(), Vec.create(), 5);
  }
}

u8[] plain(const u8[] b) {
  u8[] out = u8[].filled(b.len(), 0);
  for (i32 i = 0; i < b.len(); i++) { out[i] = b[i]; }
  return out;
}

/** -1, 0 or 1 as `a` sorts before, with, or after `b`, byte by byte. */
export i32 compareKeys(const u8[] a, const u8[] b) {
  i32 n = a.len() < b.len() ? a.len() : b.len();
  for (i32 i = 0; i < n; i++) {
    if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
  }
  return a.len() < b.len() ? -1 : a.len() > b.len() ? 1 : 0;
}

/** In a leaf's keys, where `key` is or would go, and whether it is there. */
(i32, bool) find(Vec<u8[]> keys, const u8[] key) {
  i32 lo = 0;
  i32 hi = keys.len();
  while (lo < hi) {
    i32 mid = (lo + hi) / 2;
    i32 c = compareKeys(keys.get(mid), key);
    if (c == 0) { return (mid, true); }
    if (c < 0) { lo = mid + 1; } else { hi = mid; }
  }
  return (lo, false);
}

/** In an interior's keys, the child `key` belongs under: the last whose first key is not after it, else 0. */
i32 childFor(Vec<u8[]> keys, const u8[] key) {
  i32 lo = 0;
  i32 hi = keys.len();
  while (lo < hi) {
    i32 mid = (lo + hi) / 2;
    if (compareKeys(keys.get(mid), key) <= 0) { lo = mid + 1; } else { hi = mid; }
  }
  return lo == 0 ? 0 : lo - 1;
}

i32 leafEntry(u8[] k, u8[] v) { return 6 + k.len() + v.len(); }
i32 interiorEntry(u8[] k) { return 10 + k.len(); }

void put16(u8[] b, i32 at, i32 v) {
  b[at] = (v & 255) as! u8;
  b[at + 1] = ((v >> 8) & 255) as! u8;
}
void put32(u8[] b, i32 at, i32 v) {
  for (i32 i = 0; i < 4; i++) { b[at + i] = ((v >> (8 * i)) & 255) as! u8; }
}
void put64(u8[] b, i32 at, i64 v) {
  for (i32 i = 0; i < 8; i++) { b[at + i] = ((v >> ((8 * i) as i64)) & 255) as! u8; }
}
i32 get16(u8[] b, i32 at) { return (b[at] as i32) | ((b[at + 1] as i32) << 8); }
i32 get32(u8[] b, i32 at) {
  i32 v = 0;
  for (i32 i = 0; i < 4; i++) { v = v | ((b[at + i] as i32) << (8 * i)); }
  return v;
}
i64 get64(u8[] b, i32 at) {
  i64 v = 0;
  for (i32 i = 0; i < 8; i++) { v = v | ((b[at + i] as i64) << ((8 * i) as i64)); }
  return v;
}

u8[] slice(u8[] b, i32 at, i32 n) {
  u8[] out = u8[].filled(n, 0);
  out.copyFrom(b, at, 0, n);
  return out;
}

u8[] encode(Node n) {
  u8[] out = u8[].filled(PAGE, 0);
  out[0] = n.leaf ? 0 : 1;
  put32(out, 1, n.keys.len());
  i32 at = 5;
  for (i32 i = 0; i < n.keys.len(); i++) {
    u8[] k = n.keys.get(i);
    put16(out, at, k.len());
    out.copyFrom(k, 0, at + 2, k.len());
    at += 2 + k.len();
    if (n.leaf) {
      u8[] v = n.vals.get(i);
      put32(out, at, v.len());
      out.copyFrom(v, 0, at + 4, v.len());
      at += 4 + v.len();
    } else {
      put64(out, at, n.kidPages.get(i));
      at += 8;
    }
  }
  return out;
}

Node? decode(u8[] b, i64 page) {
  if (b.len() < 5 || b[0] > 1) { return null; }
  bool leaf = b[0] == 0;
  Node n = Node(leaf, page, false, Vec.create(), Vec.create(), Vec.create(), Vec.create(), 5);
  i32 count = get32(b, 1);
  i32 at = 5;
  for (i32 i = 0; i < count; i++) {
    if (at + 2 > b.len()) { return null; }
    i32 kl = get16(b, at);
    if (at + 2 + kl > b.len()) { return null; }
    u8[] k = slice(b, at + 2, kl);
    at += 2 + kl;
    n.keys.push(k);
    if (leaf) {
      if (at + 4 > b.len()) { return null; }
      i32 vl = get32(b, at);
      if (vl < 0 || at + 4 + vl > b.len()) { return null; }
      n.vals.push(slice(b, at + 4, vl));
      at += 4 + vl;
      n.bytes += leafEntry(k, n.vals.get(i));
    } else {
      if (at + 8 > b.len()) { return null; }
      n.kidPages.push(get64(b, at));
      n.kids.push(null);
      at += 8;
      n.bytes += interiorEntry(k);
    }
  }
  return n;
}

/** What a commit records beside the tree: the caller's own bytes (which block, which root). */
export struct Committed {
  u64 seq;
  u8[] user;
}

/** A change to make: a value, or `null` to delete. */
export struct Change {
  u8[] key;
  u8[]? value;
}

/** A page's place in a write: the page and its bytes. */
struct Out {
  i64 page;
  u8[] bytes;
}

export struct Store {
  Disk disk;
  Node root;
  i32 height;
  u64 seq;
  i32 slot;
  /** The end of the file, in pages. */
  i64 pages;
  /** Pages this commit may write to: free since the last commit. */
  Vec<i64> free;
  /** Pages freed by this commit: the old copies of what it rewrote. */
  Vec<i64> freed;
  /** The pages the last commit's free list is on, which become free at the commit after it. */
  i64[] listPages;
  u8[] user;
  /** Leaves held in memory, oldest first, for evicting: the interior node holding each, and its index there. */
  Vec<Node> leafParents;
  Vec<u8[]> leafKeys;
  i32 maxLeaves;
  /** Leaves the commit under way has written, to queue for letting go once it is on the disk. */
  Vec<Node> writtenParents;
  Vec<u8[]> writtenKeys;
  /** Requests to the disk, for whoever is measuring. */
  i32 reads;
  /** Readers holding the committed state still (`hold`), and whether a commit is under way or waiting. */
  i32 readers;
  bool writing;
  i32 wantWrite;
  Vec<Ticket<bool>> waiting;
  /**
   * When set, every key looked up (`get`, `getNow`) and every key committed, in order, each led by `R` or
   * `W`: the stream a cache in front of the tree would see, for whoever is measuring one
   * (`tools/measure/cache.wac`).
   */
  Vec<u8[]>? trace;
  /** Entries read and committed, kept between blocks (`cache.wac`); `cacheMb` sets its budget. */
  EntryCache cache;

  /** The store in `disk`: the last commit, or an empty one for an empty file. */
  async Result<Store, string> open(Disk disk) {
    Store s = Store(disk, Node.fresh(true), 1, 0, 0, 2, Vec.create(), Vec.create(), i64[].filled(0, 0), u8[].filled(0, 0), Vec.create(), Vec.create(), LEAVES, Vec.create(), Vec.create(), 0, 0, false, 0, Vec.create(), null,
                    EntryCache.create(CACHE_MB * 1024 * 1024));
    i64 size = match (await disk.size()) {
      Ok(n): n,
      Err(e): return Result.Err(e),
    };
    if (size == 0) { return Result.Ok(s); }
    Meta? best = null;
    for (i32 slot = 0; slot < 2; slot++) {
      u8[] b = match (await disk.read((slot as i64) * (PAGE as i64), 8192)) {
        Ok(x): x,
        Err(e): return Result.Err(e),
      };
      Meta? m = readMeta(b, slot);
      if (m is not null && (best is null || m!.seq > best!.seq)) { best = m; }
    }
    if (best is null) {
      // A file whose first meta never reached the disk is an empty store, whatever else it holds.
      return Result.Ok(s);
    }
    Meta m = best!;
    s.seq = m.seq;
    s.slot = m.slot;
    s.height = m.height;
    s.pages = m.pages;
    s.user = m.user;
    s.listPages = m.listPages;
    // The free list, PAGE / 8 page numbers a page.
    i32 perPage = PAGE / 8;
    for (i32 p = 0; p < m.listPages.len(); p++) {
      u8[] fb = match (await disk.read(m.listPages[p] * (PAGE as i64), PAGE)) {
        Ok(x): x,
        Err(e): return Result.Err(e),
      };
      for (i32 i = 0; i < perPage && p * perPage + i < m.freeCount; i++) { s.free.push(get64(fb, i * 8)); }
    }
    // The root, and every interior node under it: a lookup should never wait for one.
    Node? r = await s.load(m.root);
    if (r is null) { return Result.Err("the root page \{m.root} does not decode"); }
    s.root = r!;
    string bad = await s.loadInterior(s.root, s.height);
    if (bad != "") { return Result.Err(bad); }
    return Result.Ok(s);
  }

  async Node? load(this, i64 page) {
    this.reads++;
    match (await this.disk.read(page * (PAGE as i64), PAGE)) {
      Ok(b): { return decode(b, page); }
      Err(e): { return null; }
    }
  }

  async string loadInterior(this, Node n, i32 level) {
    if (level <= 2 || n.leaf) { return ""; }
    for (i32 i = 0; i < n.kidPages.len(); i++) {
      Node? k = await this.load(n.kidPages.get(i));
      if (k is null || k!.leaf) { return "interior page \{n.kidPages.get(i)} does not decode"; }
      n.kids.set(i, k);
      string bad = await this.loadInterior(k!, level - 1);
      if (bad != "") { return bad; }
    }
    return "";
  }

  void traced(this, u8 kind, const u8[] key) {
    if (this.trace is null) { return; }
    u8[] t = u8[].filled(key.len() + 1, kind);
    t.copyFrom(key, 0, 1, key.len());
    this.trace!.push(t);
  }

  /** What the last commit recorded beside the tree. */
  Committed committed(this) { return Committed(this.seq, this.user); }

  Node? loadNow(this, i64 page) {
    this.reads++;
    match (this.disk.readNow(page * (PAGE as i64), PAGE)) {
      Ok(b): { return decode(b, page); }
      Err(e): { return null; }
    }
  }

  /** `get`, read where it is asked (`Disk.readNow`): for the synchronous EVM. */
  u8[]? getNow(this, const u8[] key) {
    this.traced(82, key);
    u8[] k0 = plain(key);
    Cached c = this.cache.get(k0);
    if (c.known) { return c.value; }
    Node n = this.root;
    while (!n.leaf) {
      i32 i = childFor(n.keys, key);
      Node? k = n.kids.get(i);
      if (k is null) {
        k = this.loadNow(n.kidPages.get(i));
        // A page that did not read is not an absent key: nothing is cached.
        if (k is null) { return null; }
        // Queued before it is attached: the queue may hold an older entry for this same place, and letting
        // that go after attaching would detach the leaf just read — whose changes a commit would then lose.
        this.held(n, n.keys.get(i));
        n.kids.set(i, k);
      }
      n = k!;
    }
    (i32 at, bool found) = find(n.keys, key);
    u8[]? v = found ? n.vals.get(at) : null;
    this.cache.put(k0, v);
    return v;
  }

  /** `range`, read where it is asked. */
  Vec<Change> rangeNow(this, u8[] from, u8[] to, i32 limit) {
    Vec<Change> out = Vec.create();
    this.walkNow(this.root, from, to, limit, out);
    return out;
  }

  void walkNow(this, Node n, u8[] from, u8[] to, i32 limit, Vec<Change> out) {
    if (n.leaf) {
      (i32 at, bool found) = find(n.keys, from);
      for (i32 i = at; i < n.keys.len() && out.len() < limit; i++) {
        if (to.len() > 0 && compareKeys(n.keys.get(i), to) >= 0) { return; }
        out.push(Change(n.keys.get(i), n.vals.get(i)));
      }
      return;
    }
    for (i32 i = childFor(n.keys, from); i < n.kids.len() && out.len() < limit; i++) {
      if (to.len() > 0 && compareKeys(n.keys.get(i), to) >= 0) { return; }
      Node? k = n.kids.get(i);
      if (k is null) {
        k = this.loadNow(n.kidPages.get(i));
        if (k is null) { return; }
        // Queued before it is attached: the queue may hold an older entry for this same place, and letting
        // that go after attaching would detach the leaf just read — whose changes a commit would then lose.
        this.held(n, n.keys.get(i));
        n.kids.set(i, k);
      }
      this.walkNow(k!, from, to, limit, out);
    }
  }

  /** The value at `key`, or null. One disk request at most: the leaf. */
  async u8[]? get(this, const u8[] key) {
    this.traced(82, key);
    u8[] k0 = plain(key);
    Cached c = this.cache.get(k0);
    if (c.known) { return c.value; }
    Node? leaf = await this.leafFor(key, null);
    if (leaf is null) { return null; }
    (i32 at, bool found) = find(leaf!.keys, key);
    u8[]? v = found ? leaf!.vals.get(at) : null;
    this.cache.put(k0, v);
    return v;
  }

  /** The leaf `key` belongs in, loaded if it was not; the nodes on the way are pushed onto `path`. */
  async Node? leafFor(this, const u8[] key, Vec<Node>? path) {
    Node n = this.root;
    while (!n.leaf) {
      if (path is not null) { path!.push(n); }
      i32 i = childFor(n.keys, key);
      Node? k = n.kids.get(i);
      if (k is null) {
        k = await this.load(n.kidPages.get(i));
        if (k is null) { return null; }
        // Queued before it is attached: the queue may hold an older entry for this same place, and letting
        // that go after attaching would detach the leaf just read — whose changes a commit would then lose.
        this.held(n, n.keys.get(i));
        n.kids.set(i, k);
      }
      n = k!;
    }
    return n;
  }

  /** A leaf just loaded under `parent`: remembered, and the oldest clean one dropped past the limit. */
  void held(this, Node parent, u8[] firstKey) {
    this.leafParents.push(parent);
    this.leafKeys.push(firstKey);
    while (this.leafParents.len() > this.maxLeaves) {
      Node p = this.leafParents.remove(0);
      u8[] k = this.leafKeys.remove(0);
      i32 i = childFor(p.keys, k);
      Node? leaf = p.kids.get(i);
      if (leaf is not null && leaf!.leaf && !leaf!.dirty && leaf!.page >= 0) { p.kids.set(i, null); }
    }
  }

  /**
   * Apply `changes` and commit them, with `user` recorded beside the tree. The changes need not be sorted
   * or unique (the last for a key wins). Returns "" once the commit is on the disk, or why it is not — in
   * which case the store in memory is no longer the one on disk, and should be opened again.
   */
  async string commit(this, Change[] changes, u8[] user) {
    this.wantWrite++;
    while (this.writing || this.readers > 0) { await this.parked(); }
    this.wantWrite--;
    this.writing = true;
    for (i32 i = 0; this.trace is not null && i < changes.len(); i++) { this.traced(87, changes[i].key); }
    string out = await this.commitNow(changes, user);
    // The cache is written through: what was committed is what the next read sees. After a failed commit
    // the tree in memory is not the store's, and neither is anything the cache was told.
    if (out == "") {
      for (i32 i = 0; i < changes.len(); i++) { this.cache.put(changes[i].key, changes[i].value); }
    } else {
      this.cache.clear();
    }
    this.writing = false;
    this.wake();
    return out;
  }

  /**
   * The committed state kept as it is until `release`: no commit starts meanwhile, and one waiting goes
   * before new holders, so a reader that awaits between reads (a snap answer: a range, then proofs) sees one
   * state throughout, and block import is not starved. A holder must not commit.
   */
  async void hold(this) {
    while (this.writing || this.wantWrite > 0) { await this.parked(); }
    this.readers++;
  }

  void release(this) {
    this.readers--;
    if (this.readers == 0) { this.wake(); }
  }

  /**
   * A new ticket to wait on until the gate changes. Made here, not declared in the waiting loop: a ticket
   * declared in a loop of an async function is one ticket for every pass (docs/wac-asks.md), and the second
   * pass would await the first's, already settled.
   */
  Ticket<bool> parked(this) {
    Ticket<bool> t;
    this.waiting.push(t);
    return t;
  }

  /** Everyone waiting for the gate to change: each looks again. */
  void wake(this) {
    Vec<Ticket<bool>> all = this.waiting;
    this.waiting = Vec.create();
    for (i32 i = 0; i < all.len(); i++) { all.get(i).resolve(true); }
  }

  async string commitNow(this, Change[] changes, u8[] user) {
    this.writtenParents = Vec.create();
    this.writtenKeys = Vec.create();
    if (user.len() > 3900) { return "the commit's own bytes are over 3900"; }
    // Into the tree in memory, marking every node on each changed path.
    for (i32 c = 0; c < changes.len(); c++) {
      Change ch = changes[c];
      if (ch.value is not null && ch.value!.len() > MAX_VALUE) { return "a value of \{ch.value!.len()} bytes is over the limit"; }
      if (ch.key.len() > 1024) { return "a key of \{ch.key.len()} bytes is over the limit"; }
      Vec<Node> path = Vec.create();
      Node? leaf = await this.leafFor(ch.key, path);
      if (leaf is null) { return "a page on the way to a key does not decode"; }
      Node l = leaf!;
      (i32 at, bool found) = find(l.keys, ch.key);
      if (ch.value is null) {
        if (!found) { continue; }
        l.bytes -= leafEntry(l.keys.get(at), l.vals.get(at));
        l.keys.remove(at);
        l.vals.remove(at);
      } else if (found) {
        l.bytes += ch.value!.len() - l.vals.get(at).len();
        l.vals.set(at, ch.value!);
      } else {
        l.keys.insert(at, ch.key);
        l.vals.insert(at, ch.value!);
        l.bytes += leafEntry(ch.key, ch.value!);
      }
      l.dirty = true;
      for (i32 p = 0; p < path.len(); p++) {
        Node on = path.get(p);
        on.dirty = true;
      }
    }

    // Splits, merges of the empty, a new root or a shorter tree.
    Node[] top = this.fix(this.root);
    while (top.len() > 1) {
      Node r = Node.fresh(false);
      for (i32 i = 0; i < top.len(); i++) { adopt(r, r.keys.len(), top[i]); }
      this.height++;
      top = this.fix(r);
    }
    this.root = top.len() == 1 ? top[0] : Node.fresh(true);
    if (top.len() == 0) { this.height = 1; }
    while (!this.root.leaf && this.root.kids.len() == 1 && this.root.kids.get(0) is not null) {
      if (this.root.page >= 0) { this.freed.push(this.root.page); }
      this.root = this.root.kids.get(0)!;
      this.height--;
    }

    // Every dirty node to a page of its own, children before parents.
    Vec<Out> outs = Vec.create();
    i64 rootPage = this.place(this.root, outs);
    // The free list for the next commit: what this one did not use, what it freed, and the old list's pages.
    // Its own pages come from what is free now, like any other page; counted before taking them, which
    // can only overcount by a page.
    i32 perPage = PAGE / 8;
    i32 listCount = (this.free.len() + this.freed.len() + this.listPages.len() + perPage - 1) / perPage;
    i64[] lists = i64[].filled(listCount, 0);
    for (i32 p = 0; p < listCount; p++) { lists[p] = this.free.len() > 0 ? this.free.pop()! : this.grow(); }
    Vec<i64> nextFree = Vec.create();
    for (i32 i = 0; i < this.free.len(); i++) { nextFree.push(this.free.get(i)); }
    for (i32 i = 0; i < this.freed.len(); i++) { nextFree.push(this.freed.get(i)); }
    for (i32 i = 0; i < this.listPages.len(); i++) { nextFree.push(this.listPages[i]); }
    if (listCount > 400) { return "a free list of \{listCount} pages is more than the meta can name"; }
    for (i32 p = 0; p < listCount; p++) {
      u8[] b = u8[].filled(PAGE, 0);
      for (i32 i = 0; i < perPage && p * perPage + i < nextFree.len(); i++) { put64(b, i * 8, nextFree.get(p * perPage + i)); }
      outs.push(Out(lists[p], b));
    }
    string bad = await this.writeAll(outs);
    if (bad != "") { return bad; }
    match (await this.disk.sync()) {
      Ok(v): {}
      Err(e): { return e; }
    }

    u64 seq = this.seq + 1;
    i32 slot = 1 - this.slot;
    u8[] meta = writeMeta(Meta(seq, slot, rootPage, this.height, this.pages, lists, nextFree.len(), user));
    match (await this.disk.write((slot as i64) * (PAGE as i64), meta)) {
      Ok(v): {}
      Err(e): { return e; }
    }
    match (await this.disk.sync()) {
      Ok(v): {}
      Err(e): { return e; }
    }
    this.seq = seq;
    this.slot = slot;
    this.user = user;
    this.free = nextFree;
    this.freed = Vec.create();
    this.listPages = lists;
    for (i32 i = 0; i < this.writtenParents.len(); i++) { this.held(this.writtenParents.get(i), this.writtenKeys.get(i)); }
    this.writtenParents = Vec.create();
    this.writtenKeys = Vec.create();
    return "";
  }

  /**
   * `n` made to fit: a dirty child replaced by what it became, an entry for each first key, and `n` itself
   * split if it is over a page. What `n` became: none if it is empty, else one or more nodes.
   */
  Node[] fix(this, Node n) {
    if (!n.dirty) { return [n]; }
    if (!n.leaf) {
      i32 i = 0;
      while (i < n.kids.len()) {
        Node? k = n.kids.get(i);
        if (k is null || !k!.dirty) {
          i++;
          continue;
        }
        Node[] parts = this.fix(k!);
        n.bytes -= interiorEntry(n.keys.get(i));
        n.keys.remove(i);
        n.kids.remove(i);
        n.kidPages.remove(i);
        for (i32 p = 0; p < parts.len(); p++) { adopt(n, i + p, parts[p]); }
        i += parts.len();
      }
    }
    if (n.keys.len() == 0) {
      if (n.page >= 0) { this.freed.push(n.page); }
      return [];
    }
    if (n.bytes <= PAGE) { return [n]; }
    // Halves by bytes, each fixed again in case one is still over.
    i32 half = 0;
    i32 acc = 5;
    while (half < n.keys.len() - 1 && acc < n.bytes / 2) {
      acc += n.leaf ? leafEntry(n.keys.get(half), n.vals.get(half)) : interiorEntry(n.keys.get(half));
      half++;
    }
    if (half == 0) { half = 1; }
    Node right = Node.fresh(n.leaf);
    while (n.keys.len() > half) {
      u8[] k = n.keys.remove(half);
      right.keys.push(k);
      if (n.leaf) {
        u8[] v = n.vals.remove(half);
        right.vals.push(v);
        i32 sz = leafEntry(k, v);
        n.bytes -= sz;
        right.bytes += sz;
      } else {
        right.kids.push(n.kids.remove(half));
        right.kidPages.push(n.kidPages.remove(half));
        n.bytes -= interiorEntry(k);
        right.bytes += interiorEntry(k);
      }
    }
    Node[] a = this.fix(n);
    Node[] b = this.fix(right);
    Node[] out = Node[].filled(a.len() + b.len(), n);
    for (i32 i = 0; i < a.len(); i++) { out[i] = a[i]; }
    for (i32 i = 0; i < b.len(); i++) { out[a.len() + i] = b[i]; }
    return out;
  }

  /** `n` and its dirty descendants given pages, their bytes queued; `n`'s page. */
  i64 place(this, Node n, Vec<Out> outs) {
    if (!n.dirty && n.page >= 0) { return n.page; }
    if (!n.leaf) {
      for (i32 i = 0; i < n.kids.len(); i++) {
        Node? k = n.kids.get(i);
        if (k is null) { continue; }
        bool written = k!.dirty || k!.page < 0;
        n.kidPages.set(i, this.place(k!, outs));
        // A leaf written is in memory like one read, and is let go the same way: noted here, under the parent
        // it ended in, and queued once the commit is on the disk (let go before, it would be read back from a
        // page not yet written). Without this every leaf a commit touched stayed in memory for good — one
        // read was queued once, skipped if dirty when its turn came, and one a split made was never queued.
        if (written && k!.leaf) {
          this.writtenParents.push(n);
          this.writtenKeys.push(n.keys.get(i));
        }
      }
    }
    if (n.page >= 0) { this.freed.push(n.page); }
    i64 page = this.free.len() > 0 ? this.free.pop()! : this.grow();
    n.page = page;
    n.dirty = false;
    outs.push(Out(page, encode(n)));
    return page;
  }

  i64 grow(this) {
    i64 p = this.pages;
    this.pages++;
    return p;
  }

  /** The pages, sorted, with runs of neighbours written in one request each (up to 64 pages). */
  async string writeAll(this, Vec<Out> outs) {
    outs.sort((Out a, Out b) => a.page < b.page ? -1 : a.page > b.page ? 1 : 0);
    i32 i = 0;
    while (i < outs.len()) {
      i32 j = i + 1;
      while (j < outs.len() && j - i < 64 && outs.get(j).page == outs.get(j - 1).page + 1) { j++; }
      u8[] run = u8[].filled((j - i) * PAGE, 0);
      for (i32 k = i; k < j; k++) { run.copyFrom(outs.get(k).bytes, 0, (k - i) * PAGE, PAGE); }
      match (await this.disk.write(outs.get(i).page * (PAGE as i64), run)) {
        Ok(v): {}
        Err(e): { return e; }
      }
      i = j;
    }
    return "";
  }

  /** Every key and value from `from` (inclusive) to `to` (exclusive; empty for the end), in order. */
  async Vec<Change> range(this, u8[] from, u8[] to, i32 limit) {
    Vec<Change> out = Vec.create();
    await this.walk(this.root, from, to, limit, out);
    return out;
  }

  async void walk(this, Node n, u8[] from, u8[] to, i32 limit, Vec<Change> out) {
    if (n.leaf) {
      (i32 at, bool found) = find(n.keys, from);
      for (i32 i = at; i < n.keys.len() && out.len() < limit; i++) {
        if (to.len() > 0 && compareKeys(n.keys.get(i), to) >= 0) { return; }
        out.push(Change(n.keys.get(i), n.vals.get(i)));
      }
      return;
    }
    for (i32 i = childFor(n.keys, from); i < n.kids.len() && out.len() < limit; i++) {
      if (to.len() > 0 && compareKeys(n.keys.get(i), to) >= 0) { return; }
      Node? k = n.kids.get(i);
      if (k is null) {
        k = await this.load(n.kidPages.get(i));
        if (k is null) { return; }
        // Queued before it is attached: the queue may hold an older entry for this same place, and letting
        // that go after attaching would detach the leaf just read — whose changes a commit would then lose.
        this.held(n, n.keys.get(i));
        n.kids.set(i, k);
      }
      await this.walk(k!, from, to, limit, out);
    }
  }
}

/** A child `k` put at `i` of interior `n`, keyed by its first key. */
void adopt(Node n, i32 i, Node k) {
  u8[] first = k.keys.get(0);
  n.keys.insert(i, first);
  n.kids.insert(i, k);
  n.kidPages.insert(i, k.page);
  n.bytes += interiorEntry(first);
  n.dirty = true;
}

struct Meta {
  u64 seq;
  i32 slot;
  i64 root;
  i32 height;
  i64 pages;
  i64[] listPages;
  i32 freeCount;
  u8[] user;
}

u8[] writeMeta(Meta m) {
  u8[] b = u8[].filled(PAGE, 0);
  put64(b, 0, MAGIC as@ i64);
  put64(b, 8, m.seq as@ i64);
  put64(b, 16, m.root);
  put32(b, 24, m.height);
  put64(b, 28, m.pages);
  put32(b, 36, m.freeCount);
  put32(b, 40, m.listPages.len());
  i32 at = 44;
  for (i32 i = 0; i < m.listPages.len(); i++) { put64(b, at + 8 * i, m.listPages[i]); }
  at += 8 * m.listPages.len();
  put32(b, at, m.user.len());
  b.copyFrom(m.user, 0, at + 4, m.user.len());
  i32 end = at + 4 + m.user.len();
  u8[] sum = keccak256(slice(b, 0, end));
  b.copyFrom(sum, 0, end, 32);
  return slice(b, 0, end + 32);
}

Meta? readMeta(u8[] b, i32 slot) {
  if (b.len() < 80 || get64(b, 0) != (MAGIC as@ i64)) { return null; }
  i32 lists = get32(b, 40);
  if (lists < 0 || 44 + 8 * lists + 4 > b.len()) { return null; }
  i64[] listPages = i64[].filled(lists, 0);
  for (i32 i = 0; i < lists; i++) { listPages[i] = get64(b, 44 + 8 * i); }
  i32 at = 44 + 8 * lists;
  i32 userLen = get32(b, at);
  if (userLen < 0 || at + 4 + userLen + 32 > b.len()) { return null; }
  i32 end = at + 4 + userLen;
  u8[] sum = keccak256(slice(b, 0, end));
  for (i32 i = 0; i < 32; i++) {
    if (sum[i] != b[end + i]) { return null; }
  }
  return Meta(get64(b, 8) as@ u64, slot, get64(b, 16), get32(b, 24), get64(b, 28), listPages, get32(b, 36), slice(b, at + 4, userLen));
}
