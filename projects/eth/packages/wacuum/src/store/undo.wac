// What a block changed, kept in the store beside its state: the change set the engine moves the store across a
// reorg with. In memory alone, a restart had none for the blocks at or below the store's, and the store could not
// go back from its block: after any restart a one-block reorg was SYNCING for good (docs/state-on-disk.md, "Crash
// windows"). Written in the block's own commit (`Engine.withBlock`), so a store holding a block's state holds its
// undo record too; read back as a restart adopts the block; deleted once the block is finalized.
//
//     undo   0x09 ‖ number (8 bytes) ‖ block hash ‖ u16 chunk   the change set, 12 KB a chunk (CHUNK)
//
// By number first, so that what finality makes unneeded is one range. A change set is its four maps: accounts
// before and after (exists, nonce, balance, code hash — no code: undoing a block needs only the hash, and codes
// stay in the store), and slots before and after.

import { Map, Vec } from "core";
import { rlp.Item, rlp.encode, rlp.decode, rlp.itemsOf, rlp.bytesOf, rlp.isList } from "@/lib.wac";
import { U256 } from "../u256.wac";
import { AccountState, ChangeSet, hashU256, eqU256 } from "../state/world.wac";
import { u256Bytes } from "../state/root.wac";
import { Change } from "./tree.wac";
import { chunked } from "./receipts.wac";

export u8[] undoKey(u64 number, U256 hash) {
  u8[] out = u8[].filled(41, 9);
  for (i32 i = 0; i < 8; i++) { out[1 + i] = ((number >> ((56 - 8 * i) as! u64)) & 255) as! u8; }
  out.copyFrom(hash.toBytes(), 0, 9, 32);
  return out;
}

/** The first key of the undo records of blocks numbered `number` and above. */
export u8[] undoFrom(u64 number) {
  u8[] out = u8[].filled(9, 9);
  for (i32 i = 0; i < 8; i++) { out[1 + i] = ((number >> ((56 - 8 * i) as! u64)) & 255) as! u8; }
  return out;
}

export Change[] undoChanges(u64 number, U256 hash, ChangeSet cs) { return chunked(undoKey(number, hash), encodeChangeSet(cs)); }

Item num(U256 v) { return Item.Bytes(u256Bytes(v)); }
U256 numOf(Item it) { return U256.fromBytes(bytesOf(it), 0, bytesOf(it).len()); }

Item accounts(Map<U256, AccountState> m) {
  U256[] keys = m.keys();
  Item[] out = Item[].filled(keys.len(), Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < keys.len(); i++) {
    AccountState a = m.get(keys[i])!;
    out[i] = Item.List([num(keys[i]), Item.Bytes(a.exists ? [1 as u8] : u8[].filled(0, 0)), num(U256.ofU64(a.nonce)), num(a.balance), num(a.codeHash)]);
  }
  return Item.List(out);
}

Item slots(Map<U256, Map<U256, U256>> m) {
  U256[] keys = m.keys();
  Item[] out = Item[].filled(keys.len(), Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < keys.len(); i++) {
    Map<U256, U256> s = m.get(keys[i])!;
    U256[] ks = s.keys();
    Item[] pairs = Item[].filled(ks.len(), Item.Bytes(u8[].filled(0, 0)));
    for (i32 k = 0; k < ks.len(); k++) { pairs[k] = Item.List([num(ks[k]), num(s.get(ks[k])!)]); }
    out[i] = Item.List([num(keys[i]), Item.List(pairs)]);
  }
  return Item.List(out);
}

export u8[] encodeChangeSet(ChangeSet cs) {
  return encode(Item.List([accounts(cs.before), accounts(cs.after), slots(cs.slotsBefore), slots(cs.slotsAfter)]));
}

bool accountsInto(Item it, Map<U256, AccountState> m) {
  if (!isList(it)) { return false; }
  Item[] all = itemsOf(it);
  for (i32 i = 0; i < all.len(); i++) {
    if (!isList(all[i]) || itemsOf(all[i]).len() != 5) { return false; }
    Item[] f = itemsOf(all[i]);
    m.set(numOf(f[0]), AccountState(bytesOf(f[1]).len() > 0, numOf(f[2]).low(), numOf(f[3]), u8[].filled(0, 0), numOf(f[4])));
  }
  return true;
}

bool slotsInto(Item it, Map<U256, Map<U256, U256>> m) {
  if (!isList(it)) { return false; }
  Item[] all = itemsOf(it);
  for (i32 i = 0; i < all.len(); i++) {
    if (!isList(all[i]) || itemsOf(all[i]).len() != 2 || !isList(itemsOf(all[i])[1])) { return false; }
    Item[] f = itemsOf(all[i]);
    Map<U256, U256> s = Map.create(hashU256, eqU256);
    Item[] pairs = itemsOf(f[1]);
    for (i32 k = 0; k < pairs.len(); k++) {
      if (!isList(pairs[k]) || itemsOf(pairs[k]).len() != 2) { return false; }
      s.set(numOf(itemsOf(pairs[k])[0]), numOf(itemsOf(pairs[k])[1]));
    }
    m.set(numOf(f[0]), s);
  }
  return true;
}

/** The change set an undo record holds, or null if it does not decode. */
export ChangeSet? decodeChangeSet(u8[] b) {
  auto d = decode(b);
  if (!d.ok || !isList(d.item) || itemsOf(d.item).len() != 4) { return null; }
  Item[] f = itemsOf(d.item);
  ChangeSet cs = ChangeSet.create();
  if (!accountsInto(f[0], cs.before) || !accountsInto(f[1], cs.after) || !slotsInto(f[2], cs.slotsBefore) || !slotsInto(f[3], cs.slotsAfter)) { return null; }
  return cs;
}
