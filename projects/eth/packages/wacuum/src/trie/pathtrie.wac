// A Merkle-Patricia trie kept in the store, by path: each node whose encoding is 32 bytes or more is an
// entry under its path from the root, and only the nodes a change walks through are read into memory. The
// rest are stubs that know their hash. This is the state root of `docs/state-on-disk.md`: a block's changes
// are put and deleted here, which reads the nodes on their paths, and the root is rehashed from what
// changed.
//
//     account trie   0x03 ‖ nibbles of the path, one a byte
//     storage trie   0x04 ‖ keccak(address) ‖ nibbles of the path
//
// One entry a path means a node replaced is a node overwritten, and nothing accumulates: a node that moves
// (a leaf pushed down under a new branch), shrinks into its parent's encoding, or goes, leaves its old path
// to be deleted at the next commit unless something else is written there. That is geth's path scheme, and
// it is also what snap's healing asks for: GetTrieNodes names nodes by path.
//
// The operations are asynchronous because a stub met on the way has to be read; everything else is
// `live.wac`'s algorithm. Keys are 32 bytes (hashes), so no value sits in a branch.

import { keccak256 } from "../crypto/keccak.wac";
import { rlp.Item, rlp.encode, rlp.decode, rlp.itemsOf, rlp.bytesOf, rlp.isList } from "@/lib.wac";
import { emptyRoot, hexPrefixOf } from "./trie.wac";
import { Map, Vec } from "core";
import { hashString, stringEq } from "core";
import { Store, Change } from "../store/tree.wac";

static i32 LEAF = 0;
static i32 EXT = 1;
static i32 BRANCH = 2;
/** A node not read yet: `ref` is its hash, and its path says where to read it. */
static i32 STUB = 3;

struct PNode {
  i32 kind;
  u8[] path;
  u8[] value;
  PNode?[] kids;
  PNode? next;
  /** How a parent refers to it, once computed or read; null once it changed. */
  Item? ref;
  /** The path it is stored under, or null for one not stored (new, or inside its parent's encoding). */
  u8[]? at;
  /** Changed since it was read, or never stored. */
  bool dirty;
}

PNode leafNode(u8[] path, u8[] value) { return PNode(LEAF, path, value, PNode?[].defaulted(0), null, null, null, true); }
PNode extNode(u8[] path, PNode next) { return PNode(EXT, path, u8[].filled(0, 0), PNode?[].defaulted(0), next, null, null, true); }
PNode branchNode() { return PNode(BRANCH, u8[].filled(0, 0), u8[].filled(0, 0), PNode?[].defaulted(16), null, null, null, true); }
PNode stub(Item ref, u8[] at) { return PNode(STUB, u8[].filled(0, 0), u8[].filled(0, 0), PNode?[].defaulted(0), null, ref, at, false); }

u8[] cut(u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  out.copyFrom(b, from, 0, to - from);
  return out;
}

u8[] join(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  out.copyFrom(a, 0, 0, a.len());
  out.copyFrom(b, 0, a.len(), b.len());
  return out;
}

i32 common(u8[] path, u8[] key, i32 at) {
  i32 n = 0;
  while (n < path.len() && at + n < key.len() && path[n] == key[at + n]) { n++; }
  return n;
}

export u8[] nibblesOf(u8[] key) {
  u8[] n = u8[].filled(key.len() * 2, 0);
  for (i32 i = 0; i < key.len(); i++) {
    n[2 * i] = key[i] >> 4;
    n[2 * i + 1] = key[i] & 15;
  }
  return n;
}

/** Hex-prefix decoded: the nibbles, and whether it marks a leaf. */
(u8[], bool) fromHexPrefix(u8[] b) {
  if (b.len() == 0) { return (u8[].filled(0, 0), false); }
  u8 flag = b[0] >> 4;
  bool odd = (flag & 1) == 1;
  u8[] n = u8[].filled(b.len() * 2 - (odd ? 1 : 2), 0);
  i32 at = 0;
  if (odd) {
    n[0] = b[0] & 15;
    at = 1;
  }
  for (i32 i = 1; i < b.len(); i++) {
    n[at] = b[i] >> 4;
    n[at + 1] = b[i] & 15;
    at += 2;
  }
  return (n, flag >= 2);
}

/** A node from its RLP, whose children are stubs (or decoded in place, when inside this encoding). */
PNode? nodeOf(Item it, u8[] at) {
  if (!isList(it)) { return null; }
  Item[] f = itemsOf(it);
  if (f.len() == 17) {
    PNode b = branchNode();
    for (i32 i = 0; i < 16; i++) { b.kids[i] = childOf(f[i], join(at, [i as@ u8])); }
    return b;
  }
  if (f.len() != 2) { return null; }
  (u8[] path, bool isLeaf) = fromHexPrefix(bytesOf(f[0]));
  if (isLeaf) { return leafNode(path, bytesOf(f[1])); }
  PNode? next = childOf(f[1], join(at, path));
  return next is null ? null : extNode(path, next!);
}

/** A child reference: empty is none, a 32-byte string is a stored node's hash, a list is the node itself. */
PNode? childOf(Item ref, u8[] at) {
  if (isList(ref)) { return nodeOf(ref, at); }
  u8[] b = bytesOf(ref);
  if (b.len() == 0) { return null; }
  return stub(ref, at);
}

Item itemOf(PNode n) {
  if (n.kind == LEAF) { return Item.List([Item.Bytes(hexPrefixOf(n.path, true)), Item.Bytes(n.value)]); }
  if (n.kind == EXT) { return Item.List([Item.Bytes(hexPrefixOf(n.path, false)), refOf(n.next!)]); }
  Item[] b = Item[].filled(17, Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < 16; i++) {
    if (n.kids[i] is not null) { b[i] = refOf(n.kids[i]!); }
  }
  return Item.List(b);
}

Item refOf(PNode n) {
  if (n.ref is not null) { return n.ref!; }
  Item it = itemOf(n);
  u8[] enc = encode(it);
  Item r = enc.len() < 32 ? it : Item.Bytes(keccak256(enc));
  n.ref = r;
  return r;
}

export struct PathTrie {
  Store store;
  /** The prefix of every node key: 0x03, or 0x04 and the owner's hash. */
  u8[] prefix;
  PNode? root;
  /** Paths whose stored node went away, to delete unless written again. */
  Vec<u8[]> stale;
  /** Reads, for whoever is measuring. */
  i32 reads;
  string error;

  /** The account trie, or with `owner` (keccak of an address) that account's storage trie. */
  PathTrie of(Store store, u8[] owner) {
    u8[] prefix = owner.len() == 0 ? [3] : join([4], owner);
    return PathTrie(store, prefix, null, Vec.create(), 0, "");
  }

  u8[] keyOf(this, u8[] path) { return join(this.prefix, path); }

  /** The trie as the store has it: its root, as a stub, when there is one. */
  async void open(this) {
    u8[]? enc = await this.store.get(this.keyOf(u8[].filled(0, 0)));
    this.reads++;
    if (enc is null) {
      this.root = null;
      return;
    }
    PNode? r = nodeOf(decode(enc!).item, u8[].filled(0, 0));
    if (r is null) {
      this.error = "the root node does not decode";
      return;
    }
    r!.at = u8[].filled(0, 0);
    r!.dirty = false;
    this.root = r;
  }

  /** A stub read in; anything else as it is. */
  async PNode resolve(this, PNode n) {
    if (n.kind != STUB) { return n; }
    u8[]? enc = await this.store.get(this.keyOf(n.at!));
    this.reads++;
    if (enc is null) {
      this.error = "no node at path \{n.at!.len()} nibbles deep";
      return n;
    }
    if (bytesOf(n.ref!).len() == 32 && !same(keccak256(enc!), bytesOf(n.ref!))) {
      this.error = "the node at a path does not hash to its parent's reference";
      return n;
    }
    PNode? r = nodeOf(decode(enc!).item, n.at!);
    if (r is null) {
      this.error = "a stored node does not decode";
      return n;
    }
    r!.ref = n.ref;
    r!.at = n.at;
    r!.dirty = false;
    return r!;
  }

  /** A node no longer where it was stored: its path goes, unless written again. */
  void gone(this, PNode n) {
    if (n.at is not null) { this.stale.push(n.at!); }
  }

  async void set(this, u8[] key, u8[] value) { this.root = await this.put(this.root, nibblesOf(key), 0, value); }

  async void delete(this, u8[] key) { this.root = (await this.remove(this.root, nibblesOf(key), 0)).node; }

  async PNode put(this, PNode? node, u8[] key, i32 at, u8[] value) {
    if (node is null) { return leafNode(cut(key, at, key.len()), value); }
    PNode n = await this.resolve(node!);
    n.ref = null;
    n.dirty = true;
    if (n.kind == BRANCH) {
      i32 nib = key[at] as i32;
      n.kids[nib] = await this.put(n.kids[nib], key, at + 1, value);
      return n;
    }
    i32 cp = common(n.path, key, at);
    if (n.kind == LEAF && cp == n.path.len()) {
      n.value = value;
      return n;
    }
    if (n.kind == EXT && cp == n.path.len()) {
      n.next = await this.put(n.next, key, at + cp, value);
      return n;
    }
    // They part after `cp` nibbles: a branch there, holding what this node was and the new leaf. The node
    // itself is replaced, so its stored path is stale unless the new one is written there.
    this.gone(n);
    PNode b = branchNode();
    i32 mine = n.path[cp] as i32;
    if (n.kind == LEAF) {
      b.kids[mine] = leafNode(cut(n.path, cp + 1, n.path.len()), n.value);
    } else {
      b.kids[mine] = cp + 1 == n.path.len() ? n.next! : extNode(cut(n.path, cp + 1, n.path.len()), n.next!);
    }
    i32 theirs = key[at + cp] as i32;
    b.kids[theirs] = leafNode(cut(key, at + cp + 1, key.len()), value);
    return cp == 0 ? b : extNode(cut(n.path, 0, cp), b);
  }

  /** `prefix` in front of `n` (read in if a stub): a leaf or extension absorbs it, a branch gets an extension. */
  async PNode prefixed(this, u8[] prefix, PNode node, u8[] nodeAt) {
    PNode n = await this.resolve(node);
    if (n.kind == BRANCH) { return extNode(prefix, n); }
    this.gone(n);
    if (n.kind == LEAF) { return leafNode(join(prefix, n.path), n.value); }
    return extNode(join(prefix, n.path), n.next!);
  }

  async Gone remove(this, PNode? node, u8[] key, i32 at) {
    if (node is null) { return Gone(null, false); }
    PNode n = await this.resolve(node!);
    if (n.kind == LEAF) {
      if (n.path.len() != key.len() - at || common(n.path, key, at) != n.path.len()) { return Gone(n, false); }
      this.gone(n);
      return Gone(null, true);
    }
    if (n.kind == EXT) {
      if (common(n.path, key, at) != n.path.len()) { return Gone(n, false); }
      Gone r = await this.remove(n.next, key, at + n.path.len());
      if (!r.changed) { return Gone(n, false); }
      this.gone(n);
      if (r.node is null) { return Gone(null, true); }
      return Gone(await this.prefixed(n.path, r.node!, cut(key, 0, at + n.path.len())), true);
    }
    i32 nib = key[at] as i32;
    Gone r = await this.remove(n.kids[nib], key, at + 1);
    if (!r.changed) { return Gone(n, false); }
    n.ref = null;
    n.dirty = true;
    n.kids[nib] = r.node;
    i32 count = 0;
    i32 only = -1;
    for (i32 i = 0; i < 16; i++) {
      if (n.kids[i] is not null) {
        count++;
        only = i;
      }
    }
    if (count == 0) {
      this.gone(n);
      return Gone(null, true);
    }
    if (count == 1) {
      this.gone(n);
      return Gone(await this.prefixed([only as@ u8], n.kids[only]!, join(cut(key, 0, at), [only as@ u8])), true);
    }
    return Gone(n, true);
  }

  /**
   * The nodes on the path to `key`, root first, as their encodings — what a proof of it or of its absence
   * is (`LiveTrie.prove`'s, from the store): a node under 32 bytes is inside its parent's, not an entry.
   */
  async u8[][] prove(this, u8[] key) {
    Vec<u8[]> out = Vec.create();
    if (this.root is null) { return out.toArray(); }
    u8[] k = nibblesOf(key);
    PNode cur = await this.resolve(this.root!);
    if (cur.kind == STUB) { return out.toArray(); }
    out.push(encode(itemOf(cur)));
    i32 at = 0;
    while (true) {
      PNode? next = null;
      if (cur.kind == EXT && common(cur.path, k, at) == cur.path.len()) {
        at += cur.path.len();
        next = cur.next;
      } else if (cur.kind == BRANCH && at < k.len()) {
        next = cur.kids[k[at] as i32];
        at++;
      }
      if (next is null) { break; }
      PNode n = await this.resolve(next!);
      if (n.kind == STUB) { break; }
      u8[] enc = encode(itemOf(n));
      if (enc.len() >= 32) { out.push(enc); }
      cur = n;
    }
    return out.toArray();
  }

  /** How many nodes the trie stores, every one read in: for tests, which compare it with the store's entries. */
  async i32 storedNodes(this) {
    if (this.root is null) { return 0; }
    return await this.countUnder(this.root!, true);
  }

  async i32 countUnder(this, PNode node, bool isRoot) {
    PNode n = await this.resolve(node);
    i32 c = isRoot || encode(itemOf(n)).len() >= 32 ? 1 : 0;
    if (n.kind == BRANCH) {
      for (i32 i = 0; i < 16; i++) {
        if (n.kids[i] is not null) { c += await this.countUnder(n.kids[i]!, false); }
      }
    } else if (n.kind == EXT) {
      c += await this.countUnder(n.next!, false);
    }
    return c;
  }

  /** The root hash. */
  u8[] hash(this) {
    if (this.root is null) { return emptyRoot(); }
    return keccak256(encode(itemOf(this.root!)));
  }

  /**
   * What to write so the store holds this trie: every changed node of 32 bytes or more (and the root,
   * whatever its size) at its path, and a delete for every path whose node went away and was not written
   * again. The nodes are then the store's: their paths are remembered, and the stale list starts over.
   */
  Change[] changes(this) {
    Vec<Change> out = Vec.create();
    Map<string, bool> written = Map.create(hashString, stringEq);
    if (this.root is not null) {
      this.hash();
      this.collect(this.root!, u8[].filled(0, 0), true, out, written);
    }
    for (i32 i = 0; i < this.stale.len(); i++) {
      u8[] p = this.stale.get(i);
      string k = hexOf(p);
      if (written.has(k)) { continue; }
      written.set(k, true);
      out.push(Change(this.keyOf(p), null));
    }
    this.stale = Vec.create();
    return out.toArray();
  }

  /** Changed nodes under `n` (at `path`) into `out`; a stored node that moved or shrank leaves its path stale. */
  void collect(this, PNode n, u8[] path, bool isRoot, Vec<Change> out, Map<string, bool> written) {
    if (n.kind == STUB) { return; }
    bool changed = n.at is null || !same(n.at!, path);
    // Everything under a changed node is re-collected: the cached refs say which are unchanged.
    if (n.kind == BRANCH) {
      for (i32 i = 0; i < 16; i++) {
        if (n.kids[i] is not null) { this.collect(n.kids[i]!, join(path, [i as@ u8]), false, out, written); }
      }
    } else if (n.kind == EXT) {
      this.collect(n.next!, join(path, n.path), false, out, written);
    }
    u8[] enc = encode(itemOf(n));
    bool stored = isRoot || enc.len() >= 32;
    if (n.at is not null && (!stored || !same(n.at!, path))) { this.stale.push(n.at!); }
    if (!stored) {
      n.at = null;
      return;
    }
    if (changed || n.dirty) {
      out.push(Change(this.keyOf(path), enc));
      written.set(hexOf(path), true);
    }
    n.at = path;
    n.dirty = false;
  }
}

/** What a removal left: the node in its place, and whether anything under it changed. */
struct Gone {
  PNode? node;
  bool changed;
}

bool same(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

string hexOf(u8[] p) {
  u8[] d = "0123456789abcdef".toBytes();
  u8[] out = u8[].filled(p.len(), 0);
  for (i32 i = 0; i < p.len(); i++) { out[i] = d[(p[i] & 15) as i32]; }
  return string.fromBytes(out);
}
