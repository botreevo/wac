// A trie built from keys that arrive in ascending order, emitting each node by path as soon as nothing
// later can change it: what snap sync needs to turn a downloaded state — sorted, as the store iterates it —
// into the tries `pathtrie.wac` keeps, without holding more than the path to the latest key in memory.
//
// Keys are 32 bytes (hashes). A node is emitted (its path, its RLP) once it is sealed: a branch's child is
// sealed when a key arrives under a higher nibble of that branch, since keys only grow; and whatever is left
// is sealed by `finish`. As in the path scheme, a node under 32 bytes sits inside its parent's encoding and
// is not emitted on its own; the root always is.

import { keccak256 } from "../crypto/keccak.wac";
import { rlp.Item, rlp.encode, rlp.bytesOf } from "@/lib.wac";
import { emptyRoot, hexPrefixOf } from "./trie.wac";
import { nibblesOf } from "./pathtrie.wac";

static i32 LEAF = 0;
static i32 EXT = 1;
static i32 BRANCH = 2;
/** Sealed: only its reference is kept. */
static i32 SEALED = 3;

struct SNode {
  i32 kind;
  u8[] path;
  u8[] value;
  SNode?[] kids;
  SNode? next;
  /** A sealed node's reference: its hash, or itself when under 32 bytes. */
  Item? ref;
}

SNode sleaf(u8[] path, u8[] value) { return SNode(LEAF, path, value, SNode?[].defaulted(0), null, null); }
SNode sext(u8[] path, SNode next) { return SNode(EXT, path, u8[].filled(0, 0), SNode?[].defaulted(0), next, null); }
SNode sbranch() { return SNode(BRANCH, u8[].filled(0, 0), u8[].filled(0, 0), SNode?[].defaulted(16), null, null); }

u8[] part(u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  out.copyFrom(b, from, 0, to - from);
  return out;
}

u8[] joined(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  out.copyFrom(a, 0, 0, a.len());
  out.copyFrom(b, 0, a.len(), b.len());
  return out;
}

export struct StackTrie {
  SNode? root;
  /** Where each emitted node goes: its path from the root, and its encoding. */
  fn<void(u8[], u8[])> emit;
  u8[] last;
  i32 count;
  string error;

  StackTrie create(fn<void(u8[], u8[])> emit) { return StackTrie(null, emit, u8[].filled(0, 0), 0, ""); }

  /** The next key, which must sort after every one before it, and its value (not empty). */
  void add(this, u8[] key, u8[] value) {
    if (this.count > 0 && !after(key, this.last)) {
      this.error = "keys out of order";
      return;
    }
    this.last = key;
    this.count++;
    this.root = this.put(this.root, nibblesOf(key), 0, value);
  }

  SNode put(this, SNode? node, u8[] key, i32 at, u8[] value) {
    if (node is null) { return sleaf(part(key, at, key.len()), value); }
    SNode n = node!;
    if (n.kind == BRANCH) {
      i32 nib = key[at] as i32;
      // Everything under a lower nibble is finished: no later key goes there.
      for (i32 i = 0; i < nib; i++) {
        if (n.kids[i] is not null && n.kids[i]!.kind != SEALED) { n.kids[i] = this.seal(n.kids[i]!, joined(part(key, 0, at), [i as@ u8]), false); }
      }
      n.kids[nib] = this.put(n.kids[nib], key, at + 1, value);
      return n;
    }
    i32 cp = 0;
    while (cp < n.path.len() && at + cp < key.len() && n.path[cp] == key[at + cp]) { cp++; }
    if (n.kind == EXT && cp == n.path.len()) {
      n.next = this.put(n.next, key, at + cp, value);
      return n;
    }
    // They part after `cp` nibbles: a branch there; what was here goes under its nibble, which is the lower,
    // and is finished.
    SNode b = sbranch();
    i32 mine = n.path[cp] as i32;
    u8[] here = joined(part(key, 0, at + cp), [mine as@ u8]);
    SNode old = n.kind == LEAF ? sleaf(part(n.path, cp + 1, n.path.len()), n.value)
                               : (cp + 1 == n.path.len() ? n.next! : sext(part(n.path, cp + 1, n.path.len()), n.next!));
    b.kids[mine] = this.seal(old, here, false);
    i32 theirs = key[at + cp] as i32;
    b.kids[theirs] = sleaf(part(key, at + cp + 1, key.len()), value);
    return cp == 0 ? b : sext(part(n.path, 0, cp), b);
  }

  /** `n`, at `path`, and everything under it sealed and emitted: a node holding only its reference. */
  SNode seal(this, SNode n, u8[] path, bool isRoot) {
    if (n.kind == SEALED) { return n; }
    if (n.kind == BRANCH) {
      for (i32 i = 0; i < 16; i++) {
        if (n.kids[i] is not null) { n.kids[i] = this.seal(n.kids[i]!, joined(path, [i as@ u8]), false); }
      }
    } else if (n.kind == EXT) {
      n.next = this.seal(n.next!, joined(path, n.path), false);
    }
    Item it = itemOf(n);
    u8[] enc = encode(it);
    if (isRoot || enc.len() >= 32) { this.emit(path, enc); }
    Item ref = enc.len() < 32 && !isRoot ? it : Item.Bytes(keccak256(enc));
    return SNode(SEALED, u8[].filled(0, 0), u8[].filled(0, 0), SNode?[].defaulted(0), null, ref);
  }

  /** Everything left sealed and emitted, and the root hash. */
  u8[] finish(this) {
    if (this.root is null) { return emptyRoot(); }
    SNode r = this.seal(this.root!, u8[].filled(0, 0), true);
    this.root = r;
    return bytesOf(r.ref!);
  }
}

Item itemOf(SNode n) {
  if (n.kind == LEAF) { return Item.List([Item.Bytes(hexPrefixOf(n.path, true)), Item.Bytes(n.value)]); }
  if (n.kind == EXT) { return Item.List([Item.Bytes(hexPrefixOf(n.path, false)), n.next!.ref!]); }
  Item[] b = Item[].filled(17, Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < 16; i++) {
    if (n.kids[i] is not null) { b[i] = n.kids[i]!.ref!; }
  }
  return Item.List(b);
}

/** Whether `a` sorts strictly after `b`. */
bool after(u8[] a, u8[] b) {
  i32 n = a.len() < b.len() ? a.len() : b.len();
  for (i32 i = 0; i < n; i++) {
    if (a[i] != b[i]) { return a[i] > b[i]; }
  }
  return a.len() > b.len();
}
