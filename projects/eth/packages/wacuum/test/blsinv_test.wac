// BLS12-381 base-field inversion here against `bls`'s own fpInvert.

import { keccak256 } from "../src/crypto/keccak.wac";
import { bls.fpInvert, bls.fpFromBytes, bls.fpMul, bls.fpOne, bls.fpEquals } from "wac";
import { fpInverse } from "../src/crypto/blsinv.wac";
import { Check } from "./check.wac";

export string test_inversion_agrees_with_bls() {
  Check t = Check.create();
  u8[] seed = "bls".toBytes();
  for (i32 i = 0; i < 40; i++) {
    seed = keccak256(seed);
    u8[] b = u8[].filled(48, 0);
    // Below p: the top byte kept small.
    for (i32 k = 0; k < 32; k++) { b[16 + k] = seed[k]; }
    b[15] = (i as@ u8);
    u32[] a = fpFromBytes(b)!;
    u32[] mine = fpInverse(a)!;
    t.ok(fpEquals(mine, fpInvert(a)!), "the inverse of element \{i}");
    t.ok(fpEquals(fpMul(a, mine), fpOne()), "element \{i} times its inverse");
  }
  t.ok(fpInverse(fpFromBytes(u8[].filled(48, 0))!) is null, "zero has none");
  return t.report();
}
