// Public networks' genesis blocks and fork ids against geth's: the genesis as `geth --<net> dumpgenesis` writes it
// (mainnet's Frontier genesis with its 8 893 accounts; Sepolia's, Merge-era; Hoodi's, Cancun at genesis), its hash
// computed here in the header shape its own forks give it, and EIP-2124's fork id at points across each chain's forks
// — a peer drops a node whose fork id does not fit its own. The expected values are go-ethereum 1.17.10's own
// (`core.Default*GenesisBlock().Hash()`, `forkid.NewID`).

import { Sys } from "std";
import { json.parse } from "wac";
import { U256 } from "../src/u256.wac";
import { genesisFrom, Genesis } from "../src/chain/genesis.wac";
import { forkId, ForkId } from "../src/p2p/wire.wac";
import { Check } from "./check.wac";

async Genesis? load(Sys sys, string name) {
  string[] why = [""];
  return genesisFrom(parse((await sys.readFile("test/chain/\{name}-genesis.json")).ok()!).ok()!, why);
}

string hex8(u32 v) {
  string h = U256.ofU64(v as u64).toHex().slice(2, 100);
  while (h.len() < 8) { h = "0" + h; }
  return h;
}

/** `[number, time, hash, next]` rows, as geth computed them. */
void forks(Check t, Genesis g, string net, u64[] numbers, u64[] times, string[] hashes, u64[] nexts) {
  for (i32 i = 0; i < numbers.len(); i++) {
    ForkId f = forkId(g.header.hash, g.forkBlocks, g.forkTimes, numbers[i], times[i]);
    t.ok(hex8(f.hash) == hashes[i] && f.next == nexts[i],
         "\{net} at block \{numbers[i]}, time \{times[i]}: \{hex8(f.hash)}/\{f.next}, geth \{hashes[i]}/\{nexts[i]}");
  }
}

export async string test_mainnet_genesis_and_fork_ids_are_geths(Sys sys) {
  Check t = Check.create();
  Genesis g = (await load(sys, "mainnet"))!;
  t.eqStr(g.header.hash.toHex(), "0xd4e56740f876aef8c010b86a40d5f56745a118d0906a34e69aec8c0db1cb8fa3", "mainnet's genesis hash, from its alloc");
  t.ok(g.beforeRun, "a genesis before Cancun: its early blocks are never run");
  forks(t, g, "mainnet", [0, 1150000, 15537394, 19426587, 22431084, 24000000, 24300000, 26437654],
        [0, 0, 1681338454, 1710338135, 1746612311, 1764798551, 1767747671, 1795000000],
        ["fc64ec04", "97c2c34c", "f0afd0e3", "9f3d2254", "c376cf8b", "5167e2a6", "07c9462e", "07c9462e"],
        [1150000, 1920000, 1681338455, 1746612311, 1764798551, 1765290071, 0, 0]);
  return t.report();
}

export async string test_sepolia_genesis_and_fork_ids_are_geths(Sys sys) {
  Check t = Check.create();
  Genesis g = (await load(sys, "sepolia"))!;
  t.eqStr(g.header.hash.toHex(), "0x25a5cc106eea7138acab33231d7160d69cb777ee0c2c553fcddf5138993e6dd9", "Sepolia's genesis hash");
  forks(t, g, "sepolia", [0, 15537394, 19426587, 22431084, 24000000, 26437654], [0, 1681338454, 1710338135, 1746612311, 1764798551, 1795000000],
        ["fe3366e7", "f7f9bc08", "88cf81d9", "ed88b5fd", "268956b6", "6c1d9423"], [1735371, 1706655072, 1741159776, 1760427360, 1791294816, 0]);
  return t.report();
}

export async string test_hoodi_genesis_and_fork_ids_are_geths(Sys sys) {
  Check t = Check.create();
  Genesis g = (await load(sys, "hoodi"))!;
  t.eqStr(g.header.hash.toHex(), "0xbbe312868b376a3001692a646dd2d7d1e4406380dfd86b98aa8a34d1557c971b", "Hoodi's genesis hash");
  t.ok(!g.beforeRun, "Hoodi is on Cancun at genesis");
  forks(t, g, "hoodi", [0, 22431084, 24000000], [0, 1746612311, 1764798551], ["bef71d30", "0929e24e", "23aa1351"], [1742999832, 1761677592, 0]);
  return t.report();
}
