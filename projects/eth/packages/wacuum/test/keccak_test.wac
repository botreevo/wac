// keccak256 here against wac's, every length up to past two blocks: the lane reads, the partial last lane and
// the padding are where it could differ.

import { crypto.keccak256 as wacKeccak } from "wac";
import { keccak256 } from "../src/crypto/keccak.wac";
import { Check } from "./check.wac";

export string test_keccak256_agrees_with_wacs_at_every_length() {
  Check t = Check.create();
  u8[] data = u8[].filled(300, 0);
  for (i32 i = 0; i < 300; i++) { data[i] = ((i * 131 + 7) % 251) as@ u8; }
  for (i32 n = 0; n <= 300; n++) {
    u8[] m = u8[].filled(n, 0);
    m.copyFrom(data, 0, 0, n);
    u8[] a = keccak256(m);
    u8[] b = wacKeccak(m);
    bool same = true;
    for (i32 i = 0; i < 32; i++) { same = same && a[i] == b[i]; }
    t.ok(same, "\{n} bytes");
  }
  return t.report();
}
