// snap sync between two stores in memory: a server answering from one, a client fetching into the other a
// few kilobytes at a time, so that every account run and every cut-short storage run is proved. The client
// must end with the server's state root, built from what it fetched; and a server that leaves out an
// account, or answers about the wrong root, must be caught.

import { Map, Vec, Ticket } from "core";
import { rlp.Item, rlp.itemsOf } from "@/lib.wac";
import { U256 } from "../src/u256.wac";
import { World, Account, AccountState, slotMap, hashU256, eqU256, emptyCodeHash } from "../src/state/world.wac";
import { keccak256 } from "../src/crypto/keccak.wac";
import { Store } from "../src/store/tree.wac";
import { MemDisk } from "../src/store/disk.wac";
import { StateDb, rootOf } from "../src/store/state.wac";
import { Message } from "../src/p2p/wire.wac";
import { Asker, Fetched, snapSync, answerAccountRange, answerStorageRanges, answerByteCodes, answerTrieNodes, GET_TRIE_NODES,
         GET_ACCOUNT_RANGE, GET_STORAGE_RANGES, GET_BYTE_CODES } from "../src/p2p/snap.wac";
import { bytesToHex } from "../src/hex.wac";
import { PathTrie } from "../src/trie/pathtrie.wac";
import { Check } from "./check.wac";

/** A state: accounts with balances, some with code, some with a few slots, one with many. */
World state() {
  World w = World.create();
  for (i32 i = 1; i <= 300; i++) {
    U256 addr = U256.ofU64(((i * 7919) as@ u32) as u64);
    w.setBalance(addr, U256.ofU64(((i * 13) as@ u32) as u64));
    w.setNonce(addr, ((i % 5) as@ u32) as u64);
    if (i % 17 == 0) { w.setCode(addr, [0x60 as u8, (i & 255) as! u8, 0x00]); }
    if (i % 23 == 0) {
      for (i32 k = 0; k < 5; k++) { w.setStorage(addr, U256.ofU64(((k * 31 + i) as@ u32) as u64), U256.ofU64(((k + 1) as@ u32) as u64)); }
    }
  }
  U256 big = U256.ofU64(424242);
  for (i32 k = 0; k < 2000; k++) { w.setStorage(big, U256.ofU64(((k + 1) as@ u32) as u64), U256.ofU64(((k * 3 + 1) as@ u32) as u64)); }
  w.endTransaction();
  return w;
}

/** A server over `s`, as an Asker: a request answered from the store, the answer's items after its id. */
Asker serverOf(Store s, u8[] root, u64 bytes, fn<Item[](Item[])> tamper) {
  return Asker(async (Message m) => {
    Message a = m;
    if (m.code == GET_ACCOUNT_RANGE) { a = await answerAccountRange(s, root, m.body); }
    else if (m.code == GET_STORAGE_RANGES) { a = await answerStorageRanges(s, root, m.body); }
    else if (m.code == GET_BYTE_CODES) { a = await answerByteCodes(s, m.body); }
    else { return null; }
    Item[] all = itemsOf(a.body);
    Item[] rest = Item[].filled(all.len() - 1, all[0]);
    for (i32 i = 1; i < all.len(); i++) { rest[i - 1] = all[i]; }
    return tamper(rest);
  }, 1, bytes, null);
}

async string run() {
  Check t = Check.create();
  MemDisk sd = MemDisk.create();
  Store server = (await Store.open(sd.disk())).unwrap();
  string[] why = [""];
  u8[] root = (await StateDb.over(server).seed(state(), u8[].filled(0, 0), why))!;

  // Honest, a few kilobytes at a time.
  MemDisk cd = MemDisk.create();
  Store client = (await Store.open(cd.disk())).unwrap();
  Fetched f = await snapSync([serverOf(server, root, 4096, (Item[] x) => x)], client, root, "pivot".toBytes());
  t.eqStr(f.error, "", "the sync finishes");
  t.ok(f.accounts == 301 && f.slots == 2000 + 13 * 5 && f.codes == 17, "every account, slot and code: \{f.accounts}, \{f.slots}, \{f.codes}");
  t.ok(f.requests > 20, "in many runs: \{f.requests} requests");
  t.eqStr(bytesToHex(await rootOf(client)), bytesToHex(root), "the client's entries come to the server's root");
  t.eqStr(string.fromBytes(client.committed().user), "pivot", "and its last commit says so");
  // The tries it built are the ones block processing goes on from: read back, the same root and nodes.
  PathTrie back = PathTrie.of(client, u8[].filled(0, 0));
  await back.open();
  t.eqStr(bytesToHex(back.hash()), bytesToHex(root), "the stored account trie's root");
  PathTrie theirs = PathTrie.of(server, u8[].filled(0, 0));
  await theirs.open();
  t.ok((await back.storedNodes()) == (await theirs.storedNodes()), "as many account trie nodes as the server's");

  // From three peers at once: the same state, in fewer runs each.
  MemDisk cd4 = MemDisk.create();
  Store client4 = (await Store.open(cd4.disk())).unwrap();
  Asker[] three = [serverOf(server, root, 4096, (Item[] x) => x), serverOf(server, root, 4096, (Item[] x) => x),
                   serverOf(server, root, 4096, (Item[] x) => x)];
  Fetched f4 = await snapSync(three, client4, root, u8[].filled(0, 0));
  t.eqStr(f4.error, "", "a sync from three peers finishes");
  t.ok(f4.accounts == 301 && f4.slots == 2000 + 13 * 5 && f4.codes == 17, "with every account, slot and code: \{f4.accounts}, \{f4.slots}, \{f4.codes}");
  t.eqStr(bytesToHex(await rootOf(client4)), bytesToHex(root), "to the server's root");
  i32 asked = 0;
  for (i32 i = 0; i < 3; i++) { asked += three[i].nextId > 1 ? 1 : 0; }
  t.ok(asked == 3, "and every peer was asked: \{asked}");

  // A server that drops an account from the middle of a run.
  MemDisk cd2 = MemDisk.create();
  Store client2 = (await Store.open(cd2.disk())).unwrap();
  Fetched f2 = await snapSync([serverOf(server, root, 4096, (Item[] x) => dropOne(x))], client2, root, u8[].filled(0, 0));
  t.ok(f2.error.indexOf("does not prove") >= 0, "a run with an account left out is refused: \{f2.error}");

  // A server whose state is another: it answers nothing about this root.
  MemDisk cd3 = MemDisk.create();
  Store client3 = (await Store.open(cd3.disk())).unwrap();
  Fetched f3 = await snapSync([serverOf(server, u8[].filled(32, 7), 4096, (Item[] x) => x)], client3, root, u8[].filled(0, 0));
  t.ok(f3.error != "", "a peer without the state does not pass for one: \{f3.error}");
  return t.report();
}

/** The answer with the third account of its run taken out, when the run has that many. */
Item[] dropOne(Item[] x) {
  Item[] run = itemsOf(x[0]);
  if (run.len() < 4 || itemsOf(run[0]).len() != 2) { return x; }
  Item[] fewer = Item[].filled(run.len() - 1, run[0]);
  i32 j = 0;
  for (i32 i = 0; i < run.len(); i++) {
    if (i != 2) {
      fewer[j] = run[i];
      j++;
    }
  }
  return [Item.List(fewer), x[1]];
}

export string test_snap_sync_between_two_stores() { return run().wait().orElse("it never finished"); }

/** A server whose state moves on after `after` requests, as a peer's does while a sync runs: then it answers only about the new root. */
struct Moving {
  Store s;
  u8[] root;
  i32 asked;
  i32 after;
  bool moved;
  /** One request at a time: a real peer answers from a consistent state, and changes it at once between answers. */
  bool busy;
  Vec<Ticket<bool>> waiting;
}

/** The state the server moves to: balances changed, accounts gone and new, slots changed and gone, a contract made. */
async u8[] moveOn(Moving m) {
  Vec<U256> addrs = Vec.create();
  Vec<AccountState?> states = Vec.create();
  for (i32 i = 1; i <= 300; i += 6) {
    addrs.push(U256.ofU64(((i * 7919) as@ u32) as u64));
    // Every other one gone, the rest richer.
    states.push(i % 12 == 1 ? null : AccountState(true, 9, U256.ofU64(((i * 1000) as@ u32) as u64), u8[].filled(0, 0), emptyCodeHash()));
  }
  for (i32 i = 0; i < 20; i++) {
    addrs.push(U256.ofU64(((900000 + i) as@ u32) as u64));
    states.push(AccountState(true, 1, U256.ofU64(5), u8[].filled(0, 0), emptyCodeHash()));
  }
  u8[] code = [0x60 as u8, 0x2a, 0x60, 0x00, 0x55, 0x00];
  addrs.push(U256.ofU64(777777));
  states.push(AccountState(true, 1, U256.zero(), code, U256.fromBytes(keccak256(code), 0, 32)));
  Map<U256, Map<U256, U256>> slots = Map.create(hashU256, eqU256);
  Map<U256, U256> big = slotMap();
  for (i32 k = 1; k <= 2000; k += 9) { big.set(U256.ofU64(((k) as@ u32) as u64), k % 2 == 0 ? U256.zero() : U256.ofU64(((k * 11) as@ u32) as u64)); }
  slots.set(U256.ofU64(424242), big);
  Map<U256, U256> fresh = slotMap();
  fresh.set(U256.ofU64(1), U256.ofU64(99));
  slots.set(U256.ofU64(777777), fresh);
  AccountState?[] st = AccountState?[].defaulted(states.len());
  for (i32 i = 0; i < st.len(); i++) { st[i] = states.get(i); }
  string[] why = [""];
  u8[]? r = await StateDb.over(m.s).write(addrs.toArray(), st, slots, u8[].filled(0, 0), why);
  return r!;
}

async Item[]? answerMoving(Moving m, Message q) {
  m.asked++;
  if (!m.moved && m.asked > m.after) {
    m.root = await moveOn(m);
    m.moved = true;
  }
  Message a = q;
  if (q.code == GET_ACCOUNT_RANGE) { a = await answerAccountRange(m.s, m.root, q.body); }
  else if (q.code == GET_STORAGE_RANGES) { a = await answerStorageRanges(m.s, m.root, q.body); }
  else if (q.code == GET_BYTE_CODES) { a = await answerByteCodes(m.s, q.body); }
  else if (q.code == GET_TRIE_NODES) { a = await answerTrieNodes(m.s, m.root, q.body); }
  else { return null; }
  Item[] all = itemsOf(a.body);
  Item[] rest = Item[].filled(all.len() - 1, all[0]);
  for (i32 i = 1; i < all.len(); i++) { rest[i - 1] = all[i]; }
  return rest;
}

async string runMoving(i32 after) {
  Check t = Check.create();
  MemDisk sd = MemDisk.create();
  Store server = (await Store.open(sd.disk())).unwrap();
  string[] why = [""];
  u8[] first = (await StateDb.over(server).seed(state(), u8[].filled(0, 0), why))!;
  Moving m = Moving(server, first, 0, after, false, false, Vec.create());
  Asker peer = Asker(async (Message q) => {
    while (m.busy) {
      Ticket<bool> t;
      m.waiting.push(t);
      await t;
    }
    m.busy = true;
    Item[]? out = await answerMoving(m, q);
    m.busy = false;
    if (m.waiting.len() > 0) { m.waiting.remove(0).resolve(true); }
    return out;
  }, 1, 4096, () => m.root);

  MemDisk cd = MemDisk.create();
  Store client = (await Store.open(cd.disk())).unwrap();
  Fetched f = await snapSync([peer], client, first, "pivot".toBytes());
  t.eqStr(f.error, "", "the sync finishes though its pivot moved");
  t.ok(m.moved, "the pivot did move, after \{m.after} requests");
  t.ok(f.healed > 0, "and was healed: \{f.healed} nodes");
  t.eqStr(bytesToHex(f.root), bytesToHex(m.root), "to the newest root");
  t.eqStr(bytesToHex(await rootOf(client)), bytesToHex(m.root), "the client's entries come to it");
  PathTrie back = PathTrie.of(client, u8[].filled(0, 0));
  await back.open();
  t.eqStr(bytesToHex(back.hash()), bytesToHex(m.root), "and its stored account trie");
  PathTrie theirs = PathTrie.of(server, u8[].filled(0, 0));
  await theirs.open();
  i32 ours = await back.storedNodes();
  i32 serverNodes = await theirs.storedNodes();
  t.ok(ours == serverNodes, "with as many nodes as the server's: \{ours} and \{serverNodes}");
  // Nothing left over: as many entries of each kind as the server.
  i32 extra = 0;
  for (i32 kind = 0; kind < 5; kind++) {
    i32 a = (await client.range([kind as@ u8], [(kind + 1) as@ u8], 0x7fffffff)).len();
    i32 b = (await server.range([kind as@ u8], [(kind + 1) as@ u8], 0x7fffffff)).len();
    if (a != b) { extra++; }
  }
  t.ok(extra == 0, "every kind of entry counted the same as the server's");
  return t.report();
}

export string test_snap_sync_heals_a_moving_pivot() {
  // The pivot moving early in the accounts, later in them, in the storage, and near the end (a whole sync
  // is some thirty requests).
  string out = "";
  i32[] when = [3, 8, 15, 22];
  for (i32 i = 0; i < when.len(); i++) {
    string r = runMoving(when[i]).wait().orElse("it never finished");
    if (r != "") { out += "moving after \{when[i]}: " + r + "; "; }
  }
  return out;
}
