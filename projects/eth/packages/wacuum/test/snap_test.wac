// snap sync between two stores in memory: a server answering from one, a client fetching into the other a
// few kilobytes at a time, so that every account run and every cut-short storage run is proved. The client
// must end with the server's state root, built from what it fetched; and a server that leaves out an
// account, or answers about the wrong root, must be caught.

import { Map, Vec, Ticket } from "core";
import { Sys } from "std";
import { rlp.Item, rlp.itemsOf, rlp.decode, rlp.encode } from "@/lib.wac";
import { U256 } from "../src/u256.wac";
import { World, Account, AccountState, slotMap, hashU256, eqU256, emptyCodeHash } from "../src/state/world.wac";
import { keccak256 } from "../src/crypto/keccak.wac";
import { Store, Change, compareKeys } from "../src/store/tree.wac";
import { MemDisk, Disk } from "../src/store/disk.wac";
import { StateDb, rootOf } from "../src/store/state.wac";
import { Message } from "../src/p2p/wire.wac";
import { Asker, Fetched, snapSync, answerHeld, getAccountRange, fullAccount, answerAccountRange, answerStorageRanges, answerByteCodes, answerTrieNodes, GET_TRIE_NODES,
         GET_ACCOUNT_RANGE, GET_STORAGE_RANGES, GET_BYTE_CODES, getStorageRanges, nextKey } from "../src/p2p/snap.wac";
import { bytesToHex } from "../src/hex.wac";
import { PathTrie, entries, entryKey, isEntry } from "../src/trie/pathtrie.wac";
import { emptyRoot } from "../src/trie/trie.wac";
import { verifyRange, Range } from "../src/trie/rangeproof.wac";
import { rlp.bytesOf } from "@/lib.wac";
import { Check } from "./check.wac";

/** A state: accounts with balances, some with code, some with a few slots, one with many. */
World state() {
  World w = World.create();
  for (i32 i = 1; i <= 300; i++) {
    U256 addr = U256.ofU64(((i * 7919) as@ u32) as u64);
    w.setBalance(addr, U256.ofU64(((i * 13) as@ u32) as u64));
    w.setNonce(addr, ((i % 5) as@ u32) as u64);
    if (i % 17 == 0) { w.setCode(addr, [0x60 as u8, (i & 255) as! u8, 0x00]); }
    if (i % 23 == 0) {
      for (i32 k = 0; k < 5; k++) { w.setStorage(addr, U256.ofU64(((k * 31 + i) as@ u32) as u64), U256.ofU64(((k + 1) as@ u32) as u64)); }
    }
  }
  U256 big = U256.ofU64(424242);
  for (i32 k = 0; k < 2000; k++) { w.setStorage(big, U256.ofU64(((k + 1) as@ u32) as u64), U256.ofU64(((k * 3 + 1) as@ u32) as u64)); }
  w.endTransaction();
  return w;
}

/** A server over `s`, as an Asker: a request answered from the store, the answer's items after its id. */
Asker serverOf(Store s, u8[] root, u64 bytes, fn<Item[](Item[])> tamper) {
  return Asker(async (Message m) => {
    Message a = m;
    if (m.code == GET_ACCOUNT_RANGE) { a = await answerAccountRange(s, root, m.body); }
    else if (m.code == GET_STORAGE_RANGES) { a = await answerStorageRanges(s, root, m.body); }
    else if (m.code == GET_BYTE_CODES) { a = await answerByteCodes(s, m.body); }
    else { return null; }
    Item[] all = itemsOf(a.body);
    Item[] rest = Item[].filled(all.len() - 1, all[0]);
    for (i32 i = 1; i < all.len(); i++) { rest[i - 1] = all[i]; }
    return tamper(rest);
  }, 1, bytes, null);
}

async string run() {
  Check t = Check.create();
  MemDisk sd = MemDisk.create();
  Store server = (await Store.open(sd.disk())).unwrap();
  string[] why = [""];
  u8[] root = (await StateDb.over(server).seed(state(), u8[].filled(0, 0), why))!;

  // Honest, a few kilobytes at a time.
  MemDisk cd = MemDisk.create();
  Store client = (await Store.open(cd.disk())).unwrap();
  Fetched f = await snapSync([serverOf(server, root, 4096, (Item[] x) => x)], client, root, "pivot".toBytes());
  t.eqStr(f.error, "", "the sync finishes");
  t.ok(f.accounts == 301 && f.slots == 2000 + 13 * 5 && f.codes == 17, "every account, slot and code: \{f.accounts}, \{f.slots}, \{f.codes}");
  t.ok(f.requests > 20, "in many runs: \{f.requests} requests");
  t.eqStr(bytesToHex(await rootOf(client)), bytesToHex(root), "the client's entries come to the server's root");
  t.eqStr(string.fromBytes(client.committed().user), "pivot", "and its last commit says so");
  // The tries it built are the ones block processing goes on from: read back, the same root and nodes.
  PathTrie back = PathTrie.of(client, u8[].filled(0, 0));
  await back.open();
  t.eqStr(bytesToHex(back.hash()), bytesToHex(root), "the stored account trie's root");
  PathTrie theirs = PathTrie.of(server, u8[].filled(0, 0));
  await theirs.open();
  t.ok((await back.storedNodes()) == (await theirs.storedNodes()), "as many account trie nodes as the server's");

  // From three peers at once: the same state, in fewer runs each.
  MemDisk cd4 = MemDisk.create();
  Store client4 = (await Store.open(cd4.disk())).unwrap();
  Asker[] three = [serverOf(server, root, 4096, (Item[] x) => x), serverOf(server, root, 4096, (Item[] x) => x),
                   serverOf(server, root, 4096, (Item[] x) => x)];
  Fetched f4 = await snapSync(three, client4, root, u8[].filled(0, 0));
  t.eqStr(f4.error, "", "a sync from three peers finishes");
  t.ok(f4.accounts == 301 && f4.slots == 2000 + 13 * 5 && f4.codes == 17, "with every account, slot and code: \{f4.accounts}, \{f4.slots}, \{f4.codes}");
  t.eqStr(bytesToHex(await rootOf(client4)), bytesToHex(root), "to the server's root");
  i32 asked = 0;
  for (i32 i = 0; i < 3; i++) { asked += three[i].nextId > 1 ? 1 : 0; }
  t.ok(asked == 3, "and every peer was asked: \{asked}");

  // A server that drops an account from the middle of a run.
  MemDisk cd2 = MemDisk.create();
  Store client2 = (await Store.open(cd2.disk())).unwrap();
  Fetched f2 = await snapSync([serverOf(server, root, 4096, (Item[] x) => dropOne(x))], client2, root, u8[].filled(0, 0));
  t.ok(f2.error.indexOf("does not prove") >= 0, "a run with an account left out is refused: \{f2.error}");

  // A server whose state is another: it answers nothing about this root.
  MemDisk cd3 = MemDisk.create();
  Store client3 = (await Store.open(cd3.disk())).unwrap();
  Fetched f3 = await snapSync([serverOf(server, u8[].filled(32, 7), 4096, (Item[] x) => x)], client3, root, u8[].filled(0, 0));
  t.ok(f3.error != "", "a peer without the state does not pass for one: \{f3.error}");
  return t.report();
}

/** The answer with the third account of its run taken out, when the run has that many. */
Item[] dropOne(Item[] x) {
  Item[] run = itemsOf(x[0]);
  if (run.len() < 4 || itemsOf(run[0]).len() != 2) { return x; }
  Item[] fewer = Item[].filled(run.len() - 1, run[0]);
  i32 j = 0;
  for (i32 i = 0; i < run.len(); i++) {
    if (i != 2) {
      fewer[j] = run[i];
      j++;
    }
  }
  return [Item.List(fewer), x[1]];
}

export async string test_snap_sync_between_two_stores(Sys sys) { return await run(); }

/** A server whose state moves on after `after` requests, as a peer's does while a sync runs: then it answers only about the new root. */
struct Moving {
  Store s;
  u8[] root;
  i32 asked;
  i32 after;
  bool moved;
  /** One request at a time: a real peer answers from a consistent state, and changes it at once between answers. */
  bool busy;
  Vec<Ticket<bool>> waiting;
}

/** The state the server moves to: balances changed, accounts gone and new, slots changed and gone, a contract made. */
async u8[] moveOn(Moving m) {
  Vec<U256> addrs = Vec.create();
  Vec<AccountState?> states = Vec.create();
  for (i32 i = 1; i <= 300; i += 6) {
    addrs.push(U256.ofU64(((i * 7919) as@ u32) as u64));
    // Every other one gone, the rest richer.
    states.push(i % 12 == 1 ? null : AccountState(true, 9, U256.ofU64(((i * 1000) as@ u32) as u64), u8[].filled(0, 0), emptyCodeHash()));
  }
  for (i32 i = 0; i < 20; i++) {
    addrs.push(U256.ofU64(((900000 + i) as@ u32) as u64));
    states.push(AccountState(true, 1, U256.ofU64(5), u8[].filled(0, 0), emptyCodeHash()));
  }
  u8[] code = [0x60 as u8, 0x2a, 0x60, 0x00, 0x55, 0x00];
  addrs.push(U256.ofU64(777777));
  states.push(AccountState(true, 1, U256.zero(), code, U256.fromBytes(keccak256(code), 0, 32)));
  Map<U256, Map<U256, U256>> slots = Map.create(hashU256, eqU256);
  Map<U256, U256> big = slotMap();
  for (i32 k = 1; k <= 2000; k += 9) { big.set(U256.ofU64(((k) as@ u32) as u64), k % 2 == 0 ? U256.zero() : U256.ofU64(((k * 11) as@ u32) as u64)); }
  slots.set(U256.ofU64(424242), big);
  Map<U256, U256> fresh = slotMap();
  fresh.set(U256.ofU64(1), U256.ofU64(99));
  slots.set(U256.ofU64(777777), fresh);
  AccountState?[] st = AccountState?[].defaulted(states.len());
  for (i32 i = 0; i < st.len(); i++) { st[i] = states.get(i); }
  string[] why = [""];
  u8[]? r = await StateDb.over(m.s).write(addrs.toArray(), st, slots, u8[].filled(0, 0), why);
  return r!;
}

/** A new ticket each time it is asked for: one declared in the waiting loop would be one for every pass (wac 0474w). */
Ticket<bool> parked(Moving m) {
  Ticket<bool> t;
  m.waiting.push(t);
  return t;
}

async Item[]? answerMoving(Moving m, Message q) {
  m.asked++;
  if (!m.moved && m.asked > m.after) {
    m.root = await moveOn(m);
    m.moved = true;
  }
  Message a = q;
  if (q.code == GET_ACCOUNT_RANGE) { a = await answerAccountRange(m.s, m.root, q.body); }
  else if (q.code == GET_STORAGE_RANGES) { a = await answerStorageRanges(m.s, m.root, q.body); }
  else if (q.code == GET_BYTE_CODES) { a = await answerByteCodes(m.s, q.body); }
  else if (q.code == GET_TRIE_NODES) { a = await answerTrieNodes(m.s, m.root, q.body); }
  else { return null; }
  Item[] all = itemsOf(a.body);
  Item[] rest = Item[].filled(all.len() - 1, all[0]);
  for (i32 i = 1; i < all.len(); i++) { rest[i - 1] = all[i]; }
  return rest;
}

/** One asker over the moving server; several share its one state, as peers on one chain do. */
Asker movingAsker(Moving m) {
  return Asker(async (Message q) => {
    while (m.busy) { await parked(m); }
    m.busy = true;
    Item[]? out = await answerMoving(m, q);
    m.busy = false;
    if (m.waiting.len() > 0) { m.waiting.remove(0).resolve(true); }
    return out;
  }, 1, 4096, () => m.root);
}

async string runMoving(i32 after, i32 count) {
  Check t = Check.create();
  MemDisk sd = MemDisk.create();
  Store server = (await Store.open(sd.disk())).unwrap();
  string[] why = [""];
  u8[] first = (await StateDb.over(server).seed(state(), u8[].filled(0, 0), why))!;
  Moving m = Moving(server, first, 0, after, false, false, Vec.create());
  Asker[] peers = Asker[].filled(count, movingAsker(m));
  for (i32 i = 1; i < count; i++) { peers[i] = movingAsker(m); }

  MemDisk cd = MemDisk.create();
  Store client = (await Store.open(cd.disk())).unwrap();
  Fetched f = await snapSync(peers, client, first, "pivot".toBytes());
  t.eqStr(f.error, "", "the sync finishes though its pivot moved");
  t.ok(m.moved, "the pivot did move, after \{m.after} requests");
  t.ok(f.healed > 0, "and was healed: \{f.healed} nodes");
  t.eqStr(bytesToHex(f.root), bytesToHex(m.root), "to the newest root");
  t.eqStr(bytesToHex(await rootOf(client)), bytesToHex(m.root), "the client's entries come to it");
  PathTrie back = PathTrie.of(client, u8[].filled(0, 0));
  await back.open();
  t.eqStr(bytesToHex(back.hash()), bytesToHex(m.root), "and its stored account trie");
  PathTrie theirs = PathTrie.of(server, u8[].filled(0, 0));
  await theirs.open();
  i32 ours = await back.storedNodes();
  i32 serverNodes = await theirs.storedNodes();
  t.ok(ours == serverNodes, "with as many nodes as the server's: \{ours} and \{serverNodes}");
  // Nothing left over: as many accounts, slots and trie nodes as the server. Not codes: they are kept by hash
  // and the server keeps those of accounts gone in the move, which the client fetched only if it saw the
  // account before the move; instead, every code an account names must be there.
  i32 extra = 0;
  for (i32 kind = 0; kind < 5; kind++) {
    if (kind == 2) { continue; }
    i32 a = (await client.range([kind as@ u8], [(kind + 1) as@ u8], 0x7fffffff)).len();
    i32 b = (await server.range([kind as@ u8], [(kind + 1) as@ u8], 0x7fffffff)).len();
    if (a != b) { extra++; }
  }
  Vec<Change> accounts = await entries(client, u8[].filled(0, 0), u8[].filled(32, 0), 0x7fffffff);
  i32 missingCode = 0;
  for (i32 i = 0; i < accounts.len(); i++) {
    u8[] ch = bytesOf(itemsOf(decode(accounts.get(i).value!).item)[3]);
    if (bytesToHex(ch) == emptyCodeHash().toHex()) { continue; }
    u8[] at = u8[].filled(33, 2);
    at.copyFrom(ch, 0, 1, 32);
    // A code's chunks are at 2, its hash, and a two-byte index: all before 2, the hash, ff ff ff.
    u8[] past = u8[].filled(36, 0xff);
    past[0] = 2;
    past.copyFrom(ch, 0, 1, 32);
    if ((await client.range(at, past, 1)).len() == 0) { missingCode++; }
  }
  t.ok(missingCode == 0, "every code an account names is there: \{missingCode} missing");
  t.ok(extra == 0, "every kind of entry counted the same as the server's");
  return t.report();
}

/** Async, not `wait()`: eight syncs each waited for would all be kept alive (wac 0473w), past the heap. */
export async string test_snap_sync_heals_a_moving_pivot(Sys sys) {
  // The pivot moving early in the accounts, later in them, in the storage, and near the end (a whole sync
  // is some thirty requests).
  string out = "";
  i32[] when = [3, 8, 15, 22];
  for (i32 i = 0; i < when.len(); i++) {
    for (i32 count = 1; count <= 3; count += 2) {
      string r = await runMoving(when[i], count);
      if (r != "") { out += "moving after \{when[i]}, from \{count} peer(s): " + r + "; "; }
    }
  }
  return out;
}

/** Round `r` of blocks committing under a server: balances changed, some accounts gone, some new. */
async u8[] bump(Store s, i32 r) {
  Vec<U256> addrs = Vec.create();
  Vec<AccountState?> states = Vec.create();
  for (i32 i = 1 + r; i <= 300; i += 5) {
    addrs.push(U256.ofU64(((i * 7919) as@ u32) as u64));
    states.push(i % 10 == r ? null : AccountState(true, 3, U256.ofU64(((i * 100 + r) as@ u32) as u64), u8[].filled(0, 0), emptyCodeHash()));
  }
  for (i32 i = 0; i < 7; i++) {
    addrs.push(U256.ofU64(((800000 + r * 100 + i) as@ u32) as u64));
    states.push(AccountState(true, 1, U256.ofU64(7), u8[].filled(0, 0), emptyCodeHash()));
  }
  AccountState?[] st = AccountState?[].defaulted(states.len());
  for (i32 i = 0; i < st.len(); i++) { st[i] = states.get(i); }
  string[] why = [""];
  u8[]? root = await StateDb.over(s).write(addrs.toArray(), st, Map.create(hashU256, eqU256), u8[].filled(0, 0), why);
  return root ?? u8[].filled(0, 0);
}

/** Whether an account range answered about `root` from `origin` proves, or is empty (not about that root). */
string judge(Message a, u8[] root, u8[] origin) {
  Item[] all = itemsOf(a.body);
  Item[] run = itemsOf(all[1]);
  Item[] proof = itemsOf(all[2]);
  if (run.len() == 0 && proof.len() == 0) { return "empty"; }
  u8[][] keys = u8[][].defaulted(run.len());
  u8[][] vals = u8[][].defaulted(run.len());
  for (i32 i = 0; i < run.len(); i++) {
    Item[] pair = itemsOf(run[i]);
    keys[i] = bytesOf(pair[0]);
    vals[i] = fullAccount(pair[1])!;
  }
  u8[][] nodes = u8[][].defaulted(proof.len());
  for (i32 i = 0; i < proof.len(); i++) { nodes[i] = bytesOf(proof[i]); }
  Range r = verifyRange(root, origin, keys, vals, nodes);
  return r.ok ? "proved" : r.why;
}

/** `m`'s disk, but every read and write waits a turn of the host first, as a file's do. */
Disk slow(MemDisk m, Sys sys) {
  Disk d = m.disk();
  return Disk(async (i64 at, i32 n) => {
    await sys.sleepMillis(0);
    return await d.read(at, n);
  }, d.readNow, async (i64 at, u8[] b) => {
    await sys.sleepMillis(0);
    return await d.write(at, b);
  }, d.sync, d.size);
}

async string serving(Sys sys, i32 rounds, i32 per) {
  Check t = Check.create();
  MemDisk sd = MemDisk.create();
  Store server = (await Store.open(slow(sd, sys))).unwrap();
  // Few leaves kept, so that answers go to the disk, and wait there.
  server.maxLeaves = 2;
  string[] why = [""];
  u8[] root = (await StateDb.over(server).seed(state(), u8[].filled(0, 0), why))!;
  // Opened again, it holds only the interior: the leaves are read as they are needed.
  server = (await Store.open(slow(sd, sys))).unwrap();
  server.maxLeaves = 2;
  Vec<Ticket<Message>> answers = Vec.create();
  Vec<u8[]> asked = Vec.create();
  Vec<u8[]> origins = Vec.create();
  for (i32 r = 0; r < rounds; r++) {
    // A block on its way to committing, and requests about the state now arriving one after another while it
    // is: some answered before it, some across it, some after.
    Ticket<u8[]> block = bump(server, r);
    for (i32 k = 0; k < per; k++) {
      u8[] origin = u8[].filled(32, 0);
      origin[0] = (k * 32) as! u8;
      u8[] limit = u8[].filled(32, 0xff);
      answers.push(answerHeld(server, GET_ACCOUNT_RANGE, getAccountRange(((r * per + k) as@ u32) as u64, root, origin, limit, 2048).body));
      asked.push(root);
      origins.push(origin);
      await sys.sleepMillis(0);
    }
    root = await block;
  }
  i32 proved = 0;
  i32 empty = 0;
  string bad = "";
  for (i32 i = 0; i < answers.len(); i++) {
    string v = judge(await answers.get(i), asked.get(i), origins.get(i));
    if (v == "proved") { proved++; }
    else if (v == "empty") { empty++; }
    else if (bad == "") { bad = v; }
  }
  t.eqStr(bad, "", "no answer mixes two states (\{proved} proved, \{empty} about a state gone)");
  t.ok(proved >= 6, "and those served before their block are proved: \{proved}");
  return t.report();
}

/** Run with a `Sys` (so `wac test --allow-read`): its turns are what interleave the answers and the blocks. */
export async string test_snap_answers_while_blocks_commit(Sys sys) { return await serving(sys, 6, 8); }

/**
 * A trie in `s` (the accounts', or with `owner` a storage's) whose keys come in groups sharing their first 12
 * nibbles, so that it has nodes below the level-keyed depths, and the depth-first region of the store holds
 * nodes and entries mixed: committed, its sorted keys into `keys`, its root returned. A random state of a few
 * hundred keys has no node that deep, and every node would sort before every entry.
 */
async u8[] mixed(Store s, u8[] owner, i32 groups, i32 per, u64 seed, Vec<u8[]> keys) {
  u64 x = seed;
  PathTrie t = PathTrie.of(s, owner);
  await t.open();
  Vec<Change> out = Vec.create();
  for (i32 g = 0; g < groups; g++) {
    u8[] head = u8[].filled(6, 0);
    for (i32 b = 0; b < 6; b++) {
      x ^= x << 13;
      x ^= x >> 7;
      x ^= x << 17;
      head[b] = (x & 255) as! u8;
    }
    for (i32 j = 0; j < per; j++) {
      u8[] k = u8[].filled(32, 0);
      k.copyFrom(head, 0, 0, 6);
      for (i32 b = 6; b < 32; b++) {
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        k[b] = (x & 255) as! u8;
      }
      // An account as snap's full form has it, or a slot's value.
      u8[] v = owner.len() == 0 ? encode(Item.List([Item.Bytes([(j + 1) as! u8]), Item.Bytes([g as! u8, 7]), Item.Bytes(emptyRoot()), Item.Bytes(emptyCodeHash().toBytes())]))
                                : encode(Item.Bytes([(j + 1) as! u8, g as! u8]));
      await t.set(k, v);
      out.push(Change(entryKey(owner, k), v));
      keys.push(k);
    }
  }
  Change[] nodes = t.changes();
  for (i32 i = 0; i < nodes.len(); i++) { out.push(nodes[i]); }
  string bad = await s.commit(out.toArray(), u8[].filled(0, 0));
  keys.sort((u8[] a, u8[] b) => compareKeys(a, b));
  return bad == "" ? t.hash() : u8[].filled(0, 0);
}

/** Whether `got` is `model` from some index on, in order, and from where; -1 if not. */
i32 runIn(u8[][] model, u8[][] got) {
  if (got.len() == 0) { return -1; }
  for (i32 s = 0; s < model.len(); s++) {
    if (bytesToHex(model[s]) != bytesToHex(got[0])) { continue; }
    for (i32 i = 0; i < got.len(); i++) {
      if (s + i >= model.len() || bytesToHex(model[s + i]) != bytesToHex(got[i])) { return -1; }
    }
    return s;
  }
  return -1;
}

async string ranges() {
  Check t = Check.create();
  MemDisk sd = MemDisk.create();
  Store s = (await Store.open(sd.disk())).unwrap();
  // Accounts: 30 groups of 10 sharing 12 nibbles, so nodes 13 deep and more among the entries.
  Vec<u8[]> ak = Vec.create();
  u8[] root = await mixed(s, u8[].filled(0, 0), 30, 10, 0x9e3779b97f4a7c15, ak);
  u8[][] model = ak.toArray();
  Vec<Change> deep = await s.range([3, 16], [3, 17], 0x7fffffff);
  i32 deepNodes = 0;
  for (i32 i = 0; i < deep.len(); i++) {
    if (!isEntry(deep.get(i).key)) { deepNodes++; }
  }
  t.ok(deepNodes > 100, "the depth-first region holds nodes as well as entries: \{deepNodes} nodes, \{deep.len() - deepNodes} entries");
  u8[][] origins = [u8[].filled(32, 0), model[100], (nextKey(model[150]))!, model[295]];
  // The third is just past a key, so its run starts at the next.
  i32[] starts = [0, 100, 151, 295];
  for (i32 o = 0; o < origins.len(); o++) {
    Message a = await answerAccountRange(s, root, getAccountRange(1, root, origins[o], u8[].filled(32, 255), 1200).body);
    Item[] run = itemsOf(itemsOf(a.body)[1]);
    u8[][] got = u8[][].defaulted(run.len());
    for (i32 i = 0; i < run.len(); i++) { got[i] = bytesOf(itemsOf(run[i])[0]); }
    t.ok(got.len() > 1, "from origin \{o}: more than one account (\{got.len()})");
    t.ok(runIn(model, got) == starts[o], "from origin \{o}: only accounts, in order, none missed, from the right one: at \{runIn(model, got)}");
    t.eqStr(judge(a, root, origins[o]), "proved", "from origin \{o}: it proves");
  }
  // Slots: one storage the same way, asked for from its 700th, cut short by the budget.
  u8[] owner = model[7];
  Vec<u8[]> sk = Vec.create();
  u8[] storageRoot = await mixed(s, owner, 100, 20, 0x2545f4914f6cdd1d, sk);
  u8[][] slots = sk.toArray();
  Message a = await answerStorageRanges(s, root, getStorageRanges(2, root, [owner], slots[700], u8[].filled(32, 255), 1500).body);
  Item[] lists = itemsOf(itemsOf(a.body)[1]);
  Item[] run = lists.len() == 1 ? itemsOf(lists[0]) : Item[].filled(0, Item.Bytes(u8[].filled(0, 0)));
  u8[][] got = u8[][].defaulted(run.len());
  u8[][] vals = u8[][].defaulted(run.len());
  for (i32 i = 0; i < run.len(); i++) {
    got[i] = bytesOf(itemsOf(run[i])[0]);
    vals[i] = bytesOf(itemsOf(run[i])[1]);
  }
  t.ok(got.len() > 1 && got.len() < 1300, "slots from the 700th: a run cut short by the budget (\{got.len()})");
  t.ok(runIn(slots, got) == 700, "only slots, in order, none missed, from the 700th: at \{runIn(slots, got)}");
  Item[] proof = itemsOf(itemsOf(a.body)[2]);
  u8[][] nodes = u8[][].defaulted(proof.len());
  for (i32 i = 0; i < proof.len(); i++) { nodes[i] = bytesOf(proof[i]); }
  Range r = verifyRange(storageRoot, slots[700], got, vals, nodes);
  t.ok(r.ok, "and it proves: \{r.why}");
  return t.report();
}

export async string test_snap_ranges_pass_over_trie_nodes(Sys sys) { return await ranges(); }
