// A world backed by a `StateSource`: what it does not hold is asked of the source once, writes and
// deletions win over the source, and a revert does not bring back what the source said differently.

import { Map } from "core";
import { U256 } from "../src/u256.wac";
import { World, Account, StateSource, slotMap, hashU256, eqU256, emptyCodeHash } from "../src/state/world.wac";
import { Check } from "./check.wac";

/** A source with one account, 0xaa, holding 5 wei and slot 1 = 7, that counts what it is asked. */
struct Counted {
  i32[] asks;

  StateSource source(this) {
    i32[] asks = this.asks;
    return StateSource((U256 addr) => {
      asks[0] = asks[0] + 1;
      if (!addr.eq(U256.ofU64(0xaa))) { return null; }
      return Account(1, U256.ofU64(5), u8[].filled(0, 0), emptyCodeHash(), slotMap(), null, Map.create(hashU256, eqU256));
    }, (U256 addr, U256 key) => {
      asks[1] = asks[1] + 1;
      return key.eq(U256.one()) ? U256.ofU64(7) : U256.zero();
    }, (U256 addr) => addr.eq(U256.ofU64(0xaa)));
  }
}

export string test_a_backed_world_reads_through_once() {
  Check t = Check.create();
  Counted c = Counted([0, 0]);
  World w = World.create();
  w.backBy(c.source());
  U256 a = U256.ofU64(0xaa);
  t.eqU256(w.balance(a), U256.ofU64(5), "the balance comes from the source");
  t.eqU256(w.storage(a, U256.one()), U256.ofU64(7), "and the slot");
  t.eqU256(w.storage(a, U256.one()), U256.ofU64(7), "and again");
  t.eqU256(w.storage(a, U256.ofU64(2)), U256.zero(), "an empty slot is zero");
  t.eqU256(w.storage(a, U256.ofU64(2)), U256.zero(), "and still zero");
  t.ok(!w.exists(U256.ofU64(0xbb)) && !w.exists(U256.ofU64(0xbb)), "an absent account is absent");
  t.ok(c.asks[0] == 2 && c.asks[1] == 2, "each account and slot asked once: \{c.asks[0]} and \{c.asks[1]}");
  t.ok(w.hasStorage(a), "the account has storage it has not been asked for");
  return t.report();
}

export string test_writes_and_deletions_win_over_the_source() {
  Check t = Check.create();
  Counted c = Counted([0, 0]);
  World w = World.create();
  w.backBy(c.source());
  U256 a = U256.ofU64(0xaa);
  w.setStorage(a, U256.one(), U256.zero());
  w.endTransaction();
  t.eqU256(w.storage(a, U256.one()), U256.zero(), "a slot cleared stays cleared, not read again from the source");
  w.setBalance(a, U256.zero());
  w.setNonce(a, 0);
  w.markTouched(a);
  w.endTransaction();
  t.ok(!w.exists(a), "an account emptied and touched is swept");
  t.ok(!w.exists(a), "and the source is not asked again");
  t.ok(c.asks[0] == 1, "the account was asked for once: \{c.asks[0]}");
  return t.report();
}
