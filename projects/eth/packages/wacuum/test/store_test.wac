// The store against a map: random puts and deletes over many commits, reopened from the disk after each;
// a tree tall enough to have interior nodes under interior nodes; and a commit cut short at every write
// it makes, with any subset of what was not yet synced lost, which must reopen as the commit before or the
// commit itself, never anything between. The disk is in memory and never waits, so each test drives its
// async body to the end with `wait`, and needs no grant.

import { Map, Vec, Ticket } from "core";
import { Sys } from "std";
import { hashString, stringEq } from "core";
import { bytesToHex } from "../src/hex.wac";
import { Store, Change, compareKeys, LEAVES, CACHE_MB } from "../src/store/tree.wac";
import { EntryCache } from "../src/store/cache.wac";
import { MemDisk, Disk } from "../src/store/disk.wac";
import { Check } from "./check.wac";

struct Rng {
  u64 x;

  u64 next(this) {
    this.x = this.x ^ (this.x << 13);
    this.x = this.x ^ (this.x >> 7);
    this.x = this.x ^ (this.x << 17);
    return this.x;
  }
  i32 below(this, i32 n) { return (this.next() % ((n as@ u32) as u64)) as! i32; }
  u8[] bytes(this, i32 n) {
    u8[] b = u8[].filled(n, 0);
    for (i32 i = 0; i < n; i++) { b[i] = (this.next() & 255) as! u8; }
    return b;
  }
}

/** The model: hex of the key to the value. */
Map<string, u8[]> model() { return Map.create(hashString, stringEq); }

/** Whether the store holds exactly the model, every key looked up and every absent key from `gone` too. */
async string differs(Store s, Map<string, u8[]> m, Vec<u8[]> keys) {
  for (i32 i = 0; i < keys.len(); i++) {
    u8[] k = keys.get(i);
    u8[]? want = m.get(bytesToHex(k));
    u8[]? got = await s.get(k);
    if (want is null && got is not null) { return "key \{bytesToHex(k)} should be absent"; }
    if (want is not null && got is null) { return "key \{bytesToHex(k)} is missing"; }
    if (want is not null && bytesToHex(want!) != bytesToHex(got!)) { return "key \{bytesToHex(k)} has the wrong value"; }
  }
  return "";
}

async string run_the_store_agrees_with_a_map_across_commits_and_reopening(i32 leaves, i64 cacheBytes) {
  // With the store's own settings, and the cache in front: what it reads must be what the file holds.
  Check t = Check.create();
  Rng r = Rng(0x9e3779b97f4a7c15);
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  s.maxLeaves = leaves;
  s.cache = EntryCache.create(cacheBytes);
  Map<string, u8[]> m = model();
  Vec<u8[]> keys = Vec.create();
  for (i32 round = 0; round < 25; round++) {
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < 400; i++) {
      bool del = keys.len() > 0 && r.below(10) < 3;
      u8[] k = del ? keys.get(r.below(keys.len())) : r.bytes(1 + r.below(40));
      if (!del) { keys.push(k); }
      u8[]? v = del ? null : r.bytes(r.below(50) == 0 ? 5000 : r.below(120));
      cs.push(Change(k, v));
      if (v is null) { m.remove(bytesToHex(k)); } else { m.set(bytesToHex(k), v!); }
    }
    string e = await s.commit(cs.toArray(), "round \{round}".toBytes());
    t.eqStr(e, "", "commit \{round}");
    t.eqStr(await differs(s, m, keys), "", "after commit \{round}");
    Store again = (await Store.open(md.disk())).unwrap();
    t.eqStr(await differs(again, m, keys), "", "reopened after commit \{round}");
    t.eqStr(string.fromBytes(again.committed().user), "round \{round}", "its own bytes after commit \{round}");
    // Carry on with the reopened one half the time, so both paths keep being exercised.
    if (round % 2 == 1) {
      s = again;
      s.maxLeaves = leaves;
      s.cache = EntryCache.create(cacheBytes);
    }
  }
  t.ok(s.height >= 2, "a tree of more than one level: \{s.height}");

  // Everything deleted: the tree empties and still reopens.
  Vec<Change> all = Vec.create();
  for (i32 i = 0; i < keys.len(); i++) {
    all.push(Change(keys.get(i), null));
    m.remove(bytesToHex(keys.get(i)));
  }
  t.eqStr(await s.commit(all.toArray(), u8[].filled(0, 0)), "", "deleting everything");
  t.eqStr(await differs((await Store.open(md.disk())).unwrap(), m, keys), "", "empty after reopening");
  return t.report();
}

async string run_a_tall_tree_with_big_keys() {
  Check t = Check.create();
  Rng r = Rng(12345);
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  Map<string, u8[]> m = model();
  Vec<u8[]> keys = Vec.create();
  // 1000-byte keys and 5 KB values: three entries a leaf, some sixteen children an interior node.
  for (i32 round = 0; round < 6; round++) {
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < 60; i++) {
      u8[] k = r.bytes(1000);
      u8[] v = r.bytes(5000);
      keys.push(k);
      cs.push(Change(k, v));
      m.set(bytesToHex(k), v);
    }
    t.eqStr(await s.commit(cs.toArray(), u8[].filled(0, 0)), "", "commit \{round}");
  }
  t.ok(s.height >= 3, "interior under interior: height \{s.height}");
  t.eqStr(await differs((await Store.open(md.disk())).unwrap(), m, keys), "", "reopened");

  // A range, in order, from the middle.
  Vec<u8[]> sorted = Vec.create();
  for (i32 i = 0; i < keys.len(); i++) { sorted.push(keys.get(i)); }
  sorted.sort((u8[] a, u8[] b) => compareKeys(a, b));
  Vec<Change> got = await s.range(sorted.get(100), sorted.get(150), 1000);
  t.ok(got.len() == 50, "fifty keys in the range: \{got.len()}");
  bool inOrder = true;
  for (i32 i = 0; i < got.len(); i++) { inOrder = inOrder && compareKeys(got.get(i).key, sorted.get(100 + i)) == 0; }
  t.ok(inOrder, "in order");
  return t.report();
}

/** A store with two commits of 300 keys, on a fresh disk, and the model of it. */
async (MemDisk, Map<string, u8[]>, Vec<u8[]>) base(Rng r) {
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  Map<string, u8[]> m = model();
  Vec<u8[]> keys = Vec.create();
  Vec<Change> cs = Vec.create();
  for (i32 i = 0; i < 300; i++) {
    u8[] k = r.bytes(33);
    u8[] v = r.bytes(r.below(400));
    keys.push(k);
    cs.push(Change(k, v));
    m.set(bytesToHex(k), v);
  }
  await s.commit(cs.toArray(), "A0".toBytes());
  // A second commit rewrites half of them, so the pages of the first are free for the commit being cut:
  // its writes land in scattered places as well as at the end.
  Vec<Change> more = Vec.create();
  for (i32 i = 0; i < keys.len(); i += 2) {
    u8[] v = r.bytes(r.below(400));
    more.push(Change(keys.get(i), v));
    m.set(bytesToHex(keys.get(i)), v);
  }
  await s.commit(more.toArray(), "A".toBytes());
  return (md, m, keys);
}

async string run_a_commit_cut_short_anywhere_leaves_one_whole_state() {
  Check t = Check.create();
  i32 cuts = 0;
  i32 sawA = 0;
  i32 sawB = 0;
  bool done = false;
  for (i32 cut = 0; cut < 400 && !done; cut++) {
   for (i32 mask = 0; mask < 8 && !done; mask++) {
    // The same base and the same second commit each time: the cut is the only difference.
    Rng r = Rng(777);
    auto (md, a, keys) = await base(r);
    Map<string, u8[]> b = model();
    for (i32 i = 0; i < keys.len(); i++) { b.set(bytesToHex(keys.get(i)), a.get(bytesToHex(keys.get(i)))!); }
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < 500; i++) {
      bool del = r.below(4) == 0;
      u8[] k = del ? keys.get(r.below(keys.len())) : r.bytes(33);
      if (!del) { keys.push(k); }
      u8[]? v = del ? null : r.bytes(r.below(3000));
      cs.push(Change(k, v));
      if (v is null) { b.remove(bytesToHex(k)); } else { b.set(bytesToHex(k), v!); }
    }
    Store s = (await Store.open(md.disk())).unwrap();
    md.failAfter = md.writes + cut;
    string e = await s.commit(cs.toArray(), "B".toBytes());
    if (e == "") {
      done = true;
      continue;
    }
    cuts++;
    // Which unsynced writes survive: none, all, and six patterns between.
    md.crash(mask == 0 ? 0 : mask == 1 ? 0xffffffffffffffff : r.next());
    Store after = (await Store.open(md.disk())).unwrap();
    string which = string.fromBytes(after.committed().user);
    if (which == "A") {
      sawA++;
      t.eqStr(await differs(after, a, keys), "", "cut at write \{cut}, mask \{mask}: exactly A");
    } else if (which == "B") {
      sawB++;
      t.eqStr(await differs(after, b, keys), "", "cut at write \{cut}, mask \{mask}: exactly B");
    } else {
      t.fail("cut at write \{cut}, mask \{mask}: neither A nor B but '\{which}'");
    }
   }
  }
  t.ok(cuts >= 16 && sawA > 0 && sawB > 0, "cut \{cuts} ways, coming back as A \{sawA} times and as B \{sawB}");
  return t.report();
}

export string test_the_store_agrees_with_a_map_across_commits_and_reopening() {
  return run_the_store_agrees_with_a_map_across_commits_and_reopening(LEAVES, CACHE_MB * 1024 * 1024).wait().orElse("it never finished");
}

/**
 * A leaf read, then written (so queued twice to be let go), let go, and read again by the next commit: the
 * older entry for it, let go as the new copy was queued, once detached that copy, and the commit to it was
 * lost from the file. One leaf kept and no cache, so every step is the store's own.
 */
async string run_a_leaf_read_again_by_a_commit_is_not_lost() {
  Check t = Check.create();
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  s.cache = EntryCache.create(0);
  Vec<Change> cs = Vec.create();
  for (i32 i = 0; i < 3000; i++) { cs.push(Change(key(i), u8[].filled(100, 1))); }
  t.eqStr(await s.commit(cs.toArray(), u8[].filled(0, 0)), "", "a tree of several leaves");
  s = (await Store.open(md.disk())).unwrap();
  s.cache = EntryCache.create(0);
  s.maxLeaves = 1;
  await s.get(key(5));
  t.eqStr(await s.commit([Change(key(5), u8[].filled(100, 2))], u8[].filled(0, 0)), "", "a write to the leaf read");
  t.eqStr(await s.commit([Change(key(6), u8[].filled(100, 3))], u8[].filled(0, 0)), "", "and another, the leaf read again");
  Store again = (await Store.open(md.disk())).unwrap();
  u8[]? five = await again.get(key(5));
  u8[]? six = await again.get(key(6));
  t.ok(five is not null && five![0] == 2, "the first write is in the file");
  t.ok(six is not null && six![0] == 3, "and the second");
  return t.report();
}

u8[] key(i32 i) { return [7 as u8, ((i >> 8) & 255) as! u8, (i & 255) as! u8]; }

export string test_a_leaf_read_again_by_a_commit_is_not_lost() { return run_a_leaf_read_again_by_a_commit_is_not_lost().wait().orElse("it never finished"); }

export string test_a_tall_tree_with_big_keys() { return run_a_tall_tree_with_big_keys().wait().orElse("it never finished"); }

export string test_a_commit_cut_short_anywhere_leaves_one_whole_state() { return run_a_commit_cut_short_anywhere_leaves_one_whole_state().wait().orElse("it never finished"); }

async string run_rewriting_the_same_keys_does_not_grow_the_file() {
  Check t = Check.create();
  Rng r = Rng(4242);
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  Vec<u8[]> keys = Vec.create();
  for (i32 i = 0; i < 2000; i++) { keys.push(r.bytes(33)); }
  i64 at10 = 0;
  for (i32 round = 0; round < 60; round++) {
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < keys.len(); i++) { cs.push(Change(keys.get(i), r.bytes(r.below(100)))); }
    t.eqStr(await s.commit(cs.toArray(), u8[].filled(0, 0)), "", "commit \{round}");
    if (round == 10) { at10 = s.pages; }
  }
  t.ok(s.pages <= at10 + 4, "the file stays the size it reached: \{at10} pages at commit 10, \{s.pages} at 60");
  return t.report();
}

export string test_rewriting_the_same_keys_does_not_grow_the_file() { return run_rewriting_the_same_keys_does_not_grow_the_file().wait().orElse("it never finished"); }

async bool committed(Store s, Change[] ch) { return (await s.commit(ch, u8[].filled(0, 0))) == ""; }

/** Writes held back until `open`: a test can stop a commit at its first write and look at the store meanwhile. */
struct Gate {
  bool closed;
  bool waiting;
  Vec<Ticket<bool>> held;

  Ticket<bool> wait(this) {
    Ticket<bool> t;
    this.held.push(t);
    this.waiting = true;
    return t;
  }

  void open(this) {
    this.closed = false;
    while (this.held.len() > 0) { this.held.remove(0).resolve(true); }
  }
}

Disk gated(MemDisk m, Gate g) {
  Disk d = m.disk();
  return Disk(d.read, d.readNow, async (i64 at, u8[] b) => {
    if (g.closed) { await g.wait(); }
    return await d.write(at, b);
  }, d.sync, d.size);
}

/**
 * A leaf a commit has rewritten — clean, with its new page — let go by a read while the commit waits on the disk,
 * and read back before its page is written: from a page that does not hold it yet. The store keeps one leaf; the
 * commit is held at its first write while a read of another leaf loads it (letting the rewritten one go, as it
 * did), and a read of the rewritten key then reads it again. Since old blocks are answered from the store, the
 * node reads during commits, and this broke the snap e2e's import after a moved pivot.
 */
export async string test_a_leaf_a_commit_rewrote_is_not_let_go_before_its_page_is_written(Sys sys) {
  Check t = Check.create();
  MemDisk md = MemDisk.create();
  Gate g = Gate(false, false, Vec.create());
  Store s = (await Store.open(gated(md, g))).unwrap();
  Vec<Change> cs = Vec.create();
  for (i32 i = 0; i < 3000; i++) { cs.push(Change(key(i), u8[].filled(100, 1))); }
  t.ok(await committed(s, cs.toArray()), "a tree of several leaves");
  s = (await Store.open(gated(md, g))).unwrap();
  s.cache = EntryCache.create(0);
  s.maxLeaves = 1;
  s.getNow(key(10));
  g.closed = true;
  Ticket<bool> c = committed(s, [Change(key(10), u8[].filled(100, 2))]);
  for (i32 i = 0; i < 100 && !g.waiting; i++) { await sys.sleepMillis(0); }
  t.ok(g.waiting, "the commit is waiting on its first write");
  s.getNow(key(2900));
  u8[]? during = s.getNow(key(10));
  t.ok(during is not null && (during![0] == 1 || during![0] == 2), "a read during the commit finds the key, old or new");
  g.open();
  t.ok(await c, "the commit finishes");
  u8[]? after = s.getNow(key(10));
  t.ok(after is not null && after![0] == 2, "and the store then reads what it wrote");
  u8[]? reopened = await (await Store.open(md.disk())).unwrap().get(key(10));
  t.ok(reopened is not null && reopened![0] == 2, "as does the file, opened again");
  return t.report();
}

/** A store of the format before 16 KB pages is refused, not taken for an empty one and written over. */
async string run_a_store_of_64_kb_pages_is_refused() {
  MemDisk md = MemDisk.create();
  Disk d = md.disk();
  // The old magic, as its meta began: "WACUMUDB", little-endian.
  await d.write(0, "WACUMUDB".toBytes());
  await d.sync();
  match (await Store.open(d)) {
    Ok(s): { return "opened as a store"; }
    Err(why): { return why.indexOf("64 KB pages") >= 0 ? "" : "refused, but saying: \{why}"; }
  }
}

export string test_a_store_of_64_kb_pages_is_refused() { return run_a_store_of_64_kb_pages_is_refused().wait().orElse("it never finished"); }

/** The map's entries in `[from, to)`, as hex keys in order, for comparing with a range read. */
string modelRange(Map<string, u8[]> m, Vec<u8[]> keys, u8[] from, u8[] to) {
  Vec<Change> in = Vec.create();
  Map<string, bool> seen = Map.create(hashString, stringEq);
  for (i32 i = 0; i < keys.len(); i++) {
    u8[] k = keys.get(i);
    string h = bytesToHex(k);
    if (seen.has(h) || !m.has(h)) { continue; }
    seen.set(h, true);
    if (compareKeys(k, from) < 0 || compareKeys(k, to) >= 0) { continue; }
    in.push(Change(k, m.get(h)!));
  }
  // In key order, by selection: small.
  string out = "";
  while (in.len() > 0) {
    i32 best = 0;
    for (i32 i = 1; i < in.len(); i++) {
      if (compareKeys(in.get(i).key, in.get(best).key) < 0) { best = i; }
    }
    out += bytesToHex(in.get(best).key) + ";";
    in.remove(best);
  }
  return out;
}

string rangeText(Vec<Change> got) {
  string out = "";
  for (i32 i = 0; i < got.len(); i++) { out += bytesToHex(got.get(i).key) + ";"; }
  return out;
}

/**
 * Commits staged and flushed in batches: what the store reads — keys and ranges, before and after each flush — is
 * a map's, and the file opened again holds exactly what was last flushed, whatever was staged after it.
 */
async string run_staged_commits_read_as_committed_and_a_crash_loses_only_what_is_staged() {
  Check t = Check.create();
  Rng r = Rng(4242);
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  s.maxLeaves = 2;
  Map<string, u8[]> m = model();
  Map<string, u8[]> flushedModel = model();
  Vec<u8[]> keys = Vec.create();
  for (i32 round = 0; round < 40; round++) {
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < 60; i++) {
      bool del = keys.len() > 0 && r.below(10) < 3;
      u8[] k = del ? keys.get(r.below(keys.len())) : r.bytes(1 + r.below(6));
      if (!del) { keys.push(k); }
      u8[]? v = del ? null : r.bytes(1 + r.below(80));
      cs.push(Change(k, v));
      if (v is null) { m.remove(bytesToHex(k)); } else { m.set(bytesToHex(k), v!); }
    }
    await s.stage(cs.toArray(), "round \{round}".toBytes());
    t.eqStr(await differs(s, m, keys), "", "staged round \{round}: reads as committed");
    u8[] from = r.bytes(1);
    u8[] to = r.bytes(1);
    if (compareKeys(from, to) > 0) {
      u8[] x = from;
      from = to;
      to = x;
    }
    t.eqStr(rangeText(await s.range(from, to, 0x7fffffff)), modelRange(m, keys, from, to), "staged round \{round}: a range");
    t.eqStr(rangeText(s.rangeNow(from, to, 0x7fffffff)), modelRange(m, keys, from, to), "staged round \{round}: a range read where asked");
    if (round % 5 == 4) {
      t.eqStr(await s.flush(), "", "flush after round \{round}");
      flushedModel = model();
      for (i32 i = 0; i < keys.len(); i++) {
        string h = bytesToHex(keys.get(i));
        if (m.has(h)) { flushedModel.set(h, m.get(h)!); }
      }
      t.eqStr(string.fromBytes(s.committed().user), "round \{round}", "the flush records the last staged bytes");
    }
    // A crash here: the file holds the last flush, not what is staged since.
    Store again = (await Store.open(md.disk())).unwrap();
    t.eqStr(await differs(again, flushedModel, keys), "", "reopened after round \{round}: exactly the last flush");
  }
  return t.report();
}

export string test_staged_commits_read_as_committed_and_a_crash_loses_only_what_is_staged() {
  return run_staged_commits_read_as_committed_and_a_crash_loses_only_what_is_staged().wait().orElse("it never finished");
}

/** A key of 200 bytes, so an interior node holds few and the tree has several under its root. */
u8[] wide(i32 i) {
  u8[] k = u8[].filled(200, 9);
  k[0] = 7;
  k[1] = ((i >> 8) & 255) as! u8;
  k[2] = (i & 255) as! u8;
  return k;
}

// Undo records pruned in the soak: the prune's range reads cold leaves, which queues each with its parent to be let
// go later, and then deletes every key under them, which empties those parents and takes them out of the tree. Letting
// go read a kid of a parent with none left, and trapped, ~400 blocks after pruning began.
async string run_a_parent_emptied_after_its_leaves_were_read_is_let_go() {
  Check t = Check.create();
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  s.cache = EntryCache.create(0);
  Vec<Change> cs = Vec.create();
  for (i32 i = 0; i < 3000; i++) { cs.push(Change(wide(i), u8[].filled(2000, 1))); }
  t.eqStr(await s.commit(cs.toArray(), u8[].filled(0, 0)), "", "a tree with interior nodes under its root");
  s = (await Store.open(md.disk())).unwrap();
  s.cache = EntryCache.create(0);
  s.maxLeaves = 100000;
  Vec<Change> front = await s.range(wide(0), wide(1200), 0x7fffffff);
  t.ok(front.len() == 1200, "the front read as a range, every leaf under it loaded and queued: \{front.len()}");
  Change[] gone = Change[].filled(front.len(), Change(u8[].filled(0, 0), null));
  for (i32 i = 0; i < front.len(); i++) { gone[i] = Change(front.get(i).key, null); }
  t.eqStr(await s.commit(gone, u8[].filled(0, 0)), "", "and all of it deleted");
  s.maxLeaves = 1;
  for (i32 i = 1200; i < 3000; i += 50) { await s.get(wide(i)); }
  t.eqStr(await s.commit([Change(wide(2000), u8[].filled(2000, 2))], u8[].filled(0, 0)), "", "a commit after, letting go");
  Store again = (await Store.open(md.disk())).unwrap();
  t.ok((await again.get(wide(5))) is null, "the front is gone");
  u8[]? kept = await again.get(wide(2000));
  t.ok(kept is not null && kept![0] == 2, "and the rest is there");
  return t.report();
}

export string test_a_parent_emptied_after_its_leaves_were_read_is_let_go() {
  return run_a_parent_emptied_after_its_leaves_were_read_is_let_go().wait().orElse("it never finished");
}
