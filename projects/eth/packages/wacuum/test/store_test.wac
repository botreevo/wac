// The store against a map: random puts and deletes over many commits, reopened from the disk after each;
// a tree tall enough to have interior nodes under interior nodes; and a commit cut short at every write
// it makes, with any subset of what was not yet synced lost, which must reopen as the commit before or the
// commit itself, never anything between. The disk is in memory and never waits, so each test drives its
// async body to the end with `wait`, and needs no grant.

import { Map, Vec } from "core";
import { hashString, stringEq } from "core";
import { bytesToHex } from "../src/hex.wac";
import { Store, Change, compareKeys } from "../src/store/tree.wac";
import { MemDisk } from "../src/store/disk.wac";
import { Check } from "./check.wac";

struct Rng {
  u64 x;

  u64 next(this) {
    this.x = this.x ^ (this.x << 13);
    this.x = this.x ^ (this.x >> 7);
    this.x = this.x ^ (this.x << 17);
    return this.x;
  }
  i32 below(this, i32 n) { return (this.next() % ((n as@ u32) as u64)) as! i32; }
  u8[] bytes(this, i32 n) {
    u8[] b = u8[].filled(n, 0);
    for (i32 i = 0; i < n; i++) { b[i] = (this.next() & 255) as! u8; }
    return b;
  }
}

/** The model: hex of the key to the value. */
Map<string, u8[]> model() { return Map.create(hashString, stringEq); }

/** Whether the store holds exactly the model, every key looked up and every absent key from `gone` too. */
async string differs(Store s, Map<string, u8[]> m, Vec<u8[]> keys) {
  for (i32 i = 0; i < keys.len(); i++) {
    u8[] k = keys.get(i);
    u8[]? want = m.get(bytesToHex(k));
    u8[]? got = await s.get(k);
    if (want is null && got is not null) { return "key \{bytesToHex(k)} should be absent"; }
    if (want is not null && got is null) { return "key \{bytesToHex(k)} is missing"; }
    if (want is not null && bytesToHex(want!) != bytesToHex(got!)) { return "key \{bytesToHex(k)} has the wrong value"; }
  }
  return "";
}

async string run_the_store_agrees_with_a_map_across_commits_and_reopening() {
  Check t = Check.create();
  Rng r = Rng(0x9e3779b97f4a7c15);
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  Map<string, u8[]> m = model();
  Vec<u8[]> keys = Vec.create();
  for (i32 round = 0; round < 25; round++) {
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < 400; i++) {
      bool del = keys.len() > 0 && r.below(10) < 3;
      u8[] k = del ? keys.get(r.below(keys.len())) : r.bytes(1 + r.below(40));
      if (!del) { keys.push(k); }
      u8[]? v = del ? null : r.bytes(r.below(50) == 0 ? 20000 : r.below(120));
      cs.push(Change(k, v));
      if (v is null) { m.remove(bytesToHex(k)); } else { m.set(bytesToHex(k), v!); }
    }
    string e = await s.commit(cs.toArray(), "round \{round}".toBytes());
    t.eqStr(e, "", "commit \{round}");
    t.eqStr(await differs(s, m, keys), "", "after commit \{round}");
    Store again = (await Store.open(md.disk())).unwrap();
    t.eqStr(await differs(again, m, keys), "", "reopened after commit \{round}");
    t.eqStr(string.fromBytes(again.committed().user), "round \{round}", "its own bytes after commit \{round}");
    // Carry on with the reopened one half the time, so both paths keep being exercised.
    if (round % 2 == 1) { s = again; }
  }
  t.ok(s.height >= 2, "a tree of more than one level: \{s.height}");

  // Everything deleted: the tree empties and still reopens.
  Vec<Change> all = Vec.create();
  for (i32 i = 0; i < keys.len(); i++) {
    all.push(Change(keys.get(i), null));
    m.remove(bytesToHex(keys.get(i)));
  }
  t.eqStr(await s.commit(all.toArray(), u8[].filled(0, 0)), "", "deleting everything");
  t.eqStr(await differs((await Store.open(md.disk())).unwrap(), m, keys), "", "empty after reopening");
  return t.report();
}

async string run_a_tall_tree_with_big_keys() {
  Check t = Check.create();
  Rng r = Rng(12345);
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  Map<string, u8[]> m = model();
  Vec<u8[]> keys = Vec.create();
  // 1000-byte keys and 20 KB values: three entries a leaf, sixty-odd children an interior node.
  for (i32 round = 0; round < 6; round++) {
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < 60; i++) {
      u8[] k = r.bytes(1000);
      u8[] v = r.bytes(20000);
      keys.push(k);
      cs.push(Change(k, v));
      m.set(bytesToHex(k), v);
    }
    t.eqStr(await s.commit(cs.toArray(), u8[].filled(0, 0)), "", "commit \{round}");
  }
  t.ok(s.height >= 3, "interior under interior: height \{s.height}");
  t.eqStr(await differs((await Store.open(md.disk())).unwrap(), m, keys), "", "reopened");

  // A range, in order, from the middle.
  Vec<u8[]> sorted = Vec.create();
  for (i32 i = 0; i < keys.len(); i++) { sorted.push(keys.get(i)); }
  sorted.sort((u8[] a, u8[] b) => compareKeys(a, b));
  Vec<Change> got = await s.range(sorted.get(100), sorted.get(150), 1000);
  t.ok(got.len() == 50, "fifty keys in the range: \{got.len()}");
  bool inOrder = true;
  for (i32 i = 0; i < got.len(); i++) { inOrder = inOrder && compareKeys(got.get(i).key, sorted.get(100 + i)) == 0; }
  t.ok(inOrder, "in order");
  return t.report();
}

/** A store with two commits of 300 keys, on a fresh disk, and the model of it. */
async (MemDisk, Map<string, u8[]>, Vec<u8[]>) base(Rng r) {
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  Map<string, u8[]> m = model();
  Vec<u8[]> keys = Vec.create();
  Vec<Change> cs = Vec.create();
  for (i32 i = 0; i < 300; i++) {
    u8[] k = r.bytes(33);
    u8[] v = r.bytes(r.below(400));
    keys.push(k);
    cs.push(Change(k, v));
    m.set(bytesToHex(k), v);
  }
  await s.commit(cs.toArray(), "A0".toBytes());
  // A second commit rewrites half of them, so the pages of the first are free for the commit being cut:
  // its writes land in scattered places as well as at the end.
  Vec<Change> more = Vec.create();
  for (i32 i = 0; i < keys.len(); i += 2) {
    u8[] v = r.bytes(r.below(400));
    more.push(Change(keys.get(i), v));
    m.set(bytesToHex(keys.get(i)), v);
  }
  await s.commit(more.toArray(), "A".toBytes());
  return (md, m, keys);
}

async string run_a_commit_cut_short_anywhere_leaves_one_whole_state() {
  Check t = Check.create();
  i32 cuts = 0;
  i32 sawA = 0;
  i32 sawB = 0;
  bool done = false;
  for (i32 cut = 0; cut < 400 && !done; cut++) {
   for (i32 mask = 0; mask < 8 && !done; mask++) {
    // The same base and the same second commit each time: the cut is the only difference.
    Rng r = Rng(777);
    auto (md, a, keys) = await base(r);
    Map<string, u8[]> b = model();
    for (i32 i = 0; i < keys.len(); i++) { b.set(bytesToHex(keys.get(i)), a.get(bytesToHex(keys.get(i)))!); }
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < 500; i++) {
      bool del = r.below(4) == 0;
      u8[] k = del ? keys.get(r.below(keys.len())) : r.bytes(33);
      if (!del) { keys.push(k); }
      u8[]? v = del ? null : r.bytes(r.below(3000));
      cs.push(Change(k, v));
      if (v is null) { b.remove(bytesToHex(k)); } else { b.set(bytesToHex(k), v!); }
    }
    Store s = (await Store.open(md.disk())).unwrap();
    md.failAfter = md.writes + cut;
    string e = await s.commit(cs.toArray(), "B".toBytes());
    if (e == "") {
      done = true;
      continue;
    }
    cuts++;
    // Which unsynced writes survive: none, all, and six patterns between.
    md.crash(mask == 0 ? 0 : mask == 1 ? 0xffffffffffffffff : r.next());
    Store after = (await Store.open(md.disk())).unwrap();
    string which = string.fromBytes(after.committed().user);
    if (which == "A") {
      sawA++;
      t.eqStr(await differs(after, a, keys), "", "cut at write \{cut}, mask \{mask}: exactly A");
    } else if (which == "B") {
      sawB++;
      t.eqStr(await differs(after, b, keys), "", "cut at write \{cut}, mask \{mask}: exactly B");
    } else {
      t.fail("cut at write \{cut}, mask \{mask}: neither A nor B but '\{which}'");
    }
   }
  }
  t.ok(cuts >= 16 && sawA > 0 && sawB > 0, "cut \{cuts} ways, coming back as A \{sawA} times and as B \{sawB}");
  return t.report();
}

export string test_the_store_agrees_with_a_map_across_commits_and_reopening() { return run_the_store_agrees_with_a_map_across_commits_and_reopening().wait().orElse("it never finished"); }

export string test_a_tall_tree_with_big_keys() { return run_a_tall_tree_with_big_keys().wait().orElse("it never finished"); }

export string test_a_commit_cut_short_anywhere_leaves_one_whole_state() { return run_a_commit_cut_short_anywhere_leaves_one_whole_state().wait().orElse("it never finished"); }

async string run_rewriting_the_same_keys_does_not_grow_the_file() {
  Check t = Check.create();
  Rng r = Rng(4242);
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  Vec<u8[]> keys = Vec.create();
  for (i32 i = 0; i < 2000; i++) { keys.push(r.bytes(33)); }
  i64 at10 = 0;
  for (i32 round = 0; round < 60; round++) {
    Vec<Change> cs = Vec.create();
    for (i32 i = 0; i < keys.len(); i++) { cs.push(Change(keys.get(i), r.bytes(r.below(100)))); }
    t.eqStr(await s.commit(cs.toArray(), u8[].filled(0, 0)), "", "commit \{round}");
    if (round == 10) { at10 = s.pages; }
  }
  t.ok(s.pages <= at10 + 4, "the file stays the size it reached: \{at10} pages at commit 10, \{s.pages} at 60");
  return t.report();
}

export string test_rewriting_the_same_keys_does_not_grow_the_file() { return run_rewriting_the_same_keys_does_not_grow_the_file().wait().orElse("it never finished"); }
