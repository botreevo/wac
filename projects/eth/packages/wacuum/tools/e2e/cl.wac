// wacuum driven by a real consensus client: Prysm. A beacon node with all 64 validators (interop keys, imported
// from keystores this writes) has wacuum on a store as its execution client, so every block is built by wacuum
// (forkchoiceUpdated with attributes, getPayload) and imported by it (newPayload) as Prysm drives it, with
// transfers sent to wacuum for its blocks to carry. A second beacon node, peered with the first, drives geth: geth
// imports each block wacuum built and judges it independently. Checked: the chain grows, geth has wacuum's blocks
// (the same hash at the same height), wacuum killed and started again goes on proposing and importing, and the
// chain finalizes, the finalized block the same in both.
//
//     wac run --allow-read --allow-write --allow-net --allow-run tools/e2e/cl.wac -- GETH PRYSM_BIN_DIR
//
// PRYSM_BIN_DIR holds beacon-chain, validator and prysmctl (Prysm 7: `go build ./cmd/...` in its repository; the
// module proxy's copy lacks `third_party/`). The chain is the mainnet preset with 2 s slots, every fork through
// Fulu (Osaka) at genesis, chain id 1337.

import { Sys } from "std";
import { json.JsonValue } from "wac";
import { bytesToHex } from "../../src/hex.wac";
import { Check, Proc, Rpc, shell, tempDir, removeDir, somePort, addressOf, field, quantity } from "./kit.wac";
import { prepare, gethNode, beaconNode, validatorNode, wacuumNode, peerAddress, beacon, hashAt, growTo, decimal, blobBlock } from "./clkit.wac";
import { U256 } from "../../src/u256.wac";

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() < 2) {
    sys.warn("usage: cl.wac GETH PRYSM_BIN_DIR");
    return 2;
  }
  string geth = args[0];
  string bin = args[1];
  Check t = Check.on(sys);
  string dir = await tempDir(sys, "wacuum-cl");
  string app = dir + "/wacuum-bin";
  await shell(sys, "wac app --allow-read --allow-write --allow-net cmd/wacuum.wac -o \{app} > /dev/null 2>&1");
  u8[] key = u8[].filled(32, 0x11);
  string me = addressOf(key);
  u8[] secret = (await sys.random().bytes(32)).ok()!;
  await sys.writeFile(dir + "/jwt.hex", bytesToHex(secret).toBytes());
  // The genesis, 45 s from now, and the validators' wallet.
  string ready = await prepare(sys, dir, bin, me, 45);
  t.that(ready == "", "prysmctl makes the genesis, and the validator imports the interop keys \{ready}");

  // The execution clients, then the beacon nodes, then the validator.
  i32 wacPort = await somePort(sys, 21551, 400);
  Proc w = await wacuumNode(sys, app, dir, "wacuum", wacPort, []);
  Rpc wac = Rpc.at(sys, wacPort);
  i32 gethBase = await somePort(sys, 22551, 400);
  Proc g = await gethNode(sys, geth, dir, gethBase);
  Rpc gr = Rpc.at(sys, gethBase + 2);
  t.that(field(await wac.get("eth_getBlockByNumber", "[\"0x0\",false]"), "hash") == field(await gr.get("eth_getBlockByNumber", "[\"0x0\",false]"), "hash"),
         "wacuum and geth start from the same genesis block");
  i32 aBase = await somePort(sys, 23551, 400);
  Proc a = await beaconNode(sys, bin, dir, "beacon-a", aBase, wacPort, []);
  string peer = await peerAddress(sys, a);
  t.that(peer != "", "beacon A is up: \{peer}");
  i32 bBase = await somePort(sys, 24551, 400);
  Proc b = await beaconNode(sys, bin, dir, "beacon-b", bBase, gethBase + 1, ["--peer", peer]);
  Proc v = await validatorNode(sys, bin, dir, aBase, aBase + 7);

  // The chain grows on wacuum's blocks, with transfers in them, and geth has them.
  u64[] nonce = [0];
  bool grew = await growTo(sys, wac, wac, 20, 240000, key, nonce);
  t.that(grew, "wacuum's chain reaches block 20 under Prysm: at \{quantity(await wac.text("eth_blockNumber", "[]"))}");
  u64 txs = quantity(await wac.text("eth_getTransactionCount", "[\"\{me}\",\"latest\"]"));
  t.that(txs > 0, "with transfers in its blocks: \{txs} included");
  await sys.sleepMillis(4000);
  string ours = await hashAt(wac, 20);
  string theirs = await hashAt(gr, 20);
  t.that(ours != "" && ours == theirs, "geth, under its own beacon node, has wacuum's block 20: \{ours} \{theirs}");

  // Killed and started again: it goes on, building and importing.
  u64 before = quantity(await wac.text("eth_blockNumber", "[]"));
  await shell(sys, "kill -9 \{w.pid}; while kill -0 \{w.pid} 2>/dev/null; do sleep 0.05; done");
  w = await wacuumNode(sys, app, dir, "wacuum", wacPort, []);
  bool again = await growTo(sys, wac, wac, before + 10, 180000, key, nonce);
  t.that(again, "killed at block \{before} and started again, wacuum goes on: at \{quantity(await wac.text("eth_blockNumber", "[]"))}");

  // Blobs: blob transactions sent to wacuum go into a block it builds — the blobs and cell proofs in its getPayload,
  // which Prysm publishes as data columns — and geth, under its own beacon node, takes the block.
  u64 bb = await blobBlock(sys, wac, wac, 90000);
  t.that(bb > 0, "blob transactions go into a block wacuum builds: block \{bb}");
  await sys.sleepMillis(4000);
  JsonValue? wb = await wac.get("eth_getBlockByNumber", "[\"\{U256.ofU64(bb).toHex()}\",false]");
  JsonValue? gbk = await gr.get("eth_getBlockByNumber", "[\"\{U256.ofU64(bb).toHex()}\",false]");
  t.that(field(wb, "hash") == field(gbk, "hash") && field(wb, "blobGasUsed") == field(gbk, "blobGasUsed"),
         "and geth has it, the same blob gas: \{field(wb, "blobGasUsed")} \{field(wb, "hash")}");

  // Finality: Prysm finalizes an epoch, and both execution clients have the same finalized block.
  u64 fin = 0;
  for (i32 i = 0; i < 240 && fin < 2; i++) {
    JsonValue? cp = await beacon(sys, aBase + 1, "/eth/v1/beacon/states/head/finality_checkpoints");
    fin = decimal(cp?.member("data")?.member("finalized")?.member("epoch")?.text() ?? "0");
    if (fin < 2) { await growTo(sys, wac, wac, 0, 2000, key, nonce); await sys.sleepMillis(2000); }
  }
  t.that(fin >= 2, "the chain finalizes: epoch \{fin}");
  string wf = field(await wac.get("eth_getBlockByNumber", "[\"finalized\",false]"), "hash");
  string gf = field(await gr.get("eth_getBlockByNumber", "[\"finalized\",false]"), "hash");
  t.that(wf != "" && wf == gf, "the same finalized block in wacuum and geth: \{wf} \{gf}");
  u64 head = quantity(await wac.text("eth_blockNumber", "[]"));
  string wh = await hashAt(wac, head - 1);
  string gh = await hashAt(gr, head - 1);
  t.that(wh == gh, "and the same chain to near the head: block \{head - 1} \{wh}");
  JsonValue? hdr = await beacon(sys, aBase + 1, "/eth/v1/beacon/headers/head");
  u64 slot = decimal(hdr?.member("data")?.member("header")?.member("message")?.member("slot")?.text() ?? "0");
  sys.log("  \{head} blocks in \{slot} slots; \{nonce[0]} transfers sent");

  await v.stop(sys);
  await b.stop(sys);
  await a.stop(sys);
  await g.stop(sys);
  await w.stop(sys);
  await removeDir(sys, dir);
  return t.done();
}
