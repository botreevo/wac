// wacuum driven by a real consensus client: Prysm. A beacon node with all 64 validators (interop keys, imported
// from keystores this writes) has wacuum on a store as its execution client, so every block is built by wacuum
// (forkchoiceUpdated with attributes, getPayload) and imported by it (newPayload) as Prysm drives it, with
// transfers sent to wacuum for its blocks to carry. A second beacon node, peered with the first, drives geth: geth
// imports each block wacuum built and judges it independently. Checked: the chain grows, geth has wacuum's blocks
// (the same hash at the same height), wacuum killed and started again goes on proposing and importing, and the
// chain finalizes, the finalized block the same in both.
//
//     wac run --allow-read --allow-write --allow-net --allow-run tools/e2e/cl.wac -- GETH PRYSM_BIN_DIR
//
// PRYSM_BIN_DIR holds beacon-chain, validator and prysmctl (Prysm 7: `go build ./cmd/...` in its repository; the
// module proxy's copy lacks `third_party/`). The chain is the mainnet preset with 2 s slots, every fork through
// Fulu (Osaka) at genesis, chain id 1337.

import { Sys } from "std";
import { Vec } from "core";
import { json.JsonValue, json.parse } from "wac";
import { U256 } from "../../src/u256.wac";
import { bytesToHex } from "../../src/hex.wac";
import { systemContracts } from "../../src/chain/dev.wac";
import { Check, Proc, Rpc, shell, quote, tempDir, removeDir, somePort, addressOf, type2, field, quantity, trim, ZERO } from "./kit.wac";
import { writeKeystores } from "./keystores.wac";

static i32 VALIDATORS = 64;

string config() {
  return "CONFIG_NAME: 'wacuum-devnet'\nPRESET_BASE: 'mainnet'\nTERMINAL_TOTAL_DIFFICULTY: 0\n" +
         "MIN_GENESIS_ACTIVE_VALIDATOR_COUNT: \{VALIDATORS}\nMIN_GENESIS_TIME: 0\nGENESIS_DELAY: 0\n" +
         "GENESIS_FORK_VERSION: 0x20000089\nALTAIR_FORK_VERSION: 0x20000090\nALTAIR_FORK_EPOCH: 0\n" +
         "BELLATRIX_FORK_VERSION: 0x20000091\nBELLATRIX_FORK_EPOCH: 0\nCAPELLA_FORK_VERSION: 0x20000092\nCAPELLA_FORK_EPOCH: 0\n" +
         "DENEB_FORK_VERSION: 0x20000093\nDENEB_FORK_EPOCH: 0\nELECTRA_FORK_VERSION: 0x20000094\nELECTRA_FORK_EPOCH: 0\n" +
         "FULU_FORK_VERSION: 0x20000095\nFULU_FORK_EPOCH: 0\nGLOAS_FORK_VERSION: 0x20000096\nGLOAS_FORK_EPOCH: 18446744073709551615\n" +
         "SECONDS_PER_SLOT: 2\nSLOT_DURATION_MS: 2000\nSECONDS_PER_ETH1_BLOCK: 2\nETH1_FOLLOW_DISTANCE: 1\n" +
         "DEPOSIT_CHAIN_ID: 1337\nDEPOSIT_NETWORK_ID: 1337\nDEPOSIT_CONTRACT_ADDRESS: 0x4242424242424242424242424242424242424242\n" +
         "BLOB_SCHEDULE:\n  - EPOCH: 0\n    MAX_BLOBS_PER_BLOCK: 9\n";
}

/**
 * The execution genesis prysmctl starts from: it sets the timestamp and the time-based forks, and hashes the genesis
 * block with geth's own code for the beacon state — so every block-numbered fork must be here, and the blob schedule
 * (without London, that code leaves the base fee out of the header, and the hash is not the one either client makes).
 */
string elGenesis(string funded) {
  return "{\"config\":{\"chainId\":1337,\"homesteadBlock\":0,\"eip150Block\":0,\"eip155Block\":0,\"eip158Block\":0,\"byzantiumBlock\":0," +
         "\"constantinopleBlock\":0,\"petersburgBlock\":0,\"istanbulBlock\":0,\"berlinBlock\":0,\"londonBlock\":0,\"mergeNetsplitBlock\":0," +
         "\"terminalTotalDifficulty\":0,\"shanghaiTime\":0,\"cancunTime\":0,\"pragueTime\":0,\"osakaTime\":0," +
         "\"blobSchedule\":{\"cancun\":{\"target\":3,\"max\":6,\"baseFeeUpdateFraction\":3338477}," +
         "\"prague\":{\"target\":6,\"max\":9,\"baseFeeUpdateFraction\":5007716},\"osaka\":{\"target\":6,\"max\":9,\"baseFeeUpdateFraction\":5007716}}}," +
         "\"difficulty\":\"0x0\",\"nonce\":\"0x0\"," +
         "\"mixHash\":\"\{ZERO}\",\"parentHash\":\"\{ZERO}\",\"coinbase\":\"0x0000000000000000000000000000000000000000\",\"extraData\":\"0x\"," +
         "\"excessBlobGas\":\"0x0\",\"blobGasUsed\":\"0x0\",\"gasLimit\":\"0x2faf080\",\"baseFeePerGas\":\"0x3b9aca00\",\"timestamp\":\"0x0\"," +
         "\"alloc\":{\"\{funded}\":{\"balance\":\"0xd3c21bcecceda1000000\"}," + systemContracts() + "}}";
}

/** A beacon node's REST answer at `path`, or null. */
async JsonValue? beacon(Sys sys, i32 port, string path) {
  string out = await shell(sys, "curl -s --max-time 5 http://127.0.0.1:\{port}\{path}");
  return parse(out.toBytes()).ok();
}

async Proc beaconNode(Sys sys, string bin, string dir, string name, i32 base, i32 elPort, string peer) {
  string[] argv = [bin + "/beacon-chain", "--datadir", dir + "/" + name, "--force-clear-db", "--accept-terms-of-use",
                   "--genesis-state", dir + "/genesis.ssz", "--chain-config-file", dir + "/config.yml", "--chain-id", "1337",
                   "--execution-endpoint", "http://127.0.0.1:\{elPort}", "--jwt-secret", dir + "/jwt.hex",
                   "--min-sync-peers", "0", "--no-discovery", "--minimum-peers-per-subnet", "0", "--contract-deployment-block", "0",
                   "--rpc-port", "\{base}", "--http-port", "\{base + 1}", "--p2p-tcp-port", "\{base + 2}", "--p2p-udp-port", "\{base + 3}",
                   "--p2p-quic-port", "\{base + 4}", "--monitoring-port", "\{base + 5}", "--p2p-local-ip", "127.0.0.1",
                   "--suggested-fee-recipient", "0x00000000000000000000000000000000000000fe", "--supernode"];
  if (peer != "") {
    Vec<string> all = Vec.create();
    for (i32 i = 0; i < argv.len(); i++) { all.push(argv[i]); }
    all.push("--peer");
    all.push(peer);
    argv = all.toArray();
  }
  return await Proc.start(sys, argv, dir + "/" + name + ".log");
}

async Proc wacuumNode(Sys sys, string app, string dir, i32 port) {
  Proc p = await Proc.start(sys, [app, "--genesis", dir + "/el.json", "--jwt-secret", dir + "/jwt.hex", "--datadir", dir + "/wacuum",
                                  "--store", "--port", "\{port}", "--public-rpc"], dir + "/wacuum.log");
  await p.says(sys, "Engine API on", 120000);
  return p;
}

/** The block at `number` on an execution client, as its hash, or "". */
async string hashAt(Rpc rpc, u64 number) { return field(await rpc.get("eth_getBlockByNumber", "[\"\{U256.ofU64(number).toHex()}\",false]"), "hash"); }

/** Wait until wacuum's head is at least `n`, sending a transfer every 2 s; false if `millis` pass first. */
async bool growTo(Sys sys, Rpc wac, u64 n, i32 millis, u8[] key, u64[] nonce) {
  for (i32 t = 0; t < millis; t += 2000) {
    if (quantity(await wac.text("eth_blockNumber", "[]")) >= n) { return true; }
    string to = "0x" + bytesToHex(U256.ofU64(0x9000000 + nonce[0]).toBytes()).slice(26, 66);
    string sent = await wac.text("eth_sendRawTransaction", "[\"\{type2(key, 1337, nonce[0], to, U256.ofU64(nonce[0] + 1), u8[].filled(0, 0), 21000)}\"]");
    if (sent != "") { nonce[0] = nonce[0] + 1; }
    await sys.sleepMillis(2000);
  }
  return false;
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() < 2) {
    sys.warn("usage: cl.wac GETH PRYSM_BIN_DIR");
    return 2;
  }
  string geth = args[0];
  string bin = args[1];
  Check t = Check.on(sys);
  string dir = await tempDir(sys, "wacuum-cl");
  string app = dir + "/wacuum-bin";
  await shell(sys, "wac app --allow-read --allow-write --allow-net cmd/wacuum.wac -o \{app} > /dev/null 2>&1");
  u8[] key = u8[].filled(32, 0x11);
  string me = addressOf(key);
  u8[] secret = (await sys.random().bytes(32)).ok()!;
  await sys.writeFile(dir + "/jwt.hex", bytesToHex(secret).toBytes());
  await sys.writeFile(dir + "/config.yml", config().toBytes());
  await sys.writeFile(dir + "/el-in.json", elGenesis(me).toBytes());

  // The genesis: the beacon state and the execution genesis with its fork times, 45 s from now.
  string made = await shell(sys, "cd \{quote(dir)} && \{quote(bin + "/prysmctl")} testnet generate-genesis --fork fulu --num-validators \{VALIDATORS} " +
                                 "--genesis-time-delay 45 --chain-config-file config.yml --geth-genesis-json-in el-in.json --geth-genesis-json-out el.json " +
                                 "--output-ssz genesis.ssz 2>&1 | grep -i fatal");
  t.that(trim(made) == "", "prysmctl makes the genesis \{trim(made)}");

  // The validators' keys, imported into a wallet.
  await sys.files().mkdir(dir + "/keys", true);
  await writeKeystores(sys, dir + "/keys", VALIDATORS, "interop-password");
  await sys.writeFile(dir + "/key.pw", "interop-password".toBytes());
  await sys.writeFile(dir + "/wallet.pw", "wallet-password-123".toBytes());
  string imported = await shell(sys, "\{quote(bin + "/validator")} accounts import --keys-dir \{quote(dir + "/keys")} --wallet-dir \{quote(dir + "/wallet")} " +
                                     "--wallet-password-file \{quote(dir + "/wallet.pw")} --account-password-file \{quote(dir + "/key.pw")} --accept-terms-of-use 2>&1 | grep -c 'Successfully imported'");
  t.that(trim(imported) == "1", "the validator imports \{VALIDATORS} interop keys");

  // The execution clients, then the beacon nodes, then the validator.
  i32 wacPort = await somePort(sys, 21551, 400);
  Proc w = await wacuumNode(sys, app, dir, wacPort);
  Rpc wac = Rpc.at(sys, wacPort);
  i32 gethBase = await somePort(sys, 22551, 400);
  await shell(sys, "\{quote(geth)} --datadir \{quote(dir + "/geth")} init \{quote(dir + "/el.json")} > \{quote(dir + "/geth-init.log")} 2>&1");
  Proc g = await Proc.start(sys, [geth, "--datadir", dir + "/geth", "--networkid", "1337", "--nodiscover", "--port", "\{gethBase}",
                                  "--authrpc.port", "\{gethBase + 1}", "--authrpc.jwtsecret", dir + "/jwt.hex",
                                  "--http", "--http.port", "\{gethBase + 2}", "--http.api", "eth,net", "--syncmode", "full"], dir + "/geth.log");
  Rpc gr = Rpc.at(sys, gethBase + 2);
  for (i32 i = 0; i < 60 && (await gr.text("eth_blockNumber", "[]")) == ""; i++) { await sys.sleepMillis(500); }
  t.that(field(await wac.get("eth_getBlockByNumber", "[\"0x0\",false]"), "hash") == field(await gr.get("eth_getBlockByNumber", "[\"0x0\",false]"), "hash"),
         "wacuum and geth start from the same genesis block");
  i32 aBase = await somePort(sys, 23551, 400);
  Proc a = await beaconNode(sys, bin, dir, "beacon-a", aBase, wacPort, "");
  // Its address for beacon B to dial, from its own log: without discovery it has no ENR, and the identity
  // endpoint answers only an error.
  string peer = "";
  for (i32 i = 0; i < 120 && peer == ""; i++) {
    string said = await a.output(sys);
    i32 at = said.indexOf("/ip4/127.0.0.1/tcp/");
    if (at >= 0) {
      u8[] b = said.toBytes();
      i32 end = at;
      while (end < b.len() && (b[end] == 47 || b[end] == 46 || (b[end] >= 48 && b[end] <= 57) || (b[end] >= 65 && b[end] <= 90) || (b[end] >= 97 && b[end] <= 122))) { end++; }
      if (said.slice(at, end).indexOf("/p2p/") > 0) { peer = said.slice(at, end); }
    }
    if (peer == "") { await sys.sleepMillis(1000); }
  }
  t.that(peer != "", "beacon A is up: \{peer}");
  i32 bBase = await somePort(sys, 24551, 400);
  Proc b = await beaconNode(sys, bin, dir, "beacon-b", bBase, gethBase + 1, peer);
  Proc v = await Proc.start(sys, [bin + "/validator", "--datadir", dir + "/validator", "--accept-terms-of-use", "--force-clear-db",
                                  "--chain-config-file", dir + "/config.yml", "--beacon-rpc-provider", "127.0.0.1:\{aBase}",
                                  "--wallet-dir", dir + "/wallet", "--wallet-password-file", dir + "/wallet.pw", "--monitoring-port", "\{aBase + 7}",
                                  "--suggested-fee-recipient", "0x00000000000000000000000000000000000000fe"], dir + "/validator.log");

  // The chain grows on wacuum's blocks, with transfers in them, and geth has them.
  u64[] nonce = [0];
  bool grew = await growTo(sys, wac, 20, 240000, key, nonce);
  t.that(grew, "wacuum's chain reaches block 20 under Prysm: at \{quantity(await wac.text("eth_blockNumber", "[]"))}");
  u64 txs = quantity(await wac.text("eth_getTransactionCount", "[\"\{me}\",\"latest\"]"));
  t.that(txs > 0, "with transfers in its blocks: \{txs} included");
  await sys.sleepMillis(4000);
  string ours = await hashAt(wac, 20);
  string theirs = await hashAt(gr, 20);
  t.that(ours != "" && ours == theirs, "geth, under its own beacon node, has wacuum's block 20: \{ours} \{theirs}");

  // Killed and started again: it goes on, building and importing.
  await shell(sys, "kill -9 \{w.pid}; while kill -0 \{w.pid} 2>/dev/null; do sleep 0.05; done");
  u64 before = quantity(await gr.text("eth_blockNumber", "[]"));
  w = await wacuumNode(sys, app, dir, wacPort);
  bool again = await growTo(sys, wac, before + 10, 180000, key, nonce);
  t.that(again, "killed at block \{before} and started again, wacuum goes on: at \{quantity(await wac.text("eth_blockNumber", "[]"))}");

  // Finality: Prysm finalizes an epoch, and both execution clients have the same finalized block.
  u64 fin = 0;
  for (i32 i = 0; i < 240 && fin < 2; i++) {
    JsonValue? cp = await beacon(sys, aBase + 1, "/eth/v1/beacon/states/head/finality_checkpoints");
    string e = cp?.member("data")?.member("finalized")?.member("epoch")?.text() ?? "0";
    fin = 0;
    u8[] d = e.toBytes();
    for (i32 k = 0; k < d.len(); k++) { fin = fin * 10 + ((d[k] - 48) as u64); }
    if (fin < 2) {
      await growTo(sys, wac, 0, 2000, key, nonce);
      await sys.sleepMillis(2000);
    }
  }
  t.that(fin >= 2, "the chain finalizes: epoch \{fin}");
  string wf = field(await wac.get("eth_getBlockByNumber", "[\"finalized\",false]"), "hash");
  string gf = field(await gr.get("eth_getBlockByNumber", "[\"finalized\",false]"), "hash");
  t.that(wf != "" && wf == gf, "the same finalized block in wacuum and geth: \{wf} \{gf}");
  u64 head = quantity(await wac.text("eth_blockNumber", "[]"));
  string wh = await hashAt(wac, head - 1);
  string gh = await hashAt(gr, head - 1);
  t.that(wh == gh, "and the same chain to near the head: block \{head - 1} \{wh}");
  JsonValue? hdr = await beacon(sys, aBase + 1, "/eth/v1/beacon/headers/head");
  u64 slot = 0;
  string slotText = hdr?.member("data")?.member("header")?.member("message")?.member("slot")?.text() ?? "0";
  u8[] sd = slotText.toBytes();
  for (i32 k = 0; k < sd.len(); k++) { slot = slot * 10 + ((sd[k] - 48) as u64); }
  sys.log("  \{head} blocks in \{slot} slots; \{nonce[0]} transfers sent");

  await v.stop(sys);
  await b.stop(sys);
  await a.stop(sys);
  await g.stop(sys);
  await w.stop(sys);
  await removeDir(sys, dir);
  return t.done();
}
