// wacuum driven by Lighthouse, the consensus client Hoodi's deploy runs it with: a Lighthouse beacon node and validator
// client with all 64 validators drive wacuum on a store, which builds and imports every block; a Prysm beacon node,
// peered with Lighthouse's, drives geth, which imports what wacuum built — so the chain also crosses two consensus
// clients. Checked as `cl.wac` checks under Prysm: the chain grows with transfers, geth has the same blocks, wacuum
// killed and started again goes on, blob transactions go into a block wacuum builds and geth takes it, and the
// chain finalizes, the same finalized block in both.
//
//     wac run --allow-read --allow-write --allow-net --allow-run tools/e2e/cllh.wac -- GETH PRYSM_BIN_DIR LIGHTHOUSE

import { Sys } from "std";
import { json.JsonValue } from "wac";
import { U256 } from "../../src/u256.wac";
import { bytesToHex } from "../../src/hex.wac";
import { Check, Proc, Rpc, shell, tempDir, removeDir, somePort, addressOf, field, quantity } from "./kit.wac";
import { prepare, prepareLighthouse, gethNode, beaconNode, lighthouseBeacon, lighthouseValidator, wacuumNode, peerAddress, beacon, hashAt,
         growTo, decimal, blobBlock } from "./clkit.wac";

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() < 3) {
    sys.warn("usage: cllh.wac GETH PRYSM_BIN_DIR LIGHTHOUSE");
    return 2;
  }
  string geth = args[0];
  string bin = args[1];
  string lighthouse = args[2];
  Check t = Check.on(sys);
  string dir = await tempDir(sys, "wacuum-cllh");
  string app = dir + "/wacuum-bin";
  await shell(sys, "wac app --allow-read --allow-write --allow-net cmd/wacuum.wac -o \{app} > /dev/null 2>&1");
  u8[] key = u8[].filled(32, 0x11);
  string me = addressOf(key);
  u8[] secret = (await sys.random().bytes(32)).ok()!;
  await sys.writeFile(dir + "/jwt.hex", bytesToHex(secret).toBytes());
  string ready = await prepare(sys, dir, bin, me, 75);
  t.that(ready == "", "prysmctl makes the genesis and the keystores \{ready}");

  // geth under Prysm beacon B first: its spec is Lighthouse's config, and Lighthouse dials it.
  i32 gethBase = await somePort(sys, 22551, 400);
  Proc g = await gethNode(sys, geth, dir, gethBase);
  Rpc gr = Rpc.at(sys, gethBase + 2);
  i32 bBase = await somePort(sys, 24551, 400);
  Proc b = await beaconNode(sys, bin, dir, "beacon-b", bBase, gethBase + 1, []);
  string peer = await peerAddress(sys, b);
  t.that(peer != "", "Prysm beacon B is up: \{peer}");
  string lh = await prepareLighthouse(sys, dir, lighthouse, bBase + 1);
  t.that(lh == "", "Lighthouse takes the chain's config and imports the keystores \{lh}");

  // wacuum under Lighthouse, which has the validators.
  i32 wacPort = await somePort(sys, 21551, 400);
  Proc w = await wacuumNode(sys, app, dir, "wacuum", wacPort, []);
  Rpc wac = Rpc.at(sys, wacPort);
  t.that(field(await wac.get("eth_getBlockByNumber", "[\"0x0\",false]"), "hash") == field(await gr.get("eth_getBlockByNumber", "[\"0x0\",false]"), "hash"),
         "wacuum and geth start from the same genesis block");
  i32 aBase = await somePort(sys, 23551, 400);
  Proc a = await lighthouseBeacon(sys, lighthouse, dir, "lighthouse", aBase, wacPort, ["--libp2p-addresses", peer]);
  Proc v = await lighthouseValidator(sys, lighthouse, dir, aBase + 2);

  u64[] nonce = [0];
  bool grew = await growTo(sys, wac, wac, 20, 300000, key, nonce);
  t.that(grew, "wacuum's chain reaches block 20 under Lighthouse: at \{quantity(await wac.text("eth_blockNumber", "[]"))}");
  u64 txs = quantity(await wac.text("eth_getTransactionCount", "[\"\{me}\",\"latest\"]"));
  t.that(txs > 0, "with transfers in its blocks: \{txs} included");
  await sys.sleepMillis(4000);
  string ours = await hashAt(wac, 20);
  string theirs = await hashAt(gr, 20);
  t.that(ours != "" && ours == theirs, "geth, under Prysm, has wacuum's block 20: \{ours} \{theirs}");

  u64 before = quantity(await wac.text("eth_blockNumber", "[]"));
  await shell(sys, "kill -9 \{w.pid}; while kill -0 \{w.pid} 2>/dev/null; do sleep 0.05; done");
  w = await wacuumNode(sys, app, dir, "wacuum", wacPort, []);
  bool again = await growTo(sys, wac, wac, before + 10, 180000, key, nonce);
  t.that(again, "killed at block \{before} and started again, wacuum goes on: at \{quantity(await wac.text("eth_blockNumber", "[]"))}");

  u64 bb = await blobBlock(sys, wac, wac, 90000);
  t.that(bb > 0, "blob transactions go into a block wacuum builds under Lighthouse: block \{bb}");
  await sys.sleepMillis(4000);
  JsonValue? wb = await wac.get("eth_getBlockByNumber", "[\"\{U256.ofU64(bb).toHex()}\",false]");
  JsonValue? gbk = await gr.get("eth_getBlockByNumber", "[\"\{U256.ofU64(bb).toHex()}\",false]");
  t.that(field(wb, "hash") == field(gbk, "hash") && field(wb, "blobGasUsed") == field(gbk, "blobGasUsed"),
         "and geth has it, the same blob gas: \{field(wb, "blobGasUsed")} \{field(wb, "hash")}");

  u64 fin = 0;
  for (i32 i = 0; i < 240 && fin < 2; i++) {
    JsonValue? cp = await beacon(sys, aBase + 2, "/eth/v1/beacon/states/head/finality_checkpoints");
    fin = decimal(cp?.member("data")?.member("finalized")?.member("epoch")?.text() ?? "0");
    if (fin < 2) { await growTo(sys, wac, wac, 0, 2000, key, nonce); await sys.sleepMillis(2000); }
  }
  t.that(fin >= 2, "the chain finalizes under Lighthouse: epoch \{fin}");
  await sys.sleepMillis(4000);
  string wf = field(await wac.get("eth_getBlockByNumber", "[\"finalized\",false]"), "hash");
  string gf = field(await gr.get("eth_getBlockByNumber", "[\"finalized\",false]"), "hash");
  t.that(wf != "" && wf == gf, "the same finalized block in wacuum and geth: \{wf} \{gf}");
  u64 head = quantity(await wac.text("eth_blockNumber", "[]"));
  t.that((await hashAt(wac, head - 1)) == (await hashAt(gr, head - 1)), "and the same chain to near the head: block \{head - 1}");
  JsonValue? hdr = await beacon(sys, aBase + 2, "/eth/v1/beacon/headers/head");
  u64 slot = decimal(hdr?.member("data")?.member("header")?.member("message")?.member("slot")?.text() ?? "0");
  sys.log("  \{head} blocks in \{slot} slots; \{nonce[0]} transfers sent");

  await v.stop(sys);
  await a.stop(sys);
  await b.stop(sys);
  await g.stop(sys);
  await w.stop(sys);
  if (t.failed == 0) { await removeDir(sys, dir); } else { sys.log("  kept: \{dir}"); }
  return t.done();
}
