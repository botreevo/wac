// The interop validator keys — the ones `prysmctl testnet generate-genesis --num-validators N` puts in a genesis — as
// EIP-2335 keystores, for a validator client to import. Prysm 7's validator no longer takes the keys from a flag
// (`--interop-num-validators` is accepted and ignored), and its own end-to-end tests build a wallet in Go; this
// writes the keystores instead, so `validator accounts import` can.
//
// Key i is sha256 of i as 32 little-endian bytes, read little-endian, modulo the BLS group order (the interop
// spec, and Prysm's `DeterministicallyGenerateKeys`). Each keystore is encrypted with PBKDF2-HMAC-SHA256 (a low
// count: these keys guard a test network) and AES-128-CTR, the checksum sha256 of the derived key's second half
// and the cipher text.

import { Sys } from "std";
import { crypto.sha256, crypto.hmacSha256, crypto.aesCtr, bls.g1Mul, bls.g1Generator, bls.g1Compress } from "wac";
import { U256 } from "../../src/u256.wac";
import { bytesToHex } from "../../src/hex.wac";

/** The BLS12-381 group order. */
U256 order() { return U256.fromHex("0x73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001")!; }

/** Interop secret key `i`, 32 bytes big-endian. */
export u8[] interopSecret(i32 i) {
  u8[] le = u8[].filled(32, 0);
  for (i32 k = 0; k < 4; k++) { le[k] = ((i >> (8 * k)) & 255) as! u8; }
  u8[] h = sha256(le);
  u8[] be = u8[].filled(32, 0);
  for (i32 k = 0; k < 32; k++) { be[k] = h[31 - k]; }
  U256 v = U256.fromBytes(be, 0, 32);
  U256 r = order();
  while (!v.lt(r)) { v = v.sub(r); }
  return v.toBytes();
}

/** The compressed public key (48 bytes) of a secret key given big-endian. */
export u8[] publicOf(u8[] secret) {
  u32[] limbs = u32[].filled(8, 0);
  for (i32 l = 0; l < 8; l++) {
    u32 w = 0;
    for (i32 b = 0; b < 4; b++) { w = w | ((secret[31 - (4 * l + b)] as u32) << ((8 * b) as! u32)); }
    limbs[l] = w;
  }
  return g1Compress(g1Mul(g1Generator(), limbs));
}

/** PBKDF2-HMAC-SHA256, one block: a 32-byte key. */
u8[] pbkdf2(u8[] password, u8[] salt, i32 count) {
  u8[] first = u8[].filled(salt.len() + 4, 0);
  first.copyFrom(salt, 0, 0, salt.len());
  first[salt.len() + 3] = 1;
  u8[] u = hmacSha256(password, first);
  u8[] out = u8[].filled(32, 0);
  out.copyFrom(u, 0, 0, 32);
  for (i32 c = 1; c < count; c++) {
    u = hmacSha256(password, u);
    for (i32 k = 0; k < 32; k++) { out[k] = out[k] ^ u[k]; }
  }
  return out;
}

string hex(u8[] b) { return bytesToHex(b).slice(2, 2 + 2 * b.len()); }

/** Keystore `i` as EIP-2335 JSON, under `password`, its randomness from `random` (48 bytes: salt, iv, uuid). */
export string keystore(i32 i, string password, u8[] random) {
  u8[] secret = interopSecret(i);
  u8[] salt = u8[].filled(16, 0);
  salt.copyFrom(random, 0, 0, 16);
  u8[] iv = u8[].filled(16, 0);
  iv.copyFrom(random, 16, 0, 16);
  i32 count = 16;
  u8[] dk = pbkdf2(password.toBytes(), salt, count);
  u8[] key = u8[].filled(16, 0);
  key.copyFrom(dk, 0, 0, 16);
  u8[] cipher = aesCtr(key, iv, secret);
  u8[] sum = u8[].filled(16 + cipher.len(), 0);
  sum.copyFrom(dk, 16, 0, 16);
  sum.copyFrom(cipher, 0, 16, cipher.len());
  string u = hex(random).slice(64, 96);
  string uuid = u.slice(0, 8) + "-" + u.slice(8, 12) + "-4" + u.slice(13, 16) + "-8" + u.slice(17, 20) + "-" + u.slice(20, 32);
  return "{\"crypto\":{\"kdf\":{\"function\":\"pbkdf2\",\"params\":{\"dklen\":32,\"c\":\{count},\"prf\":\"hmac-sha256\",\"salt\":\"\{hex(salt)}\"},\"message\":\"\"}," +
         "\"checksum\":{\"function\":\"sha256\",\"params\":{},\"message\":\"\{hex(sha256(sum))}\"}," +
         "\"cipher\":{\"function\":\"aes-128-ctr\",\"params\":{\"iv\":\"\{hex(iv)}\"},\"message\":\"\{hex(cipher)}\"}}," +
         "\"description\":\"interop key \{i}\",\"pubkey\":\"\{hex(publicOf(secret))}\",\"path\":\"\",\"uuid\":\"\{uuid}\",\"version\":4}";
}

/** Keystores for interop keys 0 … n − 1 in `dir`, one file each, all under `password`. */
export async void writeKeystores(Sys sys, string dir, i32 n, string password) {
  for (i32 i = 0; i < n; i++) {
    u8[] random = (await sys.random().bytes(48)).ok()!;
    await sys.writeFile(dir + "/keystore-\{i}.json", keystore(i, password, random).toBytes());
  }
}
