// What a cache in front of the store would catch, from a trace of what blocks asked of it
// (`tools/mainnet/replay.wac --keys`): for every read, the LRU stack distance — how many distinct keys were
// touched since this key last was — so one pass gives the hit rate of an LRU cache of every size. A write
// is a touch (a cache written through holds what was committed), and a block's first reads are what its
// fresh per-block state asked, so only reuse across blocks counts.
//
// Two units are compared: the entry (an account, a slot, a trie node, a code) and the 64 KB leaf it lies in.
// Leaves are modelled at mainnet's size, since the store the trace came from is tiny: hashed keys lie in
// leaves uniformly, so an account's leaf is its hash's place among ~460 K account leaves (30 GB of them). Slots
// lie by owner, then slot hash, across ~1.7 M leaves (110 GB), and how many leaves an owner's storage spans the
// trace cannot say, so a slot's leaf is modelled both ways: by its owner (a contract's storage in one leaf,
// the most a leaf cache could gain) and by its own hash (each slot alone, the least). Trie nodes and codes keep
// their entry as their leaf, which flatters the leaf cache too.
//
//     wac run --allow-read tools/measure/cache.wac -- TRACE [WARM]
//
// WARM blocks (default a quarter of them) only warm the cache; the rest are counted.

import { Sys } from "std";
import { Map, Vec } from "core";
import { hashString, stringEq } from "core";

/** Counts over the positions of time, for the distinct keys touched between two times. */
struct Fenwick {
  i32[] t;

  Fenwick create(i32 n) { return Fenwick(i32[].filled(n + 1, 0)); }

  void add(this, i32 i, i32 d) {
    for (i32 k = i + 1; k < this.t.len(); k += k & (-k)) { this.t[k] += d; }
  }

  i32 sum(this, i32 i) {
    i32 s = 0;
    for (i32 k = i + 1; k > 0; k -= k & (-k)) { s += this.t[k]; }
    return s;
  }
}

static string[] KINDS = ["account", "slot", "code", "account trie node", "storage trie node", "receipts"];
static i32[] SIZES = [1000, 3000, 10000, 30000, 100000, 300000, 1000000];

struct Access {
  string key;
  string leaf;
  string leafAlone;
  i32 kind;
  bool read;
  i32 block;
}

string hex(u8[] b, i32 from, i32 to) {
  u8[] d = "0123456789abcdef".toBytes();
  u8[] out = u8[].filled((to - from) * 2, 0);
  for (i32 i = from; i < to; i++) {
    out[2 * (i - from)] = d[(b[i] >> 4) as i32];
    out[2 * (i - from) + 1] = d[(b[i] & 15) as i32];
  }
  return string.fromBytes(out);
}

/** The modelled 64 KB leaf of a key: its place among a mainnet-sized kind's leaves, by its hash's top bits. */
string leafOf(u8[] key, bool alone) {
  i32 kind = key[0] as i32;
  if (kind > 1 || key.len() < 5) { return "e" + hex(key, 0, key.len()); }
  // A slot alone: by its own hash, after the owner's 32 bytes.
  i32 o = kind == 1 && alone && key.len() >= 37 ? 33 : 1;
  u64 top = ((key[o] as u64) << 24) | ((key[o + 1] as u64) << 16) | ((key[o + 2] as u64) << 8) | (key[o + 3] as u64);
  u64 leaves = kind == 0 ? 460000 : 1700000;
  return "\{kind}:\{(top * leaves) >> 32}";
}

/** For every read counted, its stack distance over `unit`'s names (-1 when never touched before). */
i32[] distances(Vec<Access> all, i32 unit, i32 warm, Vec<i32> kinds) {
  Fenwick f = Fenwick.create(all.len());
  Map<string, i32> last = Map.create(hashString, stringEq);
  Vec<i32> out = Vec.create();
  for (i32 t = 0; t < all.len(); t++) {
    Access a = all.get(t);
    string name = unit == 0 ? a.key : (unit == 1 ? a.leaf : a.leafAlone);
    i32? p = last.get(name);
    if (a.read && a.block >= warm) {
      out.push(p is null ? -1 : f.sum(t - 1) - f.sum(p!));
      kinds.push(a.kind);
    }
    if (p is not null) { f.add(p!, -1); }
    f.add(t, 1);
    last.set(name, t);
  }
  return out.toArray();
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() < 1) {
    sys.warn("usage: cache.wac TRACE [WARM]");
    return 2;
  }
  u8[] b = (await sys.readFile(args[0])).ok()!;
  Vec<Access> all = Vec.create();
  i32 blocks = 0;
  // Within a block, a key counts once: the block's own state holds it after its first touch.
  Map<string, bool> seen = Map.create(hashString, stringEq);
  i32[] reads = i32[].filled(KINDS.len(), 0);
  i32[] writes = i32[].filled(KINDS.len(), 0);
  i32 at = 0;
  while (at + 2 <= b.len()) {
    u8 kind = b[at];
    i32 n = b[at + 1] as i32;
    u8[] key = u8[].filled(n, 0);
    key.copyFrom(b, at + 2, 0, n);
    at += 2 + n;
    if (kind == 66) {
      blocks++;
      seen = Map.create(hashString, stringEq);
      continue;
    }
    bool read = kind == 82;
    string k = hex(key, 0, key.len());
    string tag = (read ? "R" : "W") + k;
    if (seen.has(tag)) { continue; }
    seen.set(tag, true);
    i32 kd = key.len() > 0 && (key[0] as i32) < KINDS.len() ? key[0] as i32 : KINDS.len() - 1;
    if (read) { reads[kd]++; } else { writes[kd]++; }
    all.push(Access(k, leafOf(key, false), leafOf(key, true), kd, read, blocks - 1));
  }
  i32 warm = args.len() > 1 ? parseInt(args[1]) : blocks / 4;
  sys.log("\{blocks} blocks, \{all.len()} distinct touches (a key once a block for each of read and write); the first \{warm} only warm");
  for (i32 k = 0; k < KINDS.len(); k++) {
    if (reads[k] + writes[k] == 0) { continue; }
    sys.log("  \{KINDS[k]}: \{reads[k] / blocks} reads and \{writes[k] / blocks} writes a block");
  }
  // Commits: flushed every N blocks, a key written in several of them is written once, and each leaf it lies
  // in is rewritten once (copy-on-write) — keys, and modelled leaves (slots by their own hash), per block.
  i32[] spans = [1, 4, 16, 64];
  for (i32 si = 0; si < spans.len(); si++) {
    i32 span = spans[si];
    Map<string, bool> keys = Map.create(hashString, stringEq);
    Map<string, bool> leaves = Map.create(hashString, stringEq);
    i32 keyTotal = 0;
    i32 leafTotal = 0;
    i32 window = -1;
    for (i32 t = 0; t < all.len(); t++) {
      Access a = all.get(t);
      if (a.read) { continue; }
      if (a.block / span != window) {
        keyTotal += keys.len();
        leafTotal += leaves.len();
        keys = Map.create(hashString, stringEq);
        leaves = Map.create(hashString, stringEq);
        window = a.block / span;
      }
      keys.set(a.key, true);
      leaves.set(a.leafAlone, true);
    }
    keyTotal += keys.len();
    leafTotal += leaves.len();
    sys.log("flushed every \{span} block(s): \{keyTotal / blocks} keys and \{leafTotal / blocks} leaves written a block");
  }
  string[] units = ["LRU of entries — hit rate of the reads counted, by capacity in entries:",
                    "LRU of 64 KB leaves, a contract's slots in one leaf — by capacity in leaves:",
                    "LRU of 64 KB leaves, each slot in a leaf of its own — by capacity in leaves:"];
  for (i32 unit = 0; unit < 3; unit++) {
    Vec<i32> kinds = Vec.create();
    i32[] d = distances(all, unit, warm, kinds);
    sys.log(units[unit]);
    for (i32 k = -1; k < KINDS.len(); k++) {
      i32 total = 0;
      i32 ever = 0;
      for (i32 i = 0; i < d.len(); i++) {
        if (k >= 0 && kinds.get(i) != k) { continue; }
        total++;
        if (d[i] >= 0) { ever++; }
      }
      if (total == 0) { continue; }
      string line = "  \{k < 0 ? "all" : KINDS[k]} (\{total} reads): ever before \{pct(ever, total)}";
      for (i32 s = 0; s < SIZES.len(); s++) {
        i32 hit = 0;
        for (i32 i = 0; i < d.len(); i++) {
          if ((k < 0 || kinds.get(i) == k) && d[i] >= 0 && d[i] < SIZES[s]) { hit++; }
        }
        line += ", \{SIZES[s]}: \{pct(hit, total)}";
      }
      sys.log(line);
    }
  }
  return 0;
}

string pct(i32 a, i32 b) { return b == 0 ? "-" : "\{(a * 1000 / b) / 10}.\{(a * 1000 / b) % 10}%"; }

i32 parseInt(string s) {
  u8[] b = s.toBytes();
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) { n = n * 10 + ((b[i] as i32) - 48); }
  return n;
}
