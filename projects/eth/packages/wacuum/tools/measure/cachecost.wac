// What one read through the store's cache of entries costs: a million lookups of keys it holds, among 100 K,
// against the same keys' copy and hash alone. Keys are an account key's shape (a byte and 32 hash bytes).
//
//     wac run --allow-read tools/measure/cachecost.wac

import { Sys } from "std";
import { EntryCache } from "../../src/store/cache.wac";

u8[] keyOf(i32 i) {
  u8[] k = u8[].filled(33, 0);
  u64 x = ((i as@ u32) as u64) * 0x9e3779b97f4a7c15 + 1;
  for (i32 j = 1; j < 33; j++) {
    x ^= x << 13;
    x ^= x >> 7;
    x ^= x << 17;
    k[j] = (x & 255) as! u8;
  }
  return k;
}

i32 fnv(u8[] b) {
  i32 h = -2128831035;
  for (i32 i = 0; i < b.len(); i++) { h = (h ^ (b[i] as i32)) * 16777619; }
  return h;
}

export async i32 main(Sys sys) {
  i32 n = 100000;
  u8[][] keys = u8[][].defaulted(n);
  for (i32 i = 0; i < n; i++) { keys[i] = keyOf(i); }
  EntryCache c = EntryCache.create(1 << 30);
  for (i32 i = 0; i < n; i++) { c.put(keys[i], [1 as u8, 2, 3]); }
  i32 rounds = 1000000;
  i64 t0 = await sys.monotonicNanos();
  i32 found = 0;
  for (i32 r = 0; r < rounds; r++) {
    if (c.get(keys[((r % n) * 7919) % n]).known) { found++; }
  }
  i64 t1 = await sys.monotonicNanos();
  i32 acc = 0;
  for (i32 r = 0; r < rounds; r++) {
    u8[] k = keys[((r % n) * 7919) % n];
    u8[] copy = u8[].filled(k.len(), 0);
    for (i32 j = 0; j < k.len(); j++) { copy[j] = k[j]; }
    acc ^= fnv(copy);
  }
  i64 t2 = await sys.monotonicNanos();
  sys.log("a lookup: \{(t1 - t0) / (rounds as i64)} ns (\{found} found); the key's copy and hash alone: \{(t2 - t1) / (rounds as i64)} ns (\{acc & 1})");
  return 0;
}
