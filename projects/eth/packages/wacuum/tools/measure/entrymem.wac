// What an entry kept in memory costs: a million keys and values of an account's size (33 and ~40 bytes) put
// in a `Map` keyed by the key's text, as a cache of entries would hold them, and the process's resident size
// read before and after (Linux's /proc/self/status).
//
//     wac run --allow-read tools/measure/entrymem.wac

import { Sys } from "std";
import { Map } from "core";
import { hashString, stringEq } from "core";

async i64 rssKb(Sys sys) {
  string s = string.fromBytes((await sys.readFile("/proc/self/status")).ok()!);
  i32 at = s.indexOf("VmRSS:");
  i64 n = 0;
  u8[] b = s.toBytes();
  for (i32 i = at + 6; i < b.len() && b[i] != 107; i++) {
    if (b[i] >= 48 && b[i] <= 57) { n = n * 10 + ((b[i] - 48) as i64); }
  }
  return n;
}

export async i32 main(Sys sys) {
  i64 before = await rssKb(sys);
  Map<string, u8[]> m = Map.create(hashString, stringEq);
  u64 x = 88172645463325252;
  i32 count = 1000000;
  for (i32 i = 0; i < count; i++) {
    u8[] k = u8[].filled(33, 0);
    for (i32 j = 0; j < 33; j++) {
      x ^= x << 13;
      x ^= x >> 7;
      x ^= x << 17;
      k[j] = (x & 255) as! u8;
    }
    m.set(string.fromBytes(k), u8[].filled(40, 1));
  }
  i64 after = await rssKb(sys);
  sys.log("\{count} entries: \{(after - before) * 1024 / (count as i64)} bytes each (resident \{before / 1024} MB before, \{after / 1024} MB after)");
  return m.len() == count ? 0 : 1;
}
