// Whether a `Map` whose size stays the same, with keys added and removed all the time, stays the same size in
// memory: what the store's cache does (100 K entries, each let go for a new one). Resident memory every
// million turns.
//
//     wac run --allow-read tools/measure/mapchurn.wac

import { Sys } from "std";
import { Map } from "core";
import { hashString, stringEq } from "core";

async i64 rssKb(Sys sys) {
  string s = string.fromBytes((await sys.readFile("/proc/self/status")).ok()!);
  i32 at = s.indexOf("VmRSS:");
  i64 n = 0;
  u8[] b = s.toBytes();
  for (i32 i = at + 6; i < b.len() && b[i] != 107; i++) {
    if (b[i] >= 48 && b[i] <= 57) { n = n * 10 + ((b[i] - 48) as i64); }
  }
  return n;
}

string key(i32 i) { return "k\{i}"; }

export async i32 main(Sys sys) {
  Map<string, i32> m = Map.create(hashString, stringEq);
  i32 live = 100000;
  for (i32 i = 0; i < live; i++) { m.set(key(i), i); }
  sys.log("filled: \{(await rssKb(sys)) / 1024} MB");
  for (i32 round = 1; round <= 8; round++) {
    for (i32 i = 0; i < 1000000; i++) {
      i32 n = live + (round - 1) * 1000000 + i;
      m.set(key(n), n);
      m.remove(key(n - live));
    }
    sys.log("after \{round} M turns, \{m.len()} live: \{(await rssKb(sys)) / 1024} MB");
  }
  return 0;
}
