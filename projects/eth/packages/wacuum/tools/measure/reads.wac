// What a read from the store's file costs by its size, waited for where it is asked (`Disk.readNow`, as the
// EVM's misses are) and awaited (as snap and the commit read): the numbers a page size and a cache are
// chosen by. A file of 1 GB is written first (in the page cache after, so this is the host, not the disk),
// then 2000 reads of each size at random page-aligned offsets.
//
//     wac run --allow-read --allow-write tools/measure/reads.wac -- PATH

import { Sys } from "std";
import { Disk } from "../../src/store/disk.wac";
import { fileDisk } from "../../src/store/file.wac";

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() < 1) {
    sys.warn("usage: reads.wac PATH");
    return 2;
  }
  Disk d = (await fileDisk(sys, args[0])).unwrap();
  i64 size = 1 << 30;
  if ((await d.size()).unwrap() < size) {
    u8[] block = u8[].filled(1 << 20, 7);
    for (i64 at = 0; at < size; at += 1 << 20) { await d.write(at, block); }
    await d.sync();
  }
  i32[] sizes = [512, 4096, 16384, 65536, 262144];
  u64 x = 88172645463325252;
  for (i32 s = 0; s < sizes.len(); s++) {
    i32 n = sizes[s];
    i64 pages = size / (n as i64);
    for (i32 mode = 0; mode < 2; mode++) {
      i64 t0 = await sys.monotonicNanos();
      for (i32 i = 0; i < 2000; i++) {
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        i64 at = ((x % (pages as! u64)) as! i64) * (n as i64);
        if (mode == 0) { d.readNow(at, n).unwrap(); } else { (await d.read(at, n)).unwrap(); }
      }
      i64 t1 = await sys.monotonicNanos();
      sys.log("\{n} bytes \{mode == 0 ? "waited where asked" : "awaited"}: \{(t1 - t0) / 2000 / 1000} µs a read");
    }
  }
  return 0;
}
