// The store as it grows: synthetic state written into a store file — accounts, and contracts with large
// storage, through StateDb as blocks write it (the tries built by path, commits staged and flushed) — and at every
// STEP MB of file, probe blocks run against it: reads of accounts and slots chosen at random from all written
// (cold, as a block's mostly are), then a block's worth of writes committed with the state root computed. Printed
// at each step: the file's size, how fast it filled, a probe block's reads and commit, the leaf reads they took,
// and the process's resident memory. The trend is what is wanted, before mainnet's hundreds of GB.
//
//     wac --max-heap 2g run --allow-read --allow-write tools/measure/scale.wac -- PATH MAX_MB [STEP_MB] [FLUSH]
//
// PATH is created (or grown, if it holds a store this wrote). STEP_MB defaults to 500. MAX_MB 0 only probes what
// is there: under a small --max-heap, whether a store of that size works in it.

import { Sys } from "std";
import { Map, Vec } from "core";
import { U256 } from "../../src/u256.wac";
import { AccountState, emptyCodeHash, hashU256, eqU256, slotMap } from "../../src/state/world.wac";
import { Store } from "../../src/store/tree.wac";
import { fileDisk } from "../../src/store/file.wac";
import { StateDb } from "../../src/store/state.wac";

static i32 ACCOUNTS = 20000;
static i32 CONTRACT_SLOTS = 20000;
static i32 CONTRACTS = 2;
static i32 PROBE_READS = 1000;
static i32 PROBE_WRITES = 500;

U256 account(i64 i) { return U256.ofU64(((i as! u64) * 0x9e3779b97f4a7c15) ^ 0x1234567); }
U256 contract(i64 i) { return U256.ofU64(0x5000000000000 + (i as! u64)); }

async i64 rssMb(Sys sys) {
  string s = string.fromBytes((await sys.readFile("/proc/self/status")).ok()!);
  i32 at = s.indexOf("VmRSS:");
  i64 n = 0;
  u8[] b = s.toBytes();
  for (i32 i = at + 6; i < b.len() && b[i] != 107; i++) {
    if (b[i] >= 48 && b[i] <= 57) { n = n * 10 + ((b[i] - 48) as i64); }
  }
  return n / 1024;
}

i64 parse(string s) {
  u8[] b = s.toBytes();
  i64 n = 0;
  for (i32 i = 0; i < b.len(); i++) { n = n * 10 + ((b[i] - 48) as i64); }
  return n;
}

struct Rng {
  u64 x;
  u64 next(this) {
    this.x ^= this.x << 13;
    this.x ^= this.x >> 7;
    this.x ^= this.x << 17;
    return this.x;
  }
}

export async i32 main(Sys sys) {
  string[] a = sys.args();
  string path = a[0];
  i64 maxMb = parse(a[1]);
  i64 stepMb = a.len() > 2 ? parse(a[2]) : 500;
  Store store = (await Store.open((await fileDisk(sys, path)).unwrap())).unwrap();
  StateDb db = StateDb.over(store);
  // Batches as snap writes them, a commit each, unless FLUSH says to stage them.
  db.flushEvery = a.len() > 3 ? (parse(a[3]) as! i32) : 1;
  // Where a previous run got to: its batches are numbered in the commit's own bytes.
  i64 batch = 0;
  u8[] user = store.committed().user;
  if (user.len() == 8) {
    for (i32 i = 0; i < 8; i++) { batch = (batch << 8) | (user[i] as i64); }
  }
  Rng r = Rng(0x2545f4914f6cdd1d);
  i64 nextProbe = ((await sizeOf(store)) / (1024 * 1024) / stepMb + 1) * stepMb;
  sys.log("size MB | batches | fill MB/s | probe: reads ms, commit ms, leaf reads | resident MB");
  i64 t0 = await sys.monotonicNanos();
  i64 mb0 = (await sizeOf(store)) / (1024 * 1024);
  // MAX_MB 0: no filling, the probes alone — under a tight --max-heap, what the store needs to work at its size.
  bool probeOnly = maxMb == 0;
  // The batch count rides in every commit, the probes' too, so a later run knows where this one got to.
  u8[] mark = u8[].filled(8, 0);
  for (i32 i = 0; i < 8; i++) { mark[i] = ((batch >> (56 - 8 * i)) & 255) as! u8; }
  string[] why = [""];
  while (true) {
    i64 mb = 0;
    if (!probeOnly) {
      // A batch: new accounts, and new contracts with large storage.
      i32 n = ACCOUNTS + CONTRACTS;
      U256[] addrs = U256[].filled(n, U256.zero());
      AccountState?[] states = AccountState?[].defaulted(n);
      Map<U256, Map<U256, U256>> slots = Map.create(hashU256, eqU256);
      for (i32 i = 0; i < ACCOUNTS; i++) {
        addrs[i] = account(batch * (ACCOUNTS as i64) + (i as i64));
        states[i] = AccountState(true, 1, U256.ofU64(((i as@ u32) as u64) + 1), u8[].filled(0, 0), emptyCodeHash());
      }
      for (i32 c = 0; c < CONTRACTS; c++) {
        addrs[ACCOUNTS + c] = contract(batch * (CONTRACTS as i64) + (c as i64));
        states[ACCOUNTS + c] = AccountState(true, 1, U256.zero(), u8[].filled(0, 0), emptyCodeHash());
        Map<U256, U256> m = slotMap();
        for (i32 k = 0; k < CONTRACT_SLOTS; k++) { m.set(U256.ofU64(r.next()), U256.ofU64(((k as@ u32) as u64) + 1)); }
        slots.set(addrs[ACCOUNTS + c], m);
      }
      batch++;
      for (i32 i = 0; i < 8; i++) { mark[i] = ((batch >> (56 - 8 * i)) & 255) as! u8; }
      if ((await db.write(addrs, states, slots, mark, why)) is null) {
        sys.warn("batch \{batch}: \{why[0]}");
        return 1;
      }
      mb = (await sizeOf(store)) / (1024 * 1024);
      if (mb < nextProbe && mb < maxMb) { continue; }
    }
    await store.flush();
    mb = (await sizeOf(store)) / (1024 * 1024);
    i64 t1 = await sys.monotonicNanos();
    f64 rate = ((mb - mb0) as~ f64) / ((((t1 - t0) / 1000000) as~ f64) / 1000.0);
    // Probe blocks, three: cold reads of what is there, then a block's writes committed alone.
    i64 readNs = 0;
    i64 commitNs = 0;
    i32 reads0 = store.reads;
    for (i32 p = 0; p < 3; p++) {
      StateDb probe = StateDb.over(store);
      i64 p0 = await sys.monotonicNanos();
      U256[] touched = U256[].filled(PROBE_WRITES, U256.zero());
      AccountState?[] after = AccountState?[].defaulted(PROBE_WRITES);
      for (i32 i = 0; i < PROBE_READS; i++) {
        i64 which = ((r.next() % ((batch * (ACCOUNTS as i64)) as! u64)) as! i64);
        U256 who = account(which);
        probe.account(who);
        if (i < PROBE_WRITES) {
          touched[i] = who;
          after[i] = AccountState(true, 2, U256.ofU64(r.next() & 0xffffff), u8[].filled(0, 0), emptyCodeHash());
        }
      }
      i64 p1 = await sys.monotonicNanos();
      if ((await probe.write(touched, after, Map.create(hashU256, eqU256), mark, why)) is null) {
        sys.warn("probe: \{why[0]}");
        return 1;
      }
      i64 p2 = await sys.monotonicNanos();
      readNs += p1 - p0;
      commitNs += p2 - p1;
    }
    sys.log("\{mb} | \{batch} | \{(rate * 10.0) as~ i64 / 10} | \{readNs / 3 / 1000000}, \{commitNs / 3 / 1000000}, \{(store.reads - reads0) / 3} | \{await rssMb(sys)}");
    nextProbe = (mb / stepMb + 1) * stepMb;
    t0 = await sys.monotonicNanos();
    mb0 = mb;
    if (probeOnly || mb >= maxMb) { break; }
  }
  return 0;
}

async i64 sizeOf(Store s) { return (await s.disk.size()).orElse(0); }
