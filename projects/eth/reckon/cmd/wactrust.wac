// wactrust — code pinned by hash, trusted by attestation (wac design/system/0016), as one command.
//
//     wactrust tree DIR                         kt1 of a directory (a top-level .git left out)
//     wactrust tree --git REPO COMMIT [SUBDIR]  kt1 of a commit, every hash from the bytes git hands over
//     wactrust blob FILE                        kb1 of one file
//     wactrust lock pin|check                   wac.lock pinned by tree, and the cache checked against it
//     wactrust lock fetch NAME [--from URL]     fetch one entry with git, installed only if it hashes to its pin
//     wactrust build --dir D --path P --toolchain kt1:… --key F [--out S] -- COMMAND…
//                                               build from a clean commit and sign what it produced
//     wactrust rebuild S --git REPO COMMIT --toolchain kt1:… [--key F] [--out S2]
//                                               rebuild a statement's source and say whether the output matches
//     wactrust review SUBJECT SCOPE --key F [--out S]   sign a review of a kt1/kb1
//     wactrust verify S…                        check statements' signatures
//     wactrust publish MIRROR --blob FILE [--statement S]…   put an app and statements about it in a mirror directory
//     wactrust check ID --policy P --mirror M… [--purpose app|dependency]   may this be used? and why
//     wactrust resolve NAME@0xPUBLISHER --policy P            what a name points at, proved
//     wactrust run NAME@0xPUBLISHER|kb1:… --policy P --mirror M… [--out DIR] [-- ARGS…]
//                                               resolve, decide, fetch, check the hash, and only then run it

import { Sys } from "std";
import { treeId, blobId, leafHash } from "../src/tree.wac";
import { isZero } from "../src/registry.wac";
import { hashDir, hashCommit } from "../src/walk.wac";
import { LockEntry, readLock, writeLock, pin, check, fetchInto } from "../src/lock.wac";
import { Claim, Statement, Verified, signClaim, verify, toJson, fromJson, hex, unhex } from "../src/statement.wac";
import { runBuild, cleanSource, rebuild } from "../src/build.wac";
import { Policy, Chain, Decision, readPolicy, decide } from "../src/policy.wac";
import { blob, statements, chainFor, resolve, Resolved } from "../src/trust.wac";
import { Authority, Launch, Child } from "std";

string usage() {
  return """
    usage: wactrust tree DIR | tree --git REPO COMMIT [SUBDIR] | blob FILE
           wactrust lock pin | lock check | lock fetch NAME [--from URL]
           wactrust build --dir D --path P --toolchain kt1:… --key F [--out S] -- COMMAND…
           wactrust rebuild S --git REPO COMMIT --toolchain kt1:… [--key F] [--out S2]
           wactrust review SUBJECT SCOPE --key F [--out S]
           wactrust verify S…
           wactrust publish MIRROR --blob FILE [--statement S]…
           wactrust check ID --policy P --mirror M… [--purpose app|dependency]
           wactrust resolve NAME@0xPUBLISHER --policy P
           wactrust run NAME@0xPUBLISHER|kb1:… --policy P --mirror M… [--out DIR] [-- ARGS…]
    """;
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() == 0) { sys.warn(usage()); return 2; }
  string cmd = args[0];
  if (cmd == "tree" && args.len() >= 4 && args[1] == "--git") {
    match (await hashCommit(sys, args[2], args[3], args.len() > 4 ? args[4] : "")) {
      Err(e): { sys.warn("wactrust: \{e}"); return 1; }
      Ok(h): { sys.log(treeId(h)); return 0; }
    }
  }
  if (cmd == "tree" && args.len() == 2) {
    match (await hashDir(sys.files(), args[1], [".git"])) {
      Err(e): { sys.warn("wactrust: \{e}"); return 1; }
      Ok(h): { sys.log(treeId(h)); return 0; }
    }
  }
  if (cmd == "blob" && args.len() == 2) {
    match (await sys.readFile(args[1])) {
      Err(e): { sys.warn("wactrust: \{e}"); return 1; }
      Ok(b): { sys.log(blobId(leafHash(b))); return 0; }
    }
  }
  if (cmd == "lock" && args.len() >= 2) { return await lockCmd(sys, args); }
  if (cmd == "build") { return await buildCmd(sys, args); }
  if (cmd == "rebuild" && args.len() >= 2) { return await rebuildCmd(sys, args); }
  if (cmd == "review" && args.len() >= 3) { return await reviewCmd(sys, args); }
  if (cmd == "verify" && args.len() >= 2) { return await verifyCmd(sys, args); }
  if (cmd == "publish" && args.len() >= 2) { return await publishCmd(sys, args); }
  if (cmd == "check" && args.len() >= 2) { return await checkCmd(sys, args); }
  if (cmd == "resolve" && args.len() >= 2) { return await resolveCmd(sys, args); }
  if (cmd == "run" && args.len() >= 2) { return await runCmd(sys, args); }
  sys.warn(usage());
  return 2;
}

export async string envOr(Sys sys, string name, string fallback) {
  match (await sys.env().get(name)) {
    Err(e): { return fallback; }
    Ok(v): { return v is null || v!.len() == 0 ? fallback : string.fromBytes(v!); }
  }
}

async i32 lockCmd(Sys sys, string[] args) {
  string home = await envOr(sys, "WAC_HOME", (await envOr(sys, "HOME", "")) + "/.wac");
  LockEntry[] es;
  match (await sys.readFile("wac.lock")) {
    Err(e): { sys.warn("wactrust: no wac.lock here"); return 1; }
    Ok(b): {
      match (readLock(b)) {
        Err(e): { sys.warn("wactrust: \{e}"); return 1; }
        Ok(x): { es = x; }
      }
    }
  }
  if (args[1] == "pin") {
    match (await pin(sys.files(), home, es)) {
      Err(e): { sys.warn("wactrust: \{e}"); return 1; }
      Ok(lines): {
        for (string l in lines) { sys.log(l); }
        await sys.writeFile("wac.lock", writeLock(es).toBytes());
        return 0;
      }
    }
  }
  if (args[1] == "check") {
    match (await check(sys.files(), home, es)) {
      Err(e): { sys.warn("wactrust: \{e}"); return 1; }
      Ok(lines): { for (string l in lines) { sys.log(l); } return 0; }
    }
  }
  if (args[1] == "fetch" && args.len() >= 3) {
    for (LockEntry e in es) {
      if (e.name != args[2]) { continue; }
      string from = args.len() >= 5 && args[3] == "--from" ? args[4] : e.git;
      match (await fetchInto(sys, home, e, from)) {
        Err(x): { sys.warn("wactrust: \{x}"); return 1; }
        Ok(line): { sys.log(line); return 0; }
      }
    }
    sys.warn("wactrust: no entry named \{args[2]}");
    return 1;
  }
  sys.warn(usage());
  return 2;
}

/** The value after `name` (before any `--`), or "". */
export string flag(string[] args, string name) {
  for (i32 i = 0; i + 1 < args.len(); i++) {
    if (args[i] == "--") { return ""; }
    if (args[i] == name) { return args[i + 1]; }
  }
  return "";
}

/** Everything after `--`. */
string[] afterDashes(string[] args) {
  for (i32 i = 0; i < args.len(); i++) {
    if (args[i] == "--") {
      string[] out = string[].defaulted(args.len() - i - 1);
      for (i32 j = i + 1; j < args.len(); j++) { out[j - i - 1] = args[j]; }
      return out;
    }
  }
  return string[]();
}

export async u8[]? keyFrom(Sys sys, string path) {
  if (path == "") { return null; }
  match (await sys.readFile(path)) {
    Err(e): { return null; }
    Ok(b): {
      string t = string.fromBytes(b);
      while (t.len() > 0 && (t.slice(t.len() - 1, t.len()) == "\n" || t.slice(t.len() - 1, t.len()) == " ")) { t = t.slice(0, t.len() - 1); }
      u8[]? k = unhex(t);
      return k is not null && k!.len() == 32 ? k : null;
    }
  }
}

/** Sign `c` with the key at `keyPath` and write it to `out` (or print it). */
async i32 emit(Sys sys, Claim c, string keyPath, string out) {
  u8[]? key = await keyFrom(sys, keyPath);
  if (key is null) { sys.warn("wactrust: --key names no file holding a 32-byte hex key"); return 1; }
  match (signClaim(c, key!)) {
    Err(e): { sys.warn("wactrust: \{e}"); return 1; }
    Ok(st): {
      string text = toJson(st) + "\n";
      if (out == "") { sys.log(toJson(st)); } else { await sys.writeFile(out, text.toBytes()); sys.log("wrote \{out}"); }
      return 0;
    }
  }
}

async i32 buildCmd(Sys sys, string[] args) {
  string[] command = afterDashes(args);
  string dir = flag(args, "--dir");
  string path = flag(args, "--path");
  string toolchain = flag(args, "--toolchain");
  if (command.len() == 0 || path == "" || toolchain == "") { sys.warn(usage()); return 2; }
  string home = await envOr(sys, "WAC_HOME", (await envOr(sys, "HOME", "")) + "/.wac");
  string source;
  match (await cleanSource(sys)) {
    Err(e): { sys.warn("wactrust: \{e}"); return 1; }
    Ok(s): { source = s; }
  }
  match (await runBuild(sys, home, ".", source, dir == "" ? "." : dir, command, path, toolchain)) {
    Err(e): { sys.warn("wactrust: \{e}"); return 1; }
    Ok(c): {
      sys.warn("source \{source}");
      match (c) { Built(_, _, _, _, _, output): { sys.warn("output \{output}"); } Reviewed(_, _): { } }
      return await emit(sys, c, flag(args, "--key"), flag(args, "--out"));
    }
  }
}

async Statement? readStatement(Sys sys, string path) {
  match (await sys.readFile(path)) {
    Err(e): { sys.warn("wactrust: cannot read \{path}"); return null; }
    Ok(b): {
      match (fromJson(b)) {
        Err(e): { sys.warn("wactrust: \{path}: \{e}"); return null; }
        Ok(s): { return s; }
      }
    }
  }
}

async i32 rebuildCmd(Sys sys, string[] args) {
  Statement? st = await readStatement(sys, args[1]);
  if (st is null) { return 1; }
  match (verify(st!)) {
    Err(e): { sys.warn("wactrust: \{args[1]}: \{e}"); return 1; }
    Ok(_): { }
  }
  string repo = "";
  string commit = "";
  for (i32 i = 0; i + 2 < args.len(); i++) { if (args[i] == "--git") { repo = args[i + 1]; commit = args[i + 2]; } }
  string toolchain = flag(args, "--toolchain");
  if (repo == "" || toolchain == "") { sys.warn(usage()); return 2; }
  string home = await envOr(sys, "WAC_HOME", (await envOr(sys, "HOME", "")) + "/.wac");
  string scratch = home + "/rebuild-scratch";
  match (await rebuild(sys, home, repo, commit, scratch, st!.claim, toolchain)) {
    Err(e): { sys.warn("wactrust: \{e}"); return 1; }
    Ok(mine): {
      string theirs = match (st!.claim) { Built(_, _, _, _, _, o): o, Reviewed(_, _): "" };
      string got = match (mine) { Built(_, _, _, _, _, o): o, Reviewed(_, _): "" };
      string theirTool = match (st!.claim) { Built(_, _, _, _, t, _): t, Reviewed(_, _): "" };
      if (got != theirs) {
        sys.warn("DIFFERS\n  statement \{theirs}\n  rebuilt   \{got}");
        return 1;
      }
      sys.log("same \{got}" + (theirTool != toolchain ? " (with toolchain \{toolchain}, the statement says \{theirTool})" : ""));
      if (flag(args, "--key") == "") { return 0; }
      return await emit(sys, mine, flag(args, "--key"), flag(args, "--out"));
    }
  }
}

async i32 reviewCmd(Sys sys, string[] args) {
  return await emit(sys, Claim.Reviewed(args[1], args[2]), flag(args, "--key"), flag(args, "--out"));
}

async i32 verifyCmd(Sys sys, string[] args) {
  i32 bad = 0;
  for (i32 i = 1; i < args.len(); i++) {
    Statement? st = await readStatement(sys, args[i]);
    if (st is null) { bad++; continue; }
    match (verify(st!)) {
      Err(e): { sys.warn("\{args[i]}: \{e}"); bad++; }
      Ok(v): { sys.log("\{args[i]}: signed by 0x\{hex(v.signer)}, id 0x\{hex(v.id)}"); }
    }
  }
  return bad == 0 ? 0 : 1;
}

/** Every value given for a repeatable flag. */
string[] flags(string[] args, string name) {
  string[] out = string[]();
  for (i32 i = 0; i + 1 < args.len(); i++) {
    if (args[i] == "--") { break; }
    if (args[i] == name) {
      string[] next = string[].defaulted(out.len() + 1);
      for (i32 j = 0; j < out.len(); j++) { next[j] = out[j]; }
      next[out.len()] = args[i + 1];
      out = next;
    }
  }
  return out;
}

async i32 publishCmd(Sys sys, string[] args) {
  string mirror = args[1];
  await sys.files().mkdir(mirror + "/blobs", true);
  await sys.files().mkdir(mirror + "/statements", true);
  string[] blobs = flags(args, "--blob");
  for (i32 bi = 0; bi < blobs.len(); bi++) {
    string b = blobs[bi];
    match (await sys.readFile(b)) {
      Err(e): { sys.warn("wactrust: \{e}"); return 1; }
      Ok(bytes): {
        string h = hex(leafHash(bytes));
        await sys.writeFile(mirror + "/blobs/" + h, bytes);
        sys.log("blob kb1:\{h}");
      }
    }
  }
  string index = string.fromBytes((await sys.readFile(mirror + "/statements/index")).ok() ?? u8[]());
  string[] given = flags(args, "--statement");
  // An index rather than `for (string path in …)`: with the latter wacc's checker passes and its emitter reads
  // `path` as the string[] it iterates (not reduced further; scratch/wactrust-forin-bug.wac keeps the case).
  for (i32 gi = 0; gi < given.len(); gi++) {
    string path = given[gi];
    Statement? st = await readStatement(sys, path);
    if (st is null) { return 1; }
    Verified v;
    match (verify(st!)) {
      Err(e): { sys.warn("wactrust: \{path}: \{e} — not published"); return 1; }
      Ok(x): { v = x; }
    }
    string name = hex(v.id).slice(0, 16) + "-" + hex(v.signer).slice(0, 8) + ".json";
    await sys.writeFile(mirror + "/statements/" + name, (toJson(st!) + "\n").toBytes());
    if (index.indexOf(name) < 0) { index += name + "\n"; }
    sys.log("statement \{name}");
  }
  await sys.writeFile(mirror + "/statements/index", index.toBytes());
  return 0;
}

async Policy? policyFrom(Sys sys, string path) {
  match (await sys.readFile(path)) {
    Err(e): { sys.warn("wactrust: cannot read the policy \{path}"); return null; }
    Ok(b): {
      match (readPolicy(b)) {
        Err(e): { sys.warn("wactrust: \{e}"); return null; }
        Ok(p): { return p; }
      }
    }
  }
}

async i64 nowSeconds(Sys sys) { return (await sys.clock().nowMillis()).orElse(0 as i64) / (1000 as i64); }

/** Decide about `id`, printing why. */
async bool allowed(Sys sys, Policy p, string purpose, string id, string[] mirrors) {
  Verified[] vs = await statements(sys, mirrors, id, string[]());
  sys.warn("\{vs.len()} verified statement(s) about \{id} or its source");
  Chain chain;
  match (chainFor(sys, p, id, vs, await nowSeconds(sys))) {
    Err(e): {
      sys.warn("chain: \{e}");
      chain = Chain.unknown();
    }
    Ok(c): { chain = c; }
  }
  Decision d = decide(p, purpose, id, vs, chain);
  for (string r in d.reasons) { sys.warn("  " + r); }
  return d.allowed;
}

async i32 checkCmd(Sys sys, string[] args) {
  Policy? p = await policyFrom(sys, flag(args, "--policy"));
  if (p is null) { return 1; }
  string purpose = flag(args, "--purpose") == "" ? "app" : flag(args, "--purpose");
  return (await allowed(sys, p!, purpose, args[1], flags(args, "--mirror"))) ? 0 : 1;
}

/** A name's target at this moment, or "" — printing what the chain says, including a change still waiting. */
async string resolveName(Sys sys, Policy p, string target) {
  i32 at = target.indexOf("@");
  u8[]? publisher = at < 0 ? null : unhex(target.slice(at + 1, target.len()));
  if (publisher is null || publisher!.len() != 20) { sys.warn("wactrust: a name is NAME@0xPUBLISHER"); return ""; }
  string name = target.slice(0, at);
  Resolved r;
  match (resolve(sys.net(), p, publisher!, name)) {
    Err(e): { sys.warn("wactrust: \{e}"); return ""; }
    Ok(x): { r = x; }
  }
  if (isZero(r.pointer.current)) { sys.warn("wactrust: \{target} is not claimed (proved absent at block \{r.number})"); return ""; }
  i64 now = await nowSeconds(sys);
  sys.warn("name \{target} at block \{r.number}: current kb1:\{hex(r.pointer.current)}, delay \{r.pointer.delay}s");
  if (!isZero(r.pointer.pending)) {
    i64 left = r.pointer.effectiveAt - r.timestamp;
    sys.warn(left > (0 as i64)
      ? "  a change to kb1:\{hex(r.pointer.pending)} is proposed and waits \{left}s more — not followed yet"
      : "  the change to kb1:\{hex(r.pointer.pending)} has taken effect");
  }
  if (r.pointer.delay < p.minDelay) {
    sys.warn("wactrust: \{target} lets its publisher change it with \{r.pointer.delay}s notice; the policy wants at least \{p.minDelay}s");
    return "";
  }
  // The block's own time decides, not the local clock: the delay is a rule the contract states in its terms.
  return "kb1:" + hex(r.pointer.at(r.timestamp));
}

async i32 resolveCmd(Sys sys, string[] args) {
  Policy? p = await policyFrom(sys, flag(args, "--policy"));
  if (p is null) { return 1; }
  string id = await resolveName(sys, p!, args[1]);
  if (id == "") { return 1; }
  sys.log(id);
  return 0;
}

async i32 runCmd(Sys sys, string[] args) {
  Policy? p = await policyFrom(sys, flag(args, "--policy"));
  if (p is null) { return 1; }
  string id = args[1].indexOf("kb1:") == 0 ? args[1] : await resolveName(sys, p!, args[1]);
  if (id == "") { return 1; }
  string[] mirrors = flags(args, "--mirror");
  if (!(await allowed(sys, p!, "app", id, mirrors))) { sys.warn("wactrust: not running \{id}"); return 1; }
  u8[] bytes;
  string[] log = string[]();
  match (await blob(sys, mirrors, id, log)) {
    Err(e): { sys.warn("wactrust: \{e}"); return 1; }
    Ok(b): { bytes = b; }
  }
  sys.warn("fetched \{bytes.len()} bytes hashing to \{id}");
  if (bytes.len() >= 4 && bytes[0] == 0 && bytes[1] == 'a' && bytes[2] == 's' && bytes[3] == 'm') {
    // The checked bytes themselves are instantiated — no file in between to be swapped — holding nothing.
    sys.warn("running it with no authority at all: no files, no network, no environment, no processes");
    Child child;
    match (await sys.procs().spawn(bytes, afterDashes(args), Authority.none(), Launch("", false, true, false))) {
      Err(e): { sys.warn("wactrust: cannot start it: \{e}"); return 1; }
      Ok(c): { child = c; }
    }
    return (await child.exit()).orElse(1);
  }
  string out = flag(args, "--out") == "" ? "verified-" + id.slice(4, 16) : flag(args, "--out");
  await sys.files().mkdir(out, true);
  await sys.writeFile(out + "/index.html", bytes);
  string cwd = (await sys.env().cwd()).orElse("");
  sys.log("file://\{out.indexOf("/") == 0 ? out : cwd + "/" + out}/index.html");
  return 0;
}
