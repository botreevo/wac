// Reading `contracts/TrustRegistry.sol` without trusting whoever answers: design/system/0016 H6-H8.
//
// Nothing here calls the contract. Every answer is a storage slot read with `eth_getProof` and checked by
// `mpt` against the state root of one header, so "not revoked" is a proof that a slot is empty rather than a
// node's word that it is. The slots are the contract's layout:
//
//     revoked[signer][statement]   slot 0   keccak(statement ‖ keccak(pad(signer) ‖ 0))
//     denied[list][hash]           slot 1   keccak(hash ‖ keccak(pad(list) ‖ 1))
//     names[publisher][name]       slot 2   base = keccak(keccak(name) ‖ keccak(pad(publisher) ‖ 2)), +0..+3
//
// **Where the header comes from is the trust anchor**, and it is the one thing this file does not settle.
// `anchor` is a block hash from somewhere the user trusts — on mainnet, what `packages/lightclient` hands over
// from a finalized sync-committee signature. Without one the header is checked only against the node's own
// `hash` field, which proves the node is consistent with itself and nothing more; every answer then says so.

import { Net } from "std";
import { crypto.keccak256, ethrpc.call, ethrpc.headerOf, ethrpc.proofOfSlots, ethrpc.Proof, ethrpc.Header,
         ethrpc.memberQuantity, json.JsonValue, mpt.accountAt, mpt.storageAt, mpt.AccountProof,
         mpt.StorageProof } from "wac";
import { Result } from "core";
import { hex } from "./statement.wac";

export struct Endpoint {
  string host;
  i32 port;
  u8[] registry;
  /** A block hash to anchor to, or empty to take the node's latest block on its own word. */
  u8[] anchor;
  /** The registry's runtime code hash, checked against the account proof when not empty. */
  u8[] codeHash;
}

/** One block's view of the registry: what was read, and from where. */
export struct Snapshot {
  u8[] blockHash;
  i64 number;
  /** Seconds since the epoch, from the header: what freshness is measured against. */
  i64 timestamp;
  bool anchored;
  u8[][] slots;
  /** Each slot's value, 32 bytes big-endian, zero when the proof shows it absent. */
  u8[][] values;
}

u8[] word(i64 n) {
  u8[] out = u8[].filled(32, 0);
  for (i32 i = 0; i < 8; i++) { out[31 - i] = ((n >> ((i * 8) as i64)) & 255) as@ u8; }
  return out;
}

u8[] pad(u8[] b) {
  u8[] out = u8[].filled(32, 0);
  for (i32 i = 0; i < b.len(); i++) { out[32 - b.len() + i] = b[i]; }
  return out;
}

u8[] cat2(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  for (i32 i = 0; i < a.len(); i++) { out[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { out[a.len() + i] = b[i]; }
  return out;
}

/** `m[outer][inner]` for a mapping of mappings at `slot`. */
u8[] nested(u8[] outer, u8[] inner, i64 slot) {
  return keccak256(cat2(inner, keccak256(cat2(pad(outer), word(slot)))));
}

export u8[] revokedSlot(u8[] signer, u8[] statement) { return nested(signer, statement, 0 as i64); }
export u8[] deniedSlot(u8[] list, u8[] hash) { return nested(list, hash, 1 as i64); }
/** The first of a name's four slots: current, pending, effectiveAt, delay. */
export u8[] nameSlot(u8[] publisher, string name) { return nested(publisher, keccak256(name.toBytes()), 2 as i64); }

/** `slot + k`, as 256-bit big-endian addition. */
export u8[] plus(u8[] slot, i32 k) {
  u8[] out = u8[].filled(32, 0);
  i32 carry = k;
  for (i32 i = 31; i >= 0; i--) {
    i32 v = (slot[i] as i32) + carry;
    out[i] = v as@ u8;
    carry = v >> 8;
  }
  return out;
}

export bool isZero(const u8[] w) {
  for (i32 i = 0; i < w.len(); i++) { if (w[i] != 0) { return false; } }
  return true;
}

export i64 toI64(u8[] w) {
  i64 n = 0 as i64;
  for (i32 i = 0; i < w.len(); i++) { n = (n << 8) | (w[i] as i64); }
  return n;
}

/** Read `slots` of the registry at one block, every value proved. */
export Result<Snapshot, string> read(Net net, Endpoint ep, u8[][] slots) {
  string where = ep.anchor.len() == 32 ? "[\"0x\{hex(ep.anchor)}\",false]" : "[\"latest\",false]";
  JsonValue block = try call(net, ep.host, ep.port, ep.anchor.len() == 32 ? "eth_getBlockByHash" : "eth_getBlockByNumber", where);
  if (block.isNull()) { return Result.Err("the node does not have the anchored block"); }
  Header h = try headerOf(block, ep.anchor);
  // Anchor the proof to this header, so every slot is read at the block whose timestamp is reported.
  string[] keys = string[].defaulted(slots.len());
  for (i32 i = 0; i < slots.len(); i++) { keys[i] = "0x" + hex(slots[i]); }
  Proof p = try proofOfSlots(net, ep.host, ep.port, "0x" + hex(ep.registry), keys, h.hash);
  AccountProof acct = accountAt(h.stateRoot, ep.registry, p.accountNodes);
  if (!acct.ok) { return Result.Err("the registry's account proof: \{acct.error}"); }
  if (!acct.present) { return Result.Err("there is no account at the registry's address in this block"); }
  if (ep.codeHash.len() == 32 && hex(acct.account.codeHash) != hex(ep.codeHash)) {
    return Result.Err("the account at the registry's address runs other code (0x\{hex(acct.account.codeHash)})");
  }
  u8[][] values = u8[][].filled(slots.len(), u8[]());
  for (i32 i = 0; i < slots.len(); i++) {
    StorageProof s = storageAt(acct.account.storageRoot, slots[i], p.slots[i]);
    if (!s.ok) { return Result.Err("slot \{keys[i]}: \{s.error}"); }
    values[i] = pad(s.value);
  }
  return Result.Ok(Snapshot(h.hash, toI64(memberQuantity(block, "number")), toI64(memberQuantity(block, "timestamp")),
                            ep.anchor.len() == 32, slots, values));
}

/** What a name points at in a snapshot, applying a pending change whose time has come. */
export struct Pointer {
  u8[] current;
  u8[] pending;
  i64 effectiveAt;
  i64 delay;

  /** The hash a follower uses at `now`: the pending one once its delay has passed. */
  u8[] at(this, i64 now) {
    if (!isZero(this.pending) && now >= this.effectiveAt) { return this.pending; }
    return this.current;
  }
}

export Pointer pointerOf(u8[][] four) {
  return Pointer(four[0], four[1], toI64(four[2]), toI64(four[3]));
}
