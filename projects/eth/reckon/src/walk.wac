// Hashing a directory on disk, and a commit out of git: two sources, one `tree.wac`.

import { Sys, Files, Stat, ChildEnv, Launch } from "std";
import { Result } from "core";
import { Entry, nodeHash, leafHash, nameFault, Builder, KIND_FILE, KIND_EXEC, KIND_DIR } from "./tree.wac";

/**
 * The tree hash of the directory `path`. `skip` names entries left out *at the top level only* — `.git` in a
 * working tree, `pack.pack` in a wac cache entry — because those are bookkeeping beside the files, not files.
 */
export async Result<u8[], string> hashDir(Files fs, string path, string[] skip) {
  string[] names;
  match (await fs.readDir(path)) {
    Err(e): { return Result.Err("\{path}: cannot list: \{e}"); }
    Ok(n): { names = n; }
  }
  Entry[] entries = Entry[].defaulted(names.len());
  i32 n = 0;
  for (i32 i = 0; i < names.len(); i++) {
    string name = names[i];
    if (contains(skip, name)) { continue; }
    string fault = nameFault(name);
    if (fault != "") { return Result.Err("\{path}: \{fault}"); }
    string p = path + "/" + name;
    Stat st;
    match (await fs.linkStat(p)) {
      Err(e): { return Result.Err("\{p}: \{e}"); }
      Ok(s): { st = s; }
    }
    if (st.isSymlink) { return Result.Err("\{p}: a symlink, which a tree cannot hold (issues/system/0137)"); }
    if (st.isDir) {
      match (await hashDir(fs, p, string[]())) {
        Err(e): { return Result.Err(e); }
        Ok(h): { entries[n] = Entry(name, KIND_DIR, h); }
      }
    } else if (st.isFile) {
      u8[] bytes;
      match (await fs.readFile(p)) {
        Err(e): { return Result.Err("\{p}: cannot read: \{e}"); }
        Ok(b): { bytes = b; }
      }
      entries[n] = Entry(name, st.isExecutable ? KIND_EXEC : KIND_FILE, leafHash(bytes));
    } else {
      return Result.Err("\{p}: neither a file nor a directory");
    }
    n++;
  }
  Entry[] used = Entry[].defaulted(n);
  for (i32 i = 0; i < n; i++) { used[i] = entries[i]; }
  return nodeHash(used);
}

bool contains(string[] xs, string x) {
  for (i32 i = 0; i < xs.len(); i++) { if (xs[i] == x) { return true; } }
  return false;
}

/**
 * The tree hash of `commit` in the git repository at `repo`, with `subdir` ("" for all of it) as the root.
 *
 * git is a **locator** here and nothing more: the file list comes from `git ls-tree` and the bytes from one
 * `git cat-file --batch`, and every hash is computed from those bytes. git's own SHA-1 names are used to ask
 * for objects and are never part of the answer.
 */
export async Result<u8[], string> hashCommit(Sys sys, string repo, string commit, string subdir) {
  string spec = subdir == "" ? commit : "\{commit}:\{subdir}";
  u8[] listing;
  match (await run(sys, ["-C", repo, "ls-tree", "-r", "-z", spec], u8[]())) {
    Err(e): { return Result.Err(e); }
    Ok(b): { listing = b; }
  }
  // Each record: "<mode> <type> <sha>\t<path>\0"
  string[] modes = string[]();
  string[] shas = string[]();
  string[] paths = string[]();
  i32 start = 0;
  string ask = "";
  for (i32 i = 0; i < listing.len(); i++) {
    if (listing[i] != 0) { continue; }
    string rec = string.fromBytes(slice(listing, start, i));
    start = i + 1;
    i32 tab = rec.indexOf("\t");
    string head = rec.slice(0, tab);
    string mode = head.slice(0, head.indexOf(" "));
    string sha = head.slice(lastSpace(head) + 1, head.len());
    string path = rec.slice(tab + 1, rec.len());
    if (mode == "120000") { return Result.Err("\{path}: a symlink, which a tree cannot hold (issues/system/0137)"); }
    if (mode == "160000") { return Result.Err("\{path}: a submodule, which a tree cannot hold"); }
    if (mode != "100644" && mode != "100755") { return Result.Err("\{path}: mode \{mode}"); }
    modes = pushS(modes, mode);
    shas = pushS(shas, sha);
    paths = pushS(paths, path);
    ask += sha + "\n";
  }
  u8[] batch;
  match (await run(sys, ["-C", repo, "cat-file", "--batch"], ask.toBytes())) {
    Err(e): { return Result.Err(e); }
    Ok(b): { batch = b; }
  }
  Builder b = Builder.create();
  i32 at = 0;
  for (i32 i = 0; i < shas.len(); i++) {
    // "<sha> blob <size>\n<content>\n"
    i32 nl = at;
    while (batch[nl] != 10) { nl++; }
    string head = string.fromBytes(slice(batch, at, nl));
    if (head.indexOf(shas[i]) != 0 || head.indexOf(" blob ") < 0) { return Result.Err("git answered \{head} for \{paths[i]}"); }
    i32 size = parseInt(head.slice(lastSpace(head) + 1, head.len()));
    u8[] content = slice(batch, nl + 1, nl + 1 + size);
    at = nl + 1 + size + 1;
    string fault = b.add(paths[i], modes[i] == "100755", content);
    if (fault != "") { return Result.Err(fault); }
  }
  return b.hash();
}

async Result<u8[], string> run(Sys sys, string[] args, u8[] input) {
  match (await sys.procs().exec("git", args, input, ChildEnv.inherited(), Launch.plain())) {
    Err(e): { return Result.Err("cannot run git: \{e}"); }
    Ok(r): {
      if (r.ok()) { return Result.Ok(r.stdout); }
      return Result.Err("git \{args[2]}: \{r.ran() ? string.fromBytes(r.stderr) : r.error}");
    }
  }
}

export u8[] slice(u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  for (i32 i = from; i < to; i++) { out[i - from] = b[i]; }
  return out;
}

export string[] pushS(string[] xs, string x) {
  string[] out = string[].defaulted(xs.len() + 1);
  for (i32 i = 0; i < xs.len(); i++) { out[i] = xs[i]; }
  out[xs.len()] = x;
  return out;
}

export i32 parseInt(string s) {
  i32 n = 0;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { n = n * 10 + ((b[i] - '0') as i32); }
  return n;
}

i32 lastSpace(string s) {
  i32 at = -1;
  for (i32 i = 0; i < s.len(); i++) { if (s.slice(i, i + 1) == " ") { at = i; } }
  return at;
}
