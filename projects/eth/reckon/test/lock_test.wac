// wac.lock with `tree` and `root` (design/system/0016 H2): read, written back, and read again unchanged.

import { Result } from "core";
import { LockEntry, readLock, writeLock, escapeRepo } from "../src/lock.wac";
import { Check } from "./check.wac";

static string LOCK = """
  {
    "imports": {
      "wac": { "git": "https://git.voltrevo.com/wac.git", "ref": "master", "commit": "f6a3724715df3a637d03ba16f30570d3539be5b4" },
      "webbuild": { "git": "https://github.com/voltrevo/wac-web.git", "ref": "6ff6", "subdir": "./tools", "commit": "6ff6b30ec7eaa2e06e0d87fe87a2b19912455177", "tree": "kt1:aa", "root": "kt1:bb" }
    }
  }
  """;

export string test_a_lock_round_trips_with_its_pins() {
  Check c = Check.create();
  LockEntry[] es = readLock(LOCK.toBytes()).ok()!;
  c.ok(es.len() == 2, "two entries");
  c.eq(es[1].subdir, "./tools", "subdir");
  c.eq(es[1].tree, "kt1:aa", "tree");
  c.eq(es[1].root, "kt1:bb", "root");
  c.eq(es[0].tree, "", "an unpinned entry has no tree");
  string again = writeLock(readLock(writeLock(es).toBytes()).ok()!);
  c.eq(again, writeLock(es), "written, read and written again");
  c.ok(writeLock(es).indexOf("\"root\"") > 0, "root is written");
  return c.report();
}

export string test_the_cache_is_named_as_wac_names_it() {
  Check c = Check.create();
  c.eq(escapeRepo("https://git.voltrevo.com/wac.git"), "https%3A%2F%2Fgit.voltrevo.com%2Fwac.git", "a URL");
  c.eq(escapeRepo("https://github.com/Voltrevo/X"), "https%3A%2F%2Fgithub.com%2F!voltrevo%2F!x", "capitals");
  return c.report();
}
