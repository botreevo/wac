// EIP-712 statements (design/system/0016 H4) against ethers: `tools/oracle/eip712.mjs` wrote every expected
// value here. Signing is RFC 6979 on both sides, so wac's signature must be ethers' byte for byte.

import { Result } from "core";
import { Claim, Statement, Verified, digest, domainSeparator, signClaim, verify, toJson, fromJson, hex, unhex } from "../src/statement.wac";
import { Check } from "./check.wac";

static string KEY = "1111111111111111111111111111111111111111111111111111111111111111";
static string ADDRESS = "19e7e376e7c213b7e7e7e46cc70a5dd086daff2a";

string rep(string two) { string out = ""; for (i32 i = 0; i < 32; i++) { out += two; } return out; }

Claim built() {
  return Claim.Built("kt1:" + rep("aa"), "examples/hello", ["wac", "build", "hello.wac", "-o", "dist/hello"],
                     "dist/hello.wasm", "kt1:" + rep("bb"), "kb1:" + rep("cc"));
}
Claim reviewed() { return Claim.Reviewed("kt1:" + rep("dd"), "all of it, \"quoted\""); }

string d(Claim c) { return match (digest(c)) { Ok(b): hex(b), Err(e): e }; }

export string test_digests_agree_with_ethers() {
  Check c = Check.create();
  c.eq(hex(domainSeparator()), "db331607a146633d769271dec4d5c740c0cd417820ebc202e53974abb38c55e1", "domain separator");
  c.eq(d(built()), "3c3e1f97177f798f7dfc03e0f539919925d735e5a9b6aab422b60ba1888189aa", "built");
  c.eq(d(reviewed()), "3cc7f9f47bc17d6337a56049556961cf1a86d1b34072003f519036a5ecb94c27", "reviewed");
  return c.report();
}

export string test_signatures_are_ethers_byte_for_byte_and_verify() {
  Check c = Check.create();
  Statement b = signClaim(built(), unhex(KEY)!).ok()!;
  c.eq(hex(b.signer), ADDRESS, "the key's address");
  c.eq(hex(b.signature), "4ad9b0373b3e37f2223c4261dc8f8a682eba73be32b94bd276e1a10f7e9b80f908d81db0feabf58c152d5b38c62de5e01c964185975148cb2b18573f986d69d71b", "built signature");
  Statement r = signClaim(reviewed(), unhex(KEY)!).ok()!;
  c.eq(hex(r.signature), "d27f20e5c4513c89bc1e3cc7307603fdce58efdb350e91dc6d2cae901f1f109e213ed63a0bddff09266047c749ef8ec6c7e2f00f912c76ecb4fc5800df5fef2f1c", "reviewed signature");
  Verified v = verify(b).ok()!;
  c.eq(hex(v.signer), ADDRESS, "recovered signer");
  c.eq(hex(v.id), d(built()), "the id is the digest");
  return c.report();
}

export string test_a_statement_survives_its_file_form() {
  Check c = Check.create();
  Statement b = signClaim(built(), unhex(KEY)!).ok()!;
  Statement back = fromJson(toJson(b).toBytes()).ok()!;
  c.ok(verify(back).isOk(), "the file form verifies");
  c.eq(toJson(back), toJson(b), "and writes back the same");
  Statement r = signClaim(reviewed(), unhex(KEY)!).ok()!;
  c.ok(verify(fromJson(toJson(r).toBytes()).ok()!).isOk(), "a review with quotes in its scope");
  return c.report();
}

export string test_a_changed_claim_or_a_wrong_signer_is_refused() {
  Check c = Check.create();
  Statement b = signClaim(built(), unhex(KEY)!).ok()!;
  // The output changed after signing: it recovers to some other key, so it is not this signer's.
  Statement forged = Statement(Claim.Built("kt1:" + rep("aa"), "examples/hello", ["wac", "build", "hello.wac", "-o", "dist/hello"],
                                           "dist/hello.wasm", "kt1:" + rep("bb"), "kb1:" + rep("ce")), b.signer, b.signature);
  c.ok(verify(forged).isErr(), "a changed output verified");
  // One more argument: also a different digest.
  Statement extra = Statement(Claim.Built("kt1:" + rep("aa"), "examples/hello", ["wac", "build", "hello.wac", "-o", "dist/hello", "--allow-net"],
                                          "dist/hello.wasm", "kt1:" + rep("bb"), "kb1:" + rep("cc")), b.signer, b.signature);
  c.ok(verify(extra).isErr(), "an added grant verified");
  // A real signature, attributed to someone else.
  Statement other = Statement(b.claim, unhex("2222222222222222222222222222222222222222")!, b.signature);
  c.ok(verify(other).isErr(), "a signature attributed to another address verified");
  // v outside 27/28, and a flipped bit in s.
  u8[] bad = u8[].filled(65, 0);
  for (i32 i = 0; i < 65; i++) { bad[i] = b.signature[i]; }
  bad[40] = bad[40] ^ 1;
  c.ok(verify(Statement(b.claim, b.signer, bad)).isErr(), "a flipped bit verified");
  bad[40] = bad[40] ^ 1;
  bad[64] = 29;
  c.ok(verify(Statement(b.claim, b.signer, bad)).isErr(), "v = 29 verified");
  return c.report();
}
