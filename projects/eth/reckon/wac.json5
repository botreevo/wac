{
  imports: {
    // keccak256, hex, JSON, fetch: what is not Ethereum's. The commit wac-eth pins, so there is one copy of it.
    // A branch, until lib.wac's bytes, http and wactest namespaces reach master.
    wac: { git: 'https://git.voltrevo.com/wac.git', ref: 'claude/ethereum-wac-package-trust-subwyf' },
    // Ethereum: `ethrpc` and `mpt`, which turn a node's answers into verified state, and wacuum's secp256k1
    // (`recover` to check a statement's signer, `sign` to make one).
    eth: { git: 'https://git.voltrevo.com/wac-eth.git', ref: 'master' },
  },
}
