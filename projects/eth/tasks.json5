{
  // Every unit test in the repository: the packages, the client and the devnet. Each member keeps its own
  // tasks.json5 for what only it has (fixtures, builds, end-to-end runs); the `wacuum:` and `devnet:` tasks
  // here run those from where they expect to be run.
  test: "wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/abi/test/wac packages/ens/test/wac packages/ethrpc/test/wac packages/lightclient/test/wac packages/mpt/test/wac packages/rlp/test/wac packages/ssz/test/wac packages/reckon/test packages/wacuum/test packages/wacuum-devnet/test",
  // Every file the manifest's `check` covers, which is all of it but the coverage ledgers.
  check: "wac check",
  // The wac commit wac.lock pins, and web's, into wac's package cache, with git.
  deps: "sh tools/deps.sh",
  "wacuum:test": "cd packages/wacuum && wac test test",
  "wacuum:build": "cd packages/wacuum && wac task build",
  "wacuum:fixtures": "cd packages/wacuum && wac task fixtures",
  "wacuum:statetests": "cd packages/wacuum && wac task statetests",
  "wacuum:blocktests": "cd packages/wacuum && wac task blocktests",
  "devnet:test": "cd packages/wacuum-devnet && wac test test",
  "devnet:build": "cd packages/wacuum-devnet && wac task build",
  "devnet:e2e": "cd packages/wacuum-devnet && wac task e2e",
  "reckon:test": "wac test packages/reckon/test",
  "reckon:build": "mkdir -p packages/reckon/dist && wac build --allow-read --allow-write --allow-run --allow-net --allow-env packages/reckon/cmd/reckon.wac -o packages/reckon/dist/reckon",
  // The whole design on a wacuum devnet, attacks included: `wac task reckon:e2e -- WORKDIR` (see the script's header).
  "reckon:e2e": "sh packages/reckon/tools/e2e.sh",
}
