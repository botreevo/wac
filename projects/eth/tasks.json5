{
  // Every unit test in the repository: the packages, the client and the devnet. Each member keeps its own
  // tasks.json5 for what only it has (fixtures, builds, end-to-end runs); the `wacuum:` and `devnet:` tasks
  // here run those from where they expect to be run.
  // Every unit test, one package per invocation: aggregated into one module across packages, wacc refuses to emit it
  // ("a constant whose value is not a constant expression") for some combinations that pass apart
  // (packages/reckon/docs/wacc-cases/README.md).
  test: "wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/abi/test/wac && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/ens/test/wac && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/ethrpc/test/wac && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/ipfs/test && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/lightclient/test/wac && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/mpt/test/wac && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/rlp/test/wac && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/ssz/test/wac && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/reckon/test && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/wacuum/test && wac test --allow-read --allow-write --allow-run --allow-env --allow-net packages/wacuum-devnet/test",
  // Every file the manifest's `check` covers, which is all of it but the coverage ledgers.
  check: "wac check",
  // The wac commit wac.lock pins, and web's, into wac's package cache, with git.
  deps: "sh tools/deps.sh",
  "wacuum:test": "cd packages/wacuum && wac test test",
  "wacuum:build": "cd packages/wacuum && wac task build",
  "wacuum:fixtures": "cd packages/wacuum && wac task fixtures",
  "wacuum:statetests": "cd packages/wacuum && wac task statetests",
  "wacuum:blocktests": "cd packages/wacuum && wac task blocktests",
  "devnet:test": "cd packages/wacuum-devnet && wac test test",
  "devnet:build": "cd packages/wacuum-devnet && wac task build",
  "devnet:e2e": "cd packages/wacuum-devnet && wac task e2e",
  "reckon:test": "wac test packages/reckon/test",
  // The registry v2 on a wacuum devnet: deploy, revoke, reject, name, a lying node, a wrong code hash (see the script's header).
  "reckon:registry2": "sh packages/reckon/tools/registry2.sh",
  // Chain reads anchored by the light client: recorded mainnet (vitalik.eth), then a devnet. docs/anchoring.md.
  "reckon:anchor": "sh packages/reckon/tools/anchor.sh",
  // One command from a checkpoint to a decision, on recorded mainnet data: docs/admit.md.
  "reckon:admit": "sh packages/reckon/tools/admit-by-name.sh",
  // The motivating case end to end, in one run: docs/capstone.md. Needs WASMTIME_WAC; QUICK=1 skips the self-build.
  "reckon:capstone": "sh packages/reckon/tools/capstone.sh",
  // Claims published to mirrors and fetched over HTTP, each statement verified: docs/claims-mirror.md.
  "reckon:mirror": "sh packages/reckon/tools/claims-mirror.sh",
  // An ENS name to a decision: recorded mainnet (vitalik.eth from a beacon root), then a devnet name → CID → tree → admit.
  "reckon:byname": "sh packages/reckon/tools/byname.sh",
  // obj reading a store directory served over HTTP as a trustless gateway, and refusing a tampered block.
  "ipfs:http": "sh packages/ipfs/tools/http-mirror.sh",
  // The deterministic machine's corpus on V8, and on wasmtime when WASMTIME_WAC names the native host's `wac`.
  "reckon:machine": "sh packages/reckon/tools/machine.sh",
  // Attested derivations end to end: two runners, a reviewer, a policy, and three ways to lose admission.
  // Needs WASMTIME_WAC, the native host's `wac`.
  "reckon:demo": "sh packages/reckon/tools/demo.sh",
  // Admit, fetch, check and run in one command (`claim run`): the sealed machine, --out, and what does not run.
  "reckon:run": "sh packages/reckon/tools/run.sh",
  // wac.lock pinned by CID (cmd/deps.wac, docs/lock.md): pin, check, fetch from a mirror or git, admit. Needs network.
  "reckon:deps": "sh packages/reckon/tools/deps-lock.sh",
  // Milestone 1 of docs/browser-extension.md: admission through cmd/web.wac, on the command line and in headless
  // Chromium, tampered answers refused there too (needs deno, and WAC_SRC: a wac checkout at the pin).
  "reckon:browser": "sh packages/reckon/tools/browser-admit.sh",
  // The MV3 extension's shell (milestone 2) under Playwright's Chromium: isolation, the loader, an app in OPFS shown.
  "reckon:extension": "node packages/reckon/extension/test/shell.cjs",
  // Milestone 3: the extension admits (its own wasm, the light client in its page) and shows what it admitted.
  // Needs WAC_SRC and deno, for extension/build.sh. `wac task reckon:extension-admit -- WORKDIR`.
  "reckon:extension-admit": "sh packages/reckon/extension/test/admit.sh",
  // Builds as derivations: wac's compiler run by the machine, building an app and (SELF=1) itself, to a fixed point.
  // Needs WASMTIME_WAC and the pinned wac in the package cache (sh tools/deps.sh).
  "reckon:selfbuild": "sh packages/reckon/tools/selfbuild.sh",
  // A build with dependencies as a derivation: wac-eth's obj, from wac-eth's source and the locked packages. Steps
  // outside the machine for the environment (see the script). Needs WASMTIME_WAC.
  "reckon:builddeps": "sh packages/reckon/tools/builddeps.sh",
  // Decision D, milestone 1: the compiler from wac's bootstrap ladder meets the seed's, inside the machine on both engines
  // (docs/bootstrap-derivations.md). Needs WASMTIME_WAC, the pinned wac in the package cache, and cargo or LADDER.
  "reckon:ladder": "sh packages/reckon/tools/ladder.sh",
  // Decision D, milestone 2: wac-L0 as a machine, wac-l0/1, with wac's Rust and JavaScript assemblers as its two
  // runners (docs/l0-machine.md). Needs node, cargo and the pinned wac in the package cache; LADDER adds wacc's L0.
  "reckon:l0": "sh packages/reckon/tools/l0.sh",
  // Decision D: the flattener as a machine, wac-flatten/1, with wac's JavaScript and Rust flatteners as its runners
  // (docs/flatten-machine.md). Needs node and LADDER (or cargo to build it).
  "reckon:flatten": "sh packages/reckon/tools/flatten.sh",
  // The NaN rewrite's elision against checking everything, on random programs and both engines: docs/canonfuzz.md.
  "reckon:canonfuzz": "sh packages/reckon/tools/canonfuzz.sh",
}
