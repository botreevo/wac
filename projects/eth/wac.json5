{
  // **wac-eth**: the Ethereum packages, the execution client and its devnet, on one pin of wac. They were three
  // repositories until 2026-11-09 — the packages lived in wac, wacuum and wacuum-devnet in their own — and every one
  // pinned wac separately, so a program using two of them carried two copies of wac's library.
  //
  // `lib.wac` is what another project gets: `import { mpt.storageAt, rlp.encode } from "eth"`, given
  // `eth: { git: 'https://git.voltrevo.com/wac-eth.git', ref: … }` in its own manifest.
  exports: './lib.wac',
  imports: {
    // The language, and the packages that are not Ethereum's: crypto (keccak256 among them), bls, json, codec,
    // bytes, http, wactest.
    wac: { git: 'https://github.com/voltrevo/wac.git', ref: 'aaef775ca2d1d93f1706c520454cfadd0bf9d382' },
    // The devnet's pages: components rendered on the server. It imports nothing, so it brings no second wac.
    web: { git: 'https://github.com/voltrevo/wac.git', ref: '3dd6bc99c4c8d6c27e2173309370956815877730', subdir: './projects/web' },
    // wac-web's page builder, as a package: reckon's demo app builds its page with it inside the sealed machine, in
    // the builder's own two halves (cmd/pagebuild.wac), and so it is pinned with web.
    webbuild: { git: 'https://github.com/voltrevo/wac.git', ref: '3dd6bc99c4c8d6c27e2173309370956815877730', subdir: './projects/web/tools' },
  },
  check: {
    // The coverage ledgers drive wac's tools/wac/covledger.wac, which runs only inside wac's own checkout.
    // issues/open/1001 is about bringing them back.
    exclude: ['./packages/*/test/cov_ledger.wac', './packages/*/test/cov_exercise.wac',
              './packages/reckon/docs/**'],
  },
}
