# systemd unit for the devnet. Assumes a `wacuum` user whose ~/.wac/bin/wac is built from wac.lock's wac
# commit (`./bootstrap.sh --host nodejs`: the Node host runs wacuum two to four times as fast as wasmtime),
# and this repository at /opt/wacuum-devnet with `wac task build` run in it.
#
#     sudo cp deploy/wacuum-devnet.service /etc/systemd/system/ && sudo systemctl enable --now wacuum-devnet
[Unit]
Description=wacuum devnet: chain, explorer and faucet
After=network-online.target
Wants=network-online.target

[Service]
User=wacuum
Environment=PATH=/home/wacuum/.wac/bin:/usr/local/bin:/usr/bin:/bin
StateDirectory=wacuum-devnet
ExecStart=/opt/wacuum-devnet/dist/devnet --datadir /var/lib/wacuum-devnet --site-url https://wacuum.voltrevo.com
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
