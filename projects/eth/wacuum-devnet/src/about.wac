// /about: what this devnet is, what runs it, and how to use it — drawn like every other page, by `documentOf`
// over `web`'s components, with no script.
//
// The figures in it are measured, not estimated: the fixture counts are wacuum's README's, against
// execution-spec-tests v5.4.0; the line counts are `wc -l` over wacuum's `src/` and this repository's `src/`
// and `cmd/` at the commits this was written against, and the module's size is `wac task build`'s. Change them when they stop being true.

import { U256 } from "wacuum";
import { Node, Ui, html.img, html.a, html.code, html.div, html.h1, html.h2, html.h3, html.li, html.ol, html.p, html.pre,
         html.section, html.span, html.strong, html.table, html.tbody, html.td, html.th, html.thead, html.tr,
         html.ul } from "web";
import { Site, page } from "./explorer.wac";

/** A figure and what it counts. */
Node Figure(Ui ui, string value, string label) {
  return <div class="figure"><div class="figure-value">{value}</div><div class="figure-label">{label}</div></div>;
}

/** One stage a request passes through, for the diagram. */
Node Stage(Ui ui, string kind, string title, string detail) {
  return <div class={"stage " + kind}><div class="stage-title">{title}</div><div class="stage-detail">{detail}</div></div>;
}

Node Arrow(Ui ui) { return <"div" class="arrow" aria-hidden="true"></"div">; }

/** A part of the client, and what it does. */
Node Part(Ui ui, string title, string body) {
  return <div class="part"><h3>{title}</h3><p>{body}</p></div>;
}

Node Fixture(Ui ui, string suite, string cancun, string prague, string osaka) {
  return <tr><th>{suite}</th><td class="num">{cancun}</td><td class="num">{prague}</td><td class="num">{osaka}</td></tr>;
}

Node Step(Ui ui, string title, Node body) {
  return <li class="step"><div class="step-title">{title}</div><div class="step-body">{body}</div></li>;
}

export string about(Site site) {
  string rpc = site.url + "/rpc";
  string chainHex = U256.ofU64(site.chainId).toHex();
  string curl = "curl -s " + rpc + " -H 'content-type: application/json' \\\n" +
                "  -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}'";
  string cast = "cast block-number --rpc-url " + rpc + "\n" +
                "cast send --rpc-url " + rpc + " --private-key $KEY 0x… --value 1ether";
  return page(site, "About", <div class="about">
    <section class="about-hero">
      <div class="about-hero-text">
      <p class="eyebrow">About this devnet</p>
      <h1>An Ethereum chain whose every block is made by a client written from scratch.</h1>
      <p class="lede">The blocks here are built and executed by <strong>wacuum</strong>, an execution client written
      in <strong>wac</strong>, a language for WebAssembly. The same program serves this site: the explorer, the faucet and
      the JSON-RPC your wallet talks to. There is no geth, no Reth and no JavaScript underneath it.</p>
      </div>
      <img class="about-logo" src="/logo.avif" alt="wacuum: a vacuum cleaner with a face, picking up blocks" width="360" height="261"/>
      <div class="figures">
        <Figure value="~10,700" label="lines of wac in the client"/>
        <Figure value="every" label="execution-spec-tests fixture passes, Cancun to Osaka"/>
        <Figure value="~780 KB" label="one module: the node, the explorer and the faucet"/>
        <Figure value="0" label="lines of script this site runs in your browser"/>
      </div>
    </section>

    <section class="about-section">
      <h2>One program, from your wallet to the disk</h2>
      <p class="section-lede">Everything to the right of Caddy is a single wac program, about 1,800 lines of its own
      on top of wacuum, compiled to one WebAssembly module.</p>
      <div class="flow">
        <Stage kind="outside" title="You" detail="a browser, a wallet, ethers, Foundry"/>
        <Arrow/>
        <Stage kind="outside" title="Caddy" detail="TLS, HTTP/2, and the patience slow clients need"/>
        <Arrow/>
        <div class="program">
          <div class="program-label">wacuum-devnet · one wac program</div>
          <div class="program-row">
            <Stage kind="inside" title="Explorer" detail="pages drawn on the server"/>
            <Stage kind="inside" title="JSON-RPC" detail="eth_, net_, web3_ at /rpc"/>
            <Stage kind="inside" title="Faucet" detail="signs its own transfers"/>
          </div>
          <div class="program-core">
            <div class="stage-title">wacuum's engine</div>
            <div class="stage-detail">the EVM, the state and its tries, the mempool, and a block every
            {" \{site.blockSeconds} "}seconds</div>
          </div>
        </div>
        <Arrow/>
        <Stage kind="outside" title="Disk" detail="every block logged before it is answered for; snapshots"/>
      </div>
    </section>

    <section class="about-section">
      <h2>wacuum, the client</h2>
      <p class="section-lede">An execution client is the half of an Ethereum node that runs transactions and keeps
      the state. wacuum is one, written without borrowing an EVM, a trie or a curve from anywhere else.</p>
      <div class="parts">
        <Part title="The EVM" body="Every opcode through Osaka, with each fork's gas rules. Calls run on a stack of the interpreter's own, so 1024-deep calls work on any host."/>
        <Part title="Every precompile" body="ecrecover, SHA-256, RIPEMD-160, MODEXP, bn254 and its pairing, BLAKE2F, KZG point evaluation, the seven BLS12-381 operations and P256VERIFY, all in wac."/>
        <Part title="State and tries" body="One journal undoes a failed call. The Merkle-Patricia tries are kept between blocks, and a root rehashes only the paths to what changed."/>
        <Part title="Blocks" body="Header rules, system calls, withdrawals, EIP-7685 requests and blob gas, with every root and the bloom checked. A block that fails leaves no trace."/>
        <Part title="Engine API and JSON-RPC" body="What a consensus client steers it with, and what wallets and libraries read it with, over HTTP with JWT authentication."/>
        <Part title="devp2p" body="RLPx, snappy, eth/69 and discovery v4. It syncs from geth, and geth syncs from it."/>
      </div>
      <div class="card fixtures">
        <h3>Against the reference tests</h3>
        <p class="muted">Every fixture of execution-spec-tests v5.4.0 passes, and every transition between forks.</p>
        <table class="list">
          <thead><tr><th></th><th class="num">Cancun</th><th class="num">Prague</th><th class="num">Osaka</th></tr></thead>
          <tbody>
            <Fixture suite="State tests" cancun="16,847" prague="18,869" osaka="19,517"/>
            <Fixture suite="Blockchain tests, from block RLP" cancun="17,685" prague="20,859" osaka="21,558"/>
            <Fixture suite="Engine API tests" cancun="17,685" prague="20,878" osaka="21,577"/>
            <Fixture suite="Blocks rebuilt from the mempool" cancun="17,685" prague="20,878" osaka="21,577"/>
          </tbody>
        </table>
      </div>
    </section>

    <section class="about-section">
      <h2>wac, the language</h2>
      <div class="split">
        <div>
          <p>wac is a C-family language that compiles to WebAssembly with garbage collection. Its compiler is written
          in wac, and is built from a ladder of compilers whose lowest rung is WebAssembly text written by hand: no
          other language's toolchain is needed to have it.</p>
          <p>A wac program reaches nothing it was not handed. This one was granted three things — to read files, to
          write them, and the network — and its built module says so; the host refuses it anything else.</p>
        </div>
        <div>
          <p>The same module runs on Node, on V8 directly, and on wasmtime, which has no JavaScript in it at all.</p>
          <p>The pages of this site are <strong>web</strong>'s components, the ones a wac program mounts in a browser,
          rendered here on the server instead: every value from the chain is escaped on its way out, and the browser is
          sent HTML and a stylesheet, and a policy that lets it run nothing else.</p>
        </div>
      </div>
    </section>

    <section class="about-section">
      <h2>Using it</h2>
      <ol class="steps">
        <Step title="Add the network" body={<div>
          <table class="kv"><tbody>
            <tr><th>Network name</th><td>{site.name}</td></tr>
            <tr><th>RPC URL</th><td><code class="mono wrap-any">{rpc}</code></td></tr>
            <tr><th>Chain id</th><td><code class="mono">{"\{site.chainId} (\{chainHex})"}</code></td></tr>
            <tr><th>Currency</th><td>ETH</td></tr>
          </tbody></table>
        </div>}/>
        <Step title="Take some ether" body={<p>The <a href="/">faucet</a> sends {site.faucetAmount} to any address, once every
          {" " + site.faucetCooldown} for each address and each visitor.</p>}/>
        <Step title="Point your tools at it" body={<div>
          <pre class="code"><code>{curl}</code></pre>
          <pre class="code"><code>{cast}</code></pre>
          <p class="muted">Anything that speaks JSON-RPC works the same way: ethers, viem, web3.py, a wallet.</p>
        </div>}/>
      </ol>
    </section>

    <section class="about-section fine-print">
      <h2>The fine print</h2>
      <ul>
        <li>The ether here is worth nothing, and the chain may be started again from nothing.</li>
        <li>One node makes every block and there is no consensus layer, so each block is final the moment it is made.</li>
        <li>The explorer keeps a day of blocks; older ones, and the receipts of transactions from before the node last
        restarted, are not kept.</li>
        <li>Don't send anything here that is worth something anywhere else.</li>
      </ul>
      <p class="sources">The source, on GitHub: <a href="https://github.com/voltrevo/wacuum">wacuum</a>
      {" · "}<a href="https://github.com/voltrevo/wac">wac</a></p>
    </section>
  </div>);
}
