// Generated by tools/gen-assets.py from assets/ — edit those files and run it again.

export static string STYLE = ":root {\n  --bg: #f6f7fb; --card: #ffffff; --text: #1b1f2a; --muted: #687087; --line: #e3e6ef;\n  --accent: #5b4cf0; --accent-ink: #ffffff; --ok: #137a3f; --ok-bg: #e2f6ea; --bad: #b42318; --bad-bg: #fde8e7;\n  --wait: #8a5a00; --wait-bg: #fff3d6;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #0f1117; --card: #171a23; --text: #e7e9f0; --muted: #98a0b6; --line: #262b38;\n    --accent: #8b7fff; --accent-ink: #0f1117; --ok: #5fd28f; --ok-bg: #12301f; --bad: #ff8a80; --bad-bg: #3a1614;\n    --wait: #ffc860; --wait-bg: #3a2c0c;\n  }\n}\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--bg); color: var(--text);\n  font: 15px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\na { color: var(--accent); text-decoration: none; }\na:hover { text-decoration: underline; }\n.wrap { max-width: 1180px; margin: 0 auto; padding: 0 16px; }\nheader { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; padding: 18px 0; }\n.brand { font-weight: 700; font-size: 18px; color: var(--text); }\n.logo { color: var(--accent); }\nform.search { display: flex; gap: 8px; flex: 1 1 380px; max-width: 560px; }\ninput { flex: 1; min-width: 0; padding: 9px 12px; border: 1px solid var(--line); border-radius: 8px;\n  background: var(--card); color: var(--text); font: inherit; }\nbutton { padding: 9px 16px; border: 0; border-radius: 8px; background: var(--accent); color: var(--accent-ink);\n  font: inherit; font-weight: 600; cursor: pointer; white-space: nowrap; }\nbutton.secondary { background: transparent; color: var(--accent); border: 1px solid var(--line); }\nh1 { font-size: 26px; margin: 8px 0 12px; }\nh2 { font-size: 17px; margin: 0 0 12px; }\n.hero p { max-width: 760px; color: var(--muted); margin-top: 0; }\n.card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px; margin: 0 0 16px;\n  overflow-x: auto; }\n.narrow { max-width: 720px; }\n.columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 16px; }\n.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 0 0 16px; }\n.stat { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; }\n.stat-label { color: var(--muted); font-size: 13px; }\n.stat-value { font-size: 20px; font-weight: 650; font-variant-numeric: tabular-nums; }\ntable { width: 100%; border-collapse: collapse; }\nth, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }\nthead th { color: var(--muted); font-weight: 500; font-size: 13px; }\ntable.kv th { width: 180px; color: var(--muted); font-weight: 500; }\ntr:last-child td, tr:last-child th { border-bottom: 0; }\n.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13.5px; }\n.wrap-any { overflow-wrap: anywhere; word-break: break-all; }\n.big { font-size: 16px; }\n.input { display: block; max-height: 220px; overflow: auto; }\n.muted { color: var(--muted); }\n.badge { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 13px; font-weight: 600; }\n.ok { color: var(--ok); background: var(--ok-bg); }\n.bad { color: var(--bad); background: var(--bad-bg); }\n.wait { color: var(--wait); background: var(--wait-bg); }\n.in { color: var(--ok); background: var(--ok-bg); }\n.out { color: var(--wait); background: var(--wait-bg); }\nform.faucet { display: flex; flex-wrap: wrap; gap: 8px; }\n.pager { display: flex; justify-content: space-between; margin-top: 8px; }\nfooter { color: var(--muted); font-size: 13px; padding: 24px 0 40px; }\ntable.list .mono { white-space: nowrap; }\n";
export static string WALLET_JS = "// The one script the site runs: offering the chain to a browser wallet, and filling the faucet's form with\n// the wallet's address. Everything else on these pages is HTML drawn by the node.\n(function () {\n  var add = document.getElementById(\"add-network\");\n  var status = document.getElementById(\"add-network-status\");\n  var mine = document.getElementById(\"use-wallet\");\n  var field = document.querySelector(\"form.faucet input[name=address]\");\n  function say(text) { if (status) status.textContent = \" \" + text; }\n  if (!window.ethereum) {\n    if (add) add.disabled = true;\n    if (mine) mine.hidden = true;\n    say(\"No browser wallet found: add the network by hand with the details above.\");\n    return;\n  }\n  if (add) add.addEventListener(\"click\", function () {\n    var d = add.dataset;\n    window.ethereum.request({ method: \"wallet_addEthereumChain\", params: [{\n      chainId: d.chainId, chainName: d.name, rpcUrls: [d.rpc], blockExplorerUrls: [d.explorer],\n      nativeCurrency: { name: \"Ether\", symbol: \"ETH\", decimals: 18 }\n    }] }).then(function () { say(\"Added.\"); }, function (e) { say(e && e.message ? e.message : \"The wallet said no.\"); });\n  });\n  if (mine && field) mine.addEventListener(\"click\", function () {\n    window.ethereum.request({ method: \"eth_requestAccounts\" }).then(function (accounts) {\n      if (accounts && accounts[0]) field.value = accounts[0];\n    }, function () {});\n  });\n})();\n";
export static string FAVICON = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><path d=\"M16 2 28 16 16 30 4 16z\" fill=\"#5b4cf0\"/><path d=\"M16 8 23 16 16 24 9 16z\" fill=\"#ffffff\" opacity=\".85\"/></svg>\n";
