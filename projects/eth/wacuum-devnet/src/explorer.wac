// The site: the explorer's pages and the faucet's, drawn on the server with `web`'s components.
//
// **Drawn here, not in the browser.** A `web` page runs in a worker with no network grant, so it cannot ask
// the node anything; and an explorer is links and tables, which is what HTML already is. So each page is a
// tree of components rendered once by `documentOf`, every string in it escaped on the way out, and the
// browser runs no script at all: the policy every page carries says so.

import { json.JsonValue, json.JsonArray } from "wac";
import { U256, Engine } from "wacuum";
import { Head, Node, Ui, documentOf, html.a, html.b, html.button, html.code, html.div, html.footer, html.form,
         html.h1, html.h2, html.header, html.input, html.label, html.main, html.nav, html.p, html.section,
         html.span, html.strong, html.table, html.tbody, html.td, html.th, html.thead, html.tr } from "web";
import { etherText, gweiText, grouped, short, ago, gasShare, quantityOf, smallOf } from "./format.wac";
import { Index, TxRef, latest, touching, byHash, fullBlock, lowerHex } from "./index.wac";
import { Drip } from "./faucet.wac";

/** What every page knows about the site: names, links, the chain, the faucet's terms. */
export struct Site {
  string name;
  /** Where the site is, as the public sees it: "https://wacuum.voltrevo.com". */
  string url;
  u64 chainId;
  string faucetAddress;
  string faucetAmount;
  string faucetCooldown;
  i32 blockSeconds;
}

/** The policy every page carries: no script, nothing from elsewhere, the stylesheet from here, forms to here. */
static string POLICY = "default-src 'none'; style-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'none'";

/** A whole page: the header and its search box, `body`, and the footer. */
export string page(Site site, string title, Node body) {
  Head head = Head(title == "" ? site.name : title + " · " + site.name,
                   "An Ethereum devnet run by wacuum, an execution client written in wac: block explorer and faucet.",
                   POLICY, ["/style.css"], string[](), "/favicon.svg");
  return documentOf(head, <div class="wrap">
    <header>
      <nav class="top">
        <a class="brand" href="/"><span class="logo">◆</span> {site.name}</a>
        <a class="navlink" href="/about">About</a>
      </nav>
      <form class="search" method="get" action="/search">
        <"input" name="q" placeholder="Block number, block or transaction hash, or address" aria-label="Search"/>
        <button type="submit">Search</button>
      </form>
    </header>
    <main>{body}</main>
    <footer>
      <p>Blocks made and executed by <a href="https://git.voltrevo.com/wacuum.git">wacuum</a>, an Ethereum execution
      client written in <a href="https://git.voltrevo.com/wac.git">wac</a>. This page was drawn by the same program.
      {" "}<a href="/about">How it works</a>.</p>
    </footer>
  </div>);
}

// ── Pieces ─────────────────────────────────────────────────────────────────────

Node BlockLink(Ui ui, u64 n) { return <a href={"/block/\{n}"}>{grouped("\{n}")}</a>; }

Node TxLink(Ui ui, string hash) { return <a class="mono" href={"/tx/" + hash}>{short(hash)}</a>; }

/** An address, linked; `whole` shows all of it rather than its ends. */
Node AddressLink(Ui ui, string address, bool whole) {
  if (address == "") { return <span class="muted">—</span>; }
  return <a class={whole ? "mono wrap-any" : "mono"} href={"/address/" + address}>{whole ? address : short(address)}</a>;
}

/** A label and its value, as one row of a definition table. */
Node Row(Ui ui, string label, Node value) { return <tr><th>{label}</th><td>{value}</td></tr>; }

Node Text(Ui ui, string text) { return <span>{text}</span>; }

Node Mono(Ui ui, string text) { return <code class="mono wrap-any">{text}</code>; }

Node Stat(Ui ui, string label, string value) {
  return <div class="stat"><div class="stat-label">{label}</div><div class="stat-value">{value}</div></div>;
}

JsonValue? rpc(Engine e, string method, JsonValue[] args) {
  JsonArray ps = JsonArray.create();
  for (JsonValue v in args) { ps.push(v); }
  return e.call(method, JsonValue.Array(ps)).result;
}

JsonValue str(string s) { return JsonValue.Str(s.toBytes()); }

string field(JsonValue? v, string name) { return v?.member(name)?.text() ?? ""; }

// ── The home page ──────────────────────────────────────────────────────────────

/** The chain at a glance, the latest blocks and transactions, the faucet, and how to connect a wallet. */
export string home(Site site, Engine e, Index ix, u64 now) {
  u64 head = smallOf(rpc(e, "eth_blockNumber", JsonValue[]())?.text());
  JsonValue? top = rpc(e, "eth_getBlockByNumber", [str("latest"), JsonValue.Bool(false)]);
  Node[] blocks = Node[].filled(0, Node.Text(""));
  i32 shown = head + 1 < 15 ? (head + 1) as! i32 : 15;
  blocks = Node[].filled(shown, Node.Text(""));
  for (i32 i = 0; i < shown; i++) {
    u64 n = head - ((i as i64) as@ u64);
    JsonValue? b = rpc(e, "eth_getBlockByNumber", [str(U256.ofU64(n).toHex()), JsonValue.Bool(false)]);
    i32 txs = b?.member("transactions")?.array()?.len() ?? 0;
    blocks[i] = <tr key={"\{n}"}>
      <td><BlockLink n={n}/></td>
      <td class="muted">{n == 0 ? "the genesis" : ago(smallOf(field(b, "timestamp")), now)}</td>
      <td class="num">{"\{txs}"}</td>
      <td class="num">{grouped(quantityOf(field(b, "gasUsed")).toDecimal())}</td>
    </tr>;
  }
  TxRef[] recent = latest(ix, 15);
  Node[] txRows = Node[].filled(recent.len(), Node.Text(""));
  for (i32 i = 0; i < recent.len(); i++) {
    TxRef t = recent[i];
    txRows[i] = <tr key={t.hash}>
      <td><TxLink hash={t.hash}/></td>
      <td><AddressLink address={t.from} whole={false}/></td>
      <td><AddressLink address={t.to} whole={false}/></td>
      <td class="num">{etherText(quantityOf(t.value))}</td>
    </tr>;
  }
  string chainHex = U256.ofU64(site.chainId).toHex();
  return page(site, "", <div>
    <section class="hero">
      <h1>{site.name}</h1>
      <p>An Ethereum devnet whose every block is built and executed by <strong>wacuum</strong>, an execution client
      written from scratch in wac. {site.blockSeconds == 1 ? "A block every second" : "A block every \{site.blockSeconds} seconds"}, Osaka's rules, and ether that is
      worth nothing: take some from the faucet and try things.</p>
    </section>
    <section class="stats">
      <Stat label="Latest block" value={grouped("\{head}")}/>
      <Stat label="Base fee" value={gweiText(quantityOf(field(top, "baseFeePerGas")))}/>
      <Stat label="Transactions" value={grouped("\{ix.transactions}")}/>
      <Stat label="Waiting in the mempool" value={"\{e.mempool.len()}"}/>
      <Stat label="Chain id" value={"\{site.chainId}"}/>
    </section>
    <div class="columns">
      <section class="card">
        <h2>Faucet</h2>
        <p>{site.faucetAmount} to any address, once every {site.faucetCooldown} for each address and each visitor.</p>
        <form method="post" action="/faucet" class="faucet">
          <"input" name="address" placeholder="0x… your address" aria-label="Your address" autocomplete="off" spellcheck="false"/>
          <button type="submit">Send me ether</button>
        </form>
      </section>
      <section class="card">
        <h2>Connect a wallet</h2>
        <table class="kv"><tbody>
          <Row label="Network name" value={<Text text={site.name}/>}/>
          <Row label="RPC URL" value={<Mono text={site.url + "/rpc"}/>}/>
          <Row label="Chain id" value={<Mono text={"\{site.chainId} (\{chainHex})"}/>}/>
          <Row label="Currency" value={<Text text="ETH"/>}/>
        </tbody></table>
        <p class="muted">In a wallet, add a network with these details, or point a library at the RPC URL.</p>
      </section>
    </div>
    <div class="columns">
      <section class="card">
        <h2>Latest blocks</h2>
        <table class="list">
          <thead><tr><th>Block</th><th>Made</th><th class="num">Txs</th><th class="num">Gas used</th></tr></thead>
          <tbody>{blocks}</tbody>
        </table>
      </section>
      <section class="card">
        <h2>Latest transactions</h2>
        {recent.len() == 0
          ? <p class="muted">None yet. The faucet makes the first.</p>
          : <table class="list">
              <thead><tr><th>Hash</th><th>From</th><th>To</th><th class="num">Value</th></tr></thead>
              <tbody>{txRows}</tbody>
            </table>}
      </section>
    </div>
  </div>);
}

// ── A block ────────────────────────────────────────────────────────────────────

/** The block numbered or hashed `id`, or null when there is no such block. */
export string? block(Site site, Engine e, Index ix, string id, u64 now) {
  // By hash, the header alone says which number to take from the cache.
  U256? n = null;
  if (id.len() == 66 && id.indexOf("0x") == 0) {
    JsonValue? h = rpc(e, "eth_getBlockByHash", [str(id), JsonValue.Bool(false)]);
    if (h is not null && !h!.isNull()) { n = quantityOf(field(h, "number")); }
  } else {
    n = decimal(id);
  }
  if (n is null || !n!.fitsU64()) { return null; }
  JsonValue? b = fullBlock(ix, e, n!.low());
  if (b is null || b!.isNull()) { return null; }
  JsonValue blk = b!;
  u64 n = smallOf(field(blk, "number"));
  JsonArray txs = blk.member("transactions")?.array() ?? JsonArray.create();
  Node[] rows = Node[].filled(txs.len(), Node.Text(""));
  for (i32 i = 0; i < txs.len(); i++) {
    JsonValue t = txs.get(i);
    rows[i] = <tr key={field(t, "hash")}>
      <td class="num">{"\{i}"}</td>
      <td><TxLink hash={field(t, "hash")}/></td>
      <td><AddressLink address={lowerHex(field(t, "from"))} whole={false}/></td>
      <td><AddressLink address={lowerHex(field(t, "to"))} whole={false}/></td>
      <td class="num">{etherText(quantityOf(field(t, "value")))}</td>
    </tr>;
  }
  u64 ts = smallOf(field(blk, "timestamp"));
  u64 head = smallOf(rpc(e, "eth_blockNumber", JsonValue[]())?.text());
  return page(site, "Block \{n}", <div>
    <nav class="pager">
      {n > 0 ? <a href={"/block/\{n - 1}"}>← Block {grouped("\{n - 1}")}</a> : <span></span>}
      {n < head ? <a href={"/block/\{n + 1}"}>Block {grouped("\{n + 1}")} →</a> : <span></span>}
    </nav>
    <h1>Block {grouped("\{n}")}</h1>
    <section class="card">
      <table class="kv"><tbody>
        <Row label="Hash" value={<Mono text={field(blk, "hash")}/>}/>
        <Row label="Parent" value={n == 0 ? <Mono text={field(blk, "parentHash")}/> : <a class="mono wrap-any" href={"/block/" + field(blk, "parentHash")}>{field(blk, "parentHash")}</a>}/>
        <Row label="Made" value={<Text text={n == 0 ? "the genesis" : ago(ts, now) + " (unix time \{ts})"}/>}/>
        <Row label="Transactions" value={<Text text={"\{txs.len()}"}/>}/>
        <Row label="Gas used" value={<Text text={gasShare(quantityOf(field(blk, "gasUsed")), quantityOf(field(blk, "gasLimit")))}/>}/>
        <Row label="Gas limit" value={<Text text={grouped(quantityOf(field(blk, "gasLimit")).toDecimal())}/>}/>
        <Row label="Base fee" value={<Text text={gweiText(quantityOf(field(blk, "baseFeePerGas")))}/>}/>
        <Row label="Blob gas used" value={<Text text={grouped(quantityOf(field(blk, "blobGasUsed")).toDecimal())}/>}/>
        <Row label="Fee recipient" value={<AddressLink address={lowerHex(field(blk, "miner"))} whole={true}/>}/>
        <Row label="State root" value={<Mono text={field(blk, "stateRoot")}/>}/>
        <Row label="Transactions root" value={<Mono text={field(blk, "transactionsRoot")}/>}/>
        <Row label="Receipts root" value={<Mono text={field(blk, "receiptsRoot")}/>}/>
        <Row label="Size" value={<Text text={grouped("\{smallOf(field(blk, "size"))}") + " bytes"}/>}/>
      </tbody></table>
    </section>
    {txs.len() == 0 ? <p class="muted">No transactions in this block.</p> : <section class="card">
      <h2>Transactions</h2>
      <table class="list">
        <thead><tr><th class="num">#</th><th>Hash</th><th>From</th><th>To</th><th class="num">Value</th></tr></thead>
        <tbody>{rows}</tbody>
      </table>
    </section>}
  </div>);
}

// ── A transaction ──────────────────────────────────────────────────────────────

/** The transaction `hash`, in the mempool or in a block; null when there is no such transaction. */
export JsonValue? findTransaction(Engine e, Index ix, string hash) {
  JsonValue? t = rpc(e, "eth_getTransactionByHash", [str(hash)]);
  if (t is not null && !t!.isNull()) { return t; }
  // From before the snapshot the node started at: the engine has the block, so take it from there.
  TxRef? ref = byHash(ix, hash);
  if (ref is null) { return null; }
  return fullBlock(ix, e, ref!.block)?.member("transactions")?.item(ref!.position);
}

export string? transaction(Site site, Engine e, Index ix, string hash, u64 now) {
  JsonValue? t = findTransaction(e, ix, hash);
  if (t is null || t!.isNull()) { return null; }
  JsonValue tx = t!;
  JsonValue? found = rpc(e, "eth_getTransactionReceipt", [str(hash)]);
  JsonValue? r = found is null || found!.isNull() ? null : found;
  // In a block, or still waiting for one; and in a block, with its receipt or (before a snapshot) without.
  bool pending = field(tx, "blockNumber") == "";
  bool receipt = r is not null;
  string status = pending ? "Waiting in the mempool for the next block"
                : !receipt ? "In a block from before the node's last restart, whose receipt it did not keep"
                : field(r, "status") == "0x1" ? "Succeeded" : "Failed (reverted)";
  string to = lowerHex(field(tx, "to"));
  string created = lowerHex(field(r, "contractAddress"));
  JsonArray logs = r?.member("logs")?.array() ?? JsonArray.create();
  Node[] logRows = Node[].filled(logs.len(), Node.Text(""));
  for (i32 i = 0; i < logs.len(); i++) {
    JsonValue l = logs.get(i);
    JsonArray topics = l.member("topics")?.array() ?? JsonArray.create();
    Node[] ts = Node[].filled(topics.len(), Node.Text(""));
    for (i32 k = 0; k < topics.len(); k++) { ts[k] = <div class="mono wrap-any">{topics.get(k).text() ?? ""}</div>; }
    logRows[i] = <tr key={"\{i}"}>
      <td class="num">{"\{i}"}</td>
      <td><AddressLink address={lowerHex(field(l, "address"))} whole={false}/></td>
      <td>{ts}</td>
      <td class="mono wrap-any">{field(l, "data")}</td>
    </tr>;
  }
  U256 gasUsed = quantityOf(field(r, "gasUsed"));
  U256 price = quantityOf(field(r, "effectiveGasPrice"));
  string input = field(tx, "input");
  return page(site, "Transaction " + short(hash), <div>
    <h1>Transaction</h1>
    <section class="card">
      <table class="kv"><tbody>
        <Row label="Hash" value={<Mono text={field(tx, "hash")}/>}/>
        <Row label="Status" value={<span class={pending ? "badge wait" : !receipt ? "muted" : field(r, "status") == "0x1" ? "badge ok" : "badge bad"}>{status}</span>}/>
        <Row label="Block" value={pending ? <span class="muted">—</span> : <BlockLink n={smallOf(field(tx, "blockNumber"))}/>}/>
        <Row label="From" value={<AddressLink address={lowerHex(field(tx, "from"))} whole={true}/>}/>
        <Row label={created != "" ? "Created" : "To"} value={<AddressLink address={created != "" ? created : to} whole={true}/>}/>
        <Row label="Value" value={<Text text={etherText(quantityOf(field(tx, "value")))}/>}/>
        <Row label="Fee" value={!receipt ? <span class="muted">—</span> : <Text text={etherText(gasUsed.mul(price)) + " (" + grouped(gasUsed.toDecimal()) + " gas at " + gweiText(price) + ")"}/>}/>
        <Row label="Gas limit" value={<Text text={grouped(quantityOf(field(tx, "gas")).toDecimal())}/>}/>
        <Row label="Type" value={<Text text={typeName(smallOf(field(tx, "type")))}/>}/>
        <Row label="Nonce" value={<Text text={"\{smallOf(field(tx, "nonce"))}"}/>}/>
        <Row label="Input" value={input == "0x" ? <span class="muted">none</span> : <code class="mono wrap-any input">{input}</code>}/>
      </tbody></table>
    </section>
    {logs.len() == 0 ? <span></span> : <section class="card">
      <h2>Logs</h2>
      <table class="list">
        <thead><tr><th class="num">#</th><th>Address</th><th>Topics</th><th>Data</th></tr></thead>
        <tbody>{logRows}</tbody>
      </table>
    </section>}
  </div>);
}

string typeName(u64 t) {
  if (t == 0) { return "0 (legacy)"; }
  if (t == 1) { return "1 (EIP-2930, access list)"; }
  if (t == 2) { return "2 (EIP-1559)"; }
  if (t == 3) { return "3 (EIP-4844, blobs)"; }
  if (t == 4) { return "4 (EIP-7702, set code)"; }
  return "\{t}";
}

// ── An address ─────────────────────────────────────────────────────────────────

export string address(Site site, Engine e, Index ix, string addr, u64 now) {
  string a = lowerHex(addr);
  U256 balance = quantityOf(rpc(e, "eth_getBalance", [str(a), str("latest")])?.text());
  u64 nonce = smallOf(rpc(e, "eth_getTransactionCount", [str(a), str("latest")])?.text());
  string code = rpc(e, "eth_getCode", [str(a), str("latest")])?.text() ?? "0x";
  i32 codeLen = (code.len() - 2) / 2;
  TxRef[] txs = touching(ix, a);
  i32 shown = txs.len() < 100 ? txs.len() : 100;
  Node[] rows = Node[].filled(shown, Node.Text(""));
  for (i32 i = 0; i < shown; i++) {
    TxRef t = txs[txs.len() - 1 - i];
    bool out = t.from == a;
    rows[i] = <tr key={t.hash}>
      <td><TxLink hash={t.hash}/></td>
      <td><BlockLink n={t.block}/></td>
      <td><span class={out ? "badge out" : "badge in"}>{out ? (t.created ? "create" : "out") : "in"}</span></td>
      <td><AddressLink address={out ? t.to : t.from} whole={false}/></td>
      <td class="num">{etherText(quantityOf(t.value))}</td>
    </tr>;
  }
  string what = codeLen > 0 ? "Contract" : site.faucetAddress != "" && lowerHex(site.faucetAddress) == a ? "The faucet" : "Account";
  return page(site, "Address " + short(a), <div>
    <h1>{what}</h1>
    <p class="mono wrap-any big">{a}</p>
    <section class="stats">
      <Stat label="Balance" value={etherText(balance)}/>
      <Stat label="Nonce" value={"\{nonce}"}/>
      <Stat label="Code" value={codeLen > 0 ? grouped("\{codeLen}") + " bytes" : "none"}/>
      <Stat label="Transactions" value={grouped("\{txs.len()}")}/>
    </section>
    {txs.len() == 0 ? <p class="muted">No transactions to or from this address yet.</p> : <section class="card">
      <h2>{txs.len() > shown ? "The latest \{shown} transactions" : "Transactions"}</h2>
      <table class="list">
        <thead><tr><th>Hash</th><th>Block</th><th></th><th>With</th><th class="num">Value</th></tr></thead>
        <tbody>{rows}</tbody>
      </table>
    </section>}
  </div>);
}

// ── The faucet's answer, and the rest ──────────────────────────────────────────

export string faucetAnswer(Site site, Drip d, string to) {
  if (d.refused != "") {
    string wait = d.waitSeconds <= 0 ? "" : d.waitSeconds < 3600 ? "Try again in \{(d.waitSeconds + 59) / 60} minutes."
                                                                   : "Try again in \{(d.waitSeconds + 3599) / 3600} hours.";
    return page(site, "Faucet", <section class="card narrow">
      <h1>Not this time</h1>
      <p>{d.refused}</p>
      {wait == "" ? <span></span> : <p>{wait}</p>}
      <p><a href="/">Back to the start</a></p>
    </section>);
  }
  return page(site, "Faucet", <section class="card narrow">
    <h1>On its way</h1>
    <p>{site.faucetAmount} is going to <a class="mono wrap-any" href={"/address/" + to}>{to}</a>, in the next block —
    within {site.blockSeconds == 1 ? "a second" : "\{site.blockSeconds} seconds"}.</p>
    <p>Transaction <a class="mono wrap-any" href={"/tx/" + d.txHash}>{d.txHash}</a></p>
    <p><a href="/">Back to the start</a></p>
  </section>);
}

export string notFound(Site site, string what) {
  return page(site, "Not found", <section class="card narrow">
    <h1>Nothing here</h1>
    <p>{what}</p>
    <p><a href="/">Back to the start</a></p>
  </section>);
}

/** A decimal block number, with or without separators; null for anything else. */
U256? decimal(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0 || b.len() > 20) { return null; }
  U256 n = U256.zero();
  for (u8 c in b) {
    if (c == ',' || c == '_') { continue; }
    if (c < 48 || c > 57) { return null; }
    n = n.mul(U256.ofU64(10)).add(U256.ofU64((c - 48) as u64));
  }
  return n;
}
