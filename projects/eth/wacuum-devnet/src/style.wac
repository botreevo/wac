// The site's stylesheet, served as /style.css. It lives here rather than in a file beside the program so the
// node stays one file to deploy. A block string keeps it as it is written: no
// escapes needed, and no interpolation to trip over.

/** Light by default, dark when the reader's system is; the layout holds from a phone's width up. */
export static string STYLE = """
  :root {
    --bg: #f6f7fb; --card: #ffffff; --text: #1b1f2a; --muted: #687087; --line: #e3e6ef;
    --accent: #5b4cf0; --accent-ink: #ffffff; --ok: #137a3f; --ok-bg: #e2f6ea; --bad: #b42318; --bad-bg: #fde8e7;
    --wait: #8a5a00; --wait-bg: #fff3d6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1117; --card: #171a23; --text: #e7e9f0; --muted: #98a0b6; --line: #262b38;
      --accent: #8b7fff; --accent-ink: #0f1117; --ok: #5fd28f; --ok-bg: #12301f; --bad: #ff8a80; --bad-bg: #3a1614;
      --wait: #ffc860; --wait-bg: #3a2c0c;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 16px; }
  header { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; padding: 18px 0; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 18px; color: var(--text); }
  .brand:hover { text-decoration: none; }
  .wordmark { height: 36px; width: auto; display: block; }
  .brand-tag { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent);
    border: 1.5px solid var(--accent); border-radius: 999px; padding: 1px 9px; margin-top: 4px; }
  nav.top { display: flex; align-items: center; gap: 20px; }
  .navlink { color: var(--muted); font-weight: 500; }
  .navlink:hover { color: var(--accent); text-decoration: none; }
  form.search { display: flex; gap: 8px; flex: 1 1 380px; max-width: 560px; }
  input { flex: 1; min-width: 0; padding: 9px 12px; border: 1px solid var(--line); border-radius: 8px;
    background: var(--card); color: var(--text); font: inherit; }
  button { padding: 9px 16px; border: 0; border-radius: 8px; background: var(--accent); color: var(--accent-ink);
    font: inherit; font-weight: 600; cursor: pointer; white-space: nowrap; }
  h1 { font-size: 26px; margin: 8px 0 12px; }
  h2 { font-size: 17px; margin: 0 0 12px; }
  .hero { display: flex; align-items: center; gap: 20px; margin: 4px 0 8px; }
  .hero p { max-width: 760px; color: var(--muted); margin-top: 0; }
  .hero-mascot { width: 128px; height: auto; flex: none; }
  @media (max-width: 640px) { .hero-mascot { width: 84px; } .hero { gap: 12px; } }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px; margin: 0 0 16px;
    overflow-x: auto; }
  .narrow { max-width: 720px; }
  .columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 16px; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 0 0 16px; }
  .stat { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; }
  .stat-label { color: var(--muted); font-size: 13px; }
  .stat-value { font-size: 20px; font-weight: 650; font-variant-numeric: tabular-nums; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th { color: var(--muted); font-weight: 500; font-size: 13px; }
  table.kv th { width: 180px; color: var(--muted); font-weight: 500; }
  tr:last-child td, tr:last-child th { border-bottom: 0; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13.5px; }
  .wrap-any { overflow-wrap: anywhere; word-break: break-all; }
  .big { font-size: 16px; }
  .input { display: block; max-height: 220px; overflow: auto; }
  .muted { color: var(--muted); }
  .badge { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .ok { color: var(--ok); background: var(--ok-bg); }
  .bad { color: var(--bad); background: var(--bad-bg); }
  .wait { color: var(--wait); background: var(--wait-bg); }
  .in { color: var(--ok); background: var(--ok-bg); }
  .out { color: var(--wait); background: var(--wait-bg); }
  form.faucet { display: flex; flex-wrap: wrap; gap: 8px; }
  .pager { display: flex; justify-content: space-between; margin-top: 8px; }
  footer { color: var(--muted); font-size: 13px; padding: 24px 0 40px; }
  table.list .mono { white-space: nowrap; }
  table.list .mono.wrap-any { white-space: normal; }
  @media (max-width: 640px) {
    table.kv th, table.kv td { display: block; width: auto; }
    table.kv th { padding-bottom: 0; border-bottom: 0; }
  }
  /* The about page */
  .about { --glow: color-mix(in srgb, var(--accent) 18%, transparent); }
  .about-hero { padding: 32px 0 8px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 40px;
    align-items: center; }
  .about-hero .figures { grid-column: 1 / -1; }
  .about-logo { width: 360px; height: auto; }
  @media (max-width: 860px) {
    .about-hero { grid-template-columns: minmax(0, 1fr); }
    .about-logo { grid-row: 1; width: min(300px, 80%); justify-self: center; }
  }
  .eyebrow { margin: 0 0 10px; color: var(--accent); font-weight: 650; font-size: 13px; letter-spacing: .08em;
    text-transform: uppercase; }
  .about-hero h1 { font-size: clamp(30px, 4.6vw, 50px); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 18px;
    max-width: 900px; }
  .lede { font-size: 18px; line-height: 1.6; color: var(--muted); max-width: 760px; margin: 0 0 32px; }
  .lede strong { color: var(--text); }
  .figures { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .figure { background: linear-gradient(160deg, var(--card), var(--bg)); border: 1px solid var(--line); border-radius: 14px;
    padding: 18px 20px; }
  .figure-value { font-size: 30px; font-weight: 750; letter-spacing: -0.02em; color: var(--accent); }
  .figure-label { color: var(--muted); font-size: 14px; margin-top: 2px; }
  .about-section { padding: 44px 0 4px; }
  .about-section h2 { font-size: 26px; letter-spacing: -0.01em; margin: 0 0 8px; }
  .section-lede { color: var(--muted); max-width: 760px; margin: 0 0 24px; }
  .flow { display: flex; align-items: stretch; gap: 0; }
  .stage { border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; background: var(--card); }
  .stage.outside { flex: 0 1 170px; align-self: center; }
  .stage.inside { flex: 1; }
  .stage-title { font-weight: 700; }
  .stage-detail { color: var(--muted); font-size: 13.5px; margin-top: 2px; }
  .arrow { flex: 0 0 34px; align-self: center; height: 2px; background: var(--line); position: relative; }
  .arrow::after { content: ""; position: absolute; right: 0; top: -4px; border: 5px solid transparent;
    border-left-color: var(--muted); border-right: 0; }
  .program { flex: 1 1 420px; border: 1.5px solid var(--accent); border-radius: 16px; padding: 14px;
    background: radial-gradient(120% 140% at 0% 0%, var(--glow), transparent 60%), var(--card); }
  .program-label { font-size: 12px; font-weight: 650; letter-spacing: .06em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 10px 2px; }
  .program-row { display: flex; gap: 10px; }
  .program-core { margin-top: 10px; border-radius: 12px; padding: 14px 16px; background: var(--accent);
    color: var(--accent-ink); }
  .program-core .stage-detail { color: inherit; opacity: .85; }
  .parts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 12px;
    margin-bottom: 16px; }
  .part { border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; background: var(--card); }
  .part h3 { margin: 0 0 6px; font-size: 16px; }
  .part p { margin: 0; color: var(--muted); font-size: 14.5px; }
  .fixtures h3 { margin: 0 0 4px; font-size: 16px; }
  .fixtures p { margin: 0 0 8px; }
  .fixtures tbody th { font-weight: 500; color: var(--text); }
  .split { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 8px 32px; }
  .split p { margin: 0 0 14px; max-width: 560px; }
  .steps { list-style: none; counter-reset: step; padding: 0; margin: 0; display: grid; gap: 12px;
    grid-template-columns: minmax(0, 1fr); }
  .step-body { min-width: 0; }
  .step { counter-increment: step; position: relative; border: 1px solid var(--line); border-radius: 12px;
    background: var(--card); padding: 16px 18px 16px 64px; min-width: 0; }
  @media (max-width: 640px) { .step { padding-left: 18px; padding-top: 56px; } }
  .step::before { content: counter(step); position: absolute; left: 18px; top: 14px; width: 30px; height: 30px;
    border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-weight: 700; display: grid;
    place-items: center; }
  .step-title { font-weight: 700; margin: 4px 0 8px; }
  .step-body p { margin: 0; }
  .step-body table.kv { max-width: 560px; }
  pre.code { margin: 0 0 10px; padding: 12px 14px; border-radius: 10px; background: var(--bg); border: 1px solid var(--line);
    overflow-x: auto; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; line-height: 1.55; }
  .fine-print ul { margin: 0; padding-left: 20px; color: var(--muted); max-width: 760px; }
  .fine-print li { margin: 4px 0; }
  .sources { margin-top: 20px; }
  @media (max-width: 860px) {
    .flow { flex-direction: column; }
    .stage.outside { flex: none; align-self: stretch; }
    .program { flex: none; }
    .arrow { flex: 0 0 22px; width: 2px; height: auto; align-self: center; }
    .arrow::after { right: -4px; top: auto; bottom: 0; border: 5px solid transparent; border-top-color: var(--muted);
      border-bottom: 0; }
    .program-row { flex-direction: column; }
  }
  """;
