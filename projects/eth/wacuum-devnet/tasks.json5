{
  // Every unit test, in wac.
  test: "wac test test",
  // Put the commits wac.lock pins into wac's package cache with git, where `wac update` cannot authenticate.
  deps: "sh tools/fill-cache.sh",
  // src/assets.wac from assets/.
  assets: "python3 tools/gen-assets.py",
  // The node, site and faucet, as one executable file.
  build: "sh tools/build.sh",
}
