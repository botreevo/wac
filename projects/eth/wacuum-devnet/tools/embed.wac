// Write src/images.wac from the images in assets/: each one as hex, which the node decodes once at start.
//
//     wac run --allow-read --allow-write tools/embed.wac      (or: wac task embed)
//
// The node is one file to deploy, so what it serves is inside it. wac has no way to include a file's bytes
// in a program, so the bytes become a string literal; hex rather than base64 because `wacuum` already
// exports the decoder and nothing reachable from here exports a base64 one. Run it after changing assets/.

import { Sys } from "std";
import { bytesToHex } from "wacuum";

/** The images, by the name the program knows each by and the file it comes from. */
static string[] NAMES = ["WORDMARK", "STACKED", "FAVICON"];
static string[] FILES = ["wordmark.avif", "stacked.avif", "favicon.avif"];

export async i32 main(Sys sys) {
  string out = "// Generated by tools/embed.wac from assets/: edit those files and run `wac task embed` again.\n" +
               "// Each image is AVIF, as hex; src/server.wac decodes them once at start.\n";
  for (i32 i = 0; i < NAMES.len(); i++) {
    match (await sys.readFile("assets/" + FILES[i])) {
      Err(e): { sys.warn("embed: assets/\{FILES[i]}: \{e}"); return 1; }
      Ok(b): {
        out += "\n/** assets/\{FILES[i]}, \{b.len()} bytes. */\nexport static string \{NAMES[i]} = \"" + bytesToHex(b) + "\";\n";
        sys.log("embed: \{FILES[i]}, \{b.len()} bytes");
      }
    }
  }
  match (await sys.writeFile("src/images.wac", out.toBytes())) {
    Err(e): { sys.warn("embed: src/images.wac: \{e}"); return 1; }
    Ok(_): { return 0; }
  }
}
