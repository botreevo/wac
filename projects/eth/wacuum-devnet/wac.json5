{
  imports: {
    // The execution client: its engine, genesis, keys and devp2p, through the `exports` its manifest names.
    wacuum: { git: 'https://git.voltrevo.com/wacuum.git', ref: 'master' },
    // The rest of wac: json, rlp, keccak. The commit wacuum pins, so its values and this program's are one type.
    wac: { git: 'https://git.voltrevo.com/wac.git', ref: 'master' },
    // Components, and the HTML they render to.
    web: { git: 'https://git.voltrevo.com/web.git', ref: 'master' },
  },
}
