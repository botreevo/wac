// Arithmetic modulo a prime below 2^256, in Montgomery form.
//
// An element is eight 32-bit limbs in u64s, least significant first, holding aR mod p with R = 2^256.
// Multiplication is CIOS — Koç, Acar and Kaliski's coarsely integrated operand scanning — over those
// limbs, which needs no 64x64->128 multiply: a limb product plus two limbs fits in a u64. One `Field`
// serves any odd prime, so secp256k1's two moduli and bn254's share it; none of this is constant-time,
// and nothing here handles a secret — the precompiles only verify.
//
// Elements are treated as values: no method writes into an argument.

import { U256 } from "../u256.wac";
import { modLimbs } from "../limbs.wac";

static u64 MASK = 0xFFFFFFFF;

export struct Field {
  U256 modulus;
  u64[] p;
  /** -p^-1 mod 2^32. */
  u64 n0;
  /** R^2 mod p, which `fromU256` multiplies by to enter Montgomery form. */
  u64[] r2;
  /** R mod p: one, in Montgomery form. */
  u64[] oneM;

  Field create(U256 modulus) {
    u64[] p = limbsOf(modulus);
    // Newton's iteration doubles the correct low bits each step: five steps reach 32.
    u64 inv = 1;
    for (i32 i = 0; i < 5; i++) { inv = (inv * (2 - p[0] * inv)) & MASK; }
    u64 n0 = (0 - inv) & MASK;
    u64[] r = u64[].filled(9, 0);
    r[8] = 1;
    u64[] rr = u64[].filled(17, 0);
    rr[16] = 1;
    return Field(modulus, p, n0, fit(modLimbs(rr, p)), fit(modLimbs(r, p)));
  }

  u64[] zero(this) { return u64[].filled(8, 0); }
  u64[] one(this) { return this.oneM; }

  u64[] fromU256(this, U256 x) {
    return this.mul(fit(modLimbs(limbsOf(x), this.p)), this.r2);
  }

  U256 toU256(this, u64[] a) {
    u64[] plain = u64[].filled(8, 0);
    plain[0] = 1;
    u64[] l = this.mul(a, plain);
    return U256(l[0] | (l[1] << 32), l[2] | (l[3] << 32), l[4] | (l[5] << 32), l[6] | (l[7] << 32));
  }

  /**
   * CIOS, unrolled: every limb in a local rather than an array, so the inner loops are straight-line
   * arithmetic with no bounds checks and no memory traffic until the result is written. The loop form is
   * in git history; this is it written out, and about five times faster.
   */
  u64[] mul(this, u64[] a, u64[] b) {
    u64[] p = this.p;
    u64 n0 = this.n0;
    u64 a0 = a[0];
    u64 a1 = a[1];
    u64 a2 = a[2];
    u64 a3 = a[3];
    u64 a4 = a[4];
    u64 a5 = a[5];
    u64 a6 = a[6];
    u64 a7 = a[7];
    u64 p0 = p[0];
    u64 p1 = p[1];
    u64 p2 = p[2];
    u64 p3 = p[3];
    u64 p4 = p[4];
    u64 p5 = p[5];
    u64 p6 = p[6];
    u64 p7 = p[7];
    u64 t0 = 0;
    u64 t1 = 0;
    u64 t2 = 0;
    u64 t3 = 0;
    u64 t4 = 0;
    u64 t5 = 0;
    u64 t6 = 0;
    u64 t7 = 0;
    u64 t8 = 0;
    u64 t9 = 0;
    u64 c = 0;
    u64 s = 0;
    u64 m = 0;
    u64 bi = 0;
    bi = b[0];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[1];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[2];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[3];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[4];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[5];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[6];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[7];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    u64[] out = [t0, t1, t2, t3, t4, t5, t6, t7];
    if (t8 != 0 || !less(out, p)) { subInPlace(out, p); }
    return out;
  }

  u64[] square(this, u64[] a) { return this.mul(a, a); }

  u64[] add(this, u64[] a, u64[] b) {
    u64[] out = u64[].filled(8, 0);
    u64 c = 0;
    for (i32 i = 0; i < 8; i++) {
      u64 s = a[i] + b[i] + c;
      out[i] = s & MASK;
      c = s >> 32;
    }
    if (c != 0 || !less(out, this.p)) { subInPlace(out, this.p); }
    return out;
  }

  u64[] sub(this, u64[] a, u64[] b) {
    u64[] out = u64[].filled(8, 0);
    u64 borrow = 0;
    for (i32 i = 0; i < 8; i++) {
      u64 d = a[i] - b[i] - borrow;
      out[i] = d & MASK;
      borrow = (d >> 32) != 0 ? 1 : 0;
    }
    if (borrow != 0) {
      u64 c = 0;
      for (i32 i = 0; i < 8; i++) {
        u64 s = out[i] + this.p[i] + c;
        out[i] = s & MASK;
        c = s >> 32;
      }
    }
    return out;
  }

  u64[] neg(this, u64[] a) { return this.sub(this.zero(), a); }

  u64[] double(this, u64[] a) { return this.add(a, a); }

  bool isZero(this, u64[] a) {
    for (i32 i = 0; i < 8; i++) {
      if (a[i] != 0) { return false; }
    }
    return true;
  }

  bool eq(this, u64[] a, u64[] b) {
    for (i32 i = 0; i < 8; i++) {
      if (a[i] != b[i]) { return false; }
    }
    return true;
  }

  u64[] pow(this, u64[] a, U256 e) {
    u64[] result = this.oneM;
    for (i32 i = 255; i >= 0; i--) {
      result = this.square(result);
      if (e.bit(i)) { result = this.mul(result, a); }
    }
    return result;
  }

  /** a^(p-2): the inverse of a nonzero element, by Fermat. Zero has none and gives zero. */
  u64[] inv(this, u64[] a) { return this.pow(a, this.modulus.sub(U256.ofU64(2))); }

  /** A square root when p is 3 mod 4, or null when `a` is not a square. */
  u64[]? sqrt(this, u64[] a) {
    u64[] c = this.pow(a, this.modulus.add(U256.one()).shr(2));
    return this.eq(this.square(c), a) ? c : null;
  }
}

u64[] limbsOf(U256 x) {
  u64[] l = u64[].filled(8, 0);
  for (i32 i = 0; i < 4; i++) {
    u64 w = x.word(i);
    l[2 * i] = w & MASK;
    l[2 * i + 1] = w >> 32;
  }
  return l;
}

/** Exactly eight limbs, from a reduced value that may have been held in more or fewer. */
u64[] fit(u64[] x) {
  u64[] out = u64[].filled(8, 0);
  for (i32 i = 0; i < 8 && i < x.len(); i++) { out[i] = x[i]; }
  return out;
}

bool less(u64[] a, u64[] b) {
  for (i32 i = 7; i >= 0; i--) {
    if (a[i] != b[i]) { return a[i] < b[i]; }
  }
  return false;
}

void subInPlace(u64[] a, u64[] b) {
  u64 borrow = 0;
  for (i32 i = 0; i < 8; i++) {
    u64 d = a[i] - b[i] - borrow;
    a[i] = d & MASK;
    borrow = (d >> 32) != 0 ? 1 : 0;
  }
}
