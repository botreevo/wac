// Arithmetic modulo a prime below 2^256, in Montgomery form.
//
// An element is eight 32-bit limbs in u64s, least significant first, holding aR mod p with R = 2^256.
// Multiplication is CIOS — Koç, Acar and Kaliski's coarsely integrated operand scanning — over those
// limbs, which needs no 64x64->128 multiply: a limb product plus two limbs fits in a u64. One `Field`
// serves any odd prime, so secp256k1's two moduli and bn254's share it; none of this is constant-time,
// and nothing here handles a secret — the precompiles only verify.
//
// Elements are treated as values: no method writes into an argument.

import { U256, wordsOf } from "../u256.wac";
import { modLimbs } from "../limbs.wac";

// Constants as their words, parsed once by the compiler (see U256.ofWords).
static u64[] SECP_P = wordsOf(U256.fromHex("0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f")!);

static u64 MASK = 0xFFFFFFFF;

export struct Field {
  U256 modulus;
  u64[] p;
  /** -p^-1 mod 2^32. */
  u64 n0;
  /** R^2 mod p, which `fromU256` multiplies by to enter Montgomery form. */
  u64[] r2;
  /** R mod p: one, in Montgomery form. */
  u64[] oneM;
  /**
   * Whether this is secp256k1's field, p = 2^256 − 2^32 − 977, which multiplies by its own routine: the
   * product reduced by 2^256 = 2^32 + 977 (mod p), about a tenth of Montgomery's reduction. Its elements are
   * held as themselves (R = 1) rather than in Montgomery form; nothing outside `mul` can tell.
   */
  bool special;

  Field create(U256 modulus) {
    u64[] p = limbsOf(modulus);
    // Newton's iteration doubles the correct low bits each step: five steps reach 32.
    u64 inv = 1;
    for (i32 i = 0; i < 5; i++) { inv = (inv * (2 - p[0] * inv)) & MASK; }
    u64 n0 = (0 - inv) & MASK;
    u64[] r = u64[].filled(9, 0);
    r[8] = 1;
    u64[] rr = u64[].filled(17, 0);
    rr[16] = 1;
    if (modulus.eq(U256.ofWords(SECP_P))) {
      u64[] one = u64[].filled(8, 0);
      one[0] = 1;
      return Field(modulus, p, n0, one, one, true);
    }
    return Field(modulus, p, n0, fit(modLimbs(rr, p)), fit(modLimbs(r, p)), false);
  }

  u64[] zero(this) { return u64[].filled(8, 0); }
  u64[] one(this) { return this.oneM; }

  u64[] fromU256(this, U256 x) {
    return this.mul(fit(modLimbs(limbsOf(x), this.p)), this.r2);
  }

  U256 toU256(this, u64[] a) {
    u64[] plain = u64[].filled(8, 0);
    plain[0] = 1;
    u64[] l = this.mul(a, plain);
    return U256(l[0] | (l[1] << 32), l[2] | (l[3] << 32), l[4] | (l[5] << 32), l[6] | (l[7] << 32));
  }

  /**
   * CIOS, unrolled: every limb in a local rather than an array, so the inner loops are straight-line
   * arithmetic with no bounds checks and no memory traffic until the result is written. The loop form is
   * in git history; this is it written out, and about five times faster.
   */
  u64[] mul(this, u64[] a, u64[] b) {
    if (this.special) {
      u64[] out = [0 as u64, 0, 0, 0, 0, 0, 0, 0];
      mulSecpTo(out, a, b, this.p);
      return out;
    }
    u64[] p = this.p;
    u64 n0 = this.n0;
    u64 a0 = a[0];
    u64 a1 = a[1];
    u64 a2 = a[2];
    u64 a3 = a[3];
    u64 a4 = a[4];
    u64 a5 = a[5];
    u64 a6 = a[6];
    u64 a7 = a[7];
    u64 p0 = p[0];
    u64 p1 = p[1];
    u64 p2 = p[2];
    u64 p3 = p[3];
    u64 p4 = p[4];
    u64 p5 = p[5];
    u64 p6 = p[6];
    u64 p7 = p[7];
    u64 t0 = 0;
    u64 t1 = 0;
    u64 t2 = 0;
    u64 t3 = 0;
    u64 t4 = 0;
    u64 t5 = 0;
    u64 t6 = 0;
    u64 t7 = 0;
    u64 t8 = 0;
    u64 t9 = 0;
    u64 c = 0;
    u64 s = 0;
    u64 m = 0;
    u64 bi = 0;
    bi = b[0];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[1];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[2];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[3];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[4];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[5];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[6];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    bi = b[7];
    c = 0;
    s = t0 + a0 * bi + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t1 + a1 * bi + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t2 + a2 * bi + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t3 + a3 * bi + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t4 + a4 * bi + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t5 + a5 * bi + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t6 + a6 * bi + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t7 + a7 * bi + c;
    t7 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t8 = s & MASK;
    t9 = s >> 32;
    m = (t0 * n0) & MASK;
    s = t0 + m * p0;
    c = s >> 32;
    s = t1 + m * p1 + c;
    t0 = s & MASK;
    c = s >> 32;
    s = t2 + m * p2 + c;
    t1 = s & MASK;
    c = s >> 32;
    s = t3 + m * p3 + c;
    t2 = s & MASK;
    c = s >> 32;
    s = t4 + m * p4 + c;
    t3 = s & MASK;
    c = s >> 32;
    s = t5 + m * p5 + c;
    t4 = s & MASK;
    c = s >> 32;
    s = t6 + m * p6 + c;
    t5 = s & MASK;
    c = s >> 32;
    s = t7 + m * p7 + c;
    t6 = s & MASK;
    c = s >> 32;
    s = t8 + c;
    t7 = s & MASK;
    t8 = t9 + (s >> 32);
    u64[] out = [t0, t1, t2, t3, t4, t5, t6, t7];
    if (t8 != 0 || !less(out, p)) { subInPlace(out, p); }
    return out;
  }

  u64[] square(this, u64[] a) {
    if (!this.special) { return this.mul(a, a); }
    u64[] out = [0 as u64, 0, 0, 0, 0, 0, 0, 0];
    sqrSecpTo(out, a, this.p);
    return out;
  }

  /**
   * a + b mod p into `out`, unrolled as `mul` is: the limbs in locals, the result written once, so `out` may be
   * `a` or `b`. The ...To forms are what the curve's hot loops use: a fresh array costs about 12 ns on the Node
   * host, and a recovery made some four thousand of them.
   */
  void addTo(this, u64[] out, u64[] a, u64[] b) {
    u64[] p = this.p;
    u64 s = a[0] + b[0];
    u64 r0 = s & MASK;
    s = a[1] + b[1] + (s >> 32);
    u64 r1 = s & MASK;
    s = a[2] + b[2] + (s >> 32);
    u64 r2 = s & MASK;
    s = a[3] + b[3] + (s >> 32);
    u64 r3 = s & MASK;
    s = a[4] + b[4] + (s >> 32);
    u64 r4 = s & MASK;
    s = a[5] + b[5] + (s >> 32);
    u64 r5 = s & MASK;
    s = a[6] + b[6] + (s >> 32);
    u64 r6 = s & MASK;
    s = a[7] + b[7] + (s >> 32);
    u64 r7 = s & MASK;
    u64 carry = s >> 32;
    if (this.special) {
      // secp256k1's p is within 2^33 of 2^256, so a sum is seldom at least p, and comparing from the top
      // limb nearly always stops at once: cheaper than working out the difference every time.
      out[0] = r0;
      out[1] = r1;
      out[2] = r2;
      out[3] = r3;
      out[4] = r4;
      out[5] = r5;
      out[6] = r6;
      out[7] = r7;
      if (carry != 0 || !less(out, p)) { subInPlace(out, p); }
      return;
    }
    // The sum less p, alongside: it is the answer when the sum carried or did not borrow — when sum ≥ p.
    u64 d = r0 - p[0];
    u64 q0 = d & MASK;
    d = r1 - p[1] - ((d >> 32) & 1);
    u64 q1 = d & MASK;
    d = r2 - p[2] - ((d >> 32) & 1);
    u64 q2 = d & MASK;
    d = r3 - p[3] - ((d >> 32) & 1);
    u64 q3 = d & MASK;
    d = r4 - p[4] - ((d >> 32) & 1);
    u64 q4 = d & MASK;
    d = r5 - p[5] - ((d >> 32) & 1);
    u64 q5 = d & MASK;
    d = r6 - p[6] - ((d >> 32) & 1);
    u64 q6 = d & MASK;
    d = r7 - p[7] - ((d >> 32) & 1);
    u64 q7 = d & MASK;
    if (carry != 0 || ((d >> 32) & 1) == 0) {
      out[0] = q0;
      out[1] = q1;
      out[2] = q2;
      out[3] = q3;
      out[4] = q4;
      out[5] = q5;
      out[6] = q6;
      out[7] = q7;
    } else {
      out[0] = r0;
      out[1] = r1;
      out[2] = r2;
      out[3] = r3;
      out[4] = r4;
      out[5] = r5;
      out[6] = r6;
      out[7] = r7;
    }
  }


  /** a − b mod p into `out`, unrolled: p is added back when the subtraction borrows. `out` may be `a` or `b`. */
  void subTo(this, u64[] out, u64[] a, u64[] b) {
    u64 d = a[0] - b[0];
    u64 r0 = d & MASK;
    d = a[1] - b[1] - ((d >> 32) & 1);
    u64 r1 = d & MASK;
    d = a[2] - b[2] - ((d >> 32) & 1);
    u64 r2 = d & MASK;
    d = a[3] - b[3] - ((d >> 32) & 1);
    u64 r3 = d & MASK;
    d = a[4] - b[4] - ((d >> 32) & 1);
    u64 r4 = d & MASK;
    d = a[5] - b[5] - ((d >> 32) & 1);
    u64 r5 = d & MASK;
    d = a[6] - b[6] - ((d >> 32) & 1);
    u64 r6 = d & MASK;
    d = a[7] - b[7] - ((d >> 32) & 1);
    u64 r7 = d & MASK;
    if ((d >> 32) != 0) {
      u64[] p = this.p;
      u64 c = r0 + p[0];
      r0 = c & MASK;
      c = r1 + p[1] + (c >> 32);
      r1 = c & MASK;
      c = r2 + p[2] + (c >> 32);
      r2 = c & MASK;
      c = r3 + p[3] + (c >> 32);
      r3 = c & MASK;
      c = r4 + p[4] + (c >> 32);
      r4 = c & MASK;
      c = r5 + p[5] + (c >> 32);
      r5 = c & MASK;
      c = r6 + p[6] + (c >> 32);
      r6 = c & MASK;
      c = r7 + p[7] + (c >> 32);
      r7 = c & MASK;
    }
    out[0] = r0;
    out[1] = r1;
    out[2] = r2;
    out[3] = r3;
    out[4] = r4;
    out[5] = r5;
    out[6] = r6;
    out[7] = r7;
  }

  u64[] add(this, u64[] a, u64[] b) {
    u64[] out = [0 as u64, 0, 0, 0, 0, 0, 0, 0];
    this.addTo(out, a, b);
    return out;
  }

  u64[] sub(this, u64[] a, u64[] b) {
    u64[] out = [0 as u64, 0, 0, 0, 0, 0, 0, 0];
    this.subTo(out, a, b);
    return out;
  }

  /** a·b into `out`, which may be `a` or `b`: in place for secp256k1's field, a copy of `mul`'s answer otherwise. */
  void mulTo(this, u64[] out, u64[] a, u64[] b) {
    if (this.special) {
      mulSecpTo(out, a, b, this.p);
      return;
    }
    u64[] r = this.mul(a, b);
    for (i32 i = 0; i < 8; i++) { out[i] = r[i]; }
  }

  /** a² into `out`, which may be `a`. */
  void sqrTo(this, u64[] out, u64[] a) {
    if (this.special) {
      sqrSecpTo(out, a, this.p);
      return;
    }
    this.mulTo(out, a, a);
  }

  u64[] neg(this, u64[] a) { return this.sub(this.zero(), a); }

  u64[] double(this, u64[] a) { return this.add(a, a); }

  bool isZero(this, u64[] a) {
    for (i32 i = 0; i < 8; i++) {
      if (a[i] != 0) { return false; }
    }
    return true;
  }

  bool eq(this, u64[] a, u64[] b) {
    for (i32 i = 0; i < 8; i++) {
      if (a[i] != b[i]) { return false; }
    }
    return true;
  }

  u64[] pow(this, u64[] a, U256 e) {
    u64[] result = this.oneM;
    for (i32 i = 255; i >= 0; i--) {
      result = this.square(result);
      if (e.bit(i)) { result = this.mul(result, a); }
    }
    return result;
  }

  /**
   * The inverse of a nonzero element; zero has none and gives zero. By the binary extended Euclidean
   * algorithm — shifts and subtractions on the limbs, several times quicker than Fermat's a^(p−2) and its
   * 380-odd multiplications — on the element's representation x = aR, whose inverse a⁻¹R⁻¹ two
   * multiplications by R² take to a⁻¹R. Not constant-time, like everything here.
   */
  u64[] inv(this, u64[] a) {
    if (this.isZero(a)) { return this.zero(); }
    if (this.special) { return this.secpChain(a, false); }
    u64[] p = this.p;
    u64[] u = fit(a);
    u64[] v = fit(p);
    u64[] x1 = u64[].filled(8, 0);
    x1[0] = 1;
    u64[] x2 = u64[].filled(8, 0);
    while (!isOne(u) && !isOne(v)) {
      while ((u[0] & 1) == 0) {
        halve(u, 0);
        halveMod(x1, p);
      }
      while ((v[0] & 1) == 0) {
        halve(v, 0);
        halveMod(x2, p);
      }
      if (!less(u, v)) {
        subInPlace(u, v);
        this.subTo(x1, x1, x2);
      } else {
        subInPlace(v, u);
        this.subTo(x2, x2, x1);
      }
    }
    u64[] plain = isOne(u) ? x1 : x2;
    return this.mul(this.mul(plain, this.r2), this.r2);
  }

  /** a^(p-2), by Fermat: the inverse the long way, which `inv` is checked against. */
  u64[] invByFermat(this, u64[] a) { return this.pow(a, this.modulus.sub(U256.ofU64(2))); }

  /**
   * secp256k1's a^((p+1)/4), its square root, or a^(p−2), its inverse, by libsecp256k1's addition chain:
   * x_n below is a^(2^n − 1), and the runs of ones in the two exponents are built from them. 253 or 255
   * squarings and 13 or 15 multiplications, where square-and-multiply does about 250 more multiplications.
   * Both chains' exponents were checked against (p+1)/4 and p−2 when this was written.
   */
  u64[] secpChain(this, u64[] a, bool root) {
    u64[] x2 = this.mul(this.square(a), a);
    u64[] x3 = this.mul(this.squares(x2, 1), a);
    u64[] x6 = this.mul(this.squares(x3, 3), x3);
    u64[] x9 = this.mul(this.squares(x6, 3), x3);
    u64[] x11 = this.mul(this.squares(x9, 2), x2);
    u64[] x22 = this.mul(this.squares(x11, 11), x11);
    u64[] x44 = this.mul(this.squares(x22, 22), x22);
    u64[] x88 = this.mul(this.squares(x44, 44), x44);
    u64[] x176 = this.mul(this.squares(x88, 88), x88);
    u64[] x220 = this.mul(this.squares(x176, 44), x44);
    u64[] x223 = this.mul(this.squares(x220, 3), x3);
    u64[] t = this.mul(this.squares(x223, 23), x22);
    if (root) {
      t = this.mul(this.squares(t, 6), x2);
      return this.squares(t, 2);
    }
    t = this.mul(this.squares(t, 5), a);
    t = this.mul(this.squares(t, 3), x2);
    return this.mul(this.squares(t, 2), a);
  }

  /** a^(2^n): n squarings, in place on one copy. */
  u64[] squares(this, u64[] a, i32 n) {
    u64[] out = this.square(a);
    for (i32 i = 1; i < n; i++) { this.sqrTo(out, out); }
    return out;
  }

  /** A square root when p is 3 mod 4, or null when `a` is not a square. */
  u64[]? sqrt(this, u64[] a) {
    if (this.special) {
      u64[] r = this.secpChain(a, true);
      return this.eq(this.square(r), a) ? r : null;
    }
    u64[] c = this.pow(a, this.modulus.add(U256.one()).shr(2));
    return this.eq(this.square(c), a) ? c : null;
  }
}

/**
 * a·b mod secp256k1's p, for elements held as themselves: the 512-bit product, schoolbook and unrolled, and
 * then its high half H folded down twice by H·2^256 = H·(2^32 + 977) (mod p) — a shift and eight small
 * multiplications — and one conditional subtraction. The fold is written out here and in `sqrSecp`: as a
 * function of sixteen limbs it was not inlined, and cost a sixth of a recovery.
 */
void mulSecpTo(u64[] out, u64[] a, u64[] b, u64[] p) {
  u64 a0 = a[0];
  u64 a1 = a[1];
  u64 a2 = a[2];
  u64 a3 = a[3];
  u64 a4 = a[4];
  u64 a5 = a[5];
  u64 a6 = a[6];
  u64 a7 = a[7];
  u64 b0 = b[0];
  u64 b1 = b[1];
  u64 b2 = b[2];
  u64 b3 = b[3];
  u64 b4 = b[4];
  u64 b5 = b[5];
  u64 b6 = b[6];
  u64 b7 = b[7];
  u64 r0 = 0;
  u64 r1 = 0;
  u64 r2 = 0;
  u64 r3 = 0;
  u64 r4 = 0;
  u64 r5 = 0;
  u64 r6 = 0;
  u64 r7 = 0;
  u64 r8 = 0;
  u64 r9 = 0;
  u64 r10 = 0;
  u64 r11 = 0;
  u64 r12 = 0;
  u64 r13 = 0;
  u64 r14 = 0;
  u64 r15 = 0;
  u64 t = 0;
  t = r0 + a0 * b0;
  r0 = t & MASK;
  t = r1 + a0 * b1 + (t >> 32);
  r1 = t & MASK;
  t = r2 + a0 * b2 + (t >> 32);
  r2 = t & MASK;
  t = r3 + a0 * b3 + (t >> 32);
  r3 = t & MASK;
  t = r4 + a0 * b4 + (t >> 32);
  r4 = t & MASK;
  t = r5 + a0 * b5 + (t >> 32);
  r5 = t & MASK;
  t = r6 + a0 * b6 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a0 * b7 + (t >> 32);
  r7 = t & MASK;
  r8 = t >> 32;
  t = r1 + a1 * b0;
  r1 = t & MASK;
  t = r2 + a1 * b1 + (t >> 32);
  r2 = t & MASK;
  t = r3 + a1 * b2 + (t >> 32);
  r3 = t & MASK;
  t = r4 + a1 * b3 + (t >> 32);
  r4 = t & MASK;
  t = r5 + a1 * b4 + (t >> 32);
  r5 = t & MASK;
  t = r6 + a1 * b5 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a1 * b6 + (t >> 32);
  r7 = t & MASK;
  t = r8 + a1 * b7 + (t >> 32);
  r8 = t & MASK;
  r9 = t >> 32;
  t = r2 + a2 * b0;
  r2 = t & MASK;
  t = r3 + a2 * b1 + (t >> 32);
  r3 = t & MASK;
  t = r4 + a2 * b2 + (t >> 32);
  r4 = t & MASK;
  t = r5 + a2 * b3 + (t >> 32);
  r5 = t & MASK;
  t = r6 + a2 * b4 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a2 * b5 + (t >> 32);
  r7 = t & MASK;
  t = r8 + a2 * b6 + (t >> 32);
  r8 = t & MASK;
  t = r9 + a2 * b7 + (t >> 32);
  r9 = t & MASK;
  r10 = t >> 32;
  t = r3 + a3 * b0;
  r3 = t & MASK;
  t = r4 + a3 * b1 + (t >> 32);
  r4 = t & MASK;
  t = r5 + a3 * b2 + (t >> 32);
  r5 = t & MASK;
  t = r6 + a3 * b3 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a3 * b4 + (t >> 32);
  r7 = t & MASK;
  t = r8 + a3 * b5 + (t >> 32);
  r8 = t & MASK;
  t = r9 + a3 * b6 + (t >> 32);
  r9 = t & MASK;
  t = r10 + a3 * b7 + (t >> 32);
  r10 = t & MASK;
  r11 = t >> 32;
  t = r4 + a4 * b0;
  r4 = t & MASK;
  t = r5 + a4 * b1 + (t >> 32);
  r5 = t & MASK;
  t = r6 + a4 * b2 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a4 * b3 + (t >> 32);
  r7 = t & MASK;
  t = r8 + a4 * b4 + (t >> 32);
  r8 = t & MASK;
  t = r9 + a4 * b5 + (t >> 32);
  r9 = t & MASK;
  t = r10 + a4 * b6 + (t >> 32);
  r10 = t & MASK;
  t = r11 + a4 * b7 + (t >> 32);
  r11 = t & MASK;
  r12 = t >> 32;
  t = r5 + a5 * b0;
  r5 = t & MASK;
  t = r6 + a5 * b1 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a5 * b2 + (t >> 32);
  r7 = t & MASK;
  t = r8 + a5 * b3 + (t >> 32);
  r8 = t & MASK;
  t = r9 + a5 * b4 + (t >> 32);
  r9 = t & MASK;
  t = r10 + a5 * b5 + (t >> 32);
  r10 = t & MASK;
  t = r11 + a5 * b6 + (t >> 32);
  r11 = t & MASK;
  t = r12 + a5 * b7 + (t >> 32);
  r12 = t & MASK;
  r13 = t >> 32;
  t = r6 + a6 * b0;
  r6 = t & MASK;
  t = r7 + a6 * b1 + (t >> 32);
  r7 = t & MASK;
  t = r8 + a6 * b2 + (t >> 32);
  r8 = t & MASK;
  t = r9 + a6 * b3 + (t >> 32);
  r9 = t & MASK;
  t = r10 + a6 * b4 + (t >> 32);
  r10 = t & MASK;
  t = r11 + a6 * b5 + (t >> 32);
  r11 = t & MASK;
  t = r12 + a6 * b6 + (t >> 32);
  r12 = t & MASK;
  t = r13 + a6 * b7 + (t >> 32);
  r13 = t & MASK;
  r14 = t >> 32;
  t = r7 + a7 * b0;
  r7 = t & MASK;
  t = r8 + a7 * b1 + (t >> 32);
  r8 = t & MASK;
  t = r9 + a7 * b2 + (t >> 32);
  r9 = t & MASK;
  t = r10 + a7 * b3 + (t >> 32);
  r10 = t & MASK;
  t = r11 + a7 * b4 + (t >> 32);
  r11 = t & MASK;
  t = r12 + a7 * b5 + (t >> 32);
  r12 = t & MASK;
  t = r13 + a7 * b6 + (t >> 32);
  r13 = t & MASK;
  t = r14 + a7 * b7 + (t >> 32);
  r14 = t & MASK;
  r15 = t >> 32;
  // Fold H into L: limb k gains H[k]·977 and H[k−1] (the 2^32 part), and a ninth limb takes what is left.
  t = r0 + r8 * 977;
  u64 s0 = t & MASK;
  t = r1 + r9 * 977 + r8 + (t >> 32);
  u64 s1 = t & MASK;
  t = r2 + r10 * 977 + r9 + (t >> 32);
  u64 s2 = t & MASK;
  t = r3 + r11 * 977 + r10 + (t >> 32);
  u64 s3 = t & MASK;
  t = r4 + r12 * 977 + r11 + (t >> 32);
  u64 s4 = t & MASK;
  t = r5 + r13 * 977 + r12 + (t >> 32);
  u64 s5 = t & MASK;
  t = r6 + r14 * 977 + r13 + (t >> 32);
  u64 s6 = t & MASK;
  t = r7 + r15 * 977 + r14 + (t >> 32);
  u64 s7 = t & MASK;
  u64 s8 = r15 + (t >> 32);
  // And the ninth limb the same way: it is small, so this leaves at most a carry out of 2^256.
  t = s0 + s8 * 977;
  s0 = t & MASK;
  t = s1 + s8 + (t >> 32);
  s1 = t & MASK;
  t = s2 + (t >> 32);
  s2 = t & MASK;
  t = s3 + (t >> 32);
  s3 = t & MASK;
  t = s4 + (t >> 32);
  s4 = t & MASK;
  t = s5 + (t >> 32);
  s5 = t & MASK;
  t = s6 + (t >> 32);
  s6 = t & MASK;
  t = s7 + (t >> 32);
  s7 = t & MASK;
  if ((t >> 32) != 0) {
    // 2^256 once more, as 2^32 + 977; what is left is far below 2^256, so nothing carries out of this.
    t = s0 + 977;
    s0 = t & MASK;
    t = s1 + 1 + (t >> 32);
    s1 = t & MASK;
    t = s2 + (t >> 32);
    s2 = t & MASK;
    t = s3 + (t >> 32);
    s3 = t & MASK;
    t = s4 + (t >> 32);
    s4 = t & MASK;
    t = s5 + (t >> 32);
    s5 = t & MASK;
    t = s6 + (t >> 32);
    s6 = t & MASK;
    t = s7 + (t >> 32);
    s7 = t & MASK;
  }
  out[0] = s0;
  out[1] = s1;
  out[2] = s2;
  out[3] = s3;
  out[4] = s4;
  out[5] = s5;
  out[6] = s6;
  out[7] = s7;
  if (!less(out, p)) { subInPlace(out, p); }
}

/**
 * a² mod secp256k1's p: the 28 cross products a_i·a_j (i < j) once, schoolbook, then doubled by a shift,
 * then the 8 squares a_i² added on the diagonal — 36 limb multiplications where a product of two takes 64.
 * Half the multiplications in a point doubling are squarings.
 */
void sqrSecpTo(u64[] out, u64[] a, u64[] p) {
  u64 a0 = a[0];
  u64 a1 = a[1];
  u64 a2 = a[2];
  u64 a3 = a[3];
  u64 a4 = a[4];
  u64 a5 = a[5];
  u64 a6 = a[6];
  u64 a7 = a[7];
  u64 r0 = 0;
  u64 r1 = 0;
  u64 r2 = 0;
  u64 r3 = 0;
  u64 r4 = 0;
  u64 r5 = 0;
  u64 r6 = 0;
  u64 r7 = 0;
  u64 r8 = 0;
  u64 r9 = 0;
  u64 r10 = 0;
  u64 r11 = 0;
  u64 r12 = 0;
  u64 r13 = 0;
  u64 r14 = 0;
  u64 r15 = 0;
  u64 t = 0;
  t = r1 + a0 * a1;
  r1 = t & MASK;
  t = r2 + a0 * a2 + (t >> 32);
  r2 = t & MASK;
  t = r3 + a0 * a3 + (t >> 32);
  r3 = t & MASK;
  t = r4 + a0 * a4 + (t >> 32);
  r4 = t & MASK;
  t = r5 + a0 * a5 + (t >> 32);
  r5 = t & MASK;
  t = r6 + a0 * a6 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a0 * a7 + (t >> 32);
  r7 = t & MASK;
  r8 = t >> 32;
  t = r3 + a1 * a2;
  r3 = t & MASK;
  t = r4 + a1 * a3 + (t >> 32);
  r4 = t & MASK;
  t = r5 + a1 * a4 + (t >> 32);
  r5 = t & MASK;
  t = r6 + a1 * a5 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a1 * a6 + (t >> 32);
  r7 = t & MASK;
  t = r8 + a1 * a7 + (t >> 32);
  r8 = t & MASK;
  r9 = t >> 32;
  t = r5 + a2 * a3;
  r5 = t & MASK;
  t = r6 + a2 * a4 + (t >> 32);
  r6 = t & MASK;
  t = r7 + a2 * a5 + (t >> 32);
  r7 = t & MASK;
  t = r8 + a2 * a6 + (t >> 32);
  r8 = t & MASK;
  t = r9 + a2 * a7 + (t >> 32);
  r9 = t & MASK;
  r10 = t >> 32;
  t = r7 + a3 * a4;
  r7 = t & MASK;
  t = r8 + a3 * a5 + (t >> 32);
  r8 = t & MASK;
  t = r9 + a3 * a6 + (t >> 32);
  r9 = t & MASK;
  t = r10 + a3 * a7 + (t >> 32);
  r10 = t & MASK;
  r11 = t >> 32;
  t = r9 + a4 * a5;
  r9 = t & MASK;
  t = r10 + a4 * a6 + (t >> 32);
  r10 = t & MASK;
  t = r11 + a4 * a7 + (t >> 32);
  r11 = t & MASK;
  r12 = t >> 32;
  t = r11 + a5 * a6;
  r11 = t & MASK;
  t = r12 + a5 * a7 + (t >> 32);
  r12 = t & MASK;
  r13 = t >> 32;
  t = r13 + a6 * a7;
  r13 = t & MASK;
  r14 = t >> 32;
  // Doubled: each limb shifted left one, taking the bit the limb below shifts out.
  r15 = ((r15 << 1) & MASK) | (r14 >> 31);
  r14 = ((r14 << 1) & MASK) | (r13 >> 31);
  r13 = ((r13 << 1) & MASK) | (r12 >> 31);
  r12 = ((r12 << 1) & MASK) | (r11 >> 31);
  r11 = ((r11 << 1) & MASK) | (r10 >> 31);
  r10 = ((r10 << 1) & MASK) | (r9 >> 31);
  r9 = ((r9 << 1) & MASK) | (r8 >> 31);
  r8 = ((r8 << 1) & MASK) | (r7 >> 31);
  r7 = ((r7 << 1) & MASK) | (r6 >> 31);
  r6 = ((r6 << 1) & MASK) | (r5 >> 31);
  r5 = ((r5 << 1) & MASK) | (r4 >> 31);
  r4 = ((r4 << 1) & MASK) | (r3 >> 31);
  r3 = ((r3 << 1) & MASK) | (r2 >> 31);
  r2 = ((r2 << 1) & MASK) | (r1 >> 31);
  r1 = ((r1 << 1) & MASK) | (r0 >> 31);
  r0 = (r0 << 1) & MASK;
  // And the squares, on the diagonal: a_i² lands on limbs 2i and 2i+1.
  t = r0 + a0 * a0;
  r0 = t & MASK;
  t = r1 + (t >> 32);
  r1 = t & MASK;
  u64 q1 = a1 * a1;
  t = r2 + (q1 & MASK) + (t >> 32);
  r2 = t & MASK;
  t = r3 + (q1 >> 32) + (t >> 32);
  r3 = t & MASK;
  u64 q2 = a2 * a2;
  t = r4 + (q2 & MASK) + (t >> 32);
  r4 = t & MASK;
  t = r5 + (q2 >> 32) + (t >> 32);
  r5 = t & MASK;
  u64 q3 = a3 * a3;
  t = r6 + (q3 & MASK) + (t >> 32);
  r6 = t & MASK;
  t = r7 + (q3 >> 32) + (t >> 32);
  r7 = t & MASK;
  u64 q4 = a4 * a4;
  t = r8 + (q4 & MASK) + (t >> 32);
  r8 = t & MASK;
  t = r9 + (q4 >> 32) + (t >> 32);
  r9 = t & MASK;
  u64 q5 = a5 * a5;
  t = r10 + (q5 & MASK) + (t >> 32);
  r10 = t & MASK;
  t = r11 + (q5 >> 32) + (t >> 32);
  r11 = t & MASK;
  u64 q6 = a6 * a6;
  t = r12 + (q6 & MASK) + (t >> 32);
  r12 = t & MASK;
  t = r13 + (q6 >> 32) + (t >> 32);
  r13 = t & MASK;
  u64 q7 = a7 * a7;
  t = r14 + (q7 & MASK) + (t >> 32);
  r14 = t & MASK;
  t = r15 + (q7 >> 32) + (t >> 32);
  r15 = t & MASK;
  // Fold H into L: limb k gains H[k]·977 and H[k−1] (the 2^32 part), and a ninth limb takes what is left.
  t = r0 + r8 * 977;
  u64 s0 = t & MASK;
  t = r1 + r9 * 977 + r8 + (t >> 32);
  u64 s1 = t & MASK;
  t = r2 + r10 * 977 + r9 + (t >> 32);
  u64 s2 = t & MASK;
  t = r3 + r11 * 977 + r10 + (t >> 32);
  u64 s3 = t & MASK;
  t = r4 + r12 * 977 + r11 + (t >> 32);
  u64 s4 = t & MASK;
  t = r5 + r13 * 977 + r12 + (t >> 32);
  u64 s5 = t & MASK;
  t = r6 + r14 * 977 + r13 + (t >> 32);
  u64 s6 = t & MASK;
  t = r7 + r15 * 977 + r14 + (t >> 32);
  u64 s7 = t & MASK;
  u64 s8 = r15 + (t >> 32);
  // And the ninth limb the same way: it is small, so this leaves at most a carry out of 2^256.
  t = s0 + s8 * 977;
  s0 = t & MASK;
  t = s1 + s8 + (t >> 32);
  s1 = t & MASK;
  t = s2 + (t >> 32);
  s2 = t & MASK;
  t = s3 + (t >> 32);
  s3 = t & MASK;
  t = s4 + (t >> 32);
  s4 = t & MASK;
  t = s5 + (t >> 32);
  s5 = t & MASK;
  t = s6 + (t >> 32);
  s6 = t & MASK;
  t = s7 + (t >> 32);
  s7 = t & MASK;
  if ((t >> 32) != 0) {
    // 2^256 once more, as 2^32 + 977; what is left is far below 2^256, so nothing carries out of this.
    t = s0 + 977;
    s0 = t & MASK;
    t = s1 + 1 + (t >> 32);
    s1 = t & MASK;
    t = s2 + (t >> 32);
    s2 = t & MASK;
    t = s3 + (t >> 32);
    s3 = t & MASK;
    t = s4 + (t >> 32);
    s4 = t & MASK;
    t = s5 + (t >> 32);
    s5 = t & MASK;
    t = s6 + (t >> 32);
    s6 = t & MASK;
    t = s7 + (t >> 32);
    s7 = t & MASK;
  }
  out[0] = s0;
  out[1] = s1;
  out[2] = s2;
  out[3] = s3;
  out[4] = s4;
  out[5] = s5;
  out[6] = s6;
  out[7] = s7;
  if (!less(out, p)) { subInPlace(out, p); }
}

u64[] limbsOf(U256 x) {
  u64[] l = u64[].filled(8, 0);
  for (i32 i = 0; i < 4; i++) {
    u64 w = x.word(i);
    l[2 * i] = w & MASK;
    l[2 * i + 1] = w >> 32;
  }
  return l;
}

/** Exactly eight limbs, from a reduced value that may have been held in more or fewer. */
u64[] fit(u64[] x) {
  u64[] out = [0 as u64, 0, 0, 0, 0, 0, 0, 0];
  for (i32 i = 0; i < 8 && i < x.len(); i++) { out[i] = x[i]; }
  return out;
}

bool isOne(u64[] a) { return a[0] == 1 && (a[1] | a[2] | a[3] | a[4] | a[5] | a[6] | a[7]) == 0; }

/** a >>= 1, in place, `top` the bit shifted into the top: the carry of an addition that overflowed. */
void halve(u64[] a, u64 top) {
  for (i32 i = 0; i < 7; i++) { a[i] = (a[i] >> 1) | ((a[i + 1] & 1) << 31); }
  a[7] = (a[7] >> 1) | (top << 31);
}

/** a / 2 mod p, in place: a halved when even, (a + p) halved when odd. */
void halveMod(u64[] a, u64[] p) {
  if ((a[0] & 1) == 0) {
    halve(a, 0);
    return;
  }
  u64 c = 0;
  for (i32 i = 0; i < 8; i++) {
    u64 s = a[i] + p[i] + c;
    a[i] = s & MASK;
    c = s >> 32;
  }
  halve(a, c);
}

bool less(u64[] a, u64[] b) {
  for (i32 i = 7; i >= 0; i--) {
    if (a[i] != b[i]) { return a[i] < b[i]; }
  }
  return false;
}

void subInPlace(u64[] a, u64[] b) {
  u64 borrow = 0;
  for (i32 i = 0; i < 8; i++) {
    u64 d = a[i] - b[i] - borrow;
    a[i] = d & MASK;
    borrow = (d >> 32) != 0 ? 1 : 0;
  }
}
