// Multi-scalar multiplication on BLS12-381's G1 and G2 by Pippenger's bucket method: Σ kᵢ·Pᵢ for many
// points at once, which EIP-2537's MSM precompiles price on the assumption that a client does exactly
// this, and which the cell-proof check needs three of.
//
// The scalars are cut into windows of c bits. For each window, every point goes into the bucket its
// window's digit names, and the buckets are folded with a running sum, so bucket j counts j times; the
// windows are then combined by c doublings each. For n points that is about (256/c)·(n + 2ᶜ) additions,
// against n·256 doublings and n·128 additions one point at a time.

import { bls.G1, bls.G2, bls.g1Infinity, bls.g1IsInfinity, bls.g1Add, bls.g1Double, bls.g2Infinity, bls.g2IsInfinity,
         bls.g2Add, bls.g2Double } from "wac";

/** A window width for `n` points: about log₂ n, at least 1. */
i32 windowFor(i32 n) {
  i32 c = 1;
  while ((1 << (c + 1)) <= n && c < 16) { c++; }
  return c;
}

/** Bits [from, from + c) of a scalar given as 32-bit limbs, least significant first. */
i32 digit(u32[] k, i32 from, i32 c) {
  i32 v = 0;
  for (i32 b = 0; b < c; b++) {
    i32 bit = from + b;
    if (bit >= 32 * k.len()) { break; }
    if (((k[bit / 32] >> ((bit % 32) as@ u32)) & 1) != 0) { v = v | (1 << b); }
  }
  return v;
}

i32 bitsOf(u32[][] scalars) {
  i32 n = 0;
  for (i32 i = 0; i < scalars.len(); i++) {
    if (32 * scalars[i].len() > n) { n = 32 * scalars[i].len(); }
  }
  return n;
}

export G1 g1Msm(G1[] points, u32[][] scalars) {
  i32 c = windowFor(points.len());
  i32 bits = bitsOf(scalars);
  G1 acc = g1Infinity();
  for (i32 w = ((bits + c - 1) / c) - 1; w >= 0; w--) {
    for (i32 d = 0; d < c; d++) { acc = g1Double(acc); }
    G1[] buckets = G1[].filled((1 << c) - 1, g1Infinity());
    for (i32 i = 0; i < points.len(); i++) {
      i32 j = digit(scalars[i], w * c, c);
      if (j != 0 && !g1IsInfinity(points[i])) { buckets[j - 1] = g1Add(buckets[j - 1], points[i]); }
    }
    G1 running = g1Infinity();
    G1 sum = g1Infinity();
    for (i32 j = buckets.len() - 1; j >= 0; j--) {
      running = g1Add(running, buckets[j]);
      sum = g1Add(sum, running);
    }
    acc = g1Add(acc, sum);
  }
  return acc;
}

export G2 g2Msm(G2[] points, u32[][] scalars) {
  i32 c = windowFor(points.len());
  i32 bits = bitsOf(scalars);
  G2 acc = g2Infinity();
  for (i32 w = ((bits + c - 1) / c) - 1; w >= 0; w--) {
    for (i32 d = 0; d < c; d++) { acc = g2Double(acc); }
    G2[] buckets = G2[].filled((1 << c) - 1, g2Infinity());
    for (i32 i = 0; i < points.len(); i++) {
      i32 j = digit(scalars[i], w * c, c);
      if (j != 0 && !g2IsInfinity(points[i])) { buckets[j - 1] = g2Add(buckets[j - 1], points[i]); }
    }
    G2 running = g2Infinity();
    G2 sum = g2Infinity();
    for (i32 j = buckets.len() - 1; j >= 0; j--) {
      running = g2Add(running, buckets[j]);
      sum = g2Add(sum, running);
    }
    acc = g2Add(acc, sum);
  }
  return acc;
}
