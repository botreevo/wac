// Messages: what a call or a creation is, and how one runs against the world.
//
// This follows the structure of `ethereum/execution-specs` for Cancun — `process_message`,
// `process_create_message`, `generic_call` and `generic_create` — closely enough that each function here can
// be read beside its counterpart there. Where the spec's order of operations is observable (which charges
// come before which checks, what is refunded when a call cannot happen) the order here is the spec's.

import { Map, Vec } from "core";
import { keccak256 } from "../crypto/keccak.wac";
import { rlp.Item, rlp.encode } from "wac";
import { U256 } from "../u256.wac";
import { World, Snapshot, Account } from "../state/world.wac";
import { Frame, Outcome, Halt, run, resume } from "./interp.wac";
import { OpTable } from "./table.wac";
import { isPrecompile, runPrecompile } from "./precompiles.wac";
import { Spec } from "./spec.wac";

export static i32 MAX_DEPTH = 1024;
/** EIP-170. */
export static i32 MAX_CODE_SIZE = 24576;
/** EIP-3860: twice the code size limit. */
export static i32 MAX_INITCODE_SIZE = 49152;

export struct BlockEnv {
  U256 coinbase;
  U256 number;
  U256 timestamp;
  U256 gasLimit;
  U256 prevRandao;
  U256 baseFee;
  U256 blobBaseFee;
  U256 chainId;
  /** The hashes BLOCKHASH can answer, by block number. */
  Map<U256, U256> hashes;
}

export struct TxEnv {
  U256 origin;
  U256 gasPrice;
  U256[] blobHashes;
}

export struct Evm {
  World world;
  BlockEnv block;
  TxEnv tx;
  OpTable table;
  Spec spec;
  /** Handed one line per step when set: depth, pc, opcode, gas and the top of the stack. For debugging. */
  fn<void(string)>? tracer;
}

export struct Message {
  U256 caller;
  /** Whose account the code runs as: its storage, its balance, ADDRESS. */
  U256 target;
  /** Whose code runs; differs from `target` for DELEGATECALL and CALLCODE. */
  U256 codeAddress;
  U256 value;
  u8[] data;
  i64 gas;
  bool isStatic;
  i32 depth;
  /** False for DELEGATECALL, whose value is only what CALLVALUE reports. */
  bool transfersValue;
  /**
   * EIP-7702: the code came through a delegation, which runs the delegate's code even when the delegate
   * is a precompile's address — precompiles are not code, so delegating to one runs nothing.
   */
  bool noPrecompile;
}

// ## Calls without recursion
//
// A CALL or CREATE does not run its callee by calling into it: the opcode leaves the callee's message on
// its frame and stops, and the driver below keeps the frames on a stack of its own — beginning the callee,
// running whatever frame is on top, and when one halts, finishing it and handing its outcome back to the
// frame below. So however deep the EVM's calls go (1024 is allowed), the host's stack does not, and no
// host's stack limit decides whether a block can be executed.

/** A message begun: either already done (a precompile, an account with no code) or a frame to run. */
struct Begun {
  Message m;
  bool isCreate;
  Snapshot snap;
  Outcome? done;
  Frame? frame;
}

/** The value moves and the code is found: what a call does before its code runs. */
Begun beginCall(Evm evm, Message m) {
  World w = evm.world;
  Snapshot s = w.snapshot();
  w.markTouched(m.target);
  if (m.transfersValue && !m.value.isZero()) { w.transfer(m.caller, m.target, m.value); }
  Account? acct = w.get(m.codeAddress);
  return started(evm, m, false, s, w.code(m.codeAddress), acct is null ? null : acct!.codeHash);
}

/**
 * A creation whose address is already chosen and checked for collision: the new account gets nonce 1 and
 * the value, and the init code is the frame's code, its calldata empty.
 */
Begun beginCreate(Evm evm, Message m) {
  World w = evm.world;
  Snapshot s = w.snapshot();
  w.touch(m.target);
  w.markCreated(m.target);
  w.setNonce(m.target, 1);
  w.markTouched(m.target);
  if (!m.value.isZero()) { w.transfer(m.caller, m.target, m.value); }
  u8[] initcode = m.data;
  m.data = u8[].filled(0, 0);
  return started(evm, m, true, s, initcode, null);
}

/** `codeHash` is the code's when it is an account's, null for init code: what its jump analysis is cached by. */
Begun started(Evm evm, Message m, bool isCreate, Snapshot s, u8[] code, U256? codeHash) {
  if (!m.noPrecompile && isPrecompile(evm.spec, m.codeAddress)) {
    return Begun(m, isCreate, s, runPrecompile(evm.spec, m.codeAddress, m.data, m.gas), null);
  }
  if (code.len() == 0) { return Begun(m, isCreate, s, Outcome(Halt.Stop, m.gas), null); }
  return Begun(m, isCreate, s, null, Frame.create(evm, m, code, codeHash));
}

/**
 * What a message's outcome comes to once it is over: a failed call is undone; a creation's returned code
 * is checked and paid for (EIP-3541's 0xEF, EIP-170's size, 200 gas a byte) and becomes the account's.
 */
Outcome finish(Evm evm, Begun b, Outcome o) {
  World w = evm.world;
  if (!o.succeeded()) {
    w.revert(b.snap);
    return o;
  }
  if (!b.isCreate) { return o; }
  u8[] code = o.output();
  i64 deposit = 200 * (code.len() as i64);
  if ((code.len() > 0 && code[0] == 0xEF) || code.len() > MAX_CODE_SIZE || deposit > o.gasLeft) {
    w.revert(b.snap);
    return Outcome(Halt.Failure("code deposit refused"), 0);
  }
  w.setCode(b.m.target, code);
  return Outcome(Halt.Return(u8[].filled(0, 0)), o.gasLeft - deposit);
}

/** Run a message call: the value moves, then the code (or the precompile) runs, and a failure undoes both. */
export Outcome processMessage(Evm evm, Message m) { return drive(evm, beginCall(evm, m)); }

/** Run a creation; see `beginCreate` and `finish`. */
export Outcome processCreate(Evm evm, Message m) { return drive(evm, beginCreate(evm, m)); }

/** Run `first` and every call it makes, on a stack of frames, to its outcome. */
Outcome drive(Evm evm, Begun first) {
  if (first.done is not null) { return finish(evm, first, first.done!); }
  Vec<Begun> stack = Vec.create();
  stack.push(first);
  while (true) {
    Begun top = stack.get(stack.len() - 1);
    Frame f = top.frame!;
    Outcome? o = run(f);
    if (o is null) {
      // The frame stopped to make a call: begin it, and either hand back its outcome at once or run it.
      Message child = f.spawned!;
      f.spawned = null;
      Begun b = f.spawnedCreate ? beginCreate(evm, child) : beginCall(evm, child);
      if (b.done is not null) {
        resume(f, finish(evm, b, b.done!));
      } else {
        stack.push(b);
      }
      continue;
    }
    stack.pop();
    Outcome out = finish(evm, top, o!);
    if (stack.len() == 0) { return out; }
    resume(stack.get(stack.len() - 1).frame!, out);
  }
}

/** The address CREATE gives: the last 20 bytes of keccak256(rlp([sender, nonce])). */
export U256 createAddress(U256 sender, u64 nonce) {
  Item[] fields = [Item.Bytes(addressBytes(sender)), Item.Bytes(minimalBytes(nonce))];
  return U256.fromBytes(keccak256(encode(Item.List(fields))), 12, 20);
}

/** The address CREATE2 gives: keccak256(0xff ++ sender ++ salt ++ keccak256(initcode)), last 20 bytes. */
export U256 create2Address(U256 sender, U256 salt, u8[] initcode) {
  u8[] buf = u8[].filled(85, 0);
  buf[0] = 0xFF;
  u8[] a = addressBytes(sender);
  for (i32 i = 0; i < 20; i++) { buf[1 + i] = a[i]; }
  salt.writeBytes(buf, 21);
  u8[] h = keccak256(initcode);
  for (i32 i = 0; i < 32; i++) { buf[53 + i] = h[i]; }
  return U256.fromBytes(keccak256(buf), 12, 20);
}

/** An address's 20 bytes. */
export u8[] addressBytes(U256 a) {
  u8[] full = a.toBytes();
  u8[] out = u8[].filled(20, 0);
  for (i32 i = 0; i < 20; i++) { out[i] = full[12 + i]; }
  return out;
}

/** The shortest big-endian bytes of `v`: RLP's spelling of an integer, empty for zero. */
export u8[] minimalBytes(u64 v) {
  i32 n = 0;
  u64 x = v;
  while (x != 0) { n++; x = x >> 8; }
  u8[] out = u8[].filled(n, 0);
  for (i32 i = 0; i < n; i++) { out[i] = (v >> ((n - 1 - i) * 8)) as@ u8; }
  return out;
}

/** All but one 64th — EIP-150's cap on the gas a call or creation may pass on. */
export i64 allButOne64th(i64 g) { return g - g / 64; }

/** EIP-7702's delegation designator: 0xef0100 and an address, exactly 23 bytes. */
export U256? delegationOf(u8[] code) {
  if (code.len() != 23 || code[0] != 0xEF || code[1] != 0x01 || code[2] != 0x00) { return null; }
  return U256.fromBytes(code, 3, 20);
}

/** The designator that delegates to `addr`. */
export u8[] delegationTo(U256 addr) {
  u8[] out = u8[].filled(23, 0);
  out[0] = 0xEF;
  out[1] = 0x01;
  u8[] a = addressBytes(addr);
  for (i32 i = 0; i < 20; i++) { out[3 + i] = a[i]; }
  return out;
}
