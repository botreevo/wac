// `eth_getProof` (EIP-1186): an account and some of its slots, with the trie nodes that prove them against the
// state root of the block the world is at. The tries are the live ones `root.wac` keeps, brought up to date
// first, so a proof is of exactly the root the block header carries.

import { keccak256 } from "../crypto/keccak.wac";
import { json.JsonValue, json.JsonObject, json.JsonArray } from "wac";
import { U256 } from "../u256.wac";
import { bytesToHex } from "../hex.wac";
import { World, Account, emptyCodeHash } from "./world.wac";
import { stateRoot, storageRoot } from "./root.wac";
import { addressBytes } from "../evm/evm.wac";
import { emptyRoot } from "../trie/trie.wac";

JsonValue str(string s) { return JsonValue.Str(s.toBytes()); }

JsonValue nodesJson(u8[][] nodes) {
  JsonArray a = JsonArray.create();
  for (i32 i = 0; i < nodes.len(); i++) { a.push(str(bytesToHex(nodes[i]))); }
  return JsonValue.Array(a);
}

/** A quantity as JSON-RPC spells one: `0x0`, never `0x00`. */
string quantity(U256 v) { return v.toHex(); }

export JsonValue proofJson(World w, U256 address, U256[] slots) {
  stateRoot(w);
  JsonObject o = JsonObject.create();
  o.push("address".toBytes(), str(bytesToHex(addressBytes(address))));
  o.push("accountProof".toBytes(), nodesJson(w.accountTrie!.prove(keccak256(addressBytes(address)))));
  Account? a = w.get(address);
  o.push("balance".toBytes(), str(quantity(a is null ? U256.zero() : a!.balance)));
  o.push("codeHash".toBytes(), str(bytesToHex((a is null ? emptyCodeHash() : a!.codeHash).toBytes())));
  o.push("nonce".toBytes(), str(quantity(U256.ofU64(a is null ? 0 : a!.nonce))));
  o.push("storageHash".toBytes(), str(bytesToHex(a is null ? emptyRoot() : storageRoot(a!))));
  JsonArray sp = JsonArray.create();
  for (i32 i = 0; i < slots.len(); i++) {
    JsonObject s = JsonObject.create();
    s.push("key".toBytes(), str(bytesToHex(slots[i].toBytes())));
    s.push("value".toBytes(), str(quantity(a is null ? U256.zero() : a!.storage.getOr(slots[i], U256.zero()))));
    u8[][] nodes = a is null || a!.storageTrie is null ? u8[][].filled(0, u8[]()) : a!.storageTrie!.prove(keccak256(slots[i].toBytes()));
    s.push("proof".toBytes(), nodesJson(nodes));
    sp.push(JsonValue.Object(s));
  }
  o.push("storageProof".toBytes(), JsonValue.Array(sp));
  return JsonValue.Object(o);
}
