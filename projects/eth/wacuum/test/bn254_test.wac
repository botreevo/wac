// bn254's pairing constants, embedded by the compiler from one exponentiation, against the same worked out
// the long way at run time.

import { crypto.keccak256 } from "wac";
import { U256 } from "../src/u256.wac";
import { Bn, Fq2 } from "../src/crypto/bn254.wac";
import { Check } from "./check.wac";

bool same(u64[] a, u64[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

bool same2(Fq2 a, Fq2 b) { return same(a.a, b.a) && same(a.b, b.b); }

export string test_the_embedded_constants_are_the_computed_ones() {
  Check t = Check.create();
  Bn fast = Bn.create();
  Bn slow = Bn.compute();
  t.ok(same2(fast.b2, slow.b2), "b2");
  t.ok(same2(fast.frobX, slow.frobX), "frobX = t²");
  t.ok(same2(fast.frobY, slow.frobY), "frobY = t³");
  for (i32 i = 0; i < 12; i++) { t.ok(same(fast.frob2Powers[i], slow.frob2Powers[i]), "γ^\{i} = (t·t̄)^\{i}"); }
  return t.report();
}

/** Pseudo-random elements of Fp12, every coefficient set. */
u64[][] element(Bn bn, string seed) {
  u64[][] x = bn.one12();
  u8[] h = seed.toBytes();
  for (i32 i = 0; i < 12; i++) {
    h = keccak256(h);
    x[i] = bn.f.fromU256(U256.fromBytes(h, 0, 32).shr(3));
  }
  return x;
}

bool same12(u64[][] a, u64[][] b) {
  for (i32 i = 0; i < 12; i++) {
    if (!same(a[i], b[i])) { return false; }
  }
  return true;
}

export string test_fp12_frobenius_inverse_and_the_final_exponentiation() {
  Check t = Check.create();
  Bn bn = Bn.create();
  for (i32 i = 0; i < 3; i++) {
    u64[][] x = element(bn, "fp12 \{i}");
    t.ok(same12(bn.frob1(bn.frob1(x)), bn.frob2(x)), "frob1 twice is frob2, for element \{i}");
    t.ok(same12(bn.frob1(bn.mul12(x, x)), bn.mul12(bn.frob1(x), bn.frob1(x))), "frob1 is multiplicative, for element \{i}");
    t.ok(same12(bn.mul12(x, bn.inv12(x)), bn.one12()), "x times its inverse, for element \{i}");
  }
  // The chain's hard part against square and multiply by h, on a value after the easy part.
  u64[][] f = element(bn, "final");
  u64[][] g = bn.mul12(bn.frob6(f), bn.inv12(f));
  g = bn.mul12(bn.frob2(g), g);
  t.ok(same12(bn.finalExp(f), Bn.compute().hardPartByExponent(g)), "the final exponentiation's chain is the hard part");
  return t.report();
}

/** Fp12's product the long way, as a polynomial in w reduced by w^12 = 18 w^6 − 82: the tower is checked against it. */
u64[][] schoolbook(Bn bn, u64[][] x, u64[][] y) {
  u64[][] t = u64[][].filled(23, bn.f.zero());
  for (i32 i = 0; i < 12; i++) {
    for (i32 j = 0; j < 12; j++) { t[i + j] = bn.f.add(t[i + j], bn.f.mul(x[i], y[j])); }
  }
  for (i32 k = 22; k >= 12; k--) {
    t[k - 6] = bn.f.add(t[k - 6], bn.f.mul(t[k], bn.c18));
    t[k - 12] = bn.f.sub(t[k - 12], bn.f.mul(t[k], bn.c82));
  }
  u64[][] out = u64[][].filled(12, bn.f.zero());
  for (i32 i = 0; i < 12; i++) { out[i] = t[i]; }
  return out;
}

export string test_the_tower_product_is_the_polynomial_one() {
  Check t = Check.create();
  Bn bn = Bn.create();
  for (i32 i = 0; i < 4; i++) {
    u64[][] x = element(bn, "x \{i}");
    u64[][] y = element(bn, "y \{i}");
    t.ok(same12(bn.mul12(x, y), schoolbook(bn, x, y)), "x·y, pair \{i}");
    t.ok(same12(bn.sqr12(x), schoolbook(bn, x, x)), "x², element \{i}");
  }
  return t.report();
}
