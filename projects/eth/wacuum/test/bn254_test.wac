// bn254's pairing constants, embedded by the compiler from one exponentiation, against the same worked out
// the long way at run time.

import { Bn, Fq2 } from "../src/crypto/bn254.wac";
import { Check } from "./check.wac";

bool same(u64[] a, u64[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

bool same2(Fq2 a, Fq2 b) { return same(a.a, b.a) && same(a.b, b.b); }

export string test_the_embedded_constants_are_the_computed_ones() {
  Check t = Check.create();
  Bn fast = Bn.create();
  Bn slow = Bn.compute();
  t.ok(same2(fast.b2, slow.b2), "b2");
  t.ok(same2(fast.frobX, slow.frobX), "frobX = t²");
  t.ok(same2(fast.frobY, slow.frobY), "frobY = t³");
  for (i32 i = 0; i < 12; i++) { t.ok(same(fast.frob2Powers[i], slow.frob2Powers[i]), "γ^\{i} = (t·t̄)^\{i}"); }
  t.ok(same(fast.hard, slow.hard), "the hard part of the final exponent");
  return t.report();
}
