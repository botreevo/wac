// Field inversion by the binary extended Euclidean algorithm, against Fermat's a^(p−2), in each kind of
// field there is: secp256k1's p (held as itself), its order n and bn254's p (both in Montgomery form).

import { keccak256 } from "../src/crypto/keccak.wac";
import { U256 } from "../src/u256.wac";
import { Field } from "../src/crypto/field.wac";
import { secpP, secpN } from "../src/crypto/secp256k1.wac";
import { bnP } from "../src/crypto/bn254.wac";
import { Check } from "./check.wac";

void agree(Check t, string name, U256 modulus) {
  Field f = Field.create(modulus);
  u8[] seed = name.toBytes();
  U256[] xs = [U256.one(), U256.ofU64(2), modulus.sub(U256.one()), modulus.sub(U256.ofU64(2)), modulus.shr(1)];
  for (i32 i = 0; i < 40; i++) {
    U256 x = i < xs.len() ? xs[i] : U256.zero();
    if (i >= xs.len()) {
      seed = keccak256(seed);
      x = U256.fromBytes(seed, 0, 32).mod(modulus);
    }
    u64[] a = f.fromU256(x);
    u64[] inv = f.inv(a);
    t.eqU256(f.toU256(inv), f.toU256(f.invByFermat(a)), "\{name}: the inverse of \{x.toHex()}");
    if (!x.isZero()) { t.eqU256(f.toU256(f.mul(a, inv)), U256.one(), "\{name}: \{x.toHex()} times its inverse"); }
  }
  t.ok(f.isZero(f.inv(f.zero())), "\{name}: zero has none and gives zero");
}

export string test_inversion_agrees_with_fermat() {
  Check t = Check.create();
  agree(t, "secp256k1 p", secpP());
  agree(t, "secp256k1 n", secpN());
  agree(t, "bn254 p", bnP());
  return t.report();
}
