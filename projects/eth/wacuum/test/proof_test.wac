// `LiveTrie.prove` against wac's own verifier (`packages/mpt`), which was written against geth's and anvil's
// proofs and knows nothing about this trie: every key present proves its value, keys absent prove absence,
// and the proofs keep holding as the trie is changed under them.

import { crypto.keccak256 } from "wac";
import { mpt.verify, mpt.Proved } from "@/lib.wac";
import { LiveTrie } from "../src/trie/live.wac";

u8[] keyOf(i32 i) { return keccak256([(i >> 8) as@ u8, i as@ u8] as u8[]); }
u8[] valueOf(i32 i, i32 round) { return [0x80 as u8, i as@ u8, round as@ u8, 7 as u8]; }

string checkAll(LiveTrie t, i32 n, i32 round, i32 removedBelow) {
  u8[] root = t.hash();
  for (i32 i = 0; i < n + 40; i++) {
    Proved p = verify(root, keyOf(i), t.prove(keyOf(i)));
    if (!p.ok) { return "key \{i}, round \{round}: \{p.error}"; }
    bool want = i < n && i >= removedBelow;
    if (p.present != want) { return "key \{i}, round \{round}: present \{p.present}, want \{want}"; }
    if (want) {
      u8[] v = valueOf(i, round);
      for (i32 k = 0; k < v.len(); k++) { if (p.value[k] != v[k]) { return "key \{i}: wrong value"; } }
    }
  }
  return "";
}

export string test_every_key_proves_its_value_and_every_other_its_absence() {
  for (i32 n = 1; n <= 300; n = n * 3 + 1) {
    LiveTrie t = LiveTrie.create();
    for (i32 i = 0; i < n; i++) { t.set(keyOf(i), valueOf(i, 0)); }
    string e = checkAll(t, n, 0, 0);
    if (e != "") { return "\{n} keys: \{e}"; }
    // Change every value and delete the first third: the cached hashes on those paths must be rebuilt.
    for (i32 i = 0; i < n; i++) { t.set(keyOf(i), valueOf(i, 1)); }
    for (i32 i = 0; i < n / 3; i++) { t.delete(keyOf(i)); }
    e = checkAll(t, n, 1, n / 3);
    if (e != "") { return "\{n} keys, after changes: \{e}"; }
  }
  return "";
}

export string test_an_empty_trie_proves_nothing_is_there() {
  LiveTrie t = LiveTrie.create();
  Proved p = verify(t.hash(), keyOf(1), t.prove(keyOf(1)));
  if (!p.ok || p.present) { return "empty trie: ok \{p.ok}, present \{p.present}, \{p.error}"; }
  return "";
}
