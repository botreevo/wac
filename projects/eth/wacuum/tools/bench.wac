// How fast wacuum executes, in millions of gas a second, on the workloads that bound a block:
//
//   - an arithmetic loop (the interpreter itself),
//   - a KECCAK256 loop,
//   - an SSTORE loop writing fresh slots (state writes, and the state root after),
//   - a block of plain transfers built from the mempool (signatures recovered, receipts, roots).
//
// Each burns about 30M gas, a block's worth. The two loops run until their gas runs out, which is a failure
// and undoes them; the SSTORE one stops on its own, so its state root is of 1300 slots.
//
//     wac run tools/bench.wac

import { Sys } from "std";
import { Map } from "core";
import { rlp.Item, rlp.encode } from "wac";
import { crypto.keccak256 } from "wac";
import { U256 } from "../src/u256.wac";
import { World, hashU256, eqU256 } from "../src/state/world.wac";
import { stateRoot } from "../src/state/root.wac";
import { Evm, BlockEnv, TxEnv, Message, processMessage } from "../src/evm/evm.wac";
import { Outcome } from "../src/evm/interp.wac";
import { Spec } from "../src/evm/spec.wac";
import { Header, Withdrawal, EMPTY_OMMERS } from "../src/chain/block.wac";
import { Attributes, Built, buildBlock } from "../src/chain/build.wac";
import { publicKey, sign } from "../src/p2p/secp.wac";
import { SenderCache } from "../src/tx/decode.wac";
import { u256Bytes } from "../src/state/root.wac";
import { addressBytes } from "../src/evm/evm.wac";

static i64 GAS = 30000000;

Evm evmOn(World w, Spec spec) {
  BlockEnv b = BlockEnv(U256.ofU64(0xc0ffee), U256.ofU64(1), U256.ofU64(1000), U256.ofU64(GAS as@ u64), U256.zero(),
                        U256.ofU64(7), U256.ofU64(1), U256.ofU64(1), Map.create(hashU256, eqU256));
  return Evm(w, b, TxEnv(U256.ofU64(0xaaaa), U256.ofU64(10), U256[].filled(0, U256.zero())), spec.table, spec, null);
}

/** Run `code` with a block's worth of gas; answers the gas it used. */
i64 burn(Evm evm, u8[] code) {
  U256 at = U256.ofU64(0x1000);
  evm.world.setCode(at, code);
  Message m = Message(U256.ofU64(0xaaaa), at, at, U256.zero(), u8[].filled(0, 0), GAS, false, 0, true, false);
  Outcome o = processMessage(evm, m);
  return GAS - o.gasLeft;
}

async void report(Sys sys, string name, i64 gas, i64 nanos) {
  i64 ms = nanos / 1000000;
  i64 mgasps = ms == 0 ? 0 : (gas / 1000) / ms;
  sys.log("\{name}: \{gas / 1000000}M gas in \{ms} ms — \{mgasps} Mgas/s");
}

/** A signed EIP-1559 transfer of 1 wei from `key` with `nonce`, chain 1, in its block form. */
Item transfer(u8[] key, u64 nonce) {
  Item[] fields = [Item.Bytes(u256Bytes(U256.one())), Item.Bytes(u256Bytes(U256.ofU64(nonce))), Item.Bytes(u256Bytes(U256.one())),
                   Item.Bytes(u256Bytes(U256.ofU64(10000000000))), Item.Bytes(u256Bytes(U256.ofU64(21000))),
                   Item.Bytes(addressBytes(U256.ofU64(0x2222))), Item.Bytes(u256Bytes(U256.one())), Item.Bytes(u8[].filled(0, 0)),
                   Item.List(Item[].filled(0, Item.Bytes(u8[].filled(0, 0))))];
  u8[] body = encode(Item.List(fields));
  u8[] unsigned = u8[].filled(body.len() + 1, 2);
  for (i32 i = 0; i < body.len(); i++) { unsigned[i + 1] = body[i]; }
  u8[] sig = sign(keccak256(unsigned), key);
  Item[] all = Item[].filled(fields.len() + 3, Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < fields.len(); i++) { all[i] = fields[i]; }
  u8[] r = u8[].filled(32, 0);
  u8[] s = u8[].filled(32, 0);
  for (i32 i = 0; i < 32; i++) {
    r[i] = sig[i];
    s[i] = sig[32 + i];
  }
  all[fields.len()] = Item.Bytes(u256Bytes(U256.ofU64(sig[64] as u64)));
  all[fields.len() + 1] = Item.Bytes(u256Bytes(U256.fromBytes(r, 0, 32)));
  all[fields.len() + 2] = Item.Bytes(u256Bytes(U256.fromBytes(s, 0, 32)));
  u8[] signed = encode(Item.List(all));
  u8[] raw = u8[].filled(signed.len() + 1, 2);
  for (i32 i = 0; i < signed.len(); i++) { raw[i + 1] = signed[i]; }
  return Item.Bytes(raw);
}

export async i32 main(Sys sys) {
  Spec spec = Spec.prague();

  // JUMPDEST PUSH1 1 PUSH1 2 ADD POP PUSH1 0 JUMP: 30 gas a turn, until the gas runs out.
  u8[] arith = [0x5b as u8, 0x60 as u8, 0x01 as u8, 0x60 as u8, 0x02 as u8, 0x01 as u8, 0x50 as u8, 0x60 as u8, 0x00 as u8, 0x56 as u8];
  i64 t0 = await sys.monotonicNanos();
  i64 g = burn(evmOn(World.create(), spec), arith);
  await report(sys, "arithmetic loop", g, (await sys.monotonicNanos()) - t0);

  // JUMPDEST PUSH1 32 PUSH1 0 KECCAK256 POP PUSH1 0 JUMP: a 32-byte hash a turn.
  u8[] hashes = [0x5b as u8, 0x60 as u8, 0x20 as u8, 0x60 as u8, 0x00 as u8, 0x20 as u8, 0x50 as u8, 0x60 as u8, 0x00 as u8, 0x56 as u8];
  t0 = await sys.monotonicNanos();
  g = burn(evmOn(World.create(), spec), hashes);
  await report(sys, "keccak loop", g, (await sys.monotonicNanos()) - t0);

  // 1300 fresh slots, counting down — PUSH2 1300; JUMPDEST DUP1 DUP1 SSTORE PUSH1 1 SWAP1 SUB DUP1 PUSH1 3
  // JUMPI; STOP — about 29M gas, and a run that succeeds, so the slots are there for the state root after.
  u8[] stores = [0x61 as u8, 0x05 as u8, 0x14 as u8, 0x5b as u8, 0x80 as u8, 0x80 as u8, 0x55 as u8, 0x60 as u8, 0x01 as u8,
                 0x90 as u8, 0x03 as u8, 0x80 as u8, 0x60 as u8, 0x03 as u8, 0x57 as u8, 0x00 as u8];
  World ws = World.create();
  stateRoot(ws);
  t0 = await sys.monotonicNanos();
  g = burn(evmOn(ws, spec), stores);
  ws.endTransaction();
  i64 t1 = await sys.monotonicNanos();
  stateRoot(ws);
  await report(sys, "sstore loop", g, t1 - t0);
  i64 t2 = await sys.monotonicNanos();
  sys.log("  and its state root: \{(t2 - t1) / 1000000} ms");

  // A block of transfers from one sender, built from the mempool: ~1400 of them.
  u8[] key = u8[].filled(32, 0x11);
  U256 sender = U256.fromBytes(keccak256(publicKey(key)), 12, 20);
  World wb = World.create();
  wb.addBalance(sender, U256.ofU64(1000000000000000000));
  wb.endTransaction();
  stateRoot(wb);
  i32 n = (GAS / 21000) as! i32;
  Item[] txs = Item[].filled(n, Item.Bytes(u8[].filled(0, 0)));
  for (i32 i = 0; i < n; i++) { txs[i] = transfer(key, (i as@ u32) as u64); }
  Header parent = Header(U256.zero(), U256.fromHex(EMPTY_OMMERS)!, U256.zero(), U256.zero(), U256.zero(), U256.zero(),
                         u8[].filled(256, 0), U256.zero(), U256.zero(), U256.ofU64(GAS as@ u64), U256.zero(), U256.zero(),
                         u8[].filled(0, 0), U256.zero(), u8[].filled(8, 0), U256.ofU64(1), U256.zero(), U256.zero(),
                         U256.zero(), U256.zero(), U256.zero(), U256.zero());
  Spec cancun = Spec.cancun();
  t0 = await sys.monotonicNanos();
  Withdrawal[] none = Withdrawal[].filled(0, Withdrawal(U256.zero(), U256.zero(), U256.zero(), U256.zero()));
  Built b = buildBlock(cancun, wb, parent, Attributes(U256.ofU64(12), U256.zero(), U256.ofU64(0xfe), none, U256.zero()), txs,
                       U256.one(), Map.create(hashU256, eqU256), u8[].filled(0, 0), SenderCache.create());
  i64 used = b.body.gasUsed;
  await report(sys, "\{b.block.txs.len()} transfers", used, (await sys.monotonicNanos()) - t0);
  return 0;
}
