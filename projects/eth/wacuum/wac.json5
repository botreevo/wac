{
  // What another project gets from `import { … } from "wacuum"`: the engine and what a node around it needs.
  exports: './src/lib.wac',
  imports: {
    // The rest of wac, as one dependency: `import { crypto.keccak256, rlp.encode } from "wac"`. A build reads
    // only what a program reaches through it.
    wac: { git: 'https://git.voltrevo.com/wac.git', ref: 'master' },
  },
}
