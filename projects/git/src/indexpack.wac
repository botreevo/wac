// Indexing a pack that arrived without one, in time proportional to its size.
//
// wac's `indexPack` (`packages/git/src/pack.wac`) finds a `ref-delta`'s base by resolving and hashing every
// other object in the pack until one has the right name, for each such delta — so a pack of n objects whose
// deltas name their bases, which is what every thin pack is and therefore every push, costs n² hashes of
// whole objects. A 4 MB push of 400 objects did not finish in five minutes.
//
// This does what `git index-pack` does instead: every object is inflated once; the whole ones are hashed
// first; then each resolved object releases the deltas waiting on it — by offset for an `ofs-delta`, by name
// for a `ref-delta`, both looked up in a map — so every object is resolved and hashed exactly once. Whatever
// is still waiting at the end names a base the pack does not hold: a thin pack's, answered as `Thin` with the
// names, which is the same contract as wac's, so `completePack` and this compose as they do there.

import { Buf, Vec, Map, hashBytes, bytesEq, hashI64, i64Eq } from "core";
import { Indexed } from "../vendor/wac/packages/git/src/pack.wac";
import { applyDelta } from "./delta.wac";
import { PackIndex } from "../vendor/wac/packages/git/src/idx.wac";
import { Kind, framed } from "../vendor/wac/packages/git/src/object.wac";
import { Inflation, inflateAtResult } from "../vendor/wac/packages/gzip/src/inflate.wac";
import { crc32 } from "../vendor/wac/packages/gzip/src/crc32.wac";
import { Hash, sha1Of as sha1 } from "./sha1.wac";

/** An object's name: the SHA-1 of `<kind> <length>\0` and its bytes, hashed in two parts rather than joined first. */
u8[] objectName(i32 kind, u8[] body) {
  string word = kind == 1 ? "commit" : kind == 2 ? "tree" : kind == 4 ? "tag" : "blob";
  Hash h = Hash.create();
  h.update("\{word} \{body.len()}\u{0}".toBytes());
  h.update(body);
  return h.finish();
}

Kind kindFor(i32 n) {
  if (n == 1) { return Kind.Commit; }
  if (n == 2) { return Kind.Tree; }
  if (n == 4) { return Kind.Tag; }
  return Kind.Blob;
}

/** What indexing a pack came to: the pack as stored — completed, when bases were supplied — and its index. */
export enum Completed {
  Done(u8[] pack, PackIndex idx),
  /** Deltas name bases that are neither in the pack nor supplied. */
  Lacking(Vec<u8[]> bases),
  Damaged(string why)
}

/** Index `pack` as it is, with nothing supplied: `Thin` names what it lacks. */
export Indexed indexPackFast(u8[] pack) {
  match (indexWith(pack, Vec.create(), i32[](), Vec.create())) {
    Done(whole, idx): { return Indexed.Built(idx); }
    Lacking(bases): { return Indexed.Thin(bases); }
    Damaged(why): { return Indexed.Unindexable(why); }
  }
}

/**
 * Index `pack`, resolving deltas against `extNames` — objects from elsewhere, of `extKinds`, holding `extData` —
 * and append those objects so the pack stands alone, as `git index-pack --fix-thin` does.
 *
 * **One pass, not complete-then-reindex.** Appending the bases and indexing the result from scratch inflated and
 * hashed every base twice more; here they are roots of the same resolution, and their index entries are known
 * when they are written. **They are appended as stored zlib blocks** — uncompressed, which costs disk until a
 * `git gc` repacks and saves deflating megabytes during a push, which was a third of a push's time.
 */
export Completed indexWith(u8[] pack, Vec<u8[]> extNames, i32[] extKinds, Vec<u8[]> extData) {
  if (pack.len() < 32) { return Completed.Damaged("shorter than a header and a checksum"); }
  if (pack[0] != 'P' || pack[1] != 'A' || pack[2] != 'C' || pack[3] != 'K') {
    return Completed.Damaged("not a pack: the magic is missing");
  }
  i32 count = (pack[8] as i32 << 24) | (pack[9] as i32 << 16) | (pack[10] as i32 << 8) | pack[11] as i32;
  if (count < 0 || count > 10000000) { return Completed.Damaged("implausible object count"); }

  i64[] offsets = i64[].filled(count, 0);
  i32[] kinds = i32[].filled(count, 0);
  i32[] baseIndex = i32[].filled(count, -1);
  Vec<u8[]> data = Vec.create();
  Vec<u8[]> baseNames = Vec.create();
  Map<i64, i32> byOffset = Map.withCapacity(count * 2 + 8, hashI64, i64Eq);

  // Pass one: where every object is, what kind of entry, and its inflated bytes.
  i32 at = 12;
  i32 stop = pack.len() - 20;
  for (i32 i = 0; i < count; i++) {
    if (at >= stop) { return Completed.Damaged("the pack ended before its object count"); }
    i64 here = at as i64;
    i32 b = pack[at] as i32;
    i32 kind = (b >> 4) & 7;
    i32 size = b & 0x0f;
    i32 shift = 4;
    at = at + 1;
    while ((b & 0x80) != 0) {
      if (at >= stop || shift > 28) { return Completed.Damaged("a size runs off the end"); }
      b = pack[at] as i32;
      size = size | ((b & 0x7f) << shift);
      shift = shift + 7;
      at = at + 1;
    }
    if (kind == 0 || kind == 5) { return Completed.Damaged("object type \{kind} is not defined"); }
    u8[] baseName = u8[]();
    if (kind == 6) {
      if (at >= stop) { return Completed.Damaged("a delta offset runs off the end"); }
      i32 c = pack[at] as i32;
      at = at + 1;
      i64 ofs = (c & 0x7f) as i64;
      while ((c & 0x80) != 0) {
        if (at >= stop) { return Completed.Damaged("a delta offset runs off the end"); }
        c = pack[at] as i32;
        at = at + 1;
        ofs = ((ofs + 1) << 7) | ((c & 0x7f) as i64);
      }
      i32? base = byOffset.get(here - ofs);
      // An offset delta's base comes before it, so it has been seen — or the pack is damaged.
      if (base is null) { return Completed.Damaged("a delta's base offset is not an object"); }
      baseIndex[i] = base!;
    } else if (kind == 7) {
      if (at + 20 > stop) { return Completed.Damaged("a base name runs off the end"); }
      baseName = u8[].filled(20, 0);
      baseName.copyFrom(pack, at, 0, 20);
      at = at + 20;
    }
    match (inflateAtResult(pack, at + 2)) {
      Err(why): { return Completed.Damaged("an object does not inflate: \{why}"); }
      Ok(got): {
        if (got.bytes.len() != size) {
          return Completed.Damaged("an object's header says \{size} bytes and \{got.bytes.len()} inflated");
        }
        at = got.end + 4;
        data.push(got.bytes);
      }
    }
    offsets[i] = here;
    kinds[i] = kind;
    baseNames.push(baseName);
    byOffset.set(here, i);
  }
  if (at != stop) { return Completed.Damaged("bytes left over before the checksum"); }

  // Who waits on whom: an offset delta on an index, a reference delta on a name.
  Vec<Vec<i32>> waitingOn = Vec.create();
  for (i32 i = 0; i < count; i++) { waitingOn.push(Vec.create()); }
  Map<u8[], Vec<i32>> waitingFor = Map.create(hashBytes, bytesEq);
  for (i32 i = 0; i < count; i++) {
    if (kinds[i] == 6) { waitingOn.get(baseIndex[i]).push(i); }
    else if (kinds[i] == 7) {
      Vec<i32>? list = waitingFor.get(baseNames.get(i));
      if (list is null) {
        Vec<i32> fresh = Vec.create();
        fresh.push(i);
        waitingFor.set(baseNames.get(i), fresh);
      } else {
        list!.push(i);
      }
    }
  }

  // Pass two: resolve outward from the whole objects, hashing each object once.
  i32[] resolvedKind = i32[].filled(count, 0);
  u8[] names = u8[].filled(count * 20, 0);
  Vec<i32> ready = Vec.create();
  for (i32 i = 0; i < count; i++) {
    if (kinds[i] >= 1 && kinds[i] <= 4) { resolvedKind[i] = kinds[i]; ready.push(i); }
  }
  // The supplied bases release what waits on them first.
  for (i32 j = 0; j < extNames.len(); j++) {
    Vec<i32>? list = waitingFor.get(extNames.get(j));
    if (list is null) { continue; }
    for (i32 k = 0; k < list!.len(); k++) {
      i32 c = list!.get(k);
      u8[]? made = applyDelta(extData.get(j), data.get(c));
      if (made is null) { return Completed.Damaged("a delta does not apply to its supplied base"); }
      data.set(c, made!);
      resolvedKind[c] = extKinds[j];
      ready.push(c);
    }
    waitingFor.remove(extNames.get(j));
  }
  i32 done = 0;
  i32 next = 0;
  while (next < ready.len()) {
    i32 i = ready.get(next);
    next = next + 1;
    u8[] body = data.get(i);
    u8[] name = objectName(resolvedKind[i], body);
    names.copyFrom(name, 0, i * 20, 20);
    done = done + 1;
    Vec<i32> children = waitingOn.get(i);
    Vec<i32>? byName = waitingFor.get(name);
    if (byName is not null) {
      for (i32 k = 0; k < byName!.len(); k++) { children.push(byName!.get(k)); }
      waitingFor.remove(name);
    }
    for (i32 k = 0; k < children.len(); k++) {
      i32 c = children.get(k);
      if (resolvedKind[c] != 0) { continue; }
      u8[]? made = applyDelta(body, data.get(c));
      if (made is null) { return Completed.Damaged("a delta does not apply to its base"); }
      data.set(c, made!);
      resolvedKind[c] = resolvedKind[i];
      ready.push(c);
    }
    // Every delta waiting on this object was known before resolving began and has now been applied, so its
    // bytes are needed no longer.
    waitingOn.set(i, Vec.create());
    data.set(i, u8[]());
  }

  if (done < count) {
    // What is left waits on names this pack does not hold — a thin pack — or on a cycle, which is damage.
    Vec<u8[]> need = Vec.create();
    u8[][] keys = waitingFor.keys();
    for (i32 k = 0; k < keys.len(); k++) { need.push(keys[k]); }
    if (need.len() == 0) { return Completed.Damaged("a delta chain could not be resolved"); }
    return Completed.Lacking(need);
  }

  // Each object's CRC-32 over its bytes as they sit in the pack, header included.
  u32[] crcInPackOrder = u32[].filled(count, 0);
  for (i32 i = 0; i < count; i++) {
    i32 from = offsets[i] as~ i32;
    i32 to = i + 1 < count ? offsets[i + 1] as~ i32 : stop;
    u8[] seg = u8[].filled(to - from, 0);
    seg.copyFrom(pack, from, 0, to - from);
    crcInPackOrder[i] = crc32(seg);
  }

  // The supplied bases, appended whole: their names are the ones asked for, their offsets and CRCs known as
  // they are written.
  i32 m = extNames.len();
  i32 total = count + m;
  u8[] allNames = u8[].filled(total * 20, 0);
  allNames.copyFrom(names, 0, 0, count * 20);
  i64[] allOffsets = i64[].filled(total, 0);
  u32[] allCrcs = u32[].filled(total, 0);
  for (i32 i = 0; i < count; i++) { allOffsets[i] = offsets[i]; allCrcs[i] = crcInPackOrder[i]; }
  u8[] whole = pack;
  if (m > 0) {
    Buf out = Buf.withCapacity(pack.len() + 64);
    out.pushBytes(pack, 0, 8);
    out.push(((total >> 24) & 0xff) as@ u8);
    out.push(((total >> 16) & 0xff) as@ u8);
    out.push(((total >> 8) & 0xff) as@ u8);
    out.push((total & 0xff) as@ u8);
    out.pushBytes(pack, 12, stop - 12);
    for (i32 j = 0; j < m; j++) {
      Buf entry = Buf.create();
      pushEntryHeader(entry, extKinds[j], extData.get(j).len());
      pushStoredZlib(entry, extData.get(j));
      u8[] e = entry.take();
      allNames.copyFrom(extNames.get(j), 0, (count + j) * 20, 20);
      allOffsets[count + j] = out.len as i64;
      allCrcs[count + j] = crc32(e);
      out.pushAll(e);
    }
    u8[] body = out.take();
    Buf w = Buf.withCapacity(body.len() + 20);
    w.pushAll(body);
    w.pushAll(sha1(body));
    whole = w.take();
  }

  // Names ascending, with each offset and CRC carried along.
  i32[] order = i32[].filled(total, 0);
  for (i32 i = 0; i < total; i++) { order[i] = i; }
  i32[] scratch = i32[].filled(total, 0);
  mergeSort(order, scratch, 0, total, allNames);
  u8[] sortedNames = u8[].filled(total * 20, 0);
  i64[] sortedOffsets = i64[].filled(total, 0);
  u32[] crcs = u32[].filled(total, 0);
  for (i32 i = 0; i < total; i++) {
    i32 from = order[i];
    sortedNames.copyFrom(allNames, from * 20, i * 20, 20);
    sortedOffsets[i] = allOffsets[from];
    crcs[i] = allCrcs[from];
  }
  return Completed.Done(whole, PackIndex(total, sortedNames, sortedOffsets, crcs));
}

/** An entry header: the kind, and the size in git's little-endian groups after it. */
void pushEntryHeader(Buf out, i32 kind, i32 size) {
  i32 first = ((kind & 7) << 4) | (size & 0x0f);
  i32 rest = size >> 4;
  if (rest != 0) { first = first | 0x80; }
  out.push(first as@ u8);
  while (rest != 0) {
    i32 b = rest & 0x7f;
    rest = rest >> 7;
    if (rest != 0) { b = b | 0x80; }
    out.push(b as@ u8);
  }
}

/** `data` as a zlib stream of stored blocks: the header, blocks of at most 65,535 bytes, and the Adler-32. */
export void pushStoredZlib(Buf out, u8[] data) {
  out.push(0x78 as u8);
  out.push(0x01 as u8);
  i32 at = 0;
  while (true) {
    i32 n = data.len() - at < 65535 ? data.len() - at : 65535;
    bool last = at + n >= data.len();
    out.push((last ? 1 : 0) as@ u8);
    out.push((n & 0xff) as@ u8);
    out.push(((n >> 8) & 0xff) as@ u8);
    out.push(((~n) & 0xff) as@ u8);
    out.push((((~n) >> 8) & 0xff) as@ u8);
    out.pushBytes(data, at, n);
    at = at + n;
    if (last) { break; }
  }
  // Adler-32, reduced every 5,552 bytes — the most that cannot overflow 32 bits — rather than every byte.
  i32 a = 1;
  i32 b = 0;
  i32 i = 0;
  while (i < data.len()) {
    i32 stopAt = data.len() - i < 5552 ? data.len() : i + 5552;
    while (i < stopAt) {
      a = a + (data[i] as i32);
      b = b + a;
      i++;
    }
    a = a % 65521;
    b = b % 65521;
  }
  out.push(((b >> 8) & 0xff) as@ u8);
  out.push((b & 0xff) as@ u8);
  out.push(((a >> 8) & 0xff) as@ u8);
  out.push((a & 0xff) as@ u8);
}

bool nameBefore(u8[] names, i32 a, i32 b) {
  for (i32 q = 0; q < 20; q++) {
    u8 x = names[a * 20 + q];
    u8 y = names[b * 20 + q];
    if (x != y) { return x < y; }
  }
  return false;
}

void mergeSort(i32[] a, i32[] tmp, i32 lo, i32 hi, u8[] names) {
  if (hi - lo < 2) { return; }
  i32 mid = lo + (hi - lo) / 2;
  mergeSort(a, tmp, lo, mid, names);
  mergeSort(a, tmp, mid, hi, names);
  i32 i = lo;
  i32 j = mid;
  i32 k = lo;
  while (i < mid && j < hi) {
    if (nameBefore(names, a[j], a[i])) { tmp[k] = a[j]; j++; } else { tmp[k] = a[i]; i++; }
    k++;
  }
  while (i < mid) { tmp[k] = a[i]; i++; k++; }
  while (j < hi) { tmp[k] = a[j]; j++; k++; }
  for (i32 x = lo; x < hi; x++) { a[x] = tmp[x]; }
}
