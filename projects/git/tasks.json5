{
  // wac's packages this server is built on, at the commit WAC_COMMIT pins, into vendor/wac.
  deps: "sh tools/deps.sh",
  // The server, as one module: `wac dist/gitserve.wasm <root> …`.
  build: "mkdir -p dist && wac build --allow-read --allow-write --allow-net cmd/gitserve.wac -o dist/gitserve",
  // The protocol's decisions about bytes, and the pack indexer against git index-pack, in wac.
  test: "wac test --allow-run --allow-read --allow-write --allow-env test",
  // The server against real git: clone, fetch, ls-remote and push, each judged by git. Needs git and curl.
  e2e: "sh test/e2e.sh",
  // Against git's own http-backend and git daemon, on the same repositories: `wac task bench -- [--runs N] [--repos a,b]`.
  bench: "python3 bench/bench.py",
}
