// `src/sha1.wac` against the published vectors and against wac's own SHA-1, at every length that crosses a block.

import { T } from "../vendor/wac/packages/wactest/src/assert.wac";
import { sha1 } from "../vendor/wac/packages/crypto/src/sha1.wac";
import { encode } from "../vendor/wac/packages/codec/src/hex.wac";
import { Hash, sha1Of } from "../src/sha1.wac";

string hex(u8[] b) { return string.fromBytes(encode(b)); }

export string test_the_published_vectors() {
  T t = T.create();
  t.isTrue(hex(sha1Of("".toBytes())) == "da39a3ee5e6b4b0d3255bfef95601890afd80709", "empty");
  t.isTrue(hex(sha1Of("abc".toBytes())) == "a9993e364706816aba3e25717850c26c9cd0d89d", "abc");
  t.isTrue(hex(sha1Of("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".toBytes()))
           == "84983e441c3bd26ebaae4aa1f95129e5e54670f1", "two blocks");
  t.isTrue(hex(sha1Of("blob 6\u{0}hello\n".toBytes())) == "ce013625030ba8dba906f756967f9e9ca394464a", "git's hello");
  return t.report();
}

export string test_every_length_and_split_agrees_with_wacs() {
  T t = T.create();
  u8[] d = u8[].filled(300, 0);
  for (i32 i = 0; i < d.len(); i++) { d[i] = ((i * 131 + 7) & 255) as@ u8; }
  for (i32 n = 0; n <= 300; n++) {
    u8[] part = u8[].filled(n, 0);
    part.copyFrom(d, 0, 0, n);
    string want = hex(sha1(part));
    t.isTrue(hex(sha1Of(part)) == want, "length \{n}");
    // Fed in two pieces split at every third point: buffering across a block edge.
    for (i32 cut = 0; cut <= n; cut = cut + 3) {
      Hash h = Hash.create();
      h.updateRange(part, 0, cut);
      h.updateRange(part, cut, n - cut);
      if (hex(h.finish()) != want) { t.fail("length \{n} split at \{cut}"); }
    }
  }
  return t.report();
}
