// The native dialer, run against a listener: wac's own WebRTC stack underneath, the shared scenarios on top.
//
//   wac run --allow-net cmd/dial.wac [quic] <address>
//
// Prints `PASS <what>` / `FAIL <what>: <why>` per scenario (`scenarios.wac`) and `DONE <n>` last — the same lines
// the page prints, so `test/dial_test.wac` reads both the same way.

import { Sys } from "std";
import { dial } from "../src/webrtc/dial.wac";
import { dialQuic } from "../src/quic/dial.wac";
import { Limits } from "../src/webrtc/flow.wac";
import { Report, scenarios } from "./scenarios.wac";

export async i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() < 1) {
    sys.warn("usage: dial [quic] <address>");
    return 2;
  }
  i32 printed = 0;
  Report r = Report { emit: (string text) => {
    // `emit` is handed the whole report so far; print what is new.
    string fresh = text.slice(printed, text.len());
    printed = text.len();
    if (fresh.len() > 0 && fresh.slice(fresh.len() - 1, fresh.len()) == "\n") { fresh = fresh.slice(0, fresh.len() - 1); }
    sys.log(fresh);
  } };
  bool overQuic = args[0] == "quic";
  string address = overQuic && args.len() > 1 ? args[1] : args[0];
  auto dialled = overQuic ? await dialQuic(sys, address, 15000 as i64) : await dial(sys, address, Limits.defaults(), 15000 as i64);
  if (dialled.isErr()) {
    r.add(false, "the dial establishes", dialled.err()!.describe());
    r.done();
    return 1;
  }
  r.add(true, overQuic ? "the dial establishes (wac's QUIC and TLS 1.3, pinned to the certhash)"
                       : "the dial establishes (wac's ICE, DTLS client and SCTP initiator, pinned to the certhash)", "");
  await scenarios(sys, dialled.unwrap(), r);
  r.done();
  // The connection's close goes out from the socket's loop; let it finish before the program does.
  await sys.drain();
  return 0;
}
