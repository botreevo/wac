// A page that dials a KPS listener and reports what happened: the browser leg of wac-kps's own dialer.
//
//   wac run --allow-read --allow-write --allow-run <webbuild>/build.wac cmd/dialpage.wac <dir> --grant webrtc
//   open <dir>/index.html#<address>     (or open it bare, and set the `#` part once it has loaded)
//
// The address is the page's `#` part. Each scenario adds a line `PASS <what>` or `FAIL <what>: <why>` to the
// `<pre id="status">`, and `DONE <n>` ends it — what `interop/js/page-dial.mjs` waits for and prints. The scenarios
// are the ones Chromium's `@kpstreams/webrtc-client` runs against the listener, so the two clients can be held to the
// same listeners.

import { Page, Element, Rtc } from "web";
import { Buf, Result, Ticket } from "core";
import { dialFromPage } from "../src/webrtc/page.wac";
import { Limits } from "../src/webrtc/flow.wac";
import { Connection, Stream, ReadResult } from "../src/api.wac";
import { Code, Reason } from "../src/errors.wac";

struct Report {
  Element pre;
  string text;
  i32 n;

  void add(this, bool ok, string what, string why) {
    this.text += (ok ? "PASS " + what : "FAIL \{what}: \{why}") + "\n";
    this.n++;
    this.pre.text(this.text);
  }
  void done(this) {
    this.text += "DONE \{this.n}\n";
    this.pre.text(this.text);
  }
}

/** Everything the peer sends on `s` until its FIN, or an empty answer and why not. */
async Result<u8[], string> readAll(Stream s) {
  Buf got = Buf.create();
  while (true) {
    match (await s.read()) {
      Data(b): { got.pushAll(b); }
      End: { return Result.Ok(got.take()); }
      Failed(why): { return Result.Err(why.describe()); }
    }
  }
}

/** Open a stream, write `bytes` and FIN, and read the echo back to EOF. */
async Result<u8[], string> echo(Connection c, u8[] bytes) {
  match (await c.openStream()) {
    Ok(s): {
      Ticket<Result<u8[], string>> reading = readAll(s);
      if ((await s.write(bytes)).isErr()) { return Result.Err("the write failed"); }
      s.closeWrite();
      return await reading;
    }
    Err(why): { return Result.Err("no stream: " + why.describe()); }
  }
}

/** One read, as a `Result` so a deadline can be put on it. */
async Result<ReadResult, bool> readOnce(Stream s) { return Result.Ok(await s.read()); }

bool same(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) { if (a[i] != b[i]) { return false; } }
  return true;
}

export async i32 main(Page page) {
  Element pre = page.root().append("pre");
  pre.attr("id", "status");
  Report r = Report(pre, "", 0);
  // The address arrives as the `#` part. A harness may set it after the page has loaded — Chromium shows a page no
  // local interface to gather ICE candidates on until it has media permission, which a harness grants from outside.
  while (page.location() == "") { await page.sleep(50); }
  string address = page.location();
  match (await Rtc.of(page.sys)) {
    Err(why): { r.add(false, "the page has wac.webrtc", why); r.done(); return 1; }
    Ok(rtc): {
      auto dialled = await dialFromPage(page.sys, rtc, address, Limits.defaults(), 15000 as i64);
      if (dialled.isErr()) {
        r.add(false, "the dial establishes", dialled.err()!.describe());
        r.done();
        return 1;
      }
      Connection c = dialled.unwrap();
      r.add(true, "the dial establishes (the browser's ICE and DTLS pinned to the certhash; wac's HELLO both ways)", "");

      auto one = await echo(c, "hello kps".toBytes());
      r.add(one.isOk() && string.fromBytes(one.unwrap()) == "hello kps", "a stream echoes and ends in EOF",
            one.isErr() ? one.err()! : string.fromBytes(one.unwrap()));

      u8[] big = u8[].filled(3 * 1048576, 0);
      for (i32 i = 0; i < big.len(); i++) { big[i] = ((i * 31 + 7) & 0xFF) as@ u8; }
      auto three = await echo(c, big);
      r.add(three.isOk() && same(three.unwrap(), big), "3 MiB echoes intact — past the 1 MiB stream window",
            three.isErr() ? three.err()! : "\{three.unwrap().len()} bytes back");

      Ticket<Result<u8[], string>>[] many = [
        echo(c, "s0".toBytes()), echo(c, "s1".toBytes()), echo(c, "s2".toBytes()), echo(c, "s3".toBytes()),
        echo(c, "s4".toBytes()), echo(c, "s5".toBytes()), echo(c, "s6".toBytes()), echo(c, "s7".toBytes())];
      bool allOk = true;
      for (i32 i = 0; i < many.len(); i++) {
        auto got = await many[i];
        if (got.isErr() || string.fromBytes(got.unwrap()) != "s\{i}") { allOk = false; }
      }
      r.add(allOk, "eight concurrent streams, each its own bytes", "");

      bool rowOk = true;
      string why = "";
      for (i32 i = 0; i < 120 && rowOk; i++) {
        auto got = await echo(c, "r\{i}".toBytes());
        if (got.isErr() || string.fromBytes(got.unwrap()) != "r\{i}") {
          rowOk = false;
          why = "stream \{i}: \{got.isErr() ? got.err()! : string.fromBytes(got.unwrap())}";
        }
      }
      r.add(rowOk, "120 streams one after another — past the 100-stream limit, so retired slots come back", why);

      for (i32 i = 0; i < 10; i++) { c.sendDatagram("d\{i}".toBytes()); }
      i32 back = 0;
      for (i32 i = 0; i < 10; i++) {
        auto d = await page.sys.clock().within(c.receiveDatagram(), 3000);
        if (d.isOk()) { back++; }
      }
      r.add(back >= 8, "datagrams cross both ways", "\{back} of 10 back");
      Result<bool, Reason> tooBig = c.sendDatagram(u8[].filled(5000, 0));
      r.add(tooBig.isErr() && tooBig.err()!.code.name() == "too-large", "an oversized datagram is refused with too-large", "");

      match (await c.openStream()) {
        Ok(s): {
          s.resetWrite(Reason.of(Code.Timeout));
          auto res = await page.sys.clock().within(readOnce(s), 5000);
          string got = "no answer";
          if (res.isOk()) {
            got = match (res.unwrap()) { Data(b): "data", End: "end", Failed(w): w.code.name() };
          }
          r.add(got == "timeout", "a reset reaches the echo server, which resets back with the same code", got);
        }
        Err(e): { r.add(false, "a reset round-trips", e.describe()); }
      }
      c.close(Reason.of(Code.None));
    }
  }
  r.done();
  return 0;
}
