// The error-code registry — SPEC §9.1.
//
// A reset, a cancelled read, a coded stream close and a connection close each carry one of these, and the
// number travels on the wire: in the WebRTC framing's RESET and STOP_SENDING frames and the control
// channel's CONNECTION_CLOSE, and as QUIC application error codes. Every implementation uses the same
// numbers so a Go server's `protocol-error` is a browser's `protocol-error`.
//
// **An unknown received number is `internal-error`**, never dropped and never a clean close: a peer that
// says something we cannot name has still said that something went wrong.

/** A code from the registry. `None` is wire 0: a close or reset with no particular reason. */
export enum Code {
  None,
  Cancelled,
  Closed,
  Reset,
  Timeout,
  NetworkError,
  ProtocolError,
  Unsupported,
  TooLarge,
  QueueFull,
  PermissionDenied,
  InternalError,

  /** The wire `uint32`, as a non-negative i64 so a value above 2^31 never reads as negative. */
  i64 wire(const this) {
    return match (this) {
      None: 0 as i64, Cancelled: 1 as i64, Closed: 2 as i64, Reset: 3 as i64, Timeout: 4 as i64,
      NetworkError: 5 as i64, ProtocolError: 6 as i64, Unsupported: 7 as i64, TooLarge: 8 as i64,
      QueueFull: 9 as i64, PermissionDenied: 10 as i64, InternalError: 11 as i64,
    };
  }

  /** The canonical name, as the registry spells it — `network-error`, not `NetworkError`. */
  string name(const this) {
    return match (this) {
      None: "", Cancelled: "cancelled", Closed: "closed", Reset: "reset", Timeout: "timeout",
      NetworkError: "network-error", ProtocolError: "protocol-error", Unsupported: "unsupported",
      TooLarge: "too-large", QueueFull: "queue-full", PermissionDenied: "permission-denied",
      InternalError: "internal-error",
    };
  }

  bool isNone(const this) { return match (this) { None: true, default: false }; }
}

/** The code a received wire value names; anything outside the registry is `InternalError`. */
export Code codeFromWire(i64 v) {
  if (v == 0 as i64) { return Code.None; }
  if (v == 1 as i64) { return Code.Cancelled; }
  if (v == 2 as i64) { return Code.Closed; }
  if (v == 3 as i64) { return Code.Reset; }
  if (v == 4 as i64) { return Code.Timeout; }
  if (v == 5 as i64) { return Code.NetworkError; }
  if (v == 6 as i64) { return Code.ProtocolError; }
  if (v == 7 as i64) { return Code.Unsupported; }
  if (v == 8 as i64) { return Code.TooLarge; }
  if (v == 9 as i64) { return Code.QueueFull; }
  if (v == 10 as i64) { return Code.PermissionDenied; }
  return Code.InternalError;
}

/**
 * Why something ended: a code, and optionally words for a person.
 *
 * The message never crosses the wire — only the code does — so it describes this end's view of the failure.
 */
export struct Reason {
  Code code;
  string message;

  Reason of(Code code) { return Reason(code, ""); }
  Reason saying(Code code, string message) { return Reason(code, message); }

  string describe(const this) {
    string n = this.code.name();
    if (this.message.len() == 0) { return n.len() == 0 ? "no reason" : n; }
    return n.len() == 0 ? this.message : "\{n}: \{this.message}";
  }
}
