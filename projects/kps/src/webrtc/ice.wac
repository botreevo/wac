// The KPS ICE credentials — SPEC §5.2.
//
// **The ufrag is the connection's demux key and the password is derived from the certhash**, which both sides
// already hold. The client picks a random ufrag, puts it in the first STUN binding request's USERNAME, and the
// listener learns of the connection from that — there is no signalling channel to carry an offer. The password
// is never sent: both ends compute it, and it keys STUN's MESSAGE-INTEGRITY, so only a client that knows the
// certhash can get a listener to start a DTLS handshake (probe resistance).
//
//     ice-pwd = base64-std-nopad( HMAC-SHA256( certhash digest, "kps-ice-pwd-v1:" || ice-ufrag ) )

import { crypto.hmacSha256, codec.base64Encode, codec.BASE64_STANDARD, codec.hexEncode } from "wac";

/** The password both ends derive for `ufrag` from the server's certificate digest. */
export string icePassword(const u8[] digest, string ufrag) {
  u8[] key = u8[].filled(digest.len(), 0);
  key.copyFrom(digest, 0, 0, digest.len());
  u8[] mac = hmacSha256(key, ("kps-ice-pwd-v1:" + ufrag).toBytes());
  return string.fromBytes(base64Encode(mac, BASE64_STANDARD(), false));
}

/**
 * A ufrag from 8 random bytes: 16 lower-case hex digits, 64 bits of entropy — the reference clients' shape.
 * Hex is inside RFC 8839's ice-char set, which a listener checks before it does anything with a ufrag.
 */
export string ufragFrom(const u8[] random8) {
  if (random8.len() != 8) { trap; }
  return string.fromBytes(hexEncode(random8));
}

/**
 * Whether a ufrag a peer sent is one a listener should act on: 4 to 256 characters of RFC 8839 ice-char
 * (ALPHA / DIGIT / "+" / "/").
 *
 * Checked before anything else is done with it. The reference listener learned this the hard way: a ufrag
 * outside the set made its native WebRTC library abort the process, so one malformed STUN packet stopped the
 * server. Nothing here would crash, but a ufrag is also a map key and a log field, and a peer's bytes should be
 * the shape the protocol says before they are either.
 */
export bool ufragAcceptable(string ufrag) {
  if (ufrag.len() < 4 || ufrag.len() > 256) { return false; }
  u8[] b = ufrag.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    u8 c = b[i];
    bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '+' || c == '/';
    if (!ok) { return false; }
  }
  return true;
}
