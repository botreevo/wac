// The two SDP texts a KPS WebRTC dial needs — SPEC §5.2 — as the reference client writes them
// (`@kpstreams/core`'s `sdp.ts`).
//
// **There is no signalling channel.** A client makes a real offer, then rewrites its ICE credentials to the ufrag it
// chose and the password both ends derive; and it *synthesises* the listener's answer from the address — ICE-lite,
// one host candidate at the listener's ip and port, the fingerprint the certhash names, `setup:passive` so the client
// starts DTLS. The listener never sends an answer: it learns the connection's ufrag from the first STUN check.

import { Address, sdpFingerprint } from "../address.wac";

/** The offer with its `a=ice-ufrag` and `a=ice-pwd` lines replaced, lines joined with CRLF as SDP requires. */
export string rewriteOfferUfrag(string sdp, string ufrag, string pwd) {
  string out = "";
  i32 at = 0;
  bool first = true;
  while (at <= sdp.len()) {
    i32 nl = sdp.slice(at, sdp.len()).indexOf("\n");
    i32 end = nl < 0 ? sdp.len() : at + nl;
    string line = sdp.slice(at, end);
    if (line.len() > 0 && line.slice(line.len() - 1, line.len()) == "\r") { line = line.slice(0, line.len() - 1); }
    if (line.indexOf("a=ice-ufrag:") == 0) { line = "a=ice-ufrag:" + ufrag; }
    else if (line.indexOf("a=ice-pwd:") == 0) { line = "a=ice-pwd:" + pwd; }
    out += (first ? "" : "\r\n") + line;
    first = false;
    if (nl < 0) { break; }
    at = end + 1;
  }
  return out;
}

/** The listener's answer, as the client builds it: what the address says, and nothing the listener sent. */
export string synthesizeAnswer(const Address a, const u8[] digest, string ufrag, string pwd) {
  bool v6 = a.ip.indexOf(":") >= 0;
  string fam = v6 ? "IP6" : "IP4";
  string[] lines = [
    "v=0",
    "o=- 0 0 IN \{fam} \{v6 ? "::" : "0.0.0.0"}",
    "s=-",
    "t=0 0",
    "a=ice-lite",
    "m=application \{a.port} UDP/DTLS/SCTP webrtc-datachannel",
    "c=IN \{fam} \{a.ip}",
    "a=mid:0",
    "a=ice-ufrag:\{ufrag}",
    "a=ice-pwd:\{pwd}",
    "a=fingerprint:sha-256 \{sdpFingerprint(digest)}",
    "a=setup:passive",
    "a=sctp-port:5000",
    "a=max-message-size:1048576",
    "a=candidate:1 1 UDP 1 \{a.ip} \{a.port} typ host",
  ];
  string out = "";
  for (string l in lines) { out += l + "\r\n"; }
  return out;
}
