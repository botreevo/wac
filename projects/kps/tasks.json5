{
  // `wac task <name>`. The tests that ask a reference implementation need interop/js installed and interop/go built,
  // once: `wac task deps` (npm, and Go 1.24).
  deps: "cd interop/js && npm install --no-audit --no-fund && cd ../go && GOFLAGS=-mod=mod go build -o bin/kps-dial github.com/ethereum/kps/libs/go/cmd/dial && GOFLAGS=-mod=mod go build -o bin/kps-server github.com/ethereum/kps/libs/go/cmd/server",
  check: "wac check src",
  test: "wac test --allow-read --allow-write --allow-run --allow-net test",
}
