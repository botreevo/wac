// Assertions for this repository's tests.
//
// A test is an exported `test*` function returning a string: empty is a pass and anything else is what failed.
// Failures accumulate rather than trap, so one run reports every disagreement. wac's own `wactest` has the
// same shape and is not reachable from outside the wac repository.

import { codec.hexEncode } from "wac";

export struct Check {
  i32 failed;
  string messages;

  Check create() { return Check(0, ""); }

  void fail(this, string what) {
    this.failed++;
    if (this.failed > 12) { return; }
    if (this.messages.len() > 0) { this.messages += "; "; }
    this.messages += what;
  }

  void ok(this, bool cond, string what) { if (!cond) { this.fail(what); } }
  void no(this, bool cond, string what) { if (cond) { this.fail(what); } }

  void eqStr(this, string got, string want, string what) {
    if (got != want) { this.fail("\{what}: got \"\{got}\", want \"\{want}\""); }
  }

  void eqI32(this, i32 got, i32 want, string what) {
    if (got != want) { this.fail("\{what}: got \{got}, want \{want}"); }
  }

  void eqI64(this, i64 got, i64 want, string what) {
    if (got != want) { this.fail("\{what}: got \{got}, want \{want}"); }
  }

  void eqBytes(this, const u8[] got, const u8[] want, string what) {
    bool same = got.len() == want.len();
    for (i32 i = 0; i < got.len() && same; i++) { if (got[i] != want[i]) { same = false; } }
    if (!same) { this.fail("\{what}: got \{hex(got)}, want \{hex(want)}"); }
  }

  string report(this) {
    if (this.failed > 12) { return this.messages + " … and more: \{this.failed} failures in all"; }
    return this.messages;
  }
}

export string hex(const u8[] b) {
  u8[] copy = u8[].filled(b.len(), 0);
  copy.copyFrom(b, 0, 0, b.len());
  return string.fromBytes(hexEncode(copy));
}

/** Bytes from hex digits; traps on anything else — test vectors are written by hand, so a typo is a bug. */
export u8[] unhex(string s) {
  u8[] t = s.toBytes();
  if (t.len() % 2 != 0) { trap; }
  u8[] out = u8[].filled(t.len() / 2, 0);
  for (i32 i = 0; i < out.len(); i++) { out[i] = ((nib(t[i * 2]) << 4) | nib(t[i * 2 + 1])) as@ u8; }
  return out;
}

i32 nib(u8 c) {
  if (c >= '0' && c <= '9') { return (c - '0') as i32; }
  if (c >= 'a' && c <= 'f') { return (c - 'a') as i32 + 10; }
  if (c >= 'A' && c <= 'F') { return (c - 'A') as i32 + 10; }
  trap;
}
