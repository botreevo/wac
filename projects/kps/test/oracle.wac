// Asking a reference implementation: one process, every question on its standard input, every answer back.
//
// The scripts under `interop/js/` answer one line per question and finish with `DONE <n>`. Requiring the count
// is what stops a script that died halfway from reading as one that agreed with everything before the point it
// died.

import { Buf, flatten } from "core";
import { Procs, ChildEnv, Launch, Exec } from "std";
import { Check } from "./check.wac";

export struct Answers {
  bool ok;
  string[] lines;
}

/** Run `node <script>` from `interop/js` with `questions` on its input, and check it answered every one. */
export Answers ask(Check c, Procs procs, string script, string[] questions) {
  Buf input = Buf.create();
  for (string q in questions) { input.pushStr(q); input.push('\n'); }
  auto ran = flatten(procs.exec("/bin/sh", ["-c", "cd interop/js && node \{script}"], input.take(),
                                ChildEnv.inherited(), Launch.plain()).wait());
  Exec? e = ran.ok();
  if (e is null) {
    c.fail("could not run node \{script}");
    return Answers(false, string[]());
  }
  string[] got = splitLines(string.fromBytes(e!.stdout));
  string done = "DONE \{questions.len()}";
  if (e!.status != 0 || got.len() != questions.len() + 1 || got[questions.len()] != done) {
    c.fail("\{script} did not answer all \{questions.len()} questions (status \{e!.status}): " +
           string.fromBytes(e!.stderr));
    return Answers(false, got);
  }
  return Answers(true, got);
}

export string[] splitLines(string s) {
  i32 n = 0;
  for (i32 i = 0; i < s.len(); i++) { if (s.slice(i, i + 1) == "\n") { n++; } }
  if (s.len() > 0 && s.slice(s.len() - 1, s.len()) != "\n") { n++; }
  string[] out = string[].filled(n, "");
  i32 k = 0;
  i32 from = 0;
  for (i32 i = 0; i < s.len(); i++) {
    if (s.slice(i, i + 1) == "\n") { out[k] = s.slice(from, i); k++; from = i + 1; }
  }
  if (from < s.len()) { out[k] = s.slice(from, s.len()); }
  return out;
}

/** The `i`th space-separated word of a line, or "". */
export string word(string line, i32 i) {
  i32 at = 0;
  for (i32 w = 0; w < i; w++) {
    i32 sp = line.slice(at, line.len()).indexOf(" ");
    if (sp < 0) { return ""; }
    at = at + sp + 1;
  }
  i32 end = line.slice(at, line.len()).indexOf(" ");
  return end < 0 ? line.slice(at, line.len()) : line.slice(at, at + end);
}

/** Everything after the `i`th space — for answers whose last field may itself contain spaces. */
export string after(string line, i32 i) {
  i32 at = 0;
  for (i32 w = 0; w < i; w++) {
    i32 sp = line.slice(at, line.len()).indexOf(" ");
    if (sp < 0) { return ""; }
    at = at + sp + 1;
  }
  return line.slice(at, line.len());
}
