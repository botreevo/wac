{
  // KPS — Key-Pinned Streams — in wac: a listener that takes WebRTC and QUIC on one UDP port, and dialers for
  // both, native and from a page. The transports themselves are wac's own packages (webrtc, quic, tls); this
  // repository is the KPS layer on top of them, following github.com/ethereum/kps SPEC.md.
  exports: './src/kps.wac',
  imports: {
    // The page and its builder: a dialer in a browser tab drives the browser's own WebRTC through `web`'s
    // `wac.webrtc` capability (src/webrtc/page.wac), and the tests build a page with `webbuild`.
    web: { git: 'https://github.com/voltrevo/wac.git', ref: '6c9747ee9e5b08306496a4924cca6b07ac56cfb6', subdir: './projects/web' },
    webbuild: { git: 'https://github.com/voltrevo/wac.git', ref: '6c9747ee9e5b08306496a4924cca6b07ac56cfb6', subdir: './projects/web/tools' },
    wac: { git: 'https://github.com/voltrevo/wac.git', ref: '0b74a083dce3309990724cd1a8d969991f4c33fe' },
  },
}
