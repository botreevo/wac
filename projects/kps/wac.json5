{
  // KPS — Key-Pinned Streams — in wac: a listener that takes WebRTC and QUIC on one UDP port, and dialers for
  // both, native and from a page. The transports themselves are wac's own packages (webrtc, quic, tls); this
  // repository is the KPS layer on top of them, following github.com/ethereum/kps SPEC.md.
  exports: './src/kps.wac',
  imports: {
    wac: { git: 'https://github.com/voltrevo/wac.git', ref: '25e1e658ff74b4a1d56e52994e5a372b32f5d9bc' },
  },
}
