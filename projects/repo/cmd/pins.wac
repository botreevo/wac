// Check the pins into this repository: `wac run --allow-run --allow-read projects/repo/cmd/pins.wac -- [path…]`.
//
// With no paths it checks every `wac.lock` in the repository; a project's gate names its own directory. It
// prints one line per problem and exits 1 if there was any. See `src/pins.wac` for what is checked and why.

import { Sys } from "std";
import { Repo, canonicalOf, problems, topOf } from "../src/pins.wac";

export i32 main(Sys sys) {
  string top = topOf(sys.procs(), sys.files(), ".");
  if (top == "") { sys.stderr().line("pins: not inside a git working tree"); return 2; }
  Repo r = Repo(sys.procs(), sys.files(), top);
  string canonical = canonicalOf(r);
  if (canonical == "") { sys.stderr().line("pins: projects/repo/repository.txt is missing"); return 2; }
  string[] given = sys.args();
  string[] paths = given.len() == 0 ? ["projects"] : given;
  auto found = problems(r, canonical, paths);
  for (i32 i = 0; i < found.len(); i++) { sys.stderr().line("pins: \{found.get(i)}"); }
  if (found.len() > 0) { return 1; }
  sys.stdout().line("pins: every pin into \{canonical} is in this history");
  return 0;
}
