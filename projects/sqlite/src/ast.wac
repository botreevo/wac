// What the parser produces. Names are kept as written; comparisons against them fold case where SQLite
// does.

import { Value } from "./value.wac";

export enum Expr {
  Lit(Value v),
  // A parameter, by its 1-based number: `?` takes the next one, `?3` names one, and `:name` gets a
  // number from its first appearance, as in SQLite.
  Param(i32 n),
  Col(string? table, string name),
  Unary(string op, Expr e),            // "-", "+", "~", "NOT"
  Binary(string op, Expr l, Expr r),   // upper case for words: "AND", "OR", "LIKE", "GLOB", "IS", "IS NOT"
  IsNull(Expr e, bool negated),
  Between(Expr e, Expr lo, Expr hi, bool negated),
  InList(Expr e, Expr[] items, bool negated),
  InSelect(Expr e, Select s, bool negated),
  Call(string name, Expr[] args, bool star, bool distinct),   // name in lower case
  Case(Expr? base, Expr[] whens, Expr[] thens, Expr? otherwise),
  Cast(Expr e, string type),
  Subquery(Select s),
  Exists(Select s, bool negated),
  Collate(Expr e, string collation),
}

export struct ResultCol {
  Expr? expr;        // null for `*` and `t.*`
  string? star;      // "" for `*`, the table for `t.*`
  string? alias;
}

export static i32 JOIN_FIRST = 0;
export static i32 JOIN_INNER = 1;
export static i32 JOIN_LEFT = 2;
export static i32 JOIN_CROSS = 3;

export struct Source {
  string? table;
  Select? sub;
  string? alias;
  i32 join = 0;
  Expr? on;
  string[] usingCols;
}

export struct OrderTerm {
  Expr expr;
  bool desc = false;
  i32 nulls = 0;        // 0 default, 1 NULLS FIRST, 2 NULLS LAST
}

export struct Select {
  bool distinct = false;
  ResultCol[] cols;
  Source[] from;
  Expr? where;
  Expr[] groupBy;
  Expr? having;
  OrderTerm[] orderBy;
  Expr? limit;
  Expr? offset;
  // A compound: this select's rows, then `op` with `next`'s. Order and limit belong to the last.
  string? compound;   // "UNION", "UNION ALL", "INTERSECT", "EXCEPT"
  Select? next;
  Expr[][]? values;   // a VALUES list standing where a select would
}

export struct ColumnDef {
  string name;
  string typeName;
  bool primaryKey = false;
  bool pkDesc = false;
  bool autoincrement = false;
  bool notNull = false;
  bool unique = false;
  Expr? dflt;
  string? collate;
}

export struct TableConstraint {
  string kind;       // "PRIMARY KEY", "UNIQUE"
  string[] cols;
}

export struct CreateTable {
  string name;
  bool ifNotExists = false;
  ColumnDef[] cols;
  TableConstraint[] constraints;
  bool withoutRowid = false;
  string sql;        // what sqlite_schema stores
}

export struct IndexCol {
  string name;
  bool desc = false;
}

export struct CreateIndex {
  string name;
  string table;
  bool unique = false;
  bool ifNotExists = false;
  IndexCol[] cols;
  Expr? where;
  string sql;
}

export struct Assign {
  string[] cols;     // one, or several for `(a, b) = (…)`
  Expr value;
}

export struct Upsert {
  string[] target;
  Expr? targetWhere;
  bool doNothing = false;
  Assign[] sets;
  Expr? where;
}

export static i32 OR_ABORT = 0;
export static i32 OR_IGNORE = 1;
export static i32 OR_REPLACE = 2;
export static i32 OR_FAIL = 3;
export static i32 OR_ROLLBACK = 4;

export struct Insert {
  string table = "";
  string[]? cols;
  i32 orAction = 0;
  Select? source;     // VALUES lists arrive as a Select with `values`
  bool defaultValues = false;
  Upsert[] upserts;
  ResultCol[]? returning;
}

export struct Update {
  string table;
  i32 orAction = 0;
  Assign[] sets;
  Expr? where;
  ResultCol[]? returning;
}

export struct Delete {
  string table;
  Expr? where;
  ResultCol[]? returning;
}

export enum Stmt {
  CreateTableStmt(CreateTable c),
  CreateIndexStmt(CreateIndex c),
  DropStmt(string kind, string name, bool ifExists),    // kind "TABLE" or "INDEX"
  InsertStmt(Insert i),
  SelectStmt(Select s),
  UpdateStmt(Update u),
  DeleteStmt(Delete d),
  AddColumnStmt(string table, ColumnDef col, string colSql),
  RenameTableStmt(string table, string to),
  BeginStmt,
  CommitStmt,
  RollbackStmt,
  PragmaStmt(string name, Expr? value),
}
