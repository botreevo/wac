// SQLite's b-trees, read and changed where they lie on a pager's pages.
//
// A table b-tree is keyed by rowid and keeps its rows in its leaves; an index b-tree is keyed by whole
// records and keeps entries in interior pages as well. Both are laid out exactly as SQLite lays them
// out (fileformat2.html §1.6), so a page this writes is one SQLite reads.
//
// **A changed page is written whole.** Its cells are read into a list, the list is changed, and the page
// is laid out again from the end down, with no free blocks. That costs a page's worth of copying per
// change, which a page read costs anyway, and it leaves one way for a page to look.
//
// **Balancing is simpler than SQLite's, and keeps what SQLite checks.** A page that overflows is split
// into as many pages as its cells need, evenly or, when the cell went on the end of the last page (rows
// appended in order), with the old pages left full. A page that a deletion empties is removed and its
// neighbour takes the parent's divider, so every leaf stays at one depth. Pages are not merged merely
// because they are thin: `PRAGMA integrity_check` asks for none of that, and VACUUM packs them.
//
// **Index keys are compared by the caller.** An index b-tree is given a comparison as a function of a
// stored record, so this file knows nothing of collations or of which columns sort descending.

import { Vec, Buf } from "core";
import { Pager } from "./pager.wac";
import { be16, be32, put16, put32, readVarint, Varint, pushVarint, varintLen, varintAt, varintSizeAt } from "./bytes.wac";
import { localSize } from "./reader.wac";

export static i32 INDEX_INTERIOR = 2;
export static i32 TABLE_INTERIOR = 5;
export static i32 INDEX_LEAF = 10;
export static i32 TABLE_LEAF = 13;

// How a stored record compares with what is sought: below zero when it comes first. The record is
// bytes [start, end) of the array, so one on a page is compared where it lies.
export type KeyCmp = fn<i32(u8[], i32, i32)>;
// A record's own comparison, for finding it again.
export type KeyCmpOf = fn<KeyCmp(u8[])>;

i32 hdrOf(i64 pgno) { return pgno == 1 ? 100 : 0; }
bool leafKind(i32 kind) { return kind == TABLE_LEAF || kind == INDEX_LEAF; }
bool tableKind(i32 kind) { return kind == TABLE_LEAF || kind == TABLE_INTERIOR; }
i32 ptrBase(i32 kind) { return leafKind(kind) ? 8 : 12; }

// ── cells ─────────────────────────────────────────────────────────────────

// The bytes of the cell at `off` on a page of `kind`, or -1 when they run off the page.
i32 cellSize(const u8[] page, i32 off, i32 kind, i32 usable) {
  if (off < 0 || off + 4 > page.len()) { return -1; }
  if (kind == TABLE_INTERIOR) { return 4 + readVarint(page, off + 4).size; }
  i32 at = off + (kind == INDEX_INTERIOR ? 4 : 0);
  if (at + 9 > page.len() && at >= page.len()) { return -1; }
  i64 size = varintAt(page, at);
  at += varintSizeAt(page, at);
  if (kind == TABLE_LEAF) { at += varintSizeAt(page, at); }
  if (size < 0) { return -1; }
  i32 local = localSize(usable, kind == TABLE_LEAF, size);
  at += local + ((local as i64) < size ? 4 : 0);
  if (at > page.len()) { return -1; }
  return at - off;
}

export i64 cellChild(const u8[] cell) { return be32(cell, 0); }

// The rowid a table cell carries: a leaf's row, or an interior cell's key.
export i64 cellRowid(const u8[] cell, i32 kind) {
  if (kind == TABLE_INTERIOR) { return readVarint(cell, 4).value; }
  Varint p = readVarint(cell, 0);
  return readVarint(cell, p.size).value;
}

// An index cell's leaf form: the interior form less its child pointer.
u8[] leafPart(const u8[] cell) {
  u8[] out = u8[].filled(cell.len() - 4, 0);
  out.copyFrom(cell, 4, 0, cell.len() - 4);
  return out;
}

u8[] withChild(i64 child, const u8[] leafCell) {
  u8[] out = u8[].filled(leafCell.len() + 4, 0);
  put32(out, 0, child);
  out.copyFrom(leafCell, 0, 4, leafCell.len());
  return out;
}

u8[] tableInteriorCell(i64 child, i64 key) {
  Buf b = Buf.create();
  b.pushAll(u8[].filled(4, 0));
  pushVarint(b, key);
  u8[] out = b.take();
  put32(out, 0, child);
  return out;
}

// Where a cell's payload starts, its size, and how much of it is on the page.
struct PayloadAt {
  i32 start;
  i64 size;
  i32 local;
}

PayloadAt payloadOf(const u8[] cell, i32 kind, i32 usable, i32 base) {
  i32 at = base + (kind == INDEX_INTERIOR ? 4 : 0);
  i64 size = varintAt(cell, at);
  at += varintSizeAt(cell, at);
  if (kind == TABLE_LEAF) { at += varintSizeAt(cell, at); }
  return PayloadAt(at, size, localSize(usable, kind == TABLE_LEAF, size));
}

// A cell's whole payload, its overflow pages followed.
export u8[] cellPayload(Pager pg, const u8[] cell, i32 kind) {
  PayloadAt pa = payloadOf(cell, kind, pg.pageSize, 0);
  if (pa.size < 0 || pa.size > 1000000000) { pg.failed("payload of \{pa.size} bytes"); return u8[](); }
  u8[] out = u8[].filled(pa.size as! i32, 0);
  out.copyFrom(cell, pa.start, 0, pa.local);
  if ((pa.local as i64) == pa.size) { return out; }
  i32 got = pa.local;
  i64 next = be32(cell, pa.start + pa.local);
  i32 per = pg.pageSize - 4;
  while (got < out.len()) {
    if (next < 2 || next > pg.count) { pg.failed("bad overflow chain"); return out; }
    u8[] ov = pg.page(next);
    i32 n = out.len() - got < per ? out.len() - got : per;
    out.copyFrom(ov, 4, got, n);
    got += n;
    next = be32(ov, 0);
  }
  return out;
}

// The local part of a payload, then the first overflow page when the rest did not fit; the overflow
// pages are allocated and written here.
void pushPayload(Pager pg, Buf out, const u8[] payload, bool table) {
  i32 local = localSize(pg.pageSize, table, payload.len() as i64);
  out.pushBytes(payload, 0, local);
  if (local == payload.len()) { return; }
  i32 per = pg.pageSize - 4;
  i32 count = (payload.len() - local + per - 1) / per;
  i64[] pages = i64[].filled(count, 0);
  for (i32 k = 0; k < count; k++) { pages[k] = pg.allocate(); }
  for (i32 k = 0; k < count; k++) {
    u8[] page = pg.write(pages[k]);
    put32(page, 0, k + 1 < count ? pages[k + 1] : 0);
    i32 start = local + k * per;
    i32 n = payload.len() - start < per ? payload.len() - start : per;
    page.copyFrom(payload, start, 4, n);
    for (i32 i = 4 + n; i < pg.pageSize; i++) { page[i] = 0; }
  }
  u8[] num = u8[].filled(4, 0);
  put32(num, 0, pages[0]);
  out.pushAll(num);
}

u8[] tableLeafCell(Pager pg, i64 rowid, const u8[] payload) {
  Buf b = Buf.create();
  pushVarint(b, payload.len() as i64);
  pushVarint(b, rowid);
  pushPayload(pg, b, payload, true);
  return b.take();
}

u8[] indexLeafCell(Pager pg, const u8[] payload) {
  Buf b = Buf.create();
  pushVarint(b, payload.len() as i64);
  pushPayload(pg, b, payload, false);
  return b.take();
}

// Gives a cell's overflow pages back to the freelist.
void freeOverflow(Pager pg, const u8[] cell, i32 kind) {
  if (kind == TABLE_INTERIOR) { return; }
  PayloadAt pa = payloadOf(cell, kind, pg.pageSize, 0);
  if ((pa.local as i64) >= pa.size) { return; }
  i64 next = be32(cell, pa.start + pa.local);
  i64 left = (pa.size - pa.local as i64 + (pg.pageSize - 5) as i64) / (pg.pageSize - 4) as i64;
  while (next >= 2 && next <= pg.count && left > 0) {
    i64 after = be32(pg.page(next), 0);
    pg.free(next);
    next = after;
    left--;
  }
}

// ── pages ─────────────────────────────────────────────────────────────────

// A page's cells, read off it to be changed and laid out again.
export struct Node {
  i64 pgno;
  i32 kind;
  Vec<u8[]> cells;
  i64 right;           // an interior page's last child
}

i32 kindAt(Pager pg, i64 pgno) {
  u8[] page = pg.page(pgno);
  return page[hdrOf(pgno)] as i32;
}

bool validKind(i32 k) { return k == 2 || k == 5 || k == 10 || k == 13; }

Node load(Pager pg, i64 pgno) {
  u8[] page = pg.page(pgno);
  i32 h = hdrOf(pgno);
  i32 kind = page[h] as i32;
  Vec<u8[]> cells;
  if (!validKind(kind)) {
    pg.failed("page \{pgno} is not a b-tree page");
    return Node(pgno, TABLE_LEAF, cells, 0);
  }
  i32 n = be16(page, h + 3);
  i32 pb = h + ptrBase(kind);
  if (pb + 2 * n > page.len()) { pg.failed("page \{pgno} has too many cells"); n = 0; }
  for (i32 i = 0; i < n; i++) {
    i32 off = be16(page, pb + 2 * i);
    i32 sz = cellSize(page, off, kind, pg.pageSize);
    if (sz < 0) { pg.failed("cell \{i} of page \{pgno} runs off the page"); break; }
    u8[] c = u8[].filled(sz, 0);
    c.copyFrom(page, off, 0, sz);
    cells.push(c);
  }
  return Node(pgno, kind, cells, leafKind(kind) ? 0 : be32(page, h + 8));
}

i32 used(Node nd) {
  i32 total = hdrOf(nd.pgno) + ptrBase(nd.kind);
  for (i32 i = 0; i < nd.cells.len(); i++) { total += nd.cells.get(i).len() + 2; }
  return total;
}

bool fits(Pager pg, Node nd) { return used(nd) <= pg.pageSize; }

// Lays a node out on its page: header, cell pointers, then the cells packed from the end down.
void store(Pager pg, Node nd) {
  u8[] p = pg.write(nd.pgno);
  i32 h = hdrOf(nd.pgno);
  for (i32 i = h; i < pg.pageSize; i++) { p[i] = 0; }
  i32 pb = h + ptrBase(nd.kind);
  i32 top = pg.pageSize;
  for (i32 i = 0; i < nd.cells.len(); i++) {
    u8[] c = nd.cells.get(i);
    top -= c.len();
    p.copyFrom(c, 0, top, c.len());
    put16(p, pb + 2 * i, top);
  }
  p[h] = nd.kind as@ u8;
  put16(p, h + 3, nd.cells.len());
  put16(p, h + 5, top == 65536 ? 0 : top);
  if (!leafKind(nd.kind)) { put32(p, h + 8, nd.right); }
}

// A new, empty b-tree: a table's when `table`, an index's otherwise. Answers its root.
export i64 createTree(Pager pg, bool table) {
  pg.version++;
  i64 root = pg.allocate();
  store(pg, Node(root, table ? TABLE_LEAF : INDEX_LEAF, Vec.create(), 0));
  return root;
}

// Gives every page of a b-tree back but its root, which is left an empty leaf.
export void clearTree(Pager pg, i64 root) {
  pg.version++;
  Node nd = load(pg, root);
  freeBelow(pg, nd, 0);
  store(pg, Node(root, tableKind(nd.kind) ? TABLE_LEAF : INDEX_LEAF, Vec.create(), 0));
}

// Gives every page of a b-tree back, its root too.
export void dropTree(Pager pg, i64 root) {
  pg.version++;
  Node nd = load(pg, root);
  freeBelow(pg, nd, 0);
  pg.free(root);
}

void freeBelow(Pager pg, Node nd, i32 depth) {
  if (depth > 40) { pg.failed("b-tree too deep"); return; }
  for (i32 i = 0; i < nd.cells.len(); i++) {
    freeOverflow(pg, nd.cells.get(i), nd.kind);
    if (!leafKind(nd.kind)) {
      i64 c = cellChild(nd.cells.get(i));
      if (c >= 2 && c <= pg.count) { freeBelow(pg, load(pg, c), depth + 1); pg.free(c); }
    }
  }
  if (!leafKind(nd.kind) && nd.right >= 2 && nd.right <= pg.count) {
    freeBelow(pg, load(pg, nd.right), depth + 1);
    pg.free(nd.right);
  }
}

// ── paths and balancing ─────────────────────────────────────────────────

// The pages from the root down to a node, and at each the child taken (or, at the last, the cell).
export struct Path {
  Vec<i64> pages;
  Vec<i32> slots;
  bool append = false;   // the position found is at the end of the last leaf
}

i64 childAt(const Node nd, i32 i) { return i < nd.cells.len() ? cellChild(nd.cells.get(i)) : nd.right; }

// Groups of consecutive items for pages of `cap` bytes, as [start, end) pairs. With `extract`, the item
// after each group but the last leaves it to sit in the parent between them. `pack` fills each page as
// full as it goes (for rows added at the end); otherwise the groups are made about even.
Vec<i32> groups(const i32[] sizes, i32 cap, bool extract, bool pack) {
  i32 n = sizes.len();
  i32 total = 0;
  for (i32 s in sizes) { total += s; }
  if (!pack) {
    for (i32 k = 2; k <= n; k++) {
      Vec<i32>? g = evenGroups(sizes, cap, extract, k, total / k);
      if (g is not null) { return g!; }
    }
  }
  return evenGroups(sizes, cap, extract, n, cap)!;
}

Vec<i32>? evenGroups(const i32[] sizes, i32 cap, bool extract, i32 k, i32 target) {
  i32 n = sizes.len();
  Vec<i32> out;
  i32 i = 0;
  for (i32 j = 0; j < k && i < n; j++) {
    i32 start = i;
    i32 used = 0;
    // The rest must fit one page to be the last group.
    i32 rest = 0;
    for (i32 q = i; q < n; q++) { rest += sizes[q]; }
    if (rest <= cap) {
      out.push(start);
      out.push(n);
      return out;
    }
    if (j == k - 1) { return null; }
    while (i < n && (i == start || (used + sizes[i] <= cap && used + sizes[i] / 2 <= target))) {
      used += sizes[i];
      i++;
    }
    if (used > cap) { return null; }
    if (extract) {
      // Only the divider would be left for the last page: the group gives up its last item to be it.
      if (i == n - 1 && i - 1 > start) { i--; }
      if (i >= n - 1) { return null; }
      out.push(start);
      out.push(i);
      i++;
    } else {
      if (i >= n) { return null; }
      out.push(start);
      out.push(i);
    }
  }
  return null;
}

// Writes a node, splitting it when it no longer fits its page. Answers whether it split.
bool put(Pager pg, Path path, i32 d, Node nd, bool pack) {
  if (fits(pg, nd)) { store(pg, nd); return false; }
  if (d == 0) {
    // The root keeps its number: what it held moves down into a new page, which then splits.
    i64 c = pg.allocate();
    Node child = Node(c, nd.kind, nd.cells, nd.right);
    Node root = Node(nd.pgno, tableKind(nd.kind) ? TABLE_INTERIOR : INDEX_INTERIOR, Vec.create(), c);
    Path p2 = Path(Vec.fromArray([nd.pgno]), Vec.fromArray([0]), false);
    splitInto(pg, p2, 1, child, root, 0, pack);
    return true;
  }
  Node parent = load(pg, path.pages.get(d - 1));
  splitInto(pg, path, d, nd, parent, path.slots.get(d - 1), pack);
  return true;
}

// Splits `nd`, child `slot` of `parent`, into pages that fit, and writes the parent with the dividers.
void splitInto(Pager pg, Path path, i32 d, Node nd, Node parent, i32 slot, bool pack) {
  i32 n = nd.cells.len();
  i32[] sizes = i32[].filled(n, 0);
  for (i32 i = 0; i < n; i++) { sizes[i] = nd.cells.get(i).len() + 2; }
  bool extract = nd.kind != TABLE_LEAF;
  Vec<i32> g = groups(sizes, pg.pageSize - ptrBase(nd.kind), extract, pack);
  i32 k = g.len() / 2;
  for (i32 j = 0; j < k; j++) {
    i32 a = g.get(2 * j);
    i32 b = g.get(2 * j + 1);
    bool last = j == k - 1;
    Vec<u8[]> cells;
    for (i32 i = a; i < b; i++) { cells.push(nd.cells.get(i)); }
    i64 pgno = last ? nd.pgno : pg.allocate();
    i64 right = 0;
    if (nd.kind == TABLE_INTERIOR || nd.kind == INDEX_INTERIOR) {
      right = last ? nd.right : cellChild(nd.cells.get(b));
    }
    store(pg, Node(pgno, nd.kind, cells, right));
    if (last) { break; }
    u8[] div = u8[]();
    if (nd.kind == TABLE_LEAF) { div = tableInteriorCell(pgno, cellRowid(nd.cells.get(b - 1), TABLE_LEAF)); }
    else if (nd.kind == TABLE_INTERIOR) { div = tableInteriorCell(pgno, cellRowid(nd.cells.get(b), TABLE_INTERIOR)); }
    else if (nd.kind == INDEX_LEAF) { div = withChild(pgno, nd.cells.get(b)); }
    else { div = withChild(pgno, leafPart(nd.cells.get(b))); }
    parent.cells.insert(slot + j, div);
  }
  put(pg, path, d - 1, parent, false);
}

// A node with no cells left: a leaf, or an interior page with only its last child. It goes, and a
// neighbour takes what the parent held between them, so the leaves all stay at one depth.
void removeEmpty(Pager pg, Path path, i32 d, Node nd) {
  if (d == 0) {
    if (leafKind(nd.kind)) { store(pg, nd); return; }
    // The root's one child comes up into it.
    Node child = load(pg, nd.right);
    pg.free(child.pgno);
    put(pg, Path(Vec.fromArray([nd.pgno]), Vec.fromArray([0]), false), 0, Node(nd.pgno, child.kind, child.cells, child.right), false);
    return;
  }
  Node parent = load(pg, path.pages.get(d - 1));
  i32 c = path.slots.get(d - 1);
  i32 n = parent.cells.len();
  if (n == 0) {
    // Cannot happen to a b-tree this wrote; a parent with no divider has nothing to give.
    pg.failed("page \{parent.pgno} has no cells");
    return;
  }
  pg.free(nd.pgno);
  if (nd.kind == TABLE_LEAF) {
    if (c < n) { parent.cells.remove(c); }
    else { parent.right = cellChild(parent.cells.get(n - 1)); parent.cells.remove(n - 1); }
    store(pg, parent);
    if (parent.cells.len() == 0) { removeEmpty(pg, path, d - 1, parent); }
    return;
  }
  Node sib = Node(0, 0, Vec.create(), 0);
  i32 sibSlot = 0;
  if (c < n) {
    u8[] div = parent.cells.get(c);
    sib = load(pg, childAt(parent, c + 1));
    if (nd.kind == INDEX_LEAF) { sib.cells.insert(0, leafPart(div)); }
    else if (nd.kind == TABLE_INTERIOR) { sib.cells.insert(0, tableInteriorCell(nd.right, cellRowid(div, TABLE_INTERIOR))); }
    else { sib.cells.insert(0, withChild(nd.right, leafPart(div))); }
    parent.cells.remove(c);
    sibSlot = c;
  } else {
    u8[] div = parent.cells.get(n - 1);
    sib = load(pg, cellChild(div));
    if (nd.kind == INDEX_LEAF) { sib.cells.push(leafPart(div)); }
    else if (nd.kind == TABLE_INTERIOR) {
      sib.cells.push(tableInteriorCell(sib.right, cellRowid(div, TABLE_INTERIOR)));
      sib.right = nd.right;
    } else {
      sib.cells.push(withChild(sib.right, leafPart(div)));
      sib.right = nd.right;
    }
    parent.cells.remove(n - 1);
    parent.right = sib.pgno;
    sibSlot = n - 1;
  }
  store(pg, parent);
  Path p2 = Path(Vec.create(), Vec.create(), false);
  for (i32 i = 0; i < d; i++) { p2.pages.push(path.pages.get(i)); p2.slots.push(path.slots.get(i)); }
  p2.slots.set(d - 1, sibSlot);
  p2.pages.push(sib.pgno);
  p2.slots.push(0);
  bool split = put(pg, p2, d, sib, false);
  if (!split && parent.cells.len() == 0) { removeEmpty(pg, path, d - 1, parent); }
}

// Takes cell `i` off a page without laying it out again: its pointer goes, and its bytes become free
// space as SQLite's freeSpace() frees them — joined to a free block or to the free area they touch, so
// no two free blocks are less than four bytes apart, which SQLite's checks require. Answers false (and
// changes nothing) when the page has no other cell, which the caller handles by removing the page.
bool removeInPlace(Pager pg, i64 pgno, i32 i) {
  u8[] page = pg.page(pgno);
  i32 h = hdrOf(pgno);
  i32 kind = page[h] as i32;
  i32 n = be16(page, h + 3);
  if (n <= 1 || i >= n) { return false; }
  i32 pb = h + ptrBase(kind);
  i32 off = be16(page, pb + 2 * i);
  i32 size = cellSize(page, off, kind, pg.pageSize);
  if (size < 4) { return false; }
  // Where the free blocks around it are, checked before anything changes.
  i32 iStart = off;
  i32 iEnd = off + size;
  i32 iPtr = h + 1;
  i32 iFree = be16(page, iPtr);
  while (iFree != 0 && iFree < iStart) {
    if (iFree <= iPtr || iFree > pg.pageSize - 4) { return false; }
    iPtr = iFree;
    iFree = be16(page, iFree);
  }
  i32 nFrag = 0;
  if (iFree != 0 && iEnd + 3 >= iFree) {
    if (iEnd > iFree) { return false; }
    nFrag = iFree - iEnd;
    iEnd = iFree + be16(page, iFree + 2);
    iFree = be16(page, iFree);
  }
  if (iPtr > h + 1) {
    i32 ptrEnd = iPtr + be16(page, iPtr + 2);
    if (ptrEnd + 3 >= iStart) {
      if (ptrEnd > iStart) { return false; }
      nFrag += iStart - ptrEnd;
      iStart = iPtr;
    }
  }
  if (nFrag > (page[h + 7] as i32)) { return false; }
  i32 top = be16(page, h + 5);
  if (top == 0) { top = 65536; }
  if (iStart < top || (iStart == top && iPtr != h + 1)) { return false; }
  u8[] p = pg.write(pgno);
  for (i32 k = pb + 2 * i; k < pb + 2 * (n - 1); k++) { p[k] = p[k + 2]; }
  p[pb + 2 * (n - 1)] = 0;
  p[pb + 2 * (n - 1) + 1] = 0;
  put16(p, h + 3, n - 1);
  p[h + 7] = ((p[h + 7] as i32) - nFrag) as@ u8;
  if (iStart == top) {
    // At the start of the cell content: the free area grows instead.
    put16(p, h + 1, iFree);
    put16(p, h + 5, iEnd);
  } else {
    put16(p, iPtr, iStart);
    put16(p, iStart, iFree);
    put16(p, iStart + 2, iEnd - iStart);
  }
  return true;
}

// Takes the cell at the end of `path` off its leaf, and gives back its overflow when `drop`.
void leafRemove(Pager pg, Path path, bool drop) {
  i32 d = path.pages.len() - 1;
  i64 pgno = path.pages.get(d);
  i32 i = path.slots.get(d);
  if (drop) {
    u8[] page = pg.page(pgno);
    i32 h = hdrOf(pgno);
    i32 kind = page[h] as i32;
    i32 off = cellOff(page, h, kind, i);
    i32 sz = cellSize(page, off, kind, pg.pageSize);
    if (sz > 0) {
      u8[] c = u8[].filled(sz, 0);
      c.copyFrom(page, off, 0, sz);
      freeOverflow(pg, c, kind);
    }
  }
  if (removeInPlace(pg, pgno, i)) { return; }
  Node leaf = load(pg, pgno);
  leaf.cells.remove(i);
  if (leaf.cells.len() > 0 || d == 0) { store(pg, leaf); } else { removeEmpty(pg, path, d, leaf); }
}

// ── tables ────────────────────────────────────────────────────────────────

// The page bytes of cell `i` start here.
i32 cellOff(const u8[] page, i32 h, i32 kind, i32 i) { return be16(page, h + ptrBase(kind) + 2 * i); }

// A table cell's key, read off the page where it lies.
i64 rowidAt(const u8[] page, i32 off, i32 kind) {
  if (kind == TABLE_INTERIOR) { return varintAt(page, off + 4); }
  return varintAt(page, off + varintSizeAt(page, off));
}

// The leaf where `rowid` is or would go, and its position there. `path.append` says whether that
// position is the end of the last leaf.
Path findLeaf(Pager pg, i64 root, i64 rowid) {
  Path path = Path(Vec.create(), Vec.create(), false);
  i64 p = root;
  bool last = true;
  for (i32 depth = 0; depth < 40; depth++) {
    u8[] page = pg.page(p);
    i32 h = hdrOf(p);
    i32 kind = page[h] as i32;
    if (!validKind(kind)) { pg.failed("page \{p} is not a b-tree page"); path.pages.push(p); path.slots.push(0); return path; }
    i32 n = be16(page, h + 3);
    i32 lo = 0;
    i32 hi = n;
    while (lo < hi) {
      i32 mid = (lo + hi) / 2;
      if (rowidAt(page, cellOff(page, h, kind, mid), kind) < rowid) { lo = mid + 1; } else { hi = mid; }
    }
    path.pages.push(p);
    path.slots.push(lo);
    if (leafKind(kind)) {
      path.append = last && lo == n;
      return path;
    }
    if (lo < n) { last = false; }
    p = lo < n ? be32(page, cellOff(page, h, kind, lo)) : be32(page, h + 8);
    if (p < 1 || p > pg.count) { pg.failed("child page \{p} out of range"); return path; }
  }
  pg.failed("b-tree too deep");
  return path;
}

// Puts a cell at position `i` of a leaf without laying the page out again, when the space between its
// pointers and its cells holds it. Answers whether it did.
bool insertInPlace(Pager pg, i64 pgno, i32 i, const u8[] cell) {
  u8[] page = pg.page(pgno);
  i32 h = hdrOf(pgno);
  i32 kind = page[h] as i32;
  i32 n = be16(page, h + 3);
  i32 pb = h + ptrBase(kind);
  i32 top = be16(page, h + 5);
  if (top == 0) { top = 65536; }
  if (top - (pb + 2 * n) < cell.len() + 2 || i > n) { return false; }
  u8[] p = pg.write(pgno);
  i32 at = top - cell.len();
  p.copyFrom(cell, 0, at, cell.len());
  // The pointers from i on move up one.
  for (i32 k = pb + 2 * n - 1; k >= pb + 2 * i; k--) { p[k + 2] = p[k]; }
  put16(p, pb + 2 * i, at);
  put16(p, h + 3, n + 1);
  put16(p, h + 5, at);
  return true;
}

// Puts a row in a table b-tree, in place of the one with its rowid if there is one.
export void tableInsert(Pager pg, i64 root, i64 rowid, const u8[] payload) {
  pg.version++;
  Path path = findLeaf(pg, root, rowid);
  i32 d = path.pages.len() - 1;
  i64 leafNo = path.pages.get(d);
  i32 i = path.slots.get(d);
  u8[] page = pg.page(leafNo);
  i32 h = hdrOf(leafNo);
  bool replacing = i < be16(page, h + 3) && rowidAt(page, cellOff(page, h, TABLE_LEAF, i), TABLE_LEAF) == rowid;
  u8[] cell = tableLeafCell(pg, rowid, payload);
  if (!replacing && insertInPlace(pg, leafNo, i, cell)) { return; }
  if (replacing) {
    // The old cell out and the new one in, on the page as it is, when there is room.
    i32 off = cellOff(page, h, TABLE_LEAF, i);
    i32 sz = cellSize(page, off, TABLE_LEAF, pg.pageSize);
    if (sz > 0) {
      u8[] old = u8[].filled(sz, 0);
      old.copyFrom(page, off, 0, sz);
      if (removeInPlace(pg, leafNo, i)) {
        freeOverflow(pg, old, TABLE_LEAF);
        if (insertInPlace(pg, leafNo, i, cell)) { return; }
        Node leaf2 = load(pg, leafNo);
        leaf2.cells.insert(i, cell);
        put(pg, path, d, leaf2, false);
        return;
      }
    }
  }
  Node leaf = load(pg, leafNo);
  if (replacing) {
    freeOverflow(pg, leaf.cells.get(i), TABLE_LEAF);
    leaf.cells.set(i, cell);
  } else {
    leaf.cells.insert(i, cell);
  }
  put(pg, path, d, leaf, path.append && !replacing);
}

// Removes the row with a rowid from a table b-tree. Answers whether there was one.
export bool tableDelete(Pager pg, i64 root, i64 rowid) {
  Path path = findLeaf(pg, root, rowid);
  i32 d = path.pages.len() - 1;
  Node leaf = load(pg, path.pages.get(d));
  i32 i = path.slots.get(d);
  if (i >= leaf.cells.len() || cellRowid(leaf.cells.get(i), TABLE_LEAF) != rowid) { return false; }
  pg.version++;
  leafRemove(pg, path, true);
  return true;
}

// ── indexes ───────────────────────────────────────────────────────────────

// The leaf where a record would go, by its comparison, and its position there; `found` when a record
// equal to it is already in the tree (in that leaf or above it).
struct IndexSpot {
  Path path;
  bool found;
}

IndexSpot findIndexLeaf(Pager pg, i64 root, KeyCmp cmp) {
  Path path = Path(Vec.create(), Vec.create(), false);
  i64 p = root;
  bool last = true;
  bool found = false;
  for (i32 depth = 0; depth < 40; depth++) {
    u8[] page = pg.page(p);
    i32 h = hdrOf(p);
    i32 kind = page[h] as i32;
    if (!validKind(kind)) { pg.failed("page \{p} is not a b-tree page"); path.pages.push(p); path.slots.push(0); return IndexSpot(path, false); }
    i32 n = be16(page, h + 3);
    i32 lo = 0;
    i32 hi = n;
    while (lo < hi) {
      i32 mid = (lo + hi) / 2;
      i32 c = cmpAt(pg, page, cellOff(page, h, kind, mid), kind, cmp);
      if (c == 0) { found = true; }
      if (c < 0) { lo = mid + 1; } else { hi = mid; }
    }
    path.pages.push(p);
    path.slots.push(lo);
    if (leafKind(kind)) {
      path.append = last && lo == n;
      return IndexSpot(path, found);
    }
    if (lo < n) { last = false; }
    p = lo < n ? be32(page, cellOff(page, h, kind, lo)) : be32(page, h + 8);
    if (p < 1 || p > pg.count) { pg.failed("child page \{p} out of range"); return IndexSpot(path, found); }
  }
  pg.failed("b-tree too deep");
  return IndexSpot(path, found);
}

export i32 whole(KeyCmp cmp, u8[] rec) { return cmp(rec, 0, rec.len()); }

// A comparison of the payload of the cell at `off` on a page: where it lies when it is all there, or
// gathered from its overflow pages.
i32 cmpAt(Pager pg, u8[] page, i32 off, i32 kind, KeyCmp cmp) {
  PayloadAt pa = payloadOf(page, kind, pg.pageSize, off);
  if ((pa.local as i64) == pa.size && pa.start + pa.local <= page.len()) { return cmp(page, pa.start, pa.start + pa.local); }
  u8[] full = payloadAt(pg, page, off, kind);
  return cmp(full, 0, full.len());
}

bool holdsAt(Pager pg, u8[] page, i32 off, i32 kind, fn<bool(u8[], i32, i32)> f) {
  PayloadAt pa = payloadOf(page, kind, pg.pageSize, off);
  if ((pa.local as i64) == pa.size && pa.start + pa.local <= page.len()) { return f(page, pa.start, pa.start + pa.local); }
  u8[] full = payloadAt(pg, page, off, kind);
  return f(full, 0, full.len());
}

// The payload of the cell at `off` on a page, its overflow followed.
u8[] payloadAt(Pager pg, const u8[] page, i32 off, i32 kind) {
  i32 sz = cellSize(page, off, kind, pg.pageSize);
  if (sz < 0) { pg.failed("a cell runs off its page"); return u8[](); }
  PayloadAt pa = payloadOf(page, kind, pg.pageSize, off);
  if ((pa.local as i64) == pa.size) {
    u8[] out = u8[].filled(pa.local, 0);
    out.copyFrom(page, pa.start, 0, pa.local);
    return out;
  }
  u8[] c = u8[].filled(sz, 0);
  c.copyFrom(page, off, 0, sz);
  return cellPayload(pg, c, kind);
}

// Adds a record to an index b-tree; `cmp` is its own comparison. A record already there is left.
export void indexInsert(Pager pg, i64 root, const u8[] rec, KeyCmp cmp) {
  pg.version++;
  IndexSpot spot = findIndexLeaf(pg, root, cmp);
  if (spot.found) { return; }
  Path path = spot.path;
  i32 d = path.pages.len() - 1;
  u8[] cell = indexLeafCell(pg, rec);
  if (insertInPlace(pg, path.pages.get(d), path.slots.get(d), cell)) { return; }
  Node leaf = load(pg, path.pages.get(d));
  leaf.cells.insert(path.slots.get(d), cell);
  put(pg, path, d, leaf, path.append);
}

// Removes the record that compares equal under `cmp`. An entry on an interior page is replaced by the
// one before it, which comes up from its leaf. Answers whether there was one.
export bool indexDelete(Pager pg, i64 root, KeyCmp cmp, KeyCmpOf cmpOf) {
  Cursor c = Cursor.over(pg, root, false);
  if (!c.seek((u8[] s, i32 a, i32 b) => cmp(s, a, b) >= 0) || whole(cmp, c.payload) != 0) { return false; }
  pg.version++;
  Path path = c.path();
  i32 d = path.pages.len() - 1;
  Node at = load(pg, path.pages.get(d));
  if (leafKind(at.kind)) {
    leafRemove(pg, path, true);
    return true;
  }
  // The entry before it: the last of the rightmost leaf under the child to its left.
  i32 ci = path.slots.get(d);
  i64 p = cellChild(at.cells.get(ci));
  for (i32 depth = 0; depth < 40; depth++) {
    Node nd = load(pg, p);
    path.pages.push(p);
    if (leafKind(nd.kind)) {
      path.slots.push(nd.cells.len() - 1);
      break;
    }
    path.slots.push(nd.cells.len());
    p = nd.right;
  }
  i32 ld = path.pages.len() - 1;
  if (path.slots.get(ld) < 0) { pg.failed("an index leaf with no cells"); return false; }
  u8[] pred = load(pg, path.pages.get(ld)).cells.get(path.slots.get(ld));
  leafRemove(pg, path, false);
  // Taking it off may have moved things about: the entry is found again.
  Cursor again = Cursor.over(pg, root, false);
  if (!again.seek((u8[] s, i32 a, i32 b) => cmp(s, a, b) >= 0) || whole(cmp, again.payload) != 0) { pg.failed("index entry lost"); return false; }
  Path p2 = again.path();
  i32 d2 = p2.pages.len() - 1;
  Node nd2 = load(pg, p2.pages.get(d2));
  i32 i2 = p2.slots.get(d2);
  if (leafKind(nd2.kind)) {
    leafRemove(pg, p2, true);
    u8[] predRec = cellPayload(pg, pred, INDEX_LEAF);
    KeyCmp pc = cmpOf(predRec);
    Path p3 = findIndexLeaf(pg, root, pc).path;
    i32 d3 = p3.pages.len() - 1;
    Node leaf = load(pg, p3.pages.get(d3));
    leaf.cells.insert(p3.slots.get(d3), pred);
    put(pg, p3, d3, leaf, false);
    return true;
  }
  freeOverflow(pg, nd2.cells.get(i2), nd2.kind);
  nd2.cells.set(i2, withChild(cellChild(nd2.cells.get(i2)), pred));
  put(pg, p2, d2, nd2, false);
  return true;
}

// Every entry of a b-tree: a table's rows, or an index's records.
export i64 countEntries(Pager pg, i64 root) { return countBelow(pg, root, 0); }

i64 countBelow(Pager pg, i64 p, i32 depth) {
  if (depth > 40 || p < 1 || p > pg.count) { pg.failed("bad page \{p}"); return 0; }
  u8[] page = pg.page(p);
  i32 h = hdrOf(p);
  i32 kind = page[h] as i32;
  if (!validKind(kind)) { pg.failed("page \{p} is not a b-tree page"); return 0; }
  i64 n = be16(page, h + 3) as i64;
  if (leafKind(kind)) { return n; }
  i64 total = kind == INDEX_INTERIOR ? n : 0;
  i32 pb = h + 12;
  for (i32 i = 0; i < n as! i32; i++) {
    i32 off = be16(page, pb + 2 * i);
    if (off + 4 > page.len()) { pg.failed("cell off page \{p}"); return total; }
    total += countBelow(pg, be32(page, off), depth + 1);
  }
  return total + countBelow(pg, be32(page, h + 8), depth + 1);
}

// ── cursors ───────────────────────────────────────────────────────────────

// A place in a b-tree, moved forwards and backwards in key order. It keeps its entry's rowid and
// payload, so changes to the tree while it is out leave what it holds alone; on its next move it finds
// its place again by that key.
export struct Cursor {
  Pager pg;
  i64 root;
  bool table;
  Vec<i64> pages;
  Vec<i32> slots;
  bool valid = false;
  i64 seen = -1;           // the pager's version when it was placed
  i64 rowid = 0;
  u8[] payload;
  KeyCmpOf? cmpOf = null;  // an index cursor's way of finding its place again
  // A table cursor that reads its row's payload only when `body()` asks for it: one whose rows are
  // mostly found already decoded (Table's cache) copies nothing for them.
  bool lazy = false;
  bool loaded = true;
  u8[] top;                // the page at the top of the path, while it is good (see topPage)
  i64 topNo = 0;
  i64 topSeen = -1;
  i32 topCached = -1;

  Cursor over(Pager pg, i64 root, bool table) {
    return Cursor { pg: pg, root: root, table: table, pages: Vec.create(), slots: Vec.create(), payload: u8[](), top: u8[]() };
  }

  Path path(const this) {
    Path p = Path(Vec.create(), Vec.create(), false);
    for (i32 i = 0; i < this.pages.len(); i++) { p.pages.push(this.pages.get(i)); p.slots.push(this.slots.get(i)); }
    return p;
  }

  void reset(this) {
    this.pages.clear();
    this.slots.clear();
    this.valid = false;
    this.seen = this.pg.version;
  }

  // The page at the top, its kind, and its cell count.
  // The page at the top of the path, kept while nothing changes so stepping along a leaf reads it once.
  u8[] topPage(this) {
    i64 p = this.pages.get(this.pages.len() - 1);
    if (p != this.topNo || this.topSeen != this.pg.version || this.pg.cache.len() != this.topCached) {
      this.top = this.pg.page(p);
      this.topNo = p;
      this.topSeen = this.pg.version;
      this.topCached = this.pg.cache.len();
    }
    return this.top;
  }

  i32 topCount(this) {
    u8[] page = this.topPage();
    return be16(page, hdrOf(this.topNo) + 3);
  }

  i32 topKind(this) {
    u8[] page = this.topPage();
    return page[hdrOf(this.topNo)] as i32;
  }

  i64 topNumber(this) { return this.pages.get(this.pages.len() - 1); }

  i32 topSlot(this) { return this.slots.get(this.slots.len() - 1); }

  u8[] cellAt(this, i64 p, i32 i) {
    u8[] page = this.pg.page(p);
    i32 h = hdrOf(p);
    i32 kind = page[h] as i32;
    i32 off = be16(page, h + ptrBase(kind) + 2 * i);
    i32 sz = cellSize(page, off, kind, this.pg.pageSize);
    if (sz < 0) { this.pg.failed("cell \{i} of page \{p} runs off the page"); return u8[].filled(16, 0); }
    u8[] c = u8[].filled(sz, 0);
    c.copyFrom(page, off, 0, sz);
    return c;
  }

  i64 childOf(this, i64 p, i32 i) {
    u8[] page = this.pg.page(p);
    i32 h = hdrOf(p);
    i32 n = be16(page, h + 3);
    if (i >= n) { return be32(page, h + 8); }
    return be32(page, be16(page, h + 12 + 2 * i));
  }

  bool okPage(this, i64 p) {
    if (p < 1 || p > this.pg.count || this.pages.len() > 40) {
      this.pg.failed("bad child page \{p}");
      this.valid = false;
      return false;
    }
    if (!validKind(this.pg.page(p)[hdrOf(p)] as i32)) {
      this.pg.failed("page \{p} is not a b-tree page");
      this.valid = false;
      return false;
    }
    return true;
  }

  // Keeps the entry at the top.
  bool hold(this) {
    i64 p = this.topNumber();
    i32 i = this.topSlot();
    if (this.lazy) {
      u8[] page = this.topPage();
      i32 h = hdrOf(p);
      this.rowid = rowidAt(page, cellOff(page, h, TABLE_LEAF, i), TABLE_LEAF);
      this.loaded = false;
      this.valid = true;
      this.seen = this.pg.version;
      return true;
    }
    u8[] cell = this.cellAt(p, i);
    i32 kind = this.topKind();
    if (kind == TABLE_LEAF) { this.rowid = cellRowid(cell, kind); }
    this.payload = cellPayload(this.pg, cell, kind);
    this.valid = true;
    this.seen = this.pg.version;
    return true;
  }

  bool downLeft(this, i64 start) {
    i64 p = start;
    while (true) {
      if (!this.okPage(p)) { return false; }
      this.pages.push(p);
      this.slots.push(0);
      i32 kind = this.topKind();
      if (leafKind(kind)) {
        if (this.topCount() == 0) { return this.climbNext(); }
        return this.hold();
      }
      p = this.childOf(p, 0);
    }
    return false;
  }

  bool downRight(this, i64 start) {
    i64 p = start;
    while (true) {
      if (!this.okPage(p)) { return false; }
      i32 n = be16(this.pg.page(p), hdrOf(p) + 3);
      this.pages.push(p);
      this.slots.push(n);
      if (leafKind(this.topKind())) {
        if (n == 0) { return this.climbPrev(); }
        this.slots.set(this.slots.len() - 1, n - 1);
        return this.hold();
      }
      p = this.childOf(p, n);
    }
    return false;
  }

  // From the end of a leaf to the next entry above it.
  bool climbNext(this) {
    this.pages.pop();
    this.slots.pop();
    while (this.pages.len() > 0) {
      i32 c = this.slots.last()!;
      i32 n = this.topCount();
      if (c < n) {
        if (this.table) {
          this.slots.set(this.slots.len() - 1, c + 1);
          return this.downLeft(this.childOf(this.pages.last()!, c + 1));
        }
        return this.hold();
      }
      this.pages.pop();
      this.slots.pop();
    }
    this.valid = false;
    return false;
  }

  bool climbPrev(this) {
    this.pages.pop();
    this.slots.pop();
    while (this.pages.len() > 0) {
      i32 c = this.slots.last()!;
      if (c > 0) {
        this.slots.set(this.slots.len() - 1, c - 1);
        if (this.table) { return this.downRight(this.childOf(this.pages.last()!, c - 1)); }
        return this.hold();
      }
      this.pages.pop();
      this.slots.pop();
    }
    this.valid = false;
    return false;
  }

  // The entry's payload; a lazy cursor reads it now, finding its place again first if the tree changed.
  u8[] body(this) {
    if (!this.loaded) {
      if (this.seen != this.pg.version) { this.refind(); }
      if (this.valid) {
        u8[] cell = this.cellAt(this.pages.last()!, this.slots.last()!);
        this.payload = cellPayload(this.pg, cell, TABLE_LEAF);
      }
      this.loaded = true;
    }
    return this.payload;
  }

  bool first(this) {
    this.reset();
    return this.downLeft(this.root);
  }

  bool last(this) {
    this.reset();
    return this.downRight(this.root);
  }

  // The first row whose rowid is `rowid` or more.
  bool seekRowid(this, i64 rowid) {
    this.reset();
    i64 p = this.root;
    while (true) {
      if (!this.okPage(p)) { return false; }
      u8[] page = this.pg.page(p);
      i32 h = hdrOf(p);
      i32 kind = page[h] as i32;
      i32 n = be16(page, h + 3);
      i32 lo = 0;
      i32 hi = n;
      while (lo < hi) {
        i32 mid = (lo + hi) / 2;
        if (rowidAt(page, cellOff(page, h, kind, mid), kind) < rowid) { lo = mid + 1; } else { hi = mid; }
      }
      this.pages.push(p);
      this.slots.push(lo);
      if (leafKind(kind)) {
        if (lo < n) { return this.hold(); }
        return this.climbNext();
      }
      p = this.childOf(p, lo);
    }
    return false;
  }

  // The first entry `after` holds for: it must hold for every entry from some point on.
  bool seek(this, fn<bool(u8[], i32, i32)> after) {
    this.reset();
    i64 p = this.root;
    while (true) {
      if (!this.okPage(p)) { return false; }
      u8[] page = this.pg.page(p);
      i32 h = hdrOf(p);
      i32 kind = page[h] as i32;
      i32 n = be16(page, h + 3);
      i32 lo = 0;
      i32 hi = n;
      while (lo < hi) {
        i32 mid = (lo + hi) / 2;
        if (!holdsAt(this.pg, page, cellOff(page, h, kind, mid), kind, after)) { lo = mid + 1; } else { hi = mid; }
      }
      this.pages.push(p);
      this.slots.push(lo);
      if (leafKind(kind)) {
        if (lo < n) { return this.hold(); }
        return this.climbNext();
      }
      p = this.childOf(p, lo);
    }
    return false;
  }

  // Finds its place again after the tree changed: on its own entry (answering true), or on the first
  // after it when that has gone (answering false).
  bool refind(this) {
    if (this.table) {
      i64 want = this.rowid;
      return this.seekRowid(want) && this.rowid == want;
    }
    KeyCmp cmp = this.cmpOf!(this.payload);
    u8[] mine = this.payload;
    return this.seek((u8[] s, i32 a, i32 b) => cmp(s, a, b) >= 0) && whole(cmp, mine) == 0;
  }

  bool stale(const this) { return this.seen != this.pg.version && (this.table || this.cmpOf is not null); }

  bool next(this) {
    if (!this.valid) { return false; }
    if (this.stale()) {
      if (!this.refind()) { return this.valid; }
    }
    i32 n = this.topCount();
    i32 i = this.topSlot();
    if (!leafKind(this.topKind())) {
      // On an index entry in an interior page: next is the first entry of the child after it.
      this.slots.set(this.slots.len() - 1, i + 1);
      return this.downLeft(this.childOf(this.pages.last()!, i + 1));
    }
    if (i + 1 < n) {
      this.slots.set(this.slots.len() - 1, i + 1);
      return this.hold();
    }
    return this.climbNext();
  }

  bool prev(this) {
    if (!this.valid) { return false; }
    if (this.stale()) {
      this.refind();
      if (!this.valid) { return this.last(); }
    }
    i32 i = this.slots.last()!;
    if (!leafKind(this.topKind())) {
      return this.downRight(this.childOf(this.pages.last()!, i));
    }
    if (i > 0) {
      this.slots.set(this.slots.len() - 1, i - 1);
      return this.hold();
    }
    return this.climbPrev();
  }
}

// A pager with nothing in it gets page 1: the file header's 100 bytes, left for the caller, and below
// them sqlite_schema's root, an empty table leaf.
export void startDatabase(Pager pg) {
  pg.count = 1;
  pg.cache.set(1, u8[].filled(pg.pageSize, 0));
  pg.dirty.set(1, true);
  store(pg, Node(1, TABLE_LEAF, Vec.create(), 0));
}
