// Big-endian integers and SQLite's varint, over byte arrays. Everything in the file format is big-endian.

import { Buf } from "core";

export i32 u8At(const u8[] b, i32 off) { return b[off] as i32; }

export i32 be16(const u8[] b, i32 off) { return ((b[off] as i32) << 8) | (b[off + 1] as i32); }

export i32 be24(const u8[] b, i32 off) {
  return ((b[off] as i32) << 16) | ((b[off + 1] as i32) << 8) | (b[off + 2] as i32);
}

// A 32-bit field read as unsigned, which every 32-bit field in the format is: page numbers, counts.
export i64 be32(const u8[] b, i32 off) {
  i64 hi = (b[off] as i64) << 24;
  return hi | ((b[off + 1] as i64) << 16) | ((b[off + 2] as i64) << 8) | (b[off + 3] as i64);
}

// `n` bytes as a big-endian two's complement integer, which is how records store 1..8 byte integers.
export i64 beSigned(const u8[] b, i32 off, i32 n) {
  i64 v = 0;
  for (i32 i = 0; i < n; i++) { v = (v << 8) | (b[off + i] as i64); }
  i32 shift = 64 - 8 * n;
  if (shift == 0) { return v; }
  return (v << shift) >> shift;
}

export void put16(u8[] b, i32 off, i32 v) {
  b[off] = (v >> 8) as@ u8;
  b[off + 1] = v as@ u8;
}

export void put32(u8[] b, i32 off, i64 v) {
  b[off] = (v >> 24) as@ u8;
  b[off + 1] = (v >> 16) as@ u8;
  b[off + 2] = (v >> 8) as@ u8;
  b[off + 3] = v as@ u8;
}

// A varint and how many bytes it took. Up to eight bytes carry seven bits each with the high bit as a
// continuation flag; a ninth byte, when reached, contributes all eight.
export struct Varint {
  i64 value;
  i32 size;
}

export Varint readVarint(const u8[] b, i32 off) {
  i64 v = 0;
  for (i32 i = 0; i < 8; i++) {
    i32 c = b[off + i] as i32;
    v = (v << 7) | ((c & 0x7f) as i64);
    if ((c & 0x80) == 0) { return Varint(v, i + 1); }
  }
  v = (v << 8) | (b[off + 8] as i64);
  return Varint(v, 9);
}

export i32 varintLen(i64 v) {
  u64 u = v as@ u64;
  if ((u >> 56) != 0) { return 9; }
  i32 n = 1;
  while ((u >> 7) != 0) { u = u >> 7; n++; }
  return n;
}

export void pushVarint(Buf out, i64 v) {
  u64 u = v as@ u64;
  if ((u >> 56) != 0) {
    // Nine bytes: the last holds eight bits, the first eight hold seven each.
    u8[] tmp = u8[].filled(9, 0);
    tmp[8] = u as@ u8;
    u = u >> 8;
    for (i32 i = 7; i >= 0; i--) {
      tmp[i] = ((u & 0x7f) as@ u8) | 0x80;
      u = u >> 7;
    }
    out.pushAll(tmp);
    return;
  }
  i32 n = varintLen(v);
  for (i32 i = n - 1; i >= 0; i--) {
    u8 c = ((u >> (7 * i)) & 0x7f) as@ u8;
    if (i > 0) { c = c | 0x80; }
    out.push(c);
  }
}

export void pushBe(Buf out, i64 v, i32 n) {
  for (i32 i = n - 1; i >= 0; i--) { out.push((v >> (8 * i)) as@ u8); }
}

// A fresh copy of `b[start, end)`.
export u8[] sliceBytes(const u8[] b, i32 start, i32 end) {
  u8[] out = u8[].filled(end - start, 0);
  out.copyFrom(b, start, 0, end - start);
  return out;
}
