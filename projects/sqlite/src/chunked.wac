// A list kept in blocks, so inserting or removing in the middle shifts one block rather than the whole
// list. An index's entries live here: inserts land all over the key order, and a flat array would move
// half of itself each time.

import { Vec } from "core";

static i32 BLOCK = 512;

export struct Chunked<T> {
  Vec<Vec<T>> blocks;
  i32 n = 0;
  i32[] starts;        // starts[b] is the position of blocks[b]'s first element; rebuilt when stale
  bool stale = true;

  Chunked<T> create() { return Chunked<T> { blocks: Vec.create(), starts: i32[]() }; }

  Chunked<T> fromArray(T[] xs) {
    Chunked<T> c = Chunked<T> { blocks: Vec.create(), starts: i32[]() };
    for (i32 at = 0; at < xs.len(); at += BLOCK) {
      i32 end = at + BLOCK < xs.len() ? at + BLOCK : xs.len();
      Vec<T> b = Vec.withCapacity(BLOCK * 2);
      for (i32 i = at; i < end; i++) { b.push(xs[i]); }
      c.blocks.push(b);
    }
    c.n = xs.len();
    return c;
  }

  i32 len(const this) { return this.n; }

  void fix(this) {
    if (!this.stale) { return; }
    if (this.starts.len() != this.blocks.len()) { this.starts = i32[].filled(this.blocks.len(), 0); }
    i32 at = 0;
    for (i32 b = 0; b < this.blocks.len(); b++) {
      this.starts[b] = at;
      at += this.blocks.get(b).len();
    }
    this.stale = false;
  }

  // The block holding position i (i == n gives the last block, for appending).
  i32 blockOf(this, i32 i) {
    this.fix();
    i32 lo = 0;
    i32 hi = this.blocks.len() - 1;
    while (lo < hi) {
      i32 mid = (lo + hi + 1) / 2;
      if (this.starts[mid] <= i) { lo = mid; } else { hi = mid - 1; }
    }
    return lo;
  }

  T get(this, i32 i) {
    if (i < 0 || i >= this.n) { trap "Chunked.get(\{i}) of \{this.n}"; }
    i32 b = this.blockOf(i);
    return this.blocks.get(b).get(i - this.starts[b]);
  }

  void set(this, i32 i, T v) {
    i32 b = this.blockOf(i);
    this.blocks.get(b).set(i - this.starts[b], v);
  }

  void insert(this, i32 i, T v) {
    if (this.blocks.len() == 0) {
      Vec<T> first = Vec.withCapacity(BLOCK * 2);
      first.push(v);
      this.blocks.push(first);
      this.n = 1;
      this.stale = true;
      return;
    }
    i32 b = this.blockOf(i);
    Vec<T> blk = this.blocks.get(b);
    blk.insert(i - this.starts[b], v);
    this.n++;
    if (blk.len() >= BLOCK * 2) {
      Vec<T> right = Vec.withCapacity(BLOCK * 2);
      for (i32 k = BLOCK; k < blk.len(); k++) { right.push(blk.get(k)); }
      while (blk.len() > BLOCK) { blk.pop(); }
      this.blocks.insert(b + 1, right);
    }
    this.stale = true;
  }

  void push(this, T v) { this.insert(this.n, v); }

  T remove(this, i32 i) {
    i32 b = this.blockOf(i);
    Vec<T> blk = this.blocks.get(b);
    T v = blk.remove(i - this.starts[b]);
    this.n--;
    if (blk.len() == 0) { this.blocks.remove(b); }
    this.stale = true;
    return v;
  }

  void clear(this) {
    this.blocks.clear();
    this.n = 0;
    this.stale = true;
  }
}
