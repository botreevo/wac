// A connection: statements run against a database in memory, with transactions, and the image to save
// when a transaction commits.

import { Result, Vec, Map, hashString, stringEq, hashI64, i64Eq } from "core";
import { SqlError } from "./error.wac";
import { Value, compareValues, compareColl, sameValue, collationId } from "./value.wac";
import { CreateTrigger, Expr, Stmt, Select, Source, ResultCol, Insert, Update, Delete, Upsert, Assign, CreateTable,
         CreateIndex, ColumnDef, JOIN_FIRST, OR_ABORT, OR_IGNORE, OR_REPLACE, OR_FAIL, OR_ROLLBACK } from "./ast.wac";
import { parseOne, Parsed, isBlank } from "./parser.wac";
import { Table, Row, Index, Entry, Column, View, Trigger, SchemaEntry, ForeignKey, affinityOf, AFF_INTEGER } from "./schema.wac";
import { Database, openBytes, toBytes, tableFrom, indexFrom, rebuildIndex, constValue } from "./database.wac";
import { Node, BoundSource, SelectPlan, Rows } from "./plan.wac";
import { Exec, Scope, Ctx, Named, topCtx, bindExpr, eval, planSelect, runPlan, query, pushCtes, popCtes, resolveTable } from "./query.wac";
import { applyAffinity, isNull, textOf } from "./ops.wac";
import { FnEnv } from "./functions.wac";
import { lower } from "./lexer.wac";
import { Chunked } from "./chunked.wac";

// What undoes one change, newest last.
enum Undo {
  UInserted(Table t, Row r),
  UDeleted(Table t, Row r),
  UReplaced(Table t, Row old, Row now),
  USchema(Vec<SchemaEntry> order, Map<string, Table> tables, Map<string, Index> indexes, Map<string, View> views,
          Map<string, Trigger> triggers),
  UAddColumn(Table t, Column[] cols, string sql),
  UUserVersion(i64 v),
}

export struct Connection {
  Database db;
  bool inTx;
  Vec<Undo> txUndo;
  bool txChanged;
  bool txSchema;
  // Set when a commit (or an autocommitted statement) changed the database; whoever stores the image
  // clears it with `image()`.
  bool dirty;
  bool schemaDirty;
  i64 changes;
  i64 totalChanges;
  i64 lastInsertRowid;
  FnEnv env;
  Map<string, Parsed> cache;
  bool foreignKeys;          // PRAGMA foreign_keys
  Vec<Savepoint> savepoints;
  Vec<Pending> deferred;     // foreign keys to check at COMMIT

  Connection over(Database db) {
    return Connection(db, false, Vec.create(), false, false, false, false, 0, 0, 0,
                      FnEnv { nowMillis: 0, changes: 0, totalChanges: 0, lastInsertRowid: 0, randomBytes: u8[].filled(64, 7), randomAt: 0 }, Map.create(hashString, stringEq),
                      false, Vec.create(), Vec.create());
  }

  Connection memory() { return Connection.over(Database.empty()); }

  Result<Connection, SqlError> openImage(u8[] bytes) {
    if (bytes.len() == 0) { return Result.Ok(Connection.memory()); }
    return Result.Ok(Connection.over(try openBytes(bytes)));
  }

  // The time `CURRENT_TIMESTAMP` and friends answer, and fresh bytes for random(): the engine has no
  // clock or entropy of its own, so whoever runs it provides them.
  void setClock(this, i64 nowMillis) { this.env.nowMillis = nowMillis; }

  void setRandom(this, u8[] bytes) {
    if (bytes.len() > 0) { this.env.randomBytes = bytes; this.env.randomAt = 0; }
  }

  // The database as a file, with its change counter advanced, for storing after a commit.
  u8[] image(this) {
    if (this.dirty) {
      this.db.changeCounter++;
      if (this.schemaDirty) { this.db.schemaCookie++; }
    }
    this.dirty = false;
    this.schemaDirty = false;
    return toBytes(this.db);
  }

  Result<Parsed, SqlError> parse(this, string sql) {
    Parsed? hit = this.cache.get(sql);
    if (hit is not null) { return Result.Ok(hit!); }
    Parsed p = try parseOne(sql);
    if (this.cache.len() > 500) { this.cache.clear(); }
    this.cache.set(sql, p);
    return Result.Ok(p);
  }

  // Runs one statement with its parameters, in order: `?` is params[0], `?2` is params[1].
  Result<Rows, SqlError> execute(this, string sql, Value[] params) {
    Parsed p = try this.parse(sql);
    if (p.rest is not null && !isBlank(p.rest!)) {
      return Result.Err(SqlError.misuse("execute takes one statement; use exec for several"));
    }
    return this.run(p.stmt, params);
  }

  // Runs every statement in the text, with no parameters, and answers the last one's rows.
  Result<Rows, SqlError> exec(this, string sql) {
    string? rest = sql;
    Rows last = Rows(string[](), Vec.create());
    while (rest is not null && !isBlank(rest!)) {
      Parsed p = try parseOne(rest!);
      last = try this.run(p.stmt, Value[]());
      rest = p.rest;
    }
    return Result.Ok(last);
  }

  Result<Rows, SqlError> run(this, Stmt st, Value[] params) {
    match (st) {
      BeginStmt: {
        if (this.inTx) { return Result.Err(SqlError("error", "cannot start a transaction within a transaction")); }
        this.inTx = true;
        this.txUndo.clear();
        this.txChanged = false;
        this.txSchema = false;
        return Result.Ok(noRows());
      }
      CommitStmt: {
        if (!this.inTx) { return Result.Err(SqlError("error", "cannot commit - no transaction is active")); }
        try this.commit(params);
        return Result.Ok(noRows());
      }
      SavepointStmt(name): {
        bool starts = !this.inTx;
        if (starts) {
          this.inTx = true;
          this.txUndo.clear();
          this.txChanged = false;
          this.txSchema = false;
        }
        this.savepoints.push(Savepoint(lower(name), this.txUndo.len(), this.deferred.len(), starts));
        return Result.Ok(noRows());
      }
      ReleaseStmt(name): {
        i32 at = this.findSavepoint(name);
        if (at < 0) { return Result.Err(SqlError("error", "no such savepoint: \{name}")); }
        bool outermost = this.savepoints.get(at).startedTx;
        // Releasing the savepoint that began the transaction commits it.
        if (outermost) { try this.commit(params); return Result.Ok(noRows()); }
        while (this.savepoints.len() > at) { this.savepoints.pop(); }
        return Result.Ok(noRows());
      }
      RollbackToStmt(name): {
        i32 at = this.findSavepoint(name);
        if (at < 0) { return Result.Err(SqlError("error", "no such savepoint: \{name}")); }
        Savepoint sp = this.savepoints.get(at);
        Vec<Undo> tail;
        while (this.txUndo.len() > sp.undoLen) { tail.insert(0, this.txUndo.pop()!); }
        undoAll(this.db, tail);
        while (this.deferred.len() > sp.deferredLen) { this.deferred.pop(); }
        // The savepoint itself stays; the ones after it go.
        while (this.savepoints.len() > at + 1) { this.savepoints.pop(); }
        return Result.Ok(noRows());
      }
      RollbackStmt: {
        if (!this.inTx) { return Result.Err(SqlError("error", "cannot rollback - no transaction is active")); }
        this.rollback();
        return Result.Ok(noRows());
      }
      default: {}
    }
    Vec<Undo> undo;
    Exec x = Exec { db: this.db, params: params, env: this.env, ctes: Vec.create() };
    this.env.changes = this.changes;
    Statement s = Statement(this, x, undo, 0, false, false, false, Vec.create(), "");
    Result<Rows, SqlError> ran = s.run(st);
    // Immediate foreign keys hold at the end of each statement; deferred ones at COMMIT, or now when
    // there is no transaction to wait for.
    SqlError? fkErr = null;
    if (ran.isOk()) {
      for (i32 i = 0; i < s.pending.len(); i++) {
        Pending pd = s.pending.get(i);
        if (this.inTx && pd.deferred) { continue; }
        match (s.holds(pd)) {
          Ok(fine): { if (!fine) { fkErr = SqlError("constraint", "FOREIGN KEY constraint failed"); break; } }
          Err(e): { fkErr = e; break; }
        }
      }
    }
    Result<Rows, SqlError> result = fkErr is null ? ran : Result.Err(fkErr!);
    match (result) {
      Ok(rows): {
        if (this.inTx) {
          for (i32 i = 0; i < s.pending.len(); i++) { if (s.pending.get(i).deferred) { this.deferred.push(s.pending.get(i)); } }
        }
        if (s.counted) { this.changes = s.count; this.totalChanges += s.count; }
        bool changed = undo.len() > 0;
        if (this.inTx) {
          for (i32 i = 0; i < undo.len(); i++) { this.txUndo.push(undo.get(i)); }
          if (changed) { this.txChanged = true; }
          if (s.schema) { this.txSchema = true; }
        } else {
          if (changed) { this.dirty = true; }
          if (s.schema) { this.schemaDirty = true; }
        }
        return Result.Ok(rows);
      }
      Err(e): {
        undoAll(this.db, undo);
        if (s.rollbackTx && this.inTx) { this.rollback(); }
        return Result.Err(e);
      }
    }
  }

  i32 findSavepoint(this, string name) {
    string n = lower(name);
    for (i32 i = this.savepoints.len() - 1; i >= 0; i--) { if (this.savepoints.get(i).name == n) { return i; } }
    return -1;
  }

  // Deferred foreign keys are checked now; a failure leaves the transaction open, as in SQLite.
  Result<void, SqlError> commit(this, Value[] params) {
    Statement chk = Statement(this, Exec { db: this.db, params: params, env: this.env, ctes: Vec.create() },
                              Vec.create(), 0, false, false, false, Vec.create(), "");
    for (i32 i = 0; i < this.deferred.len(); i++) {
      if (!(try chk.holds(this.deferred.get(i)))) {
        return Result.Err(SqlError("constraint", "FOREIGN KEY constraint failed"));
      }
    }
    this.deferred.clear();
    this.savepoints.clear();
    this.inTx = false;
    this.txUndo.clear();
    if (this.txChanged) { this.dirty = true; }
    if (this.txSchema) { this.schemaDirty = true; }
    return Result.Ok();
  }

  void rollback(this) {
    this.savepoints.clear();
    undoAll(this.db, this.txUndo);
    this.txUndo.clear();
    this.deferred.clear();
    this.inTx = false;
  }
}

Rows noRows() { return Rows(string[](), Vec.create()); }

void undoAll(Database db, Vec<Undo> undo) {
  for (i32 i = undo.len() - 1; i >= 0; i--) {
    match (undo.get(i)) {
      UInserted(t, r): { removeRow(db, t, r); }
      UDeleted(t, r): { addRow(db, t, r); }
      UReplaced(t, old, now): { replaceRow(db, t, now, old); }
      USchema(order, tables, indexes, views, triggers): {
        db.views = views;
        db.triggers = triggers;
        db.order = order;
        db.tables = tables;
        db.indexes = indexes;
      }
      UAddColumn(t, cols, sql): {
        for (i32 k = 0; k < t.rows.len(); k++) {
          Row r = t.rows.get(k);
          Value[] v = Value[].filled(cols.len(), Value.Null);
          v.copyFrom(r.vals, 0, 0, cols.len());
          r.vals = v;
        }
        t.cols = cols;
        t.sql = sql;
      }
      UUserVersion(v): { db.userVersion = v; }
    }
  }
  undo.clear();
}

void addRow(Database db, Table t, Row r) {
  t.rows.insert(t.find(r.rowid), r);
  Index[] ixs = db.indexesOf(t.name);
  for (i32 i = 0; i < ixs.len(); i++) { ixs[i].add(r); }
}

void removeRow(Database db, Table t, Row r) {
  i32 at = t.find(r.rowid);
  if (at < t.rows.len() && t.rows.get(at).rowid == r.rowid) { t.rows.remove(at); }
  Index[] ixs = db.indexesOf(t.name);
  for (i32 i = 0; i < ixs.len(); i++) { ixs[i].drop(r); }
}

// Swaps a row for another with the same rowid, touching only the indexes whose key changed.
void replaceRow(Database db, Table t, Row old, Row now) {
  i32 at = t.find(old.rowid);
  t.rows.set(at, now);
  Index[] ixs = db.indexesOf(t.name);
  for (i32 i = 0; i < ixs.len(); i++) {
    Index ix = ixs[i];
    bool same = true;
    for (i32 k = 0; k < ix.cols.len(); k++) {
      if (!sameValue(old.vals[ix.cols[k]], now.vals[ix.cols[k]])) { same = false; break; }
    }
    if (!same) { ix.drop(old); ix.add(now); }
  }
}

// Removes many rows in one pass over the table and each index, rather than one shift per row.
void removeRows(Database db, Table t, Map<i64, bool> gone) {
  Vec<Row> keep = Vec.withCapacity(t.rows.len());
  for (i32 i = 0; i < t.rows.len(); i++) {
    Row r = t.rows.get(i);
    if (!gone.has(r.rowid)) { keep.push(r); }
  }
  t.rows = keep;
  Index[] ixs = db.indexesOf(t.name);
  for (i32 i = 0; i < ixs.len(); i++) {
    Index ix = ixs[i];
    Vec<Entry> ek = Vec.withCapacity(ix.entries.len());
    for (i32 k = 0; k < ix.entries.len(); k++) {
      Entry en = ix.entries.get(k);
      Value[] e = en.key;
      match (e[e.len() - 1]) {
        Int(id): { if (!gone.has(id)) { ek.push(en); } }
        default: { ek.push(en); }
      }
    }
    ix.entries = Chunked.fromArray(ek.toArray());
  }
}

Map<string, V> copyMap<V>(Map<string, V> m) {
  Map<string, V> out = Map.create(hashString, stringEq);
  string[] keys = m.keys();
  for (string k in keys) { out.set(k, m.get(k)!); }
  return out;
}

SqlError constraint(string m) { return SqlError("constraint", m); }

SqlError err(string m) { return SqlError("error", m); }

// One statement's run: what it changed, so a failure can be undone.
struct Statement {
  Connection conn;
  Exec x;
  Vec<Undo> undo;
  i64 count;
  bool counted;
  bool schema;
  bool rollbackTx = false;
  Vec<Pending> pending;
  string activeTriggers = "";

  Database db(this) { return this.conn.db; }

  // ── constraints: CHECK and foreign keys ──────────────────────────────────

  // Every CHECK holds for the row, or the row is refused; NULL counts as holding, as in SQLite.
  Result<bool, SqlError> checksHold(this, Table t, Row r, i32 orAction) {
    if (t.checks.len() == 0) { return Result.Ok(true); }
    Scope sc = Scope([BoundSource(lower(t.name), t, JOIN_FIRST, null, false)], null, null, false);
    Ctx c = Ctx([r as Row?], null, null, null, null);
    for (i32 i = 0; i < t.checks.len(); i++) {
      Node n = try bindExpr(t.checks[i], sc, this.x);
      if (truthOf(try eval(n, c, this.x)) == 0) {
        if (orAction == OR_IGNORE) { return Result.Ok(false); }
        if (orAction == OR_ROLLBACK) { this.rollbackTx = true; }
        return Result.Err(constraint("CHECK constraint failed: \{t.name}"));
      }
    }
    return Result.Ok(true);
  }

  // The parent's columns a foreign key names: those listed, or the parent's primary key.
  Result<i32[], SqlError> parentCols(this, Table parent, ForeignKey fk) {
    if (fk.parentCols.len() == 0) {
      if (parent.pk.len() == 0 || parent.pk.len() != fk.cols.len()) {
        return Result.Err(err("foreign key mismatch - \"?\" referencing \"\{parent.name}\""));
      }
      return Result.Ok(parent.pk);
    }
    if (fk.parentCols.len() != fk.cols.len()) { return Result.Err(err("foreign key mismatch - referencing \"\{parent.name}\"")); }
    i32[] out = i32[].filled(fk.parentCols.len(), 0);
    for (i32 i = 0; i < out.len(); i++) {
      out[i] = parent.colIndex(fk.parentCols[i]);
      if (out[i] < 0) { return Result.Err(err("foreign key mismatch - referencing \"\{parent.name}\"")); }
    }
    return Result.Ok(out);
  }

  // A child's values compared with a parent's: under the parent column's affinity and collation.
  bool keyMatches(this, Table parent, i32[] pcols, Row prow, Value[] key) {
    for (i32 i = 0; i < pcols.len(); i++) {
      Column pc = parent.cols[pcols[i]];
      Value pv = pcols[i] == parent.rowidAlias ? Value.Int(prow.rowid) : prow.vals[pcols[i]];
      if (isNull(pv)) { return false; }
      if (compareColl(applyAffinity(key[i], pc.affinity), pv, pc.coll) != 0) { return false; }
    }
    return true;
  }

  bool parentExists(this, Table parent, i32[] pcols, Value[] key) {
    if (pcols.len() == 1 && pcols[0] == parent.rowidAlias) {
      match (applyAffinity(key[0], AFF_INTEGER)) {
        Int(id): { return parent.get(id) is not null; }
        default: { return false; }
      }
    }
    for (i32 i = 0; i < parent.rows.len(); i++) {
      if (this.keyMatches(parent, pcols, parent.rows.get(i), key)) { return true; }
    }
    return false;
  }

  Row[] childrenOf(this, Table child, ForeignKey fk, Table parent, i32[] pcols, Value[] key) {
    Vec<Row> out;
    for (i32 i = 0; i < child.rows.len(); i++) {
      Row r = child.rows.get(i);
      bool all = true;
      for (i32 k = 0; k < fk.cols.len(); k++) {
        Value cv = r.vals[fk.cols[k]];
        Column pc = parent.cols[pcols[k]];
        if (isNull(cv) || compareColl(applyAffinity(cv, pc.affinity), key[k], pc.coll) != 0) { all = false; break; }
      }
      if (all) { out.push(r); }
    }
    return out.toArray();
  }

  // Whether a deferred check still holds: a child row's parent exists, or nothing refers to a parent key
  // that went away.
  Result<bool, SqlError> holds(this, Pending pd) {
    Database d = this.conn.db;
    Table? parent = d.table(pd.fk.parent);
    if (pd.row is not null) {
      Row? now = pd.child.get(pd.row!.rowid);
      if (now is null || now! is not pd.row!) { return Result.Ok(true); }
      Value[] key = Value[].filled(pd.fk.cols.len(), Value.Null);
      for (i32 i = 0; i < key.len(); i++) {
        key[i] = pd.row!.vals[pd.fk.cols[i]];
        if (isNull(key[i])) { return Result.Ok(true); }
      }
      if (parent is null) { return Result.Ok(false); }
      i32[] pcols = try this.parentCols(parent!, pd.fk);
      return Result.Ok(this.parentExists(parent!, pcols, key));
    }
    if (parent is null) { return Result.Ok(true); }
    i32[] pcols = try this.parentCols(parent!, pd.fk);
    if (this.parentExists(parent!, pcols, pd.key)) { return Result.Ok(true); }
    return Result.Ok(this.childrenOf(pd.child, pd.fk, parent!, pcols, pd.key).len() == 0);
  }

  // A row written into a table whose foreign keys must find their parents.
  void childWritten(this, Table t, Row r, Row? old) {
    if (!this.conn.foreignKeys) { return; }
    for (i32 i = 0; i < t.fks.len(); i++) {
      ForeignKey fk = t.fks[i];
      if (old is not null) {
        bool same = true;
        for (i32 k in fk.cols) { if (!sameValue(old!.vals[k], r.vals[k])) { same = false; } }
        if (same) { continue; }
      }
      this.pending.push(Pending(t, fk, r, Value[](), fk.deferred));
    }
  }

  // A parent row going away (now == null) or changing: what each foreign key that refers to it says to
  // do with its children.
  Result<void, SqlError> parentChanging(this, Table parent, Row old, Row? now) {
    if (!this.conn.foreignKeys) { return Result.Ok(); }
    Database d = this.conn.db;
    string pn = lower(parent.name);
    string[] names = d.tables.keys();
    for (string cn in names) {
      Table child = d.tables.get(cn)!;
      for (i32 f = 0; f < child.fks.len(); f++) {
        ForeignKey fk = child.fks[f];
        if (lower(fk.parent) != pn) { continue; }
        i32[] pcols = try this.parentCols(parent, fk);
        Value[] key = Value[].filled(pcols.len(), Value.Null);
        bool hasNull = false;
        bool changed = now is null;
        for (i32 k = 0; k < pcols.len(); k++) {
          key[k] = pcols[k] == parent.rowidAlias ? Value.Int(old.rowid) : old.vals[pcols[k]];
          if (isNull(key[k])) { hasNull = true; }
          if (now is not null) {
            Value nv = pcols[k] == parent.rowidAlias ? Value.Int(now!.rowid) : now!.vals[pcols[k]];
            if (!sameValue(nv, key[k])) { changed = true; }
          }
        }
        if (hasNull || !changed) { continue; }
        string action = now is null ? fk.onDelete : fk.onUpdate;
        if (action == "NO ACTION") {
          this.pending.push(Pending(child, fk, null, key, fk.deferred));
          continue;
        }
        Row[] kids = this.childrenOf(child, fk, parent, pcols, key);
        if (kids.len() == 0) { continue; }
        if (action == "RESTRICT") { return Result.Err(constraint("FOREIGN KEY constraint failed")); }
        for (i32 i = 0; i < kids.len(); i++) {
          Row kid = kids[i];
          if (action == "CASCADE" && now is null) {
            try this.parentChanging(child, kid, null);
            this.deleteRow(child, kid);
            continue;
          }
          Value[] vals = Value[].filled(kid.vals.len(), Value.Null);
          vals.copyFrom(kid.vals, 0, 0, kid.vals.len());
          for (i32 k = 0; k < fk.cols.len(); k++) {
            i32 c = fk.cols[k];
            if (action == "CASCADE") {
              vals[c] = pcols[k] == parent.rowidAlias ? Value.Int(now!.rowid) : now!.vals[pcols[k]];
            } else if (action == "SET NULL") {
              vals[c] = Value.Null;
            } else {
              vals[c] = try this.defaultFor(child.cols[c]);
            }
            vals[c] = applyAffinity(vals[c], child.cols[c].affinity);
          }
          i64 rowid = kid.rowid;
          if (child.rowidAlias >= 0) {
            match (vals[child.rowidAlias]) { Int(id): { rowid = id; } default: {} }
          }
          Row nk = Row(rowid, vals, null);
          if (!(try this.prepareRow(child, nk, OR_ABORT))) { continue; }
          try this.parentChanging(child, kid, nk);
          if (rowid == kid.rowid) {
            replaceRow(d, child, kid, nk);
            this.undo.push(Undo.UReplaced(child, kid, nk));
          } else {
            this.deleteRow(child, kid);
            this.insertRow(child, nk);
          }
          // SET DEFAULT can point at a parent that is not there.
          if (action == "SET DEFAULT") { this.childWritten(child, nk, kid); }
        }
      }
    }
    return Result.Ok();
  }

  // ── triggers ─────────────────────────────────────────────────────────────

  // A view changes only through its INSTEAD OF triggers, one firing per row.
  Result<void, SqlError> viewWritable(this, string name, string event) {
    if (this.conn.db.triggersOn(name, "INSTEAD OF", event).len() == 0) {
      return Result.Err(err("cannot modify \{name} because it is a view"));
    }
    return Result.Ok();
  }

  Result<Rows, SqlError> insertIntoView(this, Insert ins) {
    try this.viewWritable(ins.table, "INSERT");
    Named nv = try resolveTable(ins.table, this.x);
    Table shape = nv.table;
    i32[] target;
    if (ins.cols is not null) {
      string[] names = ins.cols!;
      target = i32[].filled(names.len(), 0);
      for (i32 i = 0; i < names.len(); i++) {
        target[i] = shape.colIndex(names[i]);
        if (target[i] < 0) { return Result.Err(err("table \{ins.table} has no column named \{names[i]}")); }
      }
    } else {
      target = i32[].filled(shape.cols.len(), 0);
      for (i32 i = 0; i < target.len(); i++) { target[i] = i; }
    }
    Vec<Value[]> source;
    if (ins.defaultValues) { source.push(Value[]()); target = i32[](); }
    else {
      SelectPlan sp = try planSelect(ins.source!, null, this.x);
      if (sp.names.len() != target.len()) { return Result.Err(err("\{sp.names.len()} values for \{target.len()} columns")); }
      source = try runPlan(sp, topCtx(this.x), this.x);
    }
    this.counted = true;
    for (i32 k = 0; k < source.len(); k++) {
      Value[] vals = Value[].filled(shape.cols.len(), Value.Null);
      for (i32 i = 0; i < target.len(); i++) { vals[target[i]] = source.get(k)[i]; }
      if (try this.fire(ins.table, shape, "INSTEAD OF", "INSERT", null, Row(0, vals, null), null)) { this.count++; }
    }
    return Result.Ok(noRows());
  }

  Result<Rows, SqlError> changeView(this, string name, Expr? where, Assign[] sets, string event) {
    try this.viewWritable(name, event);
    Named nv = try resolveTable(name, this.x);
    Table shape = nv.table;
    // The view's rows, and those the WHERE picks.
    Scope vs = Scope([BoundSource(lower(name), shape, JOIN_FIRST, null, true)], this.x.triggerScope, null, false);
    Node? cond = null;
    if (where is not null) { cond = try bindExpr(where!, vs, this.x); }
    Vec<Row> picked;
    for (i32 i = 0; i < shape.rows.len(); i++) {
      Row r = shape.rows.get(i);
      if (cond is null || truthOf(try eval(cond!, Ctx([r as Row?], null, null, null, null), this.x)) == 1) { picked.push(r); }
    }
    BoundSets? bs = null;
    if (event == "UPDATE") {
      Scope sc = Scope([BoundSource(lower(name), shape, JOIN_FIRST, null, true)], this.x.triggerScope, null, false);
      bs = try this.bindSets(shape, sets, sc);
    }
    this.counted = true;
    for (i32 i = 0; i < picked.len(); i++) {
      Row? old = picked.get(i);
      Row? neu = null;
      if (bs is not null) {
        Value[] vals = Value[].filled(old!.vals.len(), Value.Null);
        vals.copyFrom(old!.vals, 0, 0, vals.len());
        Ctx c = Ctx([old], null, null, null, null);
        for (i32 k = 0; k < bs!.cols.len(); k++) {
          if (bs!.cols[k] >= 0) { vals[bs!.cols[k]] = try eval(bs!.nodes[k], c, this.x); }
        }
        neu = Row(old!.rowid, vals, null);
      }
      i32[]? setCols = bs is null ? null : bs!.cols;
      if (try this.fire(name, shape, "INSTEAD OF", event, old, neu, setCols)) { this.count++; }
    }
    return Result.Ok(noRows());
  }

  // Runs the triggers on `name` for one timing and event, with OLD and NEW. Answers false when one of
  // them said RAISE(IGNORE): the row's change, and the triggers after, are skipped.
  Result<bool, SqlError> fire(this, string name, Table shape, string timing, string event, Row? old, Row? neu, i32[]? setCols) {
    Trigger[] ts = this.conn.db.triggersOn(name, timing, event);
    for (i32 i = 0; i < ts.len(); i++) {
      CreateTrigger def = ts[i].def;
      // UPDATE OF fires only when the SET list names one of its columns.
      if (event == "UPDATE" && def.ofCols.len() > 0 && setCols is not null) {
        bool hit = false;
        for (string c in def.ofCols) {
          i32 ci = shape.colIndex(c);
          for (i32 k in setCols!) { if (k == ci || (k == -1 && ci == shape.rowidAlias)) { hit = true; } }
        }
        if (!hit) { continue; }
      }
      // A trigger does not set itself off again (recursive_triggers is off, as by default in SQLite).
      if (this.activeTriggers.indexOf("|" + lower(def.name) + "|") >= 0) { continue; }
      Vec<BoundSource> srcs;
      Vec<Row?> rows;
      if (old is not null) { srcs.push(BoundSource("old", shape, JOIN_FIRST, null, false)); rows.push(old); }
      if (neu is not null) { srcs.push(BoundSource("new", shape, JOIN_FIRST, null, false)); rows.push(neu); }
      Scope? prevScope = this.x.triggerScope;
      Ctx? prevCtx = this.x.triggerCtx;
      string prevActive = this.activeTriggers;
      i64 prevCount = this.count;
      bool prevCounted = this.counted;
      Scope sc = Scope(srcs.toArray(), null, null, false);
      Ctx cx = Ctx(rows.toArray(), null, null, null, null);
      this.x.triggerScope = sc;
      this.x.triggerCtx = cx;
      this.activeTriggers = prevActive + "|" + lower(def.name) + "|";
      SqlError? failed = null;
      bool run = true;
      if (def.when is not null) {
        match (bindExpr(def.when!, sc, this.x)) {
          Ok(n): {
            match (eval(n, cx, this.x)) {
              Ok(v): { run = truthOf(v) == 1; }
              Err(e): { failed = e; }
            }
          }
          Err(e): { failed = e; }
        }
      }
      if (failed is null && run) {
        for (i32 k = 0; k < def.body.len(); k++) {
          match (this.run(def.body[k])) {
            Ok(r): {}
            Err(e): { failed = e; break; }
          }
        }
      }
      this.x.triggerScope = prevScope;
      this.x.triggerCtx = prevCtx;
      this.activeTriggers = prevActive;
      this.count = prevCount;
      this.counted = prevCounted;
      if (failed is not null) {
        string code = failed!.code;
        if (code == "raise-ignore") { return Result.Ok(false); }
        if (code == "raise-rollback") { this.rollbackTx = true; }
        if (code == "raise-abort" || code == "raise-fail" || code == "raise-rollback") {
          return Result.Err(SqlError("constraint", failed!.message));
        }
        return Result.Err(failed!);
      }
    }
    return Result.Ok(true);
  }

  // A row deleted by the statement itself or by REPLACE: its children are dealt with first.
  Result<void, SqlError> removeUserRow(this, Table t, Row r) {
    try this.parentChanging(t, r, null);
    this.deleteRow(t, r);
    return Result.Ok();
  }

  void insertRow(this, Table t, Row r) {
    addRow(this.conn.db, t, r);
    this.undo.push(Undo.UInserted(t, r));
  }

  void deleteRow(this, Table t, Row r) {
    removeRow(this.conn.db, t, r);
    this.undo.push(Undo.UDeleted(t, r));
  }

  void saveSchema(this) {
    Database d = this.conn.db;
    Vec<SchemaEntry> order = Vec.create();
    for (i32 i = 0; i < d.order.len(); i++) { order.push(d.order.get(i)); }
    this.undo.push(Undo.USchema(order, copyMap(d.tables), copyMap(d.indexes), copyMap(d.views),
                                    copyMap(d.triggers)));
    this.schema = true;
  }

  Result<Rows, SqlError> run(this, Stmt st) {
    match (st) {
      SelectStmt(s): { return query(s, this.x); }
      InsertStmt(i): {
        i32 depth = pushCtes(i.with, i.recursive, this.x);
        Result<Rows, SqlError> r = this.insert(i);
        popCtes(this.x, depth);
        return r;
      }
      UpdateStmt(u): {
        i32 depth = pushCtes(u.with, u.recursive, this.x);
        Result<Rows, SqlError> r = this.update(u);
        popCtes(this.x, depth);
        return r;
      }
      DeleteStmt(d): {
        i32 depth = pushCtes(d.with, d.recursive, this.x);
        Result<Rows, SqlError> r = this.delete(d);
        popCtes(this.x, depth);
        return r;
      }
      CreateTriggerStmt(t): { try this.createTrigger(t); return Result.Ok(noRows()); }
      CreateViewStmt(name, ine, cols, sel, sql): { try this.createView(name, ine, cols, sel, sql); return Result.Ok(noRows()); }
      CreateTableStmt(c): { try this.createTable(c); return Result.Ok(noRows()); }
      CreateIndexStmt(c): { try this.createIndex(c); return Result.Ok(noRows()); }
      DropStmt(kind, name, ifExists): { try this.drop(kind, name, ifExists); return Result.Ok(noRows()); }
      AddColumnStmt(table, col, text): { try this.addColumn(table, col, text); return Result.Ok(noRows()); }
      RenameTableStmt(table, to): { return Result.Err(SqlError.unsupported("ALTER TABLE RENAME")); }
      PragmaStmt(name, value): { return this.pragma(name, value); }
      default: { return Result.Err(err("unexpected statement")); }
    }
  }

  Result<Table, SqlError> table(this, string name) {
    Table? t = this.conn.db.table(name);
    if (t is null) {
      if (this.conn.db.view(name) is not null) { return Result.Err(err("cannot modify \{name} because it is a view")); }
      return Result.Err(err("no such table: \{name}"));
    }
    if (lower(name) == "sqlite_schema" || lower(name) == "sqlite_master") {
      return Result.Err(err("table \{name} may not be modified"));
    }
    return Result.Ok(t!);
  }

  // ── changes to rows ──────────────────────────────────────────────────────

  Result<Value, SqlError> defaultFor(this, const Column c) {
    if (c.dflt is null) { return Result.Ok(Value.Null); }
    Scope none = Scope(BoundSource[](), null, null, false);
    Node n = try bindExpr(c.dflt!, none, this.x);
    return eval(n, Ctx(Row?[](), null, null, null, null), this.x);
  }

  // The rowid a new row gets when it names none: one past the largest, as SQLite does until that
  // overflows; AUTOINCREMENT also stays past any rowid ever used, as sqlite_sequence remembers.
  Result<i64, SqlError> newRowid(this, Table t) {
    i64 max = t.maxRowid();
    if (t.autoincrement) {
      i64 seq = this.sequence(t.name);
      if (seq > max) { max = seq; }
    }
    if (max == 9223372036854775807) { return Result.Err(SqlError("full", "database or disk is full")); }
    return Result.Ok(max + 1);
  }

  i64 sequence(this, string name) {
    Table? s = this.conn.db.table("sqlite_sequence");
    if (s is null) { return 0; }
    for (i32 i = 0; i < s!.rows.len(); i++) {
      Row r = s!.rows.get(i);
      match (r.vals[0]) {
        Text(n): {
          if (lower(n) == lower(name)) { match (r.vals[1]) { Int(v): { return v; } default: { return 0; } } }
        }
        default: {}
      }
    }
    return 0;
  }

  void bumpSequence(this, Table t, i64 rowid) {
    Table? s = this.conn.db.table("sqlite_sequence");
    if (s is null || !t.autoincrement) { return; }
    for (i32 i = 0; i < s!.rows.len(); i++) {
      Row r = s!.rows.get(i);
      match (r.vals[0]) {
        Text(n): {
          if (lower(n) == lower(t.name)) {
            match (r.vals[1]) {
              Int(v): { if (v >= rowid) { return; } }
              default: {}
            }
            this.deleteRow(s!, r);
            this.insertRow(s!, Row(r.rowid, [Value.Text(t.name), Value.Int(rowid)], null));
            return;
          }
        }
        default: {}
      }
    }
    this.insertRow(s!, Row(s!.maxRowid() + 1, [Value.Text(t.name), Value.Int(rowid)], null));
  }

  // Coerces a row's values to its columns' affinities and checks NOT NULL. Answers false when the row
  // is to be skipped (OR IGNORE).
  Result<bool, SqlError> prepareRow(this, Table t, Row r, i32 orAction) {
    for (i32 i = 0; i < t.cols.len(); i++) {
      if (i == t.rowidAlias) { r.vals[i] = Value.Int(r.rowid); continue; }
      r.vals[i] = applyAffinity(r.vals[i], t.cols[i].affinity);
      if (t.cols[i].notNull && isNull(r.vals[i])) {
        if (orAction == OR_IGNORE) { return Result.Ok(false); }
        if (orAction == OR_REPLACE && t.cols[i].dflt is not null) {
          r.vals[i] = applyAffinity(try this.defaultFor(t.cols[i]), t.cols[i].affinity);
          if (!isNull(r.vals[i])) { continue; }
        }
        if (orAction == OR_ROLLBACK) { this.rollbackTx = true; }
        return Result.Err(constraint("NOT NULL constraint failed: \{t.name}.\{t.cols[i].name}"));
      }
    }
    return this.checksHold(t, r, orAction);
  }

  string describeKey(this, Table t, i32[] cols) {
    string s = "";
    for (i32 i = 0; i < cols.len(); i++) {
      if (i > 0) { s += ", "; }
      s += t.name + "." + (cols[i] < 0 ? "rowid" : t.cols[cols[i]].name);
    }
    return s;
  }

  // The first constraint a row breaks, other than against itself: the rowid, then each unique index in
  // schema order. Null when there is none.
  Conflict? firstConflict(this, Table t, Row r, i64 self) {
    if (r.rowid != self) {
      Row? other = t.get(r.rowid);
      if (other is not null) {
        i32[] key = t.rowidAlias >= 0 ? [t.rowidAlias] : [-1];
        return Conflict(other!, key, null);
      }
    }
    Index[] ixs = this.conn.db.indexesOf(t.name);
    for (i32 i = 0; i < ixs.len(); i++) {
      i64? hit = ixs[i].conflict(r, self);
      if (hit is not null) { return Conflict(t.get(hit!)!, ixs[i].cols, ixs[i]); }
    }
    return null;
  }

  Result<Rows, SqlError> insert(this, Insert ins) {
    if (this.conn.db.view(ins.table) is not null) { return this.insertIntoView(ins); }
    Table t = try this.table(ins.table);
    i32[] target;
    if (ins.cols is not null) {
      string[] names = ins.cols!;
      target = i32[].filled(names.len(), 0);
      for (i32 i = 0; i < names.len(); i++) {
        target[i] = t.colIndex(names[i]);
        if (target[i] < 0) {
          string n = lower(names[i]);
          if (t.rowidAlias < 0 && (n == "rowid" || n == "oid" || n == "_rowid_")) { target[i] = -1; continue; }
          return Result.Err(err("table \{t.name} has no column named \{names[i]}"));
        }
      }
    } else {
      target = i32[].filled(t.cols.len(), 0);
      for (i32 i = 0; i < target.len(); i++) { target[i] = i; }
    }
    Vec<Value[]> source;
    if (ins.defaultValues) {
      source.push(Value[]());
      target = i32[]();
    } else {
      SelectPlan sp = try planSelect(ins.source!, null, this.x);
      if (sp.names.len() != target.len()) {
        if (ins.cols is null) {
          return Result.Err(err("table \{t.name} has \{target.len()} columns but \{sp.names.len()} values were supplied"));
        }
        return Result.Err(err("\{sp.names.len()} values for \{target.len()} columns"));
      }
      source = try runPlan(sp, topCtx(this.x), this.x);
    }
    RetPlan? ret = try this.returning(t, ins.returning);
    Vec<Value[]> out;
    this.counted = true;
    for (i32 k = 0; k < source.len(); k++) {
      Value[] given = source.get(k);
      Value[] vals = Value[].filled(t.cols.len(), Value.Null);
      bool[] set = bool[].filled(t.cols.len(), false);
      Value? rowidGiven = null;
      for (i32 i = 0; i < target.len(); i++) {
        if (target[i] < 0) { rowidGiven = given[i]; continue; }
        vals[target[i]] = given[i];
        set[target[i]] = true;
      }
      for (i32 i = 0; i < vals.len(); i++) {
        if (!set[i] && i != t.rowidAlias) { vals[i] = try this.defaultFor(t.cols[i]); }
      }
      if (t.rowidAlias >= 0 && set[t.rowidAlias]) { rowidGiven = vals[t.rowidAlias]; }
      i64 rowid = 0;
      bool haveRowid = false;
      if (rowidGiven is not null && !isNull(rowidGiven!)) {
        match (applyAffinity(rowidGiven!, AFF_INTEGER)) {
          Int(i): { rowid = i; haveRowid = true; }
          default: { return Result.Err(SqlError("mismatch", "datatype mismatch")); }
        }
      }
      if (!haveRowid) { rowid = try this.newRowid(t); }
      Row r = Row(rowid, vals, null);
      if (!(try this.prepareRow(t, r, ins.orAction))) { continue; }
      if (!(try this.fire(t.name, t, "BEFORE", "INSERT", null, r, null))) { continue; }
      bool skip = false;
      while (true) {
        Conflict? c = this.firstConflict(t, r, -9223372036854775807 - 1);
        if (c is null) { break; }
        Upsert? u = matchUpsert(ins.upserts, t, c!);
        if (u is not null) {
          skip = true;
          if (!u!.doNothing) {
            Row? changed = try this.upsertUpdate(t, c!.row, r, u!);
            if (changed is not null && ret is not null) { out.push(try this.evalReturning(ret!, changed!)); }
          }
          break;
        }
        i32 action = ins.orAction;
        if (action == OR_IGNORE) { skip = true; break; }
        if (action == OR_REPLACE) {
          try this.removeUserRow(t, c!.row);
          continue;
        }
        if (action == OR_ROLLBACK) { this.rollbackTx = true; }
        return Result.Err(constraint("UNIQUE constraint failed: " + this.describeKey(t, c!.cols)));
      }
      if (skip) { continue; }
      this.insertRow(t, r);
      this.childWritten(t, r, null);
      try this.fire(t.name, t, "AFTER", "INSERT", null, r, null);
      this.bumpSequence(t, rowid);
      this.count++;
      this.conn.lastInsertRowid = rowid;
      this.conn.env.lastInsertRowid = rowid;
      if (ret is not null) { out.push(try this.evalReturning(ret!, r)); }
    }
    if (ret is not null) { return Result.Ok(Rows(ret!.names, out)); }
    return Result.Ok(noRows());
  }

  // ON CONFLICT … DO UPDATE: the existing row changed by the SET list, which may read the row that
  // was being inserted as `excluded`. Answers the row as it now is, or null when WHERE declined it.
  Result<Row?, SqlError> upsertUpdate(this, Table t, Row existing, Row proposed, Upsert u) {
    // `excluded` is a scope outside the table's, so a bare name means the table's column and only
    // `excluded.x` reaches the proposed row, as in SQLite.
    Table ex = Table("excluded", "", t.cols, t.rowidAlias, false, Vec.create(), Expr[](), ForeignKey[](), i32[]());
    Scope outer = Scope([BoundSource("excluded", ex, JOIN_FIRST, null, false)], null, null, false);
    Scope sc = Scope([BoundSource(lower(t.name), t, JOIN_FIRST, null, false)], outer, null, false);
    Ctx c = Ctx([existing as Row?], Ctx([proposed as Row?], null, null, null, null), null, null, null);
    if (u.where is not null) {
      Node w = try bindExpr(u.where!, sc, this.x);
      match (eval(w, c, this.x)) {
        Ok(v): { if (truthOf(v) != 1) { return Result.Ok(null); } }
        Err(e): { return Result.Err(e); }
      }
    }
    return this.applySets(t, existing, try this.bindSets(t, u.sets, sc), c, OR_ABORT);
  }

  // Computes and stores an updated row. Null when OR IGNORE skipped it.
  // A SET list resolved once per statement: each target column (-1 for the rowid) and its expression.
  Result<BoundSets, SqlError> bindSets(this, Table t, Assign[] sets, Scope sc) {
    i32[] cols = i32[].filled(sets.len(), 0);
    Node[] nodes = Node[].filled(sets.len(), Node.NLit(Value.Null));
    for (i32 i = 0; i < sets.len(); i++) {
      Assign a = sets[i];
      if (a.cols.len() != 1) { return Result.Err(SqlError.unsupported("assigning a row value")); }
      i32 col = t.colIndex(a.cols[0]);
      if (col < 0) {
        string nm = lower(a.cols[0]);
        if (t.rowidAlias >= 0 || (nm != "rowid" && nm != "oid" && nm != "_rowid_")) {
          return Result.Err(err("no such column: \{a.cols[0]}"));
        }
      }
      if (col == t.rowidAlias) { col = -1; }
      cols[i] = col;
      nodes[i] = try bindExpr(a.value, sc, this.x);
    }
    return Result.Ok(BoundSets(cols, nodes));
  }

  // Computes and stores an updated row. Null when OR IGNORE skipped it.
  Result<Row?, SqlError> applySets(this, Table t, Row old, BoundSets bs, Ctx c, i32 orAction) {
    Value[] vals = Value[].filled(old.vals.len(), Value.Null);
    vals.copyFrom(old.vals, 0, 0, old.vals.len());
    i64 rowid = old.rowid;
    for (i32 i = 0; i < bs.cols.len(); i++) {
      Value v = try eval(bs.nodes[i], c, this.x);
      i32 col = bs.cols[i];
      if (col < 0) {
        match (applyAffinity(v, AFF_INTEGER)) {
          Int(r): { rowid = r; }
          default: { return Result.Err(SqlError("mismatch", "datatype mismatch")); }
        }
        continue;
      }
      vals[col] = v;
    }
    Row r = Row(rowid, vals, null);
    if (!(try this.prepareRow(t, r, orAction))) { return Result.Ok(null); }
    if (!(try this.fire(t.name, t, "BEFORE", "UPDATE", old, r, bs.cols))) { return Result.Ok(null); }
    // A BEFORE trigger may have changed or removed the row; SQLite then updates what is there now.
    Row? now = t.get(old.rowid);
    if (now is null) { return Result.Ok(null); }
    Row was = now!;
    if (was is not old) { old = was; }
    if (rowid == old.rowid) {
      // The common case: the row keeps its rowid, so it is swapped in place, and only the indexes whose
      // key changed are touched. Its own entries do not count as conflicts.
      while (true) {
        Conflict? cf = this.firstConflict(t, r, old.rowid);
        if (cf is null) { break; }
        if (orAction == OR_IGNORE) { return Result.Ok(null); }
        if (orAction == OR_REPLACE) { try this.removeUserRow(t, cf!.row); continue; }
        if (orAction == OR_ROLLBACK) { this.rollbackTx = true; }
        return Result.Err(constraint("UNIQUE constraint failed: " + this.describeKey(t, cf!.cols)));
      }
      try this.parentChanging(t, old, r);
      this.childWritten(t, r, old);
      replaceRow(this.conn.db, t, old, r);
      this.undo.push(Undo.UReplaced(t, old, r));
      this.count++;
      try this.fire(t.name, t, "AFTER", "UPDATE", old, r, bs.cols);
      return Result.Ok(r);
    }
    // The old row is out of the way while the new one is checked, so a row may keep its own key.
    this.deleteRow(t, old);
    while (true) {
      Conflict? cf = this.firstConflict(t, r, -9223372036854775807 - 1);
      if (cf is null) { break; }
      if (orAction == OR_IGNORE) {
        this.insertRow(t, old);
        return Result.Ok(null);
      }
      if (orAction == OR_REPLACE) { try this.removeUserRow(t, cf!.row); continue; }
      if (orAction == OR_ROLLBACK) { this.rollbackTx = true; }
      return Result.Err(constraint("UNIQUE constraint failed: " + this.describeKey(t, cf!.cols)));
    }
    try this.parentChanging(t, old, r);
    this.childWritten(t, r, old);
    this.insertRow(t, r);
    this.count++;
    try this.fire(t.name, t, "AFTER", "UPDATE", old, r, bs.cols);
    return Result.Ok(r);
  }

  // The rows a WHERE picks, by rowid, found with the same planner a SELECT uses.
  Result<Row[], SqlError> matching(this, Table t, Expr? where) {
    Select s = Select { cols: [ResultCol(Expr.Col(null, "rowid"), null, null, "rowid")],
                        from: [Source { table: t.name, join: JOIN_FIRST }], where: where };
    SelectPlan p = try planSelect(s, null, this.x);
    Vec<Value[]> ids = try runPlan(p, topCtx(this.x), this.x);
    Vec<Row> out;
    for (i32 i = 0; i < ids.len(); i++) {
      match (ids.get(i)[0]) {
        Int(id): { Row? r = t.get(id); if (r is not null) { out.push(r!); } }
        default: {}
      }
    }
    return Result.Ok(out.toArray());
  }

  Result<Rows, SqlError> update(this, Update u) {
    if (this.conn.db.view(u.table) is not null) { return this.changeView(u.table, u.where, u.sets, "UPDATE"); }
    Table t = try this.table(u.table);
    Row[] rows = try this.matching(t, u.where);
    BoundSource[] srcs = [BoundSource(lower(t.name), t, JOIN_FIRST, null, false)];
    Scope sc = Scope(srcs, this.x.triggerScope, null, false);
    RetPlan? ret = try this.returning(t, u.returning);
    BoundSets bs = try this.bindSets(t, u.sets, sc);
    Vec<Value[]> out;
    this.counted = true;
    for (i32 i = 0; i < rows.len(); i++) {
      // The rowids are gathered first and each is then looked up afresh, as SQLite does: a row an earlier
      // REPLACE removed is skipped, and a row moved onto a rowid still to come is updated again there.
      Row? cur = t.get(rows[i].rowid);
      if (cur is null) { continue; }
      Ctx c = Ctx([cur], null, null, null, null);
      Row? changed = try this.applySets(t, cur!, bs, c, u.orAction);
      if (changed is not null && ret is not null) { out.push(try this.evalReturning(ret!, changed!)); }
    }
    if (ret is not null) { return Result.Ok(Rows(ret!.names, out)); }
    return Result.Ok(noRows());
  }

  Result<Rows, SqlError> delete(this, Delete d) {
    if (this.conn.db.view(d.table) is not null) { return this.changeView(d.table, d.where, Assign[](), "DELETE"); }
    Table t = try this.table(d.table);
    Row[] rows = try this.matching(t, d.where);
    RetPlan? ret = try this.returning(t, d.returning);
    Vec<Value[]> out;
    this.counted = true;
    bool triggers = this.conn.db.triggersOn(t.name, "BEFORE", "DELETE").len() > 0 ||
                    this.conn.db.triggersOn(t.name, "AFTER", "DELETE").len() > 0;
    if (rows.len() > 32 && !this.conn.foreignKeys && !triggers) {
      Map<i64, bool> gone = Map.create(hashI64, i64Eq);
      for (i32 i = 0; i < rows.len(); i++) {
        if (ret is not null) { out.push(try this.evalReturning(ret!, rows[i])); }
        gone.set(rows[i].rowid, true);
        this.undo.push(Undo.UDeleted(t, rows[i]));
      }
      removeRows(this.conn.db, t, gone);
      this.count += rows.len() as i64;
    } else {
      for (i32 i = 0; i < rows.len(); i++) {
        if (ret is not null) { out.push(try this.evalReturning(ret!, rows[i])); }
        // A CASCADE may already have taken this row.
        Row? still = t.get(rows[i].rowid);
        Row want = rows[i];
        if (still is null || still! is not want) { continue; }
        if (!(try this.fire(t.name, t, "BEFORE", "DELETE", rows[i], null, null))) { continue; }
        Row? again = t.get(rows[i].rowid);
        if (again is null || again! is not want) { continue; }
        try this.removeUserRow(t, rows[i]);
        this.count++;
        try this.fire(t.name, t, "AFTER", "DELETE", rows[i], null, null);
      }
    }
    if (ret is not null) { return Result.Ok(Rows(ret!.names, out)); }
    return Result.Ok(noRows());
  }

  Result<RetPlan?, SqlError> returning(this, Table t, ResultCol[]? cols) {
    if (cols is null) { return Result.Ok(null); }
    BoundSource[] srcs = [BoundSource(lower(t.name), t, JOIN_FIRST, null, false)];
    Scope sc = Scope(srcs, null, null, false);
    Vec<Node> nodes;
    Vec<string> names;
    ResultCol[] rcs = cols!;
    for (i32 i = 0; i < rcs.len(); i++) {
      if (rcs[i].star is not null) {
        for (i32 c = 0; c < t.cols.len(); c++) {
          nodes.push(Node.NCol(0, 0, c, t.cols[c].affinity, t.cols[c].coll));
          names.push(t.cols[c].name);
        }
        continue;
      }
      nodes.push(try bindExpr(rcs[i].expr!, sc, this.x));
      names.push(rcs[i].alias ?? rcs[i].text);
    }
    return Result.Ok(RetPlan(nodes.toArray(), names.toArray()));
  }

  Result<Value[], SqlError> evalReturning(this, RetPlan p, Row r) {
    Ctx c = Ctx([r as Row?], null, null, null, null);
    Value[] out = Value[].filled(p.nodes.len(), Value.Null);
    for (i32 i = 0; i < out.len(); i++) { out[i] = try eval(p.nodes[i], c, this.x); }
    return Result.Ok(out);
  }

  // ── schema ───────────────────────────────────────────────────────────────

  bool nameTaken(this, string name) {
    return this.conn.db.table(name) is not null || this.conn.db.index(name) is not null ||
           this.conn.db.view(name) is not null;
  }

  Result<void, SqlError> createTrigger(this, CreateTrigger c) {
    Database d = this.conn.db;
    if (d.trigger(c.name) is not null) {
      if (c.ifNotExists) { return Result.Ok(); }
      return Result.Err(err("trigger \{c.name} already exists"));
    }
    bool isView = d.view(c.table) is not null;
    if (d.table(c.table) is null && !isView) { return Result.Err(err("no such table: main.\{c.table}")); }
    if (isView && c.timing != "INSTEAD OF") {
      return Result.Err(err("cannot create \{c.timing} trigger on view: main.\{c.table}"));
    }
    if (!isView && c.timing == "INSTEAD OF") {
      return Result.Err(err("cannot create INSTEAD OF trigger on table: \{c.table}"));
    }
    this.saveSchema();
    d.triggers.set(lower(c.name), Trigger(c));
    d.order.push(SchemaEntry("trigger", c.name, c.table));
    return Result.Ok();
  }

  Result<void, SqlError> createView(this, string name, bool ifNotExists, string[]? cols, Select sel, string sql) {
    if (this.nameTaken(name)) {
      if (ifNotExists && this.conn.db.view(name) is not null) { return Result.Ok(); }
      string what = this.conn.db.view(name) is not null ? "view" : (this.conn.db.table(name) is not null ? "table" : "index");
      return Result.Err(err("\{what} \{name} already exists"));
    }
    // SQLite checks a view's query only when the view is used, not when it is made.
    this.saveSchema();
    this.conn.db.views.set(lower(name), View(name, sql, cols, sel));
    this.conn.db.order.push(SchemaEntry("view", name, name));
    return Result.Ok();
  }

  Result<void, SqlError> createTable(this, CreateTable c) {
    if (this.nameTaken(c.name)) {
      if (c.ifNotExists && this.conn.db.table(c.name) is not null) { return Result.Ok(); }
      return Result.Err(err("\{this.conn.db.table(c.name) is not null ? "table" : "index"} \{c.name} already exists"));
    }
    if (lower(c.name).indexOf("sqlite_") == 0) { return Result.Err(err("object name reserved for internal use: \{c.name}")); }
    Vec<Index> autos;
    Table t = try tableFrom(c, autos);
    this.saveSchema();
    Database d = this.conn.db;
    d.tables.set(lower(t.name), t);
    d.order.push(SchemaEntry("table", t.name, t.name));
    for (i32 i = 0; i < autos.len(); i++) {
      d.indexes.set(lower(autos.get(i).name), autos.get(i));
      d.order.push(SchemaEntry("index", autos.get(i).name, t.name));
    }
    if (t.autoincrement && d.table("sqlite_sequence") is null) {
      Table seq = Table("sqlite_sequence", "CREATE TABLE sqlite_sequence(name,seq)",
                        [Column("name", "", 0, false, null, 0), Column("seq", "", 0, false, null, 0)], -1, false, Vec.create(),
                        Expr[](), ForeignKey[](), i32[]());
      d.tables.set("sqlite_sequence", seq);
      d.order.push(SchemaEntry("table", "sqlite_sequence", "sqlite_sequence"));
    }
    return Result.Ok();
  }

  Result<void, SqlError> createIndex(this, CreateIndex c) {
    if (this.nameTaken(c.name)) {
      if (c.ifNotExists && this.conn.db.index(c.name) is not null) { return Result.Ok(); }
      return Result.Err(err("index \{c.name} already exists"));
    }
    if (lower(c.name).indexOf("sqlite_") == 0) { return Result.Err(err("object name reserved for internal use: \{c.name}")); }
    Table t = try this.table(c.table);
    Index ix = try indexFrom(c, t);
    rebuildIndex(ix, t);
    if (ix.unique) {
      for (i32 i = 0; i < t.rows.len(); i++) {
        if (ix.conflict(t.rows.get(i), t.rows.get(i).rowid) is not null) {
          return Result.Err(constraint("UNIQUE constraint failed: " + this.describeKey(t, ix.cols)));
        }
      }
    }
    this.saveSchema();
    this.conn.db.indexes.set(lower(ix.name), ix);
    this.conn.db.order.push(SchemaEntry("index", ix.name, t.name));
    return Result.Ok();
  }

  Result<void, SqlError> drop(this, string kind, string name, bool ifExists) {
    Database d = this.conn.db;
    if (kind == "TRIGGER") {
      if (d.trigger(name) is null) {
        if (ifExists) { return Result.Ok(); }
        return Result.Err(err("no such trigger: \{name}"));
      }
      this.saveSchema();
      Vec<SchemaEntry> rest;
      for (i32 i = 0; i < d.order.len(); i++) {
        if (!(d.order.get(i).kind == "trigger" && lower(d.order.get(i).name) == lower(name))) { rest.push(d.order.get(i)); }
      }
      d.order = rest;
      d.triggers.remove(lower(name));
      return Result.Ok();
    }
    if (kind == "VIEW") {
      if (d.view(name) is null) {
        if (ifExists) { return Result.Ok(); }
        return Result.Err(err("no such view: \{name}"));
      }
      this.saveSchema();
      Vec<SchemaEntry> rest;
      for (i32 i = 0; i < d.order.len(); i++) {
        SchemaEntry e = d.order.get(i);
        if (e.kind == "view" && lower(e.name) == lower(name)) { continue; }
        // A view's triggers go with it.
        if (e.kind == "trigger" && lower(e.table) == lower(name)) { d.triggers.remove(lower(e.name)); continue; }
        rest.push(e);
      }
      d.order = rest;
      d.views.remove(lower(name));
      return Result.Ok();
    }
    if (kind == "TABLE") {
      Table? t = d.table(name);
      if (t is null && d.view(name) is not null) { return Result.Err(err("use DROP VIEW to delete view \{name}")); }
      if (t is null) {
        if (ifExists) { return Result.Ok(); }
        return Result.Err(err("no such table: \{name}"));
      }
      if (lower(name) == "sqlite_sequence") { return Result.Err(err("table sqlite_sequence may not be dropped")); }
      this.saveSchema();
      string tn = lower(t!.name);
      Vec<SchemaEntry> keep;
      for (i32 i = 0; i < d.order.len(); i++) {
        SchemaEntry e = d.order.get(i);
        if (lower(e.table) == tn) {
          if (e.kind == "index") { d.indexes.remove(lower(e.name)); }
          if (e.kind == "trigger") { d.triggers.remove(lower(e.name)); }
          continue;
        }
        keep.push(e);
      }
      d.order = keep;
      d.tables.remove(tn);
      // The table's AUTOINCREMENT counter goes with it.
      Table? seq = d.table("sqlite_sequence");
      if (seq is not null) {
        for (i32 i = seq!.rows.len() - 1; i >= 0; i--) {
          Row r = seq!.rows.get(i);
          match (r.vals[0]) { Text(n): { if (lower(n) == tn) { this.deleteRow(seq!, r); } } default: {} }
        }
      }
      return Result.Ok();
    }
    Index? ix = d.index(name);
    if (ix is null) {
      if (ifExists) { return Result.Ok(); }
      return Result.Err(err("no such index: \{name}"));
    }
    if (ix!.sql is null) {
      return Result.Err(err("index associated with UNIQUE or PRIMARY KEY constraint cannot be dropped"));
    }
    this.saveSchema();
    Vec<SchemaEntry> keep;
    for (i32 i = 0; i < d.order.len(); i++) {
      if (lower(d.order.get(i).name) != lower(name)) { keep.push(d.order.get(i)); }
    }
    d.order = keep;
    d.indexes.remove(lower(name));
    return Result.Ok();
  }

  Result<void, SqlError> addColumn(this, string table, ColumnDef c, string text) {
    Table t = try this.table(table);
    if (t.colIndex(c.name) >= 0) { return Result.Err(err("duplicate column name: \{c.name}")); }
    if (c.primaryKey) { return Result.Err(err("Cannot add a PRIMARY KEY column")); }
    if (c.unique) { return Result.Err(err("Cannot add a UNIQUE column")); }
    Value dv = Value.Null;
    if (c.dflt is not null) {
      Value? v = constValue(c.dflt!);
      if (v is null) {
        // CURRENT_TIMESTAMP and the like are not constant, and neither is anything else that is not a
        // literal: SQLite refuses them here, since existing rows would need a value.
        return Result.Err(err("Cannot add a column with non-constant default"));
      }
      dv = v!;
    }
    if (c.notNull && isNull(dv)) { return Result.Err(err("Cannot add a NOT NULL column with default value NULL")); }
    i32 close = t.sql.len() - 1;
    while (close > 0 && t.sql.slice(close, close + 1) != ")") { close--; }
    this.undo.push(Undo.UAddColumn(t, t.cols, t.sql));
    this.schema = true;
    string sql = t.sql.slice(0, close) + ", " + text + t.sql.slice(close, t.sql.len());
    Column[] cols = Column[].defaulted(t.cols.len() + 1);
    cols.copyFrom(t.cols, 0, 0, t.cols.len());
    cols[t.cols.len()] = Column(c.name, c.typeName, affinityOf(c.typeName), c.notNull, c.dflt,
                                c.collate is null ? 0 : collationId(c.collate!));
    Value stored = applyAffinity(dv, cols[t.cols.len()].affinity);
    for (i32 i = 0; i < t.rows.len(); i++) {
      Row r = t.rows.get(i);
      Value[] v = Value[].filled(cols.len(), stored);
      v.copyFrom(r.vals, 0, 0, r.vals.len());
      r.vals = v;
    }
    t.cols = cols;
    t.sql = sql;
    return Result.Ok();
  }

  Result<Rows, SqlError> pragma(this, string name, Expr? value) {
    Database d = this.conn.db;
    if (name == "user_version") {
      if (value is null) { return Result.Ok(one("user_version", Value.Int(d.userVersion))); }
      Value v = try this.constant(value!);
      this.undo.push(Undo.UUserVersion(d.userVersion));
      d.userVersion = match (applyAffinity(v, AFF_INTEGER)) { Int(i): i, default: 0 as i64 };
      return Result.Ok(noRows());
    }
    if (name == "page_size") {
      if (value is null) { return Result.Ok(one("page_size", Value.Int(d.pageSize as i64))); }
      Value v = try this.constant(value!);
      match (v) {
        Int(n): {
          if (n >= 512 && n <= 65536 && (n & (n - 1)) == 0) { d.pageSize = n as! i32; }
        }
        default: {}
      }
      return Result.Ok(noRows());
    }
    if (name == "journal_mode") { return Result.Ok(one("journal_mode", Value.Text("delete"))); }
    if (name == "integrity_check" || name == "quick_check") { return Result.Ok(one(name, Value.Text("ok"))); }
    if (name == "foreign_keys") {
      if (value is null) { return Result.Ok(one("foreign_keys", Value.Int(this.conn.foreignKeys ? 1 : 0))); }
      Value v = try this.constant(value!);
      // As in SQLite, the setting cannot change inside a transaction.
      if (!this.conn.inTx) {
        match (v) {
          Text(t): { this.conn.foreignKeys = lower(t) == "on" || lower(t) == "true" || lower(t) == "yes" || t == "1"; }
          default: { this.conn.foreignKeys = truthOf(v) == 1; }
        }
      }
      return Result.Ok(noRows());
    }
    if (name == "busy_timeout" || name == "synchronous" || name == "cache_size" ||
        name == "temp_store" || name == "mmap_size" || name == "recursive_triggers" || name == "wal_autocheckpoint") {
      if (value is null) { return Result.Ok(one(name, Value.Int(0))); }
      return Result.Ok(noRows());
    }
    if (name == "table_info") {
      if (value is null) { return Result.Ok(noRows()); }
      string tn = textOf(try this.constant(value!));
      Table? t = d.table(tn);
      Vec<Value[]> rows;
      if (t is not null) {
        for (i32 i = 0; i < t!.cols.len(); i++) {
          Column c = t!.cols[i];
          rows.push([Value.Int(i as i64), Value.Text(c.name), Value.Text(c.typeName), Value.Int(c.notNull ? 1 : 0),
                     Value.Null, Value.Int(i == t!.rowidAlias ? 1 : 0)]);
        }
      }
      return Result.Ok(Rows(["cid", "name", "type", "notnull", "dflt_value", "pk"], rows));
    }
    return Result.Ok(noRows());
  }

  Result<Value, SqlError> constant(this, Expr e) {
    Scope none = Scope(BoundSource[](), null, null, false);
    return eval(try bindExpr(e, none, this.x), Ctx(Row?[](), null, null, null, null), this.x);
  }
}

i32 truthOf(Value v) {
  return match (v) { Null: -1, Int(i): i != 0 ? 1 : 0, Real(r): r != 0.0 ? 1 : 0, default: 0 };
}

Rows one(string name, Value v) {
  Vec<Value[]> rows;
  rows.push([v]);
  return Rows([name], rows);
}

// SAVEPOINT name: where the transaction's undo log and deferred checks stood.
struct Savepoint {
  string name;
  i32 undoLen;
  i32 deferredLen;
  bool startedTx;     // SAVEPOINT outside a transaction began one; releasing it commits
}

// A foreign-key check left for the end of the statement (or the transaction): a child row that must have
// a parent (row set), or a parent key that must have no children left (row null).
struct Pending {
  Table child;
  ForeignKey fk;
  Row? row;
  Value[] key;
  bool deferred;
}

struct Conflict {
  Row row;
  i32[] cols;     // the constraint's columns; [-1] for a bare rowid
  Index? ix;
}

struct BoundSets {
  i32[] cols;
  Node[] nodes;
}

struct RetPlan {
  Node[] nodes;
  string[] names;
}

// The upsert clause that handles a conflict: one whose target names the constraint's columns, or a
// clause with no target.
Upsert? matchUpsert(Upsert[] ups, Table t, Conflict c) {
  for (i32 i = 0; i < ups.len(); i++) {
    Upsert u = ups[i];
    if (u.target.len() == 0) { return u; }
    if (u.target.len() != c.cols.len()) { continue; }
    bool all = true;
    for (string n in u.target) {
      i32 col = t.colIndex(n);
      bool found = false;
      for (i32 k in c.cols) { if (k == col) { found = true; } }
      if (!found) { all = false; }
    }
    if (all) { return u; }
  }
  return null;
}
