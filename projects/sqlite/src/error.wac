// Every failure the library reports. One type rather than a union of many, because callers mostly
// show the message, and SQLite's own interface is the same: a code and a string.

export struct SqlError {
  string code;      // "corrupt", "schema", "syntax", "constraint", "misuse", "unsupported", "io"
  string message;

  SqlError corrupt(string m) { return SqlError("corrupt", m); }
  SqlError syntax(string m) { return SqlError("syntax", m); }
  SqlError schema(string m) { return SqlError("schema", m); }
  SqlError constraint(string m) { return SqlError("constraint", m); }
  SqlError misuse(string m) { return SqlError("misuse", m); }
  SqlError unsupported(string m) { return SqlError("unsupported", m); }

  string describe(const this) { return this.code + ": " + this.message; }
}
