// A database in a file. The file is read whole when opened and written whole at every commit: to a
// temporary file beside it, then renamed over it, so a reader never sees half a write and a crash
// leaves the old file or the new one.
//
// The calls block until the file operations finish (`Ticket.wait`), which keeps the interface the same
// as the in-memory Connection's.
//
// One writer at a time. SQLite's locks are not taken, so another program writing the same file at the
// same time would lose one side's changes; readers (the real SQLite included) are safe.
//
// A database in WAL mode may have a log beside it holding committed transactions the file does not yet
// have. Opening reads them over the file. Before the first write, the file is brought up to date with
// exactly those pages (a checkpoint) and only then is the log removed, so a crash at any point leaves
// either the log over the old file or a file that already holds what the log would add: replaying it
// again changes nothing. That needs no other connection to be using the database meanwhile.

import { Result, flatten } from "core";
import { Files, NotFound } from "std";
import { SqlError } from "./error.wac";
import { Value } from "./value.wac";
import { Connection } from "./engine.wac";
import { applyWal } from "./wal.wac";
import { Rows } from "./plan.wac";

export struct SqliteFile {
  Files fs;
  string path;
  Connection conn;
  u8[]? checkpoint;   // the file as the log leaves it, to be written before anything else

  // Opens a database file, or starts an empty one that is created at the first commit.
  Result<SqliteFile, SqlError> open(Files fs, string path) {
    // A hot journal holds what a crashed writer had half done, to be undone; that is SQLite's to do.
    match (flatten(fs.stat(path + "-journal").wait())) {
      Ok(st): {
        if (st.exists && st.size > 0) {
          return Result.Err(SqlError.unsupported("\{path}-journal exists: open the database with SQLite first to recover it"));
        }
      }
      Err(e): {}
    }
    u8[] bytes = u8[]();
    bool found = true;
    match (flatten(fs.readFile(path).wait())) {
      Ok(b): { bytes = b; }
      Err(e): {
        if (!(e is NotFound)) { return Result.Err(SqlError("io", "cannot read \{path}")); }
        found = false;
      }
    }
    u8[]? merged = null;
    match (flatten(fs.readFile(path + "-wal").wait())) {
      Ok(wal): { merged = applyWal(bytes, wal); }
      Err(e): {}
    }
    if (merged is not null) { return Result.Ok(SqliteFile(fs, path, try Connection.openImage(merged!), merged)); }
    if (!found) { return Result.Ok(SqliteFile(fs, path, try Connection.openImage(u8[]()), null)); }
    return Result.Ok(SqliteFile(fs, path, try Connection.openImage(bytes), null));
  }

  // Runs one statement, and writes the file if it committed a change.
  Result<Rows, SqlError> execute(this, string sql, Value[] params) {
    Rows r = try this.conn.execute(sql, params);
    try this.saveIfChanged();
    return Result.Ok(r);
  }

  // Runs every statement in the text, writing the file after each that committed a change.
  Result<Rows, SqlError> exec(this, string sql) {
    Rows r = try this.conn.exec(sql);
    try this.saveIfChanged();
    return Result.Ok(r);
  }

  Result<void, SqlError> saveIfChanged(this) {
    if (!this.conn.dirty || this.conn.inTx) { return Result.Ok(); }
    if (this.checkpoint is not null) {
      try this.replace(this.checkpoint!);
      for (string side in ["-wal", "-shm"]) {
        match (flatten(this.fs.remove(this.path + side, false).wait())) {
          Ok: {}
          Err(e): {}
        }
      }
      this.checkpoint = null;
    }
    return this.replace(this.conn.image());
  }

  // The file's contents replaced whole, through a temporary file renamed over it.
  Result<void, SqlError> replace(this, u8[] image) {
    string tmp = this.path + "-wac-tmp";
    match (flatten(this.fs.writeFile(tmp, image).wait())) {
      Ok: {}
      Err(e): { return Result.Err(SqlError("io", "cannot write \{tmp}")); }
    }
    match (flatten(this.fs.rename(tmp, this.path).wait())) {
      Ok: { return Result.Ok(); }
      Err(e): { return Result.Err(SqlError("io", "cannot replace \{this.path}")); }
    }
  }
}
