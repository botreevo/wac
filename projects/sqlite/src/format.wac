// Values as text, the way SQLite converts them: integers in decimal, reals with up to fifteen
// significant digits and always a decimal point (its "%!.15g").

import { Buf } from "core";
import { Value } from "./value.wac";

struct Digits {
  bool neg;
  string digits;   // significant digits, no leading zeros
  i32 exp;         // the value is 0.d1d2d3… × 10^exp
}

// Splits the shortest round-trip text of `r` into digits and a decimal exponent.
Digits digitsOf(f64 r) {
  string s = "\{r}";
  bool neg = false;
  if (s.slice(0, 1) == "-") { neg = true; s = s.slice(1, s.len()); }
  i32 e = s.indexOf("e");
  i32 sciExp = 0;
  if (e >= 0) {
    string ex = s.slice(e + 1, s.len());
    bool eneg = ex.slice(0, 1) == "-";
    if (ex.slice(0, 1) == "+" || eneg) { ex = ex.slice(1, ex.len()); }
    u8[] eb = ex.toBytes();
    for (i32 i = 0; i < eb.len(); i++) { sciExp = sciExp * 10 + (eb[i] - '0') as i32; }
    if (eneg) { sciExp = -sciExp; }
    s = s.slice(0, e);
  }
  i32 dot = s.indexOf(".");
  string intPart = dot < 0 ? s : s.slice(0, dot);
  string frac = dot < 0 ? "" : s.slice(dot + 1, s.len());
  string all = intPart + frac;
  i32 exp = intPart.len() + sciExp;
  // Leading zeros move the exponent; trailing zeros carry nothing.
  u8[] b = all.toBytes();
  i32 lead = 0;
  while (lead < b.len() && b[lead] == '0') { lead++; }
  i32 end = b.len();
  while (end > lead && b[end - 1] == '0') { end--; }
  if (lead == end) { return Digits(neg, "", 0); }
  return Digits(neg, all.slice(lead, end), exp - lead);
}

// Rounds a digit string to at most `n` digits, half up, carrying into the exponent if it overflows.
Digits roundTo(Digits d, i32 n) {
  if (d.digits.len() <= n) { return d; }
  u8[] b = d.digits.slice(0, n).toBytes();
  bool up = d.digits.toBytes()[n] >= '5';
  i32 exp = d.exp;
  if (up) {
    i32 i = n - 1;
    while (i >= 0) {
      if (b[i] == '9') { b[i] = '0'; i--; } else { b[i] = b[i] + 1; break; }
    }
    if (i < 0) {
      u8[] nb = u8[].filled(n, '0');
      nb[0] = '1';
      b = nb;
      exp++;
    }
  }
  i32 end = b.len();
  while (end > 1 && b[end - 1] == '0') { end--; }
  return Digits(d.neg, string.fromBytes(b).slice(0, end), exp);
}

export string formatReal(f64 r) {
  if (r != r) { return "NaN"; }
  if (r == 1.0 / 0.0) { return "Inf"; }
  if (r == -1.0 / 0.0) { return "-Inf"; }
  if (r == 0.0) { return f64.toBits(r) == f64.toBits(0.0) ? "0.0" : "-0.0"; }
  Digits d = roundTo(digitsOf(r), 15);
  Buf out = Buf.create();
  if (d.neg) { out.pushStr("-"); }
  i32 x = d.exp - 1;   // the exponent in d.ddd×10^x form
  string ds = d.digits;
  if (x < -4 || x >= 15) {
    out.pushStr(ds.slice(0, 1));
    out.pushStr(".");
    out.pushStr(ds.len() > 1 ? ds.slice(1, ds.len()) : "0");
    out.pushStr(x < 0 ? "e-" : "e+");
    i32 ax = x < 0 ? -x : x;
    if (ax < 10) { out.pushStr("0"); }
    out.pushStr("\{ax}");
    return out.toStr();
  }
  if (d.exp <= 0) {
    out.pushStr("0.");
    for (i32 i = 0; i < -d.exp; i++) { out.pushStr("0"); }
    out.pushStr(ds);
    return out.toStr();
  }
  if (ds.len() <= d.exp) {
    out.pushStr(ds);
    for (i32 i = ds.len(); i < d.exp; i++) { out.pushStr("0"); }
    out.pushStr(".0");
    return out.toStr();
  }
  out.pushStr(ds.slice(0, d.exp));
  out.pushStr(".");
  out.pushStr(ds.slice(d.exp, ds.len()));
  return out.toStr();
}

static string HEX = "0123456789ABCDEF";

export string hexOf(const u8[] b) {
  Buf out = Buf.create();
  for (i32 i = 0; i < b.len(); i++) {
    i32 v = b[i] as i32;
    out.pushStr(HEX.slice(v >> 4, (v >> 4) + 1));
    out.pushStr(HEX.slice(v & 15, (v & 15) + 1));
  }
  return out.toStr();
}

// A value as SQL would write it: NULL, a number, a quoted string, or a blob literal.
export string sqlLiteral(const Value v) {
  return match (v) {
    Null: "NULL",
    Int(i): "\{i}",
    Real(r): formatReal(r),
    Text(s): "'" + replaceAll(s, "'", "''") + "'",
    Blob(b): "X'" + hexOf(b) + "'",
  };
}

export string replaceAll(string s, string from, string to) {
  if (from.len() == 0) { return s; }
  Buf out = Buf.create();
  i32 at = 0;
  while (true) {
    i32 hit = s.slice(at, s.len()).indexOf(from);
    if (hit < 0) { break; }
    out.pushStr(s.slice(at, at + hit));
    out.pushStr(to);
    at += hit + from.len();
  }
  out.pushStr(s.slice(at, s.len()));
  return out.toStr();
}
