// Values as text, the way SQLite writes them.

import { Buf } from "core";
import { Value } from "./value.wac";
import { fpDecode, FpDigits } from "./fp.wac";

// A real as this library displays it: "%!.15g", what SQLite's printf gives and the corpus compares.
export string formatReal(f64 r) { return generic(r, 15); }

static string HEX = "0123456789ABCDEF";

export string hexOf(const u8[] b) {
  Buf out = Buf.create();
  for (i32 i = 0; i < b.len(); i++) {
    i32 v = b[i] as i32;
    out.pushStr(HEX.slice(v >> 4, (v >> 4) + 1));
    out.pushStr(HEX.slice(v & 15, (v & 15) + 1));
  }
  return out.toStr();
}

// A value as SQL would write it: NULL, a number, a quoted string, or a blob literal.
export string sqlLiteral(const Value v) {
  return match (v) {
    Null: "NULL",
    Int(i): "\{i}",
    Real(r): formatReal(r),
    Text(s): "'" + replaceAll(s, "'", "''") + "'",
    Blob(b): "X'" + hexOf(b) + "'",
  };
}

export string replaceAll(string s, string from, string to) {
  if (from.len() == 0) { return s; }
  Buf out = Buf.create();
  i32 at = 0;
  while (true) {
    i32 hit = s.slice(at, s.len()).indexOf(from);
    if (hit < 0) { break; }
    out.pushStr(s.slice(at, at + hit));
    out.pushStr(to);
    at += hit + from.len();
  }
  out.pushStr(s.slice(at, s.len()));
  return out.toStr();
}

// ── a real as text ─────────────────────────────────────────────────────────
//
// SQLite writes a real with printf's "%!.Ng": N significant digits (17 for CAST(r AS TEXT), `||` and
// every conversion to text; 15 where this library displays a value), trailing zeros dropped, a decimal
// point always, and an exponent below 1e-4 or at 10^N and above. The digits come from fp.wac, SQLite's
// own conversion, which at 17 digits falls back to fewer when they read back as the same number.

string generic(f64 r, i32 precision) {
  if (r != r) { return "NaN"; }
  if (r == 1.0 / 0.0) { return "Inf"; }
  if (r == -1.0 / 0.0) { return "-Inf"; }
  // Negative zero prints as zero, as SQLite prints it.
  if (r == 0.0) { return "0.0"; }
  bool neg = r < 0.0;
  FpDigits d = fpDecode(neg ? -r : r, precision, 20);
  Buf out = Buf.create();
  if (neg) { out.pushStr("-"); }
  i32 x = d.dp - 1;
  string ds = d.digits;
  if (x < -4 || x > precision - 1) {
    out.pushStr(ds.slice(0, 1));
    out.pushStr(".");
    out.pushStr(ds.len() > 1 ? ds.slice(1, ds.len()) : "0");
    out.pushStr(x < 0 ? "e-" : "e+");
    i32 ax = x < 0 ? -x : x;
    if (ax < 10) { out.pushStr("0"); }
    out.pushStr("\{ax}");
    return out.toStr();
  }
  if (d.dp <= 0) {
    out.pushStr("0.");
    for (i32 i = 0; i < -d.dp; i++) { out.pushStr("0"); }
    out.pushStr(ds);
    return out.toStr();
  }
  if (ds.len() <= d.dp) {
    out.pushStr(ds);
    for (i32 i = ds.len(); i < d.dp; i++) { out.pushStr("0"); }
    out.pushStr(".0");
    return out.toStr();
  }
  out.pushStr(ds.slice(0, d.dp));
  out.pushStr(".");
  out.pushStr(ds.slice(d.dp, ds.len()));
  return out.toStr();
}

// A real as SQLite converts it to text.
export string realText(f64 r) { return generic(r, 17); }
