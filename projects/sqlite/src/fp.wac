// Decimal digits of a double, exactly as SQLite 3.53 computes them (sqlite3FpDecode and its helpers in
// SQLite's src/util.c, which is in the public domain), so a real becomes the same text here as there.
//
// SQLite's own words, where they explain the arithmetic, are kept beside it.

// The high 64 bits of a*b, and the low 64 in lo[0].
u64 mul128(u64 a, u64 b, u64[] lo) {
  u64 a0 = a & 0xFFFFFFFF;
  u64 a1 = a >> 32;
  u64 b0 = b & 0xFFFFFFFF;
  u64 b1 = b >> 32;
  u64 a0b0 = a0 * b0;
  u64 a1b1 = a1 * b1;
  u64 a0b1 = a0 * b1;
  u64 a1b0 = a1 * b0;
  u64 t = (a0b0 >> 32) + (a0b1 & 0xFFFFFFFF) + (a1b0 & 0xFFFFFFFF);
  lo[0] = (a0b0 & 0xFFFFFFFF) | (t << 32);
  return a1b1 + (a0b1 >> 32) + (a1b0 >> 32) + (t >> 32);
}

// A is the 96-bit (a<<32)+aLo, B 64 bits. The upper 64 bits of A*B, and the 32 below them in lo[0].
u64 mul160(u64 a, u64 aLo, u64 b, u64[] lo) {
  u64 x2 = a >> 32;
  u64 x1 = a & 0xFFFFFFFF;
  u64 x0 = aLo;
  u64 y1 = b >> 32;
  u64 y0 = b & 0xFFFFFFFF;
  u64 x2y1 = x2 * y1;
  u64 r4 = x2y1 >> 32;
  u64 x2y0 = x2 * y0;
  u64 x1y1 = x1 * y1;
  u64 r3 = (x2y1 & 0xFFFFFFFF) + (x2y0 >> 32) + (x1y1 >> 32);
  u64 x1y0 = x1 * y0;
  u64 x0y1 = x0 * y1;
  u64 r2 = (x2y0 & 0xFFFFFFFF) + (x1y1 & 0xFFFFFFFF) + (x1y0 >> 32) + (x0y1 >> 32);
  u64 x0y0 = x0 * y0;
  u64 r1 = (x1y0 & 0xFFFFFFFF) + (x0y1 & 0xFFFFFFFF) + (x0y0 >> 32);
  r2 = r2 + (r1 >> 32);
  r3 = r3 + (r2 >> 32);
  lo[0] = r2 & 0xFFFFFFFF;
  return (r4 << 32) + r3;
}

static u64[] BASE = [
  0x8000000000000000, 0xa000000000000000, 0xc800000000000000, 0xfa00000000000000, 0x9c40000000000000,
  0xc350000000000000, 0xf424000000000000, 0x9896800000000000, 0xbebc200000000000, 0xee6b280000000000,
  0x9502f90000000000, 0xba43b74000000000, 0xe8d4a51000000000, 0x9184e72a00000000, 0xb5e620f480000000,
  0xe35fa931a0000000, 0x8e1bc9bf04000000, 0xb1a2bc2ec5000000, 0xde0b6b3a76400000, 0x8ac7230489e80000,
  0xad78ebc5ac620000, 0xd8d726b7177a8000, 0x878678326eac9000, 0xa968163f0a57b400, 0xd3c21bcecceda100,
  0x84595161401484a0, 0xa56fa5b99019a5c8,
];

static u64[] SCALE = [
  0x8049a4ac0c5811ae, 0xcf42894a5dce35ea, 0xa76c582338ed2621, 0x873e4f75e2224e68, 0xda7f5bf590966848,
  0xb080392cc4349dec, 0x8e938662882af53e, 0xe65829b3046b0afa, 0xba121a4650e4ddeb, 0x964e858c91ba2655,
  0xf2d56790ab41c2a2, 0xc428d05aa4751e4c, 0x9e74d1b791e07e48, 0xcccccccccccccccc, 0xcecb8f27f4200f3a,
  0xa70c3c40a64e6c51, 0x86f0ac99b4e8dafd, 0xda01ee641a708de9, 0xb01ae745b101e9e4, 0x8e41ade9fbebc27d,
  0xe5d3ef282a242e81, 0xb9a74a0637ce2ee1, 0x95f83d0a1fb69cd9, 0xf24a01a73cf2dccf, 0xc3b8358109e84f07,
  0x9e19db92b4e31ba9,
];

static u64[] SCALE_LO = [
  0x205b896d, 0x52064cad, 0xaf2af2b8, 0x5a7744a7, 0xaf39a475, 0xbd8d794e, 0x547eb47b, 0x0cb4a5a3,
  0x92f34d62, 0x3a6a07f9, 0xfae27299, 0xaa97e14c, 0x775ea265, 0xcccccccc, 0x00000000, 0x999090b6,
  0x69a028bb, 0xe80e6f48, 0x5ec05dd0, 0x14588f14, 0x8f1668c9, 0x6d953e2c, 0x4abdaf10, 0xbc633b39,
  0x0a862f81, 0x6c07a2c2,
];

// The most significant 64 bits of 10^p, and the next 32 in lo[0], for p in -348..347.
u64 powerOfTen(i32 p, u64[] lo) {
  i32 g = 0;
  i32 n = 0;
  if (p < 0) {
    if (p == -1) { lo[0] = SCALE_LO[13]; return SCALE[13]; }
    g = p / 27;
    n = p % 27;
    if (n != 0) { g--; n += 27; }
  } else if (p < 27) {
    lo[0] = 0;
    return BASE[p];
  } else {
    g = p / 27;
    n = p % 27;
  }
  u64 s = SCALE[g + 13];
  if (n == 0) { lo[0] = SCALE_LO[g + 13]; return s; }
  u64[] l = [0 as u64];
  u64 x = mul160(s, SCALE_LO[g + 13], BASE[n], l);
  u64 lw = l[0];
  if ((x & 0x8000000000000000) == 0) {
    x = (x << 1) | ((lw >> 31) & 1);
    lw = ((lw << 1) | 1) & 0xFFFFFFFF;
  }
  lo[0] = lw;
  return x;
}

// floor(log2(10^p)) and floor(log10(2^p)), from SQLite's approximate ratios. The right shifts round
// negative numbers down, as SQLite's do.
i32 pwr10to2(i32 p) { return (p * 108853) >> 15; }

i32 pwr2to10(i32 p) { return (p * 78913) >> 18; }

i32 leadingZeros(u64 m0) {
  u64 m = m0;
  i32 n = 0;
  if (m <= 0x00000000ffffffff) { n += 32; m = m << 32; }
  if (m <= 0x0000ffffffffffff) { n += 16; m = m << 16; }
  if (m <= 0x00ffffffffffffff) { n += 8; m = m << 8; }
  if (m <= 0x0fffffffffffffff) { n += 4; m = m << 4; }
  if (m <= 0x3fffffffffffffff) { n += 2; m = m << 2; }
  if (m <= 0x7fffffffffffffff) { n += 1; }
  return n;
}

// "Given m and e, which represent a quantity r == m*pow(2,e), return values *pD and *pP such that
// r == (*pD)*pow(10,*pP), approximately. *pD should contain at least n significant digits."
struct Dec {
  u64 d;
  i32 p;
}

Dec fp2Convert10(u64 m, i32 e, i32 n) {
  i32 p = n - 1 - pwr2to10(e + 63);
  u64[] d2 = [0 as u64];
  u64[] d1 = [0 as u64];
  u64 h = mul128(m, powerOfTen(p, d2), d1);
  if (n == 18) {
    h = h >> -(e + pwr10to2(p) + 2);
    return Dec((h + ((h << 1) & 2)) >> 1, -p);
  }
  return Dec(h >> -(e + pwr10to2(p) + 1), -p);
}

// "Return an IEEE754 floating point value that approximates d*pow(10,p)", after Russ Cox's fpfmt.
export f64 fp10Convert2(u64 d, i32 p) {
  if (p < -348) { return 0.0; }
  if (p > 347) { return 1.0 / 0.0; }
  i32 b = 64 - leadingZeros(d);
  i32 lp = pwr10to2(p);
  i32 e = 53 - b - lp;
  if (e > 1074) {
    if (e >= 1130) { return 0.0; }
    e = 1074;
  }
  i32 s = -(e - (64 - b) + lp + 3);
  u64[] l = [0 as u64];
  u64 pwr10h = powerOfTen(p, l);
  u64 pwr10l = l[0];
  if (pwr10l != 0) {
    pwr10h = pwr10h + 1;
    pwr10l = (~pwr10l) & 0xFFFFFFFF;
  }
  u64 x = d << (64 - b);
  u64[] lo = [0 as u64];
  u64 hi = mul128(x, pwr10h, lo);
  u64 mid1 = lo[0] >> 32;
  u64 sticky = 1;
  if ((hi & ((1 as u64 << s) - 1)) == 0) {
    u64[] lo2 = [0 as u64];
    u64 mid2 = (mul128(x, pwr10l << 32, lo2) >> 32) & 0xFFFFFFFF;
    // mid1 and mid2 are 32-bit quantities in SQLite (u32), so their difference wraps at 32 bits.
    sticky = ((mid1 - mid2) & 0xFFFFFFFF) > 1 ? 1 : 0;
    if (mid1 < mid2) { hi = hi - 1; }
  }
  u64 u = (hi >> s) | sticky;
  i32 adj = u >= (1 as u64 << 55) - 2 ? 1 : 0;
  if (adj == 1) {
    u = (u >> 1) | (u & 1);
    e -= 1;
  }
  u64 m = (u + 1 + ((u >> 2) & 1)) >> 2;
  if (e <= -972) { return 1.0 / 0.0; }
  if ((m & (1 as u64 << 52)) != 0) {
    m = (m & ~(1 as u64 << 52)) | (((1075 - e) as! u64) << 52);
  }
  return f64.fromBits(m);
}

// A positive, finite, non-zero double's significant digits rounded to `iRound` (at most mxRound), no
// trailing zeros, and where the decimal point goes: the value is 0.digits × 10^dp.
export struct FpDigits {
  string digits;
  i32 dp;
}

export FpDigits fpDecode(f64 r, i32 iRound0, i32 mxRound) {
  i32 iRound = iRound0;
  u64 v = f64.toBits(r);
  i32 e = ((v >> 52) & 0x7ff) as! i32;
  v = v & 0x000fffffffffffff;
  if (e == 0) {
    i32 nn = leadingZeros(v);
    v = v << nn;
    e = -1074 - nn;
  } else {
    v = (v << 11) | 0x8000000000000000;
    e -= 1086;
  }
  Dec dc = fp2Convert10(v, e, (iRound <= 0 || iRound >= 18) ? 18 : iRound + 1);
  u8[] z = "\{dc.d}".toBytes();
  i32 n = z.len();
  i32 iDP = n + dc.p;
  // Room in front for a leading zero and a carry out of the first digit.
  u8[] buf = u8[].filled(n + 2, '0');
  buf.copyFrom(z, 0, 2, n);
  i32 zi = 2;
  // Rounding to a number of places after the decimal point (printf's %f) counts from the point.
  if (iRound <= 0) {
    iRound = iDP - iRound;
    if (iRound == 0 && buf[zi] >= '5') {
      iRound = 1;
      zi--;
      buf[zi] = '0';
      n++;
      iDP++;
    }
  }
  if (iRound > 0 && (iRound < n || n > mxRound)) {
    if (iRound > mxRound) { iRound = mxRound; }
    if (iRound == 17) {
      // "If the precision is exactly 17, ... try to reduce the precision if that yields text that will
      // round-trip to the original floating-point value. Thus, for example, 49.47 will render as 49.47,
      // rather than as 49.469999999999999."
      if (buf[zi + 15] == '9' && buf[zi + 14] == '9') {
        i32 jj = 14;
        while (jj > 0 && buf[zi + jj - 1] == '9') { jj--; }
        u64 v2 = 1;
        if (jj != 0) {
          v2 = (buf[zi] - '0') as u64;
          for (i32 kk = 1; kk < jj; kk++) { v2 = v2 * 10 + ((buf[zi + kk] - '0') as u64); }
          v2 = v2 + 1;
        }
        if (r == fp10Convert2(v2, dc.p + n - jj)) { iRound = jj + 1; }
      } else if (iDP >= n || (buf[zi + 15] == '0' && buf[zi + 14] == '0' && buf[zi + 13] == '0')) {
        i32 jj = 13;
        while (buf[zi + jj - 1] == '0') { jj--; }
        u64 v2 = (buf[zi] - '0') as u64;
        for (i32 kk = 1; kk < jj; kk++) { v2 = v2 * 10 + ((buf[zi + kk] - '0') as u64); }
        if (r == fp10Convert2(v2, dc.p + n - jj)) { iRound = jj + 1; }
      }
    }
    n = iRound;
    if (buf[zi + iRound] >= '5') {
      i32 j = iRound - 1;
      while (true) {
        buf[zi + j] = buf[zi + j] + 1;
        if (buf[zi + j] <= '9') { break; }
        buf[zi + j] = '0';
        if (j == 0) {
          zi--;
          buf[zi] = '1';
          n++;
          iDP++;
          break;
        }
        j--;
      }
    }
  }
  while (n > 1 && buf[zi + n - 1] == '0') { n--; }
  u8[] out = u8[].filled(n, 0);
  out.copyFrom(buf, zi, 0, n);
  return FpDigits(string.fromBytes(out), iDP);
}

// Text to a double, as SQLite's sqlite3AtoF: up to about nineteen significant digits are kept exactly,
// and fp10Convert2 rounds the result, so a literal reads as the same double it does in SQLite. The text
// is assumed to be a number already (the callers have checked).
export f64 atof(string text) {
  u8[] z = text.toBytes();
  i32 i = 0;
  while (i < z.len() && (z[i] == ' ' || z[i] == '\t' || z[i] == '\n' || z[i] == '\r')) { i++; }
  bool neg = false;
  if (i < z.len() && (z[i] == '-' || z[i] == '+')) { neg = z[i] == '-'; i++; }
  u64 s = 0;
  i32 d = 0;
  bool full = false;
  while (i < z.len() && z[i] >= '0' && z[i] <= '9') {
    if (!full) {
      s = s * 10 + ((z[i] - '0') as u64);
      if (s >= (18446744073709551615 - 9) / 10) { full = true; }
    } else {
      d++;
    }
    i++;
  }
  if (i < z.len() && z[i] == '.') {
    i++;
    while (i < z.len() && z[i] >= '0' && z[i] <= '9') {
      if (s < (18446744073709551615 - 9) / 10) {
        s = s * 10 + ((z[i] - '0') as u64);
        d--;
      }
      i++;
    }
  }
  if (i < z.len() && (z[i] == 'e' || z[i] == 'E')) {
    i++;
    i32 esign = 1;
    if (i < z.len() && z[i] == '-') { esign = -1; i++; }
    else if (i < z.len() && z[i] == '+') { i++; }
    i32 exp = 0;
    while (i < z.len() && z[i] >= '0' && z[i] <= '9') {
      exp = exp < 10000 ? exp * 10 + (z[i] - '0') as i32 : 10000;
      i++;
    }
    d += esign * exp;
  }
  f64 r = s == 0 ? 0.0 : fp10Convert2(s, d);
  return neg ? -r : r;
}
