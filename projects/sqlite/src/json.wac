// JSON for SQLite's JSON functions: a tree that keeps numbers and strings as written, so text passes
// through json_set unchanged except for the part it sets, as SQLite's does.

import { Buf, Vec } from "core";
import { Value } from "./value.wac";
import { formatReal } from "./format.wac";
import { decimalI64, parseF64, hexDigit } from "./parser.wac";

export enum Json {
  JNull,
  JTrue,
  JFalse,
  JNum(string raw),
  JStr(string raw),                       // the text between the quotes, escapes as written
  JArr(Vec<Json> items),
  JObj(Vec<string> keys, Vec<Json> vals), // keys raw, as JStr
}

// SQLite reads JSON5 as well as JSON, as the JSON it means: comments, trailing commas, single-quoted
// strings, unquoted keys, and the looser numbers, which become canonical JSON (hex as decimal, .5 as
// 0.5, Infinity as 9e999). `json5` records that some was seen, which json_valid() distinguishes.
struct JsonParser {
  u8[] b;
  i32 i;
  bool ok;
  bool json5 = false;

  void ws(this) {
    while (this.i < this.b.len()) {
      u8 c = this.b[this.i];
      if (c == ' ' || c == '\t' || c == '\n' || c == '\r') { this.i++; continue; }
      i32 extra = this.json5Space();
      if (extra > 0) { this.i += extra; this.json5 = true; continue; }
      if (c == '/' && this.i + 1 < this.b.len() && this.b[this.i + 1] == '*') {
        i32 end = this.i + 2;
        while (end + 1 < this.b.len() && !(this.b[end] == '*' && this.b[end + 1] == '/')) { end++; }
        if (end + 1 >= this.b.len()) { return; }
        this.i = end + 2;
        this.json5 = true;
        continue;
      }
      if (c == '/' && this.i + 1 < this.b.len() && this.b[this.i + 1] == '/') {
        while (this.i < this.b.len() && this.b[this.i] != '\n') { this.i++; }
        this.json5 = true;
        continue;
      }
      return;
    }
  }

  // The length of JSON5's other whitespace at the cursor (vertical tab, form feed, the Unicode spaces),
  // or 0.
  i32 json5Space(this) {
    u8 c = this.b[this.i];
    if (c == 0x0b || c == 0x0c) { return 1; }
    i32 n = this.b.len() - this.i;
    if (c == 0xc2 && n > 1 && this.b[this.i + 1] == 0xa0) { return 2; }
    if (n < 3) { return 0; }
    u8 c1 = this.b[this.i + 1];
    u8 c2 = this.b[this.i + 2];
    if (c == 0xef && c1 == 0xbb && c2 == 0xbf) { return 3; }
    if (c == 0xe1 && c1 == 0x9a && c2 == 0x80) { return 3; }
    if (c == 0xe2 && c1 == 0x80 && ((c2 >= 0x80 && c2 <= 0x8a) || c2 == 0xa8 || c2 == 0xa9 || c2 == 0xaf)) { return 3; }
    if (c == 0xe2 && c1 == 0x81 && c2 == 0x9f) { return 3; }
    if (c == 0xe3 && c1 == 0x80 && c2 == 0x80) { return 3; }
    return 0;
  }

  // An unquoted JSON5 key: letters, digits, '_' and '$', and anything beyond ASCII.
  string? ident(this) {
    i32 s = this.i;
    while (this.i < this.b.len()) {
      u8 c = this.b[this.i];
      bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$' || c >= 0x80 ||
                (this.i > s && c >= '0' && c <= '9');
      if (!ok) { break; }
      this.i++;
    }
    if (this.i == s) { return null; }
    this.json5 = true;
    return string.fromBytes(sliceOf(this.b, s, this.i));
  }

  bool lit(this, string word) {
    u8[] w = word.toBytes();
    if (this.i + w.len() > this.b.len()) { return false; }
    for (i32 k = 0; k < w.len(); k++) { if (this.b[this.i + k] != w[k]) { return false; } }
    this.i += w.len();
    return true;
  }

  string? str(this) {
    // at the opening quote
    u8 q = this.b[this.i];
    if (q == '\'') { this.json5 = true; }
    this.i++;
    i32 s = this.i;
    // Plain JSON passes through as written; JSON5 forms are rewritten into `out` as JSON.
    Buf? out = null;
    while (this.i < this.b.len()) {
      u8 c = this.b[this.i];
      if (c == q) {
        string raw = out is null ? string.fromBytes(sliceOf(this.b, s, this.i)) : out!.toStr();
        this.i++;
        return raw;
      }
      if (c == '"' || (c == '\\' && this.i + 1 < this.b.len() && this.json5Escape(this.b[this.i + 1]))) {
        // From here on the text needs rewriting: a bare double quote inside single quotes, or a JSON5
        // escape.
        if (out is null) { out = Buf.create(); out!.pushBytes(this.b, s, this.i - s); }
        if (c == '"') { out!.pushStr("\\\""); this.i++; continue; }
        u8 e = this.b[this.i + 1];
        this.json5 = true;
        if (e == 'x') {
          if (this.i + 3 >= this.b.len() || !isHexByte(this.b[this.i + 2]) || !isHexByte(this.b[this.i + 3])) { return null; }
          out!.pushStr("\\u00");
          out!.pushBytes(this.b, this.i + 2, 2);
          this.i += 4;
        } else if (e == '0') { out!.pushStr("\\u0000"); this.i += 2; }
        else if (e == 'v') { out!.pushStr("\\u000b"); this.i += 2; }
        else if (e == '\'') { out!.pushStr("'"); this.i += 2; }
        else if (e == '\r') { this.i += this.i + 2 < this.b.len() && this.b[this.i + 2] == '\n' ? 3 : 2; }
        else if (e == '\n') { this.i += 2; }
        else { this.i += 4; }   // U+2028 or U+2029 after the backslash: a line continuation
        continue;
      }
      if (out is not null && c != '\\') { out!.push(c); this.i++; continue; }
      if (c < 0x20) { return null; }
      if (c == '\\') {
        i32 from = this.i;
        this.i++;
        if (this.i >= this.b.len()) { return null; }
        u8 e = this.b[this.i];
        if (e == 'u') {
          for (i32 k = 1; k <= 4; k++) {
            if (this.i + k >= this.b.len() || !isHexByte(this.b[this.i + k])) { return null; }
          }
          this.i += 4;
        } else if (e != '"' && e != '\\' && e != '/' && e != 'b' && e != 'f' && e != 'n' && e != 'r' && e != 't') {
          return null;
        }
        if (out is not null) { out!.pushBytes(this.b, from, this.i + 1 - from); }
      }
      this.i++;
    }
    return null;
  }

  // Whether `\` then `e` is an escape JSON5 has and JSON does not.
  bool json5Escape(this, u8 e) {
    if (e == 'x' || e == '0' || e == 'v' || e == '\'' || e == '\r' || e == '\n') { return true; }
    // A backslash before U+2028 or U+2029 continues the line.
    return e == 0xe2 && this.i + 3 < this.b.len() && this.b[this.i + 2] == 0x80 &&
           (this.b[this.i + 3] == 0xa8 || this.b[this.i + 3] == 0xa9);
  }

  Json? value(this, i32 depth) {
    if (depth > 1000) { return null; }
    this.ws();
    if (this.i >= this.b.len()) { return null; }
    u8 c = this.b[this.i];
    if (c == '{') {
      this.i++;
      Vec<string> keys;
      Vec<Json> vals;
      this.ws();
      if (this.i < this.b.len() && this.b[this.i] == '}') { this.i++; return Json.JObj(keys, vals); }
      while (true) {
        this.ws();
        if (this.i >= this.b.len()) { return null; }
        u8 kc = this.b[this.i];
        string? k = kc == '"' || kc == '\'' ? this.str() : this.ident();
        if (k is null) { return null; }
        this.ws();
        if (this.i >= this.b.len() || this.b[this.i] != ':') { return null; }
        this.i++;
        Json? v = this.value(depth + 1);
        if (v is null) { return null; }
        keys.push(k!);
        vals.push(v!);
        this.ws();
        if (this.i < this.b.len() && this.b[this.i] == ',') {
          this.i++;
          // JSON5: one trailing comma.
          this.ws();
          if (this.i < this.b.len() && this.b[this.i] == '}') { this.i++; this.json5 = true; return Json.JObj(keys, vals); }
          continue;
        }
        if (this.i < this.b.len() && this.b[this.i] == '}') { this.i++; return Json.JObj(keys, vals); }
        return null;
      }
    }
    if (c == '[') {
      this.i++;
      Vec<Json> items;
      this.ws();
      if (this.i < this.b.len() && this.b[this.i] == ']') { this.i++; return Json.JArr(items); }
      while (true) {
        Json? v = this.value(depth + 1);
        if (v is null) { return null; }
        items.push(v!);
        this.ws();
        if (this.i < this.b.len() && this.b[this.i] == ',') {
          this.i++;
          this.ws();
          if (this.i < this.b.len() && this.b[this.i] == ']') { this.i++; this.json5 = true; return Json.JArr(items); }
          continue;
        }
        if (this.i < this.b.len() && this.b[this.i] == ']') { this.i++; return Json.JArr(items); }
        return null;
      }
    }
    if (c == '"' || c == '\'') {
      string? s = this.str();
      return s is null ? null : Json.JStr(s!);
    }
    if (this.lit("null")) { return Json.JNull; }
    if (this.lit("true")) { return Json.JTrue; }
    if (this.lit("false")) { return Json.JFalse; }
    i32 s = this.i;
    bool neg = false;
    if (this.i < this.b.len() && (this.b[this.i] == '-' || this.b[this.i] == '+')) {
      neg = this.b[this.i] == '-';
      if (!neg) { this.json5 = true; }
      this.i++;
    }
    string sign = neg ? "-" : "";
    // JSON5's other numbers, written back as JSON.
    if (this.lit("Infinity")) { this.json5 = true; return Json.JNum(sign + "9e999"); }
    if (this.lit("NaN")) { this.json5 = true; return Json.JNull; }
    if (this.i + 1 < this.b.len() && this.b[this.i] == '0' && (this.b[this.i + 1] == 'x' || this.b[this.i + 1] == 'X')) {
      this.i += 2;
      i32 h0 = this.i;
      i64 v = 0;
      bool over = false;
      while (this.i < this.b.len() && isHexByte(this.b[this.i])) {
        u8 hc = this.b[this.i];
        i64 digit = hc <= '9' ? (hc - '0') as i64 : ((hc | 0x20) - 'a') as i64 + 10;
        if (v > 0x7ffffffffffffff) { over = true; }
        v = v * 16 + digit;
        this.i++;
      }
      if (this.i == h0) { return null; }
      this.json5 = true;
      return Json.JNum(over ? sign + "9.0e999" : sign + "\{v}");
    }
    if (this.i < this.b.len() && this.b[this.i] == '.') {
      // .5
      i32 f0 = this.i + 1;
      i32 f = f0;
      while (f < this.b.len() && this.b[f] >= '0' && this.b[f] <= '9') { f++; }
      if (f == f0) { return null; }
      this.json5 = true;
      this.i = f;
      string frac = string.fromBytes(sliceOf(this.b, f0 - 1, f));
      return Json.JNum(sign + "0" + frac + this.exponent());
    }
    i32 d = this.i;
    while (this.i < this.b.len() && this.b[this.i] >= '0' && this.b[this.i] <= '9') { this.i++; }
    if (this.i == d) { return null; }
    if (this.b[d] == '0' && this.i - d > 1) { return null; }
    if (this.i < this.b.len() && this.b[this.i] == '.') {
      this.i++;
      i32 f = this.i;
      while (this.i < this.b.len() && this.b[this.i] >= '0' && this.b[this.i] <= '9') { this.i++; }
      if (this.i == f) {
        // 5. is 5.0
        this.json5 = true;
        string whole = string.fromBytes(sliceOf(this.b, d, this.i));
        return Json.JNum(sign + whole + "0" + this.exponent());
      }
    }
    string mantissa = string.fromBytes(sliceOf(this.b, d, this.i));
    return Json.JNum(sign + mantissa + this.exponent());
  }

  // A number's exponent, as written, or "" (null-free: a malformed one leaves the cursor before it).
  string exponent(this) {
    if (this.i < this.b.len() && (this.b[this.i] == 'e' || this.b[this.i] == 'E')) {
      i32 s = this.i;
      this.i++;
      if (this.i < this.b.len() && (this.b[this.i] == '+' || this.b[this.i] == '-')) { this.i++; }
      i32 f = this.i;
      while (this.i < this.b.len() && this.b[this.i] >= '0' && this.b[this.i] <= '9') { this.i++; }
      if (this.i == f) { this.i = s; return ""; }
      return string.fromBytes(sliceOf(this.b, s, this.i));
    }
    return "";
  }
}

bool isHexByte(u8 c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }

u8[] sliceOf(const u8[] b, i32 s, i32 e) {
  u8[] out = u8[].filled(e - s, 0);
  out.copyFrom(b, s, 0, e - s);
  return out;
}

export Json? parseJson(string text) {
  JsonParser p = JsonParser(text.toBytes(), 0, true, false);
  Json? v = p.value(0);
  if (v is null) { return null; }
  p.ws();
  if (p.i != p.b.len()) { return null; }
  return v;
}

export void writeJson(Buf out, const Json j) {
  match (j) {
    JNull: { out.pushStr("null"); }
    JTrue: { out.pushStr("true"); }
    JFalse: { out.pushStr("false"); }
    JNum(raw): { out.pushStr(raw); }
    JStr(raw): { out.pushStr("\""); out.pushStr(raw); out.pushStr("\""); }
    JArr(items): {
      out.pushStr("[");
      for (i32 i = 0; i < items.len(); i++) {
        if (i > 0) { out.pushStr(","); }
        writeJson(out, items.get(i));
      }
      out.pushStr("]");
    }
    JObj(keys, vals): {
      out.pushStr("{");
      for (i32 i = 0; i < keys.len(); i++) {
        if (i > 0) { out.pushStr(","); }
        out.pushStr("\"");
        out.pushStr(keys.get(i));
        out.pushStr("\":");
        writeJson(out, vals.get(i));
      }
      out.pushStr("}");
    }
  }
}

export string jsonText(const Json j) {
  Buf out = Buf.create();
  writeJson(out, j);
  return out.toStr();
}

// A JSON string's raw text decoded to the text it means.
export string unescape(string raw) {
  if (raw.indexOf("\\") < 0) { return raw; }
  u8[] b = raw.toBytes();
  Buf out = Buf.create();
  i32 i = 0;
  while (i < b.len()) {
    if (b[i] != '\\') { out.push(b[i]); i++; continue; }
    u8 e = b[i + 1];
    i += 2;
    if (e == 'n') { out.push('\n'); }
    else if (e == 't') { out.push('\t'); }
    else if (e == 'r') { out.push('\r'); }
    else if (e == 'b') { out.push(8); }
    else if (e == 'f') { out.push(12); }
    else if (e == 'u') {
      i32 cp = hex4(b, i);
      i += 4;
      if (cp >= 0xD800 && cp < 0xDC00 && i + 6 <= b.len() && b[i] == '\\' && b[i + 1] == 'u') {
        i32 lo = hex4(b, i + 2);
        if (lo >= 0xDC00 && lo < 0xE000) {
          cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
          i += 6;
        }
      }
      if (cp >= 0xD800 && cp < 0xE000) { cp = 0xFFFD; }
      out.pushCodepoint(cp);
    }
    else { out.push(e); }
  }
  return out.toStr();
}

i32 hex4(const u8[] b, i32 at) {
  i32 v = 0;
  for (i32 k = 0; k < 4; k++) { v = (v << 4) | hexDigit(b[at + k] as i32); }
  return v;
}

static string HEXL = "0123456789abcdef";

// Text as a JSON string's raw contents.
export string escape(string s) {
  u8[] b = s.toBytes();
  Buf out = Buf.create();
  for (i32 i = 0; i < b.len(); i++) {
    u8 c = b[i];
    if (c == '"') { out.pushStr("\\\""); }
    else if (c == '\\') { out.pushStr("\\\\"); }
    else if (c == '\n') { out.pushStr("\\n"); }
    else if (c == '\r') { out.pushStr("\\r"); }
    else if (c == '\t') { out.pushStr("\\t"); }
    else if (c == 8) { out.pushStr("\\b"); }
    else if (c == 12) { out.pushStr("\\f"); }
    else if (c < 0x20) {
      out.pushStr("\\u00");
      out.pushStr(HEXL.slice((c >> 4) as i32, ((c >> 4) as i32) + 1));
      out.pushStr(HEXL.slice((c & 15) as i32, ((c & 15) as i32) + 1));
    }
    else { out.push(c); }
  }
  return out.toStr();
}

// A JSON value as the SQL value json_extract answers: scalars as themselves, containers as JSON text.
export Value sqlOf(const Json j) {
  match (j) {
    JNull: { return Value.Null; }
    JTrue: { return Value.Int(1); }
    JFalse: { return Value.Int(0); }
    JNum(raw): { return numValue(raw); }
    JStr(raw): { return Value.Text(unescape(raw)); }
    default: { return Value.Text(jsonText(j)); }
  }
}

export Value numValue(string raw) {
  bool integral = raw.indexOf(".") < 0 && raw.indexOf("e") < 0 && raw.indexOf("E") < 0;
  if (integral) {
    bool neg = raw.slice(0, 1) == "-";
    i64? v = decimalI64(neg ? raw.slice(1, raw.len()) : raw);
    if (v is not null) { return Value.Int(neg ? 0 - v! : v!); }
  }
  return Value.Real(parseF64(raw));
}

// An SQL value as JSON: text becomes a string unless the caller knows it is JSON already.
export Json jsonOf(const Value v) {
  match (v) {
    Null: { return Json.JNull; }
    Int(i): { return Json.JNum("\{i}"); }
    Real(r): { return Json.JNum(r != r || r == 1.0 / 0.0 || r == -1.0 / 0.0 ? "null" : realJson(r)); }
    Text(s): { return Json.JStr(escape(s)); }
    Blob: { return Json.JNull; }
  }
}

string realJson(f64 r) {
  string s = formatReal(r);
  return s;
}

// One step of a path: a member name, or an array position counted from the start or (fromEnd) the end.
export struct Step {
  string? key;
  i32 index;
  bool fromEnd;
}

// "$", ".key", ".\"key\"", "[N]", "[#-N]", "[#]". Null for a malformed path.
export Step[]? parsePath(string path) {
  u8[] b = path.toBytes();
  if (b.len() == 0 || b[0] != '$') { return null; }
  Vec<Step> out;
  i32 i = 1;
  while (i < b.len()) {
    if (b[i] == '.') {
      i++;
      if (i < b.len() && b[i] == '"') {
        i32 s = i + 1;
        i32 e = s;
        while (e < b.len() && b[e] != '"') { e++; }
        if (e >= b.len()) { return null; }
        out.push(Step(string.fromBytes(sliceOf(b, s, e)), 0, false));
        i = e + 1;
      } else {
        i32 s = i;
        while (i < b.len() && b[i] != '.' && b[i] != '[') { i++; }
        if (i == s) { return null; }
        out.push(Step(string.fromBytes(sliceOf(b, s, i)), 0, false));
      }
    } else if (b[i] == '[') {
      i++;
      bool fromEnd = false;
      if (i < b.len() && b[i] == '#') {
        fromEnd = true;
        i++;
        if (i < b.len() && b[i] == '-') { i++; }
        else if (i < b.len() && b[i] == ']') { out.push(Step(null, 0, true)); i++; continue; }
        else { return null; }
      }
      i32 n = 0;
      i32 s = i;
      while (i < b.len() && b[i] >= '0' && b[i] <= '9') { n = n * 10 + (b[i] - '0') as i32; i++; }
      if (i == s || i >= b.len() || b[i] != ']') { return null; }
      i++;
      out.push(Step(null, n, fromEnd));
    } else {
      return null;
    }
  }
  return out.toArray();
}

i32 memberAt(const Vec<string> keys, string key) {
  for (i32 i = 0; i < keys.len(); i++) { if (unescape(keys.get(i)) == key) { return i; } }
  return -1;
}

// The value at a path, or null when there is none.
export Json? lookup(Json root, const Step[] path) {
  Json cur = root;
  for (i32 k = 0; k < path.len(); k++) {
    const Step s = path[k];
    Json next = cur;
    match (cur) {
      JObj(keys, vals): {
        if (s.key is null) { return null; }
        i32 at = memberAt(keys, s.key!);
        if (at < 0) { return null; }
        next = vals.get(at);
      }
      JArr(items): {
        if (s.key is not null) { return null; }
        i32 at = s.fromEnd ? items.len() - s.index : s.index;
        if (at < 0 || at >= items.len()) { return null; }
        next = items.get(at);
      }
      default: { return null; }
    }
    cur = next;
  }
  return cur;
}

// Sets the value at a path, creating the last member or appending at the end of an array when
// `create`, replacing only when `replace`. Answers the new root.
export Json setPath(Json root, const Step[] path, Json v, bool create, bool replace) {
  if (path.len() == 0) { return replace ? v : root; }
  Json cur = root;
  for (i32 k = 0; k < path.len(); k++) {
    const Step s = path[k];
    bool last = k == path.len() - 1;
    Json next = cur;
    match (cur) {
      JObj(keys, vals): {
        if (s.key is null) { return root; }
        i32 at = memberAt(keys, s.key!);
        if (at < 0) {
          if (!create) { return root; }
          // What is missing is made whole, objects for names and arrays for positions, or not at all.
          Json? fresh = buildPath(path, k + 1, v);
          if (fresh is null) { return root; }
          keys.push(escape(s.key!));
          vals.push(fresh!);
          return root;
        } else {
          if (last) {
            if (replace) { vals.set(at, v); }
            return root;
          }
          next = vals.get(at);
        }
      }
      JArr(items): {
        if (s.key is not null) { return root; }
        i32 at = s.fromEnd ? items.len() - s.index : s.index;
        if (at == items.len()) {
          // Appending, with the rest of the path made beneath the new element.
          if (create) {
            Json? fresh = buildPath(path, k + 1, v);
            if (fresh is not null) { items.push(fresh!); }
          }
          return root;
        }
        if (at < 0 || at >= items.len()) { return root; }
        if (last) {
          if (replace) { items.set(at, v); }
          return root;
        }
        next = items.get(at);
      }
      default: { return root; }
    }
    cur = next;
  }
  return root;
}

// The value a path's steps from `from` on would lead to, made fresh: an object for each name, an array
// for each position, which must be the first (an empty array's end). Null when a step cannot be made.
Json? buildPath(const Step[] path, i32 from, Json v) {
  if (from == path.len()) { return v; }
  const Step s = path[from];
  Json? inner = buildPath(path, from + 1, v);
  if (inner is null) { return null; }
  if (s.key is not null) {
    Vec<string> keys;
    Vec<Json> vals;
    keys.push(escape(s.key!));
    vals.push(inner!);
    return Json.JObj(keys, vals);
  }
  if (s.index != 0) { return null; }
  Vec<Json> items;
  items.push(inner!);
  return Json.JArr(items);
}

// Removes the value at a path.
export void removePath(Json root, const Step[] path) {
  if (path.len() == 0) { return; }
  Json cur = root;
  for (i32 k = 0; k < path.len(); k++) {
    const Step s = path[k];
    bool last = k == path.len() - 1;
    Json next = cur;
    match (cur) {
      JObj(keys, vals): {
        if (s.key is null) { return; }
        i32 at = memberAt(keys, s.key!);
        if (at < 0) { return; }
        if (last) { keys.remove(at); vals.remove(at); return; }
        next = vals.get(at);
      }
      JArr(items): {
        if (s.key is not null) { return; }
        i32 at = s.fromEnd ? items.len() - s.index : s.index;
        if (at < 0 || at >= items.len()) { return; }
        if (last) { items.remove(at); return; }
        next = items.get(at);
      }
      default: { return; }
    }
    cur = next;
  }
}

export string jsonType(const Json j) {
  return match (j) {
    JNull: "null", JTrue: "true", JFalse: "false",
    JNum(raw): raw.indexOf(".") < 0 && raw.indexOf("e") < 0 && raw.indexOf("E") < 0 ? "integer" : "real",
    JStr: "text", JArr: "array", JObj: "object",
  };
}

// ── reading a value out of JSON text without building a tree ───────────────

i32 skipWs(const u8[] b, i32 i) {
  while (i < b.len() && (b[i] == ' ' || b[i] == '\t' || b[i] == '\n' || b[i] == '\r')) { i++; }
  return i;
}

// Past a string starting at its opening quote, or -1 when it is malformed.
i32 skipString(const u8[] b, i32 i) {
  i++;
  while (i < b.len()) {
    u8 c = b[i];
    if (c == '"') { return i + 1; }
    if (c < 0x20) { return -1; }
    if (c == '\\') {
      if (i + 1 >= b.len()) { return -1; }
      u8 e = b[i + 1];
      if (e == 'u') {
        for (i32 k = 2; k <= 5; k++) { if (i + k >= b.len() || !isHexByte(b[i + k])) { return -1; } }
        i += 6;
        continue;
      }
      if (e != '"' && e != '\\' && e != '/' && e != 'b' && e != 'f' && e != 'n' && e != 'r' && e != 't') { return -1; }
      i += 2;
      continue;
    }
    i++;
  }
  return -1;
}

bool isDigitByte(u8 c) { return c >= '0' && c <= '9'; }

i32 skipNumber(const u8[] b, i32 i) {
  if (i < b.len() && b[i] == '-') { i++; }
  i32 d = i;
  while (i < b.len() && isDigitByte(b[i])) { i++; }
  if (i == d || (b[d] == '0' && i - d > 1)) { return -1; }
  if (i < b.len() && b[i] == '.') {
    i++;
    i32 f = i;
    while (i < b.len() && isDigitByte(b[i])) { i++; }
    if (i == f) { return -1; }
  }
  if (i < b.len() && (b[i] == 'e' || b[i] == 'E')) {
    i++;
    if (i < b.len() && (b[i] == '+' || b[i] == '-')) { i++; }
    i32 f = i;
    while (i < b.len() && isDigitByte(b[i])) { i++; }
    if (i == f) { return -1; }
  }
  return i;
}

bool word(const u8[] b, i32 i, string w) {
  u8[] x = w.toBytes();
  if (i + x.len() > b.len()) { return false; }
  for (i32 k = 0; k < x.len(); k++) { if (b[i + k] != x[k]) { return false; } }
  return true;
}

// Past one value starting at `i`, checking it is well formed, or -1.
i32 skipValue(const u8[] b, i32 i, i32 depth) {
  if (depth > 1000 || i >= b.len()) { return -1; }
  u8 c = b[i];
  if (c == '"') { return skipString(b, i); }
  if (c == '{' || c == '[') {
    bool obj = c == '{';
    i = skipWs(b, i + 1);
    if (i < b.len() && b[i] == (obj ? '}' : ']')) { return i + 1; }
    while (true) {
      if (obj) {
        if (i >= b.len() || b[i] != '"') { return -1; }
        i = skipString(b, i);
        if (i < 0) { return -1; }
        i = skipWs(b, i);
        if (i >= b.len() || b[i] != ':') { return -1; }
        i = skipWs(b, i + 1);
      }
      i = skipValue(b, i, depth + 1);
      if (i < 0) { return -1; }
      i = skipWs(b, i);
      if (i >= b.len()) { return -1; }
      if (b[i] == ',') { i = skipWs(b, i + 1); continue; }
      if (b[i] == (obj ? '}' : ']')) { return i + 1; }
      return -1;
    }
  }
  if (c == 't') { return word(b, i, "true") ? i + 4 : -1; }
  if (c == 'f') { return word(b, i, "false") ? i + 5 : -1; }
  if (c == 'n') { return word(b, i, "null") ? i + 4 : -1; }
  return skipNumber(b, i);
}

bool rawKeyIs(const u8[] b, i32 start, i32 end, const u8[] key) {
  if (end - start != key.len()) { return false; }
  for (i32 k = 0; k < key.len(); k++) { if (b[start + k] != key[k]) { return false; } }
  return true;
}

// json_extract with one path, reading the text in place. Null when this cannot answer (malformed text,
// escaped keys, counting from the end), and the caller then takes the general road, which also
// produces the right error.
export Value? extractFast(string text, const Step[] path) {
  u8[] b = text.toBytes();
  i32 start = skipWs(b, 0);
  i32 end = skipValue(b, start, 0);
  if (end < 0 || skipWs(b, end) != b.len()) { return null; }
  i32 i = start;
  for (i32 k = 0; k < path.len(); k++) {
    const Step s = path[k];
    if (s.key is not null) {
      if (b[i] != '{') { return Value.Null; }
      u8[] key = s.key!.toBytes();
      i = skipWs(b, i + 1);
      bool found = false;
      while (b[i] != '}') {
        i32 ks = i;
        i32 ke = skipString(b, i);
        for (i32 q = ks + 1; q < ke - 1; q++) { if (b[q] == '\\') { return null; } }
        i = skipWs(b, skipWs(b, ke) + 1);
        if (rawKeyIs(b, ks + 1, ke - 1, key)) { found = true; break; }
        i = skipWs(b, skipValue(b, i, 0));
        if (b[i] == ',') { i = skipWs(b, i + 1); }
      }
      if (!found) { return Value.Null; }
    } else {
      if (s.fromEnd) { return null; }
      if (b[i] != '[') { return Value.Null; }
      i = skipWs(b, i + 1);
      i32 n = 0;
      bool found = false;
      while (b[i] != ']') {
        if (n == s.index) { found = true; break; }
        i = skipWs(b, skipValue(b, i, 0));
        if (b[i] == ',') { i = skipWs(b, i + 1); }
        n++;
      }
      if (!found) { return Value.Null; }
    }
  }
  u8 c = b[i];
  i32 e = skipValue(b, i, 0);
  if (c == '"') {
    string raw = string.fromBytes(sliceOf(b, i + 1, e - 1));
    return Value.Text(unescape(raw));
  }
  if (c == 't') { return Value.Int(1); }
  if (c == 'f') { return Value.Int(0); }
  if (c == 'n') { return Value.Null; }
  if (c == '{' || c == '[') {
    Json? j = parseJson(string.fromBytes(sliceOf(b, i, e)));
    return j is null ? null : Value.Text(jsonText(j!));
  }
  return numValue(string.fromBytes(sliceOf(b, i, e)));
}

// ── JSONB, SQLite's binary JSON ─────────────────────────────────────────────
//
// Each element is a header and a payload. The header's low four bits are the type; its high four the
// payload's size when under 12, or (12, 13, 14, 15) that the size follows in 1, 2, 4 or 8 bytes. Numbers
// and strings keep their JSON text as the payload; arrays hold their elements, objects their labels and
// values in turn.

static i32 JB_NULL = 0;
static i32 JB_TRUE = 1;
static i32 JB_FALSE = 2;
static i32 JB_INT = 3;
static i32 JB_INT5 = 4;
static i32 JB_FLOAT = 5;
static i32 JB_FLOAT5 = 6;
static i32 JB_TEXT = 7;
static i32 JB_TEXTJ = 8;
static i32 JB_TEXT5 = 9;
static i32 JB_TEXTRAW = 10;
static i32 JB_ARRAY = 11;
static i32 JB_OBJECT = 12;

void jbHeader(Buf out, i32 type, i32 size) {
  if (size <= 11) { out.push(((size << 4) | type) as@ u8); return; }
  if (size <= 0xff) { out.push((0xc0 | type) as@ u8); out.push(size as@ u8); return; }
  if (size <= 0xffff) {
    out.push((0xd0 | type) as@ u8);
    out.push((size >> 8) as@ u8);
    out.push((size & 0xff) as@ u8);
    return;
  }
  out.push((0xe0 | type) as@ u8);
  out.push((size >> 24) as@ u8);
  out.push(((size >> 16) & 0xff) as@ u8);
  out.push(((size >> 8) & 0xff) as@ u8);
  out.push((size & 0xff) as@ u8);
}

// A string's JSONB type: TEXT when its text needs no escapes, TEXTJ when it holds some.
i32 textType(string raw) { return raw.indexOf("\\") >= 0 ? JB_TEXTJ : JB_TEXT; }

export u8[] toJsonb(const Json j) {
  Buf out = Buf.create();
  jbWrite(out, j);
  return out.take();
}

void jbWrite(Buf out, const Json j) {
  match (j) {
    JNull: { out.push(JB_NULL as@ u8); }
    JTrue: { out.push(JB_TRUE as@ u8); }
    JFalse: { out.push(JB_FALSE as@ u8); }
    JNum(raw): {
      u8[] b = raw.toBytes();
      bool integral = raw.indexOf(".") < 0 && raw.indexOf("e") < 0 && raw.indexOf("E") < 0;
      jbHeader(out, integral ? JB_INT : JB_FLOAT, b.len());
      out.pushAll(b);
    }
    JStr(raw): {
      u8[] b = raw.toBytes();
      jbHeader(out, textType(raw), b.len());
      out.pushAll(b);
    }
    JArr(items): {
      Buf inner = Buf.create();
      for (i32 i = 0; i < items.len(); i++) { jbWrite(inner, items.get(i)); }
      u8[] body = inner.take();
      jbHeader(out, JB_ARRAY, body.len());
      out.pushAll(body);
    }
    JObj(keys, vals): {
      Buf inner = Buf.create();
      for (i32 i = 0; i < keys.len(); i++) {
        u8[] k = keys.get(i).toBytes();
        jbHeader(inner, textType(keys.get(i)), k.len());
        inner.pushAll(k);
        jbWrite(inner, vals.get(i));
      }
      u8[] body = inner.take();
      jbHeader(out, JB_OBJECT, body.len());
      out.pushAll(body);
    }
  }
}

// A JSONB blob as a value, or null when it is not one: every element's header and size must hold, and
// the elements must fill the blob exactly.
export Json? fromJsonb(u8[] b) {
  if (b.len() == 0) { return null; }
  JbReader r = JbReader(b, 0);
  Json? v = r.element(b.len(), 0);
  if (v is null || r.at != b.len()) { return null; }
  return v;
}

struct JbReader {
  u8[] b;
  i32 at;

  Json? element(this, i32 end, i32 depth) {
    if (depth > 1000 || this.at >= end) { return null; }
    i32 h = this.b[this.at] as i32;
    i32 type = h & 0x0f;
    i32 sz = h >> 4;
    i32 p = this.at + 1;
    if (sz >= 12) {
      i32 n = sz == 12 ? 1 : (sz == 13 ? 2 : (sz == 14 ? 4 : 8));
      if (p + n > end || n == 8) { return null; }
      sz = 0;
      for (i32 k = 0; k < n; k++) { sz = (sz << 8) | (this.b[p + k] as i32); }
      p += n;
    }
    if (sz < 0 || p + sz > end) { return null; }
    i32 stop = p + sz;
    this.at = stop;
    if (type <= JB_FALSE) {
      if (sz != 0) { return null; }
      return type == JB_NULL ? Json.JNull : (type == JB_TRUE ? Json.JTrue : Json.JFalse);
    }
    string text = string.fromBytes(sliceOf(this.b, p, stop));
    if (type == JB_INT || type == JB_FLOAT) { return sz == 0 ? null : Json.JNum(text); }
    if (type == JB_INT5 || type == JB_FLOAT5) { return json5Number(text); }
    if (type == JB_TEXT || type == JB_TEXTJ || type == JB_TEXT5) { return Json.JStr(text); }
    if (type == JB_TEXTRAW) { return Json.JStr(escape(text)); }
    if (type == JB_ARRAY) {
      Vec<Json> items;
      this.at = p;
      while (this.at < stop) {
        Json? v = this.element(stop, depth + 1);
        if (v is null) { return null; }
        items.push(v!);
      }
      return Json.JArr(items);
    }
    if (type == JB_OBJECT) {
      Vec<string> keys;
      Vec<Json> vals;
      this.at = p;
      while (this.at < stop) {
        Json? k = this.element(stop, depth + 1);
        if (k is null) { return null; }
        match (k!) { JStr(raw): { keys.push(raw); } default: { return null; } }
        Json? v = this.element(stop, depth + 1);
        if (v is null) { return null; }
        vals.push(v!);
      }
      return Json.JObj(keys, vals);
    }
    return null;
  }
}

// A JSON5 number (hexadecimal, a leading '+' or '.', a trailing '.', Infinity) as plain JSON.
Json? json5Number(string text) {
  string t = text;
  bool neg = false;
  if (t.slice(0, 1) == "+") { t = t.slice(1, t.len()); }
  else if (t.slice(0, 1) == "-") { neg = true; t = t.slice(1, t.len()); }
  string sign = neg ? "-" : "";
  string low = t;
  if (low == "Infinity" || low == "inf") { return Json.JNum(sign + "9.0e999"); }
  if (low.slice(0, 2) == "0x" || low.slice(0, 2) == "0X") {
    i64 v = 0;
    u8[] d = low.slice(2, low.len()).toBytes();
    for (u8 c in d) {
      i32 h = c >= '0' && c <= '9' ? (c - '0') as i32 : (c >= 'a' && c <= 'f' ? (c - 'a') as i32 + 10 : (c - 'A') as i32 + 10);
      v = v * 16 + (h as i64);
    }
    return Json.JNum(sign + "\{v}");
  }
  if (t.slice(0, 1) == ".") { t = "0" + t; }
  if (t.slice(t.len() - 1, t.len()) == ".") { t = t + "0"; }
  return Json.JNum(sign + t);
}

// 0 when the text is not JSON at all, 1 when it is JSON, 2 when it is only JSON5.
export i32 jsonValidity(string text) {
  JsonParser p = JsonParser(text.toBytes(), 0, true, false);
  Json? v = p.value(0);
  if (v is null) { return 0; }
  p.ws();
  if (p.i != p.b.len()) { return 0; }
  return p.json5 ? 2 : 1;
}

// Where JSON text first goes wrong, counted in characters from 1; 0 when it is well-formed.
export i64 jsonErrorPosition(string text) {
  JsonParser p = JsonParser(text.toBytes(), 0, true, false);
  Json? v = p.value(0);
  if (v is not null) {
    p.ws();
    if (p.i == p.b.len()) { return 0; }
  }
  i64 chars = 0;
  for (i32 k = 0; k < p.i && k < p.b.len(); k++) { if ((p.b[k] & 0xc0) != 0x80) { chars++; } }
  return chars + 1;
}

// RFC 7396: `patch` merged into `target`. A patch that is not an object replaces the target; a member
// set to null is removed; other members are merged in turn, new ones added at the end.
export Json mergePatch(const Json target, const Json patch) {
  match (patch) {
    JObj(pk, pv): {
      Vec<string> keys;
      Vec<Json> vals;
      match (target) {
        JObj(tk, tv): { for (i32 i = 0; i < tk.len(); i++) { keys.push(tk.get(i)); vals.push(tv.get(i)); } }
        default: {}
      }
      for (i32 i = 0; i < pk.len(); i++) {
        i32 at = -1;
        for (i32 k = 0; k < keys.len(); k++) { if (keys.get(k) == pk.get(i)) { at = k; break; } }
        bool isNullMember = match (pv.get(i)) { JNull: true, default: false };
        if (isNullMember) {
          if (at >= 0) { keys.remove(at); vals.remove(at); }
          continue;
        }
        if (at >= 0) { vals.set(at, mergePatch(vals.get(at), pv.get(i))); }
        else { keys.push(pk.get(i)); vals.push(mergePatch(Json.JNull, pv.get(i))); }
      }
      return Json.JObj(keys, vals);
    }
    default: { return patch as Json; }
  }
}
