// Trigonometric and hyperbolic functions, which wac's core does not have: fdlibm's kernels (Sun
// Microsystems, freely redistributable), the same algorithms most C libraries use, so results agree with
// SQLite's to the last bit or two.

import { math } from "core";

static f64 PIO2_1 = 1.57079632673412561417e+00;
static f64 PIO2_1T = 6.07710050650619224932e-11;
static f64 PIO2_2 = 6.07710050630396597660e-11;
static f64 PIO2_2T = 2.02226624879595063154e-21;
static f64 INVPIO2 = 6.36619772367581382433e-01;

f64 kernelSin(f64 x, f64 y, bool iy) {
  f64 z = x * x;
  f64 v = z * x;
  f64 r = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * (2.75573137070700676789e-06 +
          z * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)));
  if (!iy) { return x + v * (-1.66666666666666324348e-01 + z * r); }
  return x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01);
}

f64 kernelCos(f64 x, f64 y) {
  f64 z = x * x;
  f64 r = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * (2.48015872894767294178e-05 +
          z * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11)))));
  f64 hz = 0.5 * z;
  f64 w = 1.0 - hz;
  return w + (((1.0 - w) - hz) + (z * r - x * y));
}

// x reduced by multiples of pi/2: the remainder as a double-double, and the quadrant.
export struct Reduced {
  f64 y0;
  f64 y1;
  i32 n;
}

Reduced reduce(f64 x) {
  // The nearest multiple, ties away from zero, as fdlibm's (int)(x*invpio2+half).
  f64 q = x * INVPIO2;
  f64 k = q < 0.0 ? (q - 0.5).trunc() : (q + 0.5).trunc();
  f64 r = x - k * PIO2_1;
  f64 w = k * PIO2_1T;
  // A second step keeps precision when the first cancelled a great deal.
  f64 y0 = r - w;
  f64 t = r;
  w = k * PIO2_2;
  r = t - w;
  w = k * PIO2_2T - ((t - r) - w);
  y0 = r - w;
  f64 y1 = (r - y0) - w;
  i32 n = k as~ i32;
  return Reduced(y0, y1, n & 3);
}

// 2/pi's binary digits after the point, 64 to a word: enough for the largest double. Computed exactly
// (Machin's formula in integers) rather than copied.
static u64[] TWO_OVER_PI = [
  0xa2f9836e4e441529, 0xfc2757d1f534ddc0, 0xdb6295993c439041, 0xfe5163abdebbc561,
  0xb7246e3a424dd2e0, 0x06492eea09d1921c, 0xfe1deb1cb129a73e, 0xe88235f52ebb4484,
  0xe99c7026b45f7e41, 0x3991d639835339f4, 0x9c845f8bbdf9283b, 0x1ff897ffde05980f,
  0xef2f118b5a0a6d1f, 0x6d367ecf27cb09b7, 0x4f463f669e5fea2d, 0x7527bac7ebe5f17b,
  0x3d0739f78a5292ea, 0x6bfb5fb11f8d5d08, 0x56033046fc7b6bab, 0xf0cfbc209af4361d,
  0xa9e391615ee61b08,
];

export u64 bitOf(i32 i) {
  if (i < 1) { return 0; }
  i32 w = (i - 1) / 64;
  if (w >= TWO_OVER_PI.len()) { return 0; }
  return (TWO_OVER_PI[w] >> (63 - (i - 1) % 64)) & 1;
}

u64 hi64(u64 a, u64 b, u64[] lo) {
  u64 a0 = a & 0xFFFFFFFF;
  u64 a1 = a >> 32;
  u64 b0 = b & 0xFFFFFFFF;
  u64 b1 = b >> 32;
  u64 a0b0 = a0 * b0;
  u64 a1b1 = a1 * b1;
  u64 a0b1 = a0 * b1;
  u64 a1b0 = a1 * b0;
  u64 t = (a0b0 >> 32) + (a0b1 & 0xFFFFFFFF) + (a1b0 & 0xFFFFFFFF);
  lo[0] = (a0b0 & 0xFFFFFFFF) | (t << 32);
  return a1b1 + (a0b1 >> 32) + (a1b0 >> 32) + (t >> 32);
}

// Payne and Hanek's reduction for large arguments: x times 2/pi, keeping only the bits that matter
// modulo 4, so no precision is lost to the size of x.
export Reduced reduceLarge(f64 x0) {
  bool neg = x0 < 0.0;
  f64 x = neg ? -x0 : x0;
  u64 bits = f64.toBits(x);
  i32 e = ((bits >> 52) & 0x7ff) as! i32 - 1075;
  u64 m = (bits & 0x000fffffffffffff) | 0x0010000000000000;
  // x = m * 2^e. The bits of 2/pi from position e-1 on decide x*2/pi modulo 4.
  i32 start = e - 1;
  u64 wHi = 0;
  u64 wLo = 0;
  for (i32 k = 0; k < 64; k++) { wHi = (wHi << 1) | bitOf(start + k); }
  for (i32 k = 64; k < 128; k++) { wLo = (wLo << 1) | bitOf(start + k); }
  u64[] lo1 = [0 as u64];
  u64 p1h = hi64(m, wLo, lo1);
  u64[] lo2 = [0 as u64];
  u64 p2h = hi64(m, wHi, lo2);
  u64 l1 = p1h + lo2[0];
  u64 carry = l1 < p1h ? 1 : 0;
  u64 l2 = p2h + carry;
  // total = l2 * 2^128 + l1 * 2^64 + lo1; x*2/pi = total / 2^126.
  i32 n = (((l2 << 2) | (l1 >> 62)) & 3) as! i32;
  f64 frac = (((l1 & 0x3FFFFFFFFFFFFFFF) as~ f64) * 18446744073709551616.0 + (lo1[0] as~ f64)) / 85070591730234615865843651857942052864.0;
  if (frac > 0.5) { frac = frac - 1.0; n = (n + 1) & 3; }
  f64 r = frac * 1.57079632679489661923;
  if (neg) { r = -r; n = (4 - n) & 3; }
  return Reduced(r, 0.0, n);
}

Reduced reduceAny(f64 x) {
  f64 ax = x < 0.0 ? -x : x;
  if (ax < 1.0e6) { return reduce(x); }
  return reduceLarge(x);
}

export f64 sin(f64 x) {
  if (x != x || x == 1.0 / 0.0 || x == -1.0 / 0.0) { return 0.0 / 0.0; }
  f64 ax = x < 0.0 ? -x : x;
  if (ax <= 0.7853981633974483) { return kernelSin(x, 0.0, false); }
  Reduced r = reduceAny(x);
  if (r.n == 0) { return kernelSin(r.y0, r.y1, true); }
  if (r.n == 1) { return kernelCos(r.y0, r.y1); }
  if (r.n == 2) { return -kernelSin(r.y0, r.y1, true); }
  return -kernelCos(r.y0, r.y1);
}

export f64 cos(f64 x) {
  if (x != x || x == 1.0 / 0.0 || x == -1.0 / 0.0) { return 0.0 / 0.0; }
  f64 ax = x < 0.0 ? -x : x;
  if (ax <= 0.7853981633974483) { return kernelCos(x, 0.0); }
  Reduced r = reduceAny(x);
  if (r.n == 0) { return kernelCos(r.y0, r.y1); }
  if (r.n == 1) { return -kernelSin(r.y0, r.y1, true); }
  if (r.n == 2) { return -kernelCos(r.y0, r.y1); }
  return kernelSin(r.y0, r.y1, true);
}

export f64 tan(f64 x) { return sin(x) / cos(x); }

static f64[] ATANHI = [4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01,
                       1.57079632679489655800e+00];
static f64[] ATANLO = [2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17,
                       6.12323399573676603587e-17];
static f64[] AT = [3.33333333333329318027e-01, -1.99999999998764832476e-01, 1.42857142725034663711e-01,
                   -1.11111104054623557880e-01, 9.09088713343650656196e-02, -7.69187620504482999495e-02,
                   6.66107313738753120669e-02, -5.83357013379057348645e-02, 4.97687799461593236017e-02,
                   -3.65315727442169155270e-02, 1.62858201153657823623e-02];

export f64 atan(f64 x0) {
  if (x0 != x0) { return x0; }
  bool neg = x0 < 0.0;
  f64 x = neg ? -x0 : x0;
  if (x >= 6.0e18) { return neg ? -ATANHI[3] - ATANLO[3] : ATANHI[3] + ATANLO[3]; }
  i32 id = -1;
  if (x < 0.4375) {
    if (x < 1e-29) { return x0; }
  } else if (x < 1.1875) {
    if (x < 0.6875) { id = 0; x = (2.0 * x - 1.0) / (2.0 + x); }
    else { id = 1; x = (x - 1.0) / (x + 1.0); }
  } else if (x < 2.4375) {
    id = 2;
    x = (x - 1.5) / (1.0 + 1.5 * x);
  } else {
    id = 3;
    x = -1.0 / x;
  }
  f64 z = x * x;
  f64 w = z * z;
  f64 s1 = z * (AT[0] + w * (AT[2] + w * (AT[4] + w * (AT[6] + w * (AT[8] + w * AT[10])))));
  f64 s2 = w * (AT[1] + w * (AT[3] + w * (AT[5] + w * (AT[7] + w * AT[9]))));
  if (id < 0) { return neg ? -(x - x * (s1 + s2)) : x - x * (s1 + s2); }
  f64 r = ATANHI[id] - ((x * (s1 + s2) - ATANLO[id]) - x);
  return neg ? -r : r;
}

static f64 PI = 3.14159265358979311600e+00;

export f64 atan2(f64 y, f64 x) {
  if (x != x || y != y) { return x + y; }
  if (x == 1.0) { return atan(y); }
  if (y == 0.0) {
    if (x > 0.0 || (x == 0.0 && f64.toBits(x) == f64.toBits(0.0))) { return y; }
    return f64.toBits(y) == f64.toBits(0.0) ? PI : -PI;
  }
  if (x == 0.0) { return y > 0.0 ? PI / 2.0 : -PI / 2.0; }
  if (x == 1.0 / 0.0 || x == -1.0 / 0.0) {
    bool yinf = y == 1.0 / 0.0 || y == -1.0 / 0.0;
    if (x > 0.0) {
      if (yinf) { return y > 0.0 ? PI / 4.0 : -PI / 4.0; }
      return y > 0.0 ? 0.0 : -0.0;
    }
    if (yinf) { return y > 0.0 ? 3.0 * PI / 4.0 : -3.0 * PI / 4.0; }
    return y > 0.0 ? PI : -PI;
  }
  if (y == 1.0 / 0.0 || y == -1.0 / 0.0) { return y > 0.0 ? PI / 2.0 : -PI / 2.0; }
  f64 z = atan((y / x) < 0.0 ? -(y / x) : (y / x));
  if (x > 0.0) { return y < 0.0 ? -z : z; }
  f64 r = PI - (z - 1.2246467991473531772e-16);
  return y < 0.0 ? -r : r;
}

export f64 asin(f64 x) {
  if (x > 1.0 || x < -1.0) { return 0.0 / 0.0; }
  return atan2(x, (1.0 - x * x).sqrt());
}

export f64 acos(f64 x) {
  if (x > 1.0 || x < -1.0) { return 0.0 / 0.0; }
  return atan2((1.0 - x * x).sqrt(), x);
}

export f64 sinh(f64 x) {
  f64 e = math.expm1(x < 0.0 ? -x : x);
  f64 r = 0.5 * (e + e / (e + 1.0));
  return x < 0.0 ? -r : r;
}

export f64 cosh(f64 x) {
  f64 e = math.exp(x < 0.0 ? -x : x);
  return 0.5 * (e + 1.0 / e);
}

export f64 tanh(f64 x) {
  f64 ax = x < 0.0 ? -x : x;
  if (ax > 22.0) { return x < 0.0 ? -1.0 : 1.0; }
  f64 e = math.expm1(2.0 * ax);
  f64 r = e / (e + 2.0);
  return x < 0.0 ? -r : r;
}

export f64 asinh(f64 x) {
  f64 ax = x < 0.0 ? -x : x;
  f64 r = math.log1p(ax + ax * ax / (1.0 + (1.0 + ax * ax).sqrt()));
  return x < 0.0 ? -r : r;
}

export f64 acosh(f64 x) {
  if (x < 1.0) { return 0.0 / 0.0; }
  return math.log(x + (x * x - 1.0).sqrt());
}

export f64 atanh(f64 x) {
  if (x > 1.0 || x < -1.0) { return 0.0 / 0.0; }
  f64 ax = x < 0.0 ? -x : x;
  f64 r = 0.5 * math.log1p(2.0 * ax / (1.0 - ax));
  return x < 0.0 ? -r : r;
}
