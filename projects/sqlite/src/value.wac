// A value as SQLite stores it: one of five storage classes. Affinity, collation and the rest of SQL's
// typing are the engine's business and live elsewhere; this is only what a record can hold.

export enum Value {
  Null,
  Int(i64 i),
  Real(f64 r),
  Text(string s),
  Blob(u8[] b),
}

// The storage class rank SQLite sorts by: NULL, then numbers (integers and reals compare as numbers
// against each other), then text, then blobs.
export i32 classRank(const Value v) {
  return match (v) { Null: 0, Int: 1, Real: 1, Text: 2, Blob: 3 };
}

i32 cmpI64(i64 a, i64 b) { return a < b ? -1 : (a > b ? 1 : 0); }

i32 cmpF64(f64 a, f64 b) { return a < b ? -1 : (a > b ? 1 : 0); }

// An integer against a real, without rounding the integer first when they are close: a large i64 does
// not survive the trip to f64, so equality as floats is refined by comparing as integers.
i32 cmpIntReal(i64 i, f64 r) {
  f64 fi = i as~ f64;
  if (fi < r) { return -1; }
  if (fi > r) { return 1; }
  if (r >= 9223372036854775807.0) { return -1; }
  if (r < -9223372036854775808.0) { return 1; }
  return cmpI64(i, r.trunc() as~ i64);
}

export i32 cmpBytes(const u8[] a, const u8[] b) {
  i32 n = a.len() < b.len() ? a.len() : b.len();
  for (i32 i = 0; i < n; i++) {
    i32 x = a[i] as i32;
    i32 y = b[i] as i32;
    if (x != y) { return x < y ? -1 : 1; }
  }
  return a.len() < b.len() ? -1 : (a.len() > b.len() ? 1 : 0);
}

// Strings compare by byte, which for UTF-8 is SQLite's BINARY collation.
i32 cmpText(string a, string b) { return a < b ? -1 : (a > b ? 1 : 0); }

// SQLite's ordering of two values under the BINARY collation.
export i32 compareValues(const Value a, const Value b) {
  i32 ra = classRank(a);
  i32 rb = classRank(b);
  if (ra != rb) { return ra < rb ? -1 : 1; }
  match (a) {
    Null: { return 0; }
    Int(x): {
      match (b) {
        Int(y): { return cmpI64(x, y); }
        Real(y): { return cmpIntReal(x, y); }
        default: { trap; }
      }
    }
    Real(x): {
      match (b) {
        Int(y): { return -cmpIntReal(y, x); }
        Real(y): { return cmpF64(x, y); }
        default: { trap; }
      }
    }
    Text(x): {
      match (b) { Text(y): { return cmpText(x, y); } default: { trap; } }
    }
    Blob(x): {
      match (b) { Blob(y): { return cmpBytes(x, y); } default: { trap; } }
    }
  }
}

export bool sameValue(const Value a, const Value b) {
  return classRank(a) == classRank(b) && compareValues(a, b) == 0;
}

// ── collations ─────────────────────────────────────────────────────────────

export static i32 COLL_BINARY = 0;
export static i32 COLL_NOCASE = 1;   // ASCII letters compare without case
export static i32 COLL_RTRIM = 2;    // trailing spaces do not count

export i32 collationId(string name) {
  u8[] b = name.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] >= 'A' && b[i] <= 'Z') { b[i] = b[i] + 32; } }
  string n = string.fromBytes(b);
  if (n == "binary") { return COLL_BINARY; }
  if (n == "nocase") { return COLL_NOCASE; }
  if (n == "rtrim") { return COLL_RTRIM; }
  return -1;
}

// Text as a collation sees it: folded, or trimmed. Other values are unchanged.
export Value collated(const Value v, i32 coll) {
  if (coll == COLL_BINARY) { return v as Value; }
  match (v) {
    Text(s): {
      u8[] b = s.toBytes();
      if (coll == COLL_NOCASE) {
        for (i32 i = 0; i < b.len(); i++) { if (b[i] >= 'A' && b[i] <= 'Z') { b[i] = b[i] + 32; } }
        return Value.Text(string.fromBytes(b));
      }
      i32 end = b.len();
      while (end > 0 && b[end - 1] == ' ') { end--; }
      return Value.Text(s.slice(0, end));
    }
    default: { return v as Value; }
  }
}

export i32 compareColl(const Value a, const Value b, i32 coll) {
  if (coll == COLL_BINARY) { return compareValues(a, b); }
  return compareValues(collated(a, coll), collated(b, coll));
}
