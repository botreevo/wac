// Reading a write-ahead log: the committed pages it holds, laid over the database file, as SQLite reads
// them before a checkpoint has copied them back.
//
// A WAL is a 32-byte header and then frames, each a 24-byte header and one page. A frame counts only
// when its salts are the header's (a log restarted after a checkpoint keeps stale frames with old
// salts beyond its end) and the running checksum, carried from the header through every frame before
// it, agrees; and only frames up to the last commit frame (one that records the database's size) are
// part of the database. Later frames belong to a transaction that never committed.

import { Map, hashI64, i64Eq } from "core";

i64 word(const u8[] b, i32 at, bool bigEndian) {
  if (bigEndian) {
    return ((b[at] as i64) << 24) | ((b[at + 1] as i64) << 16) | ((b[at + 2] as i64) << 8) | (b[at + 3] as i64);
  }
  return ((b[at + 3] as i64) << 24) | ((b[at + 2] as i64) << 16) | ((b[at + 1] as i64) << 8) | (b[at] as i64);
}

i64 be(const u8[] b, i32 at) { return word(b, at, true); }

// SQLite's WAL checksum over b[from, from+n), continuing from (s0, s1); n is a multiple of 8.
i64[] checksum(const u8[] b, i32 from, i32 n, bool bigEndian, i64 s0in, i64 s1in) {
  i64 s0 = s0in;
  i64 s1 = s1in;
  i64 mask = 0xffffffff;
  for (i32 i = from; i < from + n; i += 8) {
    s0 = (s0 + word(b, i, bigEndian) + s1) & mask;
    s1 = (s1 + word(b, i + 4, bigEndian) + s0) & mask;
  }
  return [s0, s1];
}

// The committed pages a log holds, the latest of each, and the database's size in pages as its last
// commit records it. Null when the log holds no committed frame (or is not a log), so the file alone is
// the database.
export WalPages? walPages(const u8[] wal) {
  WalScan? sc = scanWal(wal);
  if (sc is null) { return null; }
  Map<i64, u8[]> pages = Map.create(hashI64, i64Eq);
  i32 ps = sc!.pageSize;
  for (i32 f = 32; f < sc!.committedEnd; f += 24 + ps) {
    i64 page = be(wal, f);
    if (page < 1 || page > sc!.dbPages) { continue; }
    u8[] p = u8[].filled(ps, 0);
    p.copyFrom(wal, f + 24, 0, ps);
    pages.set(page, p);
  }
  return WalPages(ps, sc!.dbPages, pages);
}

export struct WalPages {
  i32 pageSize;
  i64 dbPages;
  Map<i64, u8[]> pages;
}

struct WalScan {
  i32 pageSize;
  i32 committedEnd;
  i64 dbPages;
}

// How far a log's valid, committed frames reach.
WalScan? scanWal(const u8[] wal) {
  if (wal.len() < 32) { return null; }
  i64 magic = be(wal, 0);
  if (magic != 0x377f0682 && magic != 0x377f0683) { return null; }
  bool bigEndian = magic == 0x377f0683;
  i64 pageSize = be(wal, 8);
  if (pageSize == 1) { pageSize = 65536; }
  if (pageSize < 512 || pageSize > 65536 || (pageSize & (pageSize - 1)) != 0) { return null; }
  i32 ps = pageSize as! i32;
  i64[] sum = checksum(wal, 0, 24, bigEndian, 0, 0);
  if (sum[0] != be(wal, 24) || sum[1] != be(wal, 28)) { return null; }
  i64 salt1 = be(wal, 16);
  i64 salt2 = be(wal, 20);
  i32 frame = 24 + ps;
  i32 at = 32;
  i32 committedEnd = 32;
  i64 dbPages = 0;
  while (at + frame <= wal.len()) {
    if (be(wal, at + 8) != salt1 || be(wal, at + 12) != salt2) { break; }
    sum = checksum(wal, at, 8, bigEndian, sum[0], sum[1]);
    sum = checksum(wal, at + 24, ps, bigEndian, sum[0], sum[1]);
    if (sum[0] != be(wal, at + 16) || sum[1] != be(wal, at + 20)) { break; }
    i64 commit = be(wal, at + 4);
    at += frame;
    if (commit != 0) {
      committedEnd = at;
      dbPages = commit;
    }
  }
  if (committedEnd == 32) { return null; }
  return WalScan(ps, committedEnd, dbPages);
}

// The database as the log leaves it: `main` with every committed frame's page in place, sized as the
// last commit says. Null when the log holds no committed frame (or is not a log), so the file alone is
// the database.
export u8[]? applyWal(const u8[] main, const u8[] wal) {
  if (wal.len() < 32) { return null; }
  i64 magic = be(wal, 0);
  if (magic != 0x377f0682 && magic != 0x377f0683) { return null; }
  bool bigEndian = magic == 0x377f0683;
  i64 pageSize = be(wal, 8);
  if (pageSize == 1) { pageSize = 65536; }
  if (pageSize < 512 || pageSize > 65536 || (pageSize & (pageSize - 1)) != 0) { return null; }
  i32 ps = pageSize as! i32;
  i64[] sum = checksum(wal, 0, 24, bigEndian, 0, 0);
  if (sum[0] != be(wal, 24) || sum[1] != be(wal, 28)) { return null; }
  i64 salt1 = be(wal, 16);
  i64 salt2 = be(wal, 20);
  // First pass: how far the valid, committed frames reach.
  i32 frame = 24 + ps;
  i32 at = 32;
  i32 committedEnd = 32;
  i64 dbPages = 0;
  while (at + frame <= wal.len()) {
    if (be(wal, at + 8) != salt1 || be(wal, at + 12) != salt2) { break; }
    sum = checksum(wal, at, 8, bigEndian, sum[0], sum[1]);
    sum = checksum(wal, at + 24, ps, bigEndian, sum[0], sum[1]);
    if (sum[0] != be(wal, at + 16) || sum[1] != be(wal, at + 20)) { break; }
    i64 commit = be(wal, at + 4);
    at += frame;
    if (commit != 0) {
      committedEnd = at;
      dbPages = commit;
    }
  }
  if (committedEnd == 32) { return null; }
  // Second pass: the pages, later frames over earlier ones, in a file of the committed size.
  i64 size = dbPages * pageSize;
  if (size > 0x7fffffff) { return null; }
  u8[] out = u8[].filled(size as! i32, 0);
  i32 keep = main.len() < out.len() ? main.len() : out.len();
  out.copyFrom(main, 0, 0, keep);
  for (i32 f = 32; f < committedEnd; f += frame) {
    i64 page = be(wal, f);
    if (page < 1 || page > dbPages) { continue; }
    out.copyFrom(wal, f + 24, ((page - 1) * pageSize) as! i32, ps);
  }
  return out;
}
