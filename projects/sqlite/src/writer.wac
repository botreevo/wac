// Writing a whole database image, b-trees built bottom-up from rows that are already sorted.
//
// Every write produces a fresh file, as VACUUM does: no freelist, every page packed, tables and indexes
// in schema order. That costs a full rewrite per commit, which is what std's file interface (whole-file
// reads and writes) allows anyway, and it keeps the writer to one path that is easy to check.

import { Buf, Vec } from "core";
import { Value } from "./value.wac";
import { encodeRecord } from "./record.wac";
import { put16, put32, pushVarint, varintLen } from "./bytes.wac";
import { localSize } from "./reader.wac";

// Pages under construction. Page n is pages[n - 1]; a reserved page is an empty array until filled.
export struct Pages {
  i32 pageSize;
  Vec<u8[]> pages;

  i64 reserve(this) {
    this.pages.push(u8[]());
    return this.pages.len() as i64;
  }

  void fill(this, i64 n, u8[] page) { this.pages.set((n - 1) as! i32, page); }

  i64 add(this, u8[] page) {
    this.pages.push(page);
    return this.pages.len() as i64;
  }
}

// A cell's bytes as they sit on a b-tree page, its overflow pages already written.
struct Cell {
  u8[] bytes;
}

// The local part of a payload, then the first overflow page's number when the rest did not fit.
void pushPayload(Pages ps, Buf out, const u8[] payload, bool table) {
  i32 usable = ps.pageSize;
  i32 local = localSize(usable, table, payload.len() as i64);
  out.pushBytes(payload, 0, local);
  if (local == payload.len()) { return; }
  // Overflow pages are chained in payload order; the chain is built back to front so each page can name
  // the next one by its number.
  i32 rest = payload.len() - local;
  i32 per = usable - 4;
  i32 count = (rest + per - 1) / per;
  i64 next = 0;
  for (i32 k = count - 1; k >= 0; k--) {
    u8[] page = u8[].filled(ps.pageSize, 0);
    put32(page, 0, next);
    i32 start = local + k * per;
    i32 n = payload.len() - start < per ? payload.len() - start : per;
    page.copyFrom(payload, start, 4, n);
    next = ps.add(page);
  }
  u8[] num = u8[].filled(4, 0);
  put32(num, 0, next);
  out.pushAll(num);
}

Cell tableLeafCell(Pages ps, i64 rowid, const u8[] payload) {
  Buf b = Buf.create();
  pushVarint(b, payload.len() as i64);
  pushVarint(b, rowid);
  pushPayload(ps, b, payload, true);
  return Cell(b.take());
}

Cell indexCell(Pages ps, const u8[] payload, i64 leftChild) {
  Buf b = Buf.create();
  if (leftChild > 0) {
    u8[] num = u8[].filled(4, 0);
    put32(num, 0, leftChild);
    b.pushAll(num);
  }
  pushVarint(b, payload.len() as i64);
  pushPayload(ps, b, payload, false);
  return Cell(b.take());
}

Cell tableInteriorCell(i64 child, i64 key) {
  Buf b = Buf.create();
  u8[] num = u8[].filled(4, 0);
  put32(num, 0, child);
  b.pushAll(num);
  pushVarint(b, key);
  return Cell(b.take());
}

// Lays cells onto one page: header at `hdr` (100 on page 1), pointers after it, content packed from
// the end of the page down.
u8[] layOut(i32 pageSize, i32 hdr, i32 kind, const Cell[] cells, i64 rightChild) {
  u8[] p = u8[].filled(pageSize, 0);
  bool interior = kind == 2 || kind == 5;
  i32 ptrs = hdr + (interior ? 12 : 8);
  i32 top = pageSize;
  for (i32 i = 0; i < cells.len(); i++) {
    top -= cells[i].bytes.len();
    p.copyFrom(cells[i].bytes, 0, top, cells[i].bytes.len());
    put16(p, ptrs + 2 * i, top);
  }
  p[hdr] = kind as@ u8;
  put16(p, hdr + 1, 0);
  put16(p, hdr + 3, cells.len());
  put16(p, hdr + 5, top == 65536 ? 0 : top);
  p[hdr + 7] = 0;
  if (interior) { put32(p, hdr + 8, rightChild); }
  return p;
}

i32 cellRoom(i32 pageSize, i32 hdr, bool interior) { return pageSize - hdr - (interior ? 12 : 8); }

// One level of a b-tree under construction: a page's cells, and for interior levels the children.
struct Level {
  Vec<Cell> cells;
  i32 used;
}

// A finished page's place in the level above: its number, and the key that separates it from the next.
struct Child {
  i64 page;
  i64 maxRowid;
}

// Assigns the page a number. The root goes into its reserved slot; everything else is appended.
i64 place(Pages ps, u8[] page, i64 root, bool isRoot) {
  if (isRoot) { ps.fill(root, page); return root; }
  return ps.add(page);
}

// A table b-tree over rows already in rowid order, its root at `root`.
export void buildTable(Pages ps, i64 root, const i64[] rowids, const u8[][] payloads) {
  i32 hdr0 = root == 1 ? 100 : 0;
  // Leaves first. Cells are made (and overflow written) as they are packed.
  Vec<Cell[]> leaves;
  Vec<i64> leafMax;
  Vec<Cell> cur;
  i32 used = 0;
  i32 room = cellRoom(ps.pageSize, 0, false);
  for (i32 i = 0; i < rowids.len(); i++) {
    Cell c = tableLeafCell(ps, rowids[i], payloads[i]);
    i32 need = c.bytes.len() + 2;
    if (cur.len() > 0 && used + need > room) {
      leaves.push(cur.toArray());
      leafMax.push(rowids[i - 1]);
      cur = Vec.create();
      used = 0;
    }
    cur.push(c);
    used += need;
  }
  // A single leaf is the root, and the root of page 1 has 100 bytes less to work with.
  if (leaves.len() == 0) {
    Cell[] only = cur.toArray();
    if (used <= cellRoom(ps.pageSize, hdr0, false)) {
      ps.fill(root, layOut(ps.pageSize, hdr0, 13, only, 0));
      return;
    }
    // Did not fit beside the file header: split the last cell off into a second leaf.
    Cell[] a = Cell[].filled(only.len() - 1, only[0]);
    a.copyFrom(only, 0, 0, only.len() - 1);
    leaves.push(a);
    leafMax.push(rowids[rowids.len() - 2]);
    cur = Vec.fromArray([only[only.len() - 1]]);
  }
  leaves.push(cur.toArray());
  leafMax.push(rowids.len() > 0 ? rowids[rowids.len() - 1] : 0);
  Vec<Child> level;
  for (i32 i = 0; i < leaves.len(); i++) {
    level.push(Child(ps.add(layOut(ps.pageSize, 0, 13, leaves.get(i), 0)), leafMax.get(i)));
  }
  // Interior levels until one page holds them all.
  while (true) {
    i32 rootRoom = cellRoom(ps.pageSize, hdr0, true);
    i32 total = 0;
    for (i32 i = 0; i < level.len() - 1; i++) { total += 6 + varintLen(level.get(i).maxRowid); }
    if (total <= rootRoom) {
      Vec<Cell> cells;
      for (i32 i = 0; i < level.len() - 1; i++) { cells.push(tableInteriorCell(level.get(i).page, level.get(i).maxRowid)); }
      ps.fill(root, layOut(ps.pageSize, hdr0, 5, cells.toArray(), level.get(level.len() - 1).page));
      return;
    }
    Vec<Child> up;
    i32 rm = cellRoom(ps.pageSize, 0, true);
    i32 at = 0;
    while (at < level.len()) {
      // Cells for children at..j-1, with child j as the right pointer.
      Vec<Cell> cells;
      i32 sz = 0;
      i32 j = at;
      while (j + 1 < level.len()) {
        i32 need = 6 + varintLen(level.get(j).maxRowid);
        if (sz + need > rm) { break; }
        cells.push(tableInteriorCell(level.get(j).page, level.get(j).maxRowid));
        sz += need;
        j++;
      }
      up.push(Child(ps.add(layOut(ps.pageSize, 0, 5, cells.toArray(), level.get(j).page)), level.get(j).maxRowid));
      at = j + 1;
    }
    level = up;
  }
}

// The bytes a cell will take, without writing its overflow pages.
i32 indexCellSize(i32 usable, i32 payload, bool interior) {
  i32 local = localSize(usable, false, payload as i64);
  return (interior ? 4 : 0) + varintLen(payload as i64) + local + (local < payload ? 4 : 0);
}

// An index b-tree over entries already in index order. Interior cells carry real entries: the entry
// between two pages moves up into their parent rather than being copied, so each level is partitioned
// into pages and the dividers between them, and the dividers are the next level's items.
export void buildIndex(Pages ps, i64 root, const u8[][] entries) {
  i32 hdr0 = root == 1 ? 100 : 0;
  Vec<u8[]> items = Vec.fromArray(entries as u8[][]);
  Vec<i64> lefts;      // each item's left child; unused at the leaf level
  i64 rightmost = 0;
  bool leaf = true;
  while (true) {
    i32 kind = leaf ? 10 : 2;
    i32 n = items.len();
    i32[] size = i32[].filled(n, 0);
    i32 total = 0;
    for (i32 i = 0; i < n; i++) {
      size[i] = indexCellSize(ps.pageSize, items.get(i).len(), !leaf) + 2;
      total += size[i];
    }
    if (total <= cellRoom(ps.pageSize, hdr0, !leaf)) {
      Vec<Cell> cells;
      for (i32 i = 0; i < n; i++) { cells.push(indexCell(ps, items.get(i), leaf ? 0 : lefts.get(i))); }
      ps.fill(root, layOut(ps.pageSize, hdr0, kind, cells.toArray(), rightmost));
      return;
    }
    // Pages are [starts[k], ends[k]); the item at ends[k] is the divider after page k, except after
    // the last page.
    i32 room = cellRoom(ps.pageSize, 0, !leaf);
    Vec<i32> starts;
    Vec<i32> ends;
    i32 at = 0;
    while (at < n) {
      i32 used = 0;
      i32 j = at;
      while (j < n && (j == at || used + size[j] <= room)) { used += size[j]; j++; }
      if (j == n - 1) {
        // The divider would be the very last item and leave the final page empty: the page gives up
        // its last cell as the divider instead, and the last item is the final page on its own.
        j--;
      }
      starts.push(at);
      ends.push(j);
      at = j + 1;
    }
    Vec<u8[]> upItems;
    Vec<i64> upLefts;
    i64 lastPage = 0;
    for (i32 k = 0; k < starts.len(); k++) {
      Vec<Cell> cells;
      for (i32 i = starts.get(k); i < ends.get(k); i++) { cells.push(indexCell(ps, items.get(i), leaf ? 0 : lefts.get(i))); }
      bool isLast = k == starts.len() - 1;
      i64 right = 0;
      if (!leaf) { right = isLast ? rightmost : lefts.get(ends.get(k)); }
      i64 page = ps.add(layOut(ps.pageSize, 0, kind, cells.toArray(), right));
      if (isLast) {
        lastPage = page;
      } else {
        upItems.push(items.get(ends.get(k)));
        upLefts.push(page);
      }
    }
    items = upItems;
    lefts = upLefts;
    rightmost = lastPage;
    leaf = false;
  }
}
