{
  // Every unit test. The file tests read test/data and write under dist/.
  test: "wac test --allow-read --allow-write test",
  // Regenerate test/data with the real SQLite (Python's sqlite3).
  fixtures: "python3 tools/fixtures.py",
  // Rewrite each fixture through this library and have the real SQLite check the result.
  verify: "sh tools/verify.sh",
}
