// A test's running tally: every failed expectation is kept, and `report()` is what a test returns.

export struct Check {
  string failures;

  Check create() { return Check(""); }

  void ok(this, bool cond, string what) {
    if (!cond) { this.failures += what + "\n"; }
  }

  void eqI64(this, i64 got, i64 want, string what) {
    if (got != want) { this.failures += "\{what}: got \{got}, want \{want}\n"; }
  }

  void eqStr(this, string got, string want, string what) {
    if (got != want) { this.failures += "\{what}: got \"\{got}\", want \"\{want}\"\n"; }
  }

  string report(const this) { return this.failures; }
}
