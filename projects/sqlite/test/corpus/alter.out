> CREATE TABLE t (id INTEGER PRIMARY KEY, a TEXT UNIQUE, b, c REFERENCES t(id), d DEFAULT 4);
> CREATE INDEX t_b ON t(b);
> CREATE VIEW v AS SELECT a, t.b FROM t WHERE t.id > 0;
> CREATE TRIGGER tr AFTER INSERT ON t BEGIN UPDATE t SET b = new.a WHERE id = new.id; END;
> CREATE TABLE u (x REFERENCES t(a), y);
