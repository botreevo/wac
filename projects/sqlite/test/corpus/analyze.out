> CREATE TABLE a (x, y, z);
> CREATE INDEX a_x ON a (x);
> CREATE INDEX a_xy ON a (x, y);
> CREATE UNIQUE INDEX a_z ON a (z);
> CREATE INDEX a_p ON a (y) WHERE x > 2;
> CREATE TABLE e (q);
> CREATE INDEX e_q ON e (q);
> CREATE TABLE noix (v);
> CREATE TABLE w (k PRIMARY KEY, v) WITHOUT ROWID;
> CREATE INDEX w_v ON w (v);
> WITH RECURSIVE r(value) AS (SELECT 1 UNION ALL SELECT value + 1 FROM r WHERE value < 30) INSERT INTO a SELECT value % 3, value % 7, value FROM r;
> INSERT INTO noix VALUES (1), (2);
> WITH RECURSIVE r(value) AS (SELECT 1 UNION ALL SELECT value + 1 FROM r WHERE value < 10) INSERT INTO w SELECT value, value % 2 FROM r;
> CREATE TABLE u (id INTEGER PRIMARY KEY, t TEXT UNIQUE, n);
> INSERT INTO u (t, n) VALUES ('a', NULL), ('b', NULL), ('c', 1);
> CREATE INDEX u_n ON u (n);
> CREATE TABLE near (v);
> CREATE INDEX near_v ON near (v);
> WITH RECURSIVE r(value) AS (SELECT 1 UNION ALL SELECT value + 1 FROM r WHERE value < 100) INSERT INTO near SELECT CASE WHEN value <= 5 THEN 0 ELSE value END FROM r;
> ANALYZE;
> SELECT type, name, sql FROM sqlite_schema WHERE name LIKE 'sqlite_stat%';
'table'|'sqlite_stat1'|'CREATE TABLE sqlite_stat1(tbl,idx,stat)'
> SELECT * FROM sqlite_stat1 ORDER BY tbl, idx;
'a'|'a_p'|'0 0'
'a'|'a_x'|'30 10'
'a'|'a_xy'|'30 10 2'
'a'|'a_z'|'30 1'
'near'|'near_v'|'100 1'
'noix'|NULL|'2'
'u'|'sqlite_autoindex_u_1'|'3 1'
'u'|'u_n'|'3 2'
'w'|'w'|'10 1'
'w'|'w_v'|'10 5'
> DELETE FROM a WHERE x = 0;
> ANALYZE a;
> SELECT * FROM sqlite_stat1 ORDER BY tbl, idx;
'a'|'a_p'|'0 0'
'a'|'a_x'|'20 10'
'a'|'a_xy'|'20 10 2'
'a'|'a_z'|'20 1'
'near'|'near_v'|'100 1'
'noix'|NULL|'2'
'u'|'sqlite_autoindex_u_1'|'3 1'
'u'|'u_n'|'3 2'
'w'|'w'|'10 1'
'w'|'w_v'|'10 5'
> INSERT INTO a VALUES (9, 9, 99);
> ANALYZE a_x;
> SELECT * FROM sqlite_stat1 ORDER BY tbl, idx;
'a'|'a_p'|'0 0'
'a'|'a_x'|'21 7'
'a'|'a_xy'|'20 10 2'
'a'|'a_z'|'20 1'
