> CREATE TABLE t (a INTEGER, b TEXT, c REAL, d);
> INSERT INTO t VALUES (1, 'one', 1.5, NULL), (2, 'two', 2, 'x'), (3, 'three', NULL, 3.0);
> SELECT * FROM t;
1|'one'|1.5|NULL
2|'two'|2.0|'x'
3|'three'|NULL|3.0
> SELECT rowid, a FROM t WHERE a >= 2;
2|2
3|3
> SELECT a, b FROM t ORDER BY b;
1|'one'
3|'three'
2|'two'
> SELECT a, b FROM t ORDER BY b DESC LIMIT 2;
2|'two'
3|'three'
> SELECT a, b FROM t ORDER BY a LIMIT 1 OFFSET 1;
2|'two'
> SELECT count(*), sum(a), avg(a), min(b), max(c), total(c) FROM t;
3|6|2.0|'one'|2.0|3.5
> SELECT typeof(a), typeof(b), typeof(c), typeof(d) FROM t;
'integer'|'text'|'real'|'null'
'integer'|'text'|'real'|'text'
'integer'|'text'|'null'|'real'
> INSERT INTO t (a, b) VALUES ('42', 99);
> SELECT a, typeof(a), b, typeof(b) FROM t WHERE rowid = 4;
42|'integer'|'99'|'text'
> UPDATE t SET b = b || '!' WHERE a > 2;
> SELECT a, b FROM t;
1|'one'
2|'two'
3|'three!'
42|'99!'
> DELETE FROM t WHERE c IS NULL;
> SELECT a, b, c FROM t;
1|'one'|1.5
2|'two'|2.0
> SELECT 1 + 2, 7 / 2, 7.0 / 2, 7 % 3, -5 / 2, 1 / 0, 'a' || 'b', 10 - '3x';
3|3|3.5|1|-2|NULL|'ab'|7
> SELECT 9223372036854775807 + 1, -9223372036854775808, 2 * 4611686018427387904;
9.22337203685478e+18|-9223372036854775808|9.22337203685478e+18
> SELECT 1 = 1.0, 'a' < 'b', NULL = NULL, NULL IS NULL, 1 IS NOT 2, 3 BETWEEN 1 AND 5;
1|1|NULL|1|1|1
> SELECT 2 IN (1, 2, 3), 4 NOT IN (1, 2), NULL IN (1), 1 IN (NULL, 1), 2 IN (NULL, 1);
1|1|NULL|1|NULL
> SELECT CASE 2 WHEN 1 THEN 'a' WHEN 2 THEN 'b' ELSE 'c' END, CASE WHEN 0 THEN 'x' END;
'b'|NULL
> SELECT CAST('12abc' AS INTEGER), CAST(3.9 AS INTEGER), CAST(5 AS TEXT), CAST('1e3' AS REAL), CAST('x' AS NUMERIC);
12|3|'5'|1000.0|0
> SELECT 'abc' LIKE 'A%', 'abc' LIKE '_b_', 'abc' GLOB 'a*', 'abc' GLOB 'A*', 'a%c' LIKE 'a\%c' ESCAPE '\';
1|1|1|0|1
> SELECT coalesce(NULL, NULL, 3), ifnull(NULL, 'x'), nullif(1, 1), nullif(1, 2), iif(1, 'y', 'n');
3|'x'|NULL|1|'y'
> SELECT length('héllo'), upper('abc'), lower('ABC'), substr('hello', 2, 3), substr('hello', -3), substr('hello', 0, 2);
5|'ABC'|'abc'|'ell'|'llo'|'h'
> SELECT replace('a-b-c', '-', '+'), trim('  x  '), ltrim('xxy', 'x'), rtrim('yxx', 'x'), instr('hello', 'll');
'a+b+c'|'x'|'y'|'y'|3
> SELECT abs(-3), abs(2.5), round(2.567, 2), round(2.5), round(-2.5), hex('ab'), quote('it''s'), quote(1.5);
3|2.5|2.57|3.0|-3.0|'6162'|'''it''''s'''|'1.5'
> SELECT max(1, 5, 3), min('b', 'a'), max(1, NULL);
5|'a'|NULL
> SELECT 0.1 + 0.2, 1.0 / 3, 1e20, 1e-5, 100.0, 123456789012345678.0;
0.3|0.333333333333333|1.0e+20|1.0e-05|100.0|1.23456789012346e+17
> SELECT x'0102', length(x'0102'), typeof(x'');
X'0102'|2|'blob'
> SELECT 5 & 3, 5 | 3, 1 << 4, 256 >> 4, ~5;
1|7|16|16|-6
> SELECT 'x' = 'x' AND 1, 0 OR NULL, 1 OR NULL, NOT 0, NOT NULL;
1|NULL|1|1|NULL
