> CREATE TABLE t (id INTEGER PRIMARY KEY, a, b TEXT, c REAL, d NUMERIC, e INT, f BLOB, g VARCHAR(5), h FLOAT);
> INSERT INTO t VALUES (1, 2, 'x', 1.5, 3, 4, x'00', 'v', 2.0), (2, '7', 8, 3, '4.0', '5', NULL, 6, 7);
> CREATE TABLE x1 AS SELECT * FROM t;
> CREATE TABLE x2 AS SELECT id, a * 2 AS dbl, b || 'q', 1, 'lit', 2.5, NULL, count(*) AS n, upper(b) u, CAST(a AS TEXT) ct, c + 1 FROM t;
> CREATE TABLE "we ird" AS SELECT 1 AS "a b", 2 AS [select], 3 AS "x""y";
> CREATE TABLE IF NOT EXISTS x1 AS SELECT 1;
> CREATE TABLE x1 AS SELECT 1;
error
