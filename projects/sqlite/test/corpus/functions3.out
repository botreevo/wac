> CREATE TABLE n (v);
> INSERT INTO n VALUES (1), (2), (3), (4), (NULL), (10);
> SELECT median(v), percentile(v, 25), percentile_cont(v, 0.25), percentile_disc(v, 0.25), percentile(v, 100), percentile_disc(v, 0.5) FROM n;
3.0|2.0|2.0|2.0|10.0|3.0
> SELECT median(v) FROM n WHERE v > 100;
NULL
> SELECT percentile(v, 101) FROM n;
error
> SELECT percentile(v, NULL) FROM n;
error
> SELECT median('a');
error
> SELECT median(v) OVER (ORDER BY v) FROM n;
NULL
