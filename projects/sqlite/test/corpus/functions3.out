'real'
> SELECT median(v) FROM (SELECT 'abc' v UNION SELECT 3);
error
> SELECT median(v) FROM (SELECT '7' v UNION SELECT 3);
error
> SELECT median(DISTINCT v) FROM (SELECT 1 v UNION ALL SELECT 1 UNION ALL SELECT 5);
