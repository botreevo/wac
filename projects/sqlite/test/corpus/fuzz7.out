'table'|'a7'|'a7'|'CREATE TABLE "a7" (id INTEGER PRIMARY KEY, x4 INTEGER, y8 TEXT, CHECK (x4 >= 0))'
'trigger'|'a_ins'|'a7'|'CREATE TRIGGER a_ins AFTER INSERT ON "a7" BEGIN INSERT INTO log VALUES (''a '' || new.id || '' '' || new.x4 || '' '' || coalesce(new.y8, '''')); END'
'index'|'a_xy'|'a7'|'CREATE INDEX a_xy ON "a7" (x4, y8)'
'view'|'av'|'av'|'CREATE VIEW av AS SELECT "a7".id, "a7".x4 + 1 AS x1, "b8".w857 FROM "a7" LEFT JOIN "b8" ON "b8".aid2 = "a7".id'
'table'|'b8'|'b8'|'CREATE TABLE "b8" (id INTEGER PRIMARY KEY, aid2 INTEGER REFERENCES "a7" (id) ON DELETE CASCADE, w857, extra3462  DEFAULT 3)'
'trigger'|'b_upd'|'b8'|'CREATE TRIGGER b_upd AFTER UPDATE OF w857 ON "b8" WHEN new.w857 <> old.w857 BEGIN INSERT INTO log SELECT ''b '' || new.id || '' '' || "a7".x4 FROM "a7" WHERE "a7".id = new.aid2; END'
'index'|'b_w'|'b8'|'CREATE INDEX b_w ON "b8" (w857) WHERE aid2 > 0'
'view'|'cnt'|'cnt'|'CREATE VIEW cnt AS SELECT count(*) AS n, max(x4) AS mx FROM "a7" WHERE y8 IS NOT NULL'
'table'|'log'|'log'|'CREATE TABLE log (what TEXT)'
> ALTER TABLE b8 DROP COLUMN aid2;
