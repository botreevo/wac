> CREATE TABLE a (id INTEGER, x TEXT);
> CREATE TABLE b (id INTEGER, y TEXT);
> CREATE TABLE c (id INTEGER, z TEXT);
> INSERT INTO a VALUES (1, 'a1'), (2, 'a2'), (3, 'a3');
> INSERT INTO b VALUES (2, 'b2'), (3, 'b3'), (4, 'b4');
> INSERT INTO c VALUES (3, 'c3'), (4, 'c4'), (5, 'c5');
> SELECT a.id, x, b.id, y FROM a RIGHT JOIN b ON a.id = b.id ORDER BY 1, 3;
NULL|NULL|4|'b4'
2|'a2'|2|'b2'
3|'a3'|3|'b3'
> SELECT a.id, x, b.id, y FROM a FULL OUTER JOIN b ON a.id = b.id ORDER BY 1, 3;
NULL|NULL|4|'b4'
1|'a1'|NULL|NULL
2|'a2'|2|'b2'
3|'a3'|3|'b3'
> SELECT a.id, b.id, c.id FROM a FULL JOIN b ON a.id = b.id FULL JOIN c ON c.id = b.id ORDER BY 1, 2, 3;
NULL|NULL|5
NULL|4|4
1|NULL|NULL
2|2|NULL
3|3|3
> SELECT a.id, b.id, c.id FROM a LEFT JOIN b ON a.id = b.id RIGHT JOIN c ON c.id = a.id ORDER BY 1, 2, 3;
NULL|NULL|4
NULL|NULL|5
3|3|3
> SELECT a.id, b.id FROM a FULL JOIN b ON a.id = b.id WHERE a.id IS NULL OR b.id IS NULL ORDER BY 1, 2;
NULL|4
1|NULL
> SELECT a.id, b.id FROM a RIGHT JOIN b ON a.id = b.id WHERE b.id > 2 ORDER BY 1, 2;
NULL|4
3|3
> SELECT * FROM a NATURAL JOIN b;
2|'a2'|'b2'
3|'a3'|'b3'
> SELECT * FROM a JOIN b USING (id) ORDER BY id;
2|'a2'|'b2'
3|'a3'|'b3'
> SELECT * FROM a LEFT JOIN b USING (id) ORDER BY id;
1|'a1'|NULL
2|'a2'|'b2'
3|'a3'|'b3'
> SELECT id, x, y FROM a NATURAL LEFT JOIN b ORDER BY id;
1|'a1'|NULL
2|'a2'|'b2'
3|'a3'|'b3'
> SELECT a.*, b.* FROM a JOIN b USING (id) ORDER BY 1;
2|'a2'|2|'b2'
3|'a3'|3|'b3'
> SELECT count(*) FROM a CROSS JOIN b;
9
> SELECT count(*), sum(a.id), sum(b.id) FROM a FULL JOIN b ON a.id = b.id;
4|6|9
> SELECT a.id, b.y FROM a NATURAL RIGHT JOIN b ORDER BY b.y;
2|'b2'
3|'b3'
NULL|'b4'
