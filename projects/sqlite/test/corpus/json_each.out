> SELECT * FROM json_each('{"a":1,"b c":[2,3.5,"x\ty"],"d":{"e":null,"f":true}}');
'a'|1|'integer'|1|2|NULL|'$.a'|'$'
'b c'|'[2,3.5,"x\ty"]'|'array'|NULL|6|NULL|'$."b c"'|'$'
'd'|'{"e":null,"f":true}'|'object'|NULL|22|NULL|'$.d'|'$'
> SELECT key, value, type, atom, id, parent, fullkey, path, json, root FROM json_tree('{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}');
NULL|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'object'|NULL|0|NULL|'$'|'$'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
'a'|1|'integer'|1|2|0|'$.a'|'$'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
'b c'|'[2,3.5,"x"]'|'array'|NULL|6|0|'$."b c"'|'$'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
0|2|'integer'|2|11|6|'$."b c"[0]'|'$."b c"'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
1|3.5|'real'|3.5|13|6|'$."b c"[1]'|'$."b c"'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
2|'x'|'text'|'x'|17|6|'$."b c"[2]'|'$."b c"'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
'd'|'{"e":null,"f":false}'|'object'|NULL|19|0|'$.d'|'$'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
'e'|NULL|'null'|NULL|22|19|'$.d.e'|'$.d'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
'f'|0|'false'|0|25|19|'$.d.f'|'$.d'|'{"a":1,"b c":[2,3.5,"x"],"d":{"e":null,"f":false}}'|'$'
> SELECT * FROM json_each('[1,[2,3]]', '$[1]');
0|2|'integer'|2|4|NULL|'$[1][0]'|'$[1]'
1|3|'integer'|3|6|NULL|'$[1][1]'|'$[1]'
> SELECT * FROM json_tree('[1,[2,3]]', '$[1]');
1|'[2,3]'|'array'|NULL|3|NULL|'$[1]'|'$'
0|2|'integer'|2|4|3|'$[1][0]'|'$[1]'
1|3|'integer'|3|6|3|'$[1][1]'|'$[1]'
> SELECT * FROM json_each('5');
NULL|5|'integer'|5|0|NULL|'$'|'$'
> SELECT * FROM json_each('[1,2]', '$.nope');
> SELECT * FROM json_each('not json');
error
> SELECT * FROM json_each(NULL);
> SELECT * FROM json_each('{"a":1}', '$.a');
NULL|1|'integer'|1|1|NULL|'$.a'|'$.a'
> SELECT * FROM json_tree('{"a":1}', '$.a');
'a'|1|'integer'|1|1|NULL|'$.a'|'$'
> SELECT key, value FROM json_each('[1,2,3]') WHERE value > 1;
1|2
2|3
> SELECT json_each.value FROM json_each('[1,2]');
1
2
> SELECT j.* FROM json_each('{"x":"1e2","y":1e2,"z":-0,"w":1E+2, "v": 12345678901234567890}') j;
'x'|'1e2'|'text'|'1e2'|2|NULL|'$.x'|'$'
'y'|100.0|'real'|100.0|8|NULL|'$.y'|'$'
'z'|0|'integer'|0|14|NULL|'$.z'|'$'
'w'|100.0|'real'|100.0|19|NULL|'$.w'|'$'
'v'|1.23456789012346e+19|'integer'|1.23456789012346e+19|26|NULL|'$.v'|'$'
> SELECT * FROM json_each(' [ 1 , { "k" : [ ] } , "éA" ] ');
0|1|'integer'|1|1|NULL|'$[0]'|'$'
1|'{"k":[]}'|'object'|NULL|3|NULL|'$[1]'|'$'
2|'éA'|'text'|'éA'|7|NULL|'$[2]'|'$'
> SELECT * FROM json_each('[1,2]', 'bad');
error
> SELECT * FROM json_each('[]');
> SELECT * FROM json_tree('{}');
NULL|'{}'|'object'|NULL|0|NULL|'$'|'$'
> SELECT count(*), sum(value) FROM json_each('[1,2,3,4]');
4|10
> SELECT * FROM json_each('[10,20,30]', '$[#-1]');
NULL|30|'integer'|30|7|NULL|'$[#-1]'|'$[#-1]'
> CREATE TABLE docs (id INTEGER PRIMARY KEY, body TEXT);
> INSERT INTO docs (body) VALUES ('{"tags":["a","b"],"n":1}'), ('{"tags":["b","c","d"],"n":2}'), ('{"n":3}'), (NULL);
> SELECT docs.id, t.value FROM docs, json_each(docs.body, '$.tags') AS t ORDER BY docs.id, t.key;
1|'a'
1|'b'
2|'b'
2|'c'
2|'d'
> SELECT t.value, count(*) FROM docs, json_each(docs.body, '$.tags') t GROUP BY t.value ORDER BY t.value;
'a'|1
'b'|2
'c'|1
'd'|1
> SELECT id FROM docs WHERE EXISTS (SELECT 1 FROM json_each(docs.body, '$.tags') WHERE value = 'b') ORDER BY id;
1
2
> SELECT d.id, j.key FROM docs d LEFT JOIN json_each(d.body) j ORDER BY d.id, j.key;
1|'n'
1|'tags'
2|'n'
2|'tags'
3|'n'
4|NULL
> SELECT fullkey, type FROM docs, json_tree(docs.body) WHERE docs.id = 2;
'$'|'object'
'$.tags'|'array'
'$.tags[0]'|'text'
'$.tags[1]'|'text'
'$.tags[2]'|'text'
'$.n'|'integer'
> SELECT id, (SELECT group_concat(value, '+') FROM json_each(body, '$.tags')) FROM docs ORDER BY id;
1|'a+b'
2|'b+c+d'
3|NULL
4|NULL
> SELECT * FROM json_each('[1]', '$', 3);
error
> SELECT * FROM nosuch(1);
error
> SELECT key FROM json_each('{"a b":1,"_x":2,"9":3,"":4,"ok1":5}');
'a b'
'_x'
'9'
''
'ok1'
> SELECT fullkey FROM json_tree('{"a b":{"c":[{"d":1}]},"_x":2,"9":3,"":4,"ok1":5}');
'$'
'$."a b"'
'$."a b".c'
'$."a b".c[0]'
'$."a b".c[0].d'
'$."_x"'
'$."9"'
'$.""'
'$.ok1'
> SELECT value FROM json_each(json_array(1, 'two', 3.5, json('{"x":1}')));
1
'two'
3.5
'{"x":1}'
> SELECT * FROM json_each(2.5);
NULL|2.5|'real'|2.5|0|NULL|'$'|'$'
> SELECT key, id FROM json_each('{"long":"' || hex(zeroblob(200)) || '","after":1}');
'long'|3
'after'|411
> SELECT key, id FROM json_each('{"long":"' || hex(zeroblob(40000)) || '","after":1}');
'long'|5
'after'|80015
> SELECT key, id FROM json_tree('[[' || hex(zeroblob(100)) || ', 1], 2]') WHERE type <> 'array';
error
