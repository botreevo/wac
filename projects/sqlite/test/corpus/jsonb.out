> SELECT hex(jsonb('[1,"a","a\"b",1.5,true,null,{"k":[]},-0,1e5,"é"]'));
'CB1D1331176148615C226235312E3501003C176B0B232D303531653527C3A9'
> SELECT hex(jsonb_array('x"y', 1, 2.5, NULL, 'plain', 'tab	x', json('[1]')));
'CB1C48785C2279133135322E350057706C61696E687461625C74782B1331'
> SELECT hex(jsonb_object('k', 'v', 'n', 3));
'8C176B1776176E1333'
> SELECT hex(jsonb('"' || hex(zeroblob(20)) || '"'));
'C72830303030303030303030303030303030303030303030303030303030303030303030303030303030'
> SELECT hex(jsonb('[' || substr(hex(zeroblob(200)), 1, 300) || ']'));
error
> SELECT hex(jsonb('"' || hex(zeroblob(40000)) || '"')) = '';
0
> SELECT length(jsonb('"' || hex(zeroblob(40000)) || '"'));
80005
> SELECT json(jsonb('[1,"a\"b",{"k":[]}]'));
'[1,"a\"b",{"k":[]}]'
> SELECT json_extract(jsonb('{"a":[1,2]}'), '$.a[1]'), jsonb('{"a":1}') -> '$.a', typeof(jsonb_extract('{"a":[1]}', '$.a')), hex(jsonb_extract('{"a":[1]}', '$.a'));
2|'1'|'blob'|'2B1331'
> SELECT jsonb_extract('{"a":[1],"b":"x"}', '$.b'), hex(jsonb_extract('{"a":[1],"b":"x"}', '$.a', '$.b'));
'x'|'5B2B13311778'
> SELECT json_type(jsonb('{"a":1}')), json_valid(jsonb('[1]')), json_valid(x'00'), json_valid(jsonb('[1]'), 4), json_valid('[1]', 8), json_valid('[1]', 6), json_valid(x'0c', 4);
'object'|0|0|1|0|1|1
> SELECT json_valid('[1]', 0);
error
> SELECT json_valid('[1]', 16);
error
> SELECT json_patch('{"a":1,"b":{"c":2}}', '{"b":{"c":null,"d":3},"e":4}');
'{"a":1,"b":{"d":3},"e":4}'
> SELECT json_patch('{"a":1}', '[2]'), json_patch('[1]', '{"a":{"b":null,"c":1}}'), json_patch(NULL, '{}');
'[2]'|'{"a":{"c":1}}'|NULL
> SELECT hex(jsonb_patch('{"a":1}', '{"b":2}'));
'8C1761133117621332'
> SELECT json_quote('a"b'), json_quote(1.5), json_quote(NULL), json_quote(json('[1]')), json_quote(3);
'"a\"b"'|'1.5'|'null'|'[1]'|'3'
> SELECT json_array(json_quote('x'));
'["x"]'
> SELECT json_error_position('{"a":1'), json_error_position('[1]'), json_error_position(x'00'), json_error_position('[1,]'), json_error_position('é[');
7|0|0|0|1
> SELECT hex(jsonb_group_array(x)) FROM (SELECT 1 x UNION ALL SELECT 'a');
'4B13311761'
> SELECT hex(jsonb_group_object(k, v)) FROM (SELECT 'a' k, 1 v UNION ALL SELECT 'b', 'two');
'AC1761133117623774776F'
> SELECT json_group_array(j) FROM (SELECT jsonb('[1,2]') j UNION ALL SELECT jsonb('{"x":null}'));
'[[1,2],{"x":null}]'
> SELECT json_array(jsonb('[1]'), jsonb('"s"'));
'[[1],"s"]'
> SELECT json_array(x'01ff');
error
> SELECT jsonb('bad');
error
> SELECT json(x'0102');
error
> SELECT hex(jsonb(NULL)), hex(jsonb(5)), hex(jsonb('5')), hex(jsonb(2.5));
''|'1335'|'1335'|'35322E35'
> SELECT key, value, type FROM json_each(jsonb('{"a":1,"b":[2]}'));
'a'|1|'integer'
'b'|'[2]'|'array'
> SELECT json_set(jsonb('{"a":1}'), '$.b', 2), hex(jsonb_insert('[1]', '$[#]', 2)), json(jsonb_replace('{"a":1}', '$.a', 'z')), hex(jsonb_remove('[1,2,3]', '$[1]'));
'{"a":1,"b":2}'|'4B13311332'|'{"a":"z"}'|'4B13311333'
> SELECT json_array_length(jsonb('[1,2,3]')), jsonb('[1,2]') ->> 1;
3|2
> CREATE TABLE d (id INTEGER PRIMARY KEY, body BLOB);
> INSERT INTO d (body) VALUES (jsonb('{"n":1,"tags":["x","y"]}')), (jsonb('{"n":2}'));
> SELECT id, body ->> '$.n', json_array_length(body, '$.tags') FROM d ORDER BY id;
1|1|2
2|2|NULL
> UPDATE d SET body = jsonb_set(body, '$.n', 10) WHERE id = 1;
> SELECT id, json(body) FROM d ORDER BY id;
1|'{"n":10,"tags":["x","y"]}'
2|'{"n":2}'
