> CREATE TABLE p (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT 'x', score REAL, UNIQUE (name, score));
> CREATE TABLE c (id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p (id) ON DELETE CASCADE, note, g AS (note || '!'), FOREIGN KEY (note) REFERENCES p (name) ON UPDATE SET NULL DEFERRABLE INITIALLY DEFERRED);
> CREATE INDEX c_pid ON c (pid DESC, note COLLATE NOCASE);
> CREATE UNIQUE INDEX c_part ON c (note) WHERE pid > 0;
> CREATE INDEX c_expr ON c (lower(note), pid);
> CREATE TABLE w (k TEXT, v, PRIMARY KEY (k, v)) WITHOUT ROWID;
