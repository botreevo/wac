> CREATE TABLE devices (id TEXT PRIMARY KEY, nickname TEXT);
> CREATE TABLE instances (id TEXT PRIMARY KEY, nickname TEXT, created_at INTEGER, approved_at INTEGER, requested_by TEXT);
> CREATE TABLE access (device_id TEXT NOT NULL, instance_id TEXT NOT NULL, granted_at INTEGER, PRIMARY KEY (device_id, instance_id));
> INSERT INTO devices VALUES ('d1', 'alice'), ('d2', 'bob'), ('d3', 'carol');
> INSERT INTO instances VALUES ('i1', 'home', 10, 11, 'd1'), ('i2', 'work', 20, NULL, 'd2'), ('i3', 'misc', 5, NULL, 'dx');
> INSERT INTO access VALUES ('d1', 'i1', 1), ('d2', 'i1', 2), ('d1', 'i2', 3);
> SELECT dia.device_id, d.nickname FROM access dia JOIN devices d ON d.id = dia.device_id WHERE dia.instance_id = 'i1' ORDER BY 1;
'd1'|'alice'
'd2'|'bob'
> SELECT i.id, i.nickname, d.nickname AS device_nickname FROM instances i LEFT JOIN devices d ON d.id = i.requested_by WHERE i.approved_at IS NULL ORDER BY i.created_at;
'i3'|'misc'|NULL
'i2'|'work'|'bob'
> SELECT instance_id FROM access WHERE device_id = 'd1' ORDER BY instance_id;
'i1'
'i2'
> SELECT id, nickname FROM instances WHERE id IN ('i1', 'i3') ORDER BY id;
'i1'|'home'
'i3'|'misc'
> SELECT d.nickname, count(a.instance_id) AS n FROM devices d LEFT JOIN access a ON a.device_id = d.id GROUP BY d.id ORDER BY n DESC, d.nickname;
'alice'|2
'bob'|1
'carol'|0
> SELECT instance_id, count(*) FROM access GROUP BY instance_id HAVING count(*) > 1;
'i1'|2
> SELECT DISTINCT instance_id FROM access ORDER BY instance_id;
'i1'
'i2'
> SELECT nickname FROM devices WHERE id IN (SELECT device_id FROM access WHERE instance_id = 'i2');
'alice'
> SELECT nickname FROM devices d WHERE EXISTS (SELECT 1 FROM access a WHERE a.device_id = d.id) ORDER BY nickname;
'alice'
'bob'
> SELECT nickname, (SELECT count(*) FROM access a WHERE a.device_id = d.id) FROM devices d ORDER BY 1;
'alice'|2
'bob'|1
'carol'|0
> SELECT max(granted_at), device_id FROM access;
3|'d1'
> SELECT * FROM (SELECT id, nickname FROM devices WHERE id > 'd1') sub ORDER BY id DESC;
'd3'|'carol'
'd2'|'bob'
> SELECT id FROM devices UNION SELECT device_id FROM access ORDER BY 1;
'd1'
'd2'
'd3'
> SELECT id FROM devices UNION ALL SELECT device_id FROM access ORDER BY 1 LIMIT 4;
'd1'
'd1'
'd1'
'd2'
> SELECT id FROM devices EXCEPT SELECT device_id FROM access;
'd3'
> SELECT id FROM devices INTERSECT SELECT device_id FROM access ORDER BY id;
'd1'
'd2'
> SELECT group_concat(id), group_concat(id, ';') FROM devices;
'd1,d2,d3'|'d1;d2;d3'
> SELECT count(DISTINCT device_id), count(*) FROM access;
2|3
> SELECT a.device_id, b.id FROM access a, instances b WHERE a.instance_id = b.id AND b.approved_at IS NOT NULL ORDER BY 1;
'd1'|'i1'
'd2'|'i1'
> SELECT nosuch FROM devices;
error
> SELECT * FROM nosuch;
error
> SELECT id FROM devices, instances;
error
> VALUES (1, 'a'), (2, 'b');
1|'a'
2|'b'
> SELECT 1 WHERE 0;
> SELECT count(*) FROM devices WHERE 0;
0
> SELECT sum(x) FROM (SELECT 1 AS x UNION ALL SELECT 2);
3
> CREATE TABLE events (id TEXT PRIMARY KEY, instance_id TEXT NOT NULL, seq INTEGER NOT NULL, type TEXT NOT NULL, payload TEXT NOT NULL, timestamp INTEGER NOT NULL, UNIQUE(instance_id, seq));
> INSERT INTO events VALUES ('e1', 'i1', 1, 'TimerAdded', '{"id":"t1","name":"a","currentExpiry":100}', 1000);
> INSERT INTO events VALUES ('e2', 'i1', 2, 'TimerCompleted', '{"id":"t1","closeReason":"pass","occurredAt":1500}', 2000);
> INSERT INTO events VALUES ('e3', 'i1', 3, 'TimerAdded', '{"id":"t2","name":"b","nested":{"x":[1,2.50,"s"]}}', 3000);
> INSERT INTO events VALUES ('e4', 'i2', 1, 'TimerAdded', '{"id":"t9"}', 500);
> INSERT INTO events VALUES ('e5', 'i1', 4, 'TimerRecurred', '{"id":"t2","closeReason":"fail"}', 4000);
> SELECT MAX(seq) as max_seq FROM events WHERE instance_id = 'i1';
4
> SELECT MAX(seq) as max_seq FROM events WHERE instance_id = 'i1' AND timestamp < 2500;
2
> SELECT MAX(seq) FROM events WHERE instance_id = 'nope';
NULL
> SELECT id, seq FROM events WHERE instance_id = 'i1' AND seq < 4 ORDER BY seq DESC LIMIT 2;
'e3'|3
'e2'|2
> SELECT id, seq FROM events WHERE instance_id = 'i1' AND seq >= 2 AND seq <= 3 ORDER BY seq;
'e2'|2
'e3'|3
> SELECT id FROM events WHERE instance_id = 'i1' AND type IN ('TimerCompleted', 'TimerRemoved') AND json_extract(payload, '$.id') = 't1' ORDER BY seq DESC;
'e2'
> SELECT id, type, COALESCE(JSON_EXTRACT(payload, '$.occurredAt'), timestamp) AS at FROM events WHERE instance_id = 'i1' AND type IN ('TimerCompleted', 'TimerRecurred') AND COALESCE(JSON_EXTRACT(payload, '$.occurredAt'), timestamp) >= 1000 ORDER BY COALESCE(JSON_EXTRACT(payload, '$.occurredAt'), timestamp);
'e2'|'TimerCompleted'|1500
'e5'|'TimerRecurred'|4000
> SELECT payload FROM events WHERE instance_id = 'i1' AND type = 'TimerAdded' AND JSON_EXTRACT(payload, '$.id') IN ('t1', 't2') ORDER BY seq;
'{"id":"t1","name":"a","currentExpiry":100}'
'{"id":"t2","name":"b","nested":{"x":[1,2.50,"s"]}}'
> SELECT json_extract(payload, '$.nested'), json_extract(payload, '$.nested.x[1]'), json_extract(payload, '$.nested.x[#-1]'), json_extract(payload, '$.missing') FROM events WHERE id = 'e3';
'{"x":[1,2.50,"s"]}'|2.5|'s'|NULL
> SELECT payload -> '$.nested', payload ->> 'name', payload ->> '$.nested.x[0]' FROM events WHERE id = 'e3';
'{"x":[1,2.50,"s"]}'|'b'|1
> UPDATE events SET payload = json_set(payload, '$.legacySkipped', json('true')) WHERE id = 'e2';
> SELECT payload FROM events WHERE id = 'e2';
'{"id":"t1","closeReason":"pass","occurredAt":1500,"legacySkipped":true}'
> SELECT id FROM events WHERE payload LIKE '%"legacySkipped":true%';
'e2'
> SELECT json_set('{"a":1}', '$.b', 'text', '$.c.d', 2), json_insert('[1,2]', '$[#]', 3), json_replace('{"a":1}', '$.a', json('[1]'), '$.z', 1);
'{"a":1,"b":"text","c":{"d":2}}'|'[1,2,3]'|'{"a":[1]}'
> SELECT json_remove('{"a":1,"b":[1,2]}', '$.b[0]'), json_object('a', 1, 'b', 'x', 'c', json('{}')), json_array(1, 'two', NULL, 2.5);
'{"a":1,"b":[2]}'|'{"a":1,"b":"x","c":{}}'|'[1,"two",null,2.5]'
> SELECT json('{"a" : [1, 2.0, "x"] }'), json_valid('{'), json_type('{"a":[]}', '$.a'), json_array_length('[1,2,3]');
'{"a":[1,2.0,"x"]}'|0|'array'|3
> SELECT json_extract('{"a":"he said \"hi\"\n"}', '$.a'), json_extract('{"a":"é"}', '$.a');
'he said "hi"
'|'é'
> SELECT type, count(*) FROM events GROUP BY type ORDER BY type;
'TimerAdded'|3
'TimerCompleted'|1
'TimerRecurred'|1
> SELECT instance_id, seq FROM events ORDER BY instance_id, seq DESC;
'i1'|4
'i1'|3
'i1'|2
'i1'|1
'i2'|1
> DELETE FROM events WHERE instance_id = 'i1' AND seq >= 3;
> SELECT id FROM events ORDER BY id;
'e1'
'e2'
'e4'
> CREATE TABLE m (g TEXT, v INTEGER, w);
> CREATE INDEX m_gv ON m (g, v);
> INSERT INTO m VALUES ('a', NULL, 1), ('a', 3, 2), ('a', 1, 3), ('b', NULL, 4), ('a', 2, NULL);
> SELECT min(v), w FROM m WHERE g = 'a';
1|3
> SELECT max(v), w FROM m WHERE g = 'a';
3|2
> SELECT max(v) FROM m WHERE g = 'b';
NULL
> SELECT min(v) FROM m WHERE g = 'zz';
NULL
> SELECT max(v) FROM m WHERE g = 'a' AND w < 3;
3
> SELECT max(rowid), min(rowid) FROM m;
5|1
> SELECT v FROM m WHERE g = 'a' ORDER BY v DESC LIMIT 2;
3
2
> SELECT v FROM m WHERE g = 'a' ORDER BY v LIMIT 2;
NULL
1
> SELECT v FROM m WHERE g = 'a' AND v > 1 ORDER BY v;
2
3
> SELECT v FROM m WHERE g = 'a' AND v < 3 ORDER BY v DESC;
2
1
> SELECT g, v FROM m WHERE v IS NULL ORDER BY g;
'a'|NULL
'b'|NULL
