> CREATE TABLE acct (id INTEGER PRIMARY KEY, owner TEXT, bal INTEGER);
> CREATE TABLE log (seq INTEGER PRIMARY KEY, what TEXT);
> CREATE TRIGGER acct_ins AFTER INSERT ON acct BEGIN INSERT INTO log (what) VALUES ('ins ' || new.owner || ' ' || new.bal); END;
> CREATE TRIGGER acct_upd AFTER UPDATE OF bal ON acct WHEN new.bal <> old.bal BEGIN INSERT INTO log (what) VALUES ('bal ' || old.bal || '->' || new.bal); END;
> CREATE TRIGGER acct_del BEFORE DELETE ON acct BEGIN INSERT INTO log (what) VALUES ('del ' || old.owner); END;
> CREATE TRIGGER acct_neg BEFORE UPDATE ON acct WHEN new.bal < 0 BEGIN SELECT RAISE(ABORT, 'overdrawn'); END;
> CREATE TRIGGER acct_skip BEFORE INSERT ON acct WHEN new.owner = 'nobody' BEGIN SELECT RAISE(IGNORE); END;
> INSERT INTO acct (owner, bal) VALUES ('ann', 10), ('bob', 20);
> INSERT INTO acct (owner, bal) VALUES ('nobody', 5);
> UPDATE acct SET bal = bal + 5;
> UPDATE acct SET owner = 'Ann' WHERE id = 1;
> UPDATE acct SET bal = bal WHERE id = 2;
> UPDATE acct SET bal = -1 WHERE id = 1;
error
