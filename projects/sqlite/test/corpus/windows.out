'b'|'eve,dee'
'c'|'fay'
> SELECT group_concat(name, ';' ORDER BY name DESC) FROM s;
'gus;fay;eve;dee;cid;bob;ann'
> SELECT json_group_array(name) FROM s WHERE dept = 'a';
'["ann","bob","cid","gus"]'
> SELECT dept, json_group_object(name, pay) FROM s GROUP BY dept ORDER BY dept;
'a'|'{"ann":10,"bob":20,"cid":20,"gus":30}'
'b'|'{"dee":5,"eve":15}'
'c'|'{"fay":null}'
> SELECT json_group_array(json_object('n', name)) FROM s WHERE pay > 15;
'[{"n":"bob"},{"n":"cid"},{"n":"gus"}]'
> SELECT name FROM s WHERE row_number() OVER () > 1;
error
> SELECT name, row_number() OVER (ORDER BY id) AS rn FROM s ORDER BY rn DESC LIMIT 3;
'gus'|7
'fay'|6
'eve'|5
> SELECT name, sum(pay) OVER nosuch FROM s;
error
> SELECT abs(pay) OVER () FROM s;
error
> SELECT upper(name) FILTER (WHERE 1) FROM s;
error
> SELECT DISTINCT dept, count(*) OVER (PARTITION BY dept) FROM s ORDER BY 1;
'a'|4
'b'|2
'c'|1
> CREATE TABLE wo (id INTEGER PRIMARY KEY, g, v);
> INSERT INTO wo (g, v) VALUES (1, 5), (2, 3), (1, 1), (2, 9), (1, 4);
> SELECT id, sum(v) OVER (ORDER BY v) FROM wo;
3|1
2|4
5|8
1|13
4|22
> SELECT id, sum(v) OVER (PARTITION BY g) FROM wo;
1|10
3|10
5|10
2|12
4|12
> SELECT id, sum(v) OVER (PARTITION BY g ORDER BY v DESC) FROM wo;
1|5
5|9
3|10
4|9
2|12
> SELECT id, sum(v) OVER (ORDER BY v), count(*) OVER (ORDER BY id DESC) FROM wo;
3|1|3
2|4|4
5|8|1
1|13|5
4|22|2
> SELECT id, count(*) OVER (ORDER BY id DESC), sum(v) OVER (ORDER BY v) FROM wo;
