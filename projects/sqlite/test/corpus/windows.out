'bob'|0.666666666666667|0.857142857142857
'cid'|0.666666666666667|0.857142857142857
'dee'|0.166666666666667|0.285714285714286
'eve'|0.5|0.571428571428571
'fay'|0.0|0.142857142857143
'gus'|1.0|1.0
