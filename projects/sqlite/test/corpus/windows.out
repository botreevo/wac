'fay'|0
'gus'|3
> SELECT dept, count(*) FILTER (WHERE pay >= 20), sum(pay) FILTER (WHERE name < 'c') FROM s GROUP BY dept ORDER BY dept;
'a'|3|30
'b'|0|NULL
'c'|0|NULL
> SELECT dept, group_concat(name ORDER BY pay DESC, name) FROM s GROUP BY dept ORDER BY dept;
