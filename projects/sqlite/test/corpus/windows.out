4|2|22
3|3|1
2|4|4
1|5|13
> SELECT id, row_number() OVER (PARTITION BY g), sum(v) OVER (PARTITION BY g ORDER BY id) FROM wo;
1|1|5
3|2|6
5|3|10
2|1|3
4|2|12
> SELECT id, sum(v) OVER w, max(v) OVER (ORDER BY g) FROM wo WINDOW w AS (ORDER BY v);
3|1|5
2|4|9
5|8|5
1|13|5
4|22|9
> SELECT g, sum(v) OVER (ORDER BY g DESC) FROM wo ORDER BY g;
1|22
1|22
1|22
2|12
2|12
> create table wa(id integer primary key, g, v);
> insert into wa(g,v) values (1,'r1'),(0,'r2'),(1,'r3'),(0,'r4'),(2,'r5');
> select id, first_value(v) over () from wa;
1|'r1'
2|'r1'
3|'r1'
4|'r1'
5|'r1'
> select id, first_value(v) over (), row_number() over (order by g, id) from wa;
