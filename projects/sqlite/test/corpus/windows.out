> CREATE TABLE s (id INTEGER PRIMARY KEY, dept TEXT, name TEXT, pay INTEGER);
> INSERT INTO s (dept, name, pay) VALUES ('a', 'ann', 10), ('a', 'bob', 20), ('a', 'cid', 20), ('b', 'dee', 5), ('b', 'eve', 15), ('c', 'fay', NULL), ('a', 'gus', 30);
> SELECT name, row_number() OVER (ORDER BY pay, name) FROM s ORDER BY name;
'ann'|3
'bob'|5
'cid'|6
'dee'|2
'eve'|4
'fay'|1
'gus'|7
> SELECT name, dept, rank() OVER (PARTITION BY dept ORDER BY pay DESC), dense_rank() OVER (PARTITION BY dept ORDER BY pay DESC) FROM s ORDER BY dept, name;
