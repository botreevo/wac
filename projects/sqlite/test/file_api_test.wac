// A database file opened, changed and reopened through SqliteFile.

import { Vec, flatten } from "core";
import { Sys } from "std";
import { Check } from "./check.wac";
import { SqliteFile } from "../src/file.wac";
import { Value } from "../src/value.wac";
import { Rows } from "../src/plan.wac";

export string test_changes_survive_reopening(Sys sys) {
  Check t = Check.create();
  string path = "dist/file_api_test.db";
  sys.files().mkdir("dist", true).wait();
  sys.files().remove(path, false).wait();
  SqliteFile f = SqliteFile.open(sys.files(), path).unwrap();
  t.ok(f.exec("CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)").isOk(), "create");
  t.ok(f.execute("INSERT INTO t (name) VALUES (?)", [Value.Text("a")]).isOk(), "insert a");
  t.ok(f.exec("BEGIN; INSERT INTO t (name) VALUES ('b');").isOk(), "insert b in a transaction");
  // Nothing is written while the transaction is open.
  SqliteFile mid = SqliteFile.open(sys.files(), path).unwrap();
  Rows midRows = mid.conn.execute("SELECT count(*) FROM t", Value[]()).unwrap();
  match (midRows.rows.get(0)[0]) { Int(n): { t.eqI64(n, 1, "rows before commit"); } default: {} }
  t.ok(f.exec("COMMIT").isOk(), "commit");
  SqliteFile again = SqliteFile.open(sys.files(), path).unwrap();
  Rows rows = again.conn.execute("SELECT id, name FROM t ORDER BY id", Value[]()).unwrap();
  t.eqI64(rows.rows.len() as i64, 2, "rows after reopening");
  match (rows.rows.get(1)[1]) { Text(s): { t.eqStr(s, "b", "second row"); } default: { t.ok(false, "text"); } }
  return t.report();
}
