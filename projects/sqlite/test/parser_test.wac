import { Check } from "./check.wac";
import { parseOne, Parsed } from "../src/parser.wac";
import { Stmt } from "../src/ast.wac";

string ok(string sql) {
  return match (parseOne(sql)) { Ok(p): "", Err(e): sql + " -> " + e.describe() + "\n" };
}

export string test_autonags_statements_parse() {
  string f = "";
  string[] all = [
    "SELECT MAX(seq) as max_seq FROM events WHERE instance_id = ? AND timestamp < ?",
    "SELECT dia.device_id, d.nickname FROM device_instance_access dia JOIN devices d ON d.id = dia.device_id WHERE dia.instance_id = ?",
    "SELECT i.id, i.nickname, i.created_at, i.requested_by, d.nickname AS device_nickname FROM instances i LEFT JOIN devices d ON d.id = i.requested_by WHERE i.approved_at IS NULL ORDER BY i.created_at",
    "SELECT id FROM events WHERE instance_id = ? AND payload LIKE '%\"legacySkipped\":true%'",
    "SELECT id, instance_id, seq, type, payload, timestamp FROM events WHERE instance_id = ? AND seq < ? ORDER BY seq DESC LIMIT ?",
    "SELECT id, nickname, created_at, approved_at FROM instances WHERE id IN (?, ?, ?)",
    "SELECT id, type, payload, timestamp FROM events WHERE instance_id = ? AND type IN ('TimerCompleted', 'TimerRecurred') AND COALESCE(JSON_EXTRACT(payload, '$.occurredAt'), timestamp) >= ? ORDER BY COALESCE(JSON_EXTRACT(payload, '$.occurredAt'), timestamp)",
    "INSERT OR IGNORE INTO device_instance_access (device_id, instance_id, granted_at) VALUES (?, ?, ?)",
    "INSERT OR REPLACE INTO snapshots (id, instance_id, seq, state, created_at) VALUES (?, ?, ?, ?, ?)",
    "INSERT INTO instance_access_requests (id, instance_id, device_id, requested_at, status) VALUES (?, ?, ?, ?, 'pending') ON CONFLICT(instance_id, device_id) DO UPDATE SET status = 'pending', requested_at = excluded.requested_at, resolved_at = NULL",
    "UPDATE events SET payload = json_set(payload, '$.legacySkipped', json('true')) WHERE id = ?",
    "DELETE FROM snapshots WHERE instance_id = ? AND seq >= ?",
    "ALTER TABLE instances ADD COLUMN requested_by TEXT REFERENCES devices(id) ON DELETE SET NULL",
    "CREATE TABLE IF NOT EXISTS schema_version (version INTEGER NOT NULL)",
    "CREATE TABLE events (id TEXT PRIMARY KEY, instance_id TEXT NOT NULL REFERENCES instances(id) ON DELETE CASCADE, seq INTEGER NOT NULL, type TEXT NOT NULL, payload TEXT NOT NULL, timestamp INTEGER NOT NULL, UNIQUE(instance_id, seq))",
    "CREATE TABLE import_logs (id INTEGER PRIMARY KEY AUTOINCREMENT, details TEXT)",
    "CREATE INDEX IF NOT EXISTS idx_events_instance_seq ON events(instance_id, seq)",
    "PRAGMA journal_mode=WAL",
    "BEGIN IMMEDIATE",
    "SELECT CASE WHEN a > 1 THEN 'x' ELSE -1 END, CAST(b AS INTEGER), x NOT BETWEEN 1 AND 2, y IS NOT NULL FROM t",
    "SELECT count(*), count(DISTINCT a) FROM t GROUP BY b HAVING count(*) > 1 LIMIT 10 OFFSET 5",
    "SELECT * FROM a UNION ALL SELECT * FROM b ORDER BY 1",
  ];
  for (string s in all) { f += ok(s); }
  return f;
}

export string test_the_schema_text_drops_if_not_exists() {
  Check t = Check.create();
  match (parseOne("create table if not exists x (a, b)").unwrap().stmt) {
    CreateTableStmt(c): { t.eqStr(c.sql, "CREATE TABLE x (a, b)", "sql"); t.eqI64(c.cols.len() as i64, 2, "cols"); }
    default: { t.ok(false, "kind"); }
  }
  return t.report();
}

export string test_parameters_are_numbered() {
  Check t = Check.create();
  t.eqI64(parseOne("SELECT ?, ?, ?5, :a, :a, ?").unwrap().params as i64, 7, "count");
  return t.report();
}

export string test_errors_are_values() {
  Check t = Check.create();
  t.ok(parseOne("SELEC 1") is not null, "x");
  match (parseOne("SELECT FROM")) { Ok: { t.ok(false, "should fail"); } Err(e): { t.eqStr(e.code, "syntax", "code"); } }
  match (parseOne("SELECT 'abc")) { Ok: { t.ok(false, "should fail"); } Err(e): { t.eqStr(e.code, "syntax", "code"); } }
  return t.report();
}
