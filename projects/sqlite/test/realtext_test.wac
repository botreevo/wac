// A real as text, against what SQLite 3.53 answered for CAST(x AS TEXT).
import { Check } from "./check.wac";
import { realText } from "../src/format.wac";

export string test_reals_as_text_match_sqlite() {
  Check t = Check.create();
  t.eqStr(realText(0.1 + 0.2), "0.30000000000000004", "0.1+0.2");
  t.eqStr(realText(1.0 / 3.0), "0.33333333333333332", "1/3");
  t.eqStr(realText(0.1), "0.1", "0.1");
  t.eqStr(realText(1e20), "1.0e+20", "1e20");
  t.eqStr(realText(123456789012345678.0), "1.2345678901234568e+17", "1.23e17");
  t.eqStr(realText(1e15), "1000000000000000.0", "1e15");
  t.eqStr(realText(1e16), "10000000000000000.0", "1e16");
  t.eqStr(realText(1e17), "1.0e+17", "1e17");
  t.eqStr(realText(12345678901234567.0), "12345678901234568.0", "17 digits");
  t.eqStr(realText(1e-5), "1.0e-05", "1e-5");
  t.eqStr(realText(0.00012345), "0.00012345", "1.2345e-4");
  t.eqStr(realText(1.0 / 7.0), "0.14285714285714285", "1/7");
  t.eqStr(realText(2.0 / 3.0 * 1e-5), "6.6666666666666667e-06", "2/3e-5");
  t.eqStr(realText(2.0 / 3.0 * 1e-4), "6.666666666666667e-05", "2/3e-4");
  t.eqStr(realText(5e-324), "4.9406564584124654e-324", "smallest");
  t.eqStr(realText(1.7976931348623157e308), "1.7976931348623157e+308", "largest");
  t.eqStr(realText(9223372036854775807.0), "9.2233720368547758e+18", "2^63");
  t.eqStr(realText(-2.5), "-2.5", "-2.5");
  return t.report();
}
