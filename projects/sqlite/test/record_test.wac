// Varints and records round-trip, and decode bytes SQLite itself wrote.

import { Buf } from "core";
import { Check } from "./check.wac";
import { readVarint, pushVarint, varintLen } from "../src/bytes.wac";
import { Value, compareValues } from "../src/value.wac";
import { encodeRecord, decodeRecord } from "../src/record.wac";

export string test_varints_round_trip_at_every_width() {
  Check t = Check.create();
  i64[] xs = [0, 1, 127, 128, 16383, 16384, 2097151, 2097152, 0xFFFFFFFF, 0x00FFFFFFFFFFFFFF,
              0x0100000000000000, -1, -9223372036854775807 - 1, 9223372036854775807];
  for (i64 x in xs) {
    Buf b = Buf.create();
    pushVarint(b, x);
    u8[] bytes = b.take();
    t.eqI64(bytes.len() as i64, varintLen(x) as i64, "length of \{x}");
    t.eqI64(readVarint(bytes, 0).value, x, "value of \{x}");
    t.eqI64(readVarint(bytes, 0).size as i64, bytes.len() as i64, "size of \{x}");
  }
  return t.report();
}

export string test_records_round_trip() {
  Check t = Check.create();
  Value[] vals = [Value.Null, Value.Int(0), Value.Int(1), Value.Int(-2), Value.Int(300),
                  Value.Int(9223372036854775807), Value.Real(1.5), Value.Text("héllo"),
                  Value.Blob([1, 2, 3])];
  Value[]? back = decodeRecord(encodeRecord(vals));
  t.ok(back is not null, "decodes");
  t.eqI64(back!.len() as i64, vals.len() as i64, "count");
  for (i32 i = 0; i < vals.len(); i++) {
    t.ok(compareValues(back![i], vals[i]) == 0, "value \{i}");
  }
  return t.report();
}

// A record of (NULL, 5, 'ab', 2.0) as SQLite lays it out: header size 5, serial types 0, 1, 17, 7,
// then the one-byte integer, the two text bytes and the big-endian double.
export string test_a_record_in_sqlites_layout() {
  Check t = Check.create();
  u8[] rec = [5, 0, 1, 17, 7, 5, 97, 98, 0x40, 0, 0, 0, 0, 0, 0, 0];
  Value[] v = decodeRecord(rec)!;
  t.eqI64(v.len() as i64, 4, "count");
  t.ok(compareValues(v[1], Value.Int(5)) == 0, "int");
  t.ok(compareValues(v[2], Value.Text("ab")) == 0, "text");
  t.ok(compareValues(v[3], Value.Real(2.0)) == 0, "real");
  t.ok(encodeRecord(v).len() == rec.len(), "re-encodes to the same size");
  return t.report();
}

export string test_ordering_across_classes() {
  Check t = Check.create();
  t.ok(compareValues(Value.Null, Value.Int(-5)) < 0, "null first");
  t.ok(compareValues(Value.Int(2), Value.Real(1.5)) > 0, "int against real");
  t.ok(compareValues(Value.Real(3.0), Value.Int(3)) == 0, "3.0 = 3");
  t.ok(compareValues(Value.Int(9), Value.Text("1")) < 0, "numbers before text");
  t.ok(compareValues(Value.Text("b"), Value.Blob([0])) < 0, "text before blob");
  t.ok(compareValues(Value.Text("a"), Value.Text("ab")) < 0, "prefix first");
  return t.report();
}
