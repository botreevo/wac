// Rough timings: inserting events, querying them, and writing the file image.
// `wac run tools/bench.wac -- 20000`

import { Sys } from "std";
import { Connection } from "../src/engine.wac";
import { Value } from "../src/value.wac";
import { decimalI64 } from "../src/parser.wac";

i64 now(Sys sys) { return sys.clock().nowMillis().wait().unwrap().unwrap(); }

export i32 main(Sys sys) {
  string[] args = sys.args();
  i32 n = args.len() > 0 ? decimalI64(args[0])! as! i32 : 10000;
  Connection c = Connection.memory();
  c.exec("CREATE TABLE events (id TEXT PRIMARY KEY, instance_id TEXT NOT NULL, seq INTEGER NOT NULL, type TEXT NOT NULL, payload TEXT NOT NULL, timestamp INTEGER NOT NULL, UNIQUE (instance_id, seq)); CREATE INDEX events_by_instance_seq ON events(instance_id, seq);").unwrap();
  i64 t0 = now(sys);
  c.exec("BEGIN").unwrap();
  for (i32 i = 0; i < n; i++) {
    c.execute("INSERT INTO events (id, instance_id, seq, type, payload, timestamp) VALUES (?, ?, ?, ?, ?, ?)",
              [Value.Text("event-\{i}"), Value.Text(i % 5 == 0 ? "i2" : "i1"), Value.Int(i as i64), Value.Text("TimerAdded"),
               Value.Text("{\"id\":\"t\{i % 50}\",\"name\":\"timer number \{i}\",\"currentExpiry\":\{1700000000000 + (i as i64)}}"),
               Value.Int(1700000000000 + (i as i64))]).unwrap();
  }
  c.exec("COMMIT").unwrap();
  i64 t1 = now(sys);
  sys.stdout().line("insert \{n} rows: \{t1 - t0} ms").wait();
  for (i32 i = 0; i < 100; i++) {
    c.execute("SELECT MAX(seq) FROM events WHERE instance_id = ?", [Value.Text("i1")]).unwrap();
  }
  i64 t2 = now(sys);
  sys.stdout().line("100 x MAX(seq) by instance: \{t2 - t1} ms").wait();
  for (i32 i = 0; i < 100; i++) {
    c.execute("SELECT id, seq, payload FROM events WHERE instance_id = ? AND seq >= ? ORDER BY seq", [Value.Text("i1"), Value.Int((n - 200) as i64)]).unwrap();
  }
  i64 t3 = now(sys);
  sys.stdout().line("100 x tail range (~160 rows): \{t3 - t2} ms").wait();
  for (i32 i = 0; i < 10; i++) {
    c.execute("SELECT count(*) FROM events WHERE json_extract(payload, '$.id') = ?", [Value.Text("t7")]).unwrap();
  }
  i64 t4 = now(sys);
  sys.stdout().line("10 x full scan with json_extract: \{t4 - t3} ms").wait();
  u8[] img = c.image();
  i64 t5 = now(sys);
  sys.stdout().line("image of \{img.len()} bytes: \{t5 - t4} ms").wait();
  return 0;
}
