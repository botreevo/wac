// Random inserts and deletes on a table b-tree and an index b-tree, checked against a plain model after
// every step, then written out as a database for the real SQLite to check: `wac run --allow-write
// tools/btreefuzz.wac [seed] [steps]` writes dist/btree.db and dist/btree.txt (what it should hold).

import { Sys } from "std";
import { Vec, Map, Buf, hashI64, i64Eq, flatten } from "core";
import { Pager } from "../src/pager.wac";
import { startDatabase, createTree, tableInsert, tableDelete, indexInsert, indexDelete, Cursor, KeyCmp, countEntries } from "../src/btree.wac";
import { Value, compareValues } from "../src/value.wac";
import { encodeRecord, decodeRecord } from "../src/record.wac";
import { put32, put16 } from "../src/bytes.wac";

struct Rng {
  u64 s;
  i32 below(this, i32 n) {
    this.s = this.s * 6364136223846793005 + 1442695040888963407;
    return ((this.s >> 33) % (n as! u64)) as! i32;
  }
}

i32 cmpRec(const u8[] a, const u8[] b) {
  Value[] x = decodeRecord(a)!;
  Value[] y = decodeRecord(b)!;
  for (i32 i = 0; i < x.len() && i < y.len(); i++) {
    i32 c = compareValues(x[i], y[i]);
    if (c != 0) { return c; }
  }
  return x.len() - y.len();
}

KeyCmp cmpOf(u8[] target) { return (u8[] s) => cmpRec(s, target); }

string text(Rng r, i32 n) {
  Buf b = Buf.create();
  for (i32 i = 0; i < n; i++) { b.push(('a' as i32 + r.below(26)) as@ u8); }
  return b.toStr();
}

export i32 main(Sys sys) {
  string[] args = sys.args();
  i64 seed = args.len() > 0 ? num(args[0]) : 1;
  i32 steps = args.len() > 1 ? (num(args[1]) as! i32) : 2000;
  Rng r = Rng(seed as@ u64);
  i32[] sizes = [512, 1024, 4096];
  i32 ps = sizes[(seed % 3) as! i32];
  i32 range = seed % 2 == 0 ? 400 : 4000;
  Pager pg = Pager.memory(ps);
  startDatabase(pg);
  i64 troot = createTree(pg, true);
  i64 iroot = createTree(pg, false);
  Map<i64, u8[]> rows = Map.create(hashI64, i64Eq);
  Vec<u8[]> keys;   // the index's records, unsorted
  i32 bad = 0;
  // Savepoints: every so often the pages go back to how they were, and the model with them.
  i32 sp = -1;
  Map<i64, u8[]> rowsAt = Map.create(hashI64, i64Eq);
  Vec<u8[]> keysAt;
  i32 rollbacks = 0;
  for (i32 step = 0; step < steps; step++) {
    if (step % 137 == 0) {
      if (sp >= 0 && r.below(2) == 0) {
        pg.rollbackTo(sp);
        rows = Map.create(hashI64, i64Eq);
        for (i64 x in rowsAt.keys()) { rows.set(x, rowsAt.get(x)!); }
        keys = Vec.create();
        for (i32 i = 0; i < keysAt.len(); i++) { keys.push(keysAt.get(i)); }
        rollbacks++;
      }
      if (sp >= 0 && r.below(3) == 0) { pg.release(sp); sp = -1; }
      if (sp < 0 || r.below(2) == 0) {
        sp = pg.savepoint();
        rowsAt = Map.create(hashI64, i64Eq);
        for (i64 x in rows.keys()) { rowsAt.set(x, rows.get(x)!); }
        keysAt = Vec.create();
        for (i32 i = 0; i < keys.len(); i++) { keysAt.push(keys.get(i)); }
      }
    }
    // Mostly adding for the first half, mostly removing after.
    i32 op = r.below(10);
    if (step > steps / 2 && op < 3) { op = op + 4; }
    i64 id = (r.below(range) + 1) as i64;
    if (op < 4) {
      i32 len = r.below(10) == 0 ? r.below(ps * 3) : r.below(60);
      u8[] p = encodeRecord([Value.Int(id), Value.Text(text(r, len))]);
      tableInsert(pg, troot, id, p);
      rows.set(id, p);
    } else if (op < 6) {
      bool had = tableDelete(pg, troot, id);
      if (had != rows.has(id)) { sys.stdout().line("step \{step}: delete \{id} answered \{had}").wait(); bad++; }
      rows.remove(id);
    } else if (op < 8) {
      i32 len = r.below(8) == 0 ? r.below(ps) : r.below(30);
      u8[] k = encodeRecord([Value.Text(text(r, len)), Value.Int(id)]);
      indexInsert(pg, iroot, k, cmpOf(k));
      bool dup = false;
      for (i32 i = 0; i < keys.len(); i++) { if (cmpRec(keys.get(i), k) == 0) { dup = true; } }
      if (!dup) { keys.push(k); }
    } else if (keys.len() > 0) {
      i32 at = r.below(keys.len());
      u8[] k = keys.get(at);
      if (!indexDelete(pg, iroot, cmpOf(k), cmpOf)) { sys.stdout().line("step \{step}: index delete missed").wait(); bad++; }
      keys.swapRemove(at);
    }
    if (pg.fault is not null) { sys.stdout().line("step \{step}: fault \{pg.fault!}").wait(); return 1; }
    if (step % 50 == 0 || step == steps - 1) {
      // The table, both ways.
      i64[] ids = rows.keys();
      sortIds(ids);
      Cursor c = Cursor.over(pg, troot, true);
      i32 n = 0;
      bool ok = c.first();
      while (ok) {
        if (n >= ids.len() || c.rowid != ids[n] || cmpRec(c.payload, rows.get(ids[n])!) != 0) { bad++; break; }
        n++;
        ok = c.next();
      }
      if (n != ids.len()) { sys.stdout().line("step \{step}: forward scan saw \{n} of \{ids.len()}").wait(); bad++; }
      n = ids.len() - 1;
      ok = c.last();
      while (ok) {
        if (n < 0 || c.rowid != ids[n]) { bad++; break; }
        n--;
        ok = c.prev();
      }
      if (n != -1) { sys.stdout().line("step \{step}: backward scan stopped at \{n}").wait(); bad++; }
      if (countEntries(pg, troot) != ids.len() as i64) { sys.stdout().line("step \{step}: count").wait(); bad++; }
      // Seeks.
      for (i32 q = 0; q < 20; q++) {
        i64 want = (r.below(range + 20)) as i64;
        i64 expect = -1;
        for (i64 x in ids) { if (x >= want && (expect < 0 || x < expect)) { expect = x; } }
        bool got = c.seekRowid(want);
        if (got != (expect >= 0) || (got && c.rowid != expect)) { sys.stdout().line("step \{step}: seek \{want}").wait(); bad++; }
      }
      // The index, in order, both ways.
      u8[][] ks = keys.toArray();
      sortRecs(ks);
      Cursor ic = Cursor.over(pg, iroot, false);
      ic.cmpOf = cmpOf;
      n = 0;
      ok = ic.first();
      while (ok) {
        if (n >= ks.len() || cmpRec(ic.payload, ks[n]) != 0) { bad++; break; }
        n++;
        ok = ic.next();
      }
      if (n != ks.len()) { sys.stdout().line("step \{step}: index scan saw \{n} of \{ks.len()}").wait(); bad++; }
      n = ks.len() - 1;
      ok = ic.last();
      while (ok) {
        if (n < 0 || cmpRec(ic.payload, ks[n]) != 0) { bad++; break; }
        n--;
        ok = ic.prev();
      }
      if (n != -1) { sys.stdout().line("step \{step}: index backward stopped at \{n}").wait(); bad++; }
      if (countEntries(pg, iroot) != ks.len() as i64) { sys.stdout().line("step \{step}: index count").wait(); bad++; }
    }
    if (bad > 0) { return 1; }
  }
  // A cursor stays usable while the tree changes under it: walk the table deleting every other row.
  Cursor w = Cursor.over(pg, troot, true);
  bool more = w.first();
  i32 k = 0;
  while (more) {
    if (k % 2 == 0) { tableDelete(pg, troot, w.rowid); rows.remove(w.rowid); }
    k++;
    more = w.next();
  }
  if (countEntries(pg, troot) != rows.len() as i64) { sys.stdout().line("delete while walking left \{countEntries(pg, troot)}, want \{rows.len()}").wait(); return 1; }
  // The schema, and the file header.
  tableInsert(pg, 1, 1, encodeRecord([Value.Text("table"), Value.Text("t"), Value.Text("t"), Value.Int(troot), Value.Text("CREATE TABLE t(a, b)")]));
  tableInsert(pg, 1, 2, encodeRecord([Value.Text("table"), Value.Text("ix"), Value.Text("ix"), Value.Int(iroot), Value.Text("CREATE TABLE ix(k, id, PRIMARY KEY (k, id)) WITHOUT ROWID")]));
  u8[] h = pg.write(1);
  u8[] magic = "SQLite format 3\0".toBytes();
  h.copyFrom(magic, 0, 0, 16);
  put16(h, 16, ps);
  h[18] = 1; h[19] = 1; h[21] = 64; h[22] = 32; h[23] = 32;
  put32(h, 24, 1);
  put32(h, 28, pg.count);
  put32(h, 40, 1);
  put32(h, 44, 4);
  put32(h, 56, 1);
  put32(h, 92, 1);
  put32(h, 96, 3045000);
  u8[] img = u8[].filled((pg.count as! i32) * ps, 0);
  for (i64 p = 1; p <= pg.count; p++) { img.copyFrom(pg.page(p), 0, ((p - 1) as! i32) * ps, ps); }
  flatten(sys.files().writeFile("dist/btree.db", img).wait()).unwrap();
  Buf out = Buf.create();
  i64[] ids = rows.keys();
  sortIds(ids);
  for (i64 x in ids) { out.pushStr("\{x} \{decodeRecord(rows.get(x)!)!.len()}\n"); }
  out.pushStr("index \{keys.len()}\nfree \{pg.freeCount()}\n");
  flatten(sys.files().writeFile("dist/btree.txt", out.take()).wait()).unwrap();
  sys.stdout().line("ok: \{rollbacks} rollbacks, \{steps} steps, page size \{ps}, \{pg.count} pages, \{pg.freeCount()} free").wait();
  return 0;
}

void sortIds(i64[] a) {
  for (i32 i = 1; i < a.len(); i++) {
    i64 v = a[i];
    i32 j = i - 1;
    while (j >= 0 && a[j] > v) { a[j + 1] = a[j]; j--; }
    a[j + 1] = v;
  }
}

void sortRecs(u8[][] a) {
  for (i32 i = 1; i < a.len(); i++) {
    u8[] v = a[i];
    i32 j = i - 1;
    while (j >= 0 && cmpRec(a[j], v) > 0) { a[j + 1] = a[j]; j--; }
    a[j + 1] = v;
  }
}

i64 num(string s) {
  i64 v = 0;
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { v = v * 10 + (b[i] - '0') as i64; }
  return v;
}
