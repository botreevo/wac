// Prints what this library answers for a corpus script, in the .out format, for diffing by hand:
//     wac run --allow-read tools/corpus_run.wac -- test/corpus/fuzz.sql | diff - test/corpus/fuzz.out
import { Sys } from "std";
import { flatten } from "core";
import { run } from "../test/corpus_test.wac";

export i32 main(Sys sys) {
  string sql = string.fromBytes(flatten(sys.files().readFile(sys.args()[0]).wait()).unwrap());
  sys.stdout().write(run(sql).toBytes()).wait();
  return 0;
}
