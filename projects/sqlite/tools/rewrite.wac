// Reads a database (through its write-ahead log, if it has one) and writes it back through this
// library: `wac run --allow-read --allow-write tools/rewrite.wac -- in.db out.db`. tools/verify.py then
// asks the real SQLite what it thinks of out.db.

import { Sys } from "std";
import { flatten } from "core";
import { toBytes } from "../src/database.wac";
import { SqliteFile } from "../src/file.wac";

export i32 main(Sys sys) {
  string[] args = sys.args();
  if (args.len() != 2) { sys.stderr().line("usage: rewrite in.db out.db").wait(); return 2; }
  match (SqliteFile.open(sys.files(), args[0])) {
    Ok(f): {
      f.conn.db.changeCounter++;
      f.conn.db.schemaCookie++;
      match (flatten(sys.files().writeFile(args[1], toBytes(f.conn.db)).wait())) {
        Ok: { return 0; }
        Err(e): { sys.stderr().line("cannot write \{args[1]}").wait(); return 1; }
      }
    }
    Err(e): { sys.stderr().line(e.describe()).wait(); return 1; }
  }
}
