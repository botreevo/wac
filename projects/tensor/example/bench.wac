// CPU against GPU, in this browser: the same work timed on wac-tensor's CPU backend and on WebGPU, side by side. The
// workloads and their timing are `workloads.wac`'s. Served beside `mnist.weights`, which the digit model loads.

import { Page, Site, Element, ElementEvent, Listen } from "web";
import { Result, Ticket } from "core";
import { Device } from "../src/lib.wac";
import { gpuDevice } from "../src/gpu/backend.wac";
import { Bench, fmtMs, fmtRate, round1, run, workloads } from "./workloads.wac";

export async i32 main(Page page) {
  page.title("wac-tensor: CPU vs GPU");
  Element root = page.root();
  root.append("style").text("""
      body { font: 15px/1.5 system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 16px; color: #1b1b1a; background: #fcfcfb; }
      table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; margin-top: 1rem; }
      th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #e2e0d9; }
      td.n, th.n { text-align: right; }
      th { color: #77756f; font-weight: 600; }
      .muted { color: #77756f; }
      .win { font-weight: 700; }
      button { font: inherit; padding: .4rem 1rem; }
      a { color: #2a78d6; }
      @media (prefers-color-scheme: dark) {
        body { background: #1a1a19; color: #f0efec; }
        th, td { border-color: #34332f; }
        a { color: #3987e5; }
      }
      """);
  Element back = root.append("p").append("a");
  back.text("← wac-tensor");
  back.attr("href", "../");
  root.append("h1").text("CPU vs GPU, in this browser");
  root.append("p").text("Each row is the same computation on wac-tensor's CPU backend (WebAssembly, one thread) and on WebGPU. Times include reading the result back, so the GPU's work is counted, not just queued. Each runs once to warm up, then for about half a second.");
  Element where = root.append("p");
  where.attr("class", "muted");
  Element start = root.append("button");
  start.text("Run the benchmarks");
  Element table = root.append("table");
  Element head = table.append("tr");
  string[] heads = ["Benchmark", "CPU", "GPU", "Speed-up"];
  for (i32 k = 0; k < heads.len(); k++) {
    Element th = head.append("th");
    th.text(heads[k]);
    if (k > 0) { th.attr("class", "n"); }
  }
  Bench[] benches = workloads();
  Element[] cpuCells = Element[].filled(benches.len(), table);
  Element[] gpuCells = Element[].filled(benches.len(), table);
  Element[] ratioCells = Element[].filled(benches.len(), table);
  for (i32 k = 0; k < benches.len(); k++) {
    Element tr = table.append("tr");
    tr.append("td").text(benches[k].name);
    cpuCells[k] = tr.append("td");
    cpuCells[k].attr("class", "n");
    gpuCells[k] = tr.append("td");
    gpuCells[k].attr("class", "n");
    ratioCells[k] = tr.append("td");
    ratioCells[k].attr("class", "n");
  }

  u8[] weights = u8[]();
  Result<Site, string> site = await Site.of(page.sys);
  if (site.isOk()) { weights = (await site.ok()!.get("mnist.weights")).orElse(u8[]()); }
  Device cpu = Device.cpu();
  Result<Device, string> opened = await gpuDevice(page.sys.host, (string s) => { page.log(s); });
  bool hasGpu = opened.isOk();
  where.text(hasGpu ? "WebGPU is available here." : "No WebGPU here (" + opened.err()! + "): only the CPU column will fill in.");
  bool go = page.location() == "auto";
  start.on("click", Listen.none(), (ElementEvent e) => { go = true; });
  while (!go) { await page.nextFrame(); }
  start.attr("disabled", "");
  // Through a local: an `async` lambda written straight into the call emits a module that will not load (`docs/wac-asks.md`).
  fn<Ticket<f64>()> now = async () => page.now();
  string summary = "";
  for (i32 k = 0; k < benches.len(); k++) {
    cpuCells[k].text("running…");
    await page.nextFrame();
    f64 c = await run(now, cpu, k, weights);
    cpuCells[k].text(fmtMs(c) + " · " + fmtRate(benches[k].amount * 1000.0 / c, benches[k].unit));
    summary += " | \{benches[k].name}: cpu \{fmtMs(c)}";
    if (hasGpu) {
      gpuCells[k].text("running…");
      await page.nextFrame();
      f64 g = await run(now, opened.ok()!, k, weights);
      gpuCells[k].text(fmtMs(g) + " · " + fmtRate(benches[k].amount * 1000.0 / g, benches[k].unit));
      f64 ratio = c / g;
      ratioCells[k].text(ratio >= 1.0 ? "\{round1(ratio)}× faster on GPU" : "\{round1(1.0 / ratio)}× faster on CPU");
      summary += ", gpu \{fmtMs(g)}";
    } else {
      gpuCells[k].text("—");
    }
  }
  start.text("Done");
  page.title("PASS" + summary);
  return 0;
}
