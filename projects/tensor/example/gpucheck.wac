// The GPU check as a page, because WebGPU is a browser's — `tools/gpucheck.js` builds it, opens it in Chromium, and
// reads the verdict from the title: `PASS <n>` or `FAIL <first failure>`. The checks are `devicecheck.wac`'s.

import { Page } from "web";
import { Result } from "core";
import { Device } from "../src/tensor.wac";
import { gpuDevice } from "../src/gpu/backend.wac";
import { Verdict, checkDevice } from "./devicecheck.wac";

export async i32 main(Page page) {
  page.title("running");
  Result<Device, string> opened = await gpuDevice(page.sys.host, (string s) => { page.log(s); });
  if (opened.isErr()) {
    page.title("NO GPU: " + opened.err()!);
    return 1;
  }
  Device gpu = opened.ok()!;
  Verdict v = await checkDevice(gpu);
  for (i32 i = 0; i < v.failures.len(); i++) { page.log("FAIL " + v.failures.get(i)); }
  page.title(v.failures.len() == 0 ? "PASS \{v.checks}" : "FAIL \{v.failures.get(0)}");
  return 0;
}
