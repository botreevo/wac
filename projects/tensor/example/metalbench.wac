// CPU against Metal: `workloads.wac`'s benchmarks on wac-tensor's CPU backend and on the Metal server
// `metal/server.swift` builds, which must be running on this Mac. Reads `example/mnist/mnist.weights` when it is there.
//
//     wac run --allow-net --allow-read example/metalbench.wac [port]

import { Output, Sys } from "std";
import { Result, Ticket } from "core";
import { Device } from "../src/lib.wac";
import { metalDevice, portFrom } from "../src/metal/metal.wac";
import { Bench, fmtMs, fmtRate, round1, run, workloads } from "./workloads.wac";

export async i32 main(Sys sys) {
  Output out = sys.stdout();
  fn<void(string)> warn = (string s) => { out.line(s); };
  Result<Device, string> opened = await metalDevice(sys.net(), "127.0.0.1", portFrom(sys.args()), warn);
  if (opened.isErr()) {
    out.line("NO GPU: " + opened.err()!);
    return 1;
  }
  Device gpu = opened.ok()!;
  Device cpu = Device.cpu();
  u8[] weights = (await sys.readFile("example/mnist/mnist.weights")).orElse(u8[]());
  fn<Ticket<f64>()> now = async () => ((await sys.monotonicNanos()) as~ f64) / 1000000.0;
  out.line(gpu.backend.name());
  out.line("Benchmark | CPU | GPU | Speed-up");
  Bench[] benches = workloads();
  for (i32 k = 0; k < benches.len(); k++) {
    Bench b = benches[k];
    f64 c = await run(now, cpu, k, weights);
    f64 g = await run(now, gpu, k, weights);
    f64 ratio = c / g;
    string cpuCell = fmtMs(c) + " · " + fmtRate(b.amount * 1000.0 / c, b.unit);
    string gpuCell = fmtMs(g) + " · " + fmtRate(b.amount * 1000.0 / g, b.unit);
    string verdict = ratio >= 1.0 ? "\{round1(ratio)}× faster on GPU" : "\{round1(1.0 / ratio)}× faster on CPU";
    out.line("\{b.name} | \{cpuCell} | \{gpuCell} | \{verdict}");
  }
  return 0;
}
