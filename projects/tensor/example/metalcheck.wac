// The GPU check on Metal: `devicecheck.wac`'s checks of a device against the CPU backend, from the command line, on
// the server `metal/server.swift` builds — which must be running on this Mac. Prints `PASS <n>` or each failure.
//
//     wac run --allow-net example/metalcheck.wac [port]

import { Output, Sys } from "std";
import { Result } from "core";
import { Device } from "../src/tensor.wac";
import { metalDevice, portFrom } from "../src/metal/metal.wac";
import { Verdict, checkDevice } from "./devicecheck.wac";

export async i32 main(Sys sys) {
  Output out = sys.stdout();
  fn<void(string)> warn = (string s) => { out.line(s); };
  Result<Device, string> opened = await metalDevice(sys.net(), "127.0.0.1", portFrom(sys.args()), warn);
  if (opened.isErr()) {
    out.line("NO GPU: " + opened.err()!);
    return 1;
  }
  Device gpu = opened.ok()!;
  out.line(gpu.backend.name());
  Verdict v = await checkDevice(gpu);
  for (i32 i = 0; i < v.failures.len(); i++) { out.line("FAIL " + v.failures.get(i)); }
  out.line(v.failures.len() == 0 ? "PASS \{v.checks}" : "FAIL: \{v.failures.len()} of \{v.checks}");
  return v.failures.len() == 0 ? 0 : 1;
}
