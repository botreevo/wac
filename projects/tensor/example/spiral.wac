// Two interleaved spirals, told apart by a small network: the classic dataset a straight line cannot separate.
//
//     wac run example/spiral.wac
//
// Runs on the CPU backend, so it needs nothing but `wac`; the same code on `gpuDevice` runs on WebGPU.

import { Sys } from "std";
import { Device, Tensor } from "../src/tensor.wac";
import { Activation, Dense, Layer, Sequential, accuracy, sparseSoftmaxCrossEntropy } from "../src/nn.wac";
import { Adam } from "../src/optim.wac";
import { cos, sin } from "../src/scalar.wac";

export i32 main(Sys sys) {
  Device d = Device.cpu();
  d.seed(1 as i64);

  // 100 points along each arm, a little noise on each.
  i32 n = 100;
  f32[] xy = f32[].filled(4 * n, 0.0);
  f32[] labels = f32[].filled(2 * n, 0.0);
  Tensor noise = d.normal([2 * n, 2], 0.0, 0.05);
  f32[] jitter = noise.valuesNow();
  for (i32 arm = 0; arm < 2; arm++) {
    for (i32 i = 0; i < n; i++) {
      f64 r = (i as f64) / (n as f64);
      f64 t = 4.0 * r + 3.14159265358979 * (arm as f64);
      i32 k = arm * n + i;
      xy[2 * k] = ((r * sin(t)) as~ f32) + jitter[2 * k];
      xy[2 * k + 1] = ((r * cos(t)) as~ f32) + jitter[2 * k + 1];
      labels[k] = arm as~ f32;
    }
  }
  Tensor x = d.tensor(xy, [2 * n, 2]);
  Tensor y = d.vector(labels);

  Sequential model = Sequential.of([
    Dense.create(d, 2, 32, Activation.Relu),
    Dense.create(d, 32, 32, Activation.Relu),
    Dense.create(d, 32, 2, Activation.Linear),
  ]);
  Adam opt = Adam.create(0.02);

  for (i32 epoch = 0; epoch <= 300; epoch++) {
    Tensor loss = opt.minimize(() => sparseSoftmaxCrossEntropy(model.apply(x, true), y), model.params());
    if (epoch % 50 == 0) {
      Tensor acc = d.tidy(() => accuracy(model.apply(x, false), y));
      sys.log("epoch \{epoch}: loss \{loss.item()}, accuracy \{acc.item()}");
      acc.dispose();
    }
    loss.dispose();
  }
  return 0;
}
