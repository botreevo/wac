// The GPU backend: each kernel a program run over GPU buffers, through a `GpuLine` — WGSL over `wac.gpu` in a browser,
// or MSL over a socket to a Metal server (`../metal/`).
//
// **Nothing waits but a read.** A kernel makes its output buffer, writes its parameters and runs its program — three
// operations held in the line and sent with the rest of the step — and answers the output's storage at once. So a
// training step is built as fast as wac can call methods, and the GPU sees it as one batch.
//
// **Programs are compiled once per kind of work**, found by name in a cache: the shader text never holds a size
// (`wgsl.wac`), so `binary/add/f32,f32>f32` is one program whatever shapes it adds.
//
// **An `F16` buffer is halves packed two to a `u32`**, so it takes half the bytes, rounded up to a whole word. They
// are packed and unpacked here on upload and download, and in the shaders everywhere else.

import { Answer, Host } from "std";
import { Map, Result, Ticket, hashString, stringEq } from "core";
import { Backend, Binary, Conv, DType, Reduce, Storage, Unary, sameDType } from "../backend.wac";
import { halfBits, halfValue } from "../half.wac";
import { Device } from "../tensor.wac";
import { sizeOf } from "../shape.wac";
import { GpuLine } from "./line.wac";
import { Shaders } from "./shaders.wac";
import { PARAMS, Wgsl, typesKey } from "./wgsl.wac";

export struct GpuStorage : Storage {
  i32 handle;
}

/** The highest number of workgroups a grid may have along one axis. */
static i32 GRID = 65535;

i32 bitsOf(f32 v) { return f32.toBits(v) as@ i32; }

bool isHalf(DType t) { return sameDType(t, DType.F16); }

/** How many bytes `n` elements of `t` take in a buffer. */
i32 bytesFor(i32 n, DType t) { return isHalf(t) ? ((n + 1) / 2) * 4 : n * 4; }

/** A device on the GPU `host` provides, or why there is none. `warn` hears what the GPU reports going wrong. */
export async Result<Device, string> gpuDevice(Host host, fn<void(string)> warn) {
  Result<GpuLine, string> line = await GpuLine.open(host);
  match (line) {
    Ok(l): { return Result.Ok(Device.on(GpuBackend.over(l, warn))); }
    Err(why): { return Result.Err(why); }
  }
}

export struct GpuBackend : Backend {
  GpuLine line;
  fn<void(string)> warn;
  string label;
  Shaders shaders;
  /** Whether the line answers `GPU_MATMUL`, which an `F32` matrix product then goes to instead of a shader. */
  bool nativeMatmul;
  Map<string, i32> programs;
  i32 lastHandle = 0;

  /** WebGPU through `line`. */
  GpuBackend over(GpuLine line, fn<void(string)> warn) { return GpuBackend.speaking(line, warn, "webgpu", Wgsl(), false); }

  GpuBackend speaking(GpuLine line, fn<void(string)> warn, string label, Shaders shaders, bool nativeMatmul) {
    return GpuBackend {
      line: line, warn: warn, label: label, shaders: shaders, nativeMatmul: nativeMatmul,
      programs: Map.create(hashString, stringEq),
    };
  }

  override string name(const this) { return this.label; }

  i32 handle(this) {
    this.lastHandle++;
    return this.lastHandle;
  }

  i32 of(this, Storage s) {
    if (s.freed) { trap; }
    return (s as! GpuStorage).handle;
  }

  /** A buffer for `n` elements of `t`. Never empty: WebGPU cannot bind a buffer of no bytes. */
  GpuStorage alloc(this, i32 n, DType t) {
    i32 h = this.handle();
    i32 bytes = bytesFor(n, t);
    this.line.buffer(h, bytes > 0 ? bytes : 4);
    return GpuStorage { size: n, dtype: t, handle: h };
  }

  /** The program `name`, compiled from `source` the first time it is asked for; `tx` by `ty` invocations a workgroup. */
  i32 program(this, string name, fn<string()> source, i32 tx, i32 ty) {
    i32? had = this.programs.get(name);
    if (had is not null) { return had!; }
    i32 h = this.handle();
    // Named in a comment, which both languages allow, so a host can say which program a fault or a time belongs to.
    this.line.program(h, "// \{name}\n" + source(), tx, ty);
    this.programs.set(name, h);
    return h;
  }

  /**
   * Run `program` over `buffers`, the first of which is made here to hold `params`, in a grid of `x` by `y` by `z`
   * workgroups. The parameter buffer is freed after: the host frees nothing until the runs before it have finished.
   */
  void run(this, i32 program, i32[] params, i32[] buffers, i32 x, i32 y, i32 z) {
    if (params.len() > PARAMS) { trap; }
    i32 h = this.handle();
    this.line.buffer(h, PARAMS * 4);
    u8[] bytes = u8[].filled(params.len() * 4, 0 as u8);
    for (i32 i = 0; i < params.len(); i++) {
      for (i32 k = 0; k < 4; k++) { bytes[i * 4 + k] = ((params[i] >> (8 * k)) & 255) as~ u8; }
    }
    this.line.write(h, 0, bytes);
    i32[] all = i32[].filled(buffers.len() + 1, h);
    all.copyFrom(buffers, 0, 1, buffers.len());
    this.line.run(program, x, y, z, all);
    this.line.free(h);
  }

  /**
   * `run` over an elementwise shader writing `n` elements of `out`: one invocation an element, or a pair of them for
   * halves, 64 to a workgroup, the grid folded into two axes when it must be.
   */
  void spread(this, i32 program, i32[] params, i32[] buffers, i32 n, DType out) {
    i32 invocations = isHalf(out) ? (n + 1) / 2 : n;
    i32 groups = (invocations + 63) / 64;
    if (groups == 0) { return; }
    i32 x = groups < GRID ? groups : GRID;
    i32 y = (groups + x - 1) / x;
    this.run(program, params, buffers, x, y, 1);
  }

  /** `run` with one workgroup per row, for the reductions. */
  void perRow(this, i32 program, i32[] params, i32[] buffers, i32 rows) {
    if (rows == 0) { return; }
    i32 x = rows < GRID ? rows : GRID;
    i32 y = (rows + x - 1) / x;
    this.run(program, params, buffers, x, y, 1);
  }

  /** `s`, an `F32` result of a kernel that only writes `F32`, as `to` — freed and replaced when that is a half. */
  Storage settle(this, GpuStorage s, DType to) {
    if (!isHalf(to)) { return s; }
    Storage half = this.cast(s, to);
    this.free(s);
    return half;
  }

  override Storage upload(this, f32[] values, DType dtype) {
    GpuStorage s = this.alloc(values.len(), dtype);
    u8[] bytes = u8[].filled(bytesFor(values.len(), dtype), 0 as u8);
    if (isHalf(dtype)) {
      for (i32 i = 0; i < values.len(); i++) {
        i32 h = halfBits(values[i]);
        // Element i is the low half of word i / 2 when i is even, the high half when it is odd.
        bytes[i * 2] = (h & 255) as~ u8;
        bytes[i * 2 + 1] = ((h >> 8) & 255) as~ u8;
      }
    } else {
      for (i32 i = 0; i < values.len(); i++) {
        i32 b = bitsOf(values[i]);
        for (i32 k = 0; k < 4; k++) { bytes[i * 4 + k] = ((b >> (8 * k)) & 255) as~ u8; }
      }
    }
    if (bytes.len() > 0) { this.line.write(s.handle, 0, bytes); }
    return s;
  }

  override Ticket<f32[]> download(this, Storage s) {
    if (s.size == 0) {
      Ticket<f32[]> empty;
      empty.resolve(f32[]());
      return empty;
    }
    return readFloats(this.line.read(this.of(s), 0, bytesFor(s.size, s.dtype)), s.size, isHalf(s.dtype), this.warn);
  }

  override void free(this, Storage s) {
    if (s.freed) { return; }
    s.freed = true;
    this.line.free((s as! GpuStorage).handle);
  }

  override Storage fill(this, i32 n, f32 value, DType dtype) {
    GpuStorage out = this.alloc(n, dtype);
    i32 prog = this.program("fill/" + typesKey(DType[](), dtype), () => this.shaders.fill(dtype), 64, 1);
    this.spread(prog, [n, bitsOf(value)], [out.handle], n, dtype);
    return out;
  }

  override Storage cast(this, Storage x, DType to) {
    GpuStorage out = this.alloc(x.size, to);
    DType from = x.dtype;
    i32 prog = this.program("cast/" + typesKey([from], to), () => this.shaders.cast(from, to), 64, 1);
    this.spread(prog, [x.size], [this.of(x), out.handle], x.size, to);
    return out;
  }

  override Storage unary(this, Unary op, Storage x) {
    DType t = x.dtype;
    GpuStorage out = this.alloc(x.size, t);
    i32 prog = this.program("unary/\{unaryName(op)}/" + typesKey([t], t), () => this.shaders.unary(op, t), 64, 1);
    this.spread(prog, [x.size], [this.of(x), out.handle], x.size, t);
    return out;
  }

  override Storage binary(this, Binary op, Storage a, Storage b, i32[] out, i32[] sa, i32[] sb) {
    i32 n = sizeOf(out);
    DType t = a.dtype;
    GpuStorage o = this.alloc(n, t);
    i32 prog = this.program("binary/\{binaryName(op)}/" + typesKey([t, t], t), () => this.shaders.binary(op, t), 64, 1);
    this.spread(prog, stridedParams(n, out, [sa, sb]), [this.of(a), this.of(b), o.handle], n, t);
    return o;
  }

  override Storage select(this, Storage c, Storage a, Storage b, i32[] out, i32[] sc, i32[] sa, i32[] sb) {
    i32 n = sizeOf(out);
    DType ct = c.dtype;
    DType t = a.dtype;
    GpuStorage o = this.alloc(n, t);
    i32 prog = this.program("select/" + typesKey([ct, t, t], t), () => this.shaders.select(ct, t), 64, 1);
    this.spread(prog, stridedParams(n, out, [sc, sa, sb]), [this.of(c), this.of(a), this.of(b), o.handle], n, t);
    return o;
  }

  override Storage reduce(this, Reduce op, Storage x, i32 outer, i32 inner) {
    DType t = x.dtype;
    GpuStorage o = this.alloc(outer, DType.F32);
    i32 prog = this.program("reduce/\{reduceName(op)}/" + typesKey([t], DType.F32), () => this.shaders.reduce(op, t), 64, 1);
    this.perRow(prog, [outer, inner], [this.of(x), o.handle], outer);
    return this.settle(o, t);
  }

  override Storage argReduce(this, bool max, Storage x, i32 outer, i32 inner) {
    DType t = x.dtype;
    GpuStorage o = this.alloc(outer, DType.F32);
    string name = (max ? "argmax/" : "argmin/") + typesKey([t], DType.F32);
    i32 prog = this.program(name, () => this.shaders.argReduce(max, t), 64, 1);
    this.perRow(prog, [outer, inner], [this.of(x), o.handle], outer);
    return o;
  }

  override Storage matmul(this, Storage a, Storage b, i32 batch, i32 m, i32 k, i32 n, bool ta, bool tb,
                          i32 aStride, i32 bStride) {
    DType t = a.dtype;
    GpuStorage o = this.alloc(batch * m * n, DType.F32);
    if (batch * m * n == 0) { return this.settle(o, t); }
    if (this.nativeMatmul && !isHalf(t)) {
      this.line.matmul([this.of(a), this.of(b), o.handle, batch, m, k, n, ta ? 1 : 0, tb ? 1 : 0, aStride, bStride]);
      return o;
    }
    i32 prog = this.program("matmul/" + typesKey([t, t], DType.F32), () => this.shaders.matmul(t), 16, 16);
    this.run(prog, [batch, m, k, n, ta ? 1 : 0, tb ? 1 : 0, aStride, bStride], [this.of(a), this.of(b), o.handle],
             (n + 15) / 16, (m + 15) / 16, batch);
    return this.settle(o, t);
  }

  override Storage gather(this, Storage x, i32[] out, i32[] strides, i32 offset) {
    i32 n = sizeOf(out);
    DType t = x.dtype;
    GpuStorage o = this.alloc(n, t);
    i32 prog = this.program("gather/" + typesKey([t], t), () => this.shaders.gather(t), 64, 1);
    i32[] p = stridedParams(n, out, [strides]);
    i32[] withOffset = i32[].filled(p.len() + 1, offset);
    withOffset.copyFrom(p, 0, 0, p.len());
    this.spread(prog, withOffset, [this.of(x), o.handle], n, t);
    return o;
  }

  override Storage pad(this, Storage x, i32[] inShape, i32[] out, i32[] begin, f32 value) {
    i32 n = sizeOf(out);
    DType t = x.dtype;
    GpuStorage o = this.alloc(n, t);
    i32 prog = this.program("pad/" + typesKey([t], t), () => this.shaders.pad(t), 64, 1);
    i32 r = out.len();
    i32[] p = i32[].filled(3 + 3 * r, 0);
    p[0] = n;
    p[1] = r;
    for (i32 d = 0; d < r; d++) {
      p[2 + d] = out[d];
      p[2 + r + d] = inShape[d];
      p[2 + 2 * r + d] = begin[d];
    }
    p[2 + 3 * r] = bitsOf(value);
    this.spread(prog, p, [this.of(x), o.handle], n, t);
    return o;
  }

  override Storage im2col(this, Storage x, Conv c, f32 padValue) {
    i32 n = c.rows() * c.cols();
    DType t = x.dtype;
    GpuStorage o = this.alloc(n, t);
    i32 prog = this.program("im2col/" + typesKey([t], t), () => this.shaders.im2col(t), 64, 1);
    i32[] p = convParams(n, c);
    p[15] = bitsOf(padValue);
    this.spread(prog, p, [this.of(x), o.handle], n, t);
    return o;
  }

  override Storage col2im(this, Storage cols, Conv c) {
    i32 n = c.n * c.h * c.w * c.c;
    DType t = cols.dtype;
    GpuStorage o = this.alloc(n, t);
    i32 prog = this.program("col2im/" + typesKey([t], t), () => this.shaders.col2im(t), 64, 1);
    this.spread(prog, convParams(n, c), [this.of(cols), o.handle], n, t);
    return o;
  }

  override Storage take(this, Storage table, i32 width, Storage indices, i32 n) {
    DType t = table.dtype;
    DType it = indices.dtype;
    GpuStorage o = this.alloc(n * width, t);
    i32 prog = this.program("take/" + typesKey([t, it], t), () => this.shaders.take(t, it), 64, 1);
    this.spread(prog, [n * width, width, table.size / width], [this.of(table), this.of(indices), o.handle], n * width, t);
    return o;
  }

  override Storage scatterAdd(this, Storage values, i32 width, Storage indices, i32 n, i32 rows) {
    DType t = values.dtype;
    DType it = indices.dtype;
    GpuStorage o = this.alloc(rows * width, t);
    i32 prog = this.program("scatteradd/" + typesKey([t, it], t), () => this.shaders.scatterAdd(t, it), 64, 1);
    this.spread(prog, [rows * width, width, n], [this.of(values), this.of(indices), o.handle], rows * width, t);
    return o;
  }
}

/** [n, rank, shape…, then each operand's strides…] — what `stridedLoop` reads. */
i32[] stridedParams(i32 n, i32[] out, i32[][] strides) {
  i32 r = out.len();
  i32[] p = i32[].filled(2 + r * (strides.len() + 1), 0);
  p[0] = n;
  p[1] = r;
  for (i32 d = 0; d < r; d++) { p[2 + d] = out[d]; }
  for (i32 k = 0; k < strides.len(); k++) {
    for (i32 d = 0; d < r; d++) { p[2 + r * (k + 1) + d] = strides[k][d]; }
  }
  return p;
}

i32[] convParams(i32 n, Conv c) {
  return [n, c.n, c.h, c.w, c.c, c.kh, c.kw, c.sh, c.sw, c.dh, c.dw, c.padTop, c.padLeft, c.oh, c.ow, 0];
}

async f32[] readFloats(Ticket<Answer> pending, i32 n, bool halves, fn<void(string)> warn) {
  Answer a = await pending;
  if (a.fault != 0) {
    // The GPU said something went wrong since the last read — a shader that did not compile, a buffer it could not
    // make. The numbers cannot be trusted, and there is no value to answer with that would not be a lie.
    warn("wac.gpu: " + a.text);
    trap;
  }
  if (a.bytes.len() < (halves ? n * 2 : n * 4)) { trap; }
  f32[] out = f32[].filled(n, 0.0);
  for (i32 i = 0; i < n; i++) {
    if (halves) {
      out[i] = halfValue((a.bytes[i * 2] as i32) | ((a.bytes[i * 2 + 1] as i32) << 8));
    } else {
      u32 bits = (a.bytes[i * 4] as u32) | ((a.bytes[i * 4 + 1] as u32) << 8) | ((a.bytes[i * 4 + 2] as u32) << 16)
               | ((a.bytes[i * 4 + 3] as u32) << 24);
      out[i] = f32.fromBits(bits);
    }
  }
  return out;
}

string unaryName(Unary op) {
  match (op) {
    Neg: { return "neg"; }
    Abs: { return "abs"; }
    Exp: { return "exp"; }
    Expm1: { return "expm1"; }
    Log: { return "log"; }
    Log1p: { return "log1p"; }
    Sqrt: { return "sqrt"; }
    Rsqrt: { return "rsqrt"; }
    Square: { return "square"; }
    Reciprocal: { return "reciprocal"; }
    Sin: { return "sin"; }
    Cos: { return "cos"; }
    Tanh: { return "tanh"; }
    Sigmoid: { return "sigmoid"; }
    Relu: { return "relu"; }
    Softplus: { return "softplus"; }
    Sign: { return "sign"; }
    Floor: { return "floor"; }
    Ceil: { return "ceil"; }
    Round: { return "round"; }
    Step: { return "step"; }
  }
}

string binaryName(Binary op) {
  match (op) {
    Add: { return "add"; }
    Sub: { return "sub"; }
    Mul: { return "mul"; }
    Div: { return "div"; }
    Pow: { return "pow"; }
    Maximum: { return "maximum"; }
    Minimum: { return "minimum"; }
    Equal: { return "equal"; }
    NotEqual: { return "notequal"; }
    Less: { return "less"; }
    LessEqual: { return "lessequal"; }
    Greater: { return "greater"; }
    GreaterEqual: { return "greaterequal"; }
  }
}

string reduceName(Reduce op) {
  match (op) {
    Sum: { return "sum"; }
    Prod: { return "prod"; }
    Max: { return "max"; }
    Min: { return "min"; }
  }
}
