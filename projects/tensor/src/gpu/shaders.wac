// The programs a GPU backend runs, in one shading language: WGSL for WebGPU (`wgsl.wac`), MSL for Metal
// (`../metal/msl.wac`).
//
// **Both languages are handed the same buffers and parameters**, so `GpuBackend` is one backend whatever it runs on:
// a uniform of `PARAMS` `i32`s first, then the inputs, then the output; an `F16` buffer is halves two to a word, the
// even element in the low half — which is a plain array of halves to MSL, since Apple's GPUs are little-endian. An
// elementwise program runs 64 invocations a workgroup, one an element, or one a pair for halves; a reduction one
// workgroup of 64 a row; the matrix product 16 by 16 a tile. The names in the cache (`binary/add/f32,f32>f32`) are a
// backend's own, so the two never share one.

import { Binary, DType, Reduce, Unary } from "../backend.wac";

export struct Shaders {
  virtual string fill(this, DType t) { trap; }
  virtual string cast(this, DType from, DType to) { trap; }
  virtual string unary(this, Unary op, DType t) { trap; }
  virtual string binary(this, Binary op, DType t) { trap; }
  virtual string select(this, DType cond, DType t) { trap; }
  virtual string reduce(this, Reduce op, DType t) { trap; }
  virtual string argReduce(this, bool max, DType t) { trap; }
  virtual string matmul(this, DType t) { trap; }
  virtual string gather(this, DType t) { trap; }
  virtual string pad(this, DType t) { trap; }
  virtual string im2col(this, DType t) { trap; }
  virtual string col2im(this, DType t) { trap; }
  virtual string take(this, DType t, DType index) { trap; }
  virtual string scatterAdd(this, DType t, DType index) { trap; }
}
