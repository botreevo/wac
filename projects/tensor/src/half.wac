// IEEE 754 half precision: `f16` as sixteen bits, to and from `f32`.
//
// wac has no `f16`, so a half is its bits in the low half of an `i32`. These are the conversions the GPU backend packs
// and unpacks buffers with, and the rounding the CPU backend applies to every `F16` result so that it computes what a
// GPU storing halves computes: each operation in `f32`, rounded once to the nearest half — a tie to the even one, too
// large to infinity, too small through the subnormals to zero.

/** The half nearest `v`, as bits. */
export i32 halfBits(f32 v) {
  i32 x = f32.toBits(v) as@ i32;
  i32 sign = (x >>> 16) & 0x8000;
  i32 exp = (x >>> 23) & 0xFF;
  i32 mant = x & 0x7FFFFF;
  if (exp == 255) { return sign | 0x7C00 | (mant != 0 ? 0x200 : 0); }
  i32 e = exp - 127 + 15;
  if (e >= 31) { return sign | 0x7C00; }
  if (e <= 0) {
    // Subnormal: the implicit bit made explicit and shifted down, rounded on what falls off. A carry out of the top
    // lands on the smallest normal half, which is the right answer.
    if (e < -10) { return sign; }
    i32 m = mant | 0x800000;
    i32 shift = 14 - e;
    i32 h = m >> shift;
    i32 rest = m & ((1 << shift) - 1);
    i32 halfway = 1 << (shift - 1);
    if (rest > halfway || (rest == halfway && (h & 1) == 1)) { h++; }
    return sign | h;
  }
  i32 h = (e << 10) | (mant >> 13);
  i32 rest = mant & 0x1FFF;
  // A carry out of the mantissa moves the exponent up, and out of the largest finite half makes infinity: both right.
  if (rest > 0x1000 || (rest == 0x1000 && (h & 1) == 1)) { h++; }
  return sign | h;
}

/** The `f32` a half's bits stand for — exactly, since every half is an `f32`. */
export f32 halfValue(i32 h) {
  i32 sign = (h & 0x8000) << 16;
  i32 exp = (h >> 10) & 0x1F;
  i32 mant = h & 0x3FF;
  if (exp == 0) {
    f32 v = (mant as~ f32) * 0.000000059604644775390625;
    return sign != 0 ? -v : v;
  }
  if (exp == 31) { return f32.fromBits((sign | 0x7F800000 | (mant << 13)) as@ u32); }
  return f32.fromBits((sign | ((exp + 112) << 23) | (mant << 13)) as@ u32);
}

/** `v` rounded to the nearest half. */
export f32 toHalf(f32 v) { return halfValue(halfBits(v)); }
