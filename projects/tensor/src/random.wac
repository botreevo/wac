// Seeded random numbers, so that a model initialised twice from one seed is the same model on every backend.
//
// **Drawn on the CPU and uploaded**, whatever the device. A GPU generator would be faster and would make the numbers
// depend on the backend — and a model whose initial weights differ between a laptop and a test is a model whose test
// proves nothing about it.

import { math } from "core";
import { cos } from "./scalar.wac";

/** xorshift64*: small, fast, and good enough for weights and dropout masks. Not for anything secret. */
export struct Random {
  u64 state;

  Random seeded(i64 seed) {
    // Zero is xorshift's one fixed point, so it is moved off it; any other seed is taken as given.
    u64 s = (seed as@ u64) ^ (0x9E3779B97F4A7C15 as@ u64);
    if (s == (0 as u64)) { s = 1 as u64; }
    return Random(s);
  }

  u64 next(this) {
    u64 x = this.state;
    x = x ^ (x >> (12 as u64));
    x = x ^ (x << (25 as u64));
    x = x ^ (x >> (27 as u64));
    this.state = x;
    return x * (0x2545F4914F6CDD1D as@ u64);
  }

  /** Uniform in [0, 1), from the top 53 bits. */
  f64 uniform(this) {
    u64 bits = this.next() >> (11 as u64);
    return (bits as~ f64) / 9007199254740992.0;
  }

  /** Standard normal, by Box and Muller's transform. */
  f64 normal(this) {
    f64 u = this.uniform();
    while (u <= 0.0) { u = this.uniform(); }
    f64 v = this.uniform();
    return (-2.0 * math.log(u)).sqrt() * cos(6.283185307179586 * v);
  }
}
