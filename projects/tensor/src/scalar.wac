// The scalar functions the CPU backend computes each element with, and that `core.math` does not have.
//
// **Computed in `f64` and rounded once to `f32`**, so the CPU backend is the more accurate of the two and a
// difference between it and a GPU is the GPU's rounding — which is what the differential test (`example/gpucheck.wac`)
// allows for.

import { math } from "core";

// fdlibm's kernels on [-pi/4, pi/4]: plenty for a result rounded to f32.
f64 sinKernel(f64 x) {
  f64 z = x * x;
  f64 r = 0.00833333333332248946 + z * (-0.000198412698298579493 + z * (0.00000275573137070700676 +
          z * (-0.0000000250507602534068634 + z * (0.000000000158969099521155010))));
  return x + x * z * (-0.166666666666666324348 + z * r);
}

f64 cosKernel(f64 x) {
  f64 z = x * x;
  f64 r = z * (0.0416666666666666019037 + z * (-0.00138888888888741095749 + z * (0.0000248015872894767294178 +
          z * (-0.000000275573143513906633 + z * (0.00000000208757232129817482 + z * (-0.000000000011359647557788195))))));
  return 1.0 - 0.5 * z + z * r;
}

/** `x` less the nearest multiple of pi/2, and which multiple modulo 4 — Cody and Waite's split of pi/2 in three. */
f64 reduced(f64 x, i32[] quadrant) {
  f64 k = (x * 0.636619772367581343076).round();
  f64 r = x - k * 1.57079632673412561417;
  r = r - k * 0.0000000000607710050650619224932;
  r = r - k * 0.0000000000000000000202226624879595063154;
  quadrant[0] = ((k % 4.0 + 4.0) % 4.0) as~ i32;
  return r;
}

export f64 sin(f64 x) {
  if (x != x || x.abs() == 1.0 / 0.0) { return 0.0 / 0.0; }
  i32[] q = [0];
  f64 r = reduced(x, q);
  switch (q[0]) {
    case 0: { return sinKernel(r); }
    case 1: { return cosKernel(r); }
    case 2: { return 0.0 - sinKernel(r); }
    default: { return 0.0 - cosKernel(r); }
  }
}

export f64 cos(f64 x) {
  if (x != x || x.abs() == 1.0 / 0.0) { return 0.0 / 0.0; }
  i32[] q = [0];
  f64 r = reduced(x, q);
  switch (q[0]) {
    case 0: { return cosKernel(r); }
    case 1: { return 0.0 - sinKernel(r); }
    case 2: { return 0.0 - cosKernel(r); }
    default: { return sinKernel(r); }
  }
}

export f64 tanh(f64 x) {
  if (x > 20.0) { return 1.0; }
  if (x < -20.0) { return -1.0; }
  // expm1 keeps the digits near 0, where `(e^2x - 1) / (e^2x + 1)` would cancel them.
  f64 e = math.expm1(2.0 * x);
  return e / (e + 2.0);
}

export f64 sigmoid(f64 x) {
  if (x >= 0.0) { return 1.0 / (1.0 + math.exp(0.0 - x)); }
  f64 e = math.exp(x);
  return e / (1.0 + e);
}

/** `log(1 + e^x)` without overflowing for large `x` or losing everything for very negative `x`. */
export f64 softplus(f64 x) {
  if (x > 30.0) { return x; }
  return math.log1p(math.exp(x));
}
