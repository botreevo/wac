// Shapes: how many elements, where each one is, and what two shapes broadcast to.
//
// **A shape is an `i32[]` and nothing more.** A struct around it would be one more thing to construct at every call
// site for no invariant it could keep: every array of non-negative sizes is a shape, the empty one a scalar's.
// Every tensor is stored contiguous, row-major, so a shape alone says where each element is — a transpose or a slice
// is a copy rather than a view, which costs memory and buys a backend that never has to understand strides it was
// not handed for one call.

/** How many elements a tensor of this shape holds: 1 for a scalar. */
export i32 sizeOf(const i32[] shape) {
  i32 n = 1;
  for (i32 d in shape) { n *= d; }
  return n;
}

/** Row-major strides: how far apart, in elements, two neighbours along each axis are. */
export i32[] stridesOf(const i32[] shape) {
  i32[] s = i32[].filled(shape.len(), 1);
  i32 acc = 1;
  for (i32 i = shape.len() - 1; i >= 0; i--) {
    s[i] = acc;
    acc *= shape[i];
  }
  return s;
}

export bool sameShape(const i32[] a, const i32[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

/** `[2, 3]` as people write it, for the messages that say why two tensors do not fit. */
export string shapeText(const i32[] shape) {
  string s = "[";
  for (i32 i = 0; i < shape.len(); i++) {
    if (i > 0) { s += ", "; }
    s += "\{shape[i]}";
  }
  return s + "]";
}

/**
 * What two shapes broadcast to, aligned at their last axes as NumPy and TensorFlow do: each pair of sizes must be
 * equal or have a 1 in it, and a missing leading axis counts as 1. `null` when they do not fit.
 */
export i32[]? broadcastShapes(const i32[] a, const i32[] b) {
  i32 rank = a.len() > b.len() ? a.len() : b.len();
  i32[] out = i32[].filled(rank, 1);
  for (i32 i = 0; i < rank; i++) {
    i32 da = i < rank - a.len() ? 1 : a[i - (rank - a.len())];
    i32 db = i < rank - b.len() ? 1 : b[i - (rank - b.len())];
    if (da == db || db == 1) { out[i] = da; }
    else if (da == 1) { out[i] = db; }
    else { return null; }
  }
  return out;
}

/**
 * The strides to read a tensor of shape `from` at each index of the larger shape `to` it broadcasts into: its own
 * strides where it has the axis at full size, and 0 where it is stretched — so one formula reads both operands of a
 * broadcast without either being copied.
 */
export i32[] broadcastStrides(const i32[] from, const i32[] to) {
  i32[] own = stridesOf(from);
  i32[] out = i32[].filled(to.len(), 0);
  i32 lead = to.len() - from.len();
  for (i32 i = 0; i < from.len(); i++) {
    out[lead + i] = from[i] == 1 && to[lead + i] != 1 ? 0 : own[i];
  }
  return out;
}

/**
 * Axes as a caller writes them — negative from the end, in any order, the empty list meaning every axis — as a
 * sorted list of distinct non-negative axes. Traps on an axis the rank does not have.
 */
export i32[] normalizeAxes(const i32[] axes, i32 rank) {
  bool[] marked = bool[].filled(rank, false);
  if (axes.len() == 0) {
    for (i32 i = 0; i < rank; i++) { marked[i] = true; }
  }
  for (i32 a in axes) {
    i32 k = a < 0 ? a + rank : a;
    if (k < 0 || k >= rank) { trap; }
    marked[k] = true;
  }
  i32 n = 0;
  for (bool m in marked) { if (m) { n++; } }
  i32[] out = i32[].filled(n, 0);
  i32 j = 0;
  for (i32 i = 0; i < rank; i++) {
    if (marked[i]) { out[j] = i; j++; }
  }
  return out;
}

/** One axis as a caller writes it, negative from the end. Traps outside the rank. */
export i32 normalizeAxis(i32 axis, i32 rank) {
  i32 k = axis < 0 ? axis + rank : axis;
  if (k < 0 || k >= rank) { trap; }
  return k;
}

export bool contains(const i32[] xs, i32 x) {
  for (i32 v in xs) { if (v == x) { return true; } }
  return false;
}

/** The permutation that undoes `perm`. */
export i32[] inversePermutation(const i32[] perm) {
  i32[] inv = i32[].filled(perm.len(), 0);
  for (i32 i = 0; i < perm.len(); i++) { inv[perm[i]] = i; }
  return inv;
}

export i32[] copyShape(const i32[] s) {
  i32[] out = i32[].filled(s.len(), 0);
  out.copyFrom(s, 0, 0, s.len());
  return out;
}
