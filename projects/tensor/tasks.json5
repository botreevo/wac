{
  // Every unit test: the CPU backend, the gradients against finite differences, the layers and optimizers.
  test: "wac test test",
  // The GPU check as a page: every kernel on WebGPU against the CPU backend, from the same numbers.
  "gpucheck:build": "wac run --allow-read --allow-write --allow-run tools/build.wac example/gpucheck.wac dist/gpucheck --title 'wac-tensor GPU check'",
  // ...and run in headless Chromium, which needs Playwright on NODE_PATH; the verdict is the page's title.
  gpucheck: "node tools/gpucheck.js dist/gpucheck",
  // Every WGSL program the GPU backend can make, in both element types, compiled in headless Chromium.
  shaders: "sh -c 'mkdir -p dist && wac run tools/shaders.wac > dist/shaders.txt && node tools/shadercheck.js dist/shaders.txt'",
  // The tiny GPT on the CPU: names, 2000 steps, about ten minutes.
  "gpt:train": "wac run --allow-read example/gpt/train.wac example/gpt/data/names.txt",
  // ...and as a page that trains on WebGPU, served with its texts beside it.
  "gpt:build": "sh -c 'wac run --allow-read --allow-write --allow-run tools/build.wac example/gpt/page.wac dist/gpt --title \"tiny GPT\" && cp example/gpt/data/*.txt dist/gpt/'",
  // The page's own check, in headless Chromium: 20 steps on the GPU and the CPU, every loss agreeing.
  "gpt:check": "node tools/gpucheck.js dist/gpt 1800 test",
  // How long each CPU kernel takes at the GPT's sizes.
  bench: "wac run tools/bench.wac",
  // MNIST: fetched once and checked against its SHA-256, then trained on the CPU — three epochs, about six minutes —
  // writing the weights the page loads.
  "mnist:fetch": "sh tools/fetch-mnist.sh",
  "mnist:train": "wac run --allow-read --allow-write example/mnist/train.wac 3 example/mnist/mnist.weights",
  // The draw-a-digit page, served with the weights and the data beside it.
  "mnist:build": "sh -c 'wac run --allow-read --allow-write --allow-run tools/build.wac example/mnist/page.wac dist/mnist --title Digits && cp example/mnist/mnist.weights example/mnist/data/*-ubyte dist/mnist/'",
  // Its check, in headless Chromium: the loaded model and ten training steps, GPU against CPU.
  "mnist:check": "node tools/gpucheck.js dist/mnist 1800 test",
}
