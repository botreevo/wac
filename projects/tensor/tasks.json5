{
  // Every unit test: the CPU backend, the gradients against finite differences, the layers and optimizers.
  test: "wac test test",
  // The GPU check as a page: every kernel on WebGPU against the CPU backend, from the same numbers.
  "gpucheck:build": "wac run --allow-read --allow-write --allow-run tools/build.wac example/gpucheck.wac dist/gpucheck --title 'wac-tensor GPU check'",
  // ...and run in headless Chromium, which needs Playwright on NODE_PATH; the verdict is the page's title.
  gpucheck: "node tools/gpucheck.js dist/gpucheck",
  // Every WGSL program the GPU backend can make, in both element types, compiled in headless Chromium.
  shaders: "sh -c 'mkdir -p dist && wac run tools/shaders.wac > dist/shaders.txt && node tools/shadercheck.js dist/shaders.txt'",
}
