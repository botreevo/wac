// Attention and the transformer block: gradients against finite differences, and causality as a property.

import { Check } from "./check.wac";
import { Device, Gradients, Tensor, Variable } from "../src/tensor.wac";
import { Layer, MultiHeadAttention, TransformerBlock } from "../src/nn.wac";
import { tensorsOf } from "../src/optim.wac";

/** Each weight's gradient against central differences, nudging the variable itself through `assign`. */
void weightGradients(Check t, Device d, Layer layer, Tensor x, string what) {
  Variable[] ps = layer.params();
  Gradients g = d.gradients(() => layer.apply(x, false).square().sum([], false), tensorsOf(ps));
  f64 eps = 0.01;
  for (i32 k = 0; k < ps.len(); k++) {
    f32[] base = ps[k].valuesNow();
    f32[] analytic = g.grads[k].valuesNow();
    for (i32 i = 0; i < base.len(); i++) {
      f64[] at = [eps, 0.0 - eps];
      f64[] loss = [0.0, 0.0];
      for (i32 s = 0; s < 2; s++) {
        f32[] moved = f32[].filled(base.len(), 0.0);
        moved.copyFrom(base, 0, 0, base.len());
        moved[i] = ((moved[i] as f64) + at[s]) as~ f32;
        ps[k].assign(d.tensor(moved, ps[k].shape));
        loss[s] = layer.apply(x, false).square().sum([], false).item() as f64;
      }
      ps[k].assign(d.tensor(base, ps[k].shape));
      t.near(analytic[i] as f64, (loss[0] - loss[1]) / (2.0 * eps), 0.03, "\{what}: \{ps[k].name}[\{i}]");
    }
  }
}

export string test_attention_gradients() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(21 as i64);
  MultiHeadAttention att = MultiHeadAttention.create(d, 4, 2, true);
  Tensor x = d.normal([2, 3, 4], 0.0, 1.0);
  t.gradient(d, (Tensor[] v) => att.apply(v[0], false).square(), [x], "attention, the input");
  weightGradients(t, d, att, x, "attention");
  return t.report();
}

export string test_transformer_block_gradients() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(22 as i64);
  TransformerBlock block = TransformerBlock.create(d, 4, 2, 0.0);
  Tensor x = d.normal([1, 3, 4], 0.0, 1.0);
  t.gradient(d, (Tensor[] v) => block.apply(v[0], false).square(), [x], "block, the input");
  weightGradients(t, d, block, x, "block");
  return t.report();
}

export string test_a_position_never_sees_the_future() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(23 as i64);
  TransformerBlock block = TransformerBlock.create(d, 8, 2, 0.0);
  f32[] a = d.normal([1, 5, 8], 0.0, 1.0).valuesNow();
  f32[] b = f32[].filled(a.len(), 0.0);
  b.copyFrom(a, 0, 0, a.len());
  // Change only the last two positions.
  for (i32 i = 3 * 8; i < 5 * 8; i++) { b[i] = b[i] + 1.0; }
  f32[] ya = block.apply(d.tensor(a, [1, 5, 8]), false).valuesNow();
  f32[] yb = block.apply(d.tensor(b, [1, 5, 8]), false).valuesNow();
  for (i32 i = 0; i < 3 * 8; i++) { t.ok(ya[i] == yb[i], "position \{i / 8} changed when only later ones did"); }
  bool later = false;
  for (i32 i = 3 * 8; i < 5 * 8; i++) { if (ya[i] != yb[i]) { later = true; } }
  t.ok(later, "the changed positions did change");
  return t.report();
}
