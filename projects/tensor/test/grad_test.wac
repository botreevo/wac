// Every backward rule against central differences — the one oracle that needs no second implementation.

import { Check } from "./check.wac";
import { Device, Gradients, Padding, Tensor } from "../src/tensor.wac";

Tensor positive(Device d, i32[] shape) { return d.uniform(shape, 0.5, 2.0); }

export string test_unary_gradients() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(1 as i64);
  // Away from 0, where abs, relu and step have their kinks.
  Tensor x = d.tensor([-1.3, -0.7, 0.4, 1.1, 2.0, -0.2], [2, 3]);
  Tensor p = positive(d, [2, 3]);
  t.gradient(d, (Tensor[] v) => v[0].neg(), [x], "neg");
  t.gradient(d, (Tensor[] v) => v[0].abs(), [x], "abs");
  t.gradient(d, (Tensor[] v) => v[0].exp(), [x], "exp");
  t.gradient(d, (Tensor[] v) => v[0].expm1(), [x], "expm1");
  t.gradient(d, (Tensor[] v) => v[0].log(), [p], "log");
  t.gradient(d, (Tensor[] v) => v[0].log1p(), [p], "log1p");
  t.gradient(d, (Tensor[] v) => v[0].sqrt(), [p], "sqrt");
  t.gradient(d, (Tensor[] v) => v[0].rsqrt(), [p], "rsqrt");
  t.gradient(d, (Tensor[] v) => v[0].square(), [x], "square");
  t.gradient(d, (Tensor[] v) => v[0].reciprocal(), [p], "reciprocal");
  t.gradient(d, (Tensor[] v) => v[0].sin(), [x], "sin");
  t.gradient(d, (Tensor[] v) => v[0].cos(), [x], "cos");
  t.gradient(d, (Tensor[] v) => v[0].tanh(), [x], "tanh");
  t.gradient(d, (Tensor[] v) => v[0].sigmoid(), [x], "sigmoid");
  t.gradient(d, (Tensor[] v) => v[0].relu(), [x], "relu");
  t.gradient(d, (Tensor[] v) => v[0].softplus(), [x], "softplus");
  t.gradient(d, (Tensor[] v) => v[0].leakyRelu(0.2), [x], "leakyRelu");
  t.gradient(d, (Tensor[] v) => v[0].elu(), [x], "elu");
  t.gradient(d, (Tensor[] v) => v[0].selu(), [x], "selu");
  t.gradient(d, (Tensor[] v) => v[0].gelu(), [x], "gelu");
  t.gradient(d, (Tensor[] v) => v[0].swish(), [x], "swish");
  return t.report();
}

export string test_binary_gradients_with_broadcasting() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(2 as i64);
  Tensor a = d.normal([2, 3], 0.0, 1.0);
  Tensor row = d.normal([3], 0.0, 1.0);
  Tensor col = positive(d, [2, 1]);
  Tensor pa = positive(d, [2, 3]);
  t.gradient(d, (Tensor[] v) => v[0].add(v[1]), [a, row], "add");
  t.gradient(d, (Tensor[] v) => v[0].sub(v[1]), [a, col], "sub");
  t.gradient(d, (Tensor[] v) => v[0].mul(v[1]), [a, row], "mul");
  t.gradient(d, (Tensor[] v) => v[0].div(v[1]), [a, col], "div");
  t.gradient(d, (Tensor[] v) => v[0].pow(v[1]), [pa, row], "pow");
  t.gradient(d, (Tensor[] v) => v[0].maximum(v[1]), [a, row], "maximum");
  t.gradient(d, (Tensor[] v) => v[0].minimum(v[1]), [a, col], "minimum");
  t.gradient(d, (Tensor[] v) => v[0].squaredDifference(v[1]), [a, row], "squaredDifference");
  t.gradient(d, (Tensor[] v) => v[0].greater(0.0).where(v[0], v[1]), [a, row], "where");
  t.gradient(d, (Tensor[] v) => v[0] * v[0] * 3.0 - v[0] / 2.0, [a], "operators");
  return t.report();
}

export string test_reduction_gradients() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(3 as i64);
  Tensor x = d.normal([2, 3, 4], 0.0, 1.0);
  Tensor p = positive(d, [2, 3]);
  t.gradient(d, (Tensor[] v) => v[0].sum([1], false).square(), [x], "sum over the middle");
  t.gradient(d, (Tensor[] v) => v[0].mean([0, 2], true).square(), [x], "mean, kept");
  t.gradient(d, (Tensor[] v) => v[0].max([2], false), [x], "max");
  t.gradient(d, (Tensor[] v) => v[0].min([], false), [x], "min of all");
  t.gradient(d, (Tensor[] v) => v[0].prod([1], false), [p], "prod");
  t.gradient(d, (Tensor[] v) => v[0].variance([1], false), [p], "variance");
  t.gradient(d, (Tensor[] v) => v[0].logSumExp([2], false), [x], "logSumExp");
  t.gradient(d, (Tensor[] v) => v[0].softmax(2).mul(v[0]), [x], "softmax");
  t.gradient(d, (Tensor[] v) => v[0].logSoftmax(1).square(), [x], "logSoftmax");
  return t.report();
}

export string test_shape_gradients() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(4 as i64);
  Tensor x = d.normal([2, 3], 0.0, 1.0);
  Tensor y = d.normal([2, 2], 0.0, 1.0);
  Tensor w = d.normal([2, 3], 0.0, 1.0);
  t.gradient(d, (Tensor[] v) => v[0].reshape([3, 2]).mul(w.reshape([3, 2])), [x], "reshape");
  t.gradient(d, (Tensor[] v) => v[0].t().mul(w.t()), [x], "transpose");
  t.gradient(d, (Tensor[] v) => v[0].slice([0, 1], [2, 2]).square(), [x], "slice");
  t.gradient(d, (Tensor[] v) => v[0].pad([1, 0], [0, 2], 3.0).square(), [x], "pad");
  t.gradient(d, (Tensor[] v) => v[0].concat([v[1]], 1).square(), [x, y], "concat");
  t.gradient(d, (Tensor[] v) => v[0].split([1, 2], 1)[1].square(), [x], "split");
  t.gradient(d, (Tensor[] v) => v[0].reshape([2, 1, 3]).broadcastTo([2, 4, 3]).square(), [x], "broadcastTo");
  t.gradient(d, (Tensor[] v) => v[0].tile([2, 1]).square(), [x], "tile");
  t.gradient(d, (Tensor[] v) => v[0].take(d.vector([1.0, 0.0, 1.0])).square(), [x], "take, a row twice");
  t.gradient(d, (Tensor[] v) => v[0].gather(d.vector([2.0, 2.0, 0.0]), 1).square(), [x], "gather along axis 1");
  return t.report();
}

export string test_matmul_gradients() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(5 as i64);
  Tensor a = d.normal([2, 3], 0.0, 1.0);
  Tensor b = d.normal([3, 4], 0.0, 1.0);
  Tensor bt = d.normal([4, 3], 0.0, 1.0);
  Tensor at = d.normal([3, 2], 0.0, 1.0);
  Tensor batch = d.normal([2, 2, 3], 0.0, 1.0);
  Tensor batch2 = d.normal([2, 3, 2], 0.0, 1.0);
  t.gradient(d, (Tensor[] v) => v[0].matmul(v[1]), [a, b], "matmul");
  t.gradient(d, (Tensor[] v) => v[0].matmulT(v[1], false, true), [a, bt], "a·bᵀ");
  t.gradient(d, (Tensor[] v) => v[0].matmulT(v[1], true, false), [at, b], "aᵀ·b");
  t.gradient(d, (Tensor[] v) => v[0].matmulT(v[1], true, true), [at, bt], "aᵀ·bᵀ");
  t.gradient(d, (Tensor[] v) => v[0].matmul(v[1]), [batch, b], "a batch against one matrix");
  t.gradient(d, (Tensor[] v) => v[0].matmul(v[1]), [batch, batch2], "batch against batch");
  return t.report();
}

export string test_convolution_gradients() {
  Check t = Check.create();
  Device d = Device.cpu();
  d.seed(6 as i64);
  Tensor img = d.normal([2, 5, 5, 2], 0.0, 1.0);
  Tensor f = d.normal([3, 3, 2, 3], 0.0, 1.0);
  t.gradient(d, (Tensor[] v) => v[0].conv2d(v[1], [1, 1], Padding.Same, [1, 1]).square(), [img, f], "conv2d same");
  t.gradient(d, (Tensor[] v) => v[0].conv2d(v[1], [2, 2], Padding.Valid, [1, 1]), [img, f], "conv2d strided");
  t.gradient(d, (Tensor[] v) => v[0].conv2d(v[1], [1, 1], Padding.Valid, [2, 2]), [img, f], "conv2d dilated");
  // Max has a kink wherever two values in a window tie, so its input is spread out: no two within twice the nudge.
  f32[] spread = f32[].filled(100, 0.0);
  for (i32 i = 0; i < 100; i++) { spread[i] = (((i * 37) % 100) as~ f32) * 0.05 - 2.5; }
  Tensor separated = d.tensor(spread, [2, 5, 5, 2]);
  t.gradient(d, (Tensor[] v) => v[0].maxPool([2, 2], [2, 2], Padding.Same).square(), [separated], "maxPool");
  t.gradient(d, (Tensor[] v) => v[0].avgPool([3, 3], [2, 2], Padding.Same).square(), [img], "avgPool");
  Tensor small = d.normal([1, 3, 3, 2], 0.0, 1.0);
  Tensor g = d.normal([2, 2, 3, 2], 0.0, 1.0);
  t.gradient(d, (Tensor[] v) => v[0].conv2dTranspose(v[1], [1, 4, 4, 3], [1, 1], Padding.Valid).square(), [small, g],
             "conv2dTranspose");
  return t.report();
}

export string test_a_gradient_of_a_gradient() {
  Check t = Check.create();
  Device d = Device.cpu();
  Tensor x = d.vector([0.5, -1.5, 2.0]);
  // d/dx of (d/dx x³) = d/dx 3x² = 6x.
  Gradients outer = d.gradients(() => {
    Gradients inner = d.gradients(() => x.pow(3.0).sum([], false), [x]);
    return inner.grads[0].sum([], false);
  }, [x]);
  t.values(outer.grads[0], [3], [3.0, -9.0, 12.0], 0.0001, "second derivative");
  return t.report();
}

export string test_a_tensor_the_value_does_not_reach_has_zero_gradient() {
  Check t = Check.create();
  Device d = Device.cpu();
  Tensor x = d.vector([1.0, 2.0]);
  Tensor unused = d.vector([5.0, 6.0, 7.0]);
  Gradients g = d.gradients(() => x.square().sum([], false), [x, unused]);
  t.values(g.value, i32[](), [5.0], 0.0, "value");
  t.values(g.grads[0], [2], [2.0, 4.0], 0.0, "used");
  t.values(g.grads[1], [3], [0.0, 0.0, 0.0], 0.0, "unused");
  return t.report();
}
