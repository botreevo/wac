// The MNIST example's pieces that are not the library: reading IDX files, and preparing a drawing as MNIST's digits were.

import { Check } from "./check.wac";
import { centred, digitsOf } from "../example/mnist/mnist.wac";

void be(u8[] b, i32 at, i32 v) {
  b[at] = ((v >> 24) & 255) as~ u8;
  b[at + 1] = ((v >> 16) & 255) as~ u8;
  b[at + 2] = ((v >> 8) & 255) as~ u8;
  b[at + 3] = (v & 255) as~ u8;
}

export string test_idx_files_are_read_and_checked() {
  Check t = Check.create();
  u8[] im = u8[].filled(16 + 2 * 784, 0 as u8);
  be(im, 0, 2051);
  be(im, 4, 2);
  be(im, 8, 28);
  be(im, 12, 28);
  im[16 + 784 + 5] = 255 as u8;
  u8[] lb = u8[].filled(10, 0 as u8);
  be(lb, 0, 2049);
  be(lb, 4, 2);
  lb[8] = 7 as u8;
  lb[9] = 3 as u8;
  auto ds = digitsOf(im, lb);
  t.ok(ds.isOk(), "read");
  if (ds.isOk()) {
    t.ok(ds.ok()!.n == 2, "two images");
    t.ok(ds.ok()!.labels[0] == 7.0 && ds.ok()!.labels[1] == 3.0, "labels");
    t.ok(ds.ok()!.pixels[784 + 5] == 1.0 && ds.ok()!.pixels[5] == 0.0, "pixels scaled to [0, 1]");
  }
  be(lb, 4, 3);
  t.ok(digitsOf(im, lb).isErr(), "counts that disagree are refused");
  be(lb, 0, 2051);
  t.ok(digitsOf(im, lb).isErr(), "a wrong magic number is refused");
  return t.report();
}

export string test_a_drawing_is_scaled_and_centred_as_mnist_was() {
  Check t = Check.create();
  // A 10-wide, 40-tall bar in the top-left corner of a 100×100 drawing.
  f32[] drawing = f32[].filled(100 * 100, 0.0);
  for (i32 y = 2; y < 42; y++) { for (i32 x = 3; x < 13; x++) { drawing[y * 100 + x] = 1.0; } }
  f32[] out = centred(drawing, 100);
  i32 top = 28;
  i32 bottom = -1;
  i32 left = 28;
  i32 right = -1;
  f64 mx = 0.0;
  f64 my = 0.0;
  f64 mass = 0.0;
  for (i32 y = 0; y < 28; y++) {
    for (i32 x = 0; x < 28; x++) {
      f64 v = out[y * 28 + x] as f64;
      if (v > 0.0) {
        if (y < top) { top = y; }
        if (y > bottom) { bottom = y; }
        if (x < left) { left = x; }
        if (x > right) { right = x; }
      }
      mx += v * (x as f64);
      my += v * (y as f64);
      mass += v;
    }
  }
  t.ok(bottom - top + 1 == 20, "the long side scaled to 20 pixels: \{bottom - top + 1}");
  t.ok(right - left + 1 == 5, "the short side in proportion: \{right - left + 1}");
  t.near(mx / mass, 14.0, 0.05, "centre of mass across");
  t.near(my / mass, 14.0, 0.05, "centre of mass down");
  f32[] none = centred(f32[].filled(100, 0.0), 10);
  bool empty = true;
  for (f32 v in none) { if (v != 0.0) { empty = false; } }
  t.ok(empty, "no ink, no digit");
  return t.report();
}
