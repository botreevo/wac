// How long each kind of CPU kernel takes at the sizes the tiny GPT runs at, so a slow step can be attributed.
import { Sys } from "std";
import { Device, Tensor } from "../src/tensor.wac";

async f64 time(Sys sys, Device d, string what, i32 reps, fn<Tensor()> f) {
  i64 t0 = await sys.monotonicNanos();
  for (i32 i = 0; i < reps; i++) { d.tidy(f).dispose(); }
  f64 ms = ((await sys.monotonicNanos()) - t0) as~ f64 / 1000000.0 / (reps as f64);
  sys.log("\{what}: \{ms} ms");
  return ms;
}

export async i32 main(Sys sys) {
  Device d = Device.cpu();
  Tensor a = d.normal([512, 64], 0.0, 1.0);
  Tensor w = d.normal([64, 256], 0.0, 1.0);
  Tensor big = d.normal([512, 256], 0.0, 1.0);
  Tensor row = d.normal([256], 0.0, 1.0);
  Tensor att = d.normal([32, 4, 16, 16], 0.0, 1.0);
  Tensor q = d.normal([32, 4, 16, 16], 0.0, 1.0);
  await time(sys, d, "matmul 512x64 · 64x256", 20, () => a.matmul(w));
  await time(sys, d, "matmul, b transposed", 20, () => big.matmulT(w, false, true));
  await time(sys, d, "matmul, a transposed", 20, () => a.matmulT(big, true, false));
  await time(sys, d, "add, same shape 131k", 20, () => big.add(big));
  await time(sys, d, "add a bias row", 20, () => big.add(row));
  await time(sys, d, "gelu 131k", 20, () => big.gelu());
  await time(sys, d, "exp 131k", 20, () => big.exp());
  await time(sys, d, "sum over rows", 20, () => big.sum([1], true));
  await time(sys, d, "sum over columns", 20, () => big.sum([0], false));
  await time(sys, d, "transpose 4d", 20, () => att.transpose([0, 2, 1, 3]));
  await time(sys, d, "softmax", 20, () => att.softmax(-1));
  await time(sys, d, "batched matmul 128x16x16", 20, () => q.matmulT(q, false, true));
  await time(sys, d, "sumTo a bias", 20, () => big.sumTo([256]));
  return 0;
}
