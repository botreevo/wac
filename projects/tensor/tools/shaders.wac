// Every shader the GPU backend can compile, each after a line `//// <name>`: what `tools/shadercheck.js` hands a
// browser to compile, so a WGSL mistake is found without running a model.

import { Sys } from "std";
import { Binary, Reduce, Unary } from "../src/backend.wac";
import {
  argReduceShader, binaryShader, col2imShader, fillShader, gatherShader, im2colShader, matmulShader, padShader,
  reduceShader, scatterAddShader, selectShader, takeShader, unaryShader,
} from "../src/gpu/wgsl.wac";

export i32 main(Sys sys) {
  Unary[] us = [Unary.Neg, Unary.Abs, Unary.Exp, Unary.Expm1, Unary.Log, Unary.Log1p, Unary.Sqrt, Unary.Rsqrt,
                Unary.Square, Unary.Reciprocal, Unary.Sin, Unary.Cos, Unary.Tanh, Unary.Sigmoid, Unary.Relu,
                Unary.Softplus, Unary.Sign, Unary.Floor, Unary.Ceil, Unary.Round, Unary.Step];
  Binary[] bs = [Binary.Add, Binary.Sub, Binary.Mul, Binary.Div, Binary.Pow, Binary.Maximum, Binary.Minimum,
                 Binary.Equal, Binary.NotEqual, Binary.Less, Binary.LessEqual, Binary.Greater, Binary.GreaterEqual];
  Reduce[] rs = [Reduce.Sum, Reduce.Max, Reduce.Min, Reduce.Prod];
  for (i32 i = 0; i < us.len(); i++) { sys.log("//// unary \{i}\n" + unaryShader(us[i])); }
  for (i32 i = 0; i < bs.len(); i++) { sys.log("//// binary \{i}\n" + binaryShader(bs[i])); }
  for (i32 i = 0; i < rs.len(); i++) { sys.log("//// reduce \{i}\n" + reduceShader(rs[i])); }
  sys.log("//// argmax\n" + argReduceShader(true));
  sys.log("//// argmin\n" + argReduceShader(false));
  sys.log("//// select\n" + selectShader());
  sys.log("//// gather\n" + gatherShader());
  sys.log("//// fill\n" + fillShader());
  sys.log("//// pad\n" + padShader());
  sys.log("//// im2col\n" + im2colShader());
  sys.log("//// col2im\n" + col2imShader());
  sys.log("//// take\n" + takeShader());
  sys.log("//// scatteradd\n" + scatterAddShader());
  sys.log("//// matmul\n" + matmulShader());
  return 0;
}
