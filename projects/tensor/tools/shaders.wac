// Every shader the GPU backend can compile, for both element types, each after a line `//// <name>`: what a browser is
// handed to compile (see CLAUDE.md), so a WGSL mistake is found without running a model.

import { Sys } from "std";
import { Binary, DType, Reduce, Unary, dtypeName } from "../src/backend.wac";
import {
  argReduceShader, binaryShader, castShader, col2imShader, fillShader, gatherShader, im2colShader, matmulShader,
  padShader, reduceShader, scatterAddShader, selectShader, takeShader, unaryShader,
} from "../src/gpu/wgsl.wac";

export i32 main(Sys sys) {
  Unary[] us = [Unary.Neg, Unary.Abs, Unary.Exp, Unary.Expm1, Unary.Log, Unary.Log1p, Unary.Sqrt, Unary.Rsqrt,
                Unary.Square, Unary.Reciprocal, Unary.Sin, Unary.Cos, Unary.Tanh, Unary.Sigmoid, Unary.Relu,
                Unary.Softplus, Unary.Sign, Unary.Floor, Unary.Ceil, Unary.Round, Unary.Step];
  Binary[] bs = [Binary.Add, Binary.Sub, Binary.Mul, Binary.Div, Binary.Pow, Binary.Maximum, Binary.Minimum,
                 Binary.Equal, Binary.NotEqual, Binary.Less, Binary.LessEqual, Binary.Greater, Binary.GreaterEqual];
  Reduce[] rs = [Reduce.Sum, Reduce.Max, Reduce.Min, Reduce.Prod];
  DType[] ts = [DType.F32, DType.F16];
  for (DType t in ts) {
    string k = dtypeName(t);
    for (i32 i = 0; i < us.len(); i++) { sys.log("//// unary \{i} \{k}\n" + unaryShader(us[i], t)); }
    for (i32 i = 0; i < bs.len(); i++) { sys.log("//// binary \{i} \{k}\n" + binaryShader(bs[i], t)); }
    for (i32 i = 0; i < rs.len(); i++) { sys.log("//// reduce \{i} \{k}\n" + reduceShader(rs[i], t)); }
    sys.log("//// argmax \{k}\n" + argReduceShader(true, t));
    sys.log("//// argmin \{k}\n" + argReduceShader(false, t));
    sys.log("//// select \{k}\n" + selectShader(t, t));
    sys.log("//// gather \{k}\n" + gatherShader(t));
    sys.log("//// fill \{k}\n" + fillShader(t));
    sys.log("//// pad \{k}\n" + padShader(t));
    sys.log("//// im2col \{k}\n" + im2colShader(t));
    sys.log("//// col2im \{k}\n" + col2imShader(t));
    sys.log("//// take \{k}\n" + takeShader(t, DType.F32));
    sys.log("//// scatteradd \{k}\n" + scatterAddShader(t, DType.F32));
    sys.log("//// matmul \{k}\n" + matmulShader(t));
  }
  sys.log("//// cast f32>f16\n" + castShader(DType.F32, DType.F16));
  sys.log("//// cast f16>f32\n" + castShader(DType.F16, DType.F32));
  return 0;
}
