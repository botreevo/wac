{
  // What another project gets from `import { Device, Tensor } from "tensor"`.
  exports: './src/lib.wac',
  imports: {
    // Only the GPU check page (`example/gpucheck.wac`) and its builder use these: the library itself imports nothing.
    // The pin is a wac-web master commit whose browser host answers `wac.gpu`.
    web: { git: 'https://github.com/voltrevo/wac.git', ref: 'f5813daa14e8873a1b6d228792b26f3dae413da2', subdir: './projects/web' },
    webbuild: { git: 'https://github.com/voltrevo/wac.git', ref: 'f5813daa14e8873a1b6d228792b26f3dae413da2', subdir: './projects/web/tools' },
  },
}
