{
  // What another project gets from `import { Device, Tensor } from "tensor"`.
  exports: './src/lib.wac',
  imports: {
    // Only the GPU check page (`example/gpucheck.wac`) and its builder use these: the library itself imports nothing.
    // The pin is wac-web's `gpu` branch, where the browser's host answers `wac.gpu`.
    web: { git: 'https://github.com/voltrevo/wac-web.git', ref: '4c143a6717ba3ebf5d0cce43a65af42ec24ab17a' },
    webbuild: { git: 'https://github.com/voltrevo/wac-web.git', ref: '4c143a6717ba3ebf5d0cce43a65af42ec24ab17a', subdir: './tools' },
  },
}
