// `strings` — what a program does with text beyond `len`, `slice`, `indexOf` and `+` (spec ch37).
//
// **A module of free functions, as `math` is**, reached as `strings.split(s, ",")` once `strings` is imported from
// `core`: the methods a `string` answers are the compiler's own, and these need nothing from it. Three projects wrote
// most of this file by hand in one week — wac-sudoku, wac-tensor, wac-sqlite — and `packages/wactest`'s `strings.wac`
// was written for the same reason a year of tests ago.
//
// **Bytes, not characters.** A `string` is UTF-8, and every position here is a byte offset, as `slice` and `indexOf`
// are. A search for valid UTF-8 cannot match the middle of a character, so `split`, `replace` and the searches never
// cut one; `toLower` and `toUpper` change ASCII letters only, and leave every other byte as it was.

/** Whether `needle` appears in `s`. The empty needle does, at 0. */
export bool contains(string s, string needle) { return s.indexOf(needle) >= 0; }

/** Whether `s` begins with `prefix`. */
export bool startsWith(string s, string prefix) {
  return prefix.len() <= s.len() && s.slice(0, prefix.len()) == prefix;
}

/** Whether `s` ends with `suffix`. */
export bool endsWith(string s, string suffix) {
  return suffix.len() <= s.len() && s.slice(s.len() - suffix.len(), s.len()) == suffix;
}

/** The first offset at or after `from` where `needle` begins, or -1. */
export i32 indexOfFrom(string s, string needle, i32 from) {
  i32 at = from < 0 ? 0 : from;
  if (at > s.len()) { return -1; }
  i32 found = s.slice(at, s.len()).indexOf(needle);
  return found < 0 ? -1 : at + found;
}

/** The last offset where `needle` begins, or -1. The empty needle is found at `s.len()`. */
export i32 lastIndexOf(string s, string needle) {
  i32 last = -1;
  i32 at = 0;
  while (true) {
    i32 found = indexOfFrom(s, needle, at);
    if (found < 0) { return last; }
    last = found;
    if (needle.len() == 0) { return s.len(); }
    at = found + 1;
  }
  return last;
}

/**
 * `s` cut at every `sep`: `split("a,b,,c", ",")` is `["a", "b", "", "c"]`, and a string with no `sep` is one piece.
 * An empty `sep` is refused, as there is no position it does not match.
 */
export string[] split(string s, string sep) {
  if (sep.len() == 0) { trap "strings.split: an empty separator matches everywhere"; }
  i32 pieces = 1;
  i32 at = 0;
  while (true) {
    i32 found = indexOfFrom(s, sep, at);
    if (found < 0) { break; }
    pieces = pieces + 1;
    at = found + sep.len();
  }
  string[] out = string[].filled(pieces, "");
  i32 k = 0;
  at = 0;
  while (k < pieces - 1) {
    i32 found = indexOfFrom(s, sep, at);
    out[k] = s.slice(at, found);
    k = k + 1;
    at = found + sep.len();
  }
  out[k] = s.slice(at, s.len());
  return out;
}

/** `parts` with `sep` between them — the inverse of `split`. One allocation, however many parts. */
export string join(string[] parts, string sep) {
  if (parts.len() == 0) { return ""; }
  u8[] sb = sep.toBytes();
  i32 total = sb.len() * (parts.len() - 1);
  for (i32 i = 0; i < parts.len(); i++) { total = total + parts[i].len(); }
  u8[] out = u8[].filled(total, 0 as u8);
  i32 at = 0;
  for (i32 i = 0; i < parts.len(); i++) {
    if (i > 0) { for (i32 j = 0; j < sb.len(); j++) { out[at] = sb[j]; at = at + 1; } }
    u8[] pb = parts[i].toBytes();
    for (i32 j = 0; j < pb.len(); j++) { out[at] = pb[j]; at = at + 1; }
  }
  return string.fromBytes(out);
}

/** `s` with every `from` replaced by `to`, left to right and not overlapping. An empty `from` changes nothing. */
export string replace(string s, string from, string to) {
  if (from.len() == 0 || s.indexOf(from) < 0) { return s; }
  return join(split(s, from), to);
}

/** `s` with only its first `from` replaced by `to`. */
export string replaceFirst(string s, string from, string to) {
  i32 at = from.len() == 0 ? -1 : s.indexOf(from);
  if (at < 0) { return s; }
  return s.slice(0, at) + to + s.slice(at + from.len(), s.len());
}

/** Whether byte `b` is ASCII whitespace: space, tab, newline, carriage return, vertical tab or form feed. */
bool isSpaceByte(i32 b) { return b == 32 || (b >= 9 && b <= 13); }

/** `s` without leading or trailing ASCII whitespace. */
export string trim(string s) { return trimEnd(trimStart(s)); }

/** `s` without leading ASCII whitespace. */
export string trimStart(string s) {
  u8[] b = s.toBytes();
  i32 from = 0;
  while (from < b.len() && isSpaceByte(b[from] as i32)) { from = from + 1; }
  return s.slice(from, s.len());
}

/** `s` without trailing ASCII whitespace. */
export string trimEnd(string s) {
  u8[] b = s.toBytes();
  i32 to = b.len();
  while (to > 0 && isSpaceByte(b[to - 1] as i32)) { to = to - 1; }
  return s.slice(0, to);
}

/** `s` with its ASCII letters in lower case; every other byte as it was. */
export string toLower(string s) {
  u8[] b = s.toBytes();
  u8[] out = u8[].filled(b.len(), 0 as u8);
  for (i32 i = 0; i < b.len(); i++) {
    i32 c = b[i] as i32;
    out[i] = (c >= 65 && c <= 90 ? c + 32 : c) as! u8;
  }
  return string.fromBytes(out);
}

/** `s` with its ASCII letters in upper case; every other byte as it was. */
export string toUpper(string s) {
  u8[] b = s.toBytes();
  u8[] out = u8[].filled(b.len(), 0 as u8);
  for (i32 i = 0; i < b.len(); i++) {
    i32 c = b[i] as i32;
    out[i] = (c >= 97 && c <= 122 ? c - 32 : c) as! u8;
  }
  return string.fromBytes(out);
}

/** `s` written `n` times. `n` below zero traps. */
export string repeat(string s, i32 n) {
  if (n < 0) { trap "strings.repeat: a negative count"; }
  string[] parts = string[].filled(n, s);
  return join(parts, "");
}
