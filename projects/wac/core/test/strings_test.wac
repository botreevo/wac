// `core`'s `strings` and `Vec.sort` — `core/strings.wac`, `core/vec.wac`.
import { T } from "../../packages/wactest/src/assert.wac";
import { strings, Vec } from "core";

export string test_the_searches() {
  T t = T.create();
  t.isTrue(strings.contains("hello world", "o w") && !strings.contains("hello", "z") && strings.contains("x", ""), "contains");
  t.isTrue(strings.startsWith("hello", "he") && !strings.startsWith("he", "hello") && strings.endsWith("hello", "llo"), "starts/ends");
  t.eqI32(strings.indexOfFrom("abcabc", "bc", 2), 4, "indexOfFrom");
  t.eqI32(strings.indexOfFrom("abc", "z", 0), -1, "indexOfFrom absent");
  t.eqI32(strings.lastIndexOf("abcabc", "bc"), 4, "lastIndexOf");
  t.eqI32(strings.lastIndexOf("abc", ""), 3, "lastIndexOf empty");
  return t.report();
}

export string test_split_join_replace() {
  T t = T.create();
  string[] p = strings.split("a,b,,c", ",");
  t.eqI32(p.len(), 4, "four pieces");
  t.isTrue(p[0] == "a" && p[1] == "b" && p[2] == "" && p[3] == "c", "the pieces");
  t.isTrue(strings.split("abc", ",").len() == 1 && strings.split("", ",")[0] == "", "no separator");
  t.isTrue(strings.join(p, "-") == "a-b--c" && strings.join(string[](), ",") == "", "join");
  t.isTrue(strings.replace("a.b.c", ".", "::") == "a::b::c" && strings.replace("aaa", "aa", "b") == "ba", "replace");
  t.isTrue(strings.replace("abc", "", "x") == "abc" && strings.replaceFirst("a.b.c", ".", "!") == "a!b.c", "replace edges");
  return t.report();
}

export string test_trim_case_repeat() {
  T t = T.create();
  t.isTrue(strings.trim("  \t hi there \n") == "hi there" && strings.trimStart("  x ") == "x " && strings.trimEnd(" x  ") == " x", "trim");
  t.isTrue(strings.toLower("Hello, ÄB!") == "hello, Äb!" && strings.toUpper("abc-é") == "ABC-é", "case, ASCII only");
  t.isTrue(strings.repeat("ab", 3) == "ababab" && strings.repeat("x", 0) == "", "repeat");
  return t.report();
}

struct Item { i32 key; i32 seq; }

export string test_vec_sort_is_stable() {
  T t = T.create();
  Vec<Item> v = Vec<Item>.create();
  i32[] keys = [5, 3, 5, 1, 3, 9, 0, 5, 2, 2, 7];
  for (i32 i = 0; i < keys.len(); i++) { v.push(Item(keys[i], i)); }
  v.sort((Item a, Item b) => a.key - b.key);
  bool ordered = true;
  for (i32 i = 1; i < v.len(); i++) {
    Item p = v.get(i - 1);
    Item q = v.get(i);
    if (p.key > q.key || (p.key == q.key && p.seq > q.seq)) { ordered = false; }
  }
  t.isTrue(ordered, "sorted by key, equal keys in their first order");
  Vec<i32> e = Vec<i32>.create();
  e.sort((i32 a, i32 b) => a - b);
  t.eqI32(e.len(), 0, "an empty Vec sorts");
  return t.report();
}
