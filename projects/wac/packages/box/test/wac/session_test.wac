// A session whose filesystem is its own.
//
// **This used to spawn.** The Deno test it replaces built `bin/sealedsh.wac` and ran it once per script
// from inside a host directory it then inspected. Both claims here are about the *session's* filesystem,
// so `replay.wac`'s `runSealed` builds the same one in this process.
//
// **What the move costs, said plainly.** Spawned, a sealed session cannot reach the host because the
// binary was built with no filesystem grants and the host enforces that. Here, it cannot reach the host
// because its `Fs` is `Fs.inMemory` and has no path to one — a property of the wiring rather than of a
// permission. That is a real difference in strength, and it is why the *grant* claim is asked of the built shell
// (the last test here, which reads its manifest), and `issues/system/0193` lists the boundary. What is still worth
// asserting in process is that the session's world is its own.

import { Sys } from "std";
import { T } from "../../../wactest/src/assert.wac";
import { builtApp } from "../../../wactest/src/built.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { flatten } from "core";
import { Ran, runSealed, show } from "./replay.wac";

export async string test_a_sealed_shell_has_a_filesystem_and_it_is_not_the_hosts(Sys sys) {
  T t = T.create();
  // It has a working filesystem: directories, files, reads, listings.
  t.eqStr((await runSealed(sys, "mkdir d; echo hi > d/f; cat d/f")).out, "hi\n", "make and read");
  t.eqStr((await runSealed(sys, "mkdir a; mkdir a/b; ls a")).out, "b\n", "nested directories");
  t.eqStr((await runSealed(sys, "echo x > f; wc -c f")).out, "2 f\n", "a size");
  t.eqStr((await runSealed(sys, "echo one > f; echo two > f; cat f")).out, "two\n", "truncating rewrite");
  t.eqStr((await runSealed(sys, "mkdir w; cd w; echo x > f; rm f; ls; echo status=$?")).out, "status=0\n",
          "remove leaves an empty directory");

  // And the root holds `/dev` and `/proc` and nothing else — a *system*, not the host's root with a
  // filter over it. design/0001 step 6; before it, this was empty.
  t.eqStr((await runSealed(sys, "ls /")).out, "bin\ndev\nproc\ntmp\n", "the root of a session");
  // Which a sealed session gets without any grant at all, because `randomBytes` is a host function
  // rather than a permission. This is the one that would be surprising if it stopped being true.
  t.eqStr((await runSealed(sys, "head -c 8 /dev/urandom | wc -c")).out, "8\n", "/dev/urandom");
  t.eqStr((await runSealed(sys, "cat /dev/null; echo [$?]")).out, "[0]\n", "/dev/null");

  // The host's files are not there. A sealed session's cwd is its own, so `.` is not where the process
  // stands and an absolute host path names nothing.
  Ran passwd = await runSealed(sys, "cat /etc/passwd");
  t.isTrue(passwd.err.indexOf("No such file or directory") >= 0, passwd.err);
  t.eqI32(passwd.status, 1, "cat /etc/passwd");
  // This file, which certainly exists on the host and must not exist in here.
  Ran ours = await runSealed(sys, "cat packages/box/test/wac/session_test.wac; echo status=$?");
  t.eqStr(ours.out, "status=1\n", "it read a file from the host: \{show(ours.out)}");
  return t.report();
}

/**
 * Two sealed sessions share nothing.
 *
 * Each run is a fresh filesystem, which is what "in the process" means. A test that wants state across
 * commands puts them in one script — and an image is what changes that (design/0001 step 2), which
 * `backings_test.wac` and `imaged_test.wac` are about.
 */
export async string test_two_sealed_sessions_share_nothing(Sys sys) {
  T t = T.create();
  t.eqStr((await runSealed(sys, "echo remembered > f; cat f")).out, "remembered\n", "the first session");
  Ran second = await runSealed(sys, "cat f; echo status=$?");
  t.eqStr(second.out, "status=1\n", "the second session saw the first's file: \{show(second.out)}");
  return t.report();
}

/**
 * **The one claim about the built artefact: what it asks the host for.** In process, a sealed session cannot reach
 * the host because its `Fs` is `Fs.inMemory` — a property of the wiring. Built, it cannot because the *program was
 * built with no filesystem grants*, which the host enforces and the module's manifest states (`grants`), so a sealed
 * shell that could reach the host would say so there even if it never used it. `issues/system/0193` lists this among
 * the things that are about the artefact. It was box's TypeScript `session.test.ts`, which read a Deno shebang; a
 * built app carries the same answer in its manifest.
 */
export string test_the_sealed_binary_asks_for_no_filesystem_capability_at_all(Sys sys) {
  T t = T.create();
  string sealed = builtApp(sys.env(), sys.files(), sys.procs(), "packages/box/src/bin/sealedsh.wac", "session-sealedsh",
                           string[]());
  string text = string.fromBytes(flatten(sys.files().readFile(sealed).wait()).orElse(u8[]()));
  t.isTrue(contains(text, "\"grants\": {"), "the built shell carries a manifest that states its grants");
  t.isTrue(contains(text, "\"read\": false") && contains(text, "\"write\": false"),
           "a sealed shell must not ask for the filesystem");
  // The canary: the same check sees a grant when there is one, or it proves nothing above.
  string granted = builtApp(sys.env(), sys.files(), sys.procs(), "packages/box/src/bin/sealedsh.wac",
                            "session-sealedsh-read", ["--allow-read"]);
  t.isTrue(contains(string.fromBytes(flatten(sys.files().readFile(granted).wait()).orElse(u8[]())), "\"read\": true"),
           "a build that asks for reading says so where this looks");
  return t.report();
}
