// `wac task verify:fmt` — `ftoa` and `atof` over a large random sweep, with JavaScript's `Number` as the oracle.
//
//     wac run --allow-run packages/fmt/tools/sweep.wac [formatted] [parsed]
//
// The suite's own tests (`test/wac/ftoa_test.wac`, `test/wac/atof_test.wac`) ask the same two questions of a few
// thousand doubles on every run; this asks them of half a million, which is too slow for the gate and worth doing by
// hand after a change to either file. It was a TypeScript sweep (`git log` has it), which drove the wac code from TypeScript; Deno is an
// oracle here and nothing else, answering one line per question through `wactest`'s inline script, and the comparing
// is done on this side.
//
// **Formatting**: every finite double drawn from uniform bit patterns is formatted by `ftoaBytes`, and the oracle's
// `String(x)` must be the same text. **Parsing**: each shortest form is read back by `atofSpan`, and `Number(s)` must
// reach the same bits. The draws are the TypeScript sweep's xorshift, so a mismatch it found this finds too.

import { T } from "../../wactest/src/assert.wac";
import { hex } from "../../wactest/src/oracle.wac";
import { Asked, agree } from "../../wactest/src/inline.wac";
import { Sys } from "std";
import { ftoaBytes } from "../src/ftoa.wac";
import { atofSpan } from "../src/atof.wac";

/** The questions `Number` answers: `f64 <bits16>` is `String(x)`; `p64 <text>` is `Number(text)`'s bits. */
static string NUMBER =
  "const L = (await new Response(Deno.stdin.readable).text()).split(String.fromCharCode(10)).filter((l) => l.length > 0);\n" +
  "const v = new DataView(new ArrayBuffer(8));\n" +
  "const say = (k, a) => {\n" +
  "  if (k === 'f64') { v.setBigUint64(0, BigInt('0x' + a)); return String(v.getFloat64(0)); }\n" +
  "  if (k === 'p64') { v.setFloat64(0, Number(a)); return v.getBigUint64(0).toString(16).padStart(16, '0'); }\n" +
  "  return 'no such question: ' + k;\n" +
  "};\n" +
  "console.log(L.map((l) => { const [k, a] = l.split(' '); return say(k, a); }).concat(['DONE ' + L.length]).join(String.fromCharCode(10)));\n";

/** The TypeScript sweep's generator: xorshift32, 13/17/5, from the seed given. */
struct Xorshift {
  u32 s;

  u32 next(this) {
    this.s = this.s ^ (this.s << 13);
    this.s = this.s ^ (this.s >> 17);
    this.s = this.s ^ (this.s << 5);
    return this.s;
  }
}

/** Two draws as one double, high half first — `setUint32(0, …)` then `setUint32(4, …)`, big-endian. */
f64 nextDouble(Xorshift r) {
  u64 hi = r.next() as u64;
  u64 lo = r.next() as u64;
  return f64.fromBits((hi << 32) | lo);
}

bool isFinite64(f64 x) { return ((f64.toBits(x) >> 52) & 2047) != 2047; }

/** The eight bytes of an f64, big-endian, as hex — the form the oracle reads. */
string bits64(f64 x) {
  u64 b = f64.toBits(x);
  u8[] out = u8[].filled(8, 0);
  for (i32 i = 0; i < 8; i++) { out[i] = (((b >> ((7 - i) * 8)) & 255) as@ i32) as@ u8; }
  return hex(out);
}

/** A count from the command line, or `dflt` when it is absent or not a number. */
i32 countArg(string[] args, i32 at, i32 dflt) {
  if (at >= args.len() || args[at] == "") { return dflt; }
  string digits = "0123456789";
  i32 n = 0;
  for (i32 i = 0; i < args[at].len(); i++) {
    i32 d = digits.indexOf(args[at].slice(i, i + 1));
    if (d < 0 || n > 100000000) { return dflt; }
    n = n * 10 + d;
  }
  return n;
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  i32 formatted = countArg(args, 0, 500000);
  i32 parsedN = countArg(args, 1, 100000);
  T t = T.create();

  Xorshift r = Xorshift(0xdeadbeef as u32);
  Asked fmt = Asked.create();
  i32 checked = 0;
  for (i32 i = 0; i < formatted; i++) {
    f64 x = nextDouble(r);
    if (!isFinite64(x)) { continue; }
    fmt.add("f64 \{bits64(x)}", string.fromBytes(ftoaBytes(x)));
    checked = checked + 1;
  }
  bool fmtOk = await agree(t, sys.procs(), NUMBER, fmt, "\{checked} random doubles formatted");
  await sys.stdout().line("\{checked} finite doubles checked: " + (fmtOk ? "all agree" : "MISMATCHES"));

  Xorshift r2 = Xorshift(0x13579bdf as u32);
  Asked par = Asked.create();
  i32 pChecked = 0;
  for (i32 i = 0; i < parsedN; i++) {
    f64 x = nextDouble(r2);
    if (!isFinite64(x)) { continue; }
    string s = string.fromBytes(ftoaBytes(x));
    par.add("p64 \{s}", bits64(atofSpan(s.toBytes(), 0, s.len())));
    pChecked = pChecked + 1;
  }
  bool parOk = await agree(t, sys.procs(), NUMBER, par, "\{pChecked} shortest forms parsed");
  await sys.stdout().line("\{pChecked} decimals parsed: " + (parOk ? "all agree" : "MISMATCHES"));

  string said = t.report();
  if (said != "") { await sys.stderr().line(said); return 1; }
  return 0;
}
