// GET each URL its arguments name, by `packages/http`'s client, and say what came back: one line per request,
// `status <n> length <n> header <x-probe>` or `err <reason>`. On a host with sockets the client speaks HTTP itself;
// in a page, which has none, it asks the host's `wac.http` — the browser's `fetch`. `test/hostget_live.test.ts`.
//
//     wac run --allow-net packages/platform/example/hostget.wac http://127.0.0.1:8080/a
import { Sys, Output } from "std";
import { request } from "../../http/src/client.wac";
import { Incoming } from "../../http/src/incoming.wac";

export i32 main(Sys sys) {
  Output out = sys.stdout();
  for (string url in sys.args()) {
    // `http://host:port/path`: the client takes the three apart.
    string rest = url.slice(7, url.len());
    i32 slash = rest.indexOf("/");
    string hostPort = slash < 0 ? rest : rest.slice(0, slash);
    string path = slash < 0 ? "/" : rest.slice(slash, rest.len());
    i32 colon = hostPort.indexOf(":");
    string host = colon < 0 ? hostPort : hostPort.slice(0, colon);
    i32 port = 80;
    if (colon >= 0) {
      port = 0;
      for (u8 c in hostPort.slice(colon + 1, hostPort.len()).toBytes()) { port = port * 10 + (c as i32 - 48); }
    }
    auto got = request(sys.net(), "GET".toBytes(), host, port, path, u8[](), "");
    if (got.isErr()) {
      out.write("err \{got.err()!}\n".toBytes()).wait();
      continue;
    }
    Incoming r = got.unwrap();
    u8[] probe = r.headers.first("x-probe");
    string seen = probe.len() == 0 ? "-" : string.fromBytes(probe);
    out.write("status \{r.status} length \{r.body.len()} header \{seen}\n".toBytes()).wait();
  }
  return 0;
}
