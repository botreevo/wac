// An `async` program in a page that cannot wait: no shared memory, no cross-origin isolation.
//
//     wac build --target browser packages/platform/example/unwaiting.wac -o unwaiting.html
//
// Served without `Cross-Origin-Opener-Policy`/`Cross-Origin-Embedder-Policy`, or loaded in an opaque-origin sandbox
// frame, a page has no `SharedArrayBuffer`, so its worker cannot block on the page for an answer. An `async` main does
// not need to: its waits hand control back and the host runs it on when the answer arrives
// (`packages/platform/host/asynchost.ts`). `packages/platform/test/unisolated_live.test.ts` runs this in Chromium.

import { Output, Sys } from "std";

export async i32 main(Sys sys) {
  string[] args = sys.args();
  Output out = sys.stdout();
  out.line("args: \{args.len()}\{args.len() > 0 ? " " + args[0] : ""}");
  i64 before = await sys.monotonicNanos();
  await sys.sleepMillis(20);
  i64 waited = (await sys.monotonicNanos() - before) / 1000000 as i64;
  out.line(waited >= 15 as i64 ? "waited without blocking" : "did not wait: \{waited}ms");
  return 3;
}
