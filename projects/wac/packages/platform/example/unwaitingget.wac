// `wac.http` with a deadline, from an `async` program in a page that cannot wait — and what a blocking request says
// there instead of hanging.
//
//     wac build --target browser --allow-net packages/platform/example/unwaitingget.wac -o unwaitingget.html
//
// Each argument is a URL fetched by `fetchWithinAsync` with a 500ms deadline: `status <n> <body>` or `err <reason>`.
// Then one more by the blocking `fetch`, which a host that cannot wait (`packages/platform/host/asynchost.ts`) cannot
// finish: it says so, `sync err …`, rather than leaving the page waiting for ever.
// `packages/platform/test/unisolated_live.test.ts` runs it in an opaque sandbox frame.

import { Output, Sys } from "std";
import { Caps, Fetched, fetch, fetchWithinAsync } from "../../fetch/src/fetch.wac";

export async i32 main(Sys sys) {
  Output out = sys.stdout();
  Caps caps = Caps(sys.clock(), sys.random(), sys.env(), sys.net(), sys.files());
  string[] urls = sys.args();
  for (string url in urls) {
    auto got = await fetchWithinAsync(caps, "GET", url, string[](), u8[](), 500);
    if (got.isErr()) { out.line("err \{got.err()!}"); continue; }
    Fetched r = got.unwrap();
    out.line("status \{r.status} \{string.fromBytes(r.body)}");
  }
  if (urls.len() > 0) {
    auto blocking = fetch(caps, "GET", urls[0], string[](), u8[]());
    out.line(blocking.isErr() ? "sync err \{blocking.err()!}" : "sync status \{blocking.unwrap().status}");
  }
  return 0;
}
