// `Child.ended()` and `exit()` on every host — spec ch44 `§wac-std-child-ended-q2v8mtf`. A trap was `Ok(1)` on the native
// hosts and an unexplained `Err` on the JavaScript ones, and a program returning 1 could imitate the first; wac-eth's
// reckon needs how a child ended as a value. Each host runs `ended_probe.wac`, whose children exit, trap with a message,
// index out of bounds and recurse without end; every host must say the same of each.

import { Sys, Procs, Exec, SpawnFault, ChildEnv, Launch } from "std";
import { Result, flatten } from "core";
import { T } from "../../../wactest/src/assert.wac";

string want() {
  return "exit: exited 3, exit ok\n" +
         "trap: trapped explicit: the ring is full, exit err\n" +
         "bounds: trapped memory bounds, exit err\n" +
         "deep: trapped stack exhausted, exit err\n" +
         "convert: trapped bad conversion, exit err\n" +
         "overflow: trapped integer overflow, exit err\n";
}

void endedSaid(T t, string host, Result<Exec, SpawnFault> ran) {
  match (ran) {
    Ok(r): {
      t.eqI32(r.status, 0, host + ": the probe ran: " + string.fromBytes(r.stderr));
      t.eqStr(string.fromBytes(r.stdout), want(), host + ": each child's ending, as a value");
    }
    Err(e): { t.fail(host + ": did not run"); }
  }
}

export async string test_every_host_says_how_a_child_ended(Sys sys) {
  T t = T.create();
  Procs procs = sys.procs();
  string probe = "packages/platform/test/wac/ended_probe.wac";
  string dir = flatten(sys.env().cwd().wait()).unwrap() + "/.cache/wac-ended";
  await sys.files().mkdir(dir, true);
  endedSaid(t, "v8", await procs.exec("native/v8/target/release/wac", ["run", "--allow-run", probe],
                                      u8[](), ChildEnv.inherited(), Launch.plain()));
  if ((await sys.files().stat("native/target/release/wac")).isOk()) {
    endedSaid(t, "wasmtime", await procs.exec("native/target/release/wac", ["run", "--allow-run", probe],
                                              u8[](), ChildEnv.inherited(), Launch.plain()));
  }
  string denoOut = dir + "/probe-deno.js";
  await procs.exec("deno", ["run", "-A", "packages/platform/build.ts", probe, "--allow-run",
                            "--target", "deno", "-o", denoOut], u8[](), ChildEnv.inherited(), Launch.plain());
  endedSaid(t, "deno", await procs.exec("deno", ["run", "-A", denoOut], u8[](), ChildEnv.inherited(), Launch.plain()));
  string nodeOut = dir + "/probe-node.js";
  await procs.exec("deno", ["run", "-A", "packages/platform/build.ts", probe, "--allow-run",
                            "--target", "node", "-o", nodeOut], u8[](), ChildEnv.inherited(), Launch.plain());
  endedSaid(t, "node", await procs.exec("node", [nodeOut], u8[](), ChildEnv.inherited(), Launch.plain()));
  return t.report();
}
