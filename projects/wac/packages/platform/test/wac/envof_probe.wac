// An `Env.of` handed to a child — spec ch44 `§wac-std-env-of-k7r2wdn`. Run by `envof_test.wac` on each host. The parent
// spawns itself as `child` with an environment of two variables; the child prints what it sees of three names, the
// third one the host's own, and where it stands, which is still its own.

import { Sys, Env, Authority, Launch, Child, Output } from "std";

u8[]? recipe(string name) {
  if (name == "WAC_HOME") { return "/cache/wac".toBytes(); }
  if (name == "EMPTY") { return u8[](); }
  return null;
}

async string shown(Env env, string name) {
  match (await env.get(name)) {
    Ok(v): { return v is null ? "unset" : "\"" + string.fromBytes(v!) + "\""; }
    Err(e): { return "refused"; }
  }
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  Output out = sys.stdout();
  Env env = sys.env();
  if (args.len() > 0 && args[0] == "child") {
    await out.line("WAC_HOME " + await shown(env, "WAC_HOME") + ", EMPTY " + await shown(env, "EMPTY")
                   + ", PATH " + await shown(env, "PATH") + ", cwd " + ((await env.cwd()).isOk() ? "known" : "unknown"));
    return 0;
  }
  await out.line("parent PATH " + ((await shown(env, "PATH")) == "unset" ? "unset" : "set"));
  Child c = (await sys.procs().spawnSelf(["child"], Authority(null, null, Env.of(recipe), null),
                                         Launch("", false, true, false, false))).unwrap();
  await c.exit();
  return 0;
}
