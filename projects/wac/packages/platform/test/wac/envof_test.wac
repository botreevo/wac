// `Env.of` on every host — spec ch44 `§wac-std-env-of-k7r2wdn`. A runner that must hand a recipe's environment and no
// other (wac-eth's reckon) had no way to: a child's environment was the host's or nothing. Each host runs
// `envof_probe.wac`, whose child is handed two variables by its parent and must see exactly those.

import { Sys, Procs, Exec, SpawnFault, ChildEnv, Launch } from "std";
import { Result, flatten } from "core";
import { T } from "../../../wactest/src/assert.wac";

void envSaid(T t, string host, Result<Exec, SpawnFault> ran) {
  match (ran) {
    Ok(r): {
      t.eqI32(r.status, 0, host + ": the probe ran: " + string.fromBytes(r.stderr));
      t.eqStr(string.fromBytes(r.stdout), "parent PATH set\nWAC_HOME \"/cache/wac\", EMPTY \"\", PATH unset, cwd known\n",
              host + ": the child sees the recipe's variables and no other, and stands where it stands");
    }
    Err(e): { t.fail(host + ": did not run"); }
  }
}

export async string test_a_child_handed_an_env_of_sees_exactly_its_variables_on_every_host(Sys sys) {
  T t = T.create();
  Procs procs = sys.procs();
  string probe = "packages/platform/test/wac/envof_probe.wac";
  string dir = flatten(sys.env().cwd().wait()).unwrap() + "/.cache/wac-envof";
  await sys.files().mkdir(dir, true);
  envSaid(t, "v8", await procs.exec("native/v8/target/release/wac", ["run", "--allow-run", "--allow-env", probe],
                                    u8[](), ChildEnv.inherited(), Launch.plain()));
  if ((await sys.files().stat("native/target/release/wac")).isOk()) {
    envSaid(t, "wasmtime", await procs.exec("native/target/release/wac", ["run", "--allow-run", "--allow-env", probe],
                                            u8[](), ChildEnv.inherited(), Launch.plain()));
  }
  string denoOut = dir + "/probe-deno.js";
  await procs.exec("deno", ["run", "-A", "packages/platform/build.ts", probe, "--allow-run", "--allow-env",
                            "--target", "deno", "-o", denoOut], u8[](), ChildEnv.inherited(), Launch.plain());
  envSaid(t, "deno", await procs.exec("deno", ["run", "-A", denoOut], u8[](), ChildEnv.inherited(), Launch.plain()));
  string nodeOut = dir + "/probe-node.js";
  await procs.exec("deno", ["run", "-A", "packages/platform/build.ts", probe, "--allow-run", "--allow-env",
                            "--target", "node", "-o", nodeOut], u8[](), ChildEnv.inherited(), Launch.plain());
  envSaid(t, "node", await procs.exec("node", [nodeOut], u8[](), ChildEnv.inherited(), Launch.plain()));
  return t.report();
}
