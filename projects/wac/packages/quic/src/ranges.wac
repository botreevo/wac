// A set of `i64`s kept as disjoint, sorted, half-open ranges — what a QUIC endpoint needs in three places: the packet
// numbers it has received (which become ACK frames), the bytes of a stream the peer has acknowledged, and the bytes
// of a stream or CRYPTO level that have arrived out of order.
//
// Small on purpose: a handful of ranges is the normal case, so a sorted vector with a linear merge beats anything
// cleverer, and a peer that tries to make it large is stopped by the caller's bound (`count`).

import { Vec } from "core";

/** `[lo, hi)`. */
export struct Range {
  i64 lo;
  i64 hi;
}

export struct RangeSet {
  Vec<Range> rs = Vec<Range>.create();

  RangeSet create() { return RangeSet { }; }

  i32 count(const this) { return this.rs.len(); }
  bool isEmpty(const this) { return this.rs.len() == 0; }
  Range get(const this, i32 i) { return this.rs.get(i); }

  /** The largest value in the set, or -1 when it is empty. */
  i64 max(const this) { return this.rs.len() == 0 ? -1 as i64 : this.rs.get(this.rs.len() - 1).hi - (1 as i64); }

  bool contains(const this, i64 v) {
    for (i32 i = 0; i < this.rs.len(); i++) {
      const Range r = this.rs.get(i);
      if (v < r.lo) { return false; }
      if (v < r.hi) { return true; }
    }
    return false;
  }

  /** Where the run starting at `from` ends: `from` itself when `from` is not in the set. */
  i64 runFrom(const this, i64 from) {
    for (i32 i = 0; i < this.rs.len(); i++) {
      const Range r = this.rs.get(i);
      if (from >= r.lo && from < r.hi) { return r.hi; }
    }
    return from;
  }

  /** Add `[lo, hi)`, merging with whatever it touches. */
  void add(this, i64 lo, i64 hi) {
    if (hi <= lo) { return; }
    i32 i = 0;
    while (i < this.rs.len() && this.rs.get(i).hi < lo) { i++; }
    // Every range from i that overlaps or touches [lo, hi) is folded into it.
    i64 nlo = lo;
    i64 nhi = hi;
    while (i < this.rs.len() && this.rs.get(i).lo <= nhi) {
      Range r = this.rs.remove(i);
      if (r.lo < nlo) { nlo = r.lo; }
      if (r.hi > nhi) { nhi = r.hi; }
    }
    this.rs.insert(i, Range(nlo, nhi));
  }

  /** Forget everything below `v`. */
  void dropBelow(this, i64 v) {
    while (this.rs.len() > 0) {
      Range r = this.rs.get(0);
      if (r.hi <= v) { this.rs.remove(0); continue; }
      if (r.lo < v) { this.rs.set(0, Range(v, r.hi)); }
      break;
    }
  }

  /** Forget the smallest ranges until at most `n` remain. */
  void keepLargest(this, i32 n) {
    while (this.rs.len() > n) { this.rs.remove(0); }
  }
}
