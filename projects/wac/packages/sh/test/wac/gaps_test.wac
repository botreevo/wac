// What this shell says about the things it does not do.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/sh/test/wac/gaps_test.wac
//
// A gap has three possible answers and they are not equally good. Doing something plausible anyway is the worst — a
// wrong answer nothing can see. Refusing is better. Saying *which side is incomplete* is better still: a caller who
// writes a real flag has written a real flag, and "invalid option" says their command is wrong when this program is
// merely unfinished. So the option sweep asserts a property rather than a wording: **no option GNU has is ever called
// invalid**, with the letters read from the installed tool's own `--help`.
//
// It was packages/sh/test/gaps.test.ts (deleted 2026-11-11), which drove the built shell from TypeScript. The shell here is the same
// executable, built by `builtApp`; the installed coreutils are the only other party.

import { T } from "../../../wactest/src/assert.wac";
import { builtApp } from "../../../wactest/src/built.wac";
import { Exec, ChildEnv, Env, Launch, Procs, Sys } from "std";
import { flatten } from "core";
import { trimmed } from "../../../wactest/src/strings.wac";

struct Said {
  string out;
  string err;
  i32 status;
}

ChildEnv cleared(Env env) {
  u8[]? path = flatten(env.get("PATH").wait()).orElse(null);
  return ChildEnv.empty().set("LC_ALL", "C").set("PATH", path is null ? "/usr/bin:/bin" : string.fromBytes(path!));
}

Said run(Procs procs, ChildEnv e, string cmd, string[] args) {
  Exec? x = flatten(procs.exec(cmd, args, u8[](), e, Launch.plain()).wait()).ok();
  if (x is null) { return Said("", "", 0 - 1); }
  return Said(string.fromBytes(x!.stdout), string.fromBytes(x!.stderr), x!.status);
}

string wacsh(Sys sys) {
  return builtApp(sys.env(), sys.files(), sys.procs(), "packages/sh/src/sh.wac", "gaps-wacsh",
                  ["--allow-read", "--allow-write", "--allow-env"]);
}

Said sh(Sys sys, string shell, string script) { return run(sys.procs(), cleared(sys.env()), shell, ["-c", script]); }

bool isLetter(string c) { return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".indexOf(c) >= 0; }

/**
 * The short options a tool documents, from its own `--help`. **Both spellings on a line**: GNU writes `-r, -R,
 * --recursive`, and a scan anchored at the start of a line would see only the first (wac-mono 0105). A letter counts
 * after leading space or after `, `, and only when `,`, a space, `=`, `[` or the end of the line follows it.
 */
string[] gnuOptions(Procs procs, string tool) {
  Exec? x = flatten(procs.exec(tool, ["--help"], u8[](), ChildEnv.inherited(), Launch.plain()).wait()).ok();
  if (x is null || x!.status != 0) { return string[](); }
  string help = string.fromBytes(x!.stdout);
  string seen = "";
  i32 from = 0;
  for (i32 i = 0; i <= help.len(); i++) {
    if (i < help.len() && help.slice(i, i + 1) != "\n") { continue; }
    string line = help.slice(from, i);
    from = i + 1;
    for (i32 k = 0; k + 1 < line.len(); k++) {
      if (line.slice(k, k + 1) != "-" || !isLetter(line.slice(k + 1, k + 2))) { continue; }
      // What came before: only whitespace from the line's start, or a comma and spaces.
      bool lead = true;
      for (i32 j = 0; j < k; j++) { if (line.slice(j, j + 1) != " " && line.slice(j, j + 1) != "\t") { lead = false; } }
      bool afterComma = false;
      i32 b = k - 1;
      while (b >= 0 && (line.slice(b, b + 1) == " " || line.slice(b, b + 1) == "\t")) { b = b - 1; }
      if (b >= 0 && line.slice(b, b + 1) == ",") { afterComma = true; }
      if (!(lead && k > 0) && !afterComma) { continue; }
      bool ends = k + 2 == line.len() || ", \t=[".indexOf(line.slice(k + 2, k + 3)) >= 0;
      if (!ends) { continue; }
      string letter = line.slice(k + 1, k + 2);
      if (seen.indexOf(letter) < 0) { seen = seen + letter; }
    }
  }
  string[] out = string[].filled(seen.len(), "");
  for (i32 i = 0; i < seen.len(); i++) { out[i] = seen.slice(i, i + 1); }
  return out;
}

/** Read as a bundle, the first letter this could not implement was the second dash: `ls: invalid option -- '-'`. */
export string test_a_long_option_is_one_word_not_a_bundle_of_short_ones(Sys sys) {
  T t = T.create();
  string shell = wacsh(sys);
  if (shell == "") { t.fail("the shell was not built"); return t.report(); }
  t.eqStr(trimmed(sh(sys, shell, "ls --all").err), "ls: long option not implemented: --all", "ls --all");
  t.eqStr(trimmed(sh(sys, shell, "ls --sort=size").err), "ls: long option not implemented: --sort=size", "ls --sort=size");
  // `echo` is not a getopt program: GNU's prints `--nonsense` and says nothing.
  t.eqStr(trimmed(sh(sys, shell, "echo --nonsense").err), "", "echo --nonsense");
  // A name this shell does not have is the shell speaking, with `sh: `, not an option complaint.
  t.eqStr(trimmed(sh(sys, shell, "wc --lines").err), "sh: wc: command not found", "wc --lines");
  return t.report();
}

/**
 * **One tool, and it is a builtin**: `ls`, the one place an option was once read as a filename. The cases run as one
 * script, read off the combined standard error, with a sentinel to prove the batch reached the end; only when that
 * finds something does it re-run them one at a time to say which.
 */
export string test_no_option_gnu_has_is_called_invalid(Sys sys) {
  T t = T.create();
  string shell = wacsh(sys);
  if (shell == "") { t.fail("the shell was not built"); return t.report(); }
  string[] letters = gnuOptions(sys.procs(), "ls");
  t.isTrue(letters.len() > 25, "only \{letters.len()} options found — are the coreutils installed?");
  string sentinel = "__gaps_reached_the_end__";
  string batch = "";
  for (string l in letters) { batch = batch + "echo x | ls -" + l + "; "; }
  Said all = sh(sys, shell, batch + "echo " + sentinel);
  bool finished = all.out.indexOf(sentinel) >= 0;
  bool complained = all.err.indexOf("invalid option") >= 0;
  if (finished && !complained) { return t.report(); }
  string blamed = "";
  for (string l in letters) {
    Said one = sh(sys, shell, "echo x | ls -" + l);
    if (one.err.indexOf("invalid option") >= 0) { blamed = blamed + " -" + l; }
  }
  t.eqStr(blamed, "", "GNU's ls has these options and this shell called them invalid");
  t.isTrue(finished, "the batch reached the end, so every option was checked");
  return t.report();
}

/** The descriptor forms work; the ones that cannot are named — never a syntax error, never blaming a name that exists. */
export string test_the_descriptor_forms_work_and_the_ones_that_cannot_are_named(Sys sys) {
  T t = T.create();
  string shell = wacsh(sys);
  if (shell == "") { t.fail("the shell was not built"); return t.report(); }
  Said merged = sh(sys, shell, "echo hi 1>&2");
  t.eqStr(merged.out, "", "1>&2 leaves nothing on standard output");
  t.eqStr(merged.err, "hi\n", "and puts it on standard error");
  Said dropped = sh(sys, shell, "ls /nosuchfile 2>/dev/null; echo st=$?");
  t.eqStr(dropped.err, "", "2>/dev/null takes the complaint");
  t.eqStr(dropped.out, "st=2\n", "and leaves the status alone");
  t.eqStr(sh(sys, shell, "echo out 2>&1").out, "out\n", "2>&1 with nothing on the error stream changes nothing");
  string[][] refused = [
    ["echo hi 1>&3", "3: Bad file descriptor"],
    ["echo hi 3>&1", "3: Bad file descriptor"],
    ["echo hi 1>&-", "closing standard output is not implemented"],
    ["echo hi 3>f", "redirecting fd 3 is not implemented"],
    ["echo hi & wait", "a builtin cannot be backgrounded"],
    ["jobs & wait", "a builtin cannot be backgrounded"],
    ["f() { echo fn; }; f & wait", "a shell function cannot be backgrounded"]
  ];
  for (string[] r in refused) {
    Said got = sh(sys, shell, r[0]);
    t.isTrue(got.err.indexOf(r[1]) >= 0, r[0] + " should say " + r[1] + ": " + got.err);
    t.isTrue(got.err.indexOf("syntax error") < 0, r[0] + " is not a syntax error");
    t.isTrue(got.err.indexOf("No such file or directory") < 0, r[0] + " must not blame the caller for a name this shell has");
  }
  return t.report();
}

/**
 * Arithmetic increment and assignment are refused by name, not called syntax errors — and what is not an increment
 * keeps working: `5--3` is `5 - (-3)`, and the comparisons spelled with `=` are comparisons.
 */
export string test_arithmetic_increment_and_assignment_are_refused_by_name(Sys sys) {
  T t = T.create();
  string shell = wacsh(sys);
  if (shell == "") { t.fail("the shell was not built"); return t.report(); }
  for (string s in ["x=5; echo $((x++))", "x=5; echo $((++x))", "x=5; echo $((x=7))", "x=5; echo $((x+=2))", "x=5; echo $((x--))"]) {
    Said r = sh(sys, shell, s);
    t.isTrue(r.err.indexOf("is not implemented") >= 0, s + ": a refusal naming the gap, not: " + r.err);
    t.isTrue(r.err.indexOf("syntax error") < 0, s + ": not the caller's expression called malformed");
    t.eqStr(trimmed(r.out), "", s + ": and no answer as well");
  }
  string[][] kept = [["echo $((5--3))", "8"], ["echo $((7 - -3))", "10"], ["echo $((1==1))", "1"], ["echo $((2!=1))", "1"],
                     ["x=3; echo $((x<=3))", "1"], ["x=3; echo $((x>=4))", "0"]];
  for (string[] k in kept) { t.eqStr(trimmed(sh(sys, shell, k[0]).out), k[1], k[0]); }
  return t.report();
}
