// A module the engine will not load, kept where it can be looked at. `issues/lang/0394a`.
//
// `wac build` and `wac compile` ask the engine whether the module they made will load before writing it, and write
// nothing when it will not: the output path keeps naming a module that loads, or nothing. But the rejected bytes are
// the only evidence of the compiler bug that made them, and a person bisecting one needs them on disk — so they are
// written beside where the module would have gone, under a name no build reads, and the message names the file.

import { Files } from "std";
import { flatten } from "core";

/** `out.wasm` (or `out`) becomes `out.rejected.wasm`: beside the output, and never mistaken for it. */
export string rejectedPath(string out) {
  i32 n = out.len();
  string base = n > 5 && out.slice(n - 5, n) == ".wasm" ? out.slice(0, n - 5) : out;
  return "\{base}.rejected.wasm";
}

/** Where the rejected module was kept, said as part of a sentence — or why it could not be. */
export string keptRejected(Files fs, string out, u8[] wasm) {
  string at = rejectedPath(out);
  auto wrote = flatten(fs.writeFile(at, wasm).wait());
  if (wrote.isErr()) { return "and it could not be kept at \{at}: \{wrote.err()!}"; }
  return "the rejected module is at \{at}";
}
