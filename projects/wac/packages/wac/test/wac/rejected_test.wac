// A module the engine will not load is kept beside the output, not in it. `issues/lang/0394a`.
//
//     wac test --allow-read --allow-write --allow-env packages/wac/test/wac/rejected_test.wac
//
// No program known today makes the compiler emit a module the engine refuses — each one found was fixed — so this
// drives the keeping itself, as `wac build` and `wac compile` call it on that path.

import { T } from "../../../wactest/src/assert.wac";
import { Sys } from "std";
import { freshDir, scratch } from "../../../wactest/src/host.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { keptRejected, rejectedPath } from "../../src/rejected.wac";

export string test_the_rejected_name_is_beside_the_output_and_never_the_output() {
  T t = T.create();
  t.eqStr(rejectedPath("dist/app"), "dist/app.rejected.wasm", "a build's stem");
  t.eqStr(rejectedPath("dist/app.wasm"), "dist/app.rejected.wasm", "a compile's file");
  t.eqStr(rejectedPath(".wasm"), ".wasm.rejected.wasm", "a name that is only the extension keeps it");
  return t.report();
}

export async string test_the_rejected_bytes_are_written_and_named(Sys sys) {
  T t = T.create();
  string dir = scratch(sys.env(), "rejected");
  t.eqStr(freshDir(sys.files(), dir), "", "a scratch directory");
  u8[] bytes = [0, 97, 115, 109, 1, 0, 0, 0, 99];
  string said = keptRejected(sys.files(), "\{dir}/out", bytes);
  t.eqStr(said, "the rejected module is at \{dir}/out.rejected.wasm", said);
  u8[] back = (await sys.files().readFile("\{dir}/out.rejected.wasm")).orElse(u8[]());
  t.eqI32(back.len(), bytes.len(), "every byte kept");
  t.isFalse((await sys.files().stat("\{dir}/out.wasm")).isOk(), "and nothing at the output's own name");
  return t.report();
}

export async string test_a_module_that_cannot_be_kept_says_so(Sys sys) {
  T t = T.create();
  string dir = scratch(sys.env(), "rejected-ro");
  t.eqStr(freshDir(sys.files(), dir), "", "a scratch directory");
  string said = keptRejected(sys.files().readOnly(), "\{dir}/out", [0, 97, 115, 109]);
  t.isTrue(contains(said, "could not be kept at \{dir}/out.rejected.wasm"), said);
  return t.report();
}
