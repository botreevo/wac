// A program whose imports outnumber the emitter's old table still calls the function each name was imported from.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/importedges_test.wac
//
// The emitter records each import edge — one imported name — so that a call resolves to the file it was imported
// from. It held 4096 and skipped the rest (`continue`) while the link step holds 32767; box alone has 2,236. A skipped
// edge sent its name to the module-wide lookup, which picks wrongly or declines when two files declare it — the sweep
// after `issues/lang/0468d` found it. Here `main` imports 4200 names from `a.wac`, the last of them also declared by
// `c.wac`, and must call `a.wac`'s.

import { T } from "../../../wactest/src/assert.wac";
import { Sys } from "std";
import { Ran, runEmitted, scratchDir } from "./artifacts_probe.wac";

static i32 N = 4200;

string aSource() {
  string out = "";
  for (i32 k = 0; k < N; k++) { out = out + "export i32 f\{k}() { return \{k == N - 1 ? "7" : "1"}; }\n"; }
  return out;
}

string mainSource() {
  string names = "";
  for (i32 k = 0; k < N; k++) { names = names + (k == 0 ? "" : ", ") + "f\{k}"; }
  // `c.wac` first, so its edge is one the old table kept: with both files' edges recorded except `f4199`'s, the lookup
  // that falls back to "a file this one imports" finds two candidates and declines the module.
  return "import { marker } from \"./c.wac\";\nimport { " + names + " } from \"./a.wac\";\n"
    + "export i32 main() { return f\{N - 1}() + marker(); }\n";
}

export string test_the_last_of_many_imports_resolves_to_the_file_it_came_from(Sys sys) {
  T t = T.create();
  string c = "export i32 f\{N - 1}() { return 9; }\nexport i32 marker() { return 0; }\n";
  Ran r = runEmitted(sys.env(), sys.files(), sys.procs(), ["/t/main.wac", "/t/a.wac", "/t/c.wac"],
                     [mainSource(), aSource(), c], "/t/main.wac", scratchDir(sys.env(), sys.files()), "importedges.wasm",
                     0, string[]());
  t.isTrue(r.ok, "the program built and ran — " + r.error + r.stderr);
  t.eqI32(r.status, 7, "f\{N - 1} is a.wac's, as imported (9 would be c.wac's)");
  return t.report();
}
