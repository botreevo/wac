// An `async` body with more locals than the plan once held keeps every one of them across a suspension.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/manylocals_test.wac
//
// `planBody` lists the locals a machine must hoist into cells, and the list was a fixed 256 that stopped recording —
// past it a local was not hoisted, which its own comment calls *"a local that silently resets on resume"* (the sweep
// after `issues/lang/0468d`). Here 300 locals are set before an `await` and summed after it.

import { T } from "../../../wactest/src/assert.wac";
import { Sys } from "std";
import { Ran, runEmittedOne, scratchDir } from "./artifacts_probe.wac";

static i32 N = 300;

string program() {
  string out = "import { Ticket } from \"core\";\n"
    + "Ticket<i32> ready(i32 v) { Ticket<i32> t; t.resolve(v); return t; }\n"
    + "async i32 many() {\n";
  for (i32 k = 0; k < N; k++) { out = out + "  i32 v\{k} = \{k % 7};\n"; }
  out = out + "  await ready(0);\n  i32 s = 0;\n";
  for (i32 k = 0; k < N; k++) { out = out + "  s = s + v\{k};\n"; }
  return out + "  return s;\n}\nexport i32 main() { return many().wait()! % 250; }\n";
}

export string test_three_hundred_locals_survive_an_await(Sys sys) {
  T t = T.create();
  i32 want = 0;
  for (i32 k = 0; k < N; k++) { want = want + k % 7; }
  Ran r = runEmittedOne(sys.env(), sys.files(), sys.procs(), "/t/m.wac", program(), scratchDir(sys.env(), sys.files()),
                        "manylocals.wasm");
  t.isTrue(r.ok, "the program built and ran — " + r.error + r.stderr);
  t.eqI32(r.status, want % 250, "the sum of all \{N} locals, read after the await");
  return t.report();
}
