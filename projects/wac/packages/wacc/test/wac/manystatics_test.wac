// A program with more module constants than the evaluator's first tables still has a value for every one.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/manystatics_test.wac
//
// `demandConst` kept each constant's state in tables of 1024, and a constant past them answered "no value" with the
// status still ok — the checker asks it for every constant a program declares — and the emitter refused the 513th
// constant outright (the sweep after `issues/lang/0468d`). Here 1100 constants are declared and the last is the
// answer. Each is its own literal rather than the one before plus one: a chain 1100 deep is a question about the
// evaluator's recursion depth, which is not what this asks.

import { T } from "../../../wactest/src/assert.wac";
import { Sys } from "std";
import { Ran, runEmittedOne, scratchDir } from "./artifacts_probe.wac";

static i32 N = 1100;

string program() {
  string out = "";
  for (i32 k = 0; k < N; k++) { out = out + "static i32 C\{k} = \{k + 1};\n"; }
  return out + "export i32 main() { return C\{N - 1} % 250; }\n";
}

export string test_the_eleven_hundredth_constant_has_its_value(Sys sys) {
  T t = T.create();
  Ran r = runEmittedOne(sys.env(), sys.files(), sys.procs(), "/t/m.wac", program(), scratchDir(sys.env(), sys.files()),
                        "manystatics.wasm");
  t.isTrue(r.ok, "the program built and ran — " + r.error + r.stderr);
  t.eqI32(r.status, N % 250, "C\{N - 1} is \{N}");
  return t.report();
}
