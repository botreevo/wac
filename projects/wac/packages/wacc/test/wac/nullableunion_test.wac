// A narrower union goes into a nullable wider one, as it goes into the wider one. `issues/lang/0409a`.
//
//     wac test packages/wacc/test/wac/nullableunion_test.wac
//
// `Wide w = narrow` was accepted and `Wide? n = narrow` refused — *initialiser does not match the declared type* —
// because the checker refused any union source into a slot that was not itself a union before it unwrapped the `?`.
// Checked, then emitted and run, since an acceptance the emitter cannot write is a worse answer than the refusal.

import { T } from "../../../wactest/src/assert.wac";
import { Authority, Sys } from "std";
import { dumpTypeErrors, emitFiles, manifestFiles } from "../../src/api.wac";
import { withManifestSection } from "../../src/manifest.wac";

static string SRC = "struct A { string m; }\nstruct B { string m; }\nstruct C { string m; }\n" +
  "type Wide = union<A, B, C>;\ntype Narrow = union<A, B>;\n" +
  "Narrow pick(bool x) { return x ? A(\"a\") : B(\"b\"); }\n" +
  "export i32 run(i32 unused) {\n  Wide w = pick(true);\n  Wide? n = null;\n  n = pick(false);\n" +
  "  Wide? m = pick(true);\n  Wide? none = null;\n" +
  "  return (n is null ? 0 : 1) + (m is null ? 0 : 1) + (none is null ? 0 : 10) + (n is B ? 100 : 0);\n}\n";

export string test_a_narrower_union_widens_into_a_nullable_wider_one(Sys sys) {
  T t = T.create();
  t.eqI32(dumpTypeErrors(SRC.toBytes()).len(), 0, "accepted at every position");
  u8[] wasm = emitFiles(["/t/m.wac"], [SRC], "/t/m.wac");
  t.isTrue(wasm.len() > 8, "emitted");
  auto loaded = sys.modules().load(withManifestSection(wasm, manifestFiles(wasm, ["/t/m.wac"], [SRC], "/t/m.wac", "m", 0)),
                                   Authority.none());
  auto valid = sys.modules().validate(wasm);
  t.isTrue(valid.isOk(), "a module the engine accepts: \{valid.isErr() ? "\{valid.err()!}" : ""}");
  t.isTrue(loaded.isOk(), "the engine loads it: \{loaded.isErr() ? "\{loaded.err()!}" : ""}");
  if (loaded.isOk()) {
    auto r = loaded.unwrap().call("run", 0);
    t.isTrue(r.isOk(), "called");
    if (r.isOk()) { t.eqI32(r.unwrap().value, 102, "both held, the empty one empty, and n is still a B: \{r.unwrap().text}"); }
  }
  // **Only widening**: a wider union does not narrow into a nullable narrower one without a cast.
  string narrowing = "struct A { string m; }\nstruct B { string m; }\nstruct C { string m; }\n" +
    "type Wide = union<A, B, C>;\ntype Narrow = union<A, B>;\nWide any() { return C(\"c\"); }\n" +
    "export i32 f() { Narrow? n = any(); return n is null ? 0 : 1; }\n";
  t.isTrue(dumpTypeErrors(narrowing.toBytes()).len() > 0, "a Wide into a Narrow? is still refused");
  return t.report();
}
