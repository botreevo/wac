// A program build's diagnostics are placed on the entry as written. `issues/lang/0399a`.
//
//     wac test packages/wacc/test/wac/programdiag_test.wac
//
// `wac build` adapts a `main(Sys)` before checking it: `main` becomes `__wacMain` and an adapter follows the last
// line. A mistake on `main`'s line was reported five columns right of where `wac check` puts it, and the adapter's
// calls into the broken `main` were reported as well, at lines the author's file does not have. Here the build's
// wire, mapped, says what `check`'s does.

import { T } from "../../../wactest/src/assert.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { diagnoseFiles } from "../../src/api.wac";
import { mappedToEntry, programEntry } from "../../src/program.wac";

static string ENTRY = "/t/m.wac";

/** The wire's rows that are errors, as `line:col message`-ish text: the path, line and column fields. */
string placed(string wire) {
  string out = "";
  i32 from = 0;
  for (i32 i = 0; i <= wire.len(); i++) {
    if (i < wire.len() && wire[i] != "\n") { continue; }
    string row = wire.slice(from, i);
    from = i + 1;
    if (row == "") { continue; }
    i32 a = row.indexOf("\t");
    string rest = row.slice(a + 1, row.len());
    i32 b = rest.indexOf("\t");
    string rest2 = rest.slice(b + 1, rest.len());
    i32 c = rest2.indexOf("\t");
    out = out + rest.slice(0, b) + ":" + rest2.slice(0, c) + ";";
  }
  return out;
}

export string test_a_mistake_on_mains_line_is_where_check_puts_it_and_alone() {
  T t = T.create();
  string written = "import { Result } from \"core\";\n\nexport async Result<void> main(Sys sys) {\n" +
                   "  try await sys.stdout().line(\"hi\");\n  return Result.Ok();\n}\n";
  string adapted = programEntry(written).source;
  t.isTrue(adapted != written, "the entry was adapted");
  string checked = diagnoseFiles([ENTRY], [written], ENTRY);
  string built = diagnoseFiles([ENTRY], [adapted], ENTRY);
  t.isTrue(placed(built) != placed(checked), "the control: unmapped, the build's wire differs — \{placed(built)}");
  string mapped = mappedToEntry(built, ENTRY, written, adapted);
  t.eqStr(placed(mapped), placed(checked), "mapped, the build says what check says");
  t.isFalse(contains(mapped, "__wac"), "and nothing of the adapter's: \{mapped}");
  return t.report();
}

/** With nothing wrong in what the author wrote, an error in the adapter is the compiler's, and is kept. */
export string test_an_error_only_the_adapter_has_is_kept() {
  T t = T.create();
  string written = "export i32 main() { return 0; }\n";
  string adapted = written + "\nvoid __wacBroken() { nope(); }\n";
  string wire = diagnoseFiles([ENTRY], [adapted], ENTRY);
  t.isTrue(wire != "", "the control: the adapter's line is an error");
  t.eqStr(mappedToEntry(wire, ENTRY, written, adapted), wire, "kept, unchanged");
  return t.report();
}
