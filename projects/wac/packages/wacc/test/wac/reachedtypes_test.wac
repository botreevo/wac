// The types a file reaches through an import's signatures are all declared, however many the signature mentions.
//
//     wac test packages/wacc/test/wac/reachedtypes_test.wac
//
// `issues/lang/0468d`, from wacuum: `closeOverSignatures` gathers the type names a wanted declaration's fields, methods
// and parameters mention, so that a file importing `Engine` also declares the `Answer` that `Engine.call` returns. It
// gathered them into a list of 64 and dropped the rest without a word. wacuum's `Engine` has 41 fields, most of them
// `Map<U256, …>` — three names each — so three more fields pushed `Answer` off the end; the devnet, which imports
// `Engine`, then read the bare name as std's own `Answer`, and `.result` was *"no such field"*.
//
// Asked of the function directly, because the visible failure needs a second type of the same name somewhere in the
// importer's reach, and the function is where the name went missing.

import { T } from "../../../wactest/src/assert.wac";
import { lex } from "../../src/lex.wac";
import { P, parseProgram } from "../../src/parse.wac";
import { closeOverSignatures } from "../../src/api.wac";

/** A struct with `n` fields that each mention two type names, and a method returning `Answer`, after them. */
string source(i32 n) {
  string out = "import { Vec } from \"core\";\nexport struct Answer { i32 result; }\nexport struct Engine {\n";
  for (i32 i = 0; i < n; i++) { out = out + "  Vec<Vec<i32>> f\{i};\n"; }
  return out + "  Answer call(this) { return Answer(1); }\n}\n";
}

bool reaches(i32 n, string name) {
  u8[] src = source(n).toBytes();
  string[] got = closeOverSignatures(src, lex(src), parseProgram(P.create(src, lex(src))), ["Engine"]);
  for (string g in got) { if (g == name) { return true; } }
  return false;
}

export string test_a_method_return_type_is_reached_after_many_field_types() {
  T t = T.create();
  t.isTrue(reaches(10, "Answer"), "10 fields: Answer is reached");
  // 40 fields mention 80 names before the method's return type — past the 64 the list once held.
  t.isTrue(reaches(40, "Answer"), "40 fields: Answer is still reached");
  t.isTrue(reaches(400, "Answer"), "400 fields: and with no bound at all");
  return t.report();
}
