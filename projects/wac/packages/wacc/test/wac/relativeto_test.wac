// `relativeTo(base, abs)` — an absolute path written from an absolute base, which is how a discovered `@/` root becomes
// a key in the graph (`packages/wacc/src/path.wac`).
//
// **From the root it climbed out of nothing**: `base + "/"` is `//` there, so `/in/in` came back `../in/in`, and a
// relative entry built in `/` had every `@/` import "leave its project" — wac-eth's reckon, whose deterministic machine
// runs the compiler with its working directory at the root (`issues/lang/0450d`).

import { T } from "../../../wactest/src/assert.wac";
import { relativeTo } from "../../src/path.wac";

export string test_a_path_from_the_root_is_itself_without_its_slash() {
  T t = T.create();
  t.eqStr(relativeTo("/", "/in/in"), "in/in", "a directory under the root");
  t.eqStr(relativeTo("/", "/in/in/sub/main.wac"), "in/in/sub/main.wac", "a file under the root");
  t.eqStr(relativeTo("/", "/"), ".", "the root itself");
  return t.report();
}

export string test_the_other_bases_answer_as_they_did() {
  T t = T.create();
  t.eqStr(relativeTo("/a/b", "/a/b/c.wac"), "c.wac", "below the base");
  t.eqStr(relativeTo("/a/b", "/a/src/c.wac"), "../src/c.wac", "beside the base");
  t.eqStr(relativeTo("/a/b", "/a/bc/x.wac"), "../bc/x.wac", "a sibling whose name the base's last part begins");
  t.eqStr(relativeTo("/a/b", "/a/b"), ".", "the base itself");
  return t.report();
}
