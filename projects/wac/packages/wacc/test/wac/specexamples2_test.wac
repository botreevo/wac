// The specification's examples that are met stay met — part 2 of `specPart` (`./specexamples.wac`).
//
// `specexamples_test.wac` says why the examples are three files, and holds the check that the parts cover
// every chapter; this file is only the part.

import { Sys } from "std";
import { heldStillMet } from "./specexamples.wac";

export string test_every_spec_example_once_met_is_still_met(Sys sys) { return heldStillMet(sys, 2); }
