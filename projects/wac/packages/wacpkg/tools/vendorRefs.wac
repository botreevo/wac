// Generates `test/vendor/refs.json` from real `git`, the oracle for `src/refs.wac`.
//
//     wac run --allow-read --allow-write --allow-run --allow-env packages/wacpkg/tools/vendorRefs.wac \
//       > packages/wacpkg/test/vendor/refs.json
//
// Run by hand. The corpus is committed, so the tests need neither `git` nor a network and cannot start passing because
// a command was missing. It was a TypeScript script; `git` was always the oracle, and now a wac program asks it.
//
// **The repository is built here rather than described.** A ref table typed out by hand would be a table of what I
// believe `git ls-remote` prints, and the interesting rows are exactly the ones where that belief is wrong — an
// annotated tag advertising two lines, a name that is both a branch and a tag. So this makes the refs with `git`, reads
// the advertisement with `git ls-remote`, and asks `git rev-parse <ref>^{commit}` what each query means.
//
// `^{commit}` and not plain `rev-parse`: the question is which commit a fetcher would check out, and for an annotated
// tag plain `rev-parse` answers with the tag object.
//
// **Committed with fixed identities and dates**, so two runs produce the same object names and re-vendoring is a no-op
// diff rather than a wall of changed hashes. The output is laid out as `JSON.stringify(…, null, 2)` laid it out.

import { Sys, Files, Procs, ChildEnv, Launch, Exec } from "std";
import { Buf, Vec, flatten } from "core";
import { writeString } from "../../json/src/stringify.wac";

/** The environment every `git` here runs in: fixed people, fixed dates, and no user or system config. */
ChildEnv gitEnv() {
  return ChildEnv.empty()
    .set("GIT_AUTHOR_NAME", "wac").set("GIT_AUTHOR_EMAIL", "wac@example.invalid")
    .set("GIT_COMMITTER_NAME", "wac").set("GIT_COMMITTER_EMAIL", "wac@example.invalid")
    .set("GIT_AUTHOR_DATE", "2026-01-01T00:00:00Z").set("GIT_COMMITTER_DATE", "2026-01-01T00:00:00Z")
    .set("GIT_CONFIG_GLOBAL", "/dev/null").set("GIT_CONFIG_SYSTEM", "/dev/null")
    .set("PATH", "/usr/local/bin:/usr/bin:/bin");
}

/** Trailing whitespace off, as `.trim()` took it. */
string trimmed(string s) {
  i32 a = 0;
  i32 b = s.len();
  string ws = " \t\r\n";
  while (a < b && ws.indexOf(s.slice(a, a + 1)) >= 0) { a = a + 1; }
  while (b > a && ws.indexOf(s.slice(b - 1, b)) >= 0) { b = b - 1; }
  return s.slice(a, b);
}

/** `git args…` in `cwd`: its trimmed output, or `!` and the first line of what it said when it failed. */
async string git(Procs procs, string cwd, string[] args) {
  Exec? e = (await procs.exec("git", args, u8[](), gitEnv(), Launch(cwd, false, false, false, false))).ok();
  if (e is null) { return "!git did not start"; }
  if (e!.status != 0) {
    string err = trimmed(string.fromBytes(e!.stderr));
    i32 nl = err.indexOf("\n");
    return "!" + (nl >= 0 ? err.slice(0, nl) : err);
  }
  return trimmed(string.fromBytes(e!.stdout));
}

/** `s` as a JSON string. */
string q(string s) {
  Buf b = Buf.create();
  writeString(b, s.toBytes());
  return string.fromBytes(b.take());
}

export async i32 main(Sys sys) {
  Procs procs = sys.procs();
  Files fs = sys.files();
  u8[] r = flatten(sys.random().bytes(6).wait()).orElse(u8[]());
  string suffix = "";
  string hexd = "0123456789abcdef";
  for (i32 i = 0; i < r.len(); i++) {
    i32 v = r[i] as i32;
    suffix = suffix + hexd.slice(v >> 4, (v >> 4) + 1) + hexd.slice(v & 15, (v & 15) + 1);
  }
  string dir = "/tmp/wacpkg-refs-" + suffix;
  await fs.mkdir(dir, true);

  await git(procs, dir, ["init", "-q", "-b", "main", "."]);
  await fs.writeFile(dir + "/a.txt", "one\n".toBytes());
  await git(procs, dir, ["add", "a.txt"]);
  await git(procs, dir, ["commit", "-q", "-m", "one"]);
  await git(procs, dir, ["branch", "feature/x"]);
  await git(procs, dir, ["tag", "light"]);
  await git(procs, dir, ["tag", "-a", "v1", "-m", "release one"]);
  // The shape the rule refuses: one name that is both a branch and a tag.
  await git(procs, dir, ["branch", "dup"]);
  await git(procs, dir, ["tag", "dup"]);
  // A second commit, so `main` and the tags are not all the same object and a wrong answer shows.
  await fs.writeFile(dir + "/a.txt", "two\n".toBytes());
  await git(procs, dir, ["commit", "-q", "-am", "two"]);

  Vec<string> rows = Vec.create();
  string listed = await git(procs, dir, ["ls-remote", "."]);
  i32 from = 0;
  for (i32 i = 0; i <= listed.len(); i++) {
    if (i < listed.len() && listed.slice(i, i + 1) != "\n") { continue; }
    string line = listed.slice(from, i);
    from = i + 1;
    i32 tab = line.indexOf("\t");
    if (tab <= 0 || tab == line.len() - 1) { continue; }
    rows.push("    {\n      \"name\": " + q(line.slice(tab + 1, line.len())) + ",\n      \"commit\": "
              + q(line.slice(0, tab)) + "\n    }");
  }

  string head = await git(procs, dir, ["rev-parse", "HEAD"]);
  string[] queries = ["main", "feature/x", "light", "v1", "dup", "HEAD", "refs/heads/main", "refs/tags/v1",
                      "refs/tags/v1^{}", "refs/heads/feature/x", head, "nope", "refs/heads/nope", ""];
  Vec<string> asked = Vec.create();
  for (string qr in queries) {
    string answer = qr == "" ? "!empty" : await git(procs, dir, ["rev-parse", qr + "^{commit}"]);
    bool refused = answer.len() > 0 && answer.slice(0, 1) == "!";
    asked.push("    {\n      \"ref\": " + q(qr) + ",\n      \"git\": " + (refused ? "null" : q(answer))
               + ",\n      \"why\": " + (refused ? q(answer.slice(1, answer.len())) : "null") + "\n    }");
  }
  await fs.remove(dir, true);

  string version = await git(procs, ".", ["--version"]);
  Buf out = Buf.create();
  out.pushAll("{\n  \"source\": ".toBytes());
  out.pushAll(q("real git — " + (version != "" && version.slice(0, 1) != "!" ? version : "git")).toBytes());
  out.pushAll(",\n  \"note\": ".toBytes());
  out.pushAll(q("advertised is `git ls-remote .`; queries are `git rev-parse <ref>^{commit}`, null when git refused").toBytes());
  out.pushAll(",\n  \"advertised\": [\n".toBytes());
  for (i32 i = 0; i < rows.len(); i++) { out.pushAll((rows.get(i) + (i + 1 < rows.len() ? ",\n" : "\n")).toBytes()); }
  out.pushAll("  ],\n  \"queries\": [\n".toBytes());
  for (i32 i = 0; i < asked.len(); i++) { out.pushAll((asked.get(i) + (i + 1 < asked.len() ? ",\n" : "\n")).toBytes()); }
  out.pushAll("  ]\n}".toBytes());
  await sys.stdout().line(string.fromBytes(out.take()));
  return 0;
}
