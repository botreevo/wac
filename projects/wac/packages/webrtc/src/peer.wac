// A DTLS peer, in the server role: the handshake state that was living in a test.
//
// `dtls.wac` builds messages and `dtlskeys.wac` derives keys; neither remembers anything. This is
// what remembers — and it exists for the same reason the SCTP association does, which is that the state a
// protocol needs between datagrams is exactly the state that gets forgotten when a caller holds it.
//
// ## What has to be remembered, and why each piece bites
//
//   - **The transcript.** Every handshake message, in order, as if none had been fragmented. Get one
//     byte wrong and the Finished fails with `decrypt_error` and nothing else to go on.
//   - **Reassembly.** A browser's ClientHello is 1,413 bytes and arrives in pieces. Reading a
//     fragment as though it were a message gives a "client random" from the middle of it — which is
//     `issues/system/0151`, and it cost an afternoon.
//   - **Two sequence counters.** The record sequence and the handshake `message_seq` both run
//     continuously across the handshake, and the HelloVerifyRequest spends one of each. Restarting
//     either makes the ServerHello look like a replay: OpenSSL says `unexpected message` for one and
//     `read timeout expired` for the other, and neither names a counter.
//
// Three separate bugs, all of them state a caller was keeping. That is the argument for this struct.
//
// ## What it is not
//
// **No retransmission and no timer.** A lost flight is not resent, which on loopback never happens
// and on a real path is the first thing that does. The client role is also absent: this answers a
// handshake, it does not start one. Both are in `design/system/0008`'s list rather than half-built.

import { Record, certificateMessage, certificateRequest, clientPublic, curveX25519, handshake, helloCookie,
         helloRandom, helloSrtpProfile, helloVerifyRequest, leafCertificate, parseHandshake, parseRecord, record,
         recordSize, serverEcdhParams, serverHello, serverHelloDone, serverKeyExchange, typeChangeCipherSpec,
         typeHandshake, versionDtls10, versionDtls12, clientKeyExchange, serverCurve, serverKeyExchangeScheme,
         serverKeyExchangeSignature, serverKeyExchangeSigned, serverPublic, chosenSuite, verifyCookie, curveSecp256r1 } from "./dtls.wac";
import { keyBlock, masterSecret, open, seal, verifyData } from "./dtlskeys.wac";
import { p256Sign, p256Decodes, p256Ecdh, p256PublicKey } from "../../crypto/src/p256.wac";
import { x25519, x25519Base, x25519Shared } from "../../crypto/src/x25519.wac";
import { derInteger, derSequence } from "../../tls/src/derwrite.wac";
import { Cert, certVerifySignature, parseCert } from "../../tls/src/x509.wac";
import { Vec } from "core";

/**
 * A DTLS endpoint in either role, as `Session` drives it: `Peer` answers a handshake, `ClientPeer` (below)
 * starts one. Datagrams in, datagrams out; application records opened and sealed; and who the peer proved to be.
 */
export struct Dtls {
  /** Answer one datagram with the datagrams to send. */
  virtual u8[][] receive(this, u8[] datagram) { trap; }
  /** Open the application record at `at`, or empty. */
  virtual u8[] application(const this, u8[] datagram, i32 at) { trap; }
  /** Seal application data into a record. */
  virtual u8[] sealApplication(this, u8[] payload) { trap; }
  /** Whether the handshake finished with a peer that proved it holds its certificate's key. */
  virtual bool peerAuthenticated(const this) { trap; }
  /** The peer's certificate, DER, or empty. */
  virtual u8[] peerCertificate(const this) { trap; }
  /** Whether the handshake has finished — the Finished messages crossed — whoever the peer turned out to be. */
  virtual bool isEstablished(const this) { trap; }
  /**
   * Whatever a clock says to resend. A server's is empty: the client's retransmission is its timer, which is how
   * `Peer` has always worked against OpenSSL and libwebrtc.
   */
  virtual u8[][] timers(this, i64 now) { return u8[][](); }
  /** The first flight, for the end that starts the handshake; nothing for the end that answers. */
  virtual u8[][] begin(this, i64 now) { return u8[][](); }
}

/** ECDHE-ECDSA-AES128-GCM-SHA256, the suite a browser and OpenSSL both offer. */
i32 suite() { return 0xC02B; }
/** ecdsa_secp256r1_sha256. */
i32 scheme() { return 0x0403; }

/** One handshake message being reassembled. */
struct Partial {
  i32 seq;
  i32 kind;
  u8[] body;
  i32 have;
}

export struct Peer : Dtls {
  /** Our certificate, and the P-256 scalar that signs with it. */
  u8[] certDer;
  u8[] signingKey;
  /** The ECDSA nonce. A program supplies a fresh one per handshake; reusing one publishes the key. */
  u8[] signingNonce;
  /** Our ephemeral x25519 scalar and our server random. */
  u8[] scalar;
  u8[] random;
  /**
   * What our HelloVerifyRequest hands out.
   *
   * A real server derives this from the peer's address under a key only it holds, so that it can
   * remember nothing until the cookie comes back. This takes it as a field because that derivation
   * needs an address this file never sees.
   */
  u8[] cookie;

  Partial[] partials;
  i32 partialCount;

  /** Every handshake message so far, re-headed as if none had been fragmented. */
  u8[] transcript;
  u8[] clientRandom;
  bool flightSent;

  u8[] master;
  u8[] clientWriteKey;
  u8[] serverWriteKey;
  u8[] clientIv;
  u8[] serverIv;
  bool keysReady;
  /**
   * The peer's certificate, DER, or empty when it presented none.
   *
   * **Captured, not yet checked.** Comparing its SHA-256 against the `a=fingerprint` line is what
   * makes a peer the peer it claimed to be, and doing that alone would be worse than nothing: a
   * certificate is public, so anyone holding the offer can present the one it names. What proves
   * possession of the key is the CertificateVerify signature, which is not verified yet.
   * `issues/system/0153` steps 2 and 3.
   */
  u8[] peerCertDer;
  /**
   * Whether each of the peer's two new messages has been folded into the transcript already.
   *
   * **A wire message folded into an append-only transcript needs a fold-exactly-once guard**,
   * because DTLS retransmits. The ClientHello has one in `flightSent` and the ClientKeyExchange in
   * `!keysReady`; these two are the same rule for the messages a CertificateRequest brings. Without
   * them a single retransmission appends duplicates and nothing can ever verify again.
   */
  i32 peerCertFolded;
  i32 peerVerifyFolded;
  /**
   * Whether the peer's CertificateVerify signature checked out against its own certificate.
   *
   * **This is the half that makes a fingerprint mean anything.** A certificate is public: anyone
   * holding the offer holds the one its `a=fingerprint` line names and can present it. What cannot
   * be replayed is a signature over *this* handshake, made with the key inside that certificate.
   * Comparing the fingerprint without checking this would authenticate nothing while looking as
   * though it did — the shape of the hole `packages/quic` had over its ServerKeyExchange.
   */
  i32 peerVerified;
  bool established;

  /** The record sequence at epoch 0, and separately at epoch 1. Both continuous. */
  i64 plainSeq;
  i64 cipherSeq;

  /**
   * Our last flight, as **handshake messages** rather than as records.
   *
   * That distinction is the whole of DTLS retransmission. A resent flight carries the *same*
   * `message_seq` — it is the same message, and a peer that has it already must recognise it as a
   * duplicate — but **new record sequence numbers**, because the record layer's counter never
   * repeats and a replay window would drop anything that did. Storing the records and sending them
   * again gets the first half right and the second half exactly wrong, in a way that looks like the
   * network eating the retransmission.
   */
  u8[][] lastFlight;
  /**
   * When the flight last went out, and how many times it has, on a clock the caller supplies.
   *
   * A **flight** is the unit here, where SCTP's is a chunk: DTLS retransmits everything since the
   * peer's last message, because a handshake is a conversation of alternating flights and a peer
   * that is missing any of one is waiting for all of it.
   */
  i64 flightSentAt;
  i32 flightTries;

  Peer of(u8[] certDer, u8[] signingKey, u8[] signingNonce, u8[] scalar, u8[] random, u8[] cookie) {
    return Peer(certDer, signingKey, signingNonce, scalar, random, cookie,
                Partial[].filled(8, Partial(-1, 0, u8[](), 0)), 0,
                u8[](), u8[](), false,
                u8[](), u8[](), u8[](), u8[](), u8[](), false, u8[](), 0, 0, 0, false,
                0 as i64, 0 as i64, u8[][](), 0 as i64, 0);
  }

  /** Our ephemeral public key — the point in the ServerKeyExchange. */
  u8[] publicKey(const this) { return x25519Base(this.scalar); }

  /**
   * Take one fragment, and answer the whole message when it completes.
   *
   * Empty means *not yet* rather than *wrong*: a flight arrives across datagrams and most fragments
   * complete nothing.
   */
  u8[] reassemble(this, i32 kind, i32 seq, i32 offset, i32 fragLen, i32 total, u8[] piece) {
    i32 at = -1;
    for (i32 i = 0; i < this.partialCount; i++) {
      if (this.partials[i].seq == seq) { at = i; }
    }
    if (at < 0) {
      if (this.partialCount >= this.partials.len() || total < 0) { return u8[](); }
      at = this.partialCount;
      this.partials[at] = Partial(seq, kind, u8[].filled(total, 0), 0);
      this.partialCount = at + 1;
    }
    Partial p = this.partials[at];
    if (offset < 0 || offset + fragLen > p.body.len()) { return u8[](); }
    for (i32 i = 0; i < fragLen && i < piece.len(); i++) { p.body[offset + i] = piece[i]; }
    p.have = p.have + fragLen;
    if (p.have < p.body.len()) { return u8[](); }
    return p.body;
  }

  /** Append a message to the transcript, in the unfragmented form the hash is over. */
  void remember(this, i32 kind, i32 seq, u8[] body) {
    u8[] msg = handshake(kind, seq, body);
    u8[] out = u8[].filled(this.transcript.len() + msg.len(), 0);
    out.copyFrom(this.transcript, 0, 0, this.transcript.len());
    for (i32 i = 0; i < msg.len(); i++) { out[this.transcript.len() + i] = msg[i]; }
    this.transcript = out;
  }

  /** The ECDSA signature over `client_random + server_random + ServerECDHParams`, DER encoded. */
  u8[] signParams(const this, u8[] params) {
    u8[] signed = u8[].filled(this.clientRandom.len() + this.random.len() + params.len(), 0);
    i32 at = 0;
    signed.copyFrom(this.clientRandom, 0, at, this.clientRandom.len());
    at = at + this.clientRandom.len();
    signed.copyFrom(this.random, 0, at, this.random.len());
    at = at + this.random.len();
    signed.copyFrom(params, 0, at, params.len());

    u8[] raw = p256Sign(this.signingKey, signed, this.signingNonce);
    if (raw.len() != 64) { return u8[](); }
    u8[] r = u8[].filled(32, 0);
    u8[] s = u8[].filled(32, 0);
    for (i32 i = 0; i < 32; i++) { r[i] = raw[i]; s[i] = raw[32 + i]; }
    u8[] rd = derInteger(r);
    u8[] sd = derInteger(s);
    u8[] both = u8[].filled(rd.len() + sd.len(), 0);
    both.copyFrom(rd, 0, 0, rd.len());
    for (i32 i = 0; i < sd.len(); i++) { both[rd.len() + i] = sd[i]; }
    return derSequence(both);
  }

  /** Seal application data for sending — what a caller hands SCTP's output to. */
  override u8[] sealApplication(this, u8[] payload) { return this.sealed(23, payload); }

  /** Our record at epoch 0, taking the next plaintext sequence number. */
  u8[] plain(this, i32 kind, u8[] fragment) {
    u8[] out = record(kind, versionDtls12(), 0, this.plainSeq, fragment);
    this.plainSeq = this.plainSeq + (1 as i64);
    return out;
  }

  /** Our record at epoch 1, sealed, taking the next protected sequence number. */
  u8[] sealed(this, i32 kind, u8[] plaintext) {
    u8[] frag = seal(this.serverWriteKey, this.serverIv, 1, this.cipherSeq, kind, versionDtls12(),
                     plaintext);
    u8[] out = record(kind, versionDtls12(), 1, this.cipherSeq, frag);
    this.cipherSeq = this.cipherSeq + (1 as i64);
    return out;
  }

  /**
   * Answer one datagram with the datagrams to send.
   *
   * Everything the handshake needs is here, so a caller feeds bytes and sends what comes back — no
   * ordering to get right and no counter to remember, which is the whole point.
   */
  override u8[][] receive(this, u8[] datagram) {
    u8[][] out = u8[][]();
    i32 at = 0;
    while (recordSize(datagram, at) > 0) {
      i32 size = recordSize(datagram, at);
      Record r = parseRecord(datagram, at);
      if (r.ok && r.kind == typeHandshake() && r.epoch == 0) {
        out = this.handshakeRecord(out, r);
      } else if (r.ok && r.kind == typeHandshake() && r.epoch == 1 && this.keysReady &&
                 !this.established) {
        u8[] plainMsg = open(this.clientWriteKey, this.clientIv, r.epoch, r.sequence, r.kind,
                             r.version, r.fragment);
        if (plainMsg.len() >= 12 && plainMsg[0] == 20) {
          // Their Finished. Its verify_data is over everything up to it; ours is over that plus
          // theirs — the asymmetry that makes each end prove it saw the other's whole handshake.
          u8[] want = verifyData(this.master, "client finished", this.transcript);
          bool same = plainMsg.len() >= 24;
          for (i32 i = 0; same && i < 12; i++) {
            if (plainMsg[12 + i] != want[i]) { same = false; }
          }
          // **And the peer has to have proved who it is.** A verify_data that matches says the peer
          // saw the same handshake; it says nothing about *which* peer. The CertificateVerify is
          // what says that, so a handshake is refused here rather than established with someone who
          // never presented a certificate or presented one they cannot sign for.
          if (same && this.peerVerified != 0) {
            u8[] full = u8[].filled(this.transcript.len() + plainMsg.len(), 0);
            full.copyFrom(this.transcript, 0, 0, this.transcript.len());
            for (i32 i = 0; i < plainMsg.len(); i++) { full[this.transcript.len() + i] = plainMsg[i]; }
            // **One past the flight, not the literal 5.** The server's messages are numbered
            // HelloVerifyRequest at 0 and then the flight, so the Finished is `lastFlight.len() + 1`
            // — which is 5 today only because the flight happens to be four messages. A flight that
            // grows by one and a Finished that does not reuses a message_seq the peer has already
            // seen, and a peer discards that as a duplicate: silently, with no alert, retransmitting
            // its own flight for ever. `issues/system/0153` chased that symptom for some time.
            u8[] ours = handshake(20, this.lastFlight.len() + 1,
                                  verifyData(this.master, "server finished", full));
            u8[] ccs = u8[].filled(1, 0);
            ccs[0] = 1;
            out = appendOne(out, this.plain(typeChangeCipherSpec(), ccs));
            out = appendOne(out, this.sealed(typeHandshake(), ours));
            this.established = true;
          }
        }
      }
      at = at + size;
    }
    return out;
  }

  /** One epoch-zero handshake record: reassemble, and answer if it completed something. */
  u8[][] handshakeRecord(this, u8[][] out, Record r) {
    u8[] f = r.fragment;
    if (f.len() < 12) { return out; }
    i32 kind = f[0] as i32;
    i32 total = (f[1] as i32 << 16) | (f[2] as i32 << 8) | f[3] as i32;
    i32 seq = (f[4] as i32 << 8) | f[5] as i32;
    i32 offset = (f[6] as i32 << 16) | (f[7] as i32 << 8) | f[8] as i32;
    i32 fragLen = (f[9] as i32 << 16) | (f[10] as i32 << 8) | f[11] as i32;
    u8[] piece = u8[].filled(f.len() - 12, 0);
    piece.copyFrom(f, 12, 0, piece.len());
    u8[] body = this.reassemble(kind, seq, offset, fragLen, total, piece);
    if (body.len() == 0) { return out; }

    if (kind == 1) {                                          // ClientHello
      if (helloCookie(body).len() == 0) {
        // No cookie: hand one out and remember nothing. The transcript starts at the hello that
        // comes back, which is why nothing is recorded here.
        return appendOne(out, this.plain(typeHandshake(),
                                         handshake(3, 0, helloVerifyRequest(this.cookie))));
      }
      if (this.flightSent) {
        // **A retransmitted hello means our flight did not arrive.** Sending it again is the whole
        // of DTLS's loss recovery for a server: the client's retransmission *is* the timer, so this
        // needs no clock of its own — which suits a language with no ambient capabilities.
        return this.resend(out);
      }
      this.flightSent = true;
      this.clientRandom = helloRandom(body);
      this.remember(1, seq, body);

      u8[] params = serverEcdhParams(curveX25519(), this.publicKey());
      u8[] sh = serverHello(this.random, suite(), helloSrtpProfile(body));
      u8[] cert = certificateMessage(this.certDer);
      u8[] ske = serverKeyExchange(params, scheme(), this.signParams(params));
      // **CertificateRequest, between the key exchange and the done**, where RFC 5246 §7.4.4 puts
      // it. It is what makes the peer send a certificate at all; without it we authenticate nobody.
      u8[] req = certificateRequest();
      u8[] done = serverHelloDone();
      this.remember(2, 1, sh);
      this.remember(11, 2, cert);
      this.remember(12, 3, ske);
      this.remember(13, 4, req);
      this.remember(14, 5, done);
      this.lastFlight = u8[][].defaulted(5);
      this.lastFlight[0] = handshake(2, 1, sh);
      this.lastFlight[1] = handshake(11, 2, cert);
      this.lastFlight[2] = handshake(12, 3, ske);
      this.lastFlight[3] = handshake(13, 4, req);
      this.lastFlight[4] = handshake(14, 5, done);
      return this.resend(out);
    }
    if (kind == 11 && this.peerCertFolded == 0) {             // the peer's Certificate
      this.peerCertFolded = 1;
      this.remember(11, seq, body);
      this.peerCertDer = leafCertificate(body);
      return out;
    }
    if (kind == 15 && this.peerVerifyFolded == 0) {           // the peer's CertificateVerify
      this.peerVerifyFolded = 1;
      // **Checked before it is folded in.** The signature covers every handshake message up to but
      // not including this one, so the transcript has to be read at this instant — one line later
      // and it would cover itself, which nothing could satisfy.
      this.peerVerified = this.verifyPeer(body) ? 1 : 0;
      this.remember(15, seq, body);
      return out;
    }
    if (kind == 11 || kind == 15) { return out; }             // a retransmission; already folded
    if (kind == 16 && !this.keysReady) {                      // ClientKeyExchange
      this.remember(16, seq, body);
      // **A peer's public key has to be thirty-two bytes, and asking was a trap until 2026-08-24.**
      // `clientPublic` hands on whatever length the leading byte names — and returns *empty* when
      // that length overruns the message — while `x25519` traps on anything else. This is the
      // plaintext phase, before any key exists, so the cost to an attacker was a cookie exchange and
      // one more datagram.
      //
      // Declined the way every other unusable message here is declined, with `return out`: a peer
      // that sent this is not one we can finish a handshake with, and there is nothing to say back
      // that it would understand.
      u8[] peerKey = clientPublic(body);
      if (peerKey.len() != 32) { return out; }
      // **And a small-order point makes the premaster secret all zeros for every scalar**, so a peer
      // sending one would hold the session's keys without any private key. RFC 7748 §6; the same rule
      // `packages/tor` and `packages/ssh` carry.
      u8[]? dh = x25519Shared(this.scalar, peerKey);
      if (dh is null) { return out; }
      u8[] pms = dh!;
      this.master = masterSecret(pms, this.clientRandom, this.random);
      u8[] block = keyBlock(this.master, this.random, this.clientRandom, 40);
      this.clientWriteKey = slice(block, 0, 16);
      this.serverWriteKey = slice(block, 16, 32);
      this.clientIv = slice(block, 32, 36);
      this.serverIv = slice(block, 36, 40);
      this.keysReady = true;
    }
    return out;
  }

  /**
   * Wrap the stored flight in fresh records and append it.
   *
   * Public as well as used internally, because a caller with a clock may want to resend before the
   * peer asks — RFC 6347's timer is an initial second, doubling. Nothing here reads a clock; the
   * decision is the caller's, which is the same split `packages/quic`'s `Connection.resend` draws.
   */
  u8[][] resend(this, u8[][] out) {
    for (i32 i = 0; i < this.lastFlight.len(); i++) {
      out = appendOne(out, this.plain(typeHandshake(), this.lastFlight[i]));
    }
    this.flightTries = this.flightTries + 1;
    return out;
  }

  /** Record when the flight went out, which a caller with a clock does as it sends. */
  void sentAt(this, i64 now) { this.flightSentAt = now; }

  /**
   * The flight again, if its timer has expired at `now` — empty otherwise.
   *
   * The same shape as the SCTP association's timers, and the same reason for taking the time as an argument:
   * nothing here reads a clock. RFC 6347's initial timeout is a second, doubling, and a caller that
   * has no clock at all can ignore this entirely — the peer's own retransmission drives a resend
   * through `receive`, which is how this worked before there was a timer and how it still works
   * against OpenSSL and libwebrtc.
   */
  u8[][] due(this, i64 now, i64 rto) {
    if (this.lastFlight.len() == 0 || this.established) { return u8[][](); }
    i64 wait = rto;
    for (i32 i = 1; i < this.flightTries && wait < (60000 as i64); i++) { wait = wait * (2 as i64); }
    if (wait > (60000 as i64)) { wait = 60000 as i64; }
    if (now - this.flightSentAt < wait) { return u8[][](); }
    this.flightSentAt = now;
    return this.resend(u8[][]());
  }

  /** How many messages the last flight held — zero before there is one. */
  i32 flightSize(const this) { return this.lastFlight.len(); }

  /**
   * Whether a CertificateVerify body is a signature by the peer's own certificate over this
   * handshake.
   *
   * The body is `SignatureAndHashAlgorithm algorithm; opaque signature<0..2^16-1>;` — two bytes of
   * scheme, two of length, then the DER signature. `certVerifySignature` refuses a scheme the
   * certificate's key cannot carry, which is what stops an ECDSA signature being checked against
   * whatever bytes an RSA modulus happens to be.
   */
  bool verifyPeer(const this, u8[] body) {
    if (body.len() < 4 || this.peerCertDer.len() == 0) { return false; }
    i32 scheme = (body[0] as i32 << 8) | body[1] as i32;
    i32 sigLen = (body[2] as i32 << 8) | body[3] as i32;
    if (sigLen <= 0 || 4 + sigLen > body.len()) { return false; }
    u8[] sig = u8[].filled(sigLen, 0);
    sig.copyFrom(body, 4, 0, sigLen);
    Cert c = parseCert(this.peerCertDer);
    if (!c.wellFormed) { return false; }
    return certVerifySignature(c, scheme, this.transcript, sig);
  }

  /** Whether the peer proved possession of the key in the certificate it presented. */
  override bool peerAuthenticated(const this) { return this.peerVerified != 0; }

  override bool isEstablished(const this) { return this.established; }

  /** The peer's certificate as presented, or empty when it sent none. */
  override u8[] peerCertificate(const this) { return this.peerCertDer; }

  /** Open an application record, or empty — what a caller hands to SCTP. */
  override u8[] application(const this, u8[] datagram, i32 at) {
    if (!this.keysReady) { return u8[](); }
    Record r = parseRecord(datagram, at);
    if (!r.ok || r.epoch != 1) { return u8[](); }
    return open(this.clientWriteKey, this.clientIv, r.epoch, r.sequence, r.kind, r.version,
                r.fragment);
  }
}

/** Grow a list of datagrams by one. */
export u8[][] appendOne(u8[][] list, u8[] one) {
  u8[][] out = u8[][].defaulted(list.len() + 1);
  out.copyFrom(list, 0, 0, list.len());
  out[list.len()] = one;
  return out;
}

/** `b[from..to)`. */
export u8[] slice(u8[] b, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0);
  out.copyFrom(b, from, 0, out.len());
  return out;
}

// ─────────────────────────────────────────────────────────────────────────────────────── the client role ───
//
// A DTLS peer in the client role: the half `Peer`, above, leaves out.
//
// The server answers; this starts. It sends a ClientHello, echoes the cookie a HelloVerifyRequest hands it, reads
// the server's flight — ServerHello, Certificate, ServerKeyExchange, an optional CertificateRequest, ServerHelloDone
// — and answers with its own: Certificate if it was asked, ClientKeyExchange, CertificateVerify if it sent a
// certificate, ChangeCipherSpec, Finished. The server's ChangeCipherSpec and Finished end it.
//
// ## What it checks, and what it leaves to its caller
//
// **The ServerKeyExchange's signature, under the server's own certificate.** That is what binds the ephemeral key
// to the certificate: without it anybody on the path substitutes their own point and reads everything. The server's
// Finished is checked too, so the server saw the same handshake. **Whose certificate it was is the caller's
// question** — `peerCertificate` answers the DER, and `Session` compares its hash with the fingerprint it was told
// to expect, exactly as it does for a server.
//
// ## What it offers
//
// One suite (ECDHE-ECDSA-AES128-GCM-SHA256), two groups (x25519, and secp256r1 for libdatachannel, whose OpenSSL is
// configured for nothing else), one signature scheme (ecdsa_secp256r1_sha256) — what every WebRTC stack accepts. And `use_srtp`, though no SRTP will flow: pion refuses a
// DTLS transport that negotiated no SRTP profile, data channels or not, so a client that wants to reach a pion
// server has to offer one.
//
// ## Loss
//
// A flight is resent when its timer runs out (`timers`, RFC 6347's second, doubling) and when the server repeats a
// message of a flight already answered — its retransmission says ours was lost.
//
// (Here rather than in a file of its own because its base, `Dtls`, is declared in this one.)

static i32 SUITE = 0xC02B;
static i32 SCHEME = 0x0403;

/**
 * A ClientHello body: DTLS 1.2, one suite, x25519 and secp256r1, ECDSA with SHA-256, and `use_srtp` with the two profiles WebRTC
 * stacks select from (SRTP_AEAD_AES_128_GCM and SRTP_AES128_CM_HMAC_SHA1_80).
 *
 * The same `random` goes in both hellos — the one before the cookie and the one after — since a server may compare
 * them.
 */
export u8[] clientHelloOffer(u8[] random, u8[] cookie) {
  u8[] ext = [
    0x00, 0x0A, 0x00, 0x06, 0x00, 0x04, 0x00, 0x1D, 0x00, 0x17,             // supported_groups: x25519, secp256r1
    0x00, 0x0B, 0x00, 0x02, 0x01, 0x00,                                     // ec_point_formats: uncompressed
    0x00, 0x0D, 0x00, 0x04, 0x00, 0x02, 0x04, 0x03,                         // signature_algorithms: ecdsa_p256_sha256
    0x00, 0x0E, 0x00, 0x07, 0x00, 0x04, 0x00, 0x07, 0x00, 0x01, 0x00,       // use_srtp: two profiles, no MKI
    0xFF, 0x01, 0x00, 0x01, 0x00,                                           // renegotiation_info: empty
  ];
  i32 n = 2 + 32 + 1 + 1 + cookie.len() + 2 + 2 + 2 + 2 + ext.len();
  u8[] out = u8[].filled(n, 0);
  i32 at = 0;
  out[0] = 0xFE; out[1] = 0xFD; at = 2;
  for (i32 i = 0; i < 32; i++) { out[at + i] = i < random.len() ? random[i] : 0; }
  at += 32;
  out[at] = 0; at += 1;                                                     // session_id: empty
  out[at] = cookie.len() as@ u8; at += 1;
  out.copyFrom(cookie, 0, at, cookie.len());
  at += cookie.len();
  out[at] = 0x00; out[at + 1] = 0x02; at += 2;
  out[at] = ((SUITE >> 8) & 0xFF) as@ u8; out[at + 1] = (SUITE & 0xFF) as@ u8; at += 2;
  out[at] = 0x01; out[at + 1] = 0x00; at += 2;                              // compression: null
  out[at] = ((ext.len() >> 8) & 0xFF) as@ u8; out[at + 1] = (ext.len() & 0xFF) as@ u8; at += 2;
  out.copyFrom(ext, 0, at, ext.len());
  return out;
}

/** A server message, whole, waiting for its turn. */
struct Arrived {
  i32 seq;
  i32 kind;
  u8[] body;
  /** Which bytes of `body` have arrived, and how many: a repeated fragment adds nothing. */
  bool[] got;
  i32 have;
}

export struct ClientPeer : Dtls {
  u8[] certDer;
  u8[] signingKey;
  /** The ECDSA nonce for the CertificateVerify. Fresh per handshake: reusing one publishes the key. */
  u8[] signingNonce;
  /** Our ephemeral x25519 scalar, and our random. */
  u8[] scalar;
  u8[] random;

  u8[] cookie = u8[]();
  /** The ClientHello the transcript starts with — the last one sent. */
  u8[] hello = u8[]();
  i32 helloSeq = 0;
  u8[] transcript = u8[]();
  /** The server's messages by sequence, as they complete; processed strictly in order. */
  Vec<Arrived> arrived = Vec<Arrived>.create();
  i32 nextServerSeq = 0;
  /** Our next handshake message_seq. */
  i32 ourSeq = 0;

  u8[] serverRandom = u8[]();
  i32 suite = -1;
  u8[] serverCertDer = u8[]();
  u8[] serverKeyExchange = u8[]();
  bool certificateRequested = false;
  bool serverSigned = false;

  u8[] master = u8[]();
  u8[] clientWriteKey = u8[]();
  u8[] serverWriteKey = u8[]();
  u8[] clientIv = u8[]();
  u8[] serverIv = u8[]();
  bool keysReady = false;
  bool established = false;
  /** Why the handshake cannot finish, or "" while it can. */
  string failed = "";

  i64 plainSeq = 0 as i64;
  i64 cipherSeq = 0 as i64;
  /** Our last flight as handshake messages; those from `sealedFrom` on go after a ChangeCipherSpec, at epoch 1. */
  u8[][] lastFlight = u8[][]();
  i32 sealedFrom = -1;
  i64 flightSentAt = 0 as i64;
  i32 flightTries = 0;

  ClientPeer of(u8[] certDer, u8[] signingKey, u8[] signingNonce, u8[] scalar, u8[] random) {
    return ClientPeer { certDer: certDer, signingKey: signingKey, signingNonce: signingNonce, scalar: scalar,
                        random: random };
  }

  /** The first flight: a ClientHello with no cookie. `now` starts its timer. */
  override u8[][] begin(this, i64 now) {
    this.sendHello();
    this.flightSentAt = now;
    return this.resend(u8[][]());
  }

  void sendHello(this) {
    this.hello = clientHelloOffer(this.random, this.cookie);
    this.helloSeq = this.ourSeq;
    this.ourSeq += 1;
    this.lastFlight = [handshake(1, this.helloSeq, this.hello)];
    this.sealedFrom = -1;
    this.flightTries = 0;
  }

  // ─────────────────────────────────────────────────────────────────────────────────────────── records ───

  u8[] plain(this, i32 kind, u8[] fragment) {
    u8[] out = record(kind, versionDtls12(), 0, this.plainSeq, fragment);
    this.plainSeq += 1 as i64;
    return out;
  }

  u8[] sealed(this, i32 kind, u8[] plaintext) {
    u8[] frag = seal(this.clientWriteKey, this.clientIv, 1, this.cipherSeq, kind, versionDtls12(), plaintext);
    u8[] out = record(kind, versionDtls12(), 1, this.cipherSeq, frag);
    this.cipherSeq += 1 as i64;
    return out;
  }

  override u8[] sealApplication(this, u8[] payload) { return this.sealed(23, payload); }

  override u8[] application(const this, u8[] datagram, i32 at) {
    if (!this.established) { return u8[](); }
    Record r = parseRecord(datagram, at);
    if (!r.ok || r.epoch != 1 || r.kind != 23) { return u8[](); }
    return open(this.serverWriteKey, this.serverIv, r.epoch, r.sequence, r.kind, r.version, r.fragment);
  }

  override bool peerAuthenticated(const this) { return this.established && this.serverSigned; }
  override u8[] peerCertificate(const this) { return this.serverCertDer; }
  override bool isEstablished(const this) { return this.established; }

  /** Our flight again, in fresh records. */
  u8[][] resend(this, u8[][] out) {
    for (i32 i = 0; i < this.lastFlight.len(); i++) {
      if (i == this.sealedFrom) { out = appendOne(out, this.plain(typeChangeCipherSpec(), [1 as@ u8])); }
      out = appendOne(out, i >= this.sealedFrom && this.sealedFrom >= 0
                             ? this.sealed(typeHandshake(), this.lastFlight[i])
                             : this.plain(typeHandshake(), this.lastFlight[i]));
    }
    this.flightTries += 1;
    return out;
  }

  /** The flight again if its timer ran out: a second, doubling, to a minute. */
  override u8[][] timers(this, i64 now) {
    if (this.established || this.lastFlight.len() == 0 || this.failed != "") { return u8[][](); }
    i64 wait = 1000 as i64;
    for (i32 i = 1; i < this.flightTries && wait < 60000 as i64; i++) { wait = wait * (2 as i64); }
    if (wait > 60000 as i64) { wait = 60000 as i64; }
    if (now - this.flightSentAt < wait) { return u8[][](); }
    this.flightSentAt = now;
    return this.resend(u8[][]());
  }

  // ───────────────────────────────────────────────────────────────────────────────────────── receiving ───

  override u8[][] receive(this, u8[] datagram) {
    u8[][] out = u8[][]();
    i32 at = 0;
    while (recordSize(datagram, at) > 0) {
      i32 size = recordSize(datagram, at);
      Record r = parseRecord(datagram, at);
      at += size;
      if (!r.ok || this.failed != "") { continue; }
      if (r.kind == typeHandshake() && r.epoch == 0) {
        out = this.fragment(out, r.fragment);
      } else if (r.kind == typeHandshake() && r.epoch == 1 && this.keysReady && !this.established) {
        u8[] m = open(this.serverWriteKey, this.serverIv, r.epoch, r.sequence, r.kind, r.version, r.fragment);
        if (m.len() == 12 + 12 && m[0] == 20) {
          // The server's Finished: over everything up to it, our Finished included.
          u8[] want = verifyData(this.master, "server finished", this.transcript);
          bool same = true;
          for (i32 i = 0; i < 12; i++) { if (m[12 + i] != want[i]) { same = false; } }
          if (same && this.serverSigned) { this.established = true; }
          else if (!same) { this.failed = "the server's Finished does not match the handshake"; }
        }
      }
    }
    return out;
  }

  /** One epoch-0 handshake fragment: reassemble, then process whatever is now next in order. */
  u8[][] fragment(this, u8[][] out, u8[] f) {
    if (f.len() < 12) { return out; }
    i32 kind = f[0] as i32;
    i32 total = (f[1] as i32 << 16) | (f[2] as i32 << 8) | f[3] as i32;
    i32 seq = (f[4] as i32 << 8) | f[5] as i32;
    i32 offset = (f[6] as i32 << 16) | (f[7] as i32 << 8) | f[8] as i32;
    i32 fragLen = (f[9] as i32 << 16) | (f[10] as i32 << 8) | f[11] as i32;
    if (seq < this.nextServerSeq) {
      // **A message we have already taken, again: the server did not get our answer to it.** Once per flight of
      // theirs is enough — answering every repeated fragment would multiply our flight by theirs.
      if (this.lastFlight.len() > 0 && this.sealedFrom >= 0 && kind == 14) { return this.resend(out); }
      return out;
    }
    if (seq > this.nextServerSeq + 8 || offset < 0 || fragLen < 0 || offset + fragLen > total ||
        12 + fragLen > f.len()) { return out; }
    Arrived? a = null;
    for (i32 i = 0; i < this.arrived.len(); i++) { if (this.arrived.get(i).seq == seq) { a = this.arrived.get(i); } }
    if (a is null) {
      a = Arrived(seq, kind, u8[].filled(total, 0), bool[].filled(total, false), 0);
      this.arrived.push(a!);
    }
    if (a!.body.len() != total) { return out; }
    a!.body.copyFrom(f, 12, offset, fragLen);
    for (i32 i = offset; i < offset + fragLen; i++) {
      if (!a!.got[i]) {
        a!.got[i] = true;
        a!.have = a!.have + 1;
      }
    }
    while (true) {
      Arrived? next = null;
      for (i32 i = 0; i < this.arrived.len(); i++) {
        Arrived c = this.arrived.get(i);
        if (c.seq == this.nextServerSeq && c.have >= c.body.len()) { next = c; }
      }
      if (next is null) { break; }
      this.nextServerSeq += 1;
      out = this.message(out, next!.kind, next!.seq, next!.body);
      if (this.failed != "") { break; }
    }
    return out;
  }

  void remember(this, i32 kind, i32 seq, u8[] body) {
    u8[] msg = handshake(kind, seq, body);
    u8[] t = u8[].filled(this.transcript.len() + msg.len(), 0);
    t.copyFrom(this.transcript, 0, 0, this.transcript.len());
    t.copyFrom(msg, 0, this.transcript.len(), msg.len());
    this.transcript = t;
  }

  /** One whole server message, in order. */
  u8[][] message(this, u8[][] out, i32 kind, i32 seq, u8[] body) {
    if (kind == 3) {                                           // HelloVerifyRequest: the hello again, with the cookie
      this.cookie = verifyCookie(body);
      this.sendHello();
      return this.resend(out);
    }
    if (kind == 2) {                                           // ServerHello
      if (body.len() < 34) { this.failed = "a ServerHello too short to read"; return out; }
      this.suite = chosenSuite(body);
      if (this.suite != SUITE) { this.failed = "the server chose suite \{this.suite}, which was not offered"; return out; }
      this.serverRandom = slice(body, 2, 34);
      this.transcript = u8[]();
      this.remember(1, this.helloSeq, this.hello);
      this.remember(2, seq, body);
      return out;
    }
    if (this.serverRandom.len() == 0) { return out; }          // nothing counts before the ServerHello
    if (kind == 11) {
      this.serverCertDer = leafCertificate(body);
      this.remember(11, seq, body);
      return out;
    }
    if (kind == 12) {
      this.serverKeyExchange = body;
      this.remember(12, seq, body);
      return out;
    }
    if (kind == 13) {
      this.certificateRequested = true;
      this.remember(13, seq, body);
      return out;
    }
    if (kind == 14) {
      this.remember(14, seq, body);
      return this.answer(out);
    }
    return out;
  }

  /** The server's flight is in: check it, derive the keys, and send ours. */
  u8[][] answer(this, u8[][] out) {
    if (this.serverCertDer.len() == 0) { this.failed = "the server presented no certificate"; return out; }
    Cert leaf = parseCert(this.serverCertDer);
    if (!leaf.wellFormed) { this.failed = "the server's certificate does not parse"; return out; }
    u8[] ske = this.serverKeyExchange;
    i32 curve = serverCurve(ske);
    if (curve != curveX25519() && curve != curveSecp256r1()) {
      this.failed = "the server chose a group that was not offered";
      return out;
    }
    u8[] signedBytes = serverKeyExchangeSigned(this.random, this.serverRandom, ske);
    if (signedBytes.len() == 0 ||
        !certVerifySignature(leaf, serverKeyExchangeScheme(ske), signedBytes, serverKeyExchangeSignature(ske))) {
      this.failed = "the ServerKeyExchange is not signed by the server's certificate";
      return out;
    }
    this.serverSigned = true;
    u8[] theirs = serverPublic(ske);
    u8[] pms = u8[]();
    u8[] ours = u8[]();
    if (curve == curveX25519()) {
      if (theirs.len() != 32) { this.failed = "the server's key share is not an x25519 point"; return out; }
      u8[]? dh = x25519Shared(this.scalar, theirs);
      if (dh is null) { this.failed = "the server's key share is a small-order point"; return out; }
      pms = dh!;
      ours = x25519Base(this.scalar);
    } else {
      // **P-256, which libdatachannel's OpenSSL insists on.** The point is checked before it is used: the ECDH
      // traps on one off the curve, and a server's bytes are not ours to trap on.
      if (theirs.len() != 65 || !p256Decodes(theirs)) { this.failed = "the server's key share is not a P-256 point"; return out; }
      pms = p256Ecdh(this.scalar, theirs);
      ours = p256PublicKey(this.scalar);
    }
    this.master = masterSecret(pms, this.random, this.serverRandom);
    u8[] block = keyBlock(this.master, this.serverRandom, this.random, 40);
    this.clientWriteKey = slice(block, 0, 16);
    this.serverWriteKey = slice(block, 16, 32);
    this.clientIv = slice(block, 32, 36);
    this.serverIv = slice(block, 36, 40);
    this.keysReady = true;

    u8[][] flight = u8[][]();
    if (this.certificateRequested) {
      u8[] cert = certificateMessage(this.certDer);
      flight = appendOne(flight, handshake(11, this.ourSeq, cert));
      this.remember(11, this.ourSeq, cert);
      this.ourSeq += 1;
    }
    u8[] cke = clientKeyExchange(ours);
    flight = appendOne(flight, handshake(16, this.ourSeq, cke));
    this.remember(16, this.ourSeq, cke);
    this.ourSeq += 1;
    if (this.certificateRequested) {
      // **Signed over the transcript so far** — every message up to and including the ClientKeyExchange.
      u8[] sig = derSignature(p256Sign(this.signingKey, this.transcript, this.signingNonce));
      if (sig.len() == 0) { this.failed = "the certificate's key could not sign"; return out; }
      u8[] cv = u8[].filled(4 + sig.len(), 0);
      cv[0] = ((SCHEME >> 8) & 0xFF) as@ u8; cv[1] = (SCHEME & 0xFF) as@ u8;
      cv[2] = ((sig.len() >> 8) & 0xFF) as@ u8; cv[3] = (sig.len() & 0xFF) as@ u8;
      cv.copyFrom(sig, 0, 4, sig.len());
      flight = appendOne(flight, handshake(15, this.ourSeq, cv));
      this.remember(15, this.ourSeq, cv);
      this.ourSeq += 1;
    }
    u8[] fin = verifyData(this.master, "client finished", this.transcript);
    this.sealedFrom = flight.len();
    flight = appendOne(flight, handshake(20, this.ourSeq, fin));
    this.remember(20, this.ourSeq, fin);
    this.ourSeq += 1;
    this.lastFlight = flight;
    this.flightTries = 0;
    return this.resend(out);
  }
}

/** A raw sixty-four-byte P-256 signature as TLS carries it: `SEQUENCE { INTEGER r, INTEGER s }`. */
u8[] derSignature(u8[] raw) {
  if (raw.len() != 64) { return u8[](); }
  u8[] rd = derInteger(slice(raw, 0, 32));
  u8[] sd = derInteger(slice(raw, 32, 64));
  u8[] both = u8[].filled(rd.len() + sd.len(), 0);
  both.copyFrom(rd, 0, 0, rd.len());
  both.copyFrom(sd, 0, rd.len(), sd.len());
  return derSequence(both);
}
