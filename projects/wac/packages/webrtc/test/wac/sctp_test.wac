// SCTP framing and association, against aiortc's own parser and against CRC-32c's published vector.
//
// `design/system/0008` step 4: the common header, chunks, the checksum, the INIT/COOKIE-ECHO shapes
// an association handshake is made of, and then the association itself — reassembly, gap reporting,
// fast retransmission and the shutdown exchange.
//
// The two oracles and what each can see are in `../sctp_oracle.py`. The short version: a checksum is
// a *value*, so `google_crc32c` settles it outright; but only a foreign *parser* can say the field
// is in the right place, covering the right bytes, written little-endian while everything around it
// is network order.
//
// The association tests have no external oracle and do not want one. What they assert is behaviour
// under conditions a peer produces and a round trip cannot: chunks reordered on the path, TSNs that
// are negative as an `i32` — which is half of them, since a TSN is unsigned and chosen at random —
// and an acknowledgement that crosses 2^31. Each of those is a case where our encoder and our
// decoder would agree with each other and with nobody's reality.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// The move is one process instead of twelve. Every `python3 -c` became a line in one batch, which is
// what `Cli.exec` costs a process for. `test/wac/sctp_probe.wac` stays — `timers_test.wac` and
// `browser.test.ts` both import it — and this file uses its packet builders rather than repeating
// them, while reaching `Association`'s fields and methods directly instead of through the flattened
// accessors bindgen needed.

import { T } from "../../../wactest/src/assert.wac";
import { Procs, Sys } from "std";
import { Lines, check, hex } from "../../../wactest/src/oracle.wac";
import { encode as hexEncode } from "../../../codec/src/hex.wac";
import { chunkAbort, chunkSack, chunkShutdownAck, chunkData, dataFlagBegin, dataFlagEnd, dataPayload,
         dataPpid, dataStreamId, dataStreamSeq, dataTsn, ppidDcep, ppidString, ppidStringEmpty, sackCumulative,
         sackGapEnd, sackGaps, sackGapStart, tsnBefore } from "../../src/sctp.wac";
import { Association, SctpEvent } from "../../src/association.wac";
import { abortPacket, ackChannelPacket, chunkKindAt, chunkKinds, cookieEchoPacket, crcOf,
         crcVerifies, dataPacket, dataPacketFlags, firstChunkKind, firstChunkSize, firstChunkValue, initPacket,
         labelOf, openChannelPacket, sackPacket, sackPacketGaps, shutdownPacket, tagOf, answering,
         firstOfKind, lastOfKind, dataTsns, PEER_TAG } from "./sctp_probe.wac";

static string ORACLE = "packages/webrtc/test/sctp_oracle.py";

string hexOf(u8[] b) { return string.fromBytes(hexEncode(b)); }

/** An `i32` as eight hex digits — see the oracle's header on why numbers cross unsigned. */
string h32(i32 v) {
  string digits = "0123456789abcdef";
  string out = "";
  for (i32 shift = 28; shift >= 0; shift = shift - 4) {
    i32 nibble = (v >>> shift) & 15;
    out = out + digits.slice(nibble, nibble + 1);
  }
  return out;
}

void ask(T t, Procs procs, Lines lines, string what) {
  check(t, procs, "python3", [ORACLE], lines, what);
}

export string test_crc32c_is_castagnolis_not_the_one_packages_gzip_has(Sys sys) {
  Procs procs = sys.procs();
  // The check vector every CRC-32c implementation prints, and the reason it is worth stating: the
  // two polynomials agree on nothing, so an implementation that reached for the CRC already in this
  // repository would be wrong on the very first packet — which is the good kind of wrong.
  T t = T.create();
  t.eqStr(h32(crcOf(("123456789").toBytes())), "e3069283", "crc32c(\"123456789\")");
  t.eqStr(h32(crcOf(u8[]())), "00000000", "and the empty input is zero");

  // Against the library aiortc itself uses, over inputs long enough to exercise the loop.
  string[] inputs = ["", "a", "hello world", repeated("x", 300)];
  Lines lines = Lines.create();
  for (i32 i = 0; i < inputs.len(); i++) {
    lines.add("crc32c \{hex(inputs[i].toBytes())} \{h32(crcOf(inputs[i].toBytes()))}");
  }
  ask(t, procs, lines, "google-crc32c");
  return t.report();
}

export string test_aiortc_parses_our_init_checksum_and_all(Sys sys) {
  Procs procs = sys.procs();
  T t = T.create();
  u8[] packet = initPacket(0x12345678, 65536, 16, 16, 1);
  t.isTrue(crcVerifies(packet), "our own check agrees first");
  t.eqI32(tagOf(packet), 0, "an INIT carries verification tag zero — there is no peer yet");
  t.eqI32(firstChunkKind(packet), 1, "chunk type 1 is INIT");

  // **`parse_packet` verifies the checksum before anything else** and raises when it disagrees, so
  // getting a chunk back at all is the assertion. It is also what checks the little-endian
  // placement, which the CRC vector cannot see. 5000 is the port WebRTC fixes and ignores.
  Lines lines = Lines.create();
  lines.add("initchunk \{hexOf(packet)} 5000 5000 \{h32(0)} \{h32(0x12345678)}" +
            " 65536 16 16 \{h32(1)}");
  ask(t, procs, lines, "aiortc's INIT");
  return t.report();
}

export string test_and_refuses_one_whose_checksum_we_corrupt(Sys sys) {
  Procs procs = sys.procs();
  // The canary. `parse_packet` succeeding above proves something only if it can fail — and a parser
  // that ignored the checksum would accept both of these.
  T t = T.create();
  u8[] packet = initPacket(1, 65536, 16, 16, 1);
  Lines lines = Lines.create();

  u8[] badCrc = copyOf(packet);
  badCrc[8] = badCrc[8] ^ 1;
  t.isFalse(crcVerifies(badCrc), "we refuse it too");
  lines.add("refused \{hexOf(badCrc)}");

  // **And a big-endian checksum**, which is the mistake worth pinning: every other field in SCTP is
  // network order and this one is not, so writing it the obvious way produces a packet that verifies
  // against your own code and against nobody else's.
  u8[] swapped = copyOf(packet);
  swapped[8] = packet[11];
  swapped[9] = packet[10];
  swapped[10] = packet[9];
  swapped[11] = packet[8];
  if (hexOf(swapped) != hexOf(packet)) {       // a palindromic checksum would make this vacuous
    t.isFalse(crcVerifies(swapped), "the bytes reversed is not the same checksum");
    lines.add("refused \{hexOf(swapped)}");
  }
  ask(t, procs, lines, "aiortc refusing a corrupt checksum");
  return t.report();
}

export string test_a_cookie_echo_carries_the_peers_tag_and_the_cookie_unchanged(Sys sys) {
  Procs procs = sys.procs();
  T t = T.create();
  u8[] cookie = u8[].filled(37, 0);
  for (i32 i = 0; i < 37; i++) { cookie[i] = ((i * 3 + 1) & 255) as@ u8; }
  u8[] packet = cookieEchoPacket(0xDEADBEEF, cookie);
  t.isTrue(crcVerifies(packet), "our own check agrees first");
  t.eqStr(h32(tagOf(packet)), "deadbeef",
          "everything after the INIT carries the tag the peer chose, which is how a stale packet " +
          "from a previous association is told from a live one");
  // Thirty-seven bytes of cookie means three of padding, and the padding is in the packet but not
  // in the chunk's length — the same rule STUN has and the same place to get it wrong.
  t.eqI32(firstChunkSize(packet), 44, "4 + 37 rounded up to 44");
  t.eqStr(hexOf(firstChunkValue(packet)), hexOf(cookie),
          "the value read back is the cookie without the padding");

  Lines lines = Lines.create();
  lines.add("cookie \{hexOf(packet)} \{hexOf(cookie)}");
  ask(t, procs, lines, "aiortc's COOKIE-ECHO");
  return t.report();
}

export string test_a_chunk_length_under_four_is_refused_rather_than_walked() {
  // Without this a zero length is a step of zero and the walk never ends — the classic way a packet
  // parser hangs on input somebody else chose, and worth a case because the loop looks obviously
  // terminating until it is not.
  T t = T.create();
  u8[] packet = initPacket(1, 65536, 16, 16, 1);

  u8[] zeroed = copyOf(packet);
  zeroed[14] = 0;
  zeroed[15] = 0;
  t.eqI32(firstChunkSize(zeroed), -1, "a length of zero is not a chunk");

  u8[] short = copyOf(packet);
  short[14] = 0;
  short[15] = 3;
  t.eqI32(firstChunkSize(short), -1, "nor is three");

  u8[] past = copyOf(packet);
  past[14] = 0xFF;
  t.eqI32(firstChunkSize(past), -1, "nor a length past the end of the packet");

  t.eqI32(chunkKinds(zeroed).len(), 0, "so the walk finds nothing and terminates");
  t.eqI32(chunkKinds(packet).len(), 1, "and the good packet still walks");
  t.eqI32(chunkKinds(packet)[0], 1, "to one INIT");
  return t.report();
}

export string test_aiortc_reads_our_data_chunk_field_for_field(Sys sys) {
  Procs procs = sys.procs();
  T t = T.create();
  u8[] payload = ("hello from wac").toBytes();
  u8[] packet = dataPacket(0x11223344, 7, 3, 5, ppidString(), payload);
  t.isTrue(crcVerifies(packet), "our own check agrees first");

  u8[] value = firstChunkValue(packet);
  t.eqI32(dataTsn(value), 7, "tsn");
  t.eqI32(dataStreamId(value), 3, "stream id");
  t.eqI32(dataStreamSeq(value), 5, "stream sequence");
  t.eqI32(dataPpid(value), 51, "PPID 51 is a UTF-8 string");
  t.eqStr(string.fromBytes(dataPayload(value)), "hello from wac", "payload");

  // Flags 3 is begin and end together: a whole message in one chunk.
  Lines lines = Lines.create();
  lines.add("datachunk \{hexOf(packet)} \{h32(7)} 3 5 51 3 \{hexOf(payload)}");
  ask(t, procs, lines, "aiortc's DATA");
  return t.report();
}

export string test_and_our_sack_which_is_a_cumulative_point_and_not_a_list(Sys sys) {
  Procs procs = sys.procs();
  T t = T.create();
  u8[] packet = sackPacket(0x55667788, 42, 65536);
  t.eqI32(sackCumulative(firstChunkValue(packet)), 42, "the cumulative point");

  // No gaps and no duplicates — which is correct and slow, because a receiver that never reports a
  // gap makes the sender resend what it could have been told arrived.
  Lines lines = Lines.create();
  lines.add("sackchunk \{hexOf(packet)} \{h32(42)} 65536 0 0");
  ask(t, procs, lines, "aiortc's SACK");
  return t.report();
}

export string test_a_data_channel_is_opened_by_a_dcep_message_inside_a_data_chunk(Sys sys) {
  Procs procs = sys.procs();
  // RFC 8832. A data channel has no identifier beyond the SCTP stream it runs on, which is why
  // opening one is a *message* on that stream rather than a negotiation.
  T t = T.create();
  u8[] packet = openChannelPacket(1, 1, 0, "chat", "");
  u8[] value = firstChunkValue(packet);
  t.eqI32(dataPpid(value), 50, "PPID 50 is DCEP, which is how a peer knows it is control");
  t.eqStr(labelOf(dataPayload(value)), "chat", "the label we wrote");

  // Message type 3 is DATA_CHANNEL_OPEN and channel type 0 is reliable and ordered.
  Lines lines = Lines.create();
  lines.add("dcep \{hexOf(packet)} 50 3 0 chat");
  ask(t, procs, lines, "aiortc's DCEP");

  // And the ACK, which is one byte.
  u8[] ackValue = firstChunkValue(ackChannelPacket(1, 2, 0));
  t.eqI32(dataPayload(ackValue).len(), 1, "the ACK is one byte");
  t.eqI32(dataPayload(ackValue)[0] as i32, 0x02, "DATA_CHANNEL_ACK");
  return t.report();
}

export string test_an_empty_string_has_its_own_protocol_identifier() {
  // The detail that is invisible until a peer sends `""`: a DATA chunk with no user data is a
  // protocol error, so an empty string goes as one padding byte under PPID 56 and the receiver
  // discards the byte. An implementation that sent a zero-length chunk instead would be refused by
  // the peer for a reason that says nothing about empty strings.
  T t = T.create();
  t.eqI32(ppidStringEmpty(), 56, "an empty string");
  t.eqI32(ppidString(), 51, "a string");
  t.eqI32(ppidDcep(), 50, "DCEP");
  return t.report();
}

// ── The association's receiving and sending rules, each a bug this package once had ──────────────
//
// These drove the one-stream association's internals until 2026-11-08. They drive `association.wac` through
// packets now — a peer's DATA in, the SACK it answers with read back out — which is what the peer sees, and every
// story below is a way that once went wrong.

static i32 OUR = 0x11111111;

/** The whole messages the association has handed up, as text. */
string delivered(Association a) {
  string out = "";
  SctpEvent[] es = a.events();
  for (i32 i = 0; i < es.len(); i++) {
    match (es[i]) {
      Message(stream, ppid, data): { out += (out.len() == 0 ? "" : "|") + string.fromBytes(data); }
      default: { }
    }
  }
  return out;
}

export string test_a_message_reassembles_when_its_chunks_are_reordered_on_the_path() {
  // **Reordering is not loss.** UDP may deliver 1, 3, 2, 4 with nothing dropped at all, and a reassembler that
  // concatenates in arrival order turns that into a message whose every piece is intact and in the wrong order.
  T t = T.create();
  Association a = answering(OUR, 1, 1);
  i32 B = dataFlagBegin();
  i32 E = dataFlagEnd();
  a.receive(dataPacketFlags(OUR, 1, 0, 0, ppidString(), B, "AAA".toBytes()), 1 as i64);
  a.receive(dataPacketFlags(OUR, 3, 0, 0, ppidString(), 0, "CCC".toBytes()), 1 as i64);
  a.receive(dataPacketFlags(OUR, 2, 0, 0, ppidString(), 0, "BBB".toBytes()), 1 as i64);
  t.eqStr(delivered(a), "", "no end yet, so nothing is handed up");
  a.receive(dataPacketFlags(OUR, 4, 0, 0, ppidString(), E, "DDD".toBytes()), 1 as i64);
  t.eqStr(delivered(a), "AAABBBCCCDDD", "the pieces joined in TSN order, not arrival order");
  return t.report();
}

export string test_and_it_reassembles_when_the_tsns_are_negative_as_an_i32() {
  // **A TSN is unsigned 32-bit and chosen at random**, so held in an `i32` it is negative about half the time. A
  // `-1` sentinel for "no message in progress" was once also a TSN Chromium really sent, and it presented as the
  // browser's message never arriving.
  T t = T.create();
  i32 base = -102851347;                       // an actual initial TSN from a Chromium run
  Association a = answering(OUR, 1, base);
  i32 B = dataFlagBegin();
  i32 E = dataFlagEnd();
  a.receive(dataPacketFlags(OUR, base, 0, 0, ppidString(), B | E, "hi".toBytes()), 1 as i64);
  t.eqStr(delivered(a), "hi", "a whole message in one chunk, at a negative TSN");
  a.receive(dataPacketFlags(OUR, base + 1, 0, 1, ppidString(), B, "AA".toBytes()), 1 as i64);
  a.receive(dataPacketFlags(OUR, base + 3, 0, 1, ppidString(), 0, "CC".toBytes()), 1 as i64);
  a.receive(dataPacketFlags(OUR, base + 2, 0, 1, ppidString(), 0, "BB".toBytes()), 1 as i64);
  a.receive(dataPacketFlags(OUR, base + 4, 0, 1, ppidString(), E, "DD".toBytes()), 1 as i64);
  t.eqStr(delivered(a), "AABBCCDD", "the whole message");
  return t.report();
}

export string test_a_duplicate_of_a_piece_already_consumed_is_ignored() {
  // The peer resends what our SACK did not cover, so a piece we already joined on comes back. It must neither be
  // held for ever nor joined twice.
  T t = T.create();
  Association a = answering(OUR, 1, 10);
  a.receive(dataPacketFlags(OUR, 10, 0, 0, ppidString(), dataFlagBegin(), "AA".toBytes()), 1 as i64);
  a.receive(dataPacketFlags(OUR, 11, 0, 0, ppidString(), 0, "BB".toBytes()), 1 as i64);
  a.receive(dataPacketFlags(OUR, 11, 0, 0, ppidString(), 0, "BB".toBytes()), 1 as i64);
  a.receive(dataPacketFlags(OUR, 12, 0, 0, ppidString(), dataFlagEnd(), "CC".toBytes()), 1 as i64);
  t.eqStr(delivered(a), "AABBCC", "the message is not doubled by the duplicate");
  a.receive(dataPacketFlags(OUR, 11, 0, 0, ppidString(), 0, "BB".toBytes()), 1 as i64);
  t.eqStr(delivered(a), "", "and a late copy of a consumed piece delivers nothing");
  return t.report();
}

export string test_tsn_comparison_is_serial_so_it_survives_the_wrap_at_2_32() {
  // RFC 1982: subtract and read the sign, because the subtraction wraps the way the counter does.
  T t = T.create();
  t.isTrue(tsnBefore(1, 2), "1 before 2");
  t.isFalse(tsnBefore(2, 1), "2 is not before 1");
  t.isTrue(tsnBefore(-2, -1), "negative as an i32 is still just a counter");
  // Across the wrap: 0xFFFFFFFF is -1, and the next TSN is 0. A plain `<` says 0 comes first.
  t.isTrue(tsnBefore(-1, 0), "0xFFFFFFFF comes before 0, which follows it");
  t.isFalse(tsnBefore(0, -1), "and not the other way round");
  return t.report();
}

export string test_an_acknowledgement_clears_what_it_covers_across_2_31() {
  // **The same mistake as the sentinel, one comparison along.** A sequence crosses the signed midpoint on some
  // sessions, and there a plain `<=` inverts: the chunks stay in flight for ever, the congestion window never
  // reopens, and the transfer stops.
  T t = T.create();
  Association a = answering(OUR, 0x7FFFFFFE, 1);
  a.send(0, 51, "one".toBytes(), false, -1, 0 as i64);
  a.send(0, 51, "two".toBytes(), false, -1, 0 as i64);
  a.send(0, 51, "three".toBytes(), false, -1, 0 as i64);
  i32[] tsns = dataTsns(a.take());
  t.eqI32(tsns.len(), 3, "three sent");
  t.isTrue(tsns[2] < 0 && tsns[0] > 0, "the TSNs cross 2^31: \{tsns[0]} … \{tsns[2]}");
  a.receive(sackPacket(OUR, tsns[2], 65536), 1 as i64);
  t.eqI32(a.outstanding(), 0, "the SACK covers all three");
  return t.report();
}

export string test_the_receivers_cumulative_point_starts_empty() {
  // A cumulative point of -1 for "nothing yet" is also 0xFFFFFFFF, a TSN a peer really sends.
  T t = T.create();
  Association a = answering(OUR, 1, -1);
  a.receive(dataPacket(OUR, -1, 0, 0, ppidString(), "a".toBytes()), 1 as i64);
  t.eqI32(sackCumulative(firstOfKind(a.take(), chunkSack())), -1, "0xFFFFFFFF is the first chunk, and cumulative");
  a.receive(dataPacket(OUR, 1, 0, 2, ppidString(), "c".toBytes()), 1 as i64);
  u8[] sack = firstOfKind(a.take(), chunkSack());
  t.eqI32(sackCumulative(sack), -1, "a chunk two past it is out of order, not a new start");
  t.eqI32(sackGaps(sack), 1, "and is reported as a gap");
  a.receive(dataPacket(OUR, 0, 0, 1, ppidString(), "b".toBytes()), 1 as i64);
  t.eqI32(sackCumulative(firstOfKind(a.take(), chunkSack())), 1, "the successor across the wrap carries 1 with it");
  t.eqStr(delivered(a), "a|b|c", "and the messages come up in stream order");
  return t.report();
}

export string test_a_sack_reports_the_chunks_that_arrived_out_of_order() {
  // **A cumulative point alone understates what arrived.** If 5 is lost and 6, 7, 8 arrive, a SACK saying only "4"
  // makes the peer resend all four. Gap blocks — offsets from the cumulative TSN — make one loss one retransmission.
  T t = T.create();
  Association a = answering(OUR, 1, 1);
  i32[] arrived = [1, 2, 3, 4, 6, 7, 8, 10];
  for (i32 i = 0; i < arrived.len(); i++) {
    a.receive(dataPacketFlags(OUR, arrived[i], 0, 0, ppidString(), dataFlagBegin() | dataFlagEnd() | 0x04, "x".toBytes()), 1 as i64);
  }
  u8[] sack = lastOfKind(a.take(), chunkSack());
  t.eqI32(sackCumulative(sack), 4, "the cumulative point is 4 — 5 never came");
  t.eqI32(sackGaps(sack), 2, "two runs arrived above it: 6-8 and 10");
  t.eqI32(sackGapStart(sack, 0), 2, "the first run starts at +2");
  t.eqI32(sackGapEnd(sack, 0), 4, "and ends at +4");
  t.eqI32(sackGapStart(sack, 1), 6, "and 10 is +6, on its own");
  t.eqI32(sackGapEnd(sack, 1), 6, "starting and ending there");
  a.receive(dataPacketFlags(OUR, 5, 0, 0, ppidString(), dataFlagBegin() | dataFlagEnd() | 0x04, "x".toBytes()), 1 as i64);
  u8[] after = firstOfKind(a.take(), chunkSack());
  t.eqI32(sackCumulative(after), 8, "5 closed the first hole and 6, 7, 8 were already here");
  t.eqI32(sackGaps(after), 1, "10 is still a gap, because 9 is still missing");
  return t.report();
}

export string test_three_sacks_reporting_a_tsn_missing_resend_it() {
  // **A gap is not a timeout.** A SACK naming later TSNs proves the path is delivering, so after three such reports
  // the missing chunk goes again at once (RFC 4960 §7.2.4) — three, because reordering produces a gap too.
  T t = T.create();
  Association a = answering(OUR, 1, 1);
  string[] bodies = ["one", "two", "three", "four", "five"];
  for (string body in bodies) { a.send(0, 51, body.toBytes(), false, -1, 0 as i64); }
  t.eqI32(dataTsns(a.take()).len(), 5, "five sent");
  // The peer got 1, lost 2, and has 3, 4, 5: cumulative 1, one gap block at +2..+4.
  a.receive(gapSack(), 1 as i64);
  t.eqI32(dataTsns(a.take()).len(), 0, "one report is not enough — a reorder looks the same");
  a.receive(gapSack(), 2 as i64);
  t.eqI32(dataTsns(a.take()).len(), 0, "nor two");
  a.receive(gapSack(), 3 as i64);
  i32[] again = dataTsns(a.take());
  t.eqI32(again.len(), 1, "the third report resends exactly one chunk — 2, not 2 through 5");
  if (again.len() == 1) { t.eqI32(again[0], 2, "the missing one, at its own TSN"); }
  a.receive(gapSack(), 4 as i64);
  t.eqI32(dataTsns(a.take()).len(), 0, "and not again on the next report");
  return t.report();
}

u8[] gapSack() {
  return sackPacketGaps(OUR, 1, 65536, [2] as i32[], [4] as i32[]);
}

export string test_aiortc_reads_our_gap_blocks_back_as_the_runs_we_meant(Sys sys) {
  Procs procs = sys.procs();
  // **A foreign parser, not ours.** aiortc unpacks a SACK with `!LLHH` and then `!HH` per gap, so it disagrees the
  // moment a field moves.
  T t = T.create();
  Association a = answering(OUR, 1, 1);
  i32[] arrived = [1, 2, 3, 4, 6, 7, 8, 10, 13, 14];
  for (i32 i = 0; i < arrived.len(); i++) {
    a.receive(dataPacketFlags(OUR, arrived[i], 0, 0, ppidString(), dataFlagBegin() | dataFlagEnd() | 0x04, "x".toBytes()), 1 as i64);
  }
  u8[] sack = lastOfKind(a.take(), chunkSack());
  Lines lines = Lines.create();
  lines.add("sackbody \{hexOf(sack)} \{h32(4)} 65536 0 2-4,6-6,9-10");
  ask(t, procs, lines, "aiortc's gap blocks");
  return t.report();
}

export string test_and_a_sack_with_nothing_out_of_order_still_parses(Sys sys) {
  Procs procs = sys.procs();
  // The empty case is the one an implementation gets wrong by shortening the chunk: a SACK is 16 bytes on the wire
  // even with no gaps, because the two counts are part of it.
  T t = T.create();
  Association a = answering(OUR, 1, 1);
  a.receive(dataPacket(OUR, 1, 0, 0, ppidString(), "x".toBytes()), 1 as i64);
  u8[] sack = firstOfKind(a.take(), chunkSack());
  t.eqI32(sack.len(), 12, "twelve bytes of value; the four-byte chunk header is added around it");
  Lines lines = Lines.create();
  lines.add("sackbody \{hexOf(sack)} \{h32(1)} 65536 0 -");
  ask(t, procs, lines, "aiortc's empty SACK");
  return t.report();
}

export string test_a_peers_shutdown_is_answered_and_nothing_is_sent_after() {
  // RFC 4960 §9.2: a SHUTDOWN is answered with SHUTDOWN-ACK, and **refusing to send afterwards is the point** — an
  // association that answers a shutdown and keeps putting DATA on the path makes the peer abort. (This end never
  // starts the exchange: Chromium closes with ABORT, and nothing here has needed to.)
  T t = T.create();
  Association a = answering(OUR, 1, 1);
  a.receive(shutdownPacket(OUR, 0), 1 as i64);
  u8[][] reply = a.take();
  t.isTrue(firstOfKind(reply, chunkShutdownAck()).len() == 0 && reply.len() == 1 && firstChunkKind(reply[0]) == chunkShutdownAck(),
           "one packet back, a SHUTDOWN-ACK");
  t.isFalse(a.send(0, 51, "late".toBytes(), false, -1, 2 as i64), "nothing goes out after a shutdown was agreed");
  return t.report();
}

export string test_an_abort_closes_the_association_at_once() {
  // **This is the chunk a browser actually sends.** Ignoring it leaves an association that believes it is live,
  // retransmits into a peer that has gone, and never reports the close to whatever is above it.
  T t = T.create();
  Association a = answering(OUR, 1, 1);
  a.send(0, 51, "one".toBytes(), false, -1, 0 as i64);
  a.take();
  a.receive(abortPacket(OUR), 1 as i64);
  t.eqI32(a.take().len(), 0, "nothing goes back — an ABORT is never answered (§8.5.1)");
  bool reported = false;
  SctpEvent[] es = a.events();
  for (i32 i = 0; i < es.len(); i++) { match (es[i]) { Down(aborted): { reported = aborted; } default: { } } }
  t.isTrue(reported, "the abort is reported, not merely ignored");
  t.eqI32(a.outstanding(), 0, "and what was in flight is dropped rather than retransmitted at a peer that has gone");
  t.isFalse(a.send(0, 51, "two".toBytes(), false, -1, 2 as i64), "no more sending");
  return t.report();
}

u8[] copyOf(u8[] b) {
  u8[] out = u8[].filled(b.len(), 0);
  out.copyFrom(b, 0, 0, b.len());
  return out;
}

string repeated(string s, i32 n) {
  string out = "";
  for (i32 i = 0; i < n; i++) { out = out + s; }
  return out;
}

/**
 * **The peer says in its INIT which TSN it will start at**, and the first DATA chunk to *arrive* must not be taken
 * for it. Cumulative means everything up to and including it arrived; adopting an overtaking 101 as the cumulative
 * point is a statement that 100 arrived, made about a chunk still on the wire — and 100 is then refused as a
 * duplicate, never named in a gap block, and lost with both ends believing it was delivered.
 */
export string test_the_peers_declared_first_tsn_is_believed_over_the_first_to_arrive() {
  T t = T.create();
  Association a = answering(OUR, 1, 100);
  a.receive(dataPacket(OUR, 101, 0, 1, ppidString(), "B".toBytes()), 0 as i64);
  u8[] sack = firstOfKind(a.take(), chunkSack());
  t.eqI32(sackCumulative(sack), 99, "nothing in order has arrived: the peer said it starts at 100");
  t.eqI32(sackGaps(sack), 1, "101 is reported as a gap");
  a.receive(dataPacket(OUR, 100, 0, 0, ppidString(), "A".toBytes()), 0 as i64);
  u8[] after = firstOfKind(a.take(), chunkSack());
  t.eqI32(sackCumulative(after), 101, "100 arrived and closed the hole, so everything through 101 is delivered");
  t.eqI32(sackGaps(after), 0, "and the gap is closed");
  t.eqStr(delivered(a), "A|B", "in stream order");
  // **A retransmitted INIT must not rewind a receive point that has moved.**
  a.receive(initPacket(PEER_TAG, 65536, 16, 16, 100), 0 as i64);
  a.take();
  a.receive(dataPacket(OUR, 102, 0, 2, ppidString(), "C".toBytes()), 0 as i64);
  t.eqI32(sackCumulative(firstOfKind(a.take(), chunkSack())), 102, "a repeated INIT did not rewind the cumulative point");
  return t.report();
}
