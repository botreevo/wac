// expect: answer() = 15152
// why: the awaited operand is evaluated where the `await` is, so a lambda written in it reads the
// function's locals as any lambda in the body does — `await run((i32 d) => { … name … })` once failed to
// build (issues/lang/0424d)
// spec: §wac-await-pending-9km2xtr
import { Ticket } from "core";

Ticket<i32> ready(i32 v) {
  Ticket<i32> t;
  t.resolve(v);
  return t;
}
async i32 run(fn<void(i32)> progress) {
  progress(1);
  i32 v = await ready(2);
  progress(v);
  return v;
}
async i32 go() {
  string name = "abc";
  i32[] seen = i32[].filled(1, 0);
  i32 base = 1000;
  i32 n = await run((i32 done) => { string s = "\{name}"; seen[0] = seen[0] + base * done / 2 + s.len(); });
  await run((i32 done) => { seen[0] = seen[0] + name.len() * done; });
  return seen[0] * 10 + n;
}
export i32 answer() { return go().wait()!; }
