// expect: f() = 66
// why: `-0.5` is a literal, so it enters a union by its numeric alternative as `0.5` does (issues/lang/0425d)
// spec: §wac-union-literal-target-vmitw6m
struct T {
  f64 take(this, union<T, f64> x) {
    match (x) {
      f64: { return x; }
      T: { return 100.0; }
    }
  }
}
export i32 f() {
  T t = T();
  f64 a = t.take(-0.5) + t.take(-(-1.5)) + t.take(t) * 0.5 + t.take(15.0);
  return a as~ i32;
}
