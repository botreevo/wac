// expect: f() = 23
// why: an array literal handed to a parameter of type `fn<…>[]` gives each of its elements the element
// type, a lambda included (issues/lang/0429d)
// spec: §wac-fnref-array-n8qm4jf
struct T { i32 v; }
i32 apply(i32 k, fn<i32(T)>[] fs) {
  i32 t = 0;
  for (i32 i = 0; i < fs.len(); i++) { t = t + fs[i](T(k)); }
  return t;
}
export i32 f() { return apply(5, [(T t) => t.v * 4, (T t) => t.v - 2]) - 0 + (true ? 0 : 1); }
