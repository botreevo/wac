// expect: refused
// why: a `match` statement's subject is an expression and is checked as one — `flatten` over a plain `Result`
// cannot be typed, here as anywhere (issues/lang/0433d)
// spec: §wac-match-nullable-subject-zcnasbp
import { Result, flatten } from "core";
Result<i32, string> g() { return Result.Ok(1); }
export i32 f() {
  match (flatten(g())) {
    Ok(v): { return v; }
    Err(e): { return 0; }
  }
}
