// expect: f() = 1204
// why: `as` converts without loss, and a `string` is a `string?` already, so `"x" as string?` is that string in
// a nullable slot — as `v as Value?` is for a struct (issues/lang/0434d)
// spec: §wac-null-as-typed-ifyaj6m
export i32 f() {
  string? a = null;
  bool c = true;
  if (c) { a = "x" as string?; }
  string? b = c ? "yy" as string? : null;
  string? n = (c ? null : "zzz") as string?;
  string d = "four" as string;
  return (a ?? "").len() * 1000 + (b ?? "").len() * 100 + (n ?? "").len() * 10 + d.len();
}
