// expect: f() = 1446
// why: an `async` lambda is allowed wherever a `fn<Ticket<R>(…)>` is expected — a struct's field, positional or
// named, an assigned field, a parameter, a return — and in each it is the function the slot holds (issues/lang/0437d)
// spec: §wac-async-lambda-slot-9wq4nkz
import { Ticket } from "core";

Ticket<i32> ready(i32 v) {
  Ticket<i32> t;
  t.resolve(v);
  return t;
}
struct Driver { fn<Ticket<i32>(i32)> open; }
i32 use(fn<Ticket<i32>(i32)> g) { return g(5).wait()!; }
fn<Ticket<i32>(i32)> mk(i32 k) { return async (i32 n) => { i32 v = await ready(n); return v * k; }; }

export i32 f() {
  Driver a = Driver(async (i32 n) => { i32 v = await ready(n); return v * 2; });
  Driver b = Driver { open: async (i32 n) => { i32 v = await ready(n); return v + 1; } };
  Driver c = Driver((i32 n) => ready(0));
  c.open = async (i32 n) => { await; return n - 1; };
  return a.open(21).wait()! * 10 + b.open(9).wait()! * 100 + c.open(4).wait()! + use(async (i32 n) => { i32 v = await ready(n); return v * 3; }) + mk(4)(2).wait()!;
}
