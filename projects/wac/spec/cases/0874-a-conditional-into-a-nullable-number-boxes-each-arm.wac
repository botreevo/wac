// expect: f() = 33
// why: a `T?` of a number is a box, and a conditional going into one boxes whichever arm it takes — the block is
// the box, as the slot is (issues/lang/0439d)
// spec: §wac-ternary-null-3kx9ba2
i64? smaller(i64 v, i64 w) { return v < w ? v : w; }
i32? maybe(bool c) { return c ? 3 : null; }
export i64 f() {
  i64? a = smaller(3 as i64, 5 as i64);
  i32? b = maybe(true);
  return (a ?? 0 as i64) * 10 + ((b ?? 0) as i64);
}
