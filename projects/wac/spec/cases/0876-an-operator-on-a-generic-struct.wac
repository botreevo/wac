// expect: f() = 36
// why: an operator method is a method, read in its receiver's world — `const Box<T>` on a `Box<i32>` takes a
// `Box<i32>`, for a binary operator and for a compound assignment alike (issues/lang/0441d)
// spec: §wac-operator-dispatch-left-txsqbyi
import { operators } from "core";

struct Box<T> {
  T v;
  i32 n;
  Box<T> [operators.add](const this, const Box<T> rhs) { return Box<T>(this.v, this.n + rhs.n); }
  bool [operators.equal](const this, const Box<T> rhs) { return this.n == rhs.n; }
  void [operators.addAssign](this, const Box<T> rhs) { this.n = this.n + rhs.n * 10; }
}

export i32 f() {
  Box<i32> a = Box<i32>(1, 2) + Box<i32>(7, 3);
  Box<string> b = Box<string>("x", 1);
  b += Box<string>("y", 3);
  return (a == Box<i32>(0, 5) ? a.n : 0) + b.n;   // 5 + 31
}
