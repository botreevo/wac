// expect: f() = 1237856
// why: a destructuring in an `async` function declares locals like any other, held across a suspension — flat,
// nested, with a written whole type, partly `auto`, and bound from an awaited ticket (issues/lang/0443d)
// spec: §wac-tuple-destructure-gn8i48y
import { Ticket } from "core";

Ticket<i32> ready(i32 v) { Ticket<i32> t; t.resolve(v); return t; }
Ticket<(i32, i32)> pair() { Ticket<(i32, i32)> t; t.resolve((5, 6)); return t; }

async i32 g() {
  i32 two = 2;
  ((i32 a, auto b), i32 c) = ((1, two), 3);
  (u32, u32) (q, r) = (7 as u32, 8 as u32);
  (i32 x, i32 y) = await pair();
  await ready(0);
  return a * 1000000 + b * 100000 + c * 10000 + (q as! i32) * 1000 + (r as! i32) * 100 + x * 10 + y;
}

export i32 f() { return g().wait()!; }
