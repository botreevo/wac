// expect: f() = 3
// why: a pattern typing some of its names, over a tuple written out, types each position from the pattern where it
// writes a type and from the member where it does not — the `1` takes `i32`, `b` takes `x`'s (issues/lang/0444d)
// spec: §wac-tuple-destructure-gn8i48y
export i32 f() {
  i32 x = 2;
  (i32 a, auto b) = (1, x);
  return a + b;
}
