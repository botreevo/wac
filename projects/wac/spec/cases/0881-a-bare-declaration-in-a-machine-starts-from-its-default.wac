// expect: f() = 5
// why: a declaration without an initialiser gives its default every time it runs, in an `async` function as anywhere
// else — `seen` is `null` again on each pass, though the machine keeps one cell for it (issues/lang/0445d)
// spec: §wac-async-eager-2rf9kdp
import { Ticket } from "core";

Ticket<i32> ready(i32 v) { Ticket<i32> t; t.resolve(v); return t; }

async i32 g() {
  i32 total = 0;
  for (i32 i = 0; i < 3; i++) {
    i32? seen;
    if (i == 0) { seen = 5; }
    total = total + (seen ?? 0);
    await ready(0);
  }
  return total;
}

export i32 f() { return g().wait()!; }
