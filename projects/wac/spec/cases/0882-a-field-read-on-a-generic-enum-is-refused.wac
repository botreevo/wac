// expect: refused
// why: a generic enum's instance has no fields, as a plain enum has none — `look().isDir` on a `Result<S, E>` is
// no such field, not a module the build then refuses (issues/lang/0411a)
// spec: §enum-match-basic
import { Result } from "core";

struct S { bool isDir; }
struct E { string m; }

Result<S, E> look() { return Result.Ok(S(true)); }

export i32 main() { return look().isDir ? 1 : 0; }
