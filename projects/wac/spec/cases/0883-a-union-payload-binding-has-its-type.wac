// expect: refused
// why: an arm binding on a generic enum takes its payload's type when that type is a union, as when it is a struct —
// `e` is a `union<NF, OT>`, which a `string` cannot hold (issues/lang/0413a)
// spec: §enum-match-basic
import { Result } from "core";

struct NF { string m; }
struct OT { string m; }

export i32 main() {
  Result<i32, union<NF, OT>> r = Result.Err(OT("x"));
  string why = "";
  match (r) {
    Ok(v): { why = "ok"; }
    Err(e): { why = e; }
  }
  return why.len();
}
