// expect: refused
// why: a static of a generic struct that uses none of its owner's letters answers its written return type —
// `Ticket.first` gives a `Ticket<i32>`, whose `wait()` is a `Result`, not an `i32` (issues/lang/0415a)
// spec: §wac-generic-unused-param-unbound-k4p2xqz
import { Ticket, TicketBase } from "core";

export i32 main() {
  Ticket<i32> a;
  a.resolve(3);
  TicketBase[] parts = [a];
  i32 which = Ticket.first(parts).wait();
  return which;
}
