// expect: refused
// why: a type `std` answers from `core` has its members in a file that never imported it — `nowMillis()` is a
// `Ticket`, its `wait()` a `Result` of a `Result`, and `ok()` of that is no `i64` to put beside `?? 0 as i64`
// (issues/lang/0436d)
// spec: §wac-coalesce-type-uqe5ae9
import { Sys } from "std";

export string test_y(Sys sys) {
  string dir = "/tmp/x-\{(sys.clock().nowMillis().wait().ok() ?? 0 as i64)}";
  return dir == "" ? "bad" : "";
}
