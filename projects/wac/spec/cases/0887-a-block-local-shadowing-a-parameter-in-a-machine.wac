// expect: f() = 3
// why: in an `async` function a block-local that shadows a parameter is its own variable — after the block the
// parameter is read, whatever the machine keeps its locals in (issues/lang/0412a)
// spec: §wac-async-eager-2rf9kdp
import { Ticket } from "core";

struct P { i32 n; }
struct Q { string s; }

Ticket<i32> ready(i32 v) { Ticket<i32> t; t.resolve(v); return t; }

async i32 run(P out) {
  if (out.n > 0) {
    Q out = Q("shadow");
    await ready(0);
    if (out.s.len() == 0) { return 9; }
  }
  await ready(0);
  return out.n;
}

export i32 f() { return run(P(3)).wait()!; }
