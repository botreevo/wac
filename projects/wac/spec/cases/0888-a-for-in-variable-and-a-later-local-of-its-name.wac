// expect: f() = 5
// why: a `for … in` variable in an `async` function and a later local of the same name are two variables, of two
// types (issues/lang/0420c)
// spec: §wac-async-eager-2rf9kdp
import { Ticket } from "core";

Ticket<i32> ready(i32 v) { Ticket<i32> t; t.resolve(v); return t; }

async i32 count(string[] given) {
  i32 n = 0;
  for (string g in given) {
    if ((await ready(g.len())) > 0) { n = n + 1; }
  }
  i32[] g = i32[].filled(3, 0);
  return n + g.len();
}

export i32 f() { return count(["a", "b"]).wait()!; }
