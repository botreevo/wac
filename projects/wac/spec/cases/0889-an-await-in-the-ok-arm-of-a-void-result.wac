// expect: f() = 4
// why: an `await` in an arm whose binding is a `void` payload — `Ok(v)` on a `Result<void, E>` — suspends like any
// other; a binding nothing reads holds nothing across it (issues/lang/0405a)
// spec: §wac-async-eager-2rf9kdp
import { Result, Ticket } from "core";

struct Gone { string m; }

async Result<void, Gone> act(bool ok) { return ok ? Result.Ok() : Result.Err(Gone("x")); }
Ticket<i32> ready(i32 v) { Ticket<i32> t; t.resolve(v); return t; }

async i32 g() {
  i32 n = 0;
  match (await act(true)) {
    Ok(v): { n = await ready(4); }
    Err(e): { n = 1; }
  }
  return n;
}

export i32 f() { return g().wait()!; }
