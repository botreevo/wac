// expect: refused
// why: one scope cannot declare a local name twice — the second `n` would be read wherever the first was meant, which is
// how a light client came to want every one of 512 signers (reported by wac-eth)
// spec: §wac-redeclare-same-scope-q6m3ztc
export i32 f() {
  i32 n = 3;
  i32 m = n + 1;
  i32 n = 4;
  return n + m;
}
