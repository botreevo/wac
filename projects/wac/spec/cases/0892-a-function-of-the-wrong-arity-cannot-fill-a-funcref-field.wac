// expect: refused
// why: a struct's function-typed field takes only a function of its type; one of a different arity is refused
//      at construction rather than emitted into a module the engine rejects
// from: issues/lang/0290c
// spec: §wac-fnref-get-t4kn7wp
struct Cap { fn<i32(i32, i32, i32)> f; }
i32 two(i32 a, i32 b) { return a + b; }
export i32 f() { Cap c = Cap(two); return c.f(1, 2, 3); }
