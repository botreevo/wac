// expect: f() = 3
// why: a method may declare letters its owner does not have, and that holds when the owner has none of its own
// from: issues/lang/0319a
// spec: §wacc-method-type-args
struct S { i32 n; U pick<U>(const this, U a) { return a; } }
export i32 f() { S s = S(1); return s.pick<i32>(3) + s.pick<string>("").len(); }
