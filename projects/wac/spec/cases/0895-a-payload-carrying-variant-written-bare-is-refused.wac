// expect: refused
// why: a variant with a payload written without an argument list constructs nothing; there is no spelling that
//      leaves its payload out
// from: issues/lang/0335a
// spec: §enum-construct-payload-required-uc2cir8
enum Sh { A, B(string s) }
Sh make() { return Sh.B; }
export i32 f() { match (make()) { A: { return 1; } B(s): { return s.len(); } } }
