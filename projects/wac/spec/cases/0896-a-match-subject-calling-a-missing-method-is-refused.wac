// expect: refused
// why: a match subject is an expression like any other, and a call to a method its receiver does not have is
//      refused there rather than left for the emitter
// from: issues/lang/0403a
import { Result } from "core";
struct P { i32 x; }
export i32 f() {
  P p = P(1);
  match (p.nope()) {
    Ok(out): { return 1; }
    Err(e): { return 2; }
  }
}
