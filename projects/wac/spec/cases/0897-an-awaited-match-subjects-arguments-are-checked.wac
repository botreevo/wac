// expect: refused
// why: an awaited call's arguments are checked against its parameters when the call is a match subject, as
//      they are when it is bound to a local
// from: issues/lang/0416a
import { Result } from "core";
async Result<i32, string> half(string s) { return Result.Ok(s.len() / 2); }
async i32 g() {
  match (await half(5)) {
    Ok(v): { return v; }
    Err(e): { return 0; }
  }
}
export i32 f() { return g().wait()!; }
