// expect: refused
// why: a `return` in a match arm that leaves is checked against the function's return type like any other `return`
// from: issues/lang/0377a
// spec: §wac-match-arm-leaves-y33uzzi
import { Result } from "core";
Result<i32, string> get(i32 n) { if (n < 0) { return Result.Err("no"); } return Result.Ok(n); }
export i32 f() {
  i32 v = match (get(3)) {
    Ok(x): x,
    Err(e): return "oops",
  };
  return v + 1;
}
