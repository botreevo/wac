// expect: refused
// why: a cast does not take an enum apart: `as!` from a `Result<T, E>` to its `T` is no conversion, and `!` or
//      `unwrap()` is the spelling that takes `Ok`'s value
// from: issues/lang/0399b
import { Result } from "core";
Result<i32, string> r() { return Result.Ok(1); }
export i32 f() { return r() as! i32; }
