// expect: refused
// why: `void` has no values, so a union with it beside another member would hold a value or nothing at all, and is
//      refused where it is written
// from: issues/lang/0378a
// spec: §wac-void-no-values-uieaw93
void nothing() { }
export i32 f() { union<i32, void> u = nothing(); return 3; }
