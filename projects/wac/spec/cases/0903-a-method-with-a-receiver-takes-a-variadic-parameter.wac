// expect: f() = 23
// why: a variadic parameter is a parameter, so a method with a receiver may end with one; its call packs the
//      remaining arguments into one tuple as a free function's does
// from: issues/lang/0373a
// spec: §wac-variadic-tuple-sfevn82
struct Box<T> {
  T v;
  i32 count<Ts>(this, Ts ...xs) { return typeref(Ts).tupleMembers().len(); }
}
struct Acc {
  i32 base;
  i32 plus<Ts>(this, i32 a, Ts ...xs) { return this.base + a + typeref(Ts).tupleMembers().len(); }
}
export i32 f() {
  Box<i32> b = Box(1);
  Acc a = Acc(10);
  return b.count("x", true) + b.count() + a.plus(8, "p", "q", "r");   // 2 + 0 + (10 + 8 + 3)
}
