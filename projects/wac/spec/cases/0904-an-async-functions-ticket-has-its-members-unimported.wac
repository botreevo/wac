// expect: refused
// why: an `async` function answers core's `Ticket`, whose members a file has whether or not it imports the name —
// `one().wait()` is a `Result`, which an `i32` cannot hold (issues/lang/0449e)
// spec: §wac-async-eager-2rf9kdp
async i32 one() { return 1; }

export i32 main() {
  i32 x = one().wait();
  return x;
}
