// expect: f() = 1
// why: `void` as a type argument erases the parameter it stands in for, in a method as in a funcref —
// `Ticket<void>.resolve()` takes nothing, where `resolve(T v)` is written with one (issues/lang/0407a)
// spec: §wac-void-typearg-2mkx9db
import { Ticket } from "core";

export i32 f() {
  Ticket<void> done;
  done.resolve();
  return done.settled() ? 1 : 0;
}
