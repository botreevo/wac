// expect: f() = 2
// why: `Ticket.any` over tickets of `void` is a `Ticket<void>`, settled when the first one is; both calls ran when they
// were made (issues/lang/0448e)
// spec: §wac-ticket-any-v8nr3r9
import { Ticket } from "core";

struct Count { i32 n; }

async void bump(Count c) { c.n = c.n + 1; }

async i32 g() {
  Count c = Count(0);
  await Ticket.any(bump(c), bump(c));
  return c.n;
}

export i32 f() { return g().wait()!; }
