// expect: f() = 7
// spec: §wac-generic-fn-5hvq3mt
// why: a lambda argument's answer binds the letter its parameter's return names — `make(true, (bool b) => named(b))`
// is `make<bool, string>` in a ternary's branch and in a local lambda's body, where the call initialises no slot
// (issues/lang/0404a)
U make<T, U>(T x, fn<U(T)> f) { return f(x); }
string named(bool b) { return b ? "y" : "no"; }

export i32 f() {
  bool[] shut = bool[].filled(1, false);
  string s = shut[0] ? "a" : make(true, (bool b) => named(b));
  fn<string(string)> go = (string p) => shut[0] ? p : make(false, (bool b) => named(b));
  return s == "y" && go("x") == "no" ? 7 : 0;
}
