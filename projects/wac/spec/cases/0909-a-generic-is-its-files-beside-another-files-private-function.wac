// expect: f() = 7
// spec: §wac-generic-instantiation-identity-6pnq4wj
// why: a generic function's name was never declared, so in its own file `wrap(3, shout)` resolved to whatever held the
// bare key — the entry's private, non-generic `wrap(i32)` — and was typed as that one; neither is exported, so each
// file's `wrap` is its own (issues/lang/0402a)
// ---- lib.wac ----
struct Box<U> { U v; }
Box<U> wrap<T, U>(T x, fn<U(T)> f) { Box<U> b = Box<U>(f(x)); return b; }
string shout(i32 n) { return "\{n}!"; }
export i32 libLen() { return wrap(3, shout).v.len(); }
// ---- main.wac ----
import { libLen } from "./lib.wac";
i32[] wrap(i32 n) { i32[] b = [n]; return b; }
export i32 f() { return libLen() + wrap(5)[0]; }
