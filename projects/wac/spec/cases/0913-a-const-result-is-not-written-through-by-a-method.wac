// expect: refused
// why: a method declaring a `const T` result hands back a reference nothing may write through, and calling a
//      writing method straight on it is a write through it
// from: issues/lang/0315a
// spec: §wac-const-no-launder-t584c4n
struct Inner { i32 val; void mutate(this) { this.val = 1; } }
struct Outer { Inner inner; const Inner get(this) { return this.inner; } }
export i32 f() { Outer o = Outer(Inner(0)); o.get().mutate(); return o.inner.val; }
