// expect: f() = 1
// why: a type imported under an alias is the type it names, at any depth of a field's generic instance — the
//      instance is built for the type and not for the spelling
// from: issues/lang/0397a
// ---- lib.wac ----
export struct Item { i32 n; }
export struct Cell<T> { T? held = null; }
export struct Pair<A, B> { A a; B b; }
// ---- main.wac ----
import { Item as Thing, Cell, Pair } from "./lib.wac";
struct Holder { Cell<Pair<Thing, i32>> c; }
export i32 f() {
  Holder h = Holder(Cell<Pair<Thing, i32>>(null));
  return h.c.held is null ? 1 : 0;
}
