// expect: f() = 14
// why: a literal whose value can be written through is converted afresh each time it is evaluated, so a write
//      through one evaluation's value is not seen by the next
// from: issues/lang/0360a
// spec: §wac-fromnumber-evaluation-5k2r8vq
import { NumberLiteral, fromNumber, Result } from "core";
struct Box {
  i32 v;
  Result<Box, string> [fromNumber](NumberLiteral n) { return Result.Ok(Box(7)); }
}
export i32 f() {
  i32 total = 0;
  for (i32 i = 0; i < 2; i++) {
    Box b = 3;
    total = total + b.v;
    b.v = 100;
  }
  return total;
}
