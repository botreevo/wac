// expect: f() = 3
// spec: §wac-alias-same-type-j3wq8kf
// why: an alias is the declaration it names, whatever its spelling — a static reached through `@"$q"` is `P.make`, as it
//      is through `Q` (issues/lang/0421c)
// ---- p.wac ----
export struct P { i32 n; P make(i32 v) { return P(v); } }
// ---- main.wac ----
import { P as Q } from "./p.wac";
import { P as @"$q" } from "./p.wac";
export i32 f() { return Q.make(1).n + @"$q".make(2).n; }
