// expect: f() = 31
// why: `D d;` constructs a `D` each time it runs, in an `async` function as anywhere else — the machine keeps one cell
//      for `d`, and the two passes still push two objects; a `Ticket<bool> t;` per pass is a new, unsettled ticket each
//      time, so resolving all three is three resolves, not one twice (issues/lang/0474w)
// spec: §wac-async-eager-2rf9kdp
import { Ticket, Vec } from "core";

struct D { i32 n = 0; }

Ticket<i32> ready(i32 v) { Ticket<i32> t; t.resolve(v); return t; }

async i32 structs() {
  Vec<D> seen = Vec.create();
  for (i32 i = 0; i < 2; i++) {
    D d;
    d.n += 1;
    seen.push(d);
    await ready(0);
  }
  D first = seen.get(0);
  first.n = 7;
  return seen.get(1).n;
}

async i32 tickets() {
  Vec<Ticket<bool>> made = Vec.create();
  for (i32 i = 0; i < 3; i++) {
    Ticket<bool> t;
    made.push(t);
    await ready(0);
  }
  for (i32 i = 0; i < made.len(); i++) { made.get(i).resolve(true); }
  return made.len();
}

export i32 f() { return structs().wait()! + tickets().wait()! * 10; }
