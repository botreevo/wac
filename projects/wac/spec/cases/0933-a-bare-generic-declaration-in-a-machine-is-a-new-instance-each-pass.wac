// expect: f() = 11
// why: a generic instance declared without an initialiser — `Vec<i32> v;` — is constructed each time the declaration
//      runs in an `async` function too, so each pass pushes into its own vector (issues/lang/0474w, the generic half)
// spec: §wac-async-eager-2rf9kdp
import { Ticket, Vec } from "core";

Ticket<i32> ready(i32 v) { Ticket<i32> t; t.resolve(v); return t; }

async i32 g() {
  Vec<Vec<i32>> seen = Vec.create();
  for (i32 i = 0; i < 2; i++) {
    Vec<i32> v;
    v.push(i);
    seen.push(v);
    await ready(0);
  }
  return seen.get(0).len() * 10 + seen.get(1).len();
}

export i32 f() { return g().wait()!; }
