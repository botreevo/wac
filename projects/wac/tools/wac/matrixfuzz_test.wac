/**
 * Every crossing `tools/wac/matrixfuzz.wac` generates, compiled by this tree's compiler in this process.
 *
 * The command line runs each program through the installed `wac` — `check`, `compile`, `run` — which is the
 * compiler as last seeded, and three processes a program. Here the same programs go through langfuzz's spine:
 * diagnosed, built, given a manifest, loaded and called, with nothing between them and the source under test.
 * So a change that breaks a crossing fails the suite, and a fix is proved before anything is reseeded.
 *
 * **Nothing is excused**, as in `langfuzz_test.wac`: a failure is a compiler bug with its reproduction attached.
 */
import { Sys } from "std";
import { Construct, constructs, contexts, positions, programOf } from "./matrixfuzz.wac";
import { Ran, runProgram } from "./langfuzz.wac";

export string test_every_crossing_checks_builds_loads_and_answers(Sys sys) {
  Construct[] ks = constructs();
  string bad = "";
  i32 failed = 0;
  i32 ran = 0;
  for (i32 a = 0; a < ks.len(); a++) {
    for (string position in positions()) {
      for (string context in contexts()) {
        ran = ran + 1;
        // The spine calls `main`; every program answers through `f`.
        Ran r = runProgram(sys.modules(), programOf(ks[a], position, context) + "export i32 main() { return f(); }\n");
        if (r.ok && r.value == ks[a].want) { continue; }
        failed = failed + 1;
        if (failed <= 5) {
          bad = bad + "\n  \{ks[a].name}-\{position}-\{context}: " + (r.ok ? "answered \{r.value}, wanted \{ks[a].want}" : r.why);
        }
      }
    }
  }
  if (ran != ks.len() * positions().len() * contexts().len()) { return "ran \{ran} programs, not the whole matrix"; }
  return failed == 0 ? "" : "\{failed} of \{ran} crossings failed — the first:" + bad;
}
