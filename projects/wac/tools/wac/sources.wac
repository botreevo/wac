// The files a program is built from, resolved the way the `wac` command resolves them — its project, the packages
// its `wac.lock` pins (from the package cache), `std` and `core` — printed for a host that compiles elsewhere.
//
//     wac run --allow-read --allow-env tools/wac/sources.wac <entry.wac>
//
// One line per fact, tab-separated, so a caller needs no JSON parser:
//
//     B <base>                    the directory every relative key is measured from
//     F <key> <root>              a file the build reads; its project root, or "" when it has none
//     M <from> <spec> <to>        an import `from` wrote as `spec`, mapped to the key `to`
//
// **Why it exists**: `packages/platform/build.ts` builds a `--target browser` page with wacc in Deno, and its own
// file walk (`harness/wacFiles.ts`) knows relative, `@/`, `core` and `std` imports and not a `wac.lock` — so a
// program importing a package (`import { … } from "wac"`, all of wac-eth) failed with every such import
// unresolved. The command already resolves them, so the page builder asks it rather than growing a second copy
// of the package rules, which would drift. Exit 1, and the reason on stderr, when the walk stops.
import { Sys, Output } from "std";
import { Sources, absoluteFrom, gather, shownFrom } from "../../packages/wac/src/sources.wac";
import { normalisePath } from "../../packages/wacc/src/path.wac";
import { flatten } from "core";

string keyOf(string cwd, string base, string key, bool absolute) {
  return absolute ? absoluteFrom(base, key) : shownFrom(cwd, base, key);
}

export async i32 main(Sys sys) {
  string[] args = sys.args();
  Output err = sys.stderr();
  if (args.len() != 1) {
    err.write("usage: wac run --allow-read --allow-env tools/wac/sources.wac <entry.wac>\n".toBytes()).wait();
    return 2;
  }
  // **Every file the imports reach** (`lazy` false), and the caller prunes it as `wac build` does
  // (`pruneForBuild`) before it checks: the lazy walk leaves out a file that a kept file imports but no kept
  // declaration needs, and the caller's check of the unpruned graph reported that import missing.
  Sources s = await gather(sys.files(), sys.env(), args[0], false);
  if (s.why != "") {
    err.write((s.why + "\n").toBytes()).wait();
    return 1;
  }
  if (s.missing != "") {
    err.write(("cannot read " + s.missing + "\n").toBytes()).wait();
    return 1;
  }
  // **In the working directory's terms, as the harness reads them.** `gather` keys from the entry's project
  // root (`issues/lang/0270a`); the TypeScript callers key from `Deno.cwd()` and read each file at its key, so
  // every key goes back to that spelling here and the base with it.
  // An entry spelled absolutely was keyed absolutely, and the harness compiles it under that spelling.
  string cwd = normalisePath(flatten(sys.env().cwd().wait()).unwrap());
  bool absolute = args[0].len() > 0 && args[0].slice(0, 1) == "/";
  string out = "B\t" + cwd + "\n";
  for (i32 i = 0; i < s.n; i++) {
    string root = i < s.roots.len() ? s.roots[i] : "";
    out = out + "F\t" + keyOf(cwd, s.base, s.paths[i], absolute) + "\t" + root + "\n";
  }
  for (i32 i = 0; i < s.mapN; i++) {
    out = out + "M\t" + keyOf(cwd, s.base, s.mapFrom[i], absolute) + "\t" + s.mapSpec[i] + "\t" +
          keyOf(cwd, s.base, s.mapTo[i], absolute) + "\n";
  }
  sys.stdout().write(out.toBytes()).wait();
  return 0;
}
