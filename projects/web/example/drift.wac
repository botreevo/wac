// A page whose first frame in the browser is not the one drawn at build time — what `test/hydrate_live.test.ts`
// builds with `--prerender` to see a mismatch mended: the clock stands still at build time and has moved by the time a
// browser runs the module, so one line's text differs and one element is another tag. The rest is kept.

import { Node, Page, Ui, html.b, html.div, html.i, html.p } from "../src/page.wac";

export async i32 main(Page page) {
  bool built = page.now() == 0.0;
  string when = built ? "at build time" : "in the browser";
  page.mount((Ui ui) => <div id="drift">
    <p id="same">the same in both{""}</p>
    <p id="when">{when}</p>
    <div id="where">{built ? <b>built</b> : <i>run</i>}</div>
  </div>);
  // Still waiting when the first frame is drawn, as a page always is: the build ends the program rather than waits.
  await page.nextFrame();
  return 0;
}
