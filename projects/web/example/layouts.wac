// A page with two layouts, each drawn at build time — what `test/hydrate_live.test.ts` builds to see the frame that
// fits the window shown before any script runs, and kept when the program, told the window's size before its first
// turn (`page.size()`), draws the same layout.
//
// **The breakpoint is said once**, here: the program's rule and the frames' media query are both made from `NARROW`.

import { Frame, Node, Page, Ui, html.div, html.nav, html.p, html.style } from "../src/page.wac";

static i32 NARROW = 700;

export Frame[] prerendered() {
  return [Frame.at(390, 844, "(max-width: \{NARROW - 1}.98px)"), Frame.at(1280, 800, "")];
}

export async i32 main(Page page) {
  bool narrow = page.size().width < NARROW;
  // A stylesheet's text has no mark in the first frame, and is still the text kept.
  page.mount((Ui ui) => <div id="layout" class={narrow ? "narrow" : "wide"}>
    <style>{"#layout nav { font-weight: 600; }"}</style>
    {narrow ? <nav id="tabs">a phone's tabs</nav> : <nav id="side">a desktop's sidebar</nav>}
    <p id="size">{"\{page.size().width}x\{page.size().height}"}</p>
  </div>);
  await page.nextFrame();
  return 0;
}
