// A page that talks to the server it was served from: what `test/origin_live.test.ts` builds, serves and opens. It
// POSTs with fields and a body, then opens a WebSocket, sends on it and reads until the server closes it — or, opened
// from a file, says there is no origin.

import { Sys } from "std";
import { Node, Origin, Page, Ui, html.p } from "../src/page.wac";

async string talk(Sys sys) {
  match (await Origin.of(sys)) {
    Err(why): { return "no origin: " + why; }
    Ok(o): {
      string out = "";
      match (await o.request("POST", "/echo?q=1", ["Content-Type: application/json", "Authorization: Bearer t"], "{\"n\":1}".toBytes())) {
        Ok(r): { out = "\{r.status} " + r.header("x-seen") + " " + r.text(); }
        Err(e): { return "no answer: " + e; }
      }
      match (await o.request("DELETE", "/gone", string[](), u8[]())) {
        Ok(r): { out = out + "|\{r.status}"; }
        Err(e): { return "no answer: " + e; }
      }
      match (await o.open("/ws")) {
        Err(e): { return out + "|no socket: " + e; }
        Ok(s): {
          await s.send("hi");
          while (true) {
            match (await s.next()) {
              Text(t): { out = out + "|" + t; }
              Binary(b): { out = out + "|binary"; }
              Closed(code, why): { return out + "|closed \{code} " + why; }
            }
          }
        }
      }
    }
  }
}

async void show(Sys sys, fn<void(string)> f) { f(await talk(sys)); }

Node Talks(Ui ui, Page page) {
  auto said = ui.state("…");
  ui.effect("", () => {
    show(page.sys, (string s) => { said.set(s); });
    return () => { };
  });
  return <p id="said">{said.get()}</p>;
}

export async i32 main(Page page) {
  page.mount((Ui ui) => <Talks page={page}/>);
  return 0;
}
