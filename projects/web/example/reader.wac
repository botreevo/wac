// What a page knows about its reader that a program on a command line cannot: the reader's local time, as minutes
// ahead of UTC, and whether the page is in front of them — and a drawing made of SVG elements, which the document
// makes in SVG's namespace. What `test/reader_live.test.ts` builds and drives in a browser.

import { Node, Page, Ui, html.div, html.p } from "../src/page.wac";

Node Reader(Ui ui, Page page, i32 zone) {
  auto seen = ui.state(page.visible());
  auto away = ui.state(0);
  ui.effect("", () => page.onVisible((bool on) => {
    seen.set(on);
    if (!on) { away.update((i32 n) => n + 1); }
  }));
  return <div>
    <p id="zone">{"\{zone}"}</p>
    <p id="seen">{seen.get() ? "seen" : "away"}</p>
    <p id="away">{"\{away.get()}"}</p>
    <"svg" id="drawing" width="120" height="60">
      <"line" x1="10%" y1="50%" x2="90%" y2="50%" stroke="black" stroke-width="4"/>
      <"text" x="5" y="20">7</"text">
    </"svg">
  </div>;
}

export async i32 main(Page page) {
  i64 now = (await page.sys.clock().nowMillis()).orElse(0 as i64);
  i32 zone = page.zoneAt(now);
  page.mount((Ui ui) => <Reader page={page} zone={zone}/>);
  return 0;
}
