// A site of three pages, each a route of its own — what `test/routes_live.test.ts` builds to see each page written as its
// own `index.html` with its title and description, a link between them followed in the page, and Back.
//
// **One program draws every page**: which one is `page.path()`, known before the first turn, so each page's first frame
// is that page; links are relative (`hrefTo`), so they work wherever the site is served, before the program runs too.

import { Frame, Node, Page, Ui, hrefTo, html.a, html.div, html.h1, html.nav, html.p } from "../src/page.wac";

struct Doc {
  string path;
  string title;
  string body;
}

Doc[] docs() {
  return [Doc("/", "Home", "Welcome to the site."), Doc("/docs/a/", "Page A", "All about A."),
          Doc("/docs/b/", "Page B", "All about B.")];
}

Doc docAt(string path) {
  for (Doc d in docs()) { if (d.path == path) { return d; } }
  return Doc(path, "Not here", "There is no page at " + path + ".");
}

export Frame[] prerendered() {
  Doc[] ds = docs();
  Frame[] out = Frame[].filled(ds.len(), Frame.at(1280, 800, ""));
  for (i32 i = 0; i < ds.len(); i++) { out[i] = Frame.on(ds[i].path, 1280, 800, ""); }
  return out;
}

export async i32 main(Page page) {
  page.routeLinks();
  page.mount((Ui ui) => {
    auto at = ui.state(page.path());
    ui.effect("", () => page.onPath((string p) => { at.set(p); }));
    Doc d = docAt(at.get());
    page.title(d.title);
    page.describe(d.title + ": " + d.body);
    Doc[] ds = docs();
    Node[] links = Node[].filled(ds.len(), Node.Text(""));
    for (i32 i = 0; i < ds.len(); i++) {
      links[i] = <a key={ds[i].path} id={"to-\{i}"} href={hrefTo(at.get(), ds[i].path)}>{ds[i].title}</a>;
    }
    return <div id="site"><nav>{links}</nav><h1 id="title">{d.title}</h1><p id="body">{d.body}</p></div>;
  });
  await page.nextFrame();
  return 0;
}
