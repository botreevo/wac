// A scroller a page puts back where it was, and follows as it moves: what `test/scroll_live.test.ts` builds and opens.
// It scrolls its list to 120 once drawn (`prop("scrollTop", …)`), and shows where each `scroll` event says it is.

import { Element, ElementEvent, Node, Page, Ref, Ui, html.div, html.p } from "../src/page.wac";
import { Vec } from "core";

Node Scroller(Ui ui) {
  auto at = ui.state("…");
  Ref list = ui.ref();
  ui.effect("", () => {
    Element? el = list.element();
    if (el is not null) { el!.prop("scrollTop", "120"); }
    return () => { };
  });
  Vec<Node> rows = Vec.create();
  for (i32 i = 0; i < 50; i++) { rows.push(<div key={"\{i}"} style="height: 30px">row {"\{i}"}</div>); }
  return <div>
    <p id="said">{at.get()}</p>
    <div id="list" ref={list} style="height: 200px; overflow-y: auto" onscroll={(ElementEvent e) => { at.set(e.value); }}>{rows.toArray()}</div>
  </div>;
}

export async i32 main(Page page) {
  page.mount((Ui ui) => <Scroller/>);
  return 0;
}
