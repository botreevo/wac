// A page that reads and writes its store, says its zone by name and goes Back: what `test/store_live.test.ts` builds
// and opens. It shows what was stored under `token` (by plain JavaScript, before the page ran), stores `seen`, goes to
// `#there` and Back, and shows where it ended up.

import { Node, Page, Ui, html.p } from "../src/page.wac";

async void run(Page page, fn<void(string)> f) {
  string? token = await page.stored("token");
  page.store("seen", "from wac");
  page.unstore("gone");
  page.go("there", true);
  await page.sleep(50);
  page.back();
  await page.sleep(200);
  f((token ?? "(none)") + "|" + page.zoneName() + "|" + page.location() + ".");
}

Node Shows(Ui ui, Page page) {
  auto said = ui.state("…");
  ui.effect("", () => {
    run(page, (string s) => { said.set(s); });
    return () => { };
  });
  return <p id="said">{said.get()}</p>;
}

export async i32 main(Page page) {
  page.mount((Ui ui) => <Shows page={page}/>);
  return 0;
}
