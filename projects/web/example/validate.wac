// A page asking its host whether the engine will load a module (`Modules.validate`) — what `wac build` asks before it
// writes one, in the desktop's Terminal as on a command line. A module needs no manifest to load; a page needs one to
// start it as a program, which is another question. `test/validate_live.test.ts` reads the answers.

import { Page, Ui, html.p } from "../src/page.wac";

export async i32 main(Page page) {
  u8[] bare = [0, 97, 115, 109, 1, 0, 0, 0] as u8[];
  u8[] broken = [0, 97, 115, 109, 9, 9, 9, 9] as u8[];
  string a = page.sys.modules().validate(bare).isOk() ? "loads" : "refused";
  string b = page.sys.modules().validate(broken).isOk() ? "loads" : "refused";
  page.mount((Ui ui) => <p id="said">{"bare " + a + ", broken " + b}</p>);
  return 0;
}
