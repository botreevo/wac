// `Prerender`: a page's first frame as markup, each node carrying the handle the program gave it — what
// `tools/build.wac` writes into `index.html` for a page that exports its frames, and what the browser's host adopts by those handles.

import { Check } from "./check.wac";
import { ElementEvent, Node, Page, Prerender, Size, Ui, hrefTo, sizeOf, html.b, html.button, html.canvas, html.div, html.input, html.main,
         html.p, html.style, html.textarea } from "../../src/page.wac";
import { TestDoc } from "../../src/testdoc.wac";

void counter(Page page) {
  page.mount((Ui ui) => {
    auto n = ui.state(0);
    return <main class="app"><p>Clicks: <b>{"\{n.get()}"}</b></p>
             <button onclick={(ElementEvent e) => { n.set(n.get() + 1); }}>+1</button></main>;
  });
}

export string test_the_first_frame_is_markup_with_the_handles() {
  Check t = Check.create();
  Prerender r = Prerender.create();
  counter(r.page);
  t.eqStr(r.first(),
          "<main data-wac-h=\"1\" class=\"app\"><p data-wac-h=\"2\"><!--wac:3-->Clicks: <b data-wac-h=\"4\"><!--wac:5-->0</b></p>"
          + "<button data-wac-h=\"6\"><!--wac:7-->+1</button></main>",
          "each element carries its handle, and each text node a comment naming its");
  return t.report();
}

export string test_the_handles_are_the_ones_a_live_page_gives() {
  Check t = Check.create();
  Prerender r = Prerender.create();
  counter(r.page);
  r.first();
  // The same program on a page as a browser's host runs it: the handles it makes are the ones the markup names.
  TestDoc live = TestDoc.batched();
  Page page = live.page();
  counter(page);
  page.turn();
  t.eqStr(live.said, r.doc.said, "the same changes, under the same handles");
  t.eqStr(live.at(4).tag, "b", "handle 4 is the count in both");
  return t.report();
}

export string test_only_the_first_batch_is_the_first_frame() {
  Check t = Check.create();
  Prerender r = Prerender.create();
  Page page = r.page;
  page.mount((Ui ui) => <p>first</p>);
  // A program that asks the host something mid-turn sends what it drew so far first; that batch is the first frame,
  // and what it draws after is the browser's to apply as an ordinary change.
  page.line.flush();
  page.root().append("div").text("later");
  t.eqStr(r.first(), "<p data-wac-h=\"1\"><!--wac:2-->first</p>", "what was drawn when the first batch went, and no more");
  return t.report();
}

export string test_what_markup_cannot_say_is_left_to_the_module() {
  Check t = Check.create();
  Prerender r = Prerender.create();
  r.page.mount((Ui ui) => <div>
      <style>{"main > p { color: red }"}</style>
      <input value="typed" checked="" />
      <textarea value="a < b"></textarea>
      <canvas width="4" height="4"></canvas>
    </div>);
  r.page.root().append("div").shadow();
  string m = r.first();
  t.isTrue(m.indexOf("<style data-wac-h=\"2\">main > p { color: red }</style>") > 0,
           "a stylesheet's text is CSS, not escaped as HTML, and has no mark: \{m}");
  t.isTrue(m.indexOf("value=\"typed\"") > 0, "an input's value starts it off: \{m}");
  t.isTrue(m.indexOf(">a &lt; b</textarea>") > 0, "a textarea's value is its content, escaped: \{m}");
  t.isTrue(m.indexOf("<canvas data-wac-h=\"") > 0, "a canvas is there, without its pixels");
  t.isTrue(m.indexOf("#shadow") < 0, "a shadow root is the module's to make: \{m}");
  return t.report();
}

export string test_a_frame_is_drawn_at_its_size_which_the_page_answers() {
  Check t = Check.create();
  Prerender r = Prerender.at(390, 844);
  r.page.mount((Ui ui) => <p>{"\{r.page.size().width}x\{r.page.size().height}"}</p>);
  t.eqStr(r.first(), "<p data-wac-h=\"1\"><!--wac:2-->390x844</p>", "the program knew the size in its first turn");
  t.eqStr("\{Prerender.create().page.size().width}", "0", "a page drawn at no size says 0");
  return t.report();
}

export string test_a_hosts_size_is_read_from_its_answer() {
  Check t = Check.create();
  Size s = sizeOf("1280x800");
  t.eqStr("\{s.width} \{s.height}", "1280 800", "a size");
  for (string bad in ["", "1280", "x800", "12a0x800", "1280x", "-1x5"]) {
    Size b = sizeOf(bad);
    t.eqStr("\{b.width} \{b.height}", "0 0", "'" + bad + "' is no size");
  }
  return t.report();
}

export string test_a_frame_at_a_path_is_the_page_there_with_its_title_and_description() {
  Check t = Check.create();
  Prerender r = Prerender.on("/docs/a/", 1280, 800);
  Page page = r.page;
  page.mount((Ui ui) => {
    page.title("A " + page.path());
    page.describe("All about " + page.path());
    return <p>{page.path()}</p>;
  });
  t.eqStr(r.first(), "<p data-wac-h=\"1\"><!--wac:2-->/docs/a/</p>", "the program knew its path in its first turn");
  t.eqStr(r.doc.title, "A /docs/a/", "its title");
  t.eqStr(r.doc.description, "All about /docs/a/", "and its description");
  return t.report();
}

export string test_a_path_followed_is_heard_once() {
  Check t = Check.create();
  Prerender r = Prerender.on("/", 0, 0);
  Page page = r.page;
  string heard = "";
  page.onPath((string p) => { heard = heard + p + ";"; });
  page.navigate("/docs/b/", true);
  page.turn();
  t.eqStr(page.path(), "/docs/b/", "the page is there");
  t.eqStr(heard, "/docs/b/;", "and it was heard once");
  t.isTrue(r.doc.said.indexOf("navigate /docs/b/ push") >= 0, "the host was asked to go there: " + r.doc.said);
  r.doc.goPath("/docs/a/");
  t.eqStr(heard, "/docs/b/;/docs/a/;", "Back, as the host says it, heard too");
  return t.report();
}

export string test_a_link_between_pages_is_relative() {
  Check t = Check.create();
  t.eqStr(hrefTo("/docs/a/", "/docs/b/"), "../b/", "a sibling");
  t.eqStr(hrefTo("/docs/a/", "/"), "../../", "the root");
  t.eqStr(hrefTo("/", "/docs/a/"), "docs/a/", "from the root");
  t.eqStr(hrefTo("/docs/a/", "/docs/a/"), "./", "itself");
  t.eqStr(hrefTo("/docs/", "/docs/a/"), "a/", "a child");
  return t.report();
}
