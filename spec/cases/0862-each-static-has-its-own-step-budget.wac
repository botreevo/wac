// expect: f() = 3
// why: the step budget bounds one static's evaluation, not a file's — three statics that each fit
// evaluate together, in any order (issues/lang/0422w)
// spec: §wac-static-eval-limit-bt6cfra
i32 spin(i32 k) {
  i32 t = 0;
  for (i32 i = 0; i < 600000; i++) { t = (t + i) % 1000; }
  return t * 0 + k;
}
static i32 A = spin(1);
static i32 B = spin(1);
static i32 C = spin(1);
export i32 f() { return A + B + C; }
