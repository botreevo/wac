// expect: f() = 425
// why: `type B = fn<T?[](T)>` is a funcref answering an array, and `type C = fn<i32(T)>[]` an array of
// funcrefs; an alias is another spelling of what it names, so a lambda handed to either has that type
// (issues/lang/0426d)
// spec: §wac-type-alias-e4gvipb
struct T { i32 v; }
type B = fn<T?[](T)>;
type C = fn<i32(T)>[];
type N = fn<i32()>?;
i32 take(B b) { return b(T(4))[0]!.v; }
i32 many(C c) { return c[0](T(2)) + c.len(); }
i32 maybe(N n) { return n is null ? 0 - 1 : n!(); }
export i32 f() { return take((T t) => [t]) * 100 + many([(T t) => t.v * 10]) + maybe(() => 4); }
