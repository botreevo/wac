// expect: f() = 7
// why: a match used for its value hands each arm the type expected of it, as a ternary hands its
// branches theirs — so a lambda arm takes the funcref type the match is returned as (issues/lang/0427d)
// spec: §wac-widen-expected-union-cyghd6c
enum Op { Neg, Twice }
fn<f32(f32)> pick(Op op) {
  return match (op) {
    Neg: (f32 x) => 0.0 - x,
    Twice: (f32 x) => x * 2.0,
  };
}
export i32 f() { return (pick(Op.Neg)(1.0) + pick(Op.Twice)(4.0)) as~ i32; }
