// expect: f() = 1
// why: `0.0 - 2.0` has no type of its own, as `2.0` has none: beside an `f32` operand it is an `f32`
// (issues/lang/0428d)
// spec: §wac-float-literal-ctx-8dqm2vw
export i32 f() {
  f32 r = 0.0 - 2.0;
  f32 s = 0.0 - 2.0 + r;
  return r == 0.0 - 2.0 && s == 0.0 - 4.0 && r < 1.0 - 0.5 ? 1 : 0;
}
