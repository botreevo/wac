// expect: refused
// why: a named field's value is an expression like any other, and a lambda there is checked as one passed
// positionally is — a name nothing declares is refused inside it (issues/lang/0432d)
// spec: §wac-struct-named-4y8pg2j
struct Report { fn<i32(i32)> emit; }
export i32 f() {
  Report r = Report { emit: (i32 n) => n + nothingDeclaresThis };
  return r.emit(1);
}
