// expect: f() = 2
// why: `T[]()` is an empty array and fills nothing, so it builds no default element — even of a struct whose field
// defaults to an empty Vec of the struct that holds it, where building one recursed until the stack ran out
import { Vec } from "core";
struct Stream { i32 id; Conn conn; }
struct Conn { Vec<Stream> streams = Vec<Stream>.create(); }
export i32 f() {
  Stream[] none = Stream[]();
  Conn c = Conn { };
  c.streams.push(Stream(7, c));
  return none.len() + c.streams.len() + 1;
}
