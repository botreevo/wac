// expect: f() = 15
// why: `as!` out of a union narrows the reference, wherever the union is held — a static's field included
// (issues/lang/0440d)
// spec: §wac-cast-matrix-6hkq4wz
struct Box { i32 v; }
struct Holder { union<i32, Box> u; }
static Holder H = Holder(Box(5));
export i32 f() {
  Holder h = Holder(Box(10));
  i32 a = match (H.u) { i32: -1, Box: (H.u as! Box).v, };
  Box b = h.u as! Box;
  return a + b.v;
}
