// expect: refused
// why: `operators` declares `lessThan`, not `less`; a member named by a symbol nothing declares is an undefined name,
// said at the name rather than as a parse error at the bracket (issues/lang/0442d)
// spec: §wac-operator-dispatch-left-txsqbyi
import { operators } from "core";

struct V {
  i32 x;
  bool [operators.less](const this, const V rhs) { return this.x < rhs.x; }
}
