// expect: refused
// why: a union answers no method, not even one every member declares — a value of one is taken apart with `match`
// (issues/lang/0406a)
// spec: §wac-union-match-type-rj837up
struct A { i32 x; i32 get(const this) { return this.x; } }
struct B { i32 y; i32 get(const this) { return this.y; } }

i32 f(union<A, B> e) { return e.get(); }

export i32 main() { return f(A(1)); }
