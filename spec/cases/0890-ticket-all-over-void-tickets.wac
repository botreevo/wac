// expect: f() = 2
// why: `Ticket.all` over tickets of `void` settles when they do, with nothing to hold for them (issues/lang/0414a)
// spec: §wac-ticket-all-2h6iwfr
import { Ticket } from "core";

struct Count { i32 n; }

async void bump(Count c) { c.n = c.n + 1; }

async i32 g() {
  Count c = Count(0);
  await Ticket.all(bump(c), bump(c));
  return c.n;
}

export i32 f() { return g().wait()!; }
