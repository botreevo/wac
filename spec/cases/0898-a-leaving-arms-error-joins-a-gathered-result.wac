// expect: f() = 3
// why: a `return` in a match arm that leaves is one of the function's returns, so its `Err` is one of the errors a
//      `Result<T>` with its error type omitted gathers
// from: issues/lang/0377a
// spec: §wac-try-collects-errors-6cjnatm
import { Result } from "core";
Result<i32, string> get(i32 n) { if (n < 0) { return Result.Err("no"); } return Result.Ok(n); }
Result<i32> plusOne(i32 n) {
  i32 v = match (get(n)) {
    Ok(x): x,
    Err(e): return Result.Err("plusOne: " + e),
  };
  return Result.Ok(v + 1);
}
i32 g(i32 n) { return match (plusOne(n)) { Ok(v): v, Err(e): -1 }; }
export i32 f() { return g(3) + g(-1); }
