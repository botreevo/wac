// expect: refused
// why: `Ticket.any` answers the union of what its tickets answer, and over a `Ticket<void>` and a `Ticket<i32>` that
//      union has `void` beside `i32` — refused at the call
// from: issues/lang/0378a
import { Ticket } from "core";
async void quiet() { }
async i32 four() { return 4; }
export i32 f() {
  auto t = Ticket.any(quiet(), four());
  return 0;
}
