// expect: refused
// why: a nullable answers no method — `!` or `?.` reaches what it holds; `m.get("x")` is an `i32?`, and calling on it is
// refused whether or not the method exists (issues/lang/0305b, 0410a)
// spec: §wac-safe-call-hfr3mzk
import { Map, hashString, stringEq } from "core";

export i32 main() {
  Map<string, i32> m = Map.create(hashString, stringEq);
  m.set("x", 7);
  return m.get("x").noSuchMethodAtAll(0);
}
