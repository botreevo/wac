// expect: refused
// why: the names a condition's `matches` bind share one scope, so binding one name twice across `&&` is a second
//      declaration of it, not a second value for it
// from: issues/lang/0395a
// spec: §wac-matches-scope-i52ba3w
struct R { i32 v; }
export i32 f() {
  R? m = R(1);
  R? n = R(2);
  if (R p matches m && R p matches n) { return p.v; }
  return 0;
}
