// expect: f() = 14
// why: in a `const` slot a converted literal cannot be written through, so it is the statically converted value —
//      the same answer a fresh one would give, and the slot may hold it
// from: issues/lang/0360a
// spec: §wac-fromnumber-evaluation-5k2r8vq
import { NumberLiteral, fromNumber, Result } from "core";
struct Box {
  i32 v;
  Result<Box, string> [fromNumber](NumberLiteral n) { return Result.Ok(Box(7)); }
}
export i32 f() {
  const Box a = 3;
  const Box b = 3;
  return a.v + b.v;
}
